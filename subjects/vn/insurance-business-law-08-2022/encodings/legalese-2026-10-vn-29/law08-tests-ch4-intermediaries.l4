`a qualified individual` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS TRUE
    `has full civil act capacity` IS TRUE
    `holds an agent certificate suited to the types of insurance` IS TRUE
    `is being prosecuted for a crime` IS FALSE
    `is serving a prison sentence` IS FALSE
    `is serving a ban on practising in a field related to insurance` IS FALSE
`an individual without a certificate` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS TRUE
    `has full civil act capacity` IS TRUE
    `holds an agent certificate suited to the types of insurance` IS FALSE
    `is being prosecuted for a crime` IS FALSE
    `is serving a prison sentence` IS FALSE
    `is serving a ban on practising in a field related to insurance` IS FALSE
`a foreign individual` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS FALSE
    `has full civil act capacity` IS TRUE
    `holds an agent certificate suited to the types of insurance` IS TRUE
    `is being prosecuted for a crime` IS FALSE
    `is serving a prison sentence` IS FALSE
    `is serving a ban on practising in a field related to insurance` IS FALSE
`an individual being prosecuted` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS FALSE
    `has full civil act capacity` IS FALSE
    `holds an agent certificate suited to the types of insurance` IS FALSE
    `is being prosecuted for a crime` IS TRUE
    `is serving a prison sentence` IS FALSE
    `is serving a ban on practising in a field related to insurance` IS FALSE
`an individual in prison` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS FALSE
    `has full civil act capacity` IS FALSE
    `holds an agent certificate suited to the types of insurance` IS FALSE
    `is being prosecuted for a crime` IS FALSE
    `is serving a prison sentence` IS TRUE
    `is serving a ban on practising in a field related to insurance` IS FALSE
`an individual banned from practice` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS FALSE
    `has full civil act capacity` IS FALSE
    `holds an agent certificate suited to the types of insurance` IS FALSE
    `is being prosecuted for a crime` IS FALSE
    `is serving a prison sentence` IS FALSE
    `is serving a ban on practising in a field related to insurance` IS TRUE
`a clean individual` MEANS `An individual agent` WITH
    `is a Vietnamese citizen resident in Vietnam` IS FALSE
    `has full civil act capacity` IS FALSE
    `holds an agent certificate suited to the types of insurance` IS FALSE
    `is being prosecuted for a crime` IS FALSE
    `is serving a prison sentence` IS FALSE
    `is serving a ban on practising in a field related to insurance` IS FALSE
#ASSERT `Dieu 125(1): the individual meets the conditions to act as an agent` `a qualified individual`
#ASSERT NOT `Dieu 125(1): the individual meets the conditions to act as an agent` `an individual without a certificate`
#ASSERT NOT `Dieu 125(1): the individual meets the conditions to act as an agent` `a foreign individual`
#ASSERT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `an individual being prosecuted`
#ASSERT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `an individual in prison`
#ASSERT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `an individual banned from practice`
#ASSERT NOT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `a clean individual`
`an ordinary agent company` MEANS `An organisation agent` WITH
    `is lawfully established and operating in Vietnam` IS TRUE
    `has registered the business line of insurance agency under the Law on Enterprises` IS TRUE
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS FALSE
    `is in a conditional line` IS FALSE
    `its staff who act as agents meet the individual conditions` IS TRUE
    `meets the staffing and other conditions the Government sets` IS TRUE
    `is a commercial legal person being prosecuted for a crime` IS FALSE
    `is suspended for a time or for good, or banned from business related to insurance` IS FALSE
`a bank agent in a conditional line with cover` MEANS `An organisation agent` WITH
    `is lawfully established and operating in Vietnam` IS TRUE
    `has registered the business line of insurance agency under the Law on Enterprises` IS TRUE
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS TRUE
    `is in a conditional line` IS TRUE
    `its staff who act as agents meet the individual conditions` IS TRUE
    `meets the staffing and other conditions the Government sets` IS TRUE
    `is a commercial legal person being prosecuted for a crime` IS FALSE
    `is suspended for a time or for good, or banned from business related to insurance` IS FALSE
`a bank agent in a conditional line without cover` MEANS `An organisation agent` WITH
    `is lawfully established and operating in Vietnam` IS TRUE
    `has registered the business line of insurance agency under the Law on Enterprises` IS TRUE
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS FALSE
    `is in a conditional line` IS TRUE
    `its staff who act as agents meet the individual conditions` IS TRUE
    `meets the staffing and other conditions the Government sets` IS TRUE
    `is a commercial legal person being prosecuted for a crime` IS FALSE
    `is suspended for a time or for good, or banned from business related to insurance` IS FALSE
`an agent company with unqualified staff` MEANS `An organisation agent` WITH
    `is lawfully established and operating in Vietnam` IS TRUE
    `has registered the business line of insurance agency under the Law on Enterprises` IS TRUE
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS FALSE
    `is in a conditional line` IS FALSE
    `its staff who act as agents meet the individual conditions` IS FALSE
    `meets the staffing and other conditions the Government sets` IS TRUE
    `is a commercial legal person being prosecuted for a crime` IS FALSE
    `is suspended for a time or for good, or banned from business related to insurance` IS FALSE
`a suspended agent company` MEANS `An organisation agent` WITH
    `is lawfully established and operating in Vietnam` IS FALSE
    `has registered the business line of insurance agency under the Law on Enterprises` IS FALSE
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS FALSE
    `is in a conditional line` IS FALSE
    `its staff who act as agents meet the individual conditions` IS FALSE
    `meets the staffing and other conditions the Government sets` IS FALSE
    `is a commercial legal person being prosecuted for a crime` IS FALSE
    `is suspended for a time or for good, or banned from business related to insurance` IS TRUE
`a prosecuted agent company` MEANS `An organisation agent` WITH
    `is lawfully established and operating in Vietnam` IS FALSE
    `has registered the business line of insurance agency under the Law on Enterprises` IS FALSE
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS FALSE
    `is in a conditional line` IS FALSE
    `its staff who act as agents meet the individual conditions` IS FALSE
    `meets the staffing and other conditions the Government sets` IS FALSE
    `is a commercial legal person being prosecuted for a crime` IS TRUE
    `is suspended for a time or for good, or banned from business related to insurance` IS FALSE
#ASSERT `Dieu 125(2): the organisation meets the conditions to act as an agent` `an ordinary agent company`
#ASSERT `Dieu 125(2): the organisation meets the conditions to act as an agent` `a bank agent in a conditional line with cover`
#ASSERT NOT `Dieu 125(2): the organisation meets the conditions to act as an agent` `a bank agent in a conditional line without cover`
#ASSERT NOT `Dieu 125(2): the organisation meets the conditions to act as an agent` `an agent company with unqualified staff`
#ASSERT `Dieu 125(3)(a): the organisation may not make or perform an agency contract` `a suspended agent company`
