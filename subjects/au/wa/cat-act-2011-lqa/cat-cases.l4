`Petsafe` MEANS `Database company` WITH
    `company name` IS "PetBase Pty Ltd, trading as Petsafe"
    `keeps a microchip database` IS TRUE
    `keeps, or has agreed to keep, records about the cat and its owner` IS TRUE

`an unlisted registry` MEANS `Database company` WITH
