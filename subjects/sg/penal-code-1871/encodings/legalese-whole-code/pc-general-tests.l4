§§ `ss 41, 53 - punishments`

-- s 417: "imprisonment for a term which may extend to 3 years, or with fine, or with both"
`punishment prescribed by s 417` MEANS Punishment WITH
    section                  IS "417"
    words                    IS "imprisonment for a term which may extend to 3 years, or with fine, or with both"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `or with`
    `maximum term in months` IS JUST 36
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `or with`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS TRUE

-- s 420(2): "imprisonment for a term which may extend to 10 years and with
-- caning with not less than 6 strokes, and shall also be liable to fine"
`punishment prescribed by s 420(2)` MEANS Punishment WITH
    section                  IS "420(2)"
    words                    IS "imprisonment for a term which may extend to 10 years and with caning with not less than 6 strokes, and shall also be liable to fine"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `shall be punished with`
    `maximum term in months` IS JUST 120
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `shall also be liable to`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `shall be punished with`
    `minimum strokes`        IS JUST 6
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE

-- A section punishing with death or imprisonment for life, and a fine-only
-- section, for the boundaries.
`a punishment of death or imprisonment for life` MEANS Punishment WITH
    section                  IS "(test)"
    words                    IS "death or imprisonment for life"
    death                    IS `or with`
    `imprisonment for life`  IS `or with`
    imprisonment             IS `not prescribed`
    `maximum term in months` IS NOTHING
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `not prescribed`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE
`a fine only` MEANS Punishment WITH
    section                  IS "(test)"
    words                    IS "fine which may extend to $1,500"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `not prescribed`
    `maximum term in months` IS NOTHING
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `shall be punished with`
    `maximum fine`           IS JUST 1500
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE
`imprisonment with no stated maximum` MEANS Punishment WITH
    section                  IS "(test)"
    words                    IS "imprisonment"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `shall be punished with`
    `maximum term in months` IS NOTHING
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `not prescribed`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE

#ASSERT `punishable with imprisonment` `punishment prescribed by s 417`
#ASSERT NOT `punishable with death or imprisonment for life` `punishment prescribed by s 417`
#ASSERT `punishable with death or imprisonment for life` `a punishment of death or imprisonment for life`
#ASSERT NOT `punishable with imprisonment` `a fine only`
-- s 512(3): a mandatory minimum of caning
#ASSERT `fixed by law or carries a minimum sentence` `punishment prescribed by s 420(2)`
#ASSERT NOT `fixed by law or carries a minimum sentence` `punishment prescribed by s 417`

-- s 41: "a specified term or upwards includes an offence for which the
-- specified term is the maximum" - the boundary is inclusive.
#ASSERT `punishable with imprisonment for` 36 `months or upwards within section 41` `punishment prescribed by s 417`
#ASSERT NOT `punishable with imprisonment for` 37 `months or upwards within section 41` `punishment prescribed by s 417`
#ASSERT `punishable with imprisonment for` 6 `months or upwards within section 41` `punishment prescribed by s 417`
#ASSERT `punishable with imprisonment for` 6 `months or upwards within section 41` `a punishment of death or imprisonment for life`
#ASSERT NOT `punishable with imprisonment for` 6 `months or upwards within section 41` `a fine only`
#ASSERT REFUSED `punishable with imprisonment for` 6 `months or upwards within section 41` `imprisonment with no stated maximum`

