IMPORT prelude
IMPORT daydate

-- Work Injury Compensation Act 2019 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- A fact here is one a witness could give ("the worker was on a company bus
-- to the site"); whether that makes the accident one "arising out of and in
-- the course of" the work is a rule.
--
-- Source: ../source/WICA2019.txt (SSO PDF, current version as at 06 Oct 2026).

§ `Work Injury Compensation Act 2019 — the nouns`

§§ `Who the claimant is`

-- s 2 "work": "the individual's employment as an employee or the
-- individual's provision of a platform service as a platform worker".
DECLARE `Capacity at work` IS ONE OF
    `as an employee`
    `as a platform worker`

-- Third Schedule, "Classes of individuals not covered".
DECLARE `Third Schedule class` IS ONE OF
    `a member of the Singapore Armed Forces`                                                        -- item 1
    `an officer of the Police Force, Civil Defence Force, Central Narcotics Bureau or Prisons Service` -- item 2
    `a domestic worker employed in the domestic services of private premises`                       -- item 3
    `none of the Third Schedule classes`

DECLARE Claimant HAS
    `name`                                             IS A STRING
    `date of birth`                                    IS A DATE
    `capacity`                                         IS A `Capacity at work`
    `works under a contract of service`                IS A BOOLEAN   -- s 3(1) "employee"
    `works under a platform work agreement`            IS A BOOLEAN   -- s 2 "platform worker" (Platform Workers Act 2024 s 5(1)); an input
    `class`                                            IS A `Third Schedule class`
    `a Government employee`                            IS A BOOLEAN   -- s 3(1)(a)
    `in a class the President has declared`            IS A BOOLEAN   -- s 3(1)(a)
    `the contract was illegal at the time of the accident` IS A BOOLEAN   -- s 3(3), s 34J
    `ordinarily resident in Singapore`                 IS A BOOLEAN   -- s 9(a)
    `employed by an employer in Singapore`             IS A BOOLEAN   -- s 9(b)
    `required by the employment to work outside Singapore` IS A BOOLEAN   -- s 9(b)
    `employed as crew of a Singapore ship`             IS A BOOLEAN   -- s 65(3) "seafarer"

§§ `The accident`

-- s 34E, Fifth Schedule Part 1 para 1 and Part 2: where a platform worker was
-- in a platform service at the time of the accident.
DECLARE `Work stage` IS ONE OF
    `work stage 1`
    `work stage 2`
    `not at a work stage`

-- One platform operator the worker was providing a service for when the
-- accident happened, and the worker's earnings with it in the lookback period.
DECLARE `Platform engagement` HAS
    `operator`                         IS A STRING
    `stage`                            IS A `Work stage`
    `earnings in the lookback period`  IS A NUMBER

DECLARE Accident HAS
    `date`                                                       IS A DATE
    `in Singapore`                                               IS A BOOLEAN
    `on a Singapore ship`                                        IS A BOOLEAN    -- s 65(2)
    `in the course of the work`                                  IS A BOOLEAN    -- s 7(1), s 34D(1)
    `evidence it did not arise out of the work`                  IS A BOOLEAN    -- s 7(4), s 34D(4): "in the absence of evidence to the contrary"
    -- s 8(1): travel
    `travelling as a passenger to or from the workplace with the employer's permission` IS A BOOLEAN
    `transport operated by or for the employer, or by arrangement with the employer`     IS A BOOLEAN
    `transport operated in the ordinary course of a public transport service`           IS A BOOLEAN
    -- s 8(2), s 34F(1): emergencies
    `in or about the workplace, or at work providing the platform service`  IS A BOOLEAN
    `taking steps in an actual or supposed emergency to rescue, protect or avert damage` IS A BOOLEAN
    -- s 8(3), s 34F(2): acting against rules or instructions
    `acting in contravention of law, regulations or orders, or without instructions` IS A BOOLEAN
    `would otherwise have arisen out of and in the course of the work`               IS A BOOLEAN
    `the act was done for the purposes of and in connection with the business or service` IS A BOOLEAN
    -- s 7(2), s 34D(2): exclusions
    `proven the injury is directly attributable to alcohol or a drug`  IS A BOOLEAN
    `deliberate self-injury or deliberate aggravation`                 IS A BOOLEAN
    `injured in a fight or an assault`                                 IS A BOOLEAN
    `assaulted another person in the fight`                            IS A BOOLEAN
    `any assault was in the exercise of the right of private defence`  IS A BOOLEAN
    `breaking up or preventing the fight, or safeguarding life, property or law and order` IS A BOOLEAN
    `under the instruction or with the consent of the employer or platform operator`       IS A BOOLEAN
    -- s 34D(2)(a)(ii)-(iii) and the Sixth Schedule: platform workers' vehicles
    `proven contravention of a Sixth Schedule Part 1 law in using a vehicle`  IS A BOOLEAN
    `used a vehicle in providing the platform service`                        IS A BOOLEAN
    `proven contravention of a Sixth Schedule Part 2 law about that vehicle`  IS A BOOLEAN
    `proven that contravention caused or contributed to the accident`         IS A BOOLEAN
    -- platform operators at the time of the accident (s 34D, s 34E)
    `platform engagements`                                       IS A LIST OF `Platform engagement`

-- s 13: a principal and a contractor.
DECLARE `Principal arrangement` HAS
    `contracted in the course of or for the principal's trade or business`      IS A BOOLEAN   -- s 13(1)
    `for execution of work, or supply of labour, undertaken by the principal`   IS A BOOLEAN   -- s 13(1)(a), (b)
    `the employee was employed in executing the work`                           IS A BOOLEAN   -- s 13(1)
    `accident at a place where the principal undertook to execute work, or under the principal's control` IS A BOOLEAN   -- s 13(5)
    `the Commissioner has directed the principal`                               IS A BOOLEAN   -- s 13(1)

§§ `Disease`

-- s 10, s 34G and the Second Schedule.
DECLARE `Disease facts` HAS
    `Second Schedule item`                       IS A MAYBE NUMBER   -- 1 to 38; NOTHING if the disease is not in the Schedule
    `worked in the specified occupation when it was contracted`  IS A BOOLEAN   -- s 10(1)(a), s 34G(1)(a)
    `ceased working in the specified occupation on`              IS A MAYBE DATE -- s 10(1)(b), (5); s 34G(1)(b), (5)
    `contracted on`                              IS A DATE
    `directly attributable to a chemical or biological exposure at work` IS A BOOLEAN   -- s 10(1)(c), s 34G(1)(c)
    `exposure ceased on`                         IS A MAYBE DATE     -- s 10(3)(b), s 34G(3)(b)
    `employed in that occupation by this employer on or after 1 June 2012` IS A BOOLEAN   -- s 10(3)(a)(i)
    `incapacity commenced on`                    IS A MAYBE DATE
    `died on`                                    IS A MAYBE DATE
    `certified as suffering from the disease on` IS A MAYBE DATE     -- s 11(2)(a)(ii), s 34H(2)(a)(ii)
    `last day working for this employer or operator` IS A DATE      -- s 11(1)(a), s 34H(1)(a)
    `death preceded by compensable incapacity`   IS A BOOLEAN        -- s 10(4), s 34G(4)
    `directly attributable to a specific work injury` IS A BOOLEAN   -- s 12, s 34I

§§ `Incapacity and amount`

-- s 4 and the First and Fifth Schedules.
DECLARE Outcome IS ONE OF
    `death`
    `permanent or current total incapacity`
    `permanent or current partial incapacity` HAS `loss of earning capacity, in percent` IS A NUMBER
    `temporary incapacity`

-- Fourth Schedule, "Injuries deemed to result in permanent incapacity".
DECLARE `Fourth Schedule injury` IS ONE OF
    `loss of 2 limbs`, `loss of both hands or of all fingers and both thumbs`, `loss of both feet`
    `total loss of sight`, `total paralysis`, `injuries resulting in being permanently bedridden`
    `any other injury causing permanent total incapacity`
    `loss of arm at shoulder`, `loss of arm between elbow and shoulder`, `loss of arm at elbow`
    `loss of arm between wrist and elbow`, `loss of hand at wrist`, `loss of 4 fingers and thumb of one hand`
    `loss of 4 fingers`
    `loss of thumb, both phalanges`, `loss of thumb, one phalanx`
    `loss of index finger, 3 phalanges`, `loss of index finger, 2 phalanges`, `loss of index finger, one phalanx`
    `loss of middle finger, 3 phalanges`, `loss of middle finger, 2 phalanges`, `loss of middle finger, one phalanx`
    `loss of ring finger, 3 phalanges`, `loss of ring finger, 2 phalanges`, `loss of ring finger, one phalanx`
    `loss of little finger, 3 phalanges`, `loss of little finger, 2 phalanges`, `loss of little finger, one phalanx`
    `loss of first or second metacarpal (additional)`, `loss of third, fourth or fifth metacarpal (additional)`
    `loss of leg at or above knee`, `loss of leg below knee`, `loss of foot`
    `loss of all toes of one foot`, `loss of great toe, both phalanges`, `loss of great toe, one phalanx`
    `loss of a toe other than the great toe, more than one lost`
    `loss of sight of one eye`, `loss of hearing, one ear`, `total loss of hearing`

-- First Schedule para 6: an employee's earnings.
DECLARE `Employee earnings` HAS
    `continuously employed for more than one whole calendar month` IS A BOOLEAN   -- para 6(1) or (2)
    `whole calendar months continuously employed before the accident` IS A NUMBER   -- para 6(1)(b)-(c)
    `actual earnings in the computation period`  IS A NUMBER   -- para 6(1) "A": up to the last 12 whole months; incl. other employers the employer knows of (para 6(5))
    `average earnings per working day`           IS A NUMBER   -- para 6(2) "D"
    `average working days per week`              IS A NUMBER   -- para 6(2) "W"

-- Fifth Schedule Part 3 para 6(1)(b): the mode of transport.
DECLARE `Mode of transport` IS ONE OF
    `on foot, by public transport or by a bicycle that is not power assisted`    -- 20%
    `by personal mobility device, power-assisted bicycle or motorcycle`          -- 35%
    `by motor vehicle other than a motorcycle`                                   -- 60%

-- Fifth Schedule Part 3 para 6: a platform worker's earnings from the
-- relevant platform service (para 7).
DECLARE `Platform earnings` HAS
    `days at work providing the service before the accident` IS A NUMBER   -- para 6(1)(c)(ii), 6(2)
    `relevant earnings in the lookback period`               IS A NUMBER   -- para 6(1)(c)(i) "E", 6(3)-(4)
    `mode`                                                   IS A `Mode of transport`
    `days of hospitalisation or medical leave in a run of 7 or more` IS A NUMBER   -- para 6(2)(b) "B", 6(4): ALL the days on such leave in the period, where there was a run of 7 or more consecutive days; 0 if there was no such run
    `ADE available`                                          IS A BOOLEAN   -- para 4(2)

-- First Schedule para 4 and Fifth Schedule Part 3 para 4: one day of
-- temporary incapacity, within a year of the accident.
DECLARE `Kind of day` IS ONE OF
    `a day of hospitalisation leave`
    `a day of medical leave`
    `a day of light duties`                    -- employees only
    `a day that does not count`                -- a rest day, paid leave, a day off after termination, absence without leave

DECLARE `Leave day` HAS
    `day`                            IS A DATE
    `kind`                           IS A `Kind of day`
    `actual wages that day`          IS A NUMBER   -- light duties only (para 4(1)(c)(ii), (d)(ii), (5)(a))

§§ `Payment`

-- s 18(2), s 19, s 20, s 21: whom the money goes to.
DECLARE `Payee facts` HAS
    `the claimant has died`                                   IS A BOOLEAN
    `an executor or administrator is known to be appointed`    IS A BOOLEAN
    `the claimant lacks capacity in property and affairs`      IS A BOOLEAN
    `a donee or deputy with power to receive the payment`      IS A BOOLEAN
    `the claimant is below 18`                                 IS A BOOLEAN
    `for permanent or current incapacity`                      IS A BOOLEAN
    `the Commissioner has directed payment to relatives`       IS A BOOLEAN   -- s 20
    `the Commissioner has directed a deposit`                  IS A BOOLEAN   -- s 21

DECLARE Payee IS ONE OF
    `the claimant`
    `the Public Trustee`
    `the executor or administrator`
    `the donee or deputy`
    `the claimant's relatives, as the Commissioner directs`
    `a deposit with the Commissioner`
    `no one until the Commissioner directs (s 20, s 21)`

§§ `The claim process`

-- s 35-58: the dates a claim passes through.
DECLARE `Claim history` HAS
    `accident on`                                IS A DATE
    `claimant died on`                           IS A MAYBE DATE
    `employer first had notice on`               IS A MAYBE DATE   -- s 35(2), (2A)
    `later date specified by the Commissioner`   IS A MAYBE DATE   -- s 35(5)(c)
    `withdrawn on`                               IS A MAYBE DATE   -- s 41(1)
    `resumed on`                                 IS A MAYBE DATE   -- s 41(2)
    `the Commissioner approved a late resumption` IS A BOOLEAN     -- s 41(2)(b)
    `incapacity claim made on`                   IS A MAYBE DATE   -- s 39(1)
    `notified of assessment for permanent or current incapacity` IS A BOOLEAN   -- s 39(2)
    `incapacity claim had a health professional's statement` IS A BOOLEAN       -- s 39(3)(b)

-- s 44(5), s 47B(5), s 48(3); s 46, s 47D, s 49: a notice and its objections.
DECLARE `Notice and objections` HAS
    `served on`                                  IS A DATE
    `objections received on`                     IS A LIST OF DATE
    `all objections withdrawn on`                IS A MAYBE DATE
    `objection delayed by another's error or fraud` IS A BOOLEAN   -- s 46(2)(a)(ii)

DECLARE `Kind of order` IS ONE OF
    `a notice of computation in effect as an order`         -- s 44(5), s 47B(5)
    `a notice of assessment in effect as an order`          -- s 48(3)
    `a settlement order not set aside`                      -- s 51(2)(a)
    `an order of refusal at a pre-hearing conference`       -- s 52(d)
    `an order of the Commissioner after review`             -- s 54(1)(c)

-- s 63: what has happened in court and in the claim.
DECLARE `Damages history` HAS
    `sued the employer for damages`                          IS A BOOLEAN   -- s 63(1)(a)
    `recovered damages from the employer`                    IS A BOOLEAN   -- s 63(1)(b)
    `recovered damages from someone else`                    IS A BOOLEAN   -- s 63(2)(a)
    `a settlement order made`                                IS A BOOLEAN   -- s 63(2)(b)
    `a notice took effect as an order`                       IS A BOOLEAN   -- s 63(2)(c)
    `failed to withdraw within 28 days of service, or withdrawal not kept` IS A BOOLEAN   -- s 63(2)(d)
    `an order to pay compensation made after review`         IS A BOOLEAN   -- s 63(2)(e)
    `the s 63(3) route was followed`                         IS A BOOLEAN   -- s 63(3)(a)-(d), all
    `compensation refused, or appeal failed on scope`        IS A BOOLEAN   -- s 63(5)

§§ `Insurance`

-- s 24, s 26, s 30, s 34O.
DECLARE `Insurance position` HAS
    `insured under approved policies with designated insurers for every worker` IS A BOOLEAN   -- s 24(1), s 34O(1)
    `in an excluded class prescribed under s 24(2)(a)`           IS A BOOLEAN
    `a seafarer covered by Maritime Labour Convention security`  IS A BOOLEAN   -- s 67(4)
    `took all reasonable steps to ascertain the matters in s 25(3)` IS A BOOLEAN

DECLARE `Kind of provider` IS ONE OF
    `a designated insurer of the right kind, not suspended`
    `an insurance intermediary for such an insurer`
    `anyone else`

§§ `Offences`

-- Every offence the Act creates, with its subsection.
DECLARE Offence IS ONE OF
    `s 25(1) — employer not insured`
    `s 25(4) — employer deducting insurance cost from earnings`
    `s 30(1) — unauthorised provider of employer insurance`
    `s 30(2A) — unauthorised provider of platform operator insurance`
    `s 30(3) — insurance that is not an approved policy`
    `s 34P(1) — platform operator not insured`
    `s 34P(4) — platform operator deducting insurance cost from earnings`
    `s 35(8) — failing to give the Commissioner notice of an accident`
    `s 50(4) — failing to comply with a direction`
    `s 61(1) — failing to pay compensation`
    `s 61(3) — failing to deposit interest`
    `s 61(5) — failing to make a directed deposit`
    `s 62(1) — false or misleading information`
    `s 62(3)(a) — dishonestly obtaining compensation`
    `s 62(3)(b) — dishonestly avoiding liability to pay compensation`
    `s 68(6) — obstructing the Commissioner or an investigation officer`
    `s 82(3) — contravening the regulations`

DECLARE `Earlier conviction` HAS
    `offence`                                    IS AN Offence
    `under the repealed Act`                     IS A BOOLEAN   -- e.g. s 35(1)(b) of the repealed Act
    `repealed Act provision`                     IS A STRING    -- "35(1)(a)", "35(1)(b)", "35(2)(a)" ...; "" if not
    `under the old regulation 3(5)`              IS A BOOLEAN   -- s 35(9)(b)

-- What the court may impose, at most.
DECLARE `Maximum penalty` HAS
    `fine`                      IS A NUMBER     -- dollars; for s 30, per insurance policy
    `imprisonment in months`    IS A NUMBER     -- 0 if none
