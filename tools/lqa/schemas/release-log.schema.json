{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/release-log.schema.json",
  "title": "Release log (13A)",
  "description": "What was released, to whom, when, against which print, under which 12H signature.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "releases"
  ],
  "properties": {
    "kind": {
      "const": "release-log"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "recipient",
          "what",
          "print",
          "gate_digest"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "recipient": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "print": {
            "type": "string",
            "minLength": 1
          },
          "gate_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}
