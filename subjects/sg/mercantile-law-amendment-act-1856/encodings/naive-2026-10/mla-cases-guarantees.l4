IMPORT prelude
IMPORT `mla-guarantees`

-- Mercantile Law Amendment Act 1856, ss 1 and 2 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_mercantile-law-amendment-act-1856.py). Expected results were written by
-- hand from the text.

`a signed written guarantee of a friend's bank loan` MEANS Promise WITH
    `is to answer for another's debt, default or miscarriage` IS TRUE
    `is in writing` IS TRUE
    `is signed by the promisor` IS TRUE
    `is signed by a person the promisor lawfully authorised` IS FALSE

`a written guarantee signed by the promisor's authorised agent` MEANS Promise WITH
    `is to answer for another's debt, default or miscarriage` IS TRUE
    `is in writing` IS TRUE
    `is signed by the promisor` IS FALSE
    `is signed by a person the promisor lawfully authorised` IS TRUE

`an oral guarantee` MEANS Promise WITH
    `is to answer for another's debt, default or miscarriage` IS TRUE
    `is in writing` IS FALSE
    `is signed by the promisor` IS FALSE
    `is signed by a person the promisor lawfully authorised` IS FALSE

`an unsigned written guarantee` MEANS Promise WITH
    `is to answer for another's debt, default or miscarriage` IS TRUE
    `is in writing` IS TRUE
    `is signed by the promisor` IS FALSE
    `is signed by a person the promisor lawfully authorised` IS FALSE

`a signed written promise to pay one's own debt` MEANS Promise WITH
    `is to answer for another's debt, default or miscarriage` IS FALSE
    `is in writing` IS TRUE
    `is signed by the promisor` IS TRUE
    `is signed by a person the promisor lawfully authorised` IS FALSE

`a guarantor who paid the bank in full` MEANS Payer WITH
    `is surety for another's debt or duty` IS TRUE
    `is liable with another for the debt or duty` IS FALSE
    `has paid the debt or performed the duty` IS TRUE

`a joint borrower who repaid the whole loan` MEANS Payer WITH
    `is surety for another's debt or duty` IS FALSE
    `is liable with another for the debt or duty` IS TRUE
    `has paid the debt or performed the duty` IS TRUE

`a guarantor who has not paid` MEANS Payer WITH
    `is surety for another's debt or duty` IS TRUE
    `is liable with another for the debt or duty` IS FALSE
    `has paid the debt or performed the duty` IS FALSE

`a volunteer who paid another's debt` MEANS Payer WITH
    `is surety for another's debt or duty` IS FALSE
    `is liable with another for the debt or duty` IS FALSE
    `has paid the debt or performed the duty` IS TRUE

`a co-guarantor who performed the duty` MEANS Payer WITH
    `is surety for another's debt or duty` IS TRUE
    `is liable with another for the debt or duty` IS TRUE
    `has paid the debt or performed the duty` IS TRUE

`a mortgage over the debtor's flat securing the loan` MEANS Security WITH
    `is held by the creditor` IS TRUE
    `is held in respect of the debt or duty paid` IS TRUE
    `is deemed at law satisfied by the payment` IS FALSE

`a judgment for the loan, satisfied at law by the payment` MEANS Security WITH
    `is held by the creditor` IS TRUE
    `is held in respect of the debt or duty paid` IS TRUE
    `is deemed at law satisfied by the payment` IS TRUE

`a charge the creditor holds for a different debt` MEANS Security WITH
    `is held by the creditor` IS TRUE
    `is held in respect of the debt or duty paid` IS FALSE
    `is deemed at law satisfied by the payment` IS FALSE

`a pledge the creditor already returned to the debtor` MEANS Security WITH
    `is held by the creditor` IS FALSE
    `is held in respect of the debt or duty paid` IS TRUE
    `is deemed at law satisfied by the payment` IS FALSE

§ `s 1`

#ASSERT `s 1 covers the promise` `a signed written guarantee of a friend's bank loan`
#ASSERT `s 1 covers the promise` `a written guarantee signed by the promisor's authorised agent`
#ASSERT NOT `s 1 covers the promise` `an oral guarantee`
#ASSERT NOT `s 1 covers the promise` `an unsigned written guarantee`
#ASSERT NOT `s 1 covers the promise` `a signed written promise to pay one's own debt`

#ASSERT `s 1 defeats the objection` `a signed written guarantee of a friend's bank loan` `the consideration does not appear in writing`
#ASSERT NOT `s 1 defeats the objection` `a signed written guarantee of a friend's bank loan` `no consideration was given at all`
#ASSERT NOT `s 1 defeats the objection` `a signed written guarantee of a friend's bank loan` `the promisor lacked capacity`
#ASSERT `s 1 defeats the objection` `a written guarantee signed by the promisor's authorised agent` `the consideration does not appear in writing`
#ASSERT NOT `s 1 defeats the objection` `an oral guarantee` `the consideration does not appear in writing`
#ASSERT NOT `s 1 defeats the objection` `an unsigned written guarantee` `the consideration does not appear in writing`
#ASSERT NOT `s 1 defeats the objection` `a signed written promise to pay one's own debt` `the consideration does not appear in writing`

§ `s 2`

#ASSERT `s 2 applies to the payer` `a guarantor who paid the bank in full`
#ASSERT `s 2 applies to the payer` `a joint borrower who repaid the whole loan`
#ASSERT NOT `s 2 applies to the payer` `a guarantor who has not paid`
#ASSERT NOT `s 2 applies to the payer` `a volunteer who paid another's debt`
#ASSERT `s 2 applies to the payer` `a co-guarantor who performed the duty`

#ASSERT `the payer may have the security assigned` `a guarantor who paid the bank in full` `a mortgage over the debtor's flat securing the loan`
#ASSERT `the payer may have the security assigned` `a guarantor who paid the bank in full` `a judgment for the loan, satisfied at law by the payment`
#ASSERT NOT `the payer may have the security assigned` `a guarantor who paid the bank in full` `a charge the creditor holds for a different debt`
#ASSERT NOT `the payer may have the security assigned` `a guarantor who paid the bank in full` `a pledge the creditor already returned to the debtor`
#ASSERT NOT `the payer may have the security assigned` `a guarantor who has not paid` `a mortgage over the debtor's flat securing the loan`
#ASSERT NOT `the payer may have the security assigned` `a volunteer who paid another's debt` `a mortgage over the debtor's flat securing the loan`

#ASSERT `the payer may use the creditor's name` `a guarantor who paid the bank in full` TRUE TRUE
#ASSERT NOT `the payer may use the creditor's name` `a guarantor who paid the bank in full` TRUE FALSE
#ASSERT NOT `the payer may use the creditor's name` `a guarantor who paid the bank in full` FALSE TRUE
#ASSERT NOT `the payer may use the creditor's name` `a guarantor who has not paid` TRUE TRUE

#ASSERT `the payment cannot be pleaded in bar of the payer's action` `a guarantor who paid the bank in full`
#ASSERT NOT `the payment cannot be pleaded in bar of the payer's action` `a guarantor who has not paid`

#ASSERT `the payer may proceed against the defendant` `a guarantor who paid the bank in full` `the principal debtor`
#ASSERT `the payer may proceed against the defendant` `a guarantor who paid the bank in full` `a co-surety`
#ASSERT NOT `the payer may proceed against the defendant` `a guarantor who paid the bank in full` `a stranger to the debt`
#ASSERT `the payer may proceed against the defendant` `a joint borrower who repaid the whole loan` `a co-debtor`
#ASSERT NOT `the payer may proceed against the defendant` `a volunteer who paid another's debt` `the principal debtor`

§ `s 2 proviso`

#ASSERT `the most the payer may recover from the defendant` `a guarantor who paid the bank in full` `the principal debtor` 100000 5000 50000 EQUALS 105000
#ASSERT `the most the payer may recover from the defendant` `a guarantor who paid the bank in full` `a co-surety` 100000 5000 50000 EQUALS 50000
#ASSERT `the most the payer may recover from the defendant` `a guarantor who paid the bank in full` `a co-surety` 30000 0 50000 EQUALS 30000
#ASSERT `the most the payer may recover from the defendant` `a joint borrower who repaid the whole loan` `a co-debtor` 200000 0 100000 EQUALS 100000
#ASSERT `the most the payer may recover from the defendant` `a co-guarantor who performed the duty` `a co-contractor` 80000 2000 40000 EQUALS 40000
#ASSERT `the most the payer may recover from the defendant` `a guarantor who paid the bank in full` `a stranger to the debt` 100000 5000 50000 EQUALS 0
