§ `ss 2 and 12`

#ASSERT `the premises are a hotel` `a ten-room inn with housekeeping`
#ASSERT `the premises are a hotel` `a four-room homestay with breakfast`
#ASSERT NOT `the premises are a hotel` `a three-room homestay with breakfast`
#ASSERT NOT `the premises are a hotel` `a free twelve-room shelter with meals`
#ASSERT `the premises are a hotel` `a two-room guesthouse`
#ASSERT `the premises are a hotel` `an exempted ten-room inn`
#ASSERT NOT `the premises are a hotel` `a two-room flat let nightly with no service`

#ASSERT `the Act applies to the premises` `a ten-room inn with housekeeping`
#ASSERT NOT `the Act applies to the premises` `an exempted ten-room inn`

§ `s 14`

#ASSERT `the court treats the premises as a hotel` `a two-room flat let nightly with no service` FALSE
#ASSERT NOT `the court treats the premises as a hotel` `a two-room flat let nightly with no service` TRUE

§ `ss 5, 6`

#ASSERT `the Board may register the premises` `a complete registration application`
#ASSERT NOT `the Board may register the premises` `an application with poor sanitation`
#ASSERT NOT `the Board may register the premises` `an application without the fee`

#ASSERT NOT `the applicant is entitled to registration` `a complete registration application`

§ `s 7`

#ASSERT `the Board may grant the licence` `a fit applicant who paid`
#ASSERT NOT `the Board may grant the licence` `an applicant not fit and proper`

#ASSERT `the licence is current in that year` 2027 2027
#ASSERT NOT `the licence is current in that year` 2027 2028

#ASSERT `the days the licence runs` 1 365 EQUALS 365
#ASSERT `the days the licence runs` 349 365 EQUALS 17

§ `ss 8, 9`

#ASSERT `the remedy period is lawful` 1
#ASSERT NOT `the remedy period is lawful` 0.5

#ASSERT `the Board may suspend or cancel for insanitary condition` TRUE 1 TRUE FALSE
#ASSERT NOT `the Board may suspend or cancel for insanitary condition` TRUE 1 TRUE TRUE
#ASSERT NOT `the Board may suspend or cancel for insanitary condition` TRUE 1 FALSE FALSE

#ASSERT NOT `the section 8 suspension or cancellation has taken effect` 5 FALSE FALSE FALSE
#ASSERT `the section 8 suspension or cancellation has taken effect` 11 FALSE FALSE FALSE
#ASSERT NOT `the section 8 suspension or cancellation has taken effect` 30 TRUE TRUE FALSE
#ASSERT `the section 8 suspension or cancellation has taken effect` 30 TRUE TRUE TRUE

#ASSERT `the Board must cancel licence and registration` TRUE

§ `s 11`

#ASSERT `an appeal to the Minister is in time` `refusal to register premises` 7
#ASSERT `an appeal to the Minister is in time` `refusal to grant or renew a licence` 10
#ASSERT NOT `an appeal to the Minister is in time` `section 8 cancellation of a licence` 14
#ASSERT NOT `an appeal to the Minister is in time` `section 9 cancellation on conviction` 2
#ASSERT NOT `an appeal to the Minister is in time` `reclassification to a lower class` 2

§ `s 13`

#ASSERT `the licensee is liable for the act` TRUE TRUE FALSE
#ASSERT `the licensee is liable for the act` TRUE FALSE TRUE
#ASSERT NOT `the licensee is liable for the act` TRUE FALSE FALSE

§ `s 15`

#ASSERT `the entry is lawful` `a person authorised by the chairman in writing` FALSE TRUE TRUE FALSE
#ASSERT `the entry is lawful` `a member of the Board` TRUE FALSE TRUE FALSE
#ASSERT NOT `the entry is lawful` `a person authorised by the chairman orally` TRUE FALSE FALSE TRUE
#ASSERT NOT `the entry is lawful` `the chairman of the Board` FALSE FALSE FALSE TRUE

§ `s 16`

#ASSERT NOT `the person commits an offence under the Act` `a registered and licensed keeper`
#ASSERT `the person commits an offence under the Act` `a keeper of an unregistered hotel`
#ASSERT `the person commits an offence under the Act` `an unlicensed keeper of a registered hotel`
#ASSERT `the person commits an offence under the Act` `an owner letting an unlicensed manager run the hotel`
#ASSERT NOT `the person commits an offence under the Act` `a keeper of exempted premises with no papers`
#ASSERT `the person commits an offence under the Act` `an applicant who made a false statement unknowingly`
#ASSERT NOT `the person commits an offence under the Act` `an agent who used a false statement unknowingly`
#ASSERT `the person commits an offence under the Act` `an agent who used a false statement knowingly`

#ASSERT `the maximum fine` 3 EQUALS 2000

#ASSERT `the maximum imprisonment in months` 0 EQUALS 0
