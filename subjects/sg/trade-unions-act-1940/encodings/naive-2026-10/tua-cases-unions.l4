`an ordinary citizen member` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS FALSE
    `convicted of an offence involving fraud or dishonesty` IS FALSE
    `the Minister is satisfied the person has reformed` IS FALSE
    `the Minister has approved` IS FALSE
    `is a citizen of Singapore` IS TRUE
    `holds the office of president, chairman, treasurer or secretary` IS FALSE

`an undischarged bankrupt citizen` MEANS Candidate WITH
    `is an undischarged bankrupt` IS TRUE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS FALSE
    `convicted of an offence involving fraud or dishonesty` IS FALSE
    `the Minister is satisfied the person has reformed` IS FALSE
    `the Minister has approved` IS TRUE
    `is a citizen of Singapore` IS TRUE
    `holds the office of president, chairman, treasurer or secretary` IS FALSE

`a reformed breach-of-trust convict` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS TRUE
    `convicted of an offence involving fraud or dishonesty` IS TRUE
    `the Minister is satisfied the person has reformed` IS TRUE
    `the Minister has approved` IS FALSE
    `is a citizen of Singapore` IS TRUE
    `holds the office of president, chairman, treasurer or secretary` IS FALSE

`an unreformed extortion convict` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS TRUE
    `convicted of an offence involving fraud or dishonesty` IS FALSE
    `the Minister is satisfied the person has reformed` IS FALSE
    `the Minister has approved` IS FALSE
    `is a citizen of Singapore` IS TRUE
    `holds the office of president, chairman, treasurer or secretary` IS FALSE

`a non-citizen without approval` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS FALSE
    `convicted of an offence involving fraud or dishonesty` IS FALSE
    `the Minister is satisfied the person has reformed` IS FALSE
    `the Minister has approved` IS FALSE
    `is a citizen of Singapore` IS FALSE
    `holds the office of president, chairman, treasurer or secretary` IS FALSE

`a non-citizen with the Minister's approval` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS FALSE
    `convicted of an offence involving fraud or dishonesty` IS FALSE
    `the Minister is satisfied the person has reformed` IS FALSE
    `the Minister has approved` IS TRUE
    `is a citizen of Singapore` IS FALSE
    `holds the office of president, chairman, treasurer or secretary` IS FALSE

`the union's treasurer` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS FALSE
    `convicted of an offence involving fraud or dishonesty` IS FALSE
    `the Minister is satisfied the person has reformed` IS FALSE
    `the Minister has approved` IS FALSE
    `is a citizen of Singapore` IS TRUE
    `holds the office of president, chairman, treasurer or secretary` IS TRUE

`a fraud convict approved by the Minister` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `convicted of criminal breach of trust, extortion or criminal intimidation` IS FALSE
    `convicted of an offence involving fraud or dishonesty` IS TRUE
    `the Minister is satisfied the person has reformed` IS FALSE
