<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_part_4_general" name="Part 4 -- General" namespace="https://legalese.com/l4/dmn/part_4_general" exporter="jl4">
  <inputData id="input_c" name="c">
    <variable id="input_c_var" name="c" typeRef="Any"/>
  </inputData>
  <inputData id="input_s" name="s">
    <variable id="input_s_var" name="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_regulations_made_under_section_11_or_43_provide_to_the_contrary" name="regulations_made_under_section_11_or_43_provide_to_the_contrary" label="regulations made under section 11 or 43 provide to the contrary">
    <variable id="input_regulations_made_under_section_11_or_43_provide_to_the_contrary_var" name="regulations_made_under_section_11_or_43_provide_to_the_contrary" label="regulations made under section 11 or 43 provide to the contrary" typeRef="boolean"/>
  </inputData>
  <inputData id="input_p" name="p">
    <variable id="input_p_var" name="p" typeRef="Any"/>
  </inputData>
  <inputData id="input_p_2" name="p_2" label="p">
    <variable id="input_p_2_var" name="p_2" label="p" typeRef="Any"/>
  </inputData>
  <inputData id="input_d" name="d">
    <variable id="input_d_var" name="d" typeRef="Any"/>
  </inputData>
  <inputData id="input_b" name="b">
    <variable id="input_b_var" name="b" typeRef="Any"/>
  </inputData>
  <inputData id="input_t" name="t">
    <variable id="input_t_var" name="t" typeRef="Any"/>
  </inputData>
  <decision id="decision_the_contract_term_is_void_to_the_extent_that_it_is_inconsistent_with_the_act" name="the_contract_term_is_void_to_the_extent_that_it_is_inconsistent_with_the_Act" label="the contract term is void to the extent that it is inconsistent with the Act">
    <variable id="decision_the_contract_term_is_void_to_the_extent_that_it_is_inconsistent_with_the_act_var" name="the_contract_term_is_void_to_the_extent_that_it_is_inconsistent_with_the_Act" label="the contract term is void to the extent that it is inconsistent with the Act" typeRef="boolean"/>
    <informationRequirement id="decision_the_contract_term_is_void_to_the_extent_that_it_is_inconsistent_with_the_act_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_contract_term_is_void_to_the_extent_that_it_is_inconsistent_with_the_act_literal">
      <text>c.the_term_is_contained_in_a_contract_or_is_an_agreement_to_the_contrary and (c.the_term_is_inconsistent_with_the_provisions_of_the_Act and not(c.the_release_was_made_by_a_person_in_settlement_of_a_dispute))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_waiver_or_release_is_void" name="the_waiver_or_release_is_void" label="the waiver or release is void">
    <variable id="decision_the_waiver_or_release_is_void_var" name="the_waiver_or_release_is_void" label="the waiver or release is void" typeRef="boolean"/>
    <informationRequirement id="decision_the_waiver_or_release_is_void_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_waiver_or_release_is_void_literal">
      <text>c.the_term_is_a_waiver_or_release_of_a_right_benefit_or_protection_conferred_under_the_Act and not(c.the_release_was_made_by_a_person_in_settlement_of_a_dispute)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_individual_has_the_same_rights_as_the_consumer_to_seek_and_obtain_redress_from_the_supplier" name="the_individual_has_the_same_rights_as_the_consumer_to_seek_and_obtain_redress_from_the_supplier" label="the individual has the same rights as the consumer to seek and obtain redress from the supplier">
    <variable id="decision_the_individual_has_the_same_rights_as_the_consumer_to_seek_and_obtain_redress_from_the_supplier_var" name="the_individual_has_the_same_rights_as_the_consumer_to_seek_and_obtain_redress_from_the_supplier" label="the individual has the same rights as the consumer to seek and obtain redress from the supplier" typeRef="boolean"/>
    <informationRequirement id="decision_the_individual_has_the_same_rights_as_the_consumer_to_seek_and_obtain_redress_from_the_supplier_ir1">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_the_individual_has_the_same_rights_as_the_consumer_to_seek_and_obtain_redress_from_the_supplier_literal">
      <text>s.the_individual_is_an_heir_or_assignee_of_a_consumer and (s.the_individual_receives_goods_or_services and not(s.the_individual_receives_them_in_the_course_of_business))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_act_restricts_limits_or_derogates_from_a_right_or_remedy_the_consumer_has_apart_from_the_act" name="the_Act_restricts_limits_or_derogates_from_a_right_or_remedy_the_consumer_has_apart_from_the_Act" label="the Act restricts, limits or derogates from a right or remedy the consumer has apart from the Act">
    <variable id="decision_the_act_restricts_limits_or_derogates_from_a_right_or_remedy_the_consumer_has_apart_from_the_act_var" name="the_Act_restricts_limits_or_derogates_from_a_right_or_remedy_the_consumer_has_apart_from_the_Act" label="the Act restricts, limits or derogates from a right or remedy the consumer has apart from the Act" typeRef="boolean"/>
    <informationRequirement id="decision_the_act_restricts_limits_or_derogates_from_a_right_or_remedy_the_consumer_has_apart_from_the_act_ir1">
      <requiredInput href="#input_regulations_made_under_section_11_or_43_provide_to_the_contrary"/>
    </informationRequirement>
    <literalExpression id="decision_the_act_restricts_limits_or_derogates_from_a_right_or_remedy_the_consumer_has_apart_from_the_act_literal">
      <text>regulations_made_under_section_11_or_43_provide_to_the_contrary</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_not_liable_under_the_act_in_respect_of_the_advertisement" name="the_person_is_not_liable_under_the_Act_in_respect_of_the_advertisement" label="the person is not liable under the Act in respect of the advertisement">
    <variable id="decision_the_person_is_not_liable_under_the_act_in_respect_of_the_advertisement_var" name="the_person_is_not_liable_under_the_Act_in_respect_of_the_advertisement" label="the person is not liable under the Act in respect of the advertisement" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_not_liable_under_the_act_in_respect_of_the_advertisement_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_not_liable_under_the_act_in_respect_of_the_advertisement_literal">
      <text>p.the_person_prints_publishes_distributes_broadcasts_or_telecasts_an_advertisement_on_behalf_of_a_supplier and (p.the_person_does_so_in_good_faith and p.the_person_does_so_in_the_ordinary_course_of_the_person_s_business)</text>
    </literalExpression>
  </decision>
  <decision id="decision_section_39_makes_the_parol_or_extrinsic_evidence_admissible" name="section_39_makes_the_parol_or_extrinsic_evidence_admissible" label="section 39 makes the parol or extrinsic evidence admissible">
    <variable id="decision_section_39_makes_the_parol_or_extrinsic_evidence_admissible_var" name="section_39_makes_the_parol_or_extrinsic_evidence_admissible" label="section 39 makes the parol or extrinsic evidence admissible" typeRef="boolean"/>
    <informationRequirement id="decision_section_39_makes_the_parol_or_extrinsic_evidence_admissible_ir1">
      <requiredInput href="#input_p_2"/>
    </informationRequirement>
    <literalExpression id="decision_section_39_makes_the_parol_or_extrinsic_evidence_admissible_literal">
      <text>p_2.the_evidence_is_parol_or_extrinsic_evidence_establishing_the_existence_of_an_express_warranty and (p_2.the_action_relates_to_a_consumer_transaction_between_a_consumer_and_a_supplier and not(p_2.the_goods_or_services_are_intended_for_business_use))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_provision_must_be_interpreted_against_the_supplier" name="the_provision_must_be_interpreted_against_the_supplier" label="the provision must be interpreted against the supplier">
    <variable id="decision_the_provision_must_be_interpreted_against_the_supplier_var" name="the_provision_must_be_interpreted_against_the_supplier" label="the provision must be interpreted against the supplier" typeRef="boolean"/>
    <informationRequirement id="decision_the_provision_must_be_interpreted_against_the_supplier_ir1">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_the_provision_must_be_interpreted_against_the_supplier_literal">
      <text>d.a_consumer_and_a_supplier_enter_into_a_consumer_transaction and (d.all_or_part_of_the_transaction_or_contract_is_evidenced_by_a_document_provided_by_the_supplier and d.a_provision_of_the_document_is_ambiguous)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_burden_of_proving_compliance_is_on_the_supplier" name="the_burden_of_proving_compliance_is_on_the_supplier" label="the burden of proving compliance is on the supplier">
    <variable id="decision_the_burden_of_proving_compliance_is_on_the_supplier_var" name="the_burden_of_proving_compliance_is_on_the_supplier" label="the burden of proving compliance is on the supplier" typeRef="boolean"/>
    <informationRequirement id="decision_the_burden_of_proving_compliance_is_on_the_supplier_ir1">
      <requiredInput href="#input_b"/>
    </informationRequirement>
    <literalExpression id="decision_the_burden_of_proving_compliance_is_on_the_supplier_literal">
      <text>b.the_proceedings_are_taken_in_a_court_between_a_consumer_and_a_supplier_in_relation_to_a_consumer_transaction and (b.a_dispute_arises_as_to_whether_the_supplier_has_complied_with_a_requirement and b.the_requirement_is_specified_by_regulations_made_under_section_41_2)</text>
    </literalExpression>
  </decision>
  <decision id="decision_no_orders_under_section_42_amending_the_schedules_after_the_date_of_the_printed_text_are_encoded_in_this_model" name="no_orders_under_section_42_amending_the_Schedules_after_the_date_of_the_printed_text_are_encoded_in_this_model" label="no orders under section 42 amending the Schedules after the date of the printed text are encoded in this model">
    <description>REFUSE: no orders under section 42 amending the Schedules after the date of the printed text are encoded in this model</description>
    <variable id="decision_no_orders_under_section_42_amending_the_schedules_after_the_date_of_the_printed_text_are_encoded_in_this_model_var" name="no_orders_under_section_42_amending_the_Schedules_after_the_date_of_the_printed_text_are_encoded_in_this_model" label="no orders under section 42 amending the Schedules after the date of the printed text are encoded in this model" typeRef="boolean"/>
    <literalExpression id="decision_no_orders_under_section_42_amending_the_schedules_after_the_date_of_the_printed_text_are_encoded_in_this_model_literal">
      <text>null</text>
    </literalExpression>
  </decision>
  <decision id="decision_no_regulations_under_section_43_are_encoded_in_this_model" name="no_regulations_under_section_43_are_encoded_in_this_model" label="no regulations under section 43 are encoded in this model">
    <description>REFUSE: no regulations under section 43 are encoded in this model</description>
    <variable id="decision_no_regulations_under_section_43_are_encoded_in_this_model_var" name="no_regulations_under_section_43_are_encoded_in_this_model" label="no regulations under section 43 are encoded in this model" typeRef="boolean"/>
    <literalExpression id="decision_no_regulations_under_section_43_are_encoded_in_this_model_literal">
      <text>null</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_commission_may_continue_the_matter_as_if_it_had_commenced_it" name="the_Commission_may_continue_the_matter_as_if_it_had_commenced_it" label="the Commission may continue the matter as if it had commenced it">
    <variable id="decision_the_commission_may_continue_the_matter_as_if_it_had_commenced_it_var" name="the_Commission_may_continue_the_matter_as_if_it_had_commenced_it" label="the Commission may continue the matter as if it had commenced it" typeRef="boolean"/>
    <informationRequirement id="decision_the_commission_may_continue_the_matter_as_if_it_had_commenced_it_ir1">
      <requiredInput href="#input_t"/>
    </informationRequirement>
    <literalExpression id="decision_the_commission_may_continue_the_matter_as_if_it_had_commenced_it_literal">
      <text>t's `the matter was commenced or made by, or in relation to, the Standards, Productivity and Innovation Board` AND (t's `the date on which it was commenced or made`) LESS THAN (YMD OF 2018, 4, 2) AND t's `it is pending, or the order remains unsatisfied, on 2 April 2018` AND (CONSIDER t's `kind of matter` WHEN `proceedings for a declaration or an injunction under section 9 or 10` THEN TRUE WHEN `an investigation under Part 3A` THEN TRUE WHEN `an order of the District Court or the High Court under section 9 or 10 requiring a person to notify, inform, reimburse or do anything in relation to the Board` THEN FALSE)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_unsatisfied_order_is_satisfied" name="the_unsatisfied_order_is_satisfied" label="the unsatisfied order is satisfied">
    <variable id="decision_the_unsatisfied_order_is_satisfied_var" name="the_unsatisfied_order_is_satisfied" label="the unsatisfied order is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_the_unsatisfied_order_is_satisfied_ir1">
      <requiredInput href="#input_t"/>
    </informationRequirement>
    <literalExpression id="decision_the_unsatisfied_order_is_satisfied_literal">
      <text>t's `the matter was commenced or made by, or in relation to, the Standards, Productivity and Innovation Board` AND (t's `the date on which it was commenced or made`) LESS THAN (YMD OF 2018, 4, 2) AND t's `it is pending, or the order remains unsatisfied, on 2 April 2018` AND t's `the person notifies, informs, reimburses or does the thing in relation to the Commission` AND (CONSIDER t's `kind of matter` WHEN `an order of the District Court or the High Court under section 9 or 10 requiring a person to notify, inform, reimburse or do anything in relation to the Board` THEN TRUE OTHERWISE FALSE)</text>
    </literalExpression>
  </decision>
