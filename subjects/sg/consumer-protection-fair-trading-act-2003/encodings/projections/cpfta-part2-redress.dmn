  <decision id="decision_the_event_is_a_notifiable_event" name="the_event_is_a_notifiable_event" label="the event is a notifiable event">
    <variable id="decision_the_event_is_a_notifiable_event_var" name="the_event_is_a_notifiable_event" label="the event is a notifiable event" typeRef="boolean"/>
    <informationRequirement id="decision_the_event_is_a_notifiable_event_ir1">
      <requiredInput href="#input_e_5"/>
    </informationRequirement>
    <literalExpression id="decision_the_event_is_a_notifiable_event_literal">
      <text>CONSIDER e WHEN `the individual, as a sole proprietor, commences carrying on business as a supplier` THEN TRUE WHEN `the individual is employed or ceases to be employed by a person who carries on a business as a supplier` THEN TRUE WHEN `the individual becomes or ceases to be a director of a company which carries on a business as a supplier` THEN TRUE WHEN `the individual becomes or ceases to be a partner in a partnership or limited partnership which carries on a business as a supplier` THEN TRUE WHEN `the individual becomes or ceases to be a partner or manager of a limited liability partnership which carries on a business as a supplier` THEN TRUE WHEN `the individual becomes or ceases to be interested in voting power or issued shares in a company which carries on a business as a supplier` pct THEN pct AT LEAST 15</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_specified_periods_of_the_orders_in_section_9_4_a_to_d_are_the_same" name="the_specified_periods_of_the_orders_in_section_9_4_a_to_d_are_the_same" label="the specified periods of the orders in section 9(4)(a) to (d) are the same">
    <variable id="decision_the_specified_periods_of_the_orders_in_section_9_4_a_to_d_are_the_same_var" name="the_specified_periods_of_the_orders_in_section_9_4_a_to_d_are_the_same" label="the specified periods of the orders in section 9(4)(a) to (d) are the same" typeRef="boolean"/>
    <informationRequirement id="decision_the_specified_periods_of_the_orders_in_section_9_4_a_to_d_are_the_same_ir1">
      <requiredInput href="#input_o"/>
    </informationRequirement>
    <literalExpression id="decision_the_specified_periods_of_the_orders_in_section_9_4_a_to_d_are_the_same_literal">
      <text>CONSIDER o's `the periods specified for the orders mentioned in section 9(4)(a), (b), (c) and (d), in years` WHEN EMPTY THEN TRUE WHEN first FOLLOWED BY rest THEN all OF (GIVEN n YIELD n EQUALS first), rest</text>
    </literalExpression>
  </decision>
  <decision id="decision_every_specified_period_under_section_9_4_is_permitted" name="every_specified_period_under_section_9_4_is_permitted" label="every specified period under section 9(4) is permitted">
    <variable id="decision_every_specified_period_under_section_9_4_is_permitted_var" name="every_specified_period_under_section_9_4_is_permitted" label="every specified period under section 9(4) is permitted" typeRef="boolean"/>
    <informationRequirement id="decision_every_specified_period_under_section_9_4_is_permitted_ir1">
