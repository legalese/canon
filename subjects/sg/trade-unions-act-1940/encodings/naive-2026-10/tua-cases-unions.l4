IMPORT prelude
IMPORT `tua-unions`

-- Trade Unions Act 1940, ss 8, 17, 19, 22, 27, 28, 30, 37, 43, 47-49, 51(4), 59 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_trade-unions-act-1940.py). Expected results were written by
-- hand from the text.

`an ordinary strike with a bare majority` MEANS `Strike facts` WITH
    `the union is a combined federation` IS FALSE
    `members affected` IS 100
    `represented executives among them` IS 0
    `votes in favour` IS 51
    `most members are non-executive employees` IS TRUE
    `the dispute is between represented executives and their employer` IS FALSE
    `the union is recognised by the employer for those members` IS FALSE
    `the strike is within the union's rules` IS TRUE

`a strike with exactly half in favour` MEANS `Strike facts` WITH
    `the union is a combined federation` IS FALSE
    `members affected` IS 100
    `represented executives among them` IS 0
    `votes in favour` IS 50
    `most members are non-executive employees` IS TRUE
    `the dispute is between represented executives and their employer` IS FALSE
    `the union is recognised by the employer for those members` IS FALSE
    `the strike is within the union's rules` IS TRUE

