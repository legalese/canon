IMPORT prelude
IMPORT `wmfa-trade`

-- Wholesome Meat and Fish Act 1999, ss 2(2), 4(2), 5, 6, 9, 11, 17, 23, 31(1), 32, 39, 42(3) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_wholesome-meat-and-fish-act-1999.py). Expected results were written by
-- hand from the text.

`a compliant frozen beef import` MEANS Consignment WITH
    `the trader holds a section 5 licence` IS TRUE
    `has a permit for this consignment` IS TRUE
    `complies with the permit conditions` IS TRUE
    `conforms to the permit description` IS TRUE
    `meets the prescribed standards` IS TRUE
    `packaged and labelled as prescribed` IS TRUE
    `is meat` IS FALSE
    `derived from licensed slaughter or lawful import` IS FALSE
    `processed in a licensed processing establishment` IS FALSE
    `requires cold storage` IS FALSE
    `kept in a licensed cold store` IS FALSE
    `evidence it meets the destination country's requirements` IS FALSE

