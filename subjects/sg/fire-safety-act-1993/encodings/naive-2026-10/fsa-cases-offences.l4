IMPORT prelude
IMPORT `fsa-offences`

-- Fire Safety Act 1993, ss 2, 24-28, 35, 38, 40, 53, 56, 58, 60, 61, 101, 107 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_fire-safety-act-1993.py). Expected results were written by
-- hand from the text.

`a packed public hall with blocked exits risk` MEANS `Building condition` WITH
    `the building is a public building` IS TRUE
    `it is overcrowded` IS TRUE
    `a fire safety measure is not in proper working order` IS FALSE
    `an escape route, passageway or common property is obstructed` IS FALSE
    `escape in a fire might be made more difficult` IS TRUE

`a crowded private flat` MEANS `Building condition` WITH
    `the building is a public building` IS FALSE
    `it is overcrowded` IS TRUE
    `a fire safety measure is not in proper working order` IS FALSE
    `an escape route, passageway or common property is obstructed` IS FALSE
    `escape in a fire might be made more difficult` IS TRUE

`a broken sprinkler` MEANS `Building condition` WITH
    `the building is a public building` IS FALSE
    `it is overcrowded` IS FALSE
    `a fire safety measure is not in proper working order` IS TRUE
    `an escape route, passageway or common property is obstructed` IS FALSE
    `escape in a fire might be made more difficult` IS FALSE

`bicycles blocking a staircase` MEANS `Building condition` WITH
    `the building is a public building` IS FALSE
    `it is overcrowded` IS FALSE
    `a fire safety measure is not in proper working order` IS FALSE
    `an escape route, passageway or common property is obstructed` IS TRUE
    `escape in a fire might be made more difficult` IS TRUE

`a doormat in a wide corridor` MEANS `Building condition` WITH
    `the building is a public building` IS FALSE
    `it is overcrowded` IS FALSE
    `a fire safety measure is not in proper working order` IS FALSE
    `an escape route, passageway or common property is obstructed` IS TRUE
    `escape in a fire might be made more difficult` IS FALSE

`propping open a fire door knowingly` MEANS `Act or omission` WITH
    `it disables a fire safety measure` IS TRUE
    `it obstructs an escape route` IS FALSE
    `the obstruction might make escape more difficult` IS FALSE
    `the obstruction can easily be removed by someone escaping` IS FALSE
    `the person knew or ought to have known the effect` IS TRUE

`disabling a smoke detector unknowingly` MEANS `Act or omission` WITH
    `it disables a fire safety measure` IS TRUE
    `it obstructs an escape route` IS FALSE
    `the obstruction might make escape more difficult` IS FALSE
    `the obstruction can easily be removed by someone escaping` IS FALSE
    `the person knew or ought to have known the effect` IS FALSE

`storing a cupboard in the stairwell` MEANS `Act or omission` WITH
    `it disables a fire safety measure` IS FALSE
    `it obstructs an escape route` IS TRUE
    `the obstruction might make escape more difficult` IS TRUE
    `the obstruction can easily be removed by someone escaping` IS FALSE
    `the person knew or ought to have known the effect` IS TRUE

`leaving a light chair in the stairwell` MEANS `Act or omission` WITH
    `it disables a fire safety measure` IS FALSE
    `it obstructs an escape route` IS TRUE
    `the obstruction might make escape more difficult` IS TRUE
    `the obstruction can easily be removed by someone escaping` IS TRUE
    `the person knew or ought to have known the effect` IS TRUE

§ `s 2 -- specified fire hazard`

#ASSERT `there is a specified fire hazard` `a packed public hall with blocked exits risk`
#ASSERT NOT `there is a specified fire hazard` `a crowded private flat`
#ASSERT `there is a specified fire hazard` `a broken sprinkler`
#ASSERT `there is a specified fire hazard` `bicycles blocking a staircase`
#ASSERT NOT `there is a specified fire hazard` `a doormat in a wide corridor`

§ `ss 24, 25`

#ASSERT `commits a hydrant offence` FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `commits a hydrant offence` FALSE TRUE FALSE TRUE FALSE
#ASSERT NOT `commits a hydrant offence` TRUE TRUE FALSE FALSE FALSE
#ASSERT `commits a hydrant offence` TRUE FALSE FALSE FALSE TRUE

#ASSERT NOT `is also liable to compensate the PUB` FALSE

#ASSERT `commits the false alarm offence` `an ambulance` TRUE TRUE TRUE
#ASSERT NOT `commits the false alarm offence` `a fire` TRUE FALSE TRUE
#ASSERT `commits the false alarm offence` `another Force service` TRUE TRUE TRUE

§ `ss 26, 27`

#ASSERT `commits the s 26(1) offence` TRUE TRUE FALSE
#ASSERT NOT `commits the s 26(1) offence` FALSE TRUE TRUE

#ASSERT `commits the s 26(2) offence` TRUE TRUE FALSE
#ASSERT NOT `commits the s 26(2) offence` TRUE TRUE TRUE

#ASSERT `commits the s 27 offence` `propping open a fire door knowingly`
#ASSERT NOT `commits the s 27 offence` `disabling a smoke detector unknowingly`
#ASSERT `commits the s 27 offence` `storing a cupboard in the stairwell`
#ASSERT NOT `commits the s 27 offence` `leaving a light chair in the stairwell`

§ `s 28(5)`

#ASSERT `commits the abatement notice offence` TRUE FALSE TRUE FALSE
#ASSERT `commits the abatement notice offence` TRUE TRUE FALSE FALSE
#ASSERT NOT `commits the abatement notice offence` TRUE TRUE TRUE FALSE

§ `ss 35, 38, 40`

#ASSERT `commits the fire certificate offence` TRUE TRUE FALSE FALSE
#ASSERT NOT `commits the fire certificate offence` TRUE TRUE TRUE FALSE

#ASSERT `the premises are at-risk premises` FALSE TRUE
#ASSERT NOT `the premises are at-risk premises` FALSE FALSE

#ASSERT NOT `counts as an owner or occupier` `Part 3` TRUE TRUE TRUE
#ASSERT `counts as an owner or occupier` `Part 2` TRUE TRUE TRUE
#ASSERT `counts as an owner or occupier` `Part 3` TRUE FALSE TRUE

§ `ss 53, 56, 58, 60, 61`

#ASSERT `commits the s 53 offence` TRUE FALSE
#ASSERT NOT `commits the s 53 offence` TRUE TRUE

#ASSERT `commits the unapproved works offence` TRUE TRUE FALSE
#ASSERT NOT `commits the unapproved works offence` TRUE TRUE TRUE

#ASSERT `commits the unsupervised works offence` TRUE FALSE
#ASSERT NOT `commits the unsupervised works offence` TRUE TRUE

#ASSERT `the Commissioner may revoke the fire safety certificate` TRUE TRUE TRUE
#ASSERT NOT `the Commissioner may revoke the fire safety certificate` TRUE TRUE FALSE

#ASSERT `the revocation date is lawful` 1 15
#ASSERT NOT `the revocation date is lawful` 1 14

#ASSERT `commits the change of use offence` TRUE TRUE FALSE
#ASSERT NOT `commits the change of use offence` TRUE FALSE FALSE

§ `ss 101, 107 and stated penalties`

#ASSERT `the maximum fine` `a false alarm` EQUALS 5000
#ASSERT `the maximum fine` `causing a specified fire hazard as owner or occupier` EQUALS 10000
#ASSERT `the maximum fine` `failing to install ordered fire safety measures` EQUALS 50000

#ASSERT `the maximum imprisonment in months` `a false alarm` EQUALS 3
#ASSERT `the maximum imprisonment in months` `occupying without a fire certificate` EQUALS 6
#ASSERT `the maximum imprisonment in months` `change of use without approval` EQUALS 24

#ASSERT `the daily fine for a continuing offence` `fire safety works without supervision` EQUALS 2000
#ASSERT `the daily fine for a continuing offence` `fire safety works without approved plans` EQUALS 1000

#ASSERT `the maximum composition sum` `a false alarm` TRUE EQUALS 2500
#ASSERT `the maximum composition sum` `removing a hydrant plate` TRUE EQUALS 500
#ASSERT `the maximum composition sum` `fire safety works without approved plans` TRUE EQUALS 5000
#ASSERT `the maximum composition sum` `a false alarm` FALSE EQUALS 0

