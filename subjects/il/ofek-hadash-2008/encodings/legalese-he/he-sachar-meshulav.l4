-- תיקון 19.3.2017 סעיף 2(ה): תשע מדרגות, שמונה נקובות ואחת שיורית.
#ASSERT `מדרגת התוספת השקלית לדרגה` `דרגה 1`   EQUALS `מדרגת דרגה 1`
#ASSERT `מדרגת התוספת השקלית לדרגה` `דרגה 4.5` EQUALS `מדרגת דרגה 4.5`
#ASSERT `מדרגת התוספת השקלית לדרגה` `דרגה 5`   EQUALS `מדרגת יתר עובדי ההוראה`
#ASSERT `מדרגת התוספת השקלית לדרגה` `דרגה 9`   EQUALS `מדרגת יתר עובדי ההוראה`

-- שלושת הסכומים, מחוברים אל `he-tavlaot`. הבדיקות שלהלן אינן בודקות את
-- הטבלאות — אלה נבדקות אצלן — אלא את התפר: שהשיבוץ שהמודול הזה מחשב
-- מוליך אל הנספח הנכון, ואל התא הנכון בתוכו.
--
-- דנה היא מקרה C1 שבתוכנית, ונועם מקרה C2. שני המספרים שהתוכנית נקבה
-- בהם — 6,300.00 ו־6,615.00 — יוצאים כאן משני מודולים שנכתבו בנפרד
-- ושלא ראו זה את זה. זו ההצלבה החזקה ביותר שיש בקידוד הזה.
#ASSERT `השכר המשולב במשרה מלאה של` `דנה`  EQUALS 6300
#ASSERT `השכר המשולב במשרה מלאה של` `נועם` EQUALS 6615
#ASSERT `השכר המשולב של` `דנה` `בחלקיות משרה` 0.5 EQUALS 3150

-- מקרה C11: בעל תואר שלישי בטבלת בעלי תואר שני, דרגה 6 ותק 14.
#ASSERT `השכר המשולב במשרה מלאה של` `יונתן` EQUALS 11466.29

-- מקרה C12, והוא מאשר את הכרעת פיצול F3: אורית יושבת על דרגה 4.5, ולכן
-- נפתרת בנספח א'3 ולא בנספח א'1. שני הסכומים הנלווים שהתוכנית נקבה
-- בהם למקרה הזה — 710.54 ו־749.54 — יוצאים כאן בדיוק.
#ASSERT `תוספת אופק 2022 במשרה מלאה של` `אורית` `בתקופה` `התקופה בשנת הלימודים תשפו` EQUALS 710.54
#ASSERT `תוספת שקלית 2016 במשרה מלאה של` `אורית` EQUALS 749.54

-- תוספת שקלית 2016: הסכום למשרה מלאה, ופיצול F-C בפעולה על חצי משרה.
#ASSERT `תוספת שקלית 2016 במשרה מלאה של` `דנה` EQUALS 1280.34
#ASSERT `תוספת שקלית 2016 של` `דנה` `בחלקיות משרה` 0.5 EQUALS 640.17

-- ממצא במחלוקת של 0.46 ש"ח. תוכנית הקידוד נקבה במקרה C1 בסכום 1,586
-- לתוספת אופק 2022, שהוא ההדפסה בשקלים שלמים; `he-tavlaot` נשען על
-- ההדפסה באגורות שהחלטת ועדת המעקב מיום 14.1.2025 תיקנה אליה, והיא
-- נוקבת 1,585.54. ההפרש אינו טעות באף אחד מן השניים אלא שתי הדפסות של
-- אותה זכאות, וההחלטה מ־2025 קיימת בדיוק כדי להעדיף את המדויקת. הבדיקה
-- נכתבת על הערך שהמודול מוסר בפועל, והפער נרשם ולא מומחק.
#ASSERT `תוספת אופק 2022 במשרה מלאה של` `דנה` `בתקופה` `התקופה בשנת הלימודים תשפו` EQUALS 1585.54

-- פיצול F2: הבסיס הוא שכר משולב ועוד תוספת אופק 2022, ובלי התוספת
-- השקלית — שסעיף 1(ז) לחוזר תשעז/3 מוציא ממנו במפורש. 6,300 ועוד
-- 1,585.54, ולא ועוד 1,280.34 נוספים.
#ASSERT `בסיס התוספות האחוזיות של` `דנה` `בתקופה` `התקופה בשנת הלימודים תשפו` `בחלקיות משרה` 1 EQUALS 7885.54

-- סעיף 36(ד)(2): חמישה אחוזים מן השכר הטבלאי, ולא מבסיס הגמולים.
-- 11,466.29 כפול 5% הם 573.3145, ולא 5% מ־7,885.54.
#ASSERT `תוספת תואר שלישי של` `יונתן` `בחלקיות משרה` 1 EQUALS 573.3145

-- מי שאינו בעל תואר שלישי אינו מגיע אל הטבלה כלל, ולכן התשובה היא אפס
-- ולא סירוב: סעיף 36(ד) אינו חל עליו.
#ASSERT `תוספת תואר שלישי של` `דנה` `בחלקיות משרה` 1 EQUALS 0

-- ולבסוף, מה שהתפר לא ביטל: הסירובים שמקורם בחוק ולא במודול חסר.
-- טבלאות השכר מודפסות לשורות ותק 1 עד 36, ומעבר להן אין תא.
#ASSERT REFUSED (`נוסחת תוספת שמירת השכר אינה בקורפוס`)

-- שני כללי סעיפים 38(י) ו־38(יא), כלשונם.
#ASSERT `המשובצים בהמרה נספרים לתוך המכסה`
#ASSERT `שיבוץ בהמרה אינו נמנע בשל המכסה`

-- התפר אל `he-mishra`: שבוע 26/5/5 ברצועת הגיל שמתחת ל־50 הוא משרה
-- מלאה לפי סולם נספח א', ולכן המנה היא 1 והתוספת אינה מצטמצמת.
#ASSERT `חלקיות משרתו של` `דנה` EQUALS 1
#ASSERT `תוספת אופק 2022 של` `דנה` `בתקופה` `התקופה בשנת הלימודים תשפו` `לפי היקף משרתו` EQUALS 1585.54
