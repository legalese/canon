#ASSERT `Annex 7(41) — glomerulonephritis with nephrotic syndrome` (`Findings: glomerulonephritis with nephrotic syndrome` WITH `diagnosed and treated by a specialist` IS TRUE, `continuous months of nephrotic syndrome` IS 6)
#ASSERT NOT `Annex 7(41) — glomerulonephritis with nephrotic syndrome` (`Findings: glomerulonephritis with nephrotic syndrome` WITH `diagnosed and treated by a specialist` IS TRUE, `continuous months of nephrotic syndrome` IS 5)

§§ `Annex 7(42) — severe hand, foot and mouth disease`
#ASSERT `Annex 7(42) — severe hand, foot and mouth disease` (`Findings: severe hand, foot and mouth disease` WITH `diagnosed by a specialist` IS TRUE, `treated in an intensive care unit` IS TRUE, `the complication treated` IS `acute paralysis`)
#ASSERT NOT `Annex 7(42) — severe hand, foot and mouth disease` (`Findings: severe hand, foot and mouth disease` WITH `diagnosed by a specialist` IS TRUE, `treated in an intensive care unit` IS TRUE, `the complication treated` IS `another complication`)
#ASSERT NOT `Annex 7(42) — severe hand, foot and mouth disease` (`Findings: severe hand, foot and mouth disease` WITH `diagnosed by a specialist` IS TRUE, `treated in an intensive care unit` IS FALSE, `the complication treated` IS `acute paralysis`)

§§ `Annex 7(43) — Wilson disease`
#ASSERT `Annex 7(43) — Wilson disease` (`Findings: Wilson disease` WITH `diagnosed by a specialist` IS TRUE, `months of copper-chelation treatment` IS 6)
#ASSERT NOT `Annex 7(43) — Wilson disease` (`Findings: Wilson disease` WITH `diagnosed by a specialist` IS TRUE, `months of copper-chelation treatment` IS 5)

§§ `Annex 7(44) — generalised tetanus`
#ASSERT `Annex 7(44) — generalised tetanus` (`Findings: generalised tetanus` WITH `diagnosis established by a specialist` IS TRUE, `days of continuous mechanical ventilation` IS 3, `treated with tetanus immune serum` IS TRUE)
#ASSERT NOT `Annex 7(44) — generalised tetanus` (`Findings: generalised tetanus` WITH `diagnosis established by a specialist` IS TRUE, `days of continuous mechanical ventilation` IS 2, `treated with tetanus immune serum` IS TRUE)

§§ `Annex 7(45) — status epilepticus`
#ASSERT `Annex 7(45) — status epilepticus` (`Findings: status epilepticus` WITH `continuous generalised convulsive seizure, or several without recovery of consciousness between them` IS TRUE, `needing intubation and ventilation to sustain life` IS TRUE, `confirmed by a specialist with medical records and an EEG` IS TRUE)
#ASSERT NOT `Annex 7(45) — status epilepticus` (`Findings: status epilepticus` WITH `continuous generalised convulsive seizure, or several without recovery of consciousness between them` IS TRUE, `needing intubation and ventilation to sustain life` IS FALSE, `confirmed by a specialist with medical records and an EEG` IS TRUE)

