IMPORT prelude
IMPORT `cll-careshield`

-- CareShield Life and Long-Term Care Act 2019, ss 6, 12, 14-16, 18, 20, 25, 28, 29, 48, 50, 56, 58 and First and Fourth Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_careshield-life-and-long-term-care-act-2019.py). Expected results were written by
-- hand from the text.

§ `First and Fourth Schedules`

#ASSERT `the person is severely disabled` 3
#ASSERT NOT `the person is severely disabled` 2

#ASSERT `the person is not disabled` 0
#ASSERT NOT `the person is not disabled` 1

§ `s 6(1)(a), (b)`

#ASSERT `CareShield Life applies automatically` TRUE TRUE 30 FALSE FALSE 0 0
#ASSERT NOT `CareShield Life applies automatically` TRUE TRUE 29 FALSE FALSE 0 0
#ASSERT `CareShield Life applies automatically` TRUE TRUE 35 FALSE FALSE 5 6
#ASSERT NOT `CareShield Life applies automatically` TRUE FALSE 50 FALSE FALSE 0 0
#ASSERT `CareShield Life applies automatically` TRUE FALSE 50 TRUE TRUE 0 0
#ASSERT NOT `CareShield Life applies automatically` TRUE FALSE 50 TRUE TRUE 0 1
#ASSERT `CareShield Life applies automatically` TRUE FALSE 50 TRUE FALSE 0 1
#ASSERT NOT `CareShield Life applies automatically` TRUE FALSE 50 TRUE FALSE 3 3

§ `ss 12, 16(4), 18(7)`

#ASSERT `is entitled to the insured sum` TRUE 3 TRUE FALSE
#ASSERT NOT `is entitled to the insured sum` TRUE 4 TRUE TRUE

#ASSERT `the Board may pay the insured sum` TRUE FALSE 1 FALSE
#ASSERT NOT `the Board may pay the insured sum` TRUE FALSE 1 TRUE
#ASSERT NOT `the Board may pay the insured sum` TRUE TRUE 4 FALSE

#ASSERT NOT `the Administrator may refuse the claim` 3 TRUE TRUE FALSE
#ASSERT `the Administrator may refuse the claim` 2 TRUE TRUE FALSE
#ASSERT `the Administrator may refuse the claim` 4 TRUE TRUE TRUE

§ `ss 14(3), 29(3)`

#ASSERT `the premium is paid in time` 30 0
#ASSERT NOT `the premium is paid in time` 31 0
#ASSERT `the premium is paid in time` 45 60

#ASSERT `the most the late-payment penalties can total` 1000 0 EQUALS 170
#ASSERT `the most the late-payment penalties can total` 400 100 EQUALS 85

§ `s 15(3), (5)`

#ASSERT `may be a proper claimant` `the personal representative`
#ASSERT `may be a proper claimant` `a step-parent`
#ASSERT NOT `may be a proper claimant` `a cousin`
#ASSERT NOT `may be a proper claimant` `a friend who paid the funeral`

§ `s 20`

#ASSERT `the payout may be set off against the debt` `a debt due to the CareShield Fund`
#ASSERT `the payout may be set off against the debt` `care fees owed to the nursing home that is the approved payee`
#ASSERT NOT `the payout may be set off against the debt` `care fees owed to a nursing home that is not the approved payee`

§ `s 25(3), (9)`

#ASSERT `is a joint account under section 25` 2 FALSE FALSE FALSE
#ASSERT NOT `is a joint account under section 25` 2 FALSE FALSE TRUE
#ASSERT NOT `is a joint account under section 25` 3 TRUE FALSE FALSE

#ASSERT `the defaulter's presumed share` 9000 3 EQUALS 3000

§ `s 28(6)`

#ASSERT `leaving is an offence under section 28` TRUE TRUE FALSE FALSE
#ASSERT NOT `leaving is an offence under section 28` TRUE TRUE FALSE TRUE

§ `s 58`

#ASSERT `has informed the Board of the new address` FALSE TRUE

§ `s 48`

#ASSERT `the section 48 penalty` TRUE FALSE 2000 EQUALS 2000
#ASSERT `the section 48 penalty` FALSE FALSE 2000 EQUALS 10000
#ASSERT `the section 48 penalty` TRUE TRUE 2000 EQUALS 4000

#ASSERT `the section 48 maximum fine` TRUE TRUE EQUALS 5000

§ `s 50`

#ASSERT `is an offence of misusing the payout` TRUE FALSE FALSE
#ASSERT NOT `is an offence of misusing the payout` TRUE FALSE TRUE

#ASSERT `the section 50 penalty` TRUE 1500 EQUALS 6000
#ASSERT `the section 50 penalty` FALSE 1500 EQUALS 12000

#ASSERT `the section 50 maximum fine` FALSE EQUALS 20000

§ `s 56`

#ASSERT `the most a composition can be` 10000 EQUALS 1000
#ASSERT `the most a composition can be` 1500 EQUALS 750

