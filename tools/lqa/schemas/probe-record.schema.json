{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/probe-record.schema.json",
  "title": "Probe record (7A)",
  "description": "Which categories were run over which Parts, and what each run produced. A run that found nothing is a result.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "runs"
  ],
  "properties": {
    "kind": {
      "const": "probe-record"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "parts",
          "performed",
          "candidates"
        ],
        "properties": {
          "category": {
            "enum": [
              "D",
              "R",
              "L",
              "T",
              "U",
              "P",
              "E",
              "M",
              "I",
              "X",
              "W",
              "F",
              "S"
            ]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "performed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]-\\d{2,}$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
