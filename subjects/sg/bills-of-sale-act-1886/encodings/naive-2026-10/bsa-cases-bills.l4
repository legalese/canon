§ `ss 2, 3 -- what is a bill of sale`

#ASSERT `the Act applies to the instrument` `a written assignment of household furniture as security for a loan` FALSE
#ASSERT `the Act applies to the instrument` `a hire agreement securing money the lessor advanced to the hirer` FALSE
#ASSERT NOT `the Act applies to the instrument` `an assignment for the benefit of the assignor's creditors` FALSE
#ASSERT NOT `the Act applies to the instrument` `a transfer of a ship` FALSE
#ASSERT NOT `the Act applies to the instrument` `a sale of goods in the ordinary course of a trade` FALSE
#ASSERT NOT `the Act applies to the instrument` `a debenture of an incorporated company secured on its goods` FALSE
#ASSERT NOT `the Act applies to the instrument` `an assignment of shares in a company` FALSE
#ASSERT NOT `the Act applies to the instrument` `a written assignment of household furniture as security for a loan` TRUE

§ `s 10(2) -- attestation`

#ASSERT `the bill is duly attested` `an advocate and solicitor not acting for the grantee` TRUE
#ASSERT NOT `the bill is duly attested` `the grantee's own advocate and solicitor` TRUE
#ASSERT `the bill is duly attested` `a commissioner for oaths` TRUE
#ASSERT NOT `the bill is duly attested` `a friend of the grantor` TRUE
#ASSERT NOT `the bill is duly attested` `an advocate and solicitor not acting for the grantee` FALSE

§ `ss 4(1), 6 -- security bills void`

#ASSERT NOT `the security bill is void` `the compliant loan bill`
#ASSERT NOT `the security bill is void` `the bill registered the same day`
#ASSERT `the security bill is void` `the bill registered on the fourth day`
#ASSERT `the security bill is void` `the unattested bill`
#ASSERT `the security bill is void` `the bill with an understated consideration`
#ASSERT `the security bill is void` `the bill for 99 dollars`
#ASSERT NOT `the security bill is void` `the bill for exactly 100 dollars`
#ASSERT `the security bill is void` `the bill not in the statutory form`
#ASSERT `the security bill is void` `the bill for an existing debt`

§ `s 4(1)(b), (2) -- absolute bills`

#ASSERT `the chattels are in the grantor's apparent possession` TRUE FALSE
#ASSERT NOT `the chattels are in the grantor's apparent possession` FALSE FALSE

#ASSERT NOT `the absolute bill is void against the challenger` FALSE `the grantor himself` TRUE
#ASSERT `the absolute bill is void against the challenger` FALSE `the grantor's trustee in bankruptcy` TRUE
#ASSERT `the absolute bill is void against the challenger` FALSE `the creditor who obtained the process` TRUE
#ASSERT NOT `the absolute bill is void against the challenger` FALSE `a neighbour with no claim on the grantor` TRUE
#ASSERT NOT `the absolute bill is void against the challenger` TRUE `the grantor's trustee in bankruptcy` TRUE

§ `s 5 -- the schedule`

#ASSERT `the bill has effect over the chattel` TRUE TRUE FALSE FALSE
#ASSERT NOT `the bill has effect over the chattel` FALSE TRUE FALSE FALSE
#ASSERT NOT `the bill has effect over the chattel` TRUE FALSE FALSE FALSE
#ASSERT `the bill has effect over the chattel` FALSE FALSE FALSE TRUE

§ `s 7 -- rent and property tax`

#ASSERT NOT `a security bill protects the chattels against a distress for rent or property tax`

§ `s 8(1) -- causes for seizure`

#ASSERT `the grantee may seize for the cause` `default in paying an instalment when due`
#ASSERT `the grantee may seize for the cause` `the grantor fraudulently removed the chattels from the premises`
#ASSERT `the grantee may seize for the cause` `no rent and property tax receipts produced on written demand without reasonable excuse`
#ASSERT `the grantee may seize for the cause` `an enforcement order executed against the grantor's goods`
#ASSERT NOT `the grantee may seize for the cause` `the grantee fears the goods are losing value`
#ASSERT NOT `the grantee may seize for the cause` `the grantee wants the money back early`

§ `s 8(2), (3) -- timing after seizure`

#ASSERT `the first day the chattels may be removed or sold` 20 EQUALS 26

#ASSERT NOT `the chattels may be removed or sold` 20 25
#ASSERT `the chattels may be removed or sold` 20 26

#ASSERT `the grantor's application to the High Court is in time` 20 25
#ASSERT NOT `the grantor's application to the High Court is in time` 20 26

§ `s 9 -- sale and interest`

#ASSERT `the sale is valid` TRUE TRUE
#ASSERT NOT `the sale is valid` FALSE TRUE

#ASSERT `the maximum fine for aiding or abetting a void sale` EQUALS 200

#ASSERT `the arrears of interest recoverable` 1800 1200 EQUALS 1200
#ASSERT `the arrears of interest recoverable` 600 1200 EQUALS 600

§ `s 11 -- priority`

#ASSERT NOT `the first bill has priority` 1 5 3 4
#ASSERT `the first bill has priority` 3 4 1 5

§ `s 12 -- transfers`

#ASSERT `the transfer is valid` 10 13 TRUE
#ASSERT NOT `the transfer is valid` 10 14 TRUE

§ `s 13 -- renewal`

#ASSERT NOT `the registration has become void` 11
#ASSERT `the registration has become void` 12

