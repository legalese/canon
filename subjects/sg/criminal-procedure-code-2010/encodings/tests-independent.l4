#ASSERT (at `the Second Schedule` 31)'s `item number` EQUALS "23"
#ASSERT (at `the Second Schedule` 31)'s `Act as printed` EQUALS "Vandalism Act 1966"
#ASSERT `the offence is under a law specified in the Second Schedule` (`wlo` "Vandalism Act 1966" "10" TRUE)

