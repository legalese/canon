IMPORT prelude
IMPORT `safa-discipline`

-- Singapore Armed Forces Act 1972, ss 3, 4, 11, 15, 21-25, 32-34, 61, 77, 78, 79A, 108, 111, 112(2), 196 and First Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_singapore-armed-forces-act-1972.py). Expected results were written by
-- hand from the text.

`a regular in service` MEANS Person WITH
    `category` IS `a regular serviceman`
    `liability to report has arisen` IS TRUE
    `lawfully discharged or released` IS FALSE
    `ordered to report, in uniform or performing service` IS FALSE
    `the SAF is engaged on active service` IS FALSE
    `attached to or acting with the SAF` IS FALSE

`a discharged regular` MEANS Person WITH
    `category` IS `a regular serviceman`
    `liability to report has arisen` IS TRUE
    `lawfully discharged or released` IS TRUE
    `ordered to report, in uniform or performing service` IS FALSE
    `the SAF is engaged on active service` IS FALSE
    `attached to or acting with the SAF` IS FALSE

