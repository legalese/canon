#ASSERT `section 4 switches the Law off for the person, reading` `T-days-either-year` `:` `T-g13`
#ASSERT NOT `section 4 switches the Law off for the person, reading` `T-days-year-of-ceasing` `:` `T-g13`
#ASSERT REFUSED `section 4 switches the Law off for the person` `T-g13`
-- G14 (AMB-5): the departed person's entity.  Decided: not touched.  Default flagged.
#ASSERT `entx` `T-s4-spares-entity` `T-g01` (`a plain non-resident entity`) (LIST (`an entity's business income through the individual's exertion, of` 500_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 500_000
#ASSERT `entx` `T-s4-takes-entity` `T-g01` (`a plain non-resident entity`) (LIST (`an entity's business income through the individual's exertion, of` 500_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 0
#ASSERT REFUSED `the exempt business income of the entity` `T-g01` `entity` (`a plain non-resident entity`) `items` (LIST (`an entity's business income through the individual's exertion, of` 500_000 `produced on` (YMD 2027 3 1))) `in the tax year` 2027
-- G15: never under 75 days: the earlier years stand.
#ASSERT NOT `section 4 switches the Law off for the person` `T-g15`
#ASSERT `exd` `T-g15` (LIST (`an employment income of` 500_000 `produced on` (YMD 2026 6 1))) 2026 EQUALS 500_000

§§ `H. Income types`

-- H01 H02.
#ASSERT `exd` `T-full` (LIST (`an employment income of` 400_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 400_000
#ASSERT `exd` `T-full` (LIST (`a business income of` 400_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 400_000
-- H03 to H06 H08 H09 H18: other income and other sources are not qualifying.
#ASSERT `exd` `T-full` (LIST (`an income from another source (such as rent or interest) of` 100_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 0
#ASSERT `exd` `T-full` (LIST (`a business income that is other income under section 62A(d), of` 500_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 0
-- H07: other income that is treated as business income.
#ASSERT `exd` `T-full` (LIST (`a business income that is other income under section 62A(d), of` 50_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 0
-- H10: foreign-source employment income.
#ASSERT `exd` `T-full` (LIST (`an employment income produced or accrued abroad, of` 400_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 0
-- H11: salary 500,000, rent 200,000, interest 30,000.
#ASSERT `exd` `T-full` (LIST (`an employment income of` 500_000 `produced on` (YMD 2027 3 1)), (`an income from another source (such as rent or interest) of` 200_000 `produced on` (YMD 2027 4 1)), (`an income from another source (such as rent or interest) of` 30_000 `produced on` (YMD 2027 5 1))) 2027 EQUALS 500_000
-- H12: business 300,000 and business interest 50,000.
#ASSERT `exd` `T-full` (LIST (`a business income of` 300_000 `produced on` (YMD 2027 3 1)), (`a business income that is other income under section 62A(d), of` 50_000 `produced on` (YMD 2027 4 1))) 2027 EQUALS 300_000
-- H14: attributed from a transparent corporation, not under s 62A.
#ASSERT `exd` `T-full` (LIST (`a business income attributed from a transparent corporation, of` 300_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 0
-- H15: attributed under s 62A: qualifying on the reading I took (F2 first reading); the default of the encoding declines.
#ASSERT `ex` `T-62A-qualifies` `T-full` (LIST (`a business income attributed from a transparent corporation under section 62A, of` 300_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 300_000
-- H17: income earned in Israel before the arrival date (1 July 2026): not qualifying.
#ASSERT `ex` `T-days` `T-jul1` (LIST (`an employment income of` 100_000 `produced on` (YMD 2026 3 1))) 2026 EQUALS 0

§§ `I. Savings, commencement`

-- I03: arriving 15 March 2026, 2027 is not prorated.
#ASSERT `exd` `T-mar15` (LIST (`an employment income of` 1_200_000 `produced on` (YMD 2027 3 1))) 2027 EQUALS 1_000_000
-- I04: and 2031 is nothing.
#ASSERT `exd` `T-mar15` (LIST (`an employment income of` 100_000 `produced on` (YMD 2031 3 1))) 2031 EQUALS 0
-- A13 in amounts (AMB-6): the adaptation year changes nothing on the reading I took (F4 second reading); the default is flagged.
`T-adapt` MEANS `an immigrant who first became an Israeli resident on` (YMD 2026 2 1) `and elected an adaptation year from` (YMD 2026 2 1)
#ASSERT `ex` `T-adapt-ignored` `T-adapt` (LIST (`an employment income of` 100_000 `produced on` (YMD 2026 6 1))) 2026 EQUALS 100_000
#ASSERT REFUSED `exd` `T-adapt` (LIST (`an employment income of` 100_000 `produced on` (YMD 2026 6 1))) 2026
