#ASSERT `the debtor stays liable for the unpaid balance` TRUE FALSE FALSE
#ASSERT `the debtor stays liable for the unpaid balance` FALSE TRUE FALSE
#ASSERT NOT `the debtor stays liable for the unpaid balance` TRUE FALSE TRUE

