§§ `44 -- illustrations`

`a police officer` MEANS EnforcementCapacity WITH
    `is a police officer, proceeding in the name of the Crown` IS TRUE
    , `is an employee of a local government, authorised by the local government, proceeding in its name` IS FALSE
    , `is the CEO or a designated person` IS FALSE
    , `is a person aggrieved` IS FALSE

`an aggrieved person` MEANS EnforcementCapacity WITH
    `is a police officer, proceeding in the name of the Crown` IS FALSE
    , `is an employee of a local government, authorised by the local government, proceeding in its name` IS FALSE
    , `is the CEO or a designated person` IS FALSE
    , `is a person aggrieved` IS TRUE

`a bystander with no standing` MEANS EnforcementCapacity WITH
    `is a police officer, proceeding in the name of the Crown` IS FALSE
    , `is an employee of a local government, authorised by the local government, proceeding in its name` IS FALSE
    , `is the CEO or a designated person` IS FALSE
    , `is a person aggrieved` IS FALSE

#ASSERT `the party may commence enforcement proceedings under s 44(2)` `an aggrieved person`
#ASSERT NOT (`the party may commence enforcement proceedings under s 44(2)` `a bystander with no standing`)

#ASSERT `the party may commence proceedings for this offence under s 44` `a police officer` TRUE
#ASSERT NOT (`the party may commence proceedings for this offence under s 44` `an aggrieved person` TRUE)
#ASSERT `the party may commence proceedings for this offence under s 44` `an aggrieved person` FALSE

§§ `45 -- illustrations`

`asserting the dog was registered` MEANS `S45 Reverse-Onus Facts` WITH
    `assertion is that the dog was registered at a particular time` IS TRUE
    , `assertion is that the dog was sterilised at a particular time` IS FALSE
    , `assertion is that the dog was microchipped at a particular time` IS FALSE
    , `assertion is that the dog was under 3 months of age at a particular time` IS FALSE
    , `assertion is that the dog was not a dangerous dog (restricted breed)` IS FALSE

`asserting an unrelated fact` MEANS `S45 Reverse-Onus Facts` WITH
    `assertion is that the dog was registered at a particular time` IS FALSE
    , `assertion is that the dog was sterilised at a particular time` IS FALSE
    , `assertion is that the dog was microchipped at a particular time` IS FALSE
    , `assertion is that the dog was under 3 months of age at a particular time` IS FALSE
    , `assertion is that the dog was not a dangerous dog (restricted breed)` IS FALSE

#ASSERT `the onus of proving the asserted fact lies on the person making the assertion` `asserting the dog was registered`
#ASSERT NOT (`the onus of proving the asserted fact lies on the person making the assertion` `asserting an unrelated fact`)

