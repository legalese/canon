-- Tests for Chapter 17 of the Penal Code 1871 (Offences against property),
-- ss 378-462, over pc-property-theft, pc-property-trust, pc-property-cheating
-- and pc-property-mischief.
--
-- Expected values come from the Code: every Illustration that can be stated
-- on the atoms is an #ASSERT, cited on the line above ("-- s 378 illus (a)").
-- Boundary cases for every threshold (5 persons, 20 tons) are on the helpers.
-- Charge texts: the two reported charges the reference row pins (Lewis
-- Christine, s 420; the Illustration (q) bank transfer, s 379) are asserted
-- byte for byte, so this encoding reproduces what the charge generator shows
-- today. An assertion that fails is a finding, never an expected value to edit.
--
-- Fixtures are complete record literals: every leaf not named TRUE is FALSE,
-- which is also how the charge generator completes a partial record.

IMPORT prelude
IMPORT `pc-domain`
IMPORT `pc-general`
IMPORT `pc-property-theft`
IMPORT `pc-property-trust`
IMPORT `pc-property-cheating`
IMPORT `pc-property-mischief`

§ `Fixtures shared by every family`

`the particulars` MEANS Particulars WITH
    accused            IS "Tan Ah Kow"
    date               IS "the 1st day of June 2026"
    time               IS "9.00 pm"
    place              IS "Blk 1 Toa Payoh Lorong 1"
    `co-accused`       IS ""
    `common intention` IS FALSE

@@NONES Theft Facts, Extortion Facts, Robbery Facts

§ `Theft - ss 378-382`

@@FIX `a theft` : Theft Facts
=victim => "Z"
=the property => "a gold ring"
intending to take
dishonestly
movable property
out of the possession
without that person
moves that property
in order to such taking
@@END

-- s 378 illus (a): the tree, severed in order to the taking (Explanation 1: movable once severed)
#ASSERT `commits theft` `a theft`
#ASSERT `offence under s 379` `a theft`

-- s 378 illus (e): the plate entrusted to a warehouse operator is not in Z's possession
@@FIX `illus (e), the warehoused plate` : Theft Facts < `a theft`
-out of the possession
@@END
#ASSERT NOT `commits theft` `illus (e), the warehoused plate`

-- s 378 illus (g): a ring on the high road is in nobody's possession
@@FIX `illus (g), the ring on the high road` : Theft Facts < `a theft`
-out of the possession
-without that person
@@END
#ASSERT NOT `commits theft` `illus (g), the ring on the high road`

-- s 378 illus (i): taking one's own watch from a jeweller with no lien is not dishonest
@@FIX `illus (i), the watch with no lien` : Theft Facts < `a theft`
-dishonestly
@@END
#ASSERT NOT `commits theft` `illus (i), the watch with no lien`

-- s 378 illus (j), (k): the watch held as security, or pawned, taken back - dishonest, so theft
#ASSERT `commits theft` `a theft`

-- s 378 illus (m): the book taken in the belief of implied consent - consent (Explanation 5)
@@FIX `illus (m), the borrowed book` : Theft Facts < `a theft`
-without that person
@@END
#ASSERT NOT `commits theft` `illus (m), the borrowed book`

-- s 378 illus (p): taken in good faith believing it one's own - not dishonest
#ASSERT NOT `commits theft` `illus (i), the watch with no lien`

-- s 378 illus (h): the ring hidden in Z's house, meant to be fetched later - the first moving is theft
#ASSERT `commits theft` `a theft`

-- the charge refusal names exactly the missing element
#ASSERT (`charge under s 379` `illus (i), the watch with no lien`)'s refusal EQUALS "A charge under section 379 would assert that the facts fulfil every legal condition of theft (CPC s 123(5)). On the facts given they do not: dishonestly (section 24)."
#ASSERT (`charge under s 379` `illus (i), the watch with no lien`)'s text EQUALS ""

-- s 378 illus (q), the reference row's fixture: the charge text, byte for byte as the charge generator shows it today
@@FIX `Lim Wei Ming` : Theft Facts < `a theft`
=particulars => Particulars WITH accused IS "Lim Wei Ming", date IS "the 3rd day of March 2021", time IS "11.15 pm", place IS "Blk 123 Ang Mo Kio Avenue 3", `co-accused` IS "", `common intention` IS FALSE
=victim => "Goh Siew Lan"
=victim pronoun => she
=the property => "moneys amounting to $4,500/-"
@@END
#ASSERT (`charge under s 379` `Lim Wei Ming`)'s text EQUALS "You, Lim Wei Ming, are charged that you, on or about the 3rd day of March 2021, at about 11.15 pm, at Blk 123 Ang Mo Kio Avenue 3, Singapore, did commit theft of moneys amounting to $4,500/-, in the possession of one Goh Siew Lan, and you have thereby committed an offence punishable under section 379 of the Penal Code 1871."
#ASSERT (`charge under s 379` `Lim Wei Ming`)'s punishment EQUALS "imprisonment for a term which may extend to 3 years, or with fine, or with both"

-- s 379A
@@FIX `theft of a car` : Theft Facts < `a theft`
=the property => "motor car SBA 1234 X"
a motor vehicle
@@END
@@FIX `theft of a tyre` : Theft Facts < `a theft`
any component part
@@END
#ASSERT `offence under s 379A` `theft of a car`
#ASSERT `offence under s 379A` `theft of a tyre`
#ASSERT NOT `offence under s 379A` `a theft`
#ASSERT (`charge under s 379A` `theft of a car`)'s text EQUALS "You, Tan Ah Kow, are charged that you, on or about the 1st day of June 2026, at about 9.00 pm, at Blk 1 Toa Payoh Lorong 1, Singapore, did commit theft of motor car SBA 1234 X, in the possession of one Z, a motor vehicle, and you have thereby committed an offence punishable under section 379A of the Penal Code 1871."
#ASSERT `punishment prescribed by s 379A`'s `maximum term in months` EQUALS JUST 84

-- s 380: a shop is a building used for the custody of property; theft in the open is not s 380
@@FIX `theft in a shop` : Theft Facts < `a theft`
building
for the custody
@@END
@@FIX `theft in a building used for neither` : Theft Facts < `a theft`
building
@@END
#ASSERT `offence under s 380` `theft in a shop`
#ASSERT NOT `offence under s 380` `a theft`
#ASSERT NOT `offence under s 380` `theft in a building used for neither`
#ASSERT (`charge under s 380` `theft in a shop`)'s text EQUALS "You, Tan Ah Kow, are charged that you, on or about the 1st day of June 2026, at about 9.00 pm, at Blk 1 Toa Payoh Lorong 1, Singapore, did commit theft of a gold ring, in the possession of one Z, in a building used for the custody of property, and you have thereby committed an offence punishable under section 380 of the Penal Code 1871."

-- s 378 illus (d) with s 381: the servant entrusted with the care of the plate runs away with it
@@FIX `illus (d), the servant and the plate` : Theft Facts < `a theft`
being a clerk or servant
in the possession of his master
@@END
#ASSERT `commits theft` `illus (d), the servant and the plate`
#ASSERT `offence under s 381` `illus (d), the servant and the plate`
#ASSERT NOT `offence under s 381` `a theft`

-- s 382 illus (a): a loaded pistol carried to hurt Z if Z resisted
@@FIX `s 382 illus (a), the pistol` : Theft Facts < `a theft`
having made preparation
in order to commit such theft
=the preparation => "hurt to the said Z, to wit, by carrying a loaded pistol"
@@END
#ASSERT `offence under s 382` `s 382 illus (a), the pistol`
-- s 382 illus (b): companions posted to restrain Z if Z resisted or tried to apprehend A
@@FIX `s 382 illus (b), the companions` : Theft Facts < `a theft`
having made preparation
in order to effect his escape
@@END
#ASSERT `offence under s 382` `s 382 illus (b), the companions`
#ASSERT NOT `offence under s 382` `a theft`
-- s 382's punishment as amended by Act 21 of 2025 (wef 17/08/2026): caning is discretionary
#ASSERT `punishment prescribed by s 382`'s caning EQUALS `shall also be liable to`

§ `Extortion - ss 383-389`

@@FIX `an extortion` : Extortion Facts
=victim => "Z"
=the property extorted => "cash of $200/-"
=the fear => "of harm to his reputation"
intentionally
put the victim in fear
that person
reputation
dishonestly
induced the person
any property
@@END

-- s 383 illus (a): a threat to publish a defamatory libel unless Z pays
#ASSERT `commits extortion` `an extortion`
#ASSERT `offence under s 384` `an extortion`

-- s 383 illus (b): Z's child to be kept in wrongful confinement; Z signs and delivers a promissory note
@@FIX `illus (b), the promissory note` : Extortion Facts < `an extortion`
-that person
-reputation
-any property
any other person
body
valuable security
@@END
#ASSERT `commits extortion` `illus (b), the promissory note`

-- s 383 illus (c): an enforcement officer threatens to report a real offence - harm caused legally is still harm
#ASSERT `commits extortion` `an extortion`

-- s 383 illus (d): fear of grievous hurt; a signed blank paper, which may be converted into a valuable security
@@FIX `illus (d), the signed blank paper` : Extortion Facts < `an extortion`
-reputation
-any property
body
anything signed or sealed
fear of grievous hurt
@@END
#ASSERT `commits extortion` `illus (d), the signed blank paper`
#ASSERT `offence under s 386` `illus (d), the signed blank paper`
#ASSERT NOT `offence under s 386` `an extortion`

-- a creditor who frightens a debtor into paying what is owed is not dishonest: no extortion
@@FIX `no dishonesty` : Extortion Facts < `an extortion`
-dishonestly
@@END
#ASSERT NOT `commits extortion` `no dishonesty`
#ASSERT (`charge under s 384` `no dishonesty`)'s refusal EQUALS "A charge under section 384 would assert that the facts fulfil every legal condition of extortion (CPC s 123(5)). On the facts given they do not: dishonestly (section 24)."

-- ss 385, 387: the putting in fear is enough; no delivery need follow
@@FIX `a threat that got nothing` : Extortion Facts < `an extortion`
-induced the person
-any property
in order to commit extortion
puts or attempts
@@END
#ASSERT NOT `offence under s 384` `a threat that got nothing`
#ASSERT `offence under s 385` `a threat that got nothing`
#ASSERT NOT `offence under s 387` `a threat that got nothing`
@@FIX `a death threat that got nothing` : Extortion Facts < `a threat that got nothing`
fear of death
@@END
#ASSERT `offence under s 387` `a death threat that got nothing`

-- ss 388, 389: fear of an accusation of an offence punishable with 10 years or more
@@FIX `a threatened accusation` : Extortion Facts < `an extortion`
fear of an accusation
of having committed
@@END
#ASSERT `offence under s 388` `a threatened accusation`
#ASSERT NOT `offence under s 388` `an extortion`
@@FIX `a threatened accusation that got nothing` : Extortion Facts < `a threatened accusation`
-induced the person
in order to commit extortion
puts or attempts
@@END
#ASSERT `offence under s 389` `a threatened accusation that got nothing`
-- s 389 has no "attempted to induce" limb, s 388 does
@@FIX `accusation of inducing only` : Extortion Facts < `a threatened accusation that got nothing`
-of having committed
of having attempted to induce
@@END
#ASSERT NOT `offence under s 389` `accusation of inducing only`

-- the extortion charge recites the manner (CPC s 125)
#ASSERT (`charge under s 384` `an extortion`)'s text EQUALS "You, Tan Ah Kow, are charged that you, on or about the 1st day of June 2026, at about 9.00 pm, at Blk 1 Toa Payoh Lorong 1, Singapore, did extort cash of $200/- from one Z by intentionally putting him in fear of harm to his reputation, and you have thereby committed an offence punishable under section 384 of the Penal Code 1871."
-- s 384 as amended by Act 21 of 2025: 2 to 7 years, caning discretionary
#ASSERT `punishment prescribed by s 384`'s `minimum term in months` EQUALS JUST 24
#ASSERT `punishment prescribed by s 384`'s caning EQUALS `shall also be liable to`

§ `Robbery and gang-robbery - ss 390-402`

-- s 390 illus (a): A holds Z down and takes Z's money - theft, with wrongful restraint in order to it
@@FIX `illus (a), held down` : Robbery Facts
=theft => `a theft`
in order to commit theft
for that end
voluntarily
causes
wrongful restraint
@@END
#ASSERT `theft is robbery` `illus (a), held down`
#ASSERT `commits robbery` `illus (a), held down`
#ASSERT `offence under s 392` `illus (a), held down`

-- s 390 illus (b): a pistol shown on the high road, the purse surrendered - extortion in Z's presence, fear of instant hurt
@@FIX `the purse extorted` : Extortion Facts < `an extortion`
-reputation
body
=the property extorted => "a purse"
=the fear => "of instant hurt, to wit, by showing him a pistol"
@@END
@@FIX `illus (b), the pistol on the high road` : Robbery Facts
=extortion => `the purse extorted`
in the presence
instant hurt
to that person
then and there
@@END
#ASSERT `extortion is robbery` `illus (b), the pistol on the high road`
#ASSERT `commits robbery` `illus (b), the pistol on the high road`

-- s 390 illus (c): the child held over a precipice - fear of instant hurt to some other person, Z present
@@FIX `illus (c), the child and the precipice` : Robbery Facts < `illus (b), the pistol on the high road`
-to that person
to some other person
@@END
#ASSERT `commits robbery` `illus (c), the child and the precipice`

-- s 390 illus (d): "your child is in the hands of my gang" - extortion, but not robbery
@@FIX `illus (d), the child held elsewhere` : Robbery Facts
=extortion => `the purse extorted`
@@END
#ASSERT `commits extortion` (`illus (d), the child held elsewhere`'s extortion)
#ASSERT NOT `commits robbery` `illus (d), the child held elsewhere`

-- the robbery charge, and the night punishment
#ASSERT (`charge under s 392` `illus (a), held down`)'s text EQUALS "You, Tan Ah Kow, are charged that you, on or about the 1st day of June 2026, at about 9.00 pm, at Blk 1 Toa Payoh Lorong 1, Singapore, did rob one Z of a gold ring, and you have thereby committed an offence punishable under section 392 of the Penal Code 1871."

-- The reference row's reported s 392 charge, Chen Weixiong Jerriek v PP [2003] SGHC 103, byte for byte
@@FIX `the handphone taken` : Theft Facts < `a theft`
=particulars => Particulars WITH accused IS "Chen Weixiong Jerriek", date IS "the 5th day of July 2002", time IS "1.00pm", place IS "void deck of Blk 121, Lor 1 Toa Payoh", `co-accused` IS "Koh Bang Long and Chia Jia Ting Samuel", `common intention` IS TRUE
=victim => "Ng Juin Chye Joel"
=the property => "a handphone valued at about $450/-"
@@END
@@FIX `Chen Weixiong Jerriek` : Robbery Facts < `illus (a), held down`
=particulars => `the handphone taken`'s particulars
=theft => `the handphone taken`
@@END
#ASSERT (`charge under s 392` `Chen Weixiong Jerriek`)'s text EQUALS "You, Chen Weixiong Jerriek, are charged that you, on or about the 5th day of July 2002, at about 1.00pm, at void deck of Blk 121, Lor 1 Toa Payoh, Singapore, together with Koh Bang Long and Chia Jia Ting Samuel and in furtherance of the common intention of you all, did rob one Ng Juin Chye Joel of a handphone valued at about $450/-, and you have thereby committed an offence punishable under section 392 read with section 34 of the Penal Code 1871."
@@FIX `held down, at night` : Robbery Facts < `illus (a), held down`
committed after 7
@@END
#ASSERT (`charge under s 392` `held down, at night`)'s punishment EQUALS "imprisonment for a term of not less than 3 years and not more than 14 years and shall also be punished with caning with not less than 12 strokes"
#ASSERT (`charge under s 392` `illus (a), held down`)'s punishment EQUALS "imprisonment for a term of not less than 2 years and not more than 10 years and shall also be punished with caning with not less than 6 strokes"
#ASSERT (`charge under s 392` `illus (d), the child held elsewhere`)'s refusal EQUALS "A charge under section 392 would assert that the facts fulfil every legal condition of robbery (CPC s 123(5)). On the facts given they do not: the aggravation that makes a theft robbery (section 390(2)) or an extortion robbery (section 390(3))."

-- s 391: 5 or more
#ASSERT NOT `5 or more persons` 4
#ASSERT `5 or more persons` 5
@@FIX `a gang-robbery` : Robbery Facts < `illus (a), held down`
5 or more persons conjointly
@@END
@@FIX `an aider at a gang-robbery` : Robbery Facts < `illus (d), the child held elsewhere`
the persons conjointly committing or attempting, and
present and aiding
@@END
#ASSERT `commits gang-robbery` `a gang-robbery`
#ASSERT `offence under s 395` `a gang-robbery`
#ASSERT `commits gang-robbery` `an aider at a gang-robbery`
#ASSERT NOT `commits gang-robbery` `illus (a), held down`

-- s 393, 394, 396, 397
@@FIX `an attempted robbery with hurt` : Robbery Facts < `illus (d), the child held elsewhere`
attempting to commit robbery
voluntarily causes hurt
such person
=the hurt => "punching him in the face"
@@END
#ASSERT `offence under s 393` `an attempted robbery with hurt`
#ASSERT `offence under s 394` `an attempted robbery with hurt`
#ASSERT NOT `offence under s 392` `an attempted robbery with hurt`
@@FIX `a joint robber, hurt caused by another` : Robbery Facts < `illus (a), held down`
voluntarily causes hurt
any other person jointly
@@END
#ASSERT `offence under s 394` `a joint robber, hurt caused by another`
@@FIX `gang-robbery with murder` : Robbery Facts < `a gang-robbery`
one of those persons commits murder
@@END
#ASSERT `offence under s 396` `gang-robbery with murder`
#ASSERT NOT `offence under s 396` `a gang-robbery`
@@FIX `robbery with a knife` : Robbery Facts < `illus (a), held down`
armed with any deadly weapon
such offender
@@END
#ASSERT `offence under s 397` `robbery with a knife`
#ASSERT NOT `offence under s 397` `illus (a), held down`

-- ss 399-402
@@FIX `a gang of thieves` : Gang Facts
=the gang => "a gang of persons"
belongs to a gang of persons associated for the purpose of habitually committing theft
not being gang-robbers
@@END
#ASSERT `offence under s 401` `a gang of thieves`
#ASSERT NOT `offence under s 400` `a gang of thieves`
@@FIX `gang-robbers, not thieves only` : Gang Facts < `a gang of thieves`
-not being gang-robbers
belongs to a gang of persons associated for the purpose of habitually committing gang-robbery
@@END
#ASSERT NOT `offence under s 401` `gang-robbers, not thieves only`
#ASSERT `offence under s 400` `gang-robbers, not thieves only`

