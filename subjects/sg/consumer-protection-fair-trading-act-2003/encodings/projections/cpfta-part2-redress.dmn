  <decision id="decision_no_regulations_under_section_43_2_m_prescribing_how_a_contract_is_cancelled_under_section_9_12_are_encoded_in_this_model" name="no_regulations_under_section_43_2_m_prescribing_how_a_contract_is_cancelled_under_section_9_12_are_encoded_in_this_model" label="no regulations under section 43(2)(m) prescribing how a contract is cancelled under section 9(12) are encoded in this model">
