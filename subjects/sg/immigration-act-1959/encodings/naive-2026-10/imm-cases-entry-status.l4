    `received a free pardon` IS FALSE
    `the Controller deems the person undesirable` IS TRUE

`a foreign fine deemed undesirable` MEANS ForeignConviction WITH
    `a sentence of imprisonment was passed` IS FALSE
    `received a free pardon` IS FALSE
    `the Controller deems the person undesirable` IS TRUE

`a pardoned foreign jail sentence` MEANS ForeignConviction WITH
    `a sentence of imprisonment was passed` IS TRUE
    `received a free pardon` IS TRUE
    `the Controller deems the person undesirable` IS TRUE

`a foreign jail sentence not deemed undesirable` MEANS ForeignConviction WITH
    `a sentence of imprisonment was passed` IS TRUE
    `received a free pardon` IS FALSE
    `the Controller deems the person undesirable` IS FALSE

`a prohibited immigrant with the special pass` MEANS ProhibitedEntry WITH
    `banned by a section 9 order` IS FALSE
    `holds a pass issuable to prohibited immigrants` IS TRUE
    `exempted under section 56` IS FALSE

`a banned person with the special pass` MEANS ProhibitedEntry WITH
    `banned by a section 9 order` IS TRUE
    `holds a pass issuable to prohibited immigrants` IS TRUE
    `exempted under section 56` IS FALSE

`a banned person exempted` MEANS ProhibitedEntry WITH
    `banned by a section 9 order` IS TRUE
    `holds a pass issuable to prohibited immigrants` IS FALSE
    `exempted under section 56` IS TRUE

`a prohibited immigrant with no pass` MEANS ProhibitedEntry WITH
    `banned by a section 9 order` IS FALSE
    `holds a pass issuable to prohibited immigrants` IS FALSE
    `exempted under section 56` IS FALSE

`a citizen under any ban` MEANS BanFacts WITH
    `is a citizen` IS TRUE
    `the order is for public security or public health` IS TRUE
    `outside Singapore when the order was made` IS FALSE
    `holds a valid re-entry permit or pass` IS FALSE

`a PR abroad under an economic ban` MEANS BanFacts WITH
    `is a citizen` IS FALSE
    `the order is for public security or public health` IS FALSE
    `outside Singapore when the order was made` IS TRUE
    `holds a valid re-entry permit or pass` IS TRUE

`a PR abroad under a health ban` MEANS BanFacts WITH
    `is a citizen` IS FALSE
    `the order is for public security or public health` IS TRUE
    `outside Singapore when the order was made` IS TRUE
    `holds a valid re-entry permit or pass` IS TRUE

