IMPORT prelude
IMPORT `sfaa-agency`

-- Singapore Food Agency Act 2019, ss 8, 9, 11, 12, 16, 18, 20, 23, 25, 34, 35, 42, 43, 44, 45(2) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_singapore-food-agency-act-2019.py). Expected results were written by
-- hand from the text.

`a clean candidate` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `has an arrangement with creditors` IS FALSE
    `is a Judge or judicial officer` IS FALSE
    `months of imprisonment sentenced` IS 0
    `has received a free pardon` IS FALSE
    `is disqualified as a company or VCC director` IS FALSE
    `lacks capacity` IS FALSE

`a bankrupt` MEANS Candidate WITH
    `is an undischarged bankrupt` IS TRUE
    `has an arrangement with creditors` IS FALSE
    `is a Judge or judicial officer` IS FALSE
    `months of imprisonment sentenced` IS 0
    `has received a free pardon` IS FALSE
    `is disqualified as a company or VCC director` IS FALSE
    `lacks capacity` IS FALSE

`a judicial officer` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `has an arrangement with creditors` IS FALSE
    `is a Judge or judicial officer` IS TRUE
    `months of imprisonment sentenced` IS 0
    `has received a free pardon` IS FALSE
    `is disqualified as a company or VCC director` IS FALSE
    `lacks capacity` IS FALSE

`an unpardoned six-month prisoner` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `has an arrangement with creditors` IS FALSE
    `is a Judge or judicial officer` IS FALSE
    `months of imprisonment sentenced` IS 6
    `has received a free pardon` IS FALSE
    `is disqualified as a company or VCC director` IS FALSE
    `lacks capacity` IS FALSE

`a pardoned six-month prisoner` MEANS Candidate WITH
    `is an undischarged bankrupt` IS FALSE
    `has an arrangement with creditors` IS FALSE
    `is a Judge or judicial officer` IS FALSE
    `months of imprisonment sentenced` IS 6
    `has received a free pardon` IS TRUE
    `is disqualified as a company or VCC director` IS FALSE
    `lacks capacity` IS FALSE

`a sitting member` MEANS Member WITH
    `has died` IS FALSE
    `is adjudicated bankrupt or has an arrangement` IS FALSE
    `has become otherwise disqualified` IS FALSE
    `has been removed by the Minister` IS FALSE
    `has resigned` IS FALSE
    `failed without reasonable cause to disclose an interest` IS FALSE
    `notice of the default given to the Minister` IS FALSE
    `consecutive meetings missed without approval` IS 0
    `term expired without re-appointment` IS FALSE

`a member who missed two meetings` MEANS Member WITH
    `has died` IS FALSE
    `is adjudicated bankrupt or has an arrangement` IS FALSE
    `has become otherwise disqualified` IS FALSE
    `has been removed by the Minister` IS FALSE
    `has resigned` IS FALSE
    `failed without reasonable cause to disclose an interest` IS FALSE
    `notice of the default given to the Minister` IS FALSE
    `consecutive meetings missed without approval` IS 2
    `term expired without re-appointment` IS FALSE

`a member who missed three meetings` MEANS Member WITH
    `has died` IS FALSE
    `is adjudicated bankrupt or has an arrangement` IS FALSE
    `has become otherwise disqualified` IS FALSE
    `has been removed by the Minister` IS FALSE
    `has resigned` IS FALSE
    `failed without reasonable cause to disclose an interest` IS FALSE
    `notice of the default given to the Minister` IS FALSE
    `consecutive meetings missed without approval` IS 3
    `term expired without re-appointment` IS FALSE

`a member who failed to disclose, no notice yet` MEANS Member WITH
    `has died` IS FALSE
    `is adjudicated bankrupt or has an arrangement` IS FALSE
    `has become otherwise disqualified` IS FALSE
    `has been removed by the Minister` IS FALSE
    `has resigned` IS FALSE
    `failed without reasonable cause to disclose an interest` IS TRUE
    `notice of the default given to the Minister` IS FALSE
    `consecutive meetings missed without approval` IS 0
    `term expired without re-appointment` IS FALSE

`a member who failed to disclose, notice given` MEANS Member WITH
    `has died` IS FALSE
    `is adjudicated bankrupt or has an arrangement` IS FALSE
    `has become otherwise disqualified` IS FALSE
    `has been removed by the Minister` IS FALSE
    `has resigned` IS FALSE
    `failed without reasonable cause to disclose an interest` IS TRUE
    `notice of the default given to the Minister` IS TRUE
    `consecutive meetings missed without approval` IS 0
    `term expired without re-appointment` IS FALSE

`a consenting director` MEANS Person WITH
    `is an officer` IS TRUE
    `is in management and able to influence the conduct` IS FALSE
    `consented, connived or conspired` IS TRUE
    `was knowingly concerned` IS FALSE
    `knew or ought to have known` IS FALSE
    `took all reasonable steps to prevent it` IS FALSE

`a director who knew and did nothing` MEANS Person WITH
    `is an officer` IS TRUE
    `is in management and able to influence the conduct` IS FALSE
    `consented, connived or conspired` IS FALSE
    `was knowingly concerned` IS FALSE
    `knew or ought to have known` IS TRUE
    `took all reasonable steps to prevent it` IS FALSE

`a director who knew and took all reasonable steps` MEANS Person WITH
    `is an officer` IS TRUE
    `is in management and able to influence the conduct` IS FALSE
    `consented, connived or conspired` IS FALSE
    `was knowingly concerned` IS FALSE
    `knew or ought to have known` IS TRUE
    `took all reasonable steps to prevent it` IS TRUE

`a junior employee who consented` MEANS Person WITH
    `is an officer` IS FALSE
    `is in management and able to influence the conduct` IS FALSE
    `consented, connived or conspired` IS TRUE
    `was knowingly concerned` IS FALSE
    `knew or ought to have known` IS FALSE
    `took all reasonable steps to prevent it` IS FALSE

§ `s 8 -- symbol`

#ASSERT `the symbol use is an offence` `an identical symbol` FALSE
#ASSERT NOT `the symbol use is an offence` `an identical symbol` TRUE
#ASSERT `the symbol use is an offence` `a confusingly similar symbol` TRUE
#ASSERT NOT `the symbol use is an offence` `a dissimilar symbol` FALSE

§ `ss 9, 12 -- membership`

#ASSERT NOT `the membership size is lawful` 6
#ASSERT `the membership size is lawful` 14
#ASSERT NOT `the membership size is lawful` 15

#ASSERT NOT `may be appointed Chairperson` TRUE TRUE
#ASSERT `may be appointed Chairperson` FALSE TRUE

§ `s 11(2) -- disqualification`

#ASSERT NOT `the candidate is disqualified` `a clean candidate`
#ASSERT `the candidate is disqualified` `a bankrupt`
#ASSERT `the candidate is disqualified` `a judicial officer`
#ASSERT `the candidate is disqualified` `an unpardoned six-month prisoner`
#ASSERT NOT `the candidate is disqualified` `a pardoned six-month prisoner`

§ `ss 16, 18 -- term and resignation`

#ASSERT `the term of office in months` 0 EQUALS 36
#ASSERT `the term of office in months` 24 EQUALS 24

#ASSERT `the day the resignation takes effect` 100 0 EQUALS 100
#ASSERT `the day the resignation takes effect` 100 130 EQUALS 130

§ `s 20 -- vacation of office`

#ASSERT NOT `the member has vacated office` `a sitting member`
#ASSERT NOT `the member has vacated office` `a member who missed two meetings`
#ASSERT `the member has vacated office` `a member who missed three meetings`
#ASSERT NOT `the member has vacated office` `a member who failed to disclose, no notice yet`
#ASSERT `the member has vacated office` `a member who failed to disclose, notice given`

§ `ss 23, 25 -- quorum and voting`

#ASSERT `a quorum is present` 12 4
#ASSERT NOT `a quorum is present` 12 3
#ASSERT `a quorum is present` 7 3

#ASSERT `the resolution is passed` 9 0 12 FALSE
#ASSERT `the resolution is passed` 9 2 12 FALSE
#ASSERT NOT `the resolution is passed` 8 4 12 TRUE
#ASSERT `the resolution is passed` 12 6 12 TRUE
#ASSERT NOT `the resolution is passed` 12 6 12 FALSE

#ASSERT NOT `the Agency validly resolves` 12 3 0 FALSE
#ASSERT `the Agency validly resolves` 12 4 0 FALSE
#ASSERT NOT `the Agency validly resolves` 10 4 1 FALSE

§ `s 34 -- secrecy`

#ASSERT `the disclosure is an offence` TRUE TRUE `a press interview`
#ASSERT NOT `the disclosure is an offence` TRUE TRUE `a court order`
#ASSERT NOT `the disclosure is an offence` FALSE TRUE `a press interview`

§ `s 35 -- personal liability`

#ASSERT `is protected from personal liability` TRUE TRUE TRUE TRUE
#ASSERT NOT `is protected from personal liability` TRUE TRUE FALSE TRUE

§ `s 42 -- borrowing`

#ASSERT `the Agency may borrow` `the Government` FALSE
#ASSERT NOT `the Agency may borrow` `a Singapore bank` FALSE
#ASSERT `the Agency may borrow` `a lender outside Singapore` TRUE

§ `s 43 -- marks`

#ASSERT `the mark use is an offence` TRUE FALSE FALSE FALSE
#ASSERT NOT `the mark use is an offence` TRUE FALSE TRUE FALSE
#ASSERT NOT `the mark use is an offence` TRUE FALSE FALSE TRUE

§ `penalties and s 44 composition`

#ASSERT `the maximum fine` `misusing the Agency's symbol` EQUALS 10000
#ASSERT `the maximum fine` `unlawful disclosure` EQUALS 2000
#ASSERT `the maximum fine` `misusing an accreditation mark` EQUALS 50000

#ASSERT `the maximum composition sum` `unlawful disclosure` TRUE EQUALS 1000
#ASSERT `the maximum composition sum` `misusing an accreditation mark` TRUE EQUALS 2000
#ASSERT `the maximum composition sum` `misusing an accreditation mark` FALSE EQUALS 0

§ `s 45(2) -- officers`

#ASSERT `the person is guilty of the same offence` `a consenting director` TRUE
#ASSERT `the person is guilty of the same offence` `a director who knew and did nothing` TRUE
#ASSERT NOT `the person is guilty of the same offence` `a director who knew and took all reasonable steps` TRUE
#ASSERT NOT `the person is guilty of the same offence` `a junior employee who consented` TRUE

