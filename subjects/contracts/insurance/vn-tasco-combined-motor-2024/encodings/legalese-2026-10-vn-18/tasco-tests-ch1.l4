    `permitted number of people`                              IS 5
    `number of people carried, not counting children under 7` IS 6

`a load 10% over with 8 people where 5 are permitted` MEANS `The load at the time of the loss` WITH
    `permitted load`                                          IS 1_000
    `load carried, towed or lifted`                           IS 1_100
    `permitted number of people`                              IS 5
    `number of people carried, not counting children under 7` IS 8

`90 on a 60 limit` MEANS `The speed at the time of the loss` WITH
    `speed limit`                            IS 60
    `speed found by the competent authority` IS JUST 90
    `the finding is in writing`              IS TRUE

`89 on a 60 limit` MEANS `The speed at the time of the loss` WITH
    `speed limit`                            IS 60
    `speed found by the competent authority` IS JUST 89
    `the finding is in writing`              IS TRUE

`72 on a 60 limit, in writing` MEANS `The speed at the time of the loss` WITH
    `speed limit`                            IS 60
    `speed found by the competent authority` IS JUST 72
    `the finding is in writing`              IS TRUE

`71 on a 60 limit, in writing` MEANS `The speed at the time of the loss` WITH
    `speed limit`                            IS 60
    `speed found by the competent authority` IS JUST 71
    `the finding is in writing`              IS TRUE

`72 on a 60 limit, not in writing` MEANS `The speed at the time of the loss` WITH
    `speed limit`                            IS 60
    `speed found by the competent authority` IS JUST 72
    `the finding is in writing`              IS FALSE

`an intentional loss` MEANS `The circumstances of the loss` WITH
    `intentional damage by an excluded person`               IS TRUE
    `in road traffic`                                        IS TRUE
    `inspection certificate`                                 IS `valid and in force`
    `driver`                                                 IS `a sober licensed driver`
    `special equipment operated without the required permit` IS FALSE
    `way the vehicle was driven`                             IS `lawful driving`
    `racing, lawful or not`                                  IS FALSE
    `towing another vehicle unlawfully`                      IS FALSE
    `carrying goods unlawfully`                              IS FALSE
    `carrying explosives or flammable substances`            IS FALSE
    `outside Vietnam`                                        IS FALSE
    `war or terrorism`                                       IS FALSE
    `vandalism in a protest, riot or public disorder`        IS FALSE
    `bombs, mines or explosive devices`                      IS FALSE
    `load`                                                   IS `a load within the limits`
    `speed`                                                  IS `no speed finding`

