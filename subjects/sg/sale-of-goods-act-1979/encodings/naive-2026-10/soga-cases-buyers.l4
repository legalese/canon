§ `s 6`

#ASSERT `the contract is void under section 6` TRUE TRUE FALSE
#ASSERT NOT `the contract is void under section 6` FALSE TRUE FALSE

§ `ss 14, 15A`

#ASSERT `the satisfactory quality condition covers the defect` `a shop sale with a hidden defect`
#ASSERT NOT `the satisfactory quality condition covers the defect` `a private sale with a hidden defect`
#ASSERT NOT `the satisfactory quality condition covers the defect` `a shop sale with the defect pointed out`
#ASSERT NOT `the satisfactory quality condition covers the defect` `a shop sale where inspection should have shown the defect`
#ASSERT `the satisfactory quality condition covers the defect` `a shop sale inspected but the defect hidden`
#ASSERT `the satisfactory quality condition covers the defect` `a consignment sale for an undisclosed private owner`
#ASSERT NOT `the satisfactory quality condition covers the defect` `a consignment sale where the buyer was told the owner was private`

#ASSERT `the fitness for purpose condition is implied` `a shop sale for a stated purpose`
#ASSERT NOT `the fitness for purpose condition is implied` `a shop sale for a stated purpose without reliance on the seller`
#ASSERT NOT `the fitness for purpose condition is implied` `a shop sale with a hidden defect`

#ASSERT `the buyer may reject the goods for the defect` `a shop sale with a hidden defect`
#ASSERT NOT `the buyer may reject the goods for the defect` `a private sale with a hidden defect`
#ASSERT NOT `the buyer may reject the goods for the defect` `a shop sale to a business buyer of a slight defect`
#ASSERT `the buyer may reject the goods for the defect` `a shop sale to a consumer of a slight defect`
#ASSERT NOT `the buyer may reject the goods for the defect` `a shop sale after the buyer accepted the goods`

#ASSERT `the buyer may claim damages for the defect` `a shop sale to a business buyer of a slight defect`
#ASSERT `the buyer may claim damages for the defect` `a shop sale after the buyer accepted the goods`

