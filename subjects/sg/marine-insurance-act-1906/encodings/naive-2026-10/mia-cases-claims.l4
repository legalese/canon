IMPORT prelude
IMPORT `mia-claims`

-- Marine Insurance Act 1906, ss 4, 6, 17, 18, 33, 34, 39, 46, 48, 49, 55, 57, 60 to 62, 67 to 69, 71, 81 and 84 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_marine-insurance-act-1906.py). Expected results were written by
-- hand from the text.

`a prior grounding the owner did not mention` MEANS Circumstance WITH
    `material` IS TRUE
    `known or ought to be known to the assured` IS TRUE
    `disclosed` IS FALSE
    `the insurer asked about it` IS FALSE
    `it diminishes the risk` IS FALSE
    `known or presumed known to the insurer` IS FALSE
    `information waived by the insurer` IS FALSE
    `superfluous because of a warranty` IS FALSE

`a prior grounding the owner disclosed` MEANS Circumstance WITH
    `material` IS TRUE
    `known or ought to be known to the assured` IS TRUE
    `disclosed` IS TRUE
    `the insurer asked about it` IS FALSE
    `it diminishes the risk` IS FALSE
    `known or presumed known to the insurer` IS FALSE
    `information waived by the insurer` IS FALSE
    `superfluous because of a warranty` IS FALSE

