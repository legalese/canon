#ASSERT `the membership complies with section 5` TRUE 6 TRUE
#ASSERT NOT `the membership complies with section 5` TRUE 5 TRUE
#ASSERT NOT `the membership complies with section 5` TRUE 11 TRUE
#ASSERT NOT `the membership complies with section 5` TRUE 8 FALSE

