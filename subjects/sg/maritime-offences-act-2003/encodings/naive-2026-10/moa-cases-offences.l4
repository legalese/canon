IMPORT prelude
IMPORT `moa-offences`

-- Maritime Offences Act 2003, ss 2-8, 11-15 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_maritime-offences-act-2003.py). Expected results were written by
-- hand from the text.

`a container ship` MEANS Craft WITH
    `a vessel or other floating craft` IS TRUE
    `an artificial island, installation or structure` IS FALSE
    `permanently rests on or attached to the seabed` IS FALSE
    `withdrawn from navigation or laid up` IS FALSE
    `for exploration, exploitation or another economic purpose` IS FALSE

`a hovercraft` MEANS Craft WITH
    `a vessel or other floating craft` IS TRUE
    `an artificial island, installation or structure` IS FALSE
    `permanently rests on or attached to the seabed` IS FALSE
    `withdrawn from navigation or laid up` IS FALSE
    `for exploration, exploitation or another economic purpose` IS FALSE

`a laid-up tanker` MEANS Craft WITH
    `a vessel or other floating craft` IS TRUE
    `an artificial island, installation or structure` IS FALSE
    `permanently rests on or attached to the seabed` IS FALSE
    `withdrawn from navigation or laid up` IS TRUE
    `for exploration, exploitation or another economic purpose` IS FALSE

`a wreck permanently resting on the seabed` MEANS Craft WITH
    `a vessel or other floating craft` IS TRUE
    `an artificial island, installation or structure` IS FALSE
    `permanently rests on or attached to the seabed` IS TRUE
    `withdrawn from navigation or laid up` IS FALSE
    `for exploration, exploitation or another economic purpose` IS FALSE

`an offshore oil platform` MEANS Craft WITH
    `a vessel or other floating craft` IS FALSE
    `an artificial island, installation or structure` IS TRUE
    `permanently rests on or attached to the seabed` IS TRUE
    `withdrawn from navigation or laid up` IS FALSE
    `for exploration, exploitation or another economic purpose` IS TRUE

`an unmoored floating structure` MEANS Craft WITH
    `a vessel or other floating craft` IS FALSE
    `an artificial island, installation or structure` IS TRUE
    `permanently rests on or attached to the seabed` IS FALSE
    `withdrawn from navigation or laid up` IS FALSE
    `for exploration, exploitation or another economic purpose` IS FALSE

`a foreigner seizes a foreign merchant ship on the high seas` MEANS Incident WITH
    `the target is a warship, naval auxiliary, customs or law enforcement vessel` IS FALSE
    `the target is in Singapore's naval, customs or law enforcement service` IS FALSE
    `the offender is a citizen of Singapore` IS FALSE
    `the act is committed in Singapore` IS FALSE

`a foreigner seizes a foreign warship abroad` MEANS Incident WITH
    `the target is a warship, naval auxiliary, customs or law enforcement vessel` IS TRUE
    `the target is in Singapore's naval, customs or law enforcement service` IS FALSE
    `the offender is a citizen of Singapore` IS FALSE
    `the act is committed in Singapore` IS FALSE

`a Singapore citizen seizes a foreign warship abroad` MEANS Incident WITH
    `the target is a warship, naval auxiliary, customs or law enforcement vessel` IS TRUE
    `the target is in Singapore's naval, customs or law enforcement service` IS FALSE
    `the offender is a citizen of Singapore` IS TRUE
    `the act is committed in Singapore` IS FALSE

`a foreigner seizes a foreign customs launch in Singapore` MEANS Incident WITH
    `the target is a warship, naval auxiliary, customs or law enforcement vessel` IS TRUE
    `the target is in Singapore's naval, customs or law enforcement service` IS FALSE
    `the offender is a citizen of Singapore` IS FALSE
    `the act is committed in Singapore` IS TRUE

`a foreigner seizes a Singapore police vessel abroad` MEANS Incident WITH
    `the target is a warship, naval auxiliary, customs or law enforcement vessel` IS TRUE
    `the target is in Singapore's naval, customs or law enforcement service` IS TRUE
    `the offender is a citizen of Singapore` IS FALSE
    `the act is committed in Singapore` IS FALSE

§ `s 2`

#ASSERT `the craft is a ship` `a container ship`
#ASSERT NOT `the craft is a ship` `a laid-up tanker`
#ASSERT NOT `the craft is a ship` `a wreck permanently resting on the seabed`
#ASSERT NOT `the craft is a ship` `an offshore oil platform`
#ASSERT NOT `the craft is a ship` `an unmoored floating structure`

#ASSERT NOT `the craft is a fixed platform` `a container ship`
#ASSERT `the craft is a fixed platform` `an offshore oil platform`
#ASSERT NOT `the craft is a fixed platform` `an unmoored floating structure`

§ `ss 3(2), 4(5), 5(6), 8(2)`

#ASSERT NOT `the service-vessel exclusion applies` `a foreigner seizes a foreign merchant ship on the high seas`
#ASSERT `the service-vessel exclusion applies` `a foreigner seizes a foreign warship abroad`
#ASSERT NOT `the service-vessel exclusion applies` `a Singapore citizen seizes a foreign warship abroad`
#ASSERT NOT `the service-vessel exclusion applies` `a foreigner seizes a foreign customs launch in Singapore`
#ASSERT NOT `the service-vessel exclusion applies` `a foreigner seizes a Singapore police vessel abroad`

§ `ss 3, 8`

#ASSERT `hijacking is committed` `a container ship` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE
#ASSERT NOT `hijacking is committed` `a container ship` `a foreigner seizes a foreign merchant ship on the high seas` FALSE TRUE TRUE
#ASSERT NOT `hijacking is committed` `a laid-up tanker` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE
#ASSERT `hijacking is committed` `an offshore oil platform` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE
#ASSERT NOT `hijacking is committed` `a hovercraft` `a foreigner seizes a foreign warship abroad` TRUE TRUE TRUE
#ASSERT `hijacking is committed` `a hovercraft` `a Singapore citizen seizes a foreign warship abroad` TRUE TRUE TRUE

§ `s 4`

#ASSERT `a section 4 offence is committed` `a container ship` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE `destroying the ship`
#ASSERT NOT `a section 4 offence is committed` `a container ship` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE `damaging cargo without endangering navigation`
#ASSERT `a section 4 offence is committed` `a container ship` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE `violence on board likely to endanger safe navigation`
#ASSERT `a section 4 offence is committed` `a container ship` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE `placing a device likely to destroy the ship`
#ASSERT NOT `a section 4 offence is committed` `a laid-up tanker` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE `destroying the ship`

§ `s 5(3), (4)`

#ASSERT `the false information offence is made out` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT `the false information offence is made out` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `the false information offence is made out` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `the false information offence is made out` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE FALSE TRUE

§ `s 6(1)`

#ASSERT `the threat offence is committed` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE TRUE
#ASSERT NOT `the threat offence is committed` `a foreigner seizes a foreign merchant ship on the high seas` TRUE TRUE FALSE

§ `ss 7(5), 11(4), 12(7), 13`

#ASSERT `the maximum penalty` `hijacking a ship (s 3)` EQUALS `imprisonment for life`
#ASSERT `the maximum penalty` `abetting a ship offence (s 7(4))` EQUALS `imprisonment for life`
#ASSERT `the maximum penalty` `attempting a ship offence (s 7(5))` EQUALS `imprisonment up to 15 years`
#ASSERT `the maximum penalty` `violence connected with a hijacking (s 7(1))` EQUALS `the penalty under the ordinary law for that act`
#ASSERT `the maximum penalty` `a master failing to notify or hand over evidence (s 12(7))` EQUALS `a fine up to 5000 dollars`

