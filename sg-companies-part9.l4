§§ `Part 9 — Illustrations`

-- s 232: investigation application (share capital company)
#ASSERT `may apply for investigation share capital company` 200 0
#ASSERT `may apply for investigation share capital company` 50 10
#ASSERT NOT (`may apply for investigation share capital company` 100 5)

-- s 232: investigation application (debenture holders)
#ASSERT `debenture holders may apply for investigation` 20
#ASSERT NOT (`debenture holders may apply for investigation` 19)

-- s 232: investigation application (no share capital)
#ASSERT `may apply for investigation no share capital company` 20
#ASSERT NOT (`may apply for investigation no share capital company` 15)
