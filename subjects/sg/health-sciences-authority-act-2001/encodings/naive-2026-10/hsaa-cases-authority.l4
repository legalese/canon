#ASSERT `the term of appointment is permitted` 3
#ASSERT NOT `the term of appointment is permitted` 4

#ASSERT `the resignation notice is sufficient` 1 TRUE TRUE
#ASSERT NOT `the resignation notice is sufficient` 0.5 TRUE TRUE
#ASSERT NOT `the resignation notice is sufficient` 2 FALSE TRUE

