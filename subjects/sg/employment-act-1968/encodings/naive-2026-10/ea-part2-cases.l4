IMPORT prelude
IMPORT `ea-part2`

-- Employment Act 1968, Part 2 -- worked cases.

§ `Fixtures`

GIVEN `w26` IS A BOOLEAN, `y2` IS A BOOLEAN, `y5` IS A BOOLEAN
GIVETH A ServiceLength
DECIDE `service` `w26` `y2` `y5` IS
    ServiceLength WITH
        `employed for 26 weeks or more` IS `w26`
        `employed for 2 years or more` IS `y2`
        `employed for 5 years or more` IS `y5`

`a new starter` MEANS `service` FALSE FALSE FALSE
`six months in` MEANS `service` TRUE FALSE FALSE
`three years in` MEANS `service` TRUE TRUE FALSE
`ten years in` MEANS `service` TRUE TRUE TRUE

§§ `10(3) -- the notice table, at every band`

#ASSERT `the minimum notice in days under section 10(3)` `a new starter` EQUALS 1
#ASSERT `the minimum notice in days under section 10(3)` `six months in` EQUALS 7
#ASSERT `the minimum notice in days under section 10(3)` `three years in` EQUALS 14
#ASSERT `the minimum notice in days under section 10(3)` `ten years in` EQUALS 28

§§ `8 with 10(2) -- the three-step chain`

GIVEN `provides` IS A BOOLEAN, `days` IS A NUMBER, `symmetrical` IS A BOOLEAN
GIVETH A ContractTerms
DECIDE `terms` `provides` `days` `symmetrical` IS
    ContractTerms WITH
        `the contract makes provision for notice` IS `provides`
        `the notice period the contract provides, in days` IS `days`
        `the contract provides the same length for both parties` IS `symmetrical`

`a silent contract` MEANS `terms` FALSE 0 TRUE
`a generous contract of 60 days` MEANS `terms` TRUE 60 TRUE
`a mean contract of 1 day` MEANS `terms` TRUE 1 TRUE
`a contract matching the Act for a ten year employee` MEANS `terms` TRUE 28 TRUE

-- Silent contract: s 10(2) sends the question straight to s 10(3).
#ASSERT `the notice period that governs, in days` `a silent contract` `ten years in` EQUALS 28

-- Generous contract: it governs, because s 8 only strikes down terms that are
-- LESS favourable.
#ASSERT NOT `the contractual notice term is void under section 8` `a generous contract of 60 days` `ten years in`
#ASSERT `the notice period that governs, in days` `a generous contract of 60 days` `ten years in` EQUALS 60

-- Mean contract: s 8 voids the term, and the chain then falls back to s 10(3)
-- because s 10(2) applies "in the absence of such provision". The employee gets
-- 28 days, not the 1 day the contract said.
#ASSERT `the contractual notice is less favourable than the Act` `a mean contract of 1 day` `ten years in`
#ASSERT `the contractual notice term is void under section 8` `a mean contract of 1 day` `ten years in`
#ASSERT `the notice period that governs, in days` `a mean contract of 1 day` `ten years in` EQUALS 28

-- The SAME one-day term is perfectly lawful for a new starter, because for them
-- the statutory minimum is also one day. Nothing about the term changes; what
-- changes is the length of service it is measured against.
#ASSERT NOT `the contractual notice term is void under section 8` `a mean contract of 1 day` `a new starter`
#ASSERT `the notice period that governs, in days` `a mean contract of 1 day` `a new starter` EQUALS 1

-- A term exactly matching the Act is not less favourable.
#ASSERT NOT `the contractual notice term is void under section 8` `a contract matching the Act for a ten year employee` `ten years in`
#ASSERT `the notice period that governs, in days` `a contract matching the Act for a ten year employee` `ten years in` EQUALS 28

§§ `10(2) -- the equal-length requirement is separate`

-- A contract may be generous AND still breach s 10(2)'s first limb, which is
-- about symmetry rather than length.
`an asymmetrical but generous contract` MEANS `terms` TRUE 60 FALSE

#ASSERT `the contract breaches the equal-length requirement in section 10(2)` `an asymmetrical but generous contract`
#ASSERT NOT `the contractual notice term is void under section 8` `an asymmetrical but generous contract` `ten years in`
#ASSERT NOT `the contract breaches the equal-length requirement in section 10(2)` `a silent contract`

§§ `10(5) -- the day of giving counts`

`a 28 day written notice` MEANS Notice WITH
    `the notice is in writing` IS TRUE
    `the length given, in days` IS 28
    `the receiving party waived the right to notice` IS FALSE

`an oral notice` MEANS Notice WITH
    `the notice is in writing` IS FALSE
    `the length given, in days` IS 28
    `the receiving party waived the right to notice` IS FALSE

`a short notice, waived` MEANS Notice WITH
    `the notice is in writing` IS TRUE
    `the length given, in days` IS 1
    `the receiving party waived the right to notice` IS TRUE

`a short notice, not waived` MEANS Notice WITH
    `the notice is in writing` IS TRUE
    `the length given, in days` IS 1
    `the receiving party waived the right to notice` IS FALSE

#ASSERT `the notice satisfies section 10(5)` `a 28 day written notice`
#ASSERT NOT `the notice satisfies section 10(5)` `an oral notice`
#ASSERT `days remaining after the day the notice is given` `a 28 day written notice` EQUALS 27

#ASSERT `the notice is long enough` `a 28 day written notice` `a silent contract` `ten years in`
#ASSERT NOT `the notice is long enough` `a short notice, not waived` `a silent contract` `ten years in`
-- s 10(4): waiver cures a short notice.
#ASSERT `the notice is long enough` `a short notice, waived` `a silent contract` `ten years in`

§§ `11 -- payment in lieu`

-- The sum tracks the notice period that governs, so it moves with the band and
-- with the s 8 chain. A $200-a-day employee of ten years' standing is owed
-- 28 days, even on the one-day contract.
#ASSERT `the payment in lieu of notice` 200 `a silent contract` `ten years in` EQUALS 5600
#ASSERT `the payment in lieu of notice` 200 `a mean contract of 1 day` `ten years in` EQUALS 5600
#ASSERT `the payment in lieu of notice` 200 `a silent contract` `a new starter` EQUALS 200

-- s 11(2): a wilful breach needs no payment at all.
#ASSERT `the party may terminate without notice and without payment under section 11(2)` TRUE
#ASSERT NOT `the party may terminate without notice and without payment under section 11(2)` FALSE

§§ `13 -- deemed breach, and the asymmetry between the parties`

-- s 13(1): the employer's deemed breach has exactly one element.
#ASSERT `the employer is deemed to have broken the contract` TRUE
#ASSERT NOT `the employer is deemed to have broken the contract` FALSE

GIVEN `days` IS A NUMBER, `leave` IS A BOOLEAN, `excuse` IS A BOOLEAN, `informed` IS A BOOLEAN
GIVETH AN Absence
DECIDE `an absence of` `days` `leave` `excuse` `informed` IS
    Absence WITH
        `days absent continuously` IS `days`
        `with prior leave from the employer` IS `leave`
        `the employee has a reasonable excuse for the absence` IS `excuse`
        `the employee informed or attempted to inform the employer of the excuse` IS `informed`

-- "more than 2 days": two days is not enough, three is.
#ASSERT NOT `the employee is deemed to have broken the contract` (`an absence of` 2 FALSE FALSE FALSE)
#ASSERT `the employee is deemed to have broken the contract` (`an absence of` 3 FALSE FALSE FALSE)

-- Prior leave defeats it however long the absence.
#ASSERT NOT `the employee is deemed to have broken the contract` (`an absence of` 30 TRUE FALSE FALSE)

-- A good excuse, communicated: neither limb is made out.
#ASSERT NOT `the employee is deemed to have broken the contract` (`an absence of` 10 FALSE TRUE TRUE)

-- A good excuse the employee never mentioned: limb (b) is made out on its own,
-- so the employee is deemed to have broken the contract DESPITE having a
-- reasonable excuse. The limbs are joined by "or", not "and".
#ASSERT `the employee is deemed to have broken the contract` (`an absence of` 10 FALSE TRUE FALSE)

-- And the converse: no excuse, but the employee did tell the employer. Limb (a)
-- alone carries it.
#ASSERT `the employee is deemed to have broken the contract` (`an absence of` 10 FALSE FALSE TRUE)

§§ `14(1) -- dismissal needs a due inquiry`

GIVEN `misconduct` IS A BOOLEAN, `inquiry` IS A BOOLEAN, `suspended` IS A BOOLEAN, `days` IS A NUMBER
GIVETH A DismissalFacts
DECIDE `dismissal facts` `misconduct` `inquiry` `suspended` `days` IS
    DismissalFacts WITH
        `there was misconduct inconsistent with the conditions of service` IS `misconduct`
        `the employer held a due inquiry` IS `inquiry`
        `the employee was instead down-graded` IS FALSE
        `the employee was instead suspended without salary` IS `suspended`
        `the days of suspension` IS `days`

#ASSERT `the employer may dismiss without notice under section 14(1)` (`dismissal facts` TRUE TRUE FALSE 0)
-- Misconduct without an inquiry is not enough.
#ASSERT NOT `the employer may dismiss without notice under section 14(1)` (`dismissal facts` TRUE FALSE FALSE 0)
-- An inquiry that finds no misconduct is not enough either.
#ASSERT NOT `the employer may dismiss without notice under section 14(1)` (`dismissal facts` FALSE TRUE FALSE 0)

-- s 14(1)(b): "a period not exceeding one week" -- 7 days is in, 8 is out.
#ASSERT `the suspension is lawful under section 14(1)(b)` (`dismissal facts` TRUE TRUE TRUE 7)
#ASSERT NOT `the suspension is lawful under section 14(1)(b)` (`dismissal facts` TRUE TRUE TRUE 8)
-- And the lesser measure still needs the due inquiry, because it is offered
-- "instead of dismissing".
#ASSERT NOT `the suspension is lawful under section 14(1)(b)` (`dismissal facts` TRUE FALSE TRUE 3)

§§ `14(2A) -- who may claim wrongful dismissal`

GIVEN `manager` IS A BOOLEAN, `with notice` IS A BOOLEAN, `in lieu` IS A BOOLEAN, `six months` IS A BOOLEAN
GIVETH A Dismissed
DECIDE `a dismissed employee` `manager` `with notice` `in lieu` `six months` IS
    Dismissed WITH
        `in a managerial or an executive position` IS `manager`
        `dismissed with notice` IS `with notice`
        `dismissed without notice but paid salary in lieu` IS `in lieu`
        `served that employer for at least 6 months in any position` IS `six months`

-- (a): a manager dismissed with notice needs 6 months' service.
#ASSERT `the employee may lodge a wrongful dismissal claim` (`a dismissed employee` TRUE TRUE FALSE TRUE)
#ASSERT NOT `the employee may lodge a wrongful dismissal claim` (`a dismissed employee` TRUE TRUE FALSE FALSE)

-- (b): a manager dismissed WITHOUT notice and WITHOUT salary in lieu is a
-- relevant employee with no service qualification at all. The manager sacked on
-- the spot in week one may claim; the one given proper notice in week one may
-- not.
#ASSERT `the employee may lodge a wrongful dismissal claim` (`a dismissed employee` TRUE FALSE FALSE FALSE)
#ASSERT `the employee is a relevant employee under section 14(2A)(b)` (`a dismissed employee` TRUE FALSE FALSE FALSE)
#ASSERT NOT `the employee is a relevant employee under section 14(2A)(a)` (`a dismissed employee` TRUE FALSE FALSE FALSE)
