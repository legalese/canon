#ASSERT NOT `the person qualifies as an authorised representative` (`Representative Qualification Facts` OF FALSE, 30, TRUE, TRUE)

-- 11(3): at registration, or the date business commences if later
regTrig MEANS `residing outside Singapore at the time of registration` (YMD 2026 3 1) (YMD 2026 3 15)
#ASSERT `the last day for appointing an authorised representative` regTrig EQUALS YMD 2026 3 15
#ASSERT `the last day for appointing an authorised representative` (`residing outside Singapore at the time of registration` (YMD 2026 3 1) (YMD 2026 3 1)) EQUALS YMD 2026 3 1
#ASSERT `the authorised representative is appointed in time` regTrig (YMD 2026 3 15)
#ASSERT NOT `the authorised representative is appointed in time` regTrig (YMD 2026 3 16)
-- 11(4): within 30 days after the date of ceasing to reside
ceaseTrig MEANS `ceasing to reside in Singapore after registration` (YMD 2026 3 1)
#ASSERT `the last day for appointing an authorised representative` ceaseTrig EQUALS YMD 2026 3 31
#ASSERT `the authorised representative is appointed in time` ceaseTrig (YMD 2026 3 31)
#ASSERT NOT `the authorised representative is appointed in time` ceaseTrig (YMD 2026 4 1)
-- 11(11)
soleTrig MEANS `the sole authorised representative ceasing` (YMD 2026 3 1)
#ASSERT `the last day for appointing an authorised representative` soleTrig EQUALS YMD 2026 3 31
#ASSERT NOT `the authorised representative is appointed in time` soleTrig (YMD 2026 4 1)

-- 11(5), (6)
#ASSERT `the authorised representative is personally responsible for the obligation` (`Representative Liability Facts` OF YMD 2026 3 1, YMD 2026 3 1, FALSE)
#ASSERT `the authorised representative is personally responsible for the obligation` (`Representative Liability Facts` OF YMD 2026 3 1, YMD 2026 3 2, FALSE)
#ASSERT NOT `the authorised representative is personally responsible for the obligation` (`Representative Liability Facts` OF YMD 2026 3 1, YMD 2026 2 28, FALSE)
