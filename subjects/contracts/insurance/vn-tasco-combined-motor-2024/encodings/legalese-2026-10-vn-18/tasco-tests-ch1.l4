`a contract with payment agreed for 15 June 2024, never paid, debt agreed` MEANS `The contract` WITH
    `date the contract was concluded`                    IS YMD 2024 6 1
    `start of the insurance period`                      IS YMD 2024 6 1
    `end of the insurance period`                        IS YMD 2025 5 31
    `premium`                                            IS 10_000_000
    `agreed date for paying the premium`                 IS JUST (YMD 2024 6 15)
    `date the premium was paid in full`                  IS NOTHING
    `a written agreement lets the buyer owe the premium` IS TRUE
    `vehicle`                                            IS `a private car registered in May 2021`

`a driver with no licence` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `no licence`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`a driver with a suspended licence` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a licence suspended for a period or withdrawn`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`a driver with an expired licence` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a licence expired at the time of the accident`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`a driver whose licence was lost in this accident` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a licence lost in this same accident, confirmed by the competent authority`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`a driver whose licence awaits reissue` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a licence lost before the accident, reported, awaiting reissue, with its original records`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`an under-age driver` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS FALSE
    `driving licence`                                     IS `a valid licence in force, appropriate to the vehicle`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`a drunk driver` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a valid licence in force, appropriate to the vehicle`
    `alcohol above the Ministry of Health's normal level` IS TRUE
    `using prohibited drugs or stimulants`                IS FALSE

`a driver on drugs` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a valid licence in force, appropriate to the vehicle`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS TRUE

`running a red light` MEANS `The way the vehicle was driven` WITH
    `entered a prohibited road or area`                                   IS FALSE
    `drove against the direction of traffic`                              IS FALSE
    `reversed on an expressway`                                           IS FALSE
    `turned or made a U-turn where prohibited`                            IS FALSE
    `stopped or parked where a sign prohibits it`                         IS FALSE
    `ran a red light or disobeyed a traffic controller`                   IS TRUE
    `drove at night without the required lights`                          IS FALSE
    `entered a bus or tram lane, or a road barred to its class by a sign` IS FALSE

`driving into a bus lane` MEANS `The way the vehicle was driven` WITH
    `entered a prohibited road or area`                                   IS FALSE
    `drove against the direction of traffic`                              IS FALSE
    `reversed on an expressway`                                           IS FALSE
    `turned or made a U-turn where prohibited`                            IS FALSE
    `stopped or parked where a sign prohibits it`                         IS FALSE
    `ran a red light or disobeyed a traffic controller`                   IS FALSE
    `drove at night without the required lights`                          IS FALSE
    `entered a bus or tram lane, or a road barred to its class by a sign` IS TRUE

`a load 50% over` MEANS `The load at the time of the loss` WITH
    `permitted load`                                          IS 1_000
    `load carried, towed or lifted`                           IS 1_500
    `permitted number of people`                              IS 5
    `number of people carried, not counting children under 7` IS 4

`a load 49.9% over` MEANS `The load at the time of the loss` WITH
    `permitted load`                                          IS 1_000
    `load carried, towed or lifted`                           IS 1_499
    `permitted number of people`                              IS 5
    `number of people carried, not counting children under 7` IS 4

`a load 30% over` MEANS `The load at the time of the loss` WITH
    `permitted load`                                          IS 1_000
    `load carried, towed or lifted`                           IS 1_300
    `permitted number of people`                              IS 5
    `number of people carried, not counting children under 7` IS 4

`a load 20% over` MEANS `The load at the time of the loss` WITH
