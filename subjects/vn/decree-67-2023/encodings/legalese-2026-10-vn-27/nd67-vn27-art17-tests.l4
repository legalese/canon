#ASSERT `Article 17(1) — the ceilings` EQUALS LIST (`A ceiling of Article 17(1)` OF `(a) humanitarian support, and repaying advances`, 30, TRUE), (`A ceiling of Article 17(1)` OF `(b) works and equipment to prevent and limit losses and road accidents`, 15, TRUE), (`A ceiling of Article 17(1)` OF `(c) propaganda and education on road safety and the compulsory motor insurance`, 17, TRUE), (`A ceiling of Article 17(1)` OF `(d) support for the police`, 10, FALSE), (`A ceiling of Article 17(1)` OF `(dd) rewards for achievement`, 5, FALSE), (`A ceiling of Article 17(1)` OF `(e) the database of the compulsory motor insurance`, 10, FALSE), (`A ceiling of Article 17(1)` OF `(g) the ASEAN compulsory motor insurance programme`, 5, FALSE), (`A ceiling of Article 17(1)` OF `(h) managing the Fund`, 8, FALSE)
#ASSERT sum (map (GIVEN r YIELD r's percent) `Article 17(1) — the ceilings`) EQUALS 100
#ASSERT `Article 17(1) — the most the Fund may spend in a year under` `(a) humanitarian support, and repaying advances` `, on contributions of` 100000000000 `and a balance of earlier years of` 20000000000 EQUALS 36000000000
