#ASSERT `s 2(a) — the income ceiling for the tax year` 2025 EQUALS 0
#ASSERT `s 2(a) — the income ceiling for the tax year` 2026 EQUALS 600_000
#ASSERT `s 2(a) — the income ceiling for the tax year` 2027 EQUALS 1_000_000
#ASSERT `s 2(a) — the income ceiling for the tax year` 2028 EQUALS 1_000_000
#ASSERT `s 2(a) — the income ceiling for the tax year` 2029 EQUALS 350_000
#ASSERT `s 2(a) — the income ceiling for the tax year` 2030 EQUALS 150_000
#ASSERT `s 2(a) — the income ceiling for the tax year` 2031 EQUALS 0
