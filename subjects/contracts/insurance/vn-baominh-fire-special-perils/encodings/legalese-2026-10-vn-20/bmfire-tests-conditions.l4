#ASSERT `VII.2(b)(i) — the benefit of the rejected claim is lost` (YMD 2026 3 15) NOTHING (YMD 2027 3 16)
#ASSERT NOT `VII.2(b)(i) — the benefit of the rejected claim is lost` (YMD 2026 3 15) (JUST (YMD 2027 3 15)) (YMD 2027 6 1)
#ASSERT `VII.2(b)(i) — the benefit of the rejected claim is lost` (YMD 2026 3 15) (JUST (YMD 2027 3 16)) (YMD 2027 6 1)
-- An award of 31 August 2026: suit by 31 August 2027.
#ASSERT NOT `VII.2(b)(ii) — the benefit of the arbitrated claim is lost` (YMD 2026 8 31) NOTHING (YMD 2027 8 31)
#ASSERT `VII.2(b)(ii) — the benefit of the arbitrated claim is lost` (YMD 2026 8 31) NOTHING (YMD 2027 9 1)

§§ `VII.8 — two months`

#ASSERT `VII.8 — the end of two months from receipt` (YMD 2026 3 15) EQUALS YMD 2026 5 15
#ASSERT `VII.8 — the end of two months from receipt` (YMD 2026 12 31) EQUALS YMD 2027 2 28

§§ `V, VII.4, VII.9`

GIVEN signed IS A BOOLEAN
      done   IS A BOOLEAN
      harm   IS A BOOLEAN
      cover  IS A BOOLEAN
GIVETH A `A pending sale of insured property`
`a sale` signed done harm cover MEANS
    `A pending sale of insured property` WITH
        `contract of sale signed before the DAMAGE, formalities not complete` IS signed
        `the sale formalities have since been completed`                     IS done
        `the buyer's benefit would prejudice the obligations or rights of the Insured or of Bao Minh` IS harm
        `the buyer, or its representative, has insured the property`         IS cover
#ASSERT `V — the buyer takes the benefit of the insurance` (`a sale` TRUE TRUE FALSE FALSE)
#ASSERT NOT `V — the buyer takes the benefit of the insurance` (`a sale` TRUE FALSE FALSE FALSE)
#ASSERT NOT `V — the buyer takes the benefit of the insurance` (`a sale` TRUE TRUE TRUE FALSE)
#ASSERT NOT `V — the buyer takes the benefit of the insurance` (`a sale` TRUE TRUE FALSE TRUE)

#ASSERT NOT `VII.4 — an abandonment of property to Bao Minh has effect` TRUE
#ASSERT NOT `VII.4 — an abandonment of property to Bao Minh has effect` FALSE

#ASSERT `VII.9 — a notice to Bao Minh counts` TRUE
#ASSERT NOT `VII.9 — a notice to Bao Minh counts` FALSE

§§ `The duties, traced`

-- VII.1, no deliberate act: the four duties done, the written claim on day 20 -> FULFILLED.
#TRACE `VII.1 — the Insured's duties after an incident` (`the facts` `fire`) 30 AT 0 WITH
    PARTY `the Insured` DOES `take steps to minimise the loss and recover lost property` AT 0
    PARTY `the Insured` DOES `notify Bao Minh in writing` AT 0
    PARTY `the Insured` DOES `deliver the written claim, with particulars of any other insurance` AT 20

-- The written claim on day 31 -> BREACH, VII.1(b).
#TRACE `VII.1 — the Insured's duties after an incident` (`the facts` `fire`) 30 AT 0 WITH
    PARTY `the Insured` DOES `take steps to minimise the loss and recover lost property` AT 0
    PARTY `the Insured` DOES `notify Bao Minh in writing` AT 0
    PARTY `the Insured` DOES `deliver the written claim, with particulars of any other insurance` AT 31

-- VIII.3: paid on day 30 -> FULFILLED; nothing by day 31 -> BREACH, cover cancelled.
#TRACE `VIII.3 — the Insured must pay the premium in full` 30 AT 0 WITH
    PARTY `the Insured` DOES `pay the premium in full` AT 30
#TRACE `VIII.3 — the Insured must pay the premium in full` 30 AT 0 WITH
    (`WAIT UNTIL` 31)

-- IV: insuring the deductible on day 100 of the period -> BREACH.
#TRACE `IV — the Insured must not insure the deductible` `the Summary` AT 0 WITH
    PARTY `the Insured` DOES `insure the deductible` AT 100

-- VI.4: Bao Minh sends notice on day 5; the refund duty then stands.
#TRACE `VI.4 — Bao Minh may cancel on seven days' notice` AT 0 WITH
    PARTY `Bao Minh` DOES `send notice of cancellation by registered letter to the Insured's last known address` AT 5

-- VII.8, in months: no sole arbitrator agreed within 2; the Insured appoints in month 3,
-- Bao Minh does not by month 5 -> the Insured may appoint a sole arbitrator.
#TRACE `VII.8 — appointing the arbitrators, in months` AT 0 WITH
    (`WAIT UNTIL` 3)
    PARTY `the Insured` DOES `appoint an arbitrator in writing` AT 3
    (`WAIT UNTIL` 6)

-- The standing duties with no period, printed back.
#TRACE `closing note — the Insured must disclose` AT 0 WITH
    (`WAIT UNTIL` 400)
#TRACE `VI.6 — the Insured must look after the property` AT 0 WITH
    (`WAIT UNTIL` 400)
