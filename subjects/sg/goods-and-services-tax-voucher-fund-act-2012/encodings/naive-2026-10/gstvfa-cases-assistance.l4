IMPORT prelude
IMPORT `gstvfa-assistance`

-- Goods and Services Tax Voucher Fund Act 2012, ss 3(4), 4(1)(a), 6, 8A, 9 to 12, 16 to 18 and 19(2)(c) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_goods-and-services-tax-voucher-fund-act-2012.py). Expected results were written by
-- hand from the text.

`an applicant who knowingly understates household income` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS TRUE
    `knew the statement was false` IS TRUE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS FALSE
    `the document is false in a material particular` IS FALSE
    `knew the document was false` IS FALSE

`an applicant who ticks an answer without caring whether it is true` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS TRUE
    `knew the statement was false` IS FALSE
    `was reckless whether the statement was true` IS TRUE
    `produced or caused or allowed a document to be produced` IS FALSE
    `the document is false in a material particular` IS FALSE
    `knew the document was false` IS FALSE

`an applicant who makes an honest mistake` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS TRUE
    `knew the statement was false` IS FALSE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS FALSE
    `the document is false in a material particular` IS FALSE
    `knew the document was false` IS FALSE

`a son who knowingly misstates his mother's address on her behalf` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS TRUE
    `knew the statement was false` IS TRUE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS FALSE
    `the document is false in a material particular` IS FALSE
    `knew the document was false` IS FALSE

`an applicant who knowingly submits a forged payslip` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS FALSE
    `knew the statement was false` IS FALSE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS TRUE
    `the document is false in a material particular` IS TRUE
    `knew the document was false` IS TRUE

`an applicant who recklessly submits an unchecked false document` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS FALSE
    `knew the statement was false` IS FALSE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS TRUE
    `the document is false in a material particular` IS TRUE
    `knew the document was false` IS FALSE

`an applicant who knowingly submits a document false only in a trivial detail` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS TRUE
    `made a false statement` IS FALSE
    `knew the statement was false` IS FALSE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS TRUE
    `the document is false in a material particular` IS FALSE
    `knew the document was false` IS TRUE

`a knowingly false statement unconnected with any application` MEANS `Conduct in an application` WITH
    `relates to an application for assistance from the Fund` IS FALSE
    `made a false statement` IS TRUE
    `knew the statement was false` IS TRUE
    `was reckless whether the statement was true` IS FALSE
    `produced or caused or allowed a document to be produced` IS FALSE
    `the document is false in a material particular` IS FALSE
    `knew the document was false` IS FALSE

§ `ss 4(1)(a) and 8A`

#ASSERT `the Fund may assist the person` TRUE TRUE
#ASSERT NOT `the Fund may assist the person` TRUE FALSE
#ASSERT NOT `the Fund may assist the person` FALSE TRUE

#ASSERT NOT `the person has an absolute right to the assistance` TRUE
#ASSERT NOT `the person has an absolute right to the assistance` FALSE

§ `s 6`

#ASSERT `the payment may be made` TRUE TRUE FALSE
#ASSERT `the payment may be made` TRUE FALSE TRUE
#ASSERT NOT `the payment may be made` TRUE FALSE FALSE
#ASSERT NOT `the payment may be made` FALSE TRUE FALSE

§ `s 9`

#ASSERT `the other public authority must disclose` TRUE TRUE FALSE
#ASSERT NOT `the other public authority must disclose` TRUE TRUE TRUE
#ASSERT NOT `the other public authority must disclose` FALSE TRUE FALSE
#ASSERT NOT `the other public authority must disclose` TRUE FALSE FALSE

§ `s 10`

#ASSERT `the disclosure is an offence under s 10` TRUE TRUE FALSE FALSE
#ASSERT NOT `the disclosure is an offence under s 10` TRUE TRUE TRUE FALSE
#ASSERT NOT `the disclosure is an offence under s 10` TRUE TRUE FALSE TRUE
#ASSERT NOT `the disclosure is an offence under s 10` FALSE TRUE FALSE FALSE
#ASSERT NOT `the disclosure is an offence under s 10` TRUE FALSE FALSE FALSE

§ `s 11`

#ASSERT `the amount recoverable as a debt` 850 0 EQUALS 850
#ASSERT `the amount recoverable as a debt` 850 450 EQUALS 400
#ASSERT `the amount recoverable as a debt` 450 450 EQUALS 0
#ASSERT `the amount recoverable as a debt` 300 450 EQUALS 0

§ `s 12`

#ASSERT `the financial year begins in` 4 2026 EQUALS 2026
#ASSERT `the financial year begins in` 3 2026 EQUALS 2025
#ASSERT `the financial year begins in` 12 2026 EQUALS 2026
#ASSERT `the financial year begins in` 1 2027 EQUALS 2026

§ `s 16`

#ASSERT `the conduct is an offence under s 16` `an applicant who knowingly understates household income`
#ASSERT `the conduct is an offence under s 16` `an applicant who ticks an answer without caring whether it is true`
#ASSERT NOT `the conduct is an offence under s 16` `an applicant who makes an honest mistake`
#ASSERT `the conduct is an offence under s 16` `a son who knowingly misstates his mother's address on her behalf`
#ASSERT `the conduct is an offence under s 16` `an applicant who knowingly submits a forged payslip`
#ASSERT NOT `the conduct is an offence under s 16` `an applicant who recklessly submits an unchecked false document`
#ASSERT NOT `the conduct is an offence under s 16` `an applicant who knowingly submits a document false only in a trivial detail`
#ASSERT NOT `the conduct is an offence under s 16` `a knowingly false statement unconnected with any application`

§ `ss 10(2), 16 and 19(2)(c)`

#ASSERT `the maximum fine in dollars` `an unauthorised disclosure under s 10` EQUALS 5000
#ASSERT `the maximum fine in dollars` `a false statement or document under s 16` EQUALS 5000
#ASSERT `the maximum fine in dollars` `a contravention of the regulations` EQUALS 5000

#ASSERT `the maximum imprisonment in months` `an unauthorised disclosure under s 10` EQUALS 12
#ASSERT `the maximum imprisonment in months` `a false statement or document under s 16` EQUALS 12

§ `s 17`

#ASSERT `the officer is also guilty` TRUE TRUE FALSE
#ASSERT `the officer is also guilty` TRUE FALSE TRUE
#ASSERT NOT `the officer is also guilty` TRUE FALSE FALSE
#ASSERT NOT `the officer is also guilty` FALSE TRUE TRUE

§ `s 18`

#ASSERT `the offence may be compounded` TRUE TRUE
#ASSERT NOT `the offence may be compounded` FALSE TRUE

#ASSERT `the maximum composition sum` 5000 EQUALS 1000
#ASSERT `the maximum composition sum` 1500 EQUALS 750
#ASSERT `the maximum composition sum` 2000 EQUALS 1000

§ `s 3(4)`

#ASSERT `the net income from investments` 100000 20000 0 EQUALS 120000
#ASSERT `the net income from investments` 100000 0 30000 EQUALS 70000

