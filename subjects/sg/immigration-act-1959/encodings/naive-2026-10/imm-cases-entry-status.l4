IMPORT prelude
IMPORT `imm-entry-status`

-- Immigration Act 1959, ss 5 to 15, 36, 39A and 39B -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_imm.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a returning citizen` MEANS Entrant WITH
    `is a citizen` IS TRUE
    `holds a valid entry or re-entry permit` IS FALSE
    `is endorsed on a permit and with its holder` IS FALSE
    `holds a valid pass` IS FALSE
    `is exempted by order` IS FALSE

`a permanent resident with a re-entry permit` MEANS Entrant WITH
    `is a citizen` IS FALSE
    `holds a valid entry or re-entry permit` IS TRUE
    `is endorsed on a permit and with its holder` IS FALSE
    `holds a valid pass` IS FALSE
    `is exempted by order` IS FALSE

`a child endorsed on a parent's permit` MEANS Entrant WITH
    `is a citizen` IS FALSE
    `holds a valid entry or re-entry permit` IS FALSE
    `is endorsed on a permit and with its holder` IS TRUE
    `holds a valid pass` IS FALSE
    `is exempted by order` IS FALSE

`a tourist with a visit pass` MEANS Entrant WITH
    `is a citizen` IS FALSE
    `holds a valid entry or re-entry permit` IS FALSE
    `is endorsed on a permit and with its holder` IS FALSE
    `holds a valid pass` IS TRUE
    `is exempted by order` IS FALSE

`a diplomat exempted by order` MEANS Entrant WITH
    `is a citizen` IS FALSE
    `holds a valid entry or re-entry permit` IS FALSE
    `is endorsed on a permit and with its holder` IS FALSE
    `holds a valid pass` IS FALSE
    `is exempted by order` IS TRUE

`a foreigner arriving with nothing` MEANS Entrant WITH
    `is a citizen` IS FALSE
    `holds a valid entry or re-entry permit` IS FALSE
    `is endorsed on a permit and with its holder` IS FALSE
    `holds a valid pass` IS FALSE
    `is exempted by order` IS FALSE

`a foreign jail sentence deemed undesirable` MEANS ForeignConviction WITH
