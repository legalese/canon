@@fx `termination for non-payment, no event` : `A unilateral termination` ; `ground` = `premium not paid, or not paid in full, by the agreed time or after the grace period` ; `terminating party` = `the insurer` ; `surrender value` = 3_000_000 ; `the contract has a surrender value` = TRUE
@@fx `termination after a refused request` : `A unilateral termination` ; `ground` = `a request to change the insured risk under Dieu 23 was not accepted` ; `terminating party` = `the policyholder` ; `insured event occurred before termination` = TRUE ; `premium paid for the period after termination` = 700_000 ; `surrender value` = 3_000_000 ; `the contract has a surrender value` = TRUE
@@fx `termination after a refused request, other value agreed` : `A unilateral termination` ; `ground` = `a request to change the insured risk under Dieu 23 was not accepted` ; `terminating party` = `the policyholder` ; `surrender value` = 3_000_000 ; `the contract has a surrender value` = TRUE ; `the parties agreed otherwise on the surrender value` = TRUE
@@fx `termination for unsafe property` : `A unilateral termination` ; `ground` = `the insured person did not take the safety measures of Dieu 55(3)` ; `terminating party` = `the insurer` ; `premium paid for the period after termination` = 400_000
@@fx `termination on a transfer, assets cover the reserve, life` : `A unilateral termination` ; `ground` = `the policyholder did not agree to the transfer of the portfolio under Dieu 92(4)` ; `terminating party` = `the policyholder` ; `surrender value` = 3_000_000 ; `the contract has a surrender value` = TRUE ; `value of the transferred assets` = 100 ; `technical reserve of the transferred portfolio` = 100
@@fx `termination on a transfer, assets short, life` : `A unilateral termination` ; `ground` = `the policyholder did not agree to the transfer of the portfolio under Dieu 92(4)` ; `terminating party` = `the policyholder` ; `surrender value` = 3_000_000 ; `the contract has a surrender value` = TRUE ; `value of the transferred assets` = 80 ; `technical reserve of the transferred portfolio` = 100
@@fx `termination on a transfer, assets short, non-life` : `A unilateral termination` ; `ground` = `the policyholder did not agree to the transfer of the portfolio under Dieu 92(4)` ; `terminating party` = `the policyholder` ; `premium paid for the period after termination` = 1_000_000 ; `value of the transferred assets` = 50 ; `technical reserve of the transferred portfolio` = 100
@@fx `termination on a transfer, no reserve` : `A unilateral termination` ; `ground` = `the policyholder did not agree to the transfer of the portfolio under Dieu 92(4)` ; `terminating party` = `the policyholder` ; `premium paid for the period after termination` = 1_000_000
#ASSERT `Dieu 27(1)(a): the policyholder must still pay premium up to termination` `termination for non-payment, no event` `a property contract`
#ASSERT NOT `Dieu 27(1)(a): the policyholder must still pay premium up to termination` `termination for non-payment, no event` `a life contract`
#ASSERT NOT `Dieu 27(1)(a): the policyholder must still pay premium up to termination` `termination for non-payment, no event` `a health contract`
#ASSERT `Dieu 27(1)(a): the policyholder must still pay premium up to termination` `termination for non-payment, no event` `a group life contract`
#ASSERT NOT `Dieu 27(1)(a): the policyholder must still pay premium up to termination` `termination after a refused request` `a property contract`
#ASSERT `Dieu 27: the insurer must pay for an insured event before termination` `termination for non-payment, event before`
#ASSERT NOT `Dieu 27: the insurer must pay for an insured event before termination` `termination for non-payment, no event`
#ASSERT `Dieu 27: the insurer must pay for an insured event before termination` `termination after a refused request`
#ASSERT REFUSED `Dieu 27: the insurer must pay for an insured event before termination` `termination on a transfer, assets cover the reserve, life`
#ASSERT `Dieu 27(2): the premium the insurer must refund for the remaining period` `termination after a refused request` EQUALS 700_000
#ASSERT `Dieu 27(2): the premium the insurer must refund for the remaining period` `termination for unsafe property` EQUALS 400_000
#ASSERT REFUSED `Dieu 27(2): the premium the insurer must refund for the remaining period` `termination for non-payment, no event`
#ASSERT `Dieu 27(3): the surrender value the insurer must pay` `termination for non-payment, no event` `a life contract` EQUALS 3_000_000
#ASSERT `Dieu 27(3): the surrender value the insurer must pay` `termination after a refused request` `a life contract` EQUALS 3_000_000
#ASSERT REFUSED `Dieu 27(3): the surrender value the insurer must pay` `termination after a refused request, other value agreed` `a life contract`
#ASSERT REFUSED `Dieu 27(3): the surrender value the insurer must pay` `termination for non-payment, no event` `a property contract`
#ASSERT REFUSED `Dieu 27(3): the surrender value the insurer must pay` `termination on a transfer, assets cover the reserve, life` `a life contract`
#ASSERT `Dieu 27(4): the amount the policyholder receives back` `termination on a transfer, assets cover the reserve, life` EQUALS 3_000_000
#ASSERT `Dieu 27(4): the amount the policyholder receives back` `termination on a transfer, assets short, life` EQUALS 2_400_000
#ASSERT `Dieu 27(4): the amount the policyholder receives back` `termination on a transfer, assets short, non-life` EQUALS 500_000
#ASSERT REFUSED `Dieu 27(4): the amount the policyholder receives back` `termination on a transfer, no reserve`
#ASSERT REFUSED `Dieu 27(4): the amount the policyholder receives back` `termination for unsafe property`

§§ `Dieu 28`

@@q 680 689
@ref Dieu 28 (src:680-689)
@@fx `a full life transfer` : `A transfer of a contract` ; `the insured person or the insured person's legal representative agreed in writing` = TRUE ; `the transferee has an insurable interest` = TRUE ; `the policyholder notified the insurer in writing` = TRUE ; `the insurer agreed in writing` = TRUE
@@fx `a life transfer without the insured's consent` : `A transfer of a contract` ; `the transferee has an insurable interest` = TRUE ; `the policyholder notified the insurer in writing` = TRUE ; `the insurer agreed in writing` = TRUE
@@fx `a property transfer without the insurer's agreement` : `A transfer of a contract` ; `the transferee has an insurable interest` = TRUE ; `the policyholder notified the insurer in writing` = TRUE
@@fx `a property transfer under the contract's own terms` : `A transfer of a contract` ; `the transferee has an insurable interest` = TRUE ; `the transfer is made under international custom or by agreement in the contract` = TRUE
@@fx `a property transfer to a stranger` : `A transfer of a contract` ; `the policyholder notified the insurer in writing` = TRUE ; `the insurer agreed in writing` = TRUE
#ASSERT `Dieu 28: the transfer takes effect` `a full life transfer` `a life contract`
#ASSERT NOT `Dieu 28: the transfer takes effect` `a life transfer without the insured's consent` `a life contract`
#ASSERT `Dieu 28: the transfer takes effect` `a life transfer without the insured's consent` `a property contract`
#ASSERT NOT `Dieu 28: the transfer takes effect` `a property transfer without the insurer's agreement` `a property contract`
#ASSERT `Dieu 28: the transfer takes effect` `a property transfer under the contract's own terms` `a property contract`
#ASSERT NOT `Dieu 28: the transfer takes effect` `a property transfer to a stranger` `a property contract`

§§ `Dieu 29`

@@q 691 703
@ref Dieu 29 (src:691-703)
@@fx `an insurer relying on the reinsurer's default` : `A reinsurance in the background of a contract` ; `the reinsurer did not meet its obligation to the insurer` = TRUE ; `the insurer refused or delayed performing for the policyholder` = TRUE
@@fx `an insurer delaying for its own reasons` : `A reinsurance in the background of a contract` ; `the insurer refused or delayed performing for the policyholder` = TRUE
@@fx `a reinsurer collecting premium directly` : `A reinsurance in the background of a contract` ; `the reinsurer asked the policyholder to pay premium directly to it` = TRUE
@@fx `a reinsurer collecting premium directly as agreed` : `A reinsurance in the background of a contract` ; `the reinsurer asked the policyholder to pay premium directly to it` = TRUE ; `the contract agrees otherwise` = TRUE
@@fx `a policyholder claiming on the reinsurer` : `A reinsurance in the background of a contract` ; `the policyholder asked the reinsurer to pay the insurance money to it` = TRUE
@@fx `a policyholder claiming on the reinsurer as agreed` : `A reinsurance in the background of a contract` ; `the policyholder asked the reinsurer to pay the insurance money to it` = TRUE ; `the contract agrees otherwise` = TRUE
#ASSERT `Dieu 29(1): the insurer's refusal or delay breaches Dieu 29(1)` `an insurer relying on the reinsurer's default`
#ASSERT NOT `Dieu 29(1): the insurer's refusal or delay breaches Dieu 29(1)` `an insurer delaying for its own reasons`
#ASSERT `Dieu 29(2): the reinsurer's demand for premium breaches Dieu 29(2)` `a reinsurer collecting premium directly`
#ASSERT NOT `Dieu 29(2): the reinsurer's demand for premium breaches Dieu 29(2)` `a reinsurer collecting premium directly as agreed`
#ASSERT `Dieu 29(3): the policyholder's demand on the reinsurer breaches Dieu 29(3)` `a policyholder claiming on the reinsurer`
#ASSERT NOT `Dieu 29(3): the policyholder's demand on the reinsurer breaches Dieu 29(3)` `a policyholder claiming on the reinsurer as agreed`

