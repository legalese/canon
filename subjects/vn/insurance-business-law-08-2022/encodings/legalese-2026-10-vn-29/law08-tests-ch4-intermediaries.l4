`an organisation agent with the first principal's consent` MEANS `Two engagements of an organisation agent` WITH
    `the first principal agreed in writing to the second engagement` IS TRUE
`an organisation agent without the first principal's consent` MEANS `Two engagements of an organisation agent` WITH
    `the first principal agreed in writing to the second engagement` IS FALSE
#ASSERT `Dieu 127(2): the organisation may be the agent of both principals` `an organisation agent with the first principal's consent`
#ASSERT NOT `Dieu 127(2): the organisation may be the agent of both principals` `an organisation agent without the first principal's consent`
`a practising agent` MEANS `An agent's practice` WITH
    `acts only on products the agent was trained on` IS TRUE
    `the agent's data is registered and kept current in the insurance database` IS TRUE
    `continuous years without acting as an agent` IS 2
`an agent idle for three years` MEANS `An agent's practice` WITH
    `acts only on products the agent was trained on` IS FALSE
    `the agent's data is registered and kept current in the insurance database` IS FALSE
    `continuous years without acting as an agent` IS 3
`an agent selling untrained products` MEANS `An agent's practice` WITH
    `acts only on products the agent was trained on` IS FALSE
    `the agent's data is registered and kept current in the insurance database` IS TRUE
    `continuous years without acting as an agent` IS 0
#ASSERT `Dieu 127(3)-(4): the agent practises as the Law requires` `a practising agent`
#ASSERT NOT `Dieu 127(3)-(4): the agent practises as the Law requires` `an agent selling untrained products`
#ASSERT NOT `Dieu 127(5): the individual must pass the examination for a new certificate before acting` `a practising agent`
#ASSERT `Dieu 127(5): the individual must pass the examination for a new certificate before acting` `an agent idle for three years`

