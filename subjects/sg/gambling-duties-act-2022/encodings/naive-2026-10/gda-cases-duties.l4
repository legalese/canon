IMPORT prelude
IMPORT `gda-duties`

-- Gambling Duties Act 2022, ss 3, 5-11, 13, 14, 18, 19, 27-30 and 37 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_gambling-duties-act-2022.py). Expected results were written by
-- hand from the text.

§ `ss 3 and 5`

#ASSERT `the person conducts betting operations` TRUE FALSE FALSE
#ASSERT NOT `the person conducts betting operations` FALSE FALSE FALSE

#ASSERT `the undertaking is a taxable gambling undertaking` `betting with an authorised betting operator` TRUE FALSE
#ASSERT `the undertaking is a taxable gambling undertaking` `gaming machines in a club` TRUE FALSE
#ASSERT NOT `the undertaking is a taxable gambling undertaking` `casino gaming under a casino licence` TRUE FALSE
#ASSERT NOT `the undertaking is a taxable gambling undertaking` `unlicensed betting` TRUE FALSE
#ASSERT NOT `the undertaking is a taxable gambling undertaking` `betting with an authorised betting operator` FALSE FALSE
#ASSERT NOT `the undertaking is a taxable gambling undertaking` `gaming machines in a club` TRUE TRUE

§ `s 6`

#ASSERT `the gambling duty` 1070000 70000 FALSE 30 EQUALS 300000
#ASSERT `the gambling duty` 1070000 70000 TRUE 30 EQUALS 0

