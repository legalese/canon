IMPORT prelude
IMPORT `ea-part3-salary`
IMPORT `ea-part4-hours`
IMPORT `ea-parts5to8`
IMPORT `ea-part9-maternity`
IMPORT `ea-part10-leave`
IMPORT `ea-part12-records`

-- Employment Act 1968, Parts 5 to 12 -- worked cases.

§ `35 -- the application test, shared with section 33`

-- s 35 and s 33(1) are the same words. The encoding proves it by using one rule
-- for both, so these answers are necessarily identical.
#ASSERT `this Part applies to the employee` (Worker WITH `is a workman` IS TRUE, `is employed in a managerial or an executive position` IS FALSE, `monthly salary excluding overtime, bonus, annual wage supplement, productivity incentive and allowances` IS 4500) `the caps as the Act states them`
#ASSERT NOT `this Part applies to the employee` (Worker WITH `is a workman` IS TRUE, `is employed in a managerial or an executive position` IS FALSE, `monthly salary excluding overtime, bonus, annual wage supplement, productivity incentive and allowances` IS 4501) `the caps as the Act states them`
#ASSERT NOT `this Part applies to the employee` (Worker WITH `is a workman` IS FALSE, `is employed in a managerial or an executive position` IS TRUE, `monthly salary excluding overtime, bonus, annual wage supplement, productivity incentive and allowances` IS 1000) `the caps as the Act states them`

§ `Part 5 -- Truck system`

GIVEN `workman` IS A BOOLEAN, `cooperation` IS A BOOLEAN, `not legal tender` IS A BOOLEAN, `bank` IS A BOOLEAN
GIVETH A TruckFacts
DECIDE `truck facts` `workman` `cooperation` `not legal tender` `bank` IS
    TruckFacts WITH
        `the person is a workman` IS `workman`
        `a body of persons working on an agreement of cooperation` IS `cooperation`
        `the contract makes salary payable otherwise than in legal tender` IS `not legal tender`
        `the contract contains terms as to the place, manner or person with whom the salary is to be spent` IS FALSE
        `paid into an account at a bank in Singapore in the workman's name or jointly` IS `bank`
        `paid by cheque made payable to or to the order of the workman` IS FALSE
        `the employer made a deduction by way of discount, interest or similar charge on an advance of salary` IS FALSE
        `the employer gave noxious drugs or intoxicating liquor by way of remuneration` IS FALSE
        `the workman was compelled by the contract to purchase goods at the employer's shop or canteen` IS FALSE

#ASSERT `Part 5 applies` (`truck facts` TRUE FALSE FALSE FALSE)
-- s 64: a body of persons working on an agreement of cooperation is outside it.
#ASSERT NOT `Part 5 applies` (`truck facts` TRUE TRUE FALSE FALSE)
-- The Part protects a WORKMAN, not every employee.
#ASSERT NOT `Part 5 applies` (`truck facts` FALSE FALSE FALSE FALSE)

-- s 54 voids THE WHOLE CONTRACT OF SERVICE, not just the offending term.
#ASSERT `the contract of service is illegal and void under section 54` (`truck facts` TRUE FALSE TRUE FALSE)
-- s 63(1): bank payment is saved, so the contract stands.
#ASSERT NOT `the contract of service is illegal and void under section 54` (`truck facts` TRUE FALSE TRUE TRUE)

-- s 57, with s 63(2) taking away recovery of what was paid by bank or cheque.
#ASSERT `the amount recoverable under section 57` 2000 200 1500 EQUALS 300

§ `Part 6 -- Contractors`

GIVEN `in trade` IS A BOOLEAN, `is employer` IS A BOOLEAN, `constructional` IS A BOOLEAN
    , `is constructional contractor` IS A BOOLEAN, `due` IS A NUMBER, `one month` IS A NUMBER
GIVETH A ContractingChain
DECIDE `a chain` `in trade` `is employer` `constructional` `is constructional contractor` `due` `one month` IS
    ContractingChain WITH
        `the principal contracted in the course of or for the purposes of the principal's trade or business` IS `in trade`
        `salary is due to the workman by the contractor or a subcontractor` IS TRUE
        `the person from whom salary is claimed is the employer` IS `is employer`
        `the contract is for constructional work` IS `constructional`
        `the principal is also a constructional contractor` IS `is constructional contractor`
        `the salary due` IS `due`
        `the salary earned in one month for work done by the employer` IS `one month`

#ASSERT `section 65(1) makes the person jointly and severally liable` (`a chain` TRUE FALSE FALSE FALSE 5000 2000)
-- s 65(1A): never more than one month's salary, however much is owed.
#ASSERT `the amount recoverable from the principal or contractor` (`a chain` TRUE FALSE FALSE FALSE 5000 2000) EQUALS 2000
#ASSERT `the amount recoverable from the principal or contractor` (`a chain` TRUE FALSE FALSE FALSE 1500 2000) EQUALS 1500
-- s 65(1B): on constructional work the principal escapes unless also a
-- constructional contractor.
#ASSERT NOT `section 65(1) makes the person jointly and severally liable` (`a chain` TRUE FALSE TRUE FALSE 5000 2000)
#ASSERT `section 65(1) makes the person jointly and severally liable` (`a chain` TRUE FALSE TRUE TRUE 5000 2000)
-- The ceiling binds everyone EXCEPT the employer, who stays liable in full
-- under the ordinary Parts; s 65(1A) says "not being the employer".
#ASSERT `the amount recoverable from the principal or contractor` (`a chain` TRUE TRUE FALSE FALSE 5000 2000) EQUALS 0

§ `Part 6A -- Part-time employees`

#ASSERT `the employee is a part-time employee` 34 FALSE
#ASSERT NOT `the employee is a part-time employee` 35 FALSE
-- s 66A(2): the Minister's declaration takes an employee out however few hours.
#ASSERT NOT `the employee is a part-time employee` 10 TRUE

§ `Part 7 -- Domestic workers`

-- The Act does not apply to a domestic worker unless the Minister has said so.
#ASSERT NOT `this Act applies to the domestic worker` TRUE FALSE
#ASSERT `this Act applies to the domestic worker` TRUE TRUE

§ `Part 8 -- Children and young persons`

GIVEN `age` IS A NUMBER, `industrial` IS A BOOLEAN, `non industrial` IS A BOOLEAN
    , `family only` IS A BOOLEAN, `light work` IS A BOOLEAN, `declared` IS A BOOLEAN
GIVETH A YoungWorker
DECIDE `a worker aged` `age` `industrial` `non industrial` `family only` `light work` `declared` IS
    YoungWorker WITH
        `age in completed years` IS `age`
        `employed in an industrial undertaking` IS `industrial`
        `employed in a non-industrial undertaking` IS `non industrial`
        `the industrial undertaking employs only members of the same family` IS `family only`
        `the work is light work suited to the child's capacity` IS `light work`
        `a medical officer has certified the work suited to the child's capacity` IS FALSE
        `the Minister has declared this an industrial undertaking in which a young person must not be employed` IS `declared`

-- s 67A: a child is under 15; a young person is 15 but under 16.
#ASSERT `the person is a child` (`a worker aged` 14 FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the person is a child` (`a worker aged` 15 FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the person is a young person` (`a worker aged` 15 FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the person is a young person` (`a worker aged` 16 FALSE FALSE FALSE FALSE FALSE)

-- s 68(1): a child in an industrial undertaking, no exception: contravention.
#ASSERT `employing this child contravenes section 68(1)` (`a worker aged` 12 TRUE FALSE FALSE FALSE FALSE)
-- s 68(2): the family undertaking saves it.
#ASSERT NOT `employing this child contravenes section 68(1)` (`a worker aged` 12 TRUE FALSE TRUE FALSE FALSE)
-- s 68(3): light work in a non-industrial undertaking, for a child of 13+.
#ASSERT NOT `employing this child contravenes section 68(1)` (`a worker aged` 13 FALSE TRUE FALSE TRUE FALSE)
-- Same work, a 12-year-old: s 68(3) does not reach them.
#ASSERT `employing this child contravenes section 68(1)` (`a worker aged` 12 FALSE TRUE FALSE TRUE FALSE)
-- Non-industrial, 13+, but the work is not light: outside the exception.
#ASSERT `employing this child contravenes section 68(1)` (`a worker aged` 14 FALSE TRUE FALSE FALSE FALSE)

-- s 69: a young person is barred only from an undertaking the Minister has
-- DECLARED. Industrial work as such is not forbidden to them.
#ASSERT `employing this young person contravenes section 69` (`a worker aged` 15 TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT `employing this young person contravenes section 69` (`a worker aged` 15 TRUE FALSE FALSE FALSE FALSE)

§ `Part 9 -- Maternity`

GIVEN `arrangement` IS AN AbsenceArrangement, `current` IS A BOOLEAN, `months` IS A NUMBER
    , `daily` IS A NUMBER, `worked days` IS A NUMBER, `other employer` IS A BOOLEAN
GIVETH A MaternityFacts
DECIDE `maternity facts` `arrangement` `current` `months` `daily` `worked days` `other employer` IS
    MaternityFacts WITH
        `the arrangement` IS `arrangement`
        `delivered on or after 22 August 2015, or with an estimated delivery date on or after that day` IS `current`
        `months served preceding the day of confinement` IS `months`
        `the gross rate of pay for one day` IS `daily`
        `days worked during the benefit period before confinement` IS `worked days`
        `has worked for another employer after absenting herself under this Part` IS `other employer`

-- The absence is 12 weeks under (a) and (b), but the BENEFIT PERIOD is 8 weeks
-- on every arrangement. So four of the twelve weeks are unpaid.
#ASSERT `the weeks of absence under section 76(1)` `the default -- 4 weeks before and 8 weeks after` EQUALS 12
#ASSERT `the weeks of the benefit period under section 76(1A)` `the default -- 4 weeks before and 8 weeks after` EQUALS 8
#ASSERT `the weeks of absence that are unpaid` `the default -- 4 weeks before and 8 weeks after` EQUALS 4
#ASSERT `the weeks of absence that are unpaid` `a single agreed period of 12 weeks` EQUALS 4
#ASSERT `the weeks of absence that are unpaid` `8 agreed weeks plus further agreed periods within 12 months` EQUALS 0

-- s 76(2B): three months' service preceding the confinement.
#ASSERT `she is entitled to payment during the benefit period` (`maternity facts` `the default -- 4 weeks before and 8 weeks after` TRUE 3 100 0 FALSE)
#ASSERT NOT `she is entitled to payment during the benefit period` (`maternity facts` `the default -- 4 weeks before and 8 weeks after` TRUE 2 100 0 FALSE)
-- 8 weeks at 7 days at $100.
#ASSERT `the payment for the benefit period` (`maternity facts` `the default -- 4 weeks before and 8 weeks after` TRUE 3 100 0 FALSE) EQUALS 5600
#ASSERT `the payment for the benefit period` (`maternity facts` `the default -- 4 weeks before and 8 weeks after` TRUE 2 100 0 FALSE) EQUALS 0

-- s 83: working for another employer forfeits the claim entirely.
#ASSERT NOT `she is entitled to payment during the benefit period` (`maternity facts` `the default -- 4 weeks before and 8 weeks after` TRUE 12 100 0 TRUE)

-- s 76(3): a day worked inside the benefit period is paid twice over.
#ASSERT `the additional payment for days worked in the benefit period` (`maternity facts` `the default -- 4 weeks before and 8 weeks after` TRUE 12 100 3 FALSE) EQUALS 300

-- s 81: both limbs. Notice given during the absence, or timed to expire in it.
#ASSERT `the notice of dismissal is unlawful under section 81` TRUE TRUE FALSE
#ASSERT `the notice of dismissal is unlawful under section 81` TRUE FALSE TRUE
#ASSERT NOT `the notice of dismissal is unlawful under section 81` TRUE FALSE FALSE

-- s 82: knowledge of the employment is the only mental element.
#ASSERT `the employer is guilty of an offence under section 82` TRUE TRUE
#ASSERT NOT `the employer is guilty of an offence under section 82` TRUE FALSE

§ `Part 10 -- Holiday, annual leave and sick leave`

§§ `88A -- the annual leave ladder`

GIVEN `months total` IS A NUMBER, `years` IS A NUMBER, `months in year` IS A NUMBER, `absent` IS A BOOLEAN
GIVETH A LeaveService
DECIDE `leave service` `months total` `years` `months in year` `absent` IS
    LeaveService WITH
        `completed months of service with the employer` IS `months total`
        `completed 12 month periods of continuous service` IS `years`
        `completed months of service in that year` IS `months in year`
        `absent without permission or reasonable excuse for more than 20% of the working days` IS `absent`

-- 7 days in the first year, one more each year, capped at 14 in the eighth.
#ASSERT `the full year annual leave entitlement` (`leave service` 12 1 12 FALSE) EQUALS 7
#ASSERT `the full year annual leave entitlement` (`leave service` 24 2 12 FALSE) EQUALS 8
#ASSERT `the full year annual leave entitlement` (`leave service` 96 8 12 FALSE) EQUALS 14
-- And it stops: the twentieth year is still 14.
#ASSERT `the full year annual leave entitlement` (`leave service` 240 20 12 FALSE) EQUALS 14

#ASSERT `the annual leave days the employee is entitled to` (`leave service` 12 1 12 FALSE) EQUALS 7

-- Under 3 months: nothing at all.
#ASSERT NOT `the employee qualifies for annual leave at all` (`leave service` 2 0 2 FALSE)
#ASSERT `the annual leave days the employee is entitled to` (`leave service` 2 0 2 FALSE) EQUALS 0

-- s 88A(5): the 20% forfeiture takes away the whole entitlement.
#ASSERT `the annual leave days the employee is entitled to` (`leave service` 24 2 12 TRUE) EQUALS 0

-- s 88A(2)-(3): proportionate, rounding half up. 6 of 12 months on a 7-day
-- entitlement is 3.5, which rounds to 4.
#ASSERT `the proportion rounded half up` 42 12 EQUALS 4
#ASSERT `the proportion rounded half up` 35 12 EQUALS 3
#ASSERT `the proportion rounded half up` 84 12 EQUALS 7
#ASSERT `the whole part` 42 12 EQUALS 3
#ASSERT `the annual leave days the employee is entitled to` (`leave service` 6 1 6 FALSE) EQUALS 4
-- 5 of 12 months on 7 days is 2.9166..., which rounds down to 3.
#ASSERT `the annual leave days the employee is entitled to` (`leave service` 5 1 5 FALSE) EQUALS 3

§§ `89 -- the sick leave bands`

GIVEN `months` IS A NUMBER, `examined` IS A BOOLEAN, `hospital` IS A BOOLEAN, `hosp days` IS A NUMBER
GIVETH A SickLeaveFacts
DECIDE `sick facts` `months` `examined` `hospital` `hosp days` IS
    SickLeaveFacts WITH
        `completed months of service with the employer` IS `months`
        `examined by a medical practitioner` IS `examined`
        `hospitalisation is necessary` IS `hospital`
        `days on which the employee is hospitalised` IS `hosp days`

-- The four non-hospitalisation bands.
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 6 TRUE FALSE 0) EQUALS 14
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 5 TRUE FALSE 0) EQUALS 11
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 4 TRUE FALSE 0) EQUALS 8
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 3 TRUE FALSE 0) EQUALS 5
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 2 TRUE FALSE 0) EQUALS 0

-- Hospitalisation: the LESSER of the annual cap and 14 plus the days in
-- hospital. With 10 days in hospital the aggregate limb (24) is lower than 60.
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 6 TRUE TRUE 10) EQUALS 24
-- With 100 days in hospital the annual cap of 60 governs.
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 6 TRUE TRUE 100) EQUALS 60
-- The same shape in the 3-month band: cap 15, so 5 + 20 is held at 15.
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 3 TRUE TRUE 20) EQUALS 15
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 3 TRUE TRUE 4) EQUALS 9

-- Everything is conditional on examination by a medical practitioner.
#ASSERT `the paid sick leave ceiling in days` (`sick facts` 36 FALSE FALSE 0) EQUALS 0

§ `Part 12 -- Records and pay slips`

GIVEN `made` IS A BOOLEAN, `particulars` IS A BOOLEAN, `kept` IS A BOOLEAN, `inaccurate` IS A BOOLEAN, `knew` IS A BOOLEAN
GIVETH AN EmployeeRecord
DECIDE `a record` `made` `particulars` `kept` `inaccurate` `knew` IS
    EmployeeRecord WITH
        `the person is an employee or a former employee of the employer` IS TRUE
        `a record was made` IS `made`
        `the record contains the prescribed particulars` IS `particulars`
        `the record has been kept throughout the prescribed record retention period` IS `kept`
        `the record is readily accessible to the employee or former employee` IS TRUE
        `the record is incomplete or inaccurate` IS `inaccurate`
        `the employer knew it was incomplete or inaccurate` IS `knew`

#ASSERT `the employer has complied with section 95(1)` (`a record` TRUE TRUE TRUE FALSE FALSE)
-- s 95(3): an inaccurate record is a failure whether or not the employer knew.
-- The pair on `knew` is the point: the answer does not move.
#ASSERT NOT `the employer has complied with section 95(1)` (`a record` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT `the employer has complied with section 95(1)` (`a record` TRUE TRUE TRUE TRUE FALSE)

GIVEN `after 2016` IS A BOOLEAN, `min period` IS A BOOLEAN, `given` IS A BOOLEAN, `days` IS A NUMBER
GIVETH A KeyTermsFacts
DECIDE `key terms` `after 2016` `min period` `given` `days` IS
    KeyTermsFacts WITH
        `the contract of service was entered into on or after 1 April 2016` IS `after 2016`
        `employed for a period not shorter than the prescribed minimum period of service` IS `min period`
        `a written record of the key employment terms was given` IS `given`
        `days after the start of employment when it was given` IS `days`
        `another period has been prescribed in substitution` IS FALSE
        `the substituted period in days` IS 0

#ASSERT NOT `the employer has contravened section 95A` (`key terms` TRUE TRUE TRUE 14)
#ASSERT `the employer has contravened section 95A` (`key terms` TRUE TRUE TRUE 15)
#ASSERT `the employer has contravened section 95A` (`key terms` TRUE TRUE FALSE 0)
-- A contract entered into before 1 April 2016 is outside s 95A entirely.
#ASSERT NOT `the employer has contravened section 95A` (`key terms` FALSE TRUE FALSE 0)
