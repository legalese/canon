IMPORT `wa-interpretation-act-1984`

-- Cat Act 2011 (WA), compilation 00-l0-01 (currency start 25 Sep 2025), and the Cat Regulations
-- 2012 (WA), compilation 02-b0-00 (currency start 24 Jul 2025): Parts 1 and 2 and the
-- regulations they depend on. LQA run cat-act-2011-lqa, step 4A, 2026-10-01.
--
-- THE FACTS THE ENCODING READS. Declarations only: no rule of the Act or the regulations is
-- encoded here. Every field is either a fact about the world or a fact the reference register
-- disposes of as "fact" (its REF number is given). The rules live in part-1-preliminary.l4,
-- part-2-div-*.l4 and cat-regulations-2012.l4.
--
-- Persons are identified by name. A name is a STRING, and two persons with the same name are
-- the same person for this encoding.

§ `Persons`

DECLARE `Enactment` IS ONE OF
    `the Cat Act 2011`
    `the Dog Act 1976`
    `the Animal Welfare Act 2002`
    `another written law`

-- REF-25: only the number and dates of convictions matter.
DECLARE `Conviction` HAS
    `an offence against`  IS AN `Enactment`
    `convicted on`        IS A `Calendar date`

DECLARE `Person` HAS
    `name`                              IS A STRING
    `date of birth`                     IS A `Calendar date`
    -- s 4(1)(c): who the child's parent or guardian is, a fact.
    `parents or guardians`              IS A LIST OF STRING
    -- s 5(2)(b). NOTHING: the person is not resident in the State.
    `became resident in the State on`   IS A MAYBE `Calendar date`
    `convictions`                       IS A LIST OF `Conviction`
    -- REF-14: registration under the Veterinary Practice Act 2021 is a status fact.
    `is a veterinarian`                 IS A BOOLEAN
    -- REF-11.
    `is a veterinary nurse`             IS A BOOLEAN
    -- REF-12: the codes of units and courses completed with a registered training provider.
    `units of competency completed`     IS A LIST OF STRING
    `courses completed`                 IS A LIST OF STRING
    -- REF-01: whether the person holds a current approval to breed cats under s 37.
    `is an approved cat breeder`        IS A BOOLEAN
    -- REF-24.
    `is an eligible pensioner`          IS A BOOLEAN

-- s 4(1)(b): "a person who, or an owner of a business or organisation that, ordinarily keeps
-- and cares for the cat". `since` is the first day of the keeping (s 5(2)(a)).
DECLARE `Keeper` IS ONE OF
    `an individual` HAS `the individual` IS A `Person`
                        `keeping since`  IS A `Calendar date`
    `a business or organisation` HAS `the business name` IS A STRING
                                     `its owners`        IS A LIST OF `Person`
                                     `keeping since`     IS A `Calendar date`

§ `Bodies and places`

-- REF-06: whether a facility is operated or approved by a local government is a fact.
DECLARE `Facility` HAS
    `operator`                                    IS A STRING
    `is operated by a local government`           IS A BOOLEAN
    `is, or may be, used for keeping cats`        IS A BOOLEAN
    `is a facility for keeping cats`              IS A BOOLEAN
    `operator is approved in writing by a local government` IS A BOOLEAN

-- Who has custody of, or is receiving, a cat: the bodies Cat Regulations r 9 names, and others.
DECLARE `Body` IS ONE OF
    `Cat Haven`
    `RSPCA WA`
    -- REF-19: "the Department of State of the Commonwealth that is administered by the
    -- Commonwealth Minister administering the Biosecurity Act 2015 (Commonwealth)".
    `the Commonwealth biosecurity Department`
    `a facility` HAS `the facility` IS A `Facility`
    -- REF-20: whether premises are registered veterinary premises is a fact.
    `veterinary premises` HAS `premises are registered under the Veterinary Practice Act 2021 Part 3` IS A BOOLEAN
    `a SAFE entity` HAS `the SAFE entity` IS A `SAFE entity`
    `a foster carer`
    `anyone else` HAS `who` IS A STRING

-- Cat Regulations r 9(1): "SAFE entity means any of the following —"
DECLARE `SAFE entity` IS ONE OF
    `Saving Animals from Euthanasia Incorporated`
    `S.A.F.E. Hedland Inc`
    `Saving Animals from Euthanasia Busselton Inc`

DECLARE `Foster care` HAS
    `placed by`                          IS A `Body`
    -- r 9(3)(b): "a total of 12 weeks", counted here in days.
    `total days the cat has been in foster care` IS A NUMBER

-- Cat Regulations r 10(1): the bodies whose shows count, and affiliates. Affiliation is a fact.
DECLARE `Show holder` IS ONE OF
    `Cat Owners' Association of Western Australia Incorporated`
    `the Feline Control Council of Western Australia (Inc)`
    `Australian National Cats Incorporated`
    `Cats United WA Incorporated`
    `a body affiliated with one of those`
    `another body`

-- REF-09: a company's name, whether it keeps a microchip database, and whether it keeps or
-- has agreed to keep records about a particular cat, are facts.
DECLARE `Database company` HAS
    `company name`                                         IS A STRING
    `keeps a microchip database`                           IS A BOOLEAN
    `keeps, or has agreed to keep, records about the cat and its owner` IS A BOOLEAN

§ `The cat`

DECLARE `Period of registration` IS ONE OF
    `one year`
    `3 years`
    `the life of the cat`

DECLARE `Registration` HAS
    `with local government`   IS A STRING
    `in the name of`          IS A STRING
    `registration number`     IS A STRING
    `registered for`          IS A `Period of registration`
    -- r 12(2)(a): "has effect from the period specified in the registration certificate".
    `has effect from`         IS A `Calendar date`
    `cancelled on`            IS A MAYBE `Calendar date`
    -- REF-46: whether the information was recorded in a local government register, or in
    -- the centralised registration system under s 88, is a fact.
    `recorded in the register` IS A BOOLEAN

DECLARE `Implant` HAS
    -- REF-08: compliance with the Australian Standards is a technical fact.
    `device complies with AS 5018-2001 and AS 5019-2001`             IS A BOOLEAN
    `device is capable of being implanted in a cat`                    IS A BOOLEAN
    `device is designed to record information that can be electronically retrieved` IS A BOOLEAN
    `implanted by`                                                     IS A `Person`
    `implanted on`                                                     IS A `Calendar date`

DECLARE `Sterilisation` HAS
    `made permanently infertile`  IS A BOOLEAN
    `by a surgical procedure`     IS A BOOLEAN
    `performed by`                IS A `Person`
    `performed on`                IS A `Calendar date`

-- ss 14(2), 18(2)(a): "a certificate given by a veterinarian stating that ... may adversely
-- affect the health and welfare of the cat".
DECLARE `Health certificate` HAS
    `given by`                                               IS A `Person`
    `given on`                                               IS A `Calendar date`
    `states that the procedure may adversely affect the health and welfare of the cat` IS A BOOLEAN

DECLARE `Cat` HAS
    `cat name`                                               IS A STRING
    `is an animal of the species felis catus or a hybrid of that species` IS A BOOLEAN
    `born on`                                                IS A `Calendar date`
    `keepers`                                                IS A LIST OF `Keeper`
    -- REF-17: which district the cat is ordinarily kept in is a geographic fact.
    `ordinarily kept in the district of`                     IS A STRING
    `is kept in the State`                                   IS A BOOLEAN
    `has died`                                               IS A BOOLEAN
    `registrations`                                          IS A LIST OF `Registration`
    `implant`                                                IS A MAYBE `Implant`
    `microchip database company`                             IS A MAYBE `Database company`
    -- s 4(2).
    `name recorded as owner in a microchip database`         IS A MAYBE STRING
    `there is evidence to the contrary of that record`       IS A BOOLEAN
    `sterilisation`                                          IS A MAYBE `Sterilisation`
    `has a sterilisation tattoo on its ear`                  IS A BOOLEAN
    `microchipping health certificate`                       IS A MAYBE `Health certificate`
    `sterilisation health certificate`                       IS A MAYBE `Health certificate`
    -- s 18(2)(b).
    `is owned for the purpose of breeding`                   IS A BOOLEAN
    `in the custody of`                                      IS A `Body`
    `foster care`                                            IS A MAYBE `Foster care`

§ `Occasions`

-- s 6: an occasion on which the cat is, or may be, in a public place.
DECLARE `Outing` HAS
    `outing date`                                IS A `Calendar date`
    -- s 3(1) "public place means any place to which the public has lawful access": a fact.
    `the cat is in a place to which the public has lawful access` IS A BOOLEAN
    `the cat is wearing its registration tag`    IS A BOOLEAN
    -- r 10.
    `the cat is being exhibited for show purposes at a cat show held by` IS A MAYBE `Show holder`
    -- s 6(3), facts the accused must establish.
    `the contravention was due to the act or default of another person, an accident, or some other cause beyond the accused's control` IS A BOOLEAN
    `the accused took reasonable precautions and could not by the exercise of due diligence have prevented the commission of the offence` IS A BOOLEAN

-- s 3(1) transfer: "(a) sell, trade, give away, take consideration for, transfer ownership of
-- and offer for sale; and (b) to reclaim from a cat management facility".
DECLARE `Kind of transfer` IS ONE OF
    `sell`
    `trade`
    `give away`
    `take consideration for`
    `transfer ownership of`
    `offer for sale`
    `reclaim from a cat management facility`

DECLARE `Transfer` HAS
    `the cat transferred`                          IS A `Cat`
    `kind`                                         IS A `Kind of transfer`
    `made on`                                      IS A `Calendar date`
    -- For (a): the person who sells, gives away &c. For (b): the facility's operator.
    `the person parting with the cat`              IS A STRING
    -- For (a): the person to whom; for (b): the person who reclaims. NOTHING for an offer
    -- for sale that nobody has taken up.
    `the person receiving the cat`                 IS A MAYBE STRING
    `the recipient is`                             IS A `Body`
    -- s 23: the transferor's state of satisfaction "at the time of the transfer", a fact.
    `transferor is satisfied that a s 14(2) certificate applies`      IS A BOOLEAN
    `transferor is satisfied that a s 18(2)(a) certificate applies`   IS A BOOLEAN
    `transferor is satisfied that the purchaser is an approved cat breeder purchasing the cat for the purpose of breeding` IS A BOOLEAN
    `transferor is satisfied that the cat belongs to a class of cats prescribed as exempt from sterilisation` IS A BOOLEAN
    `a voucher is given to the purchaser to have the cat sterilised later by a veterinarian at no cost to the purchaser` IS A BOOLEAN

-- Cat Regulations rr 16 and 17: the items of information. Items both lists name are one item.
DECLARE `Information item` IS ONE OF
    `the cat owner's full name`
    `the cat owner's residential address`
    `the cat owner's postal address`
    `the cat owner's date of birth`
    `the cat owner's contact telephone numbers`
    `the cat owner's email address`
    `details of an alternative contact`
    `the address at which the cat is normally kept`
    `the cat's name`
    `the cat's registration number`
    `the cat's sterilisation status`
    `the cat's microchip number`
    `the microchip barcode information or sticker`
    `the cat's breed`
    `the cat's colour`
    `the cat's gender`
    `the cat's age`
    `the microchip implanter's full name`
    `the name of the microchip implanter's company or organisation`
    `contact details for the microchip implanter's company or organisation`
    `the date the cat was microchipped`

DECLARE `Notice` HAS
    `given on`      IS A `Calendar date`
    `in writing`    IS A BOOLEAN
    `given to`      IS A STRING
    `items`         IS A LIST OF `Information item`

§ `Applications`

DECLARE `Kind of application` IS ONE OF
    `for the grant of registration`
    `for the renewal of registration`

DECLARE `Part of Form 1` IS ONE OF
    `Part A`
    `Part B`
    `Part C`
    `Part D`
    `Part E`
    `Part F`
    `Part G`
    `Part H`

-- s 9(5): a requirement to give a document or information within a specified time.
DECLARE `Requirement for information` HAS
    `required on`                    IS A `Calendar date`
    `time specified, in days`        IS A NUMBER
    `complied with on`               IS A MAYBE `Calendar date`

DECLARE `Application` HAS
    `applicant`                      IS A `Person`
    `for the cat`                    IS A `Cat`
    `kind of application`            IS A `Kind of application`
    `application made on`            IS A `Calendar date`
    `made to the local government of` IS A STRING
    `period applied for`             IS A `Period of registration`
    `details supplied from Form 1`   IS A LIST OF `Part of Form 1`
    `fee paid`                       IS A NUMBER
    -- Sch 3 cl 1(4): a local government may reduce or waive a fee. NOTHING: it has not.
    `fee as reduced or waived by the local government` IS A MAYBE NUMBER
    `requirement for information`    IS A MAYBE `Requirement for information`
    `determined on`                  IS A `Calendar date`

§ `Helpers (no law)`

GIVEN s IS A STRING, xs IS A LIST OF STRING
GIVETH A BOOLEAN
DECIDE s `is among` xs IF
    CONSIDER xs
    WHEN EMPTY THEN FALSE
    WHEN x FOLLOWED BY rest THEN s EQUALS x OR s `is among` rest

GIVEN i IS AN `Information item`, xs IS A LIST OF `Information item`
GIVETH A BOOLEAN
DECIDE i `is an item among` xs IF
    CONSIDER xs
    WHEN EMPTY THEN FALSE
    WHEN x FOLLOWED BY rest THEN i EQUALS x OR i `is an item among` rest

GIVEN p IS A `Part of Form 1`, xs IS A LIST OF `Part of Form 1`
GIVETH A BOOLEAN
DECIDE p `is a part among` xs IF
    CONSIDER xs
    WHEN EMPTY THEN FALSE
    WHEN x FOLLOWED BY rest THEN p EQUALS x OR p `is a part among` rest

GIVEN xs IS A LIST OF STRING
      ys IS A LIST OF STRING
GIVETH A LIST OF STRING
`the names` xs `followed by` ys MEANS
    CONSIDER xs
    WHEN EMPTY THEN ys
    WHEN x FOLLOWED BY rest THEN x FOLLOWED BY (`the names` rest `followed by` ys)

GIVEN xs IS A LIST OF STRING
      ys IS A LIST OF STRING
GIVETH A BOOLEAN
DECIDE xs `share a name with` ys IF
    CONSIDER xs
    WHEN EMPTY THEN FALSE
    WHEN x FOLLOWED BY rest THEN x `is among` ys OR rest `share a name with` ys
