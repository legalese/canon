IMPORT prelude
IMPORT `wica-liability`

-- Work Injury Compensation Act 2019, ss 8 to 16, s 24 and s 34B
-- -- worked cases.

§ `8(1) -- the company bus and the public bus`

GIVEN `travelling` IS A BOOLEAN, `permission` IS A BOOLEAN
    , `employer transport` IS A BOOLEAN, `public service` IS A BOOLEAN
GIVETH A TravelFacts
DECIDE `travel` `travelling` `permission` `employer transport` `public service` IS
    TravelFacts WITH
        `travelling as a passenger to or from the workplace` IS `travelling`
        `with the express or implied permission of the employer` IS `permission`
        `the transport is operated by or on behalf of the employer, or under arrangements made with the employer` IS `employer transport`
        `the transport is operated in the ordinary course of a public transport service` IS `public service`

-- The company bus is covered.
#ASSERT `section 8(1) deems the accident to arise out of and in the course of employment` (`travel` TRUE TRUE TRUE FALSE)
-- THE PUBLIC BUS IS NOT, even where the employer arranged and paid for the
-- journey. Limb (b)(ii) excludes anything "operated in the ordinary course of a
-- public transport service".
#ASSERT NOT `section 8(1) deems the accident to arise out of and in the course of employment` (`travel` TRUE TRUE TRUE TRUE)
-- Without the employer's permission, express or implied, it fails.
#ASSERT NOT `section 8(1) deems the accident to arise out of and in the course of employment` (`travel` TRUE FALSE TRUE FALSE)
-- And the employee driving themselves is not "travelling as a passenger".
#ASSERT NOT `section 8(1) deems the accident to arise out of and in the course of employment` (`travel` FALSE TRUE TRUE FALSE)

§ `8(2) -- the emergency that turns out not to be one`

GIVEN `at workplace` IS A BOOLEAN, `emergency` IS A BOOLEAN, `rescue` IS A BOOLEAN, `property` IS A BOOLEAN
GIVETH AN EmergencyFacts
DECIDE `an emergency` `at workplace` `emergency` `rescue` `property` IS
    EmergencyFacts WITH
        `the accident happened in or about the workplace` IS `at workplace`
        `there was an actual or supposed emergency at the workplace` IS `emergency`
        `the employee was acting to rescue or protect a person injured or imperilled, or thought to be` IS `rescue`
        `the employee was acting to avert or minimise damage to or loss of property` IS `property`

#ASSERT `section 8(2) deems the accident to arise out of and in the course of employment` (`an emergency` TRUE TRUE TRUE FALSE)
-- Protecting property counts as well as protecting people.
#ASSERT `section 8(2) deems the accident to arise out of and in the course of employment` (`an emergency` TRUE TRUE FALSE TRUE)
-- "ACTUAL OR SUPPOSED": the false alarm is covered, which is the whole point of
-- those three words. This fixture is a supposed emergency and it passes.
#ASSERT NOT `section 8(2) deems the accident to arise out of and in the course of employment` (`an emergency` TRUE FALSE TRUE FALSE)
#ASSERT NOT `section 8(2) deems the accident to arise out of and in the course of employment` (`an emergency` FALSE TRUE TRUE FALSE)

§ `8(3) -- disobedience does not defeat the claim`

GIVEN `contravening` IS A BOOLEAN, `no instructions` IS A BOOLEAN
    , `would have counted` IS A BOOLEAN, `for the business` IS A BOOLEAN
GIVETH A DisobedienceFacts
DECIDE `disobedience` `contravening` `no instructions` `would have counted` `for the business` IS
    DisobedienceFacts WITH
        `the employee was acting in contravention of law, regulations or the employer's orders` IS `contravening`
        `the employee was acting without instructions from the employer` IS `no instructions`
        `it would have arisen out of and in the course of the employment had the employee not been so acting` IS `would have counted`
        `the act was done for the purposes of and in connection with the employer's trade or business` IS `for the business`

-- Breaking the employer's own orders, but doing the employer's work: covered.
#ASSERT `section 8(3) deems the accident to arise out of and in the course of employment` (`disobedience` TRUE FALSE TRUE TRUE)
#ASSERT `section 8(3) deems the accident to arise out of and in the course of employment` (`disobedience` FALSE TRUE TRUE TRUE)
-- NOT doing the employer's business: not covered. That limb, not the
-- disobedience, is what decides it.
#ASSERT NOT `section 8(3) deems the accident to arise out of and in the course of employment` (`disobedience` TRUE FALSE TRUE FALSE)

§ `9 -- accidents outside Singapore`

#ASSERT `the Act extends to the accident outside Singapore` TRUE TRUE TRUE
-- All three elements are needed. An employee who goes abroad by choice rather
-- than requirement is outside s 9.
#ASSERT NOT `the Act extends to the accident outside Singapore` TRUE TRUE FALSE
#ASSERT NOT `the Act extends to the accident outside Singapore` FALSE TRUE TRUE
#ASSERT NOT `the Act extends to the accident outside Singapore` TRUE FALSE TRUE

§ `10 -- diseases`

GIVEN `scheduled` IS A BOOLEAN, `employed then` IS A BOOLEAN, `ceased` IS A BOOLEAN
    , `within period` IS A BOOLEAN, `after 2012` IS A BOOLEAN, `chemical` IS A BOOLEAN, `arising` IS A BOOLEAN
GIVETH A DiseaseFacts
DECIDE `a disease` `scheduled` `employed then` `ceased` `within period` `after 2012` `chemical` `arising` IS
    DiseaseFacts WITH
        `incapacity or death resulted from the disease` IS TRUE
        `the disease is specified in the Second Schedule for the employee's occupation` IS `scheduled`
        `the employee was employed in that occupation when the disease was contracted` IS `employed then`
        `the employee had ceased that employment when the disease was contracted` IS `ceased`
        `it was contracted within the limitation period specified for that disease` IS `within period`
        `contracted on or after 1 June 2012` IS `after 2012`
        `directly attributable to an exposure to a chemical or biological agent` IS `chemical`
        `that exposure arose out of and in the course of the employment` IS `arising`

-- (a) scheduled disease, contracted in the job.
#ASSERT `the disease is compensable as if it were a work injury` (`a disease` TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
-- (b) scheduled disease, contracted after leaving, within the limitation period.
#ASSERT `the disease is compensable as if it were a work injury` (`a disease` TRUE FALSE TRUE TRUE FALSE FALSE FALSE)
-- Same, outside the limitation period: not compensable.
#ASSERT NOT `the disease is compensable as if it were a work injury` (`a disease` TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
-- (c) unscheduled disease from a chemical or biological agent.
#ASSERT `the disease is compensable as if it were a work injury` (`a disease` FALSE FALSE FALSE FALSE TRUE TRUE TRUE)

-- LIMB (c) IS NARROWER THAN IT LOOKS. An unscheduled disease caused by
-- something that is not a chemical or biological agent -- noise, vibration,
-- radiation, repetitive strain -- falls outside it however clearly it was caused
-- by the work.
#ASSERT NOT `the disease is compensable as if it were a work injury` (`a disease` FALSE FALSE FALSE FALSE TRUE FALSE TRUE)
-- And contracted before 1 June 2012, limb (c) does not reach it at all.
#ASSERT NOT `the disease is compensable as if it were a work injury` (`a disease` FALSE FALSE FALSE FALSE FALSE TRUE TRUE)

§ `13 -- the principal pays only if the Commissioner says so`

GIVEN `in business` IS A BOOLEAN, `for work or labour` IS A BOOLEAN
    , `employed in the work` IS A BOOLEAN, `directed` IS A BOOLEAN
GIVETH A PrincipalFacts
DECIDE `a principal` `in business` `for work or labour` `employed in the work` `directed` IS
    PrincipalFacts WITH
        `the principal contracted in the course of or for the purpose of its trade or business` IS `in business`
        `the contract was for the execution of work or the supply of labour` IS `for work or labour`
        `the employee is an employee of the contractor employed in the execution of the work` IS `employed in the work`
        `the Commissioner has directed the principal under section 13(1)` IS `directed`

#ASSERT `the Commissioner may direct the principal` (`a principal` TRUE TRUE TRUE FALSE)

-- THE DIRECTION IS WHAT CREATES THE LIABILITY. Every condition may be met and
-- the principal owes nothing until the Commissioner acts. Contrast s 65 of the
-- Motor Vehicles (Third-Party Risks and Compensation) Act 1960, where the
-- principal is jointly and severally liable by operation of law.
#ASSERT NOT `the principal is liable to pay the employee` (`a principal` TRUE TRUE TRUE FALSE)
#ASSERT `the principal is liable to pay the employee` (`a principal` TRUE TRUE TRUE TRUE)
#ASSERT `the principal is entitled to be indemnified by the employer` (`a principal` TRUE TRUE TRUE TRUE)

§ `16 and First Schedule paragraph 5 -- medical treatment, and its two ceilings`

GIVEN `by professional` IS A BOOLEAN, `certified` IS A BOOLEAN
    , `within year` IS A NUMBER, `after year` IS A NUMBER, `on or after` IS A BOOLEAN
GIVETH A MedicalTreatment
DECIDE `treatment` `by professional` `certified` `within year` `after year` `on or after` IS
    MedicalTreatment WITH
        `the treatment was by a health professional or at an approved medical institution` IS `by professional`
        `an attending health professional certified it to be necessary` IS `certified`
        `the cost of treatment received within one year after the date of the accident` IS `within year`
        `the cost of treatment received after that year` IS `after year`
        `the accident took place on or after 1 November 2025` IS `on or after`
        `the employee is one mentioned in section 9` IS FALSE
        `the treatment was received outside Singapore for an accident occurring outside Singapore` IS FALSE
        `the Commissioner is of the opinion it was required immediately due to the nature of the injury` IS FALSE

#ASSERT `the employer is liable for the medical treatment` (`treatment` TRUE TRUE 10000 0 TRUE)
-- Not certified as necessary: no liability, however the treatment was given.
#ASSERT NOT `the employer is liable for the medical treatment` (`treatment` TRUE FALSE 10000 0 TRUE)

-- Under the money cap, the cost governs.
#ASSERT `the compensation for medical treatment` (`treatment` TRUE TRUE 10000 0 TRUE) EQUALS 10000
-- Over it, the cap governs: $53,000 on or after 1 November 2025, $45,000 before.
#ASSERT `the compensation for medical treatment` (`treatment` TRUE TRUE 90000 0 TRUE) EQUALS 53000
#ASSERT `the compensation for medical treatment` (`treatment` TRUE TRUE 90000 0 FALSE) EQUALS 45000

-- THE FIRST CEILING IS TEMPORAL AND BITES HARDEST. An employee who spends
-- $2,000 inside the year and $40,000 after it recovers $2,000, though the total
-- is far below the money cap. Treatment in the thirteenth month counts for
-- nothing, however necessary.
#ASSERT `the compensation for medical treatment` (`treatment` TRUE TRUE 2000 40000 TRUE) EQUALS 2000

§ `24 -- the duty to insure`

GIVEN `insured` IS A BOOLEAN, `excluded class` IS A BOOLEAN, `meets minimum` IS A BOOLEAN
GIVETH AN InsuranceFacts
DECIDE `insurance` `insured` `excluded class` `meets minimum` IS
    InsuranceFacts WITH
        `the employer has insured and maintained insurance under an approved policy with a designated insurer` IS `insured`
        `the employee is of an excluded class prescribed for section 24(2)(a)` IS `excluded class`
        `the amount insured meets any minimum prescribed amount` IS `meets minimum`

#ASSERT NOT `the employer contravenes section 24(1)` (`insurance` TRUE FALSE TRUE)
#ASSERT `the employer contravenes section 24(1)` (`insurance` FALSE FALSE TRUE)
-- Insured, but below the prescribed minimum: still a contravention.
#ASSERT `the employer contravenes section 24(1)` (`insurance` TRUE FALSE FALSE)
-- An excluded class takes the employee outside the duty altogether.
#ASSERT NOT `the employer contravenes section 24(1)` (`insurance` FALSE TRUE FALSE)

§ `34B -- the Part 3A substitution table`

-- THE MAPPING THE DEPOSITED TEXT GETS WRONG. WICA2019.txt shifts the applicable
-- sections up one row, so it reads "8 -> 34D". The PDF has 7 -> 34D and
-- 8 -> 34F, and these assertions fix that.
#ASSERT `the section that applies to a platform worker instead` `section 7` EQUALS "34D"
#ASSERT `the section that applies to a platform worker instead` `section 8` EQUALS "34F"
#ASSERT `the section that applies to a platform worker instead` `section 10` EQUALS "34G"
#ASSERT `the section that applies to a platform worker instead` `section 11` EQUALS "34H"
#ASSERT `the section that applies to a platform worker instead` `section 12` EQUALS "34I"
#ASSERT `the section that applies to a platform worker instead` `section 14` EQUALS "34K"
#ASSERT `the section that applies to a platform worker instead` `section 15` EQUALS "34L"
#ASSERT `the section that applies to a platform worker instead` `section 16` EQUALS "34M"
#ASSERT `the section that applies to a platform worker instead` `section 17` EQUALS "34N"

#ASSERT `Part 3A replaces this section for a platform worker` `section 7`
#ASSERT NOT `Part 3A replaces this section for a platform worker` `a section Part 3A does not replace`
-- s 9 and s 13 are not in the table, so they apply to a platform worker
-- unmodified.
#ASSERT `the section that applies to a platform worker instead` `a section Part 3A does not replace` EQUALS "the section itself, unmodified"
