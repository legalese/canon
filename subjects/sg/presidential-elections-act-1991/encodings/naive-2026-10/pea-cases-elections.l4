IMPORT prelude
IMPORT `pea-elections`

-- Presidential Elections Act 1991, ss 5B, 7, 7A, 8, 8A, 10, 26, 42C, 50, 58 to 62 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_presidential-elections-act-1991.py). Expected results were written by
-- hand from the text.

§ `s 5B and 7A(4)`

#ASSERT `the rule under the next writ` 1 0 EQUALS `the first rule for the reserved election`
#ASSERT `the rule under the next writ` 1 1 EQUALS `an open election`
#ASSERT `the rule under the next writ` 2 1 EQUALS `the second rule for the reserved election`
#ASSERT `the rule under the next writ` 2 2 EQUALS `an open election`
#ASSERT `the rule under the next writ` 3 1 EQUALS `the second rule for the reserved election`
#ASSERT `the rule under the next writ` 3 2 EQUALS `the third rule for the reserved election`
#ASSERT `the rule under the next writ` 3 3 EQUALS `an open election`

#ASSERT `the winner need not belong to any community` 1 1
#ASSERT NOT `the winner need not belong to any community` 3 2

#ASSERT NOT `the election wholly failed for section 5B` 1

#ASSERT `the election wholly failed for section 7A` 1 FALSE
#ASSERT NOT `the election wholly failed for section 7A` 1 TRUE

§ `s 7`

#ASSERT `the notice was given in time` 1 6
#ASSERT NOT `the notice was given in time` 1 5

§ `ss 8(3), 8A`

#ASSERT `the application is deemed withdrawn` 44
#ASSERT NOT `the application is deemed withdrawn` 45

#ASSERT `the Committee must reject` FALSE FALSE FALSE
#ASSERT `the Committee must reject` TRUE TRUE FALSE
#ASSERT NOT `the Committee must reject` TRUE TRUE TRUE

#ASSERT `the Committee must issue a certificate of eligibility` 50 TRUE TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `the Committee must issue a certificate of eligibility` 44 TRUE TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `the Committee must issue a certificate of eligibility` 50 TRUE FALSE TRUE FALSE FALSE TRUE
#ASSERT NOT `the Committee must issue a certificate of eligibility` 50 TRUE TRUE TRUE TRUE FALSE TRUE

§ `s 10`

#ASSERT `the presidential deposit` 13500 EQUALS 40500

#ASSERT `the deposit is forfeited` FALSE 125 1000
#ASSERT NOT `the deposit is forfeited` FALSE 126 1000
