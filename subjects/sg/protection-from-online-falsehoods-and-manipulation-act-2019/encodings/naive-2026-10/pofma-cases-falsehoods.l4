IMPORT prelude
IMPORT `pofma-falsehoods`

-- Protection from Online Falsehoods and Manipulation Act 2019, ss 2(2), 3, 7-12, 15, 17, 32(1), 38 and 57 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_protection-from-online-falsehoods-and-manipulation-act-2019.py). Expected results were written by
-- hand from the text.

§ `s 2(2)`

#ASSERT `it is a false statement of fact` TRUE FALSE TRUE
#ASSERT NOT `it is a false statement of fact` FALSE TRUE TRUE
#ASSERT NOT `it is a false statement of fact` TRUE FALSE FALSE

§ `s 3`

#ASSERT `it is communicated in Singapore` `the internet` FALSE TRUE
#ASSERT `it is communicated in Singapore` `SMS or MMS` TRUE TRUE
#ASSERT NOT `it is communicated in Singapore` `SMS or MMS` FALSE TRUE
#ASSERT NOT `it is communicated in Singapore` `a printed leaflet` TRUE TRUE

§ `s 7`

#ASSERT `the s 7 offence is committed` TRUE TRUE `influencing an election or referendum` FALSE
#ASSERT `the s 7 offence is committed` TRUE TRUE `prejudice to public health, safety, tranquillity or finances` FALSE
#ASSERT NOT `the s 7 offence is committed` TRUE TRUE `no listed harm` FALSE
#ASSERT NOT `the s 7 offence is committed` TRUE FALSE `prejudice to security` FALSE
#ASSERT NOT `the s 7 offence is committed` TRUE TRUE `prejudice to security` TRUE

§ `s 8`

#ASSERT `the s 8 offence is committed` TRUE TRUE
#ASSERT NOT `the s 8 offence is committed` FALSE TRUE

§ `s 9`

#ASSERT `the s 9 offence is committed` TRUE TRUE TRUE FALSE
#ASSERT NOT `the s 9 offence is committed` TRUE FALSE TRUE FALSE
#ASSERT NOT `the s 9 offence is committed` TRUE TRUE TRUE TRUE

#ASSERT `the s 9 disgorgement penalty` 8000 TRUE EQUALS 8000
#ASSERT `the s 9 disgorgement penalty` 8000 FALSE EQUALS 0

§ `Penalties`

#ASSERT `the maximum fine` `communicating a falsehood (s 7)` TRUE FALSE EQUALS 50000
#ASSERT `the maximum fine` `communicating a falsehood (s 7)` TRUE TRUE EQUALS 100000
#ASSERT `the maximum fine` `communicating a falsehood (s 7)` FALSE TRUE EQUALS 1000000
#ASSERT `the maximum fine` `providing services for falsehoods (s 9)` TRUE TRUE EQUALS 60000
#ASSERT `the maximum fine` `providing services for falsehoods (s 9)` FALSE TRUE EQUALS 1000000
#ASSERT `the maximum fine` `ignoring a Part 3 Direction (s 15)` TRUE FALSE EQUALS 20000
#ASSERT `the maximum fine` `funding a declared online location (s 38)` TRUE FALSE EQUALS 40000

#ASSERT `the maximum imprisonment in months` `communicating a falsehood (s 7)` TRUE FALSE EQUALS 60
#ASSERT `the maximum imprisonment in months` `communicating a falsehood (s 7)` TRUE TRUE EQUALS 120
#ASSERT `the maximum imprisonment in months` `communicating a falsehood (s 7)` FALSE TRUE EQUALS 0

