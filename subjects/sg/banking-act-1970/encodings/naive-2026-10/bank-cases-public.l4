IMPORT prelude
IMPORT `bank-public`

-- Banking Act 1970, ss 4A, 4B, 5, 47, 57, 61, 62 and the Third Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_bank.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`money from the public repayable with interest` MEANS Payment WITH
    `repayable on demand or agreed terms` IS TRUE
    `is an advance for goods or services, or a security deposit` IS FALSE
    `paid by a close relative, a group company, a bank or a licensed moneylender` IS FALSE

`a tenancy security deposit` MEANS Payment WITH
    `repayable on demand or agreed terms` IS TRUE
    `is an advance for goods or services, or a security deposit` IS TRUE
    `paid by a close relative, a group company, a bank or a licensed moneylender` IS FALSE

`a pre-order payment refundable if not delivered` MEANS Payment WITH
    `repayable on demand or agreed terms` IS TRUE
    `is an advance for goods or services, or a security deposit` IS TRUE
    `paid by a close relative, a group company, a bank or a licensed moneylender` IS FALSE

`a loan from the owner's mother` MEANS Payment WITH
    `repayable on demand or agreed terms` IS TRUE
    `is an advance for goods or services, or a security deposit` IS FALSE
    `paid by a close relative, a group company, a bank or a licensed moneylender` IS TRUE

`a gift` MEANS Payment WITH
    `repayable on demand or agreed terms` IS FALSE
    `is an advance for goods or services, or a security deposit` IS FALSE
    `paid by a close relative, a group company, a bank or a licensed moneylender` IS FALSE

`an unlicensed investment scheme taking money daily` MEANS Taker WITH
    `lends deposits on or uses them materially to finance the business` IS TRUE
    `holds itself out as accepting deposits day to day` IS TRUE
    `accepts deposits day to day` IS TRUE
    `is a bank, finance company, credit co-operative, merchant bank or otherwise licensed` IS FALSE

`a company borrowing once from the public` MEANS Taker WITH
    `lends deposits on or uses them materially to finance the business` IS TRUE
    `holds itself out as accepting deposits day to day` IS FALSE
    `accepts deposits day to day` IS FALSE
    `is a bank, finance company, credit co-operative, merchant bank or otherwise licensed` IS FALSE

`a licensed bank` MEANS Taker WITH
    `lends deposits on or uses them materially to finance the business` IS TRUE
    `holds itself out as accepting deposits day to day` IS TRUE
    `accepts deposits day to day` IS TRUE
    `is a bank, finance company, credit co-operative, merchant bank or otherwise licensed` IS TRUE

`a shop holding customers' money but not using it` MEANS Taker WITH
    `lends deposits on or uses them materially to finance the business` IS FALSE
    `holds itself out as accepting deposits day to day` IS TRUE
    `accepts deposits day to day` IS TRUE
    `is a bank, finance company, credit co-operative, merchant bank or otherwise licensed` IS FALSE

`a licensed bank` MEANS NameUse WITH
    `is a bank or has MAS consent` IS TRUE
    `uses bank or a derivative in any language` IS TRUE
    `transacts no banking or financial business` IS FALSE
    `other words show it is not a bank` IS FALSE

`a fintech calling itself a digital bank` MEANS NameUse WITH
    `is a bank or has MAS consent` IS FALSE
    `uses bank or a derivative in any language` IS TRUE
    `transacts no banking or financial business` IS FALSE
    `other words show it is not a bank` IS FALSE

`a food bank charity` MEANS NameUse WITH
    `is a bank or has MAS consent` IS FALSE
    `uses bank or a derivative in any language` IS TRUE
    `transacts no banking or financial business` IS TRUE
    `other words show it is not a bank` IS TRUE

`a lender calling itself Bank Pinjaman` MEANS NameUse WITH
    `is a bank or has MAS consent` IS FALSE
    `uses bank or a derivative in any language` IS TRUE
    `transacts no banking or financial business` IS FALSE
    `other words show it is not a bank` IS TRUE

`a shop with no bank in its name` MEANS NameUse WITH
    `is a bank or has MAS consent` IS FALSE
    `uses bank or a derivative in any language` IS FALSE
    `transacts no banking or financial business` IS FALSE
    `other words show it is not a bank` IS FALSE

§ `ss 4A, 4B`

#ASSERT `the payment is a deposit` `money from the public repayable with interest`
#ASSERT NOT `the payment is a deposit` `a tenancy security deposit`
#ASSERT NOT `the payment is a deposit` `a pre-order payment refundable if not delivered`
#ASSERT NOT `the payment is a deposit` `a loan from the owner's mother`
#ASSERT NOT `the payment is a deposit` `a gift`

#ASSERT `the business is deposit-taking` `an unlicensed investment scheme taking money daily`
#ASSERT NOT `the business is deposit-taking` `a company borrowing once from the public`
#ASSERT `the business is deposit-taking` `a licensed bank`
#ASSERT NOT `the business is deposit-taking` `a shop holding customers' money but not using it`

#ASSERT `accepting the payment is an offence under section 4A` `an unlicensed investment scheme taking money daily` `money from the public repayable with interest`
#ASSERT NOT `accepting the payment is an offence under section 4A` `a licensed bank` `money from the public repayable with interest`
#ASSERT NOT `accepting the payment is an offence under section 4A` `a company borrowing once from the public` `money from the public repayable with interest`
#ASSERT NOT `accepting the payment is an offence under section 4A` `an unlicensed investment scheme taking money daily` `a loan from the owner's mother`
#ASSERT NOT `accepting the payment is an offence under section 4A` `an unlicensed investment scheme taking money daily` `a tenancy security deposit`

#ASSERT `the depositor can still recover the deposit` TRUE

