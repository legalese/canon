  <decision id="decision_the_court_may_make_a_declaration_or_grant_an_injunction_under_section_9_1" name="the_court_may_make_a_declaration_or_grant_an_injunction_under_section_9_1" label="the court may make a declaration or grant an injunction under section 9(1)">
    <variable id="decision_the_court_may_make_a_declaration_or_grant_an_injunction_under_section_9_1_var" name="the_court_may_make_a_declaration_or_grant_an_injunction_under_section_9_1" label="the court may make a declaration or grant an injunction under section 9(1)" typeRef="boolean"/>
