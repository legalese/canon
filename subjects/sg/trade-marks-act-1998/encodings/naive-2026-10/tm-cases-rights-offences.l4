IMPORT prelude
IMPORT `tm-rights-offences`

-- Trade Marks Act 1998, ss 18, 22, 27 to 29, 35, 46, 47, 49 and 51 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_tm.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a mark unused for 6 years` MEANS Use WITH
    `years without genuine use` IS 6
    `proper reasons for non-use` IS FALSE
    `use resumed before the application` IS FALSE
    `resumption was within 3 months before the application` IS FALSE
    `preparations began before the proprietor knew of a likely application` IS FALSE

`a mark unused for 4 years` MEANS Use WITH
    `years without genuine use` IS 4
    `proper reasons for non-use` IS FALSE
    `use resumed before the application` IS FALSE
    `resumption was within 3 months before the application` IS FALSE
    `preparations began before the proprietor knew of a likely application` IS FALSE

`a mark unused for 6 years for proper reasons` MEANS Use WITH
    `years without genuine use` IS 6
    `proper reasons for non-use` IS TRUE
    `use resumed before the application` IS FALSE
    `resumption was within 3 months before the application` IS FALSE
    `preparations began before the proprietor knew of a likely application` IS FALSE

`a mark revived a year before the application` MEANS Use WITH
    `years without genuine use` IS 6
    `proper reasons for non-use` IS FALSE
    `use resumed before the application` IS TRUE
    `resumption was within 3 months before the application` IS FALSE
    `preparations began before the proprietor knew of a likely application` IS FALSE

`a mark revived a month before the application, prompted by it` MEANS Use WITH
    `years without genuine use` IS 6
    `proper reasons for non-use` IS FALSE
    `use resumed before the application` IS TRUE
    `resumption was within 3 months before the application` IS TRUE
    `preparations began before the proprietor knew of a likely application` IS FALSE

`a mark revived a month before, with earlier preparations` MEANS Use WITH
    `years without genuine use` IS 6
    `proper reasons for non-use` IS FALSE
    `use resumed before the application` IS TRUE
    `resumption was within 3 months before the application` IS TRUE
    `preparations began before the proprietor knew of a likely application` IS TRUE

`an identical mark on identical goods` MEANS UseFacts WITH
    `sign` IS `identical`
    `goods` IS `identical`
    `in the course of trade` IS TRUE
    `with consent` IS FALSE
    `likelihood of confusion` IS FALSE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS FALSE

`an identical mark on similar goods without confusion` MEANS UseFacts WITH
    `sign` IS `identical`
    `goods` IS `similar`
    `in the course of trade` IS TRUE
    `with consent` IS FALSE
    `likelihood of confusion` IS FALSE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS FALSE

`a similar mark on similar goods with confusion` MEANS UseFacts WITH
    `sign` IS `similar`
    `goods` IS `similar`
    `in the course of trade` IS TRUE
    `with consent` IS FALSE
    `likelihood of confusion` IS TRUE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS FALSE

`a well-known mark on dissimilar goods with confusion and damage` MEANS UseFacts WITH
    `sign` IS `similar`
    `goods` IS `dissimilar`
    `in the course of trade` IS TRUE
    `with consent` IS FALSE
    `likelihood of confusion` IS TRUE
    `the mark is well known and the use damages and indicates a connection` IS TRUE
    `a section 28 exception applies` IS FALSE

`an ordinary mark on dissimilar goods with confusion` MEANS UseFacts WITH
    `sign` IS `similar`
    `goods` IS `dissimilar`
    `in the course of trade` IS TRUE
    `with consent` IS FALSE
    `likelihood of confusion` IS TRUE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS FALSE

`an identical mark on identical goods, licensed` MEANS UseFacts WITH
    `sign` IS `identical`
    `goods` IS `identical`
    `in the course of trade` IS TRUE
    `with consent` IS TRUE
    `likelihood of confusion` IS FALSE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS FALSE

`an identical mark used non-commercially` MEANS UseFacts WITH
    `sign` IS `identical`
    `goods` IS `identical`
    `in the course of trade` IS FALSE
    `with consent` IS FALSE
    `likelihood of confusion` IS FALSE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS FALSE

`an identical mark in comparative advertising` MEANS UseFacts WITH
    `sign` IS `identical`
    `goods` IS `identical`
    `in the course of trade` IS TRUE
    `with consent` IS FALSE
    `likelihood of confusion` IS FALSE
    `the mark is well known and the use damages and indicates a connection` IS FALSE
    `a section 28 exception applies` IS TRUE

`genuine bags bought cheaply in Japan` MEANS Import WITH
    `genuine goods put on the market abroad by or with the proprietor's consent` IS TRUE
    `condition changed or impaired` IS FALSE
    `causes unfair dilution` IS FALSE

`genuine goods repackaged without dilution` MEANS Import WITH
    `genuine goods put on the market abroad by or with the proprietor's consent` IS TRUE
    `condition changed or impaired` IS TRUE
    `causes unfair dilution` IS FALSE

`damaged genuine goods that dilute the brand` MEANS Import WITH
    `genuine goods put on the market abroad by or with the proprietor's consent` IS TRUE
    `condition changed or impaired` IS TRUE
    `causes unfair dilution` IS TRUE

`fakes` MEANS Import WITH
    `genuine goods put on the market abroad by or with the proprietor's consent` IS FALSE
    `condition changed or impaired` IS FALSE
    `causes unfair dilution` IS FALSE

`a careful retailer who names its supplier` MEANS Seller WITH
    `took all reasonable precautions` IS TRUE
    `had no reason to suspect` IS TRUE
    `disclosed all suppliers on demand` IS TRUE
    `acted innocently` IS FALSE

`a careful retailer who will not name its supplier` MEANS Seller WITH
    `took all reasonable precautions` IS TRUE
    `had no reason to suspect` IS TRUE
    `disclosed all suppliers on demand` IS FALSE
    `acted innocently` IS FALSE

`an innocent seller` MEANS Seller WITH
    `took all reasonable precautions` IS FALSE
    `had no reason to suspect` IS FALSE
    `disclosed all suppliers on demand` IS FALSE
    `acted innocently` IS TRUE

`a careless seller` MEANS Seller WITH
    `took all reasonable precautions` IS FALSE
    `had no reason to suspect` IS FALSE
    `disclosed all suppliers on demand` IS FALSE
    `acted innocently` IS FALSE

`an R symbol on a Singapore-registered mark` MEANS RSymbol WITH
    `registered in Singapore` IS TRUE
    `shown to refer to a foreign registration that exists` IS FALSE
    `knew or had reason to believe it was false` IS FALSE

`an R symbol on a US-registered mark, shown` MEANS RSymbol WITH
    `registered in Singapore` IS FALSE
    `shown to refer to a foreign registration that exists` IS TRUE
    `knew or had reason to believe it was false` IS TRUE

`an R symbol on an unregistered mark, knowingly` MEANS RSymbol WITH
    `registered in Singapore` IS FALSE
    `shown to refer to a foreign registration that exists` IS FALSE
    `knew or had reason to believe it was false` IS TRUE

`an R symbol on an unregistered mark, honestly mistaken` MEANS RSymbol WITH
    `registered in Singapore` IS FALSE
    `shown to refer to a foreign registration that exists` IS FALSE
    `knew or had reason to believe it was false` IS FALSE

§ `s 22`

#ASSERT `the mark is liable to revocation for non-use` `a mark unused for 6 years`
#ASSERT NOT `the mark is liable to revocation for non-use` `a mark unused for 4 years`
#ASSERT NOT `the mark is liable to revocation for non-use` `a mark unused for 6 years for proper reasons`
#ASSERT NOT `the mark is liable to revocation for non-use` `a mark revived a year before the application`
#ASSERT `the mark is liable to revocation for non-use` `a mark revived a month before the application, prompted by it`
#ASSERT NOT `the mark is liable to revocation for non-use` `a mark revived a month before, with earlier preparations`

§ `ss 27, 28`

#ASSERT `the use infringes` `an identical mark on identical goods`
#ASSERT NOT `the use infringes` `an identical mark on similar goods without confusion`
#ASSERT `the use infringes` `a similar mark on similar goods with confusion`
#ASSERT `the use infringes` `a well-known mark on dissimilar goods with confusion and damage`
#ASSERT NOT `the use infringes` `an ordinary mark on dissimilar goods with confusion`
#ASSERT NOT `the use infringes` `an identical mark on identical goods, licensed`
#ASSERT NOT `the use infringes` `an identical mark used non-commercially`
#ASSERT NOT `the use infringes` `an identical mark in comparative advertising`

#ASSERT `the exception is in section 28` `honest use of one's own name`
#ASSERT `the exception is in section 28` `honest descriptive use`
#ASSERT `the exception is in section 28` `spare parts compatibility`
#ASSERT `the exception is in section 28` `earlier continuous unregistered use`
#ASSERT `the exception is in section 28` `fair comparative advertising`
#ASSERT `the exception is in section 28` `non-commercial use`
#ASSERT `the exception is in section 28` `news reporting`
#ASSERT NOT `the exception is in section 28` `a parody t-shirt sold for profit`

§ `s 29`

#ASSERT `the parallel import is lawful` `genuine bags bought cheaply in Japan`
#ASSERT `the parallel import is lawful` `genuine goods repackaged without dilution`
#ASSERT NOT `the parallel import is lawful` `damaged genuine goods that dilute the brand`
#ASSERT NOT `the parallel import is lawful` `fakes`

§ `s 35`

#ASSERT NOT `the threatened person has a remedy` `a manufacturer applying the mark` FALSE
#ASSERT NOT `the threatened person has a remedy` `an importer` FALSE
#ASSERT NOT `the threatened person has a remedy` `a service provider using the mark` FALSE
#ASSERT `the threatened person has a remedy` `a retailer who only sells` FALSE
#ASSERT NOT `the threatened person has a remedy` `a retailer who only sells` TRUE

§ `ss 46 to 51`

#ASSERT `the maximum fine for selling counterfeits` 3 EQUALS 30000
#ASSERT `the maximum fine for selling counterfeits` 10 EQUALS 100000
#ASSERT `the maximum fine for selling counterfeits` 50 EQUALS 100000

#ASSERT `the seller has a section 49 defence` `a careful retailer who names its supplier`
#ASSERT NOT `the seller has a section 49 defence` `a careful retailer who will not name its supplier`
#ASSERT `the seller has a section 49 defence` `an innocent seller`
#ASSERT NOT `the seller has a section 49 defence` `a careless seller`

#ASSERT NOT `using the registered symbol is an offence` `an R symbol on a Singapore-registered mark`
#ASSERT NOT `using the registered symbol is an offence` `an R symbol on a US-registered mark, shown`
#ASSERT `using the registered symbol is an offence` `an R symbol on an unregistered mark, knowingly`
#ASSERT NOT `using the registered symbol is an offence` `an R symbol on an unregistered mark, honestly mistaken`

