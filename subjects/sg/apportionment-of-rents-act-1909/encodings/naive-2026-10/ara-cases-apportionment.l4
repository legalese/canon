IMPORT prelude
IMPORT `ara-apportionment`

-- Apportionment of Rents Act 1909, ss 2 to 8 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_apportionment-of-rents-act-1909.py). Expected results were written by
-- hand from the text.

§ `s 2`

#ASSERT `is a lessee or grantee` `an assignee of the whole State lease`
#ASSERT `is a lessee or grantee` `the legal representative of a State lessee`
#ASSERT NOT `is a lessee or grantee` `an assignee of part of the land in a State lease`
#ASSERT NOT `is a lessee or grantee` `an owner of land held under neither`

§ `s 3(1), (5)`

#ASSERT `must notify the Collector` `a State lessee` TRUE
#ASSERT NOT `must notify the Collector` `a State lessee` FALSE
#ASSERT NOT `must notify the Collector` `an assignee of part of the land in a State lease` TRUE

#ASSERT `the notification complies` TRUE TRUE TRUE TRUE
#ASSERT NOT `the notification complies` TRUE TRUE TRUE FALSE
#ASSERT NOT `the notification complies` TRUE FALSE TRUE TRUE

#ASSERT `failing to notify is an offence` `a State lessee` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `failing to notify is an offence` `a State lessee` TRUE TRUE TRUE TRUE TRUE
#ASSERT `failing to notify is an offence` `a State lessee` TRUE TRUE TRUE TRUE FALSE
#ASSERT `failing to notify is an offence` `a grantee in perpetuity` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `failing to notify is an offence` `an assignee of part of the land in a State lease` TRUE FALSE FALSE FALSE FALSE

#ASSERT `the maximum fine in dollars` `a State lessee` TRUE TRUE TRUE TRUE FALSE EQUALS 500
#ASSERT `the maximum fine in dollars` `a State lessee` TRUE TRUE TRUE TRUE TRUE EQUALS 0

§ `ss 3(2), 4`

#ASSERT `the Collector must determine the rents` TRUE TRUE
#ASSERT NOT `the Collector must determine the rents` TRUE FALSE

#ASSERT `the Collector may determine the rents of his own motion` TRUE TRUE FALSE
#ASSERT NOT `the Collector may determine the rents of his own motion` TRUE TRUE TRUE

§ `s 3(3)`

#ASSERT `the subdivision rent in dollars` 30 EQUALS 1
#ASSERT `the subdivision rent in dollars` 99 EQUALS 1
#ASSERT `the subdivision rent in dollars` 100 EQUALS 1
#ASSERT `the subdivision rent in dollars` 120 EQUALS 1.5
#ASSERT `the subdivision rent in dollars` 151 EQUALS 2
#ASSERT `the subdivision rent in dollars` 1001 EQUALS 10.5
#ASSERT `the subdivision rent in dollars` 2575 EQUALS 26

§ `s 5`

#ASSERT `the notice is well served` TRUE FALSE FALSE FALSE
#ASSERT `the notice is well served` FALSE TRUE TRUE TRUE
#ASSERT NOT `the notice is well served` FALSE TRUE TRUE FALSE
#ASSERT NOT `the notice is well served` FALSE FALSE TRUE TRUE

§ `ss 6, 7(1), (2)`

#ASSERT `the Collector must consider the objection` TRUE TRUE
#ASSERT NOT `the Collector must consider the objection` FALSE TRUE

#ASSERT `the Collector may make the order` TRUE FALSE FALSE
#ASSERT NOT `the Collector may make the order` TRUE TRUE FALSE
#ASSERT NOT `the Collector may make the order` FALSE FALSE FALSE

§ `s 7(3)`

#ASSERT `the order binds this holder` TRUE FALSE
#ASSERT NOT `the order binds this holder` FALSE TRUE

§ `s 8`

#ASSERT `the apportioned rent is payable at once` TRUE TRUE
#ASSERT NOT `the apportioned rent is payable at once` TRUE FALSE

#ASSERT `the original covenant becomes` FALSE TRUE TRUE EQUALS `unchanged`
#ASSERT `the original covenant becomes` TRUE TRUE FALSE EQUALS `discharged`
#ASSERT `the original covenant becomes` TRUE FALSE TRUE EQUALS `limited to the retained part`
#ASSERT `the original covenant becomes` TRUE FALSE FALSE EQUALS `unchanged`

#ASSERT `the rent the original holder covenants to pay` TRUE FALSE TRUE 1000 250 EQUALS 250
#ASSERT `the rent the original holder covenants to pay` TRUE TRUE FALSE 1000 0 EQUALS 0
#ASSERT `the rent the original holder covenants to pay` FALSE FALSE TRUE 1000 250 EQUALS 1000

#ASSERT NOT `a buyer's covenant to pay the lessee a share of the rent survives` TRUE
#ASSERT `a buyer's covenant to pay the lessee a share of the rent survives` FALSE

