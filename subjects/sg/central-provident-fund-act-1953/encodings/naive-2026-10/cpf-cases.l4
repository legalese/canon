IMPORT prelude
IMPORT `cpf-withdrawal`

-- Central Provident Fund Act 1953, section 15 -- worked cases.

§ `Fixtures`

GIVEN `citizen or pr` IS A BOOLEAN
    , `over 55` IS A BOOLEAN
    , `credit` IS A NUMBER
    , `retirement sum` IS A NUMBER
GIVETH A Member
DECIDE `a member` `citizen or pr` `over 55` `credit` `retirement sum` IS
    Member WITH
        `name` IS "M"
        `a citizen or permanent resident of Singapore` IS `citizen or pr`
        `of a class prescribed under section 77(1) as an applicable person` IS FALSE
        `has attained the age of 55 years` IS `over 55`
        `has already withdrawn on the ground of having attained 55` IS FALSE
        `an anniversary of the date of birth has since passed, or the Minister has directed another period` IS FALSE
        `the sum standing to the member's credit` IS `credit`
        `the prescribed retirement sum applicable to the member` IS `retirement sum`
        `a reserved amount standing to the member's credit` IS 0

`a citizen aged 40 with $200,000` MEANS `a member` TRUE FALSE 200000 100000
`a citizen aged 60 with $200,000` MEANS `a member` TRUE TRUE 200000 100000
`a foreigner aged 40 with $200,000` MEANS `a member` FALSE FALSE 200000 100000
`a citizen aged 60 with $80,000` MEANS `a member` TRUE TRUE 80000 100000

§§ `2 -- applicable person`

#ASSERT `the member is an applicable person` `a citizen aged 40 with $200,000`
#ASSERT NOT `the member is an applicable person` `a foreigner aged 40 with $200,000`

-- Limb (b) of the definition: a prescribed class. Nobody is in it on these
-- facts, but the limb is live and the rule reads it.
`a prescribed applicable person` MEANS Member WITH
    `name` IS "P"
    `a citizen or permanent resident of Singapore` IS FALSE
    `of a class prescribed under section 77(1) as an applicable person` IS TRUE
    `has attained the age of 55 years` IS FALSE
    `has already withdrawn on the ground of having attained 55` IS FALSE
    `an anniversary of the date of birth has since passed, or the Minister has directed another period` IS FALSE
    `the sum standing to the member's credit` IS 200000
    `the prescribed retirement sum applicable to the member` IS 100000
    `a reserved amount standing to the member's credit` IS 0

#ASSERT `the member is an applicable person` `a prescribed applicable person`
#ASSERT NOT `the member is entitled to withdraw under section 15(2)(b)` `a prescribed applicable person`

§§ `15(2) -- the two grounds`

-- A citizen under 55: neither ground. The money stays in.
#ASSERT NOT `the member is entitled to withdraw under section 15(2)` `a citizen aged 40 with $200,000`

-- At 55, ground (a).
#ASSERT `the member is entitled to withdraw under section 15(2)(a)` `a citizen aged 60 with $200,000`

-- A foreigner who is neither citizen nor permanent resident: ground (b), at any
-- age.
#ASSERT `the member is entitled to withdraw under section 15(2)(b)` `a foreigner aged 40 with $200,000`
#ASSERT `the member is entitled to withdraw under section 15(2)` `a foreigner aged 40 with $200,000`

§§ `15(6) -- the retirement sum, and who it binds`

-- The set-aside attaches to (2)(a) and (3), not to (2)(b).
#ASSERT `the retirement sum must be set aside` `a citizen aged 60 with $200,000`
#ASSERT NOT `the retirement sum must be set aside` `a foreigner aged 40 with $200,000`

-- THE CONSEQUENCE, asserted as a pair. Two members with the same $200,000 and
-- the same $100,000 retirement sum: the 60-year-old citizen may take $100,000,
-- the foreigner may take the whole $200,000.
#ASSERT `the amount this member may withdraw` `a citizen aged 60 with $200,000` TRUE EQUALS 100000
#ASSERT `the amount this member may withdraw` `a foreigner aged 40 with $200,000` TRUE EQUALS 200000

-- Where the credit will not cover the retirement sum, nothing comes out.
#ASSERT NOT `the credit is enough to set aside the retirement sum` `a citizen aged 60 with $80,000`
#ASSERT `the amount withdrawable after the set-aside` `a citizen aged 60 with $80,000` EQUALS 0
#ASSERT `the amount this member may withdraw` `a citizen aged 60 with $80,000` TRUE EQUALS 0

-- Exactly at the retirement sum: the credit is enough, and nothing is left.
`a citizen aged 60 with exactly $100,000` MEANS `a member` TRUE TRUE 100000 100000
#ASSERT `the credit is enough to set aside the retirement sum` `a citizen aged 60 with exactly $100,000`
#ASSERT `the amount this member may withdraw` `a citizen aged 60 with exactly $100,000` TRUE EQUALS 0

-- s 15(6)(a)(ii): the reserved amount is excluded from the sum the retirement
-- sum is taken from, so it reduces what is available twice over.
`a citizen aged 60 with a reserved amount` MEANS Member WITH
    `name` IS "R"
    `a citizen or permanent resident of Singapore` IS TRUE
    `of a class prescribed under section 77(1) as an applicable person` IS FALSE
    `has attained the age of 55 years` IS TRUE
    `has already withdrawn on the ground of having attained 55` IS FALSE
    `an anniversary of the date of birth has since passed, or the Minister has directed another period` IS FALSE
    `the sum standing to the member's credit` IS 200000
    `the prescribed retirement sum applicable to the member` IS 100000
    `a reserved amount standing to the member's credit` IS 30000

#ASSERT `the sum available to set the retirement sum aside from` `a citizen aged 60 with a reserved amount` EQUALS 170000
#ASSERT `the amount this member may withdraw` `a citizen aged 60 with a reserved amount` TRUE EQUALS 70000

§§ `15(1) -- the Board's authority is required on top of any entitlement`

-- An entitlement under s 15(2) is not a withdrawal. s 15(1) forbids any
-- withdrawal without the Board's authority, so the same member gets nothing
-- until the Board acts.
#ASSERT `the amount this member may withdraw` `a citizen aged 60 with $200,000` FALSE EQUALS 0
#ASSERT `the amount this member may withdraw` `a foreigner aged 40 with $200,000` FALSE EQUALS 0
#ASSERT `money may lawfully be withdrawn` TRUE
#ASSERT NOT `money may lawfully be withdrawn` FALSE

§§ `15(3) -- the annual further withdrawal attaches to one ground only`

`a citizen who withdrew at 55, a year on` MEANS Member WITH
    `name` IS "A"
    `a citizen or permanent resident of Singapore` IS TRUE
    `of a class prescribed under section 77(1) as an applicable person` IS FALSE
    `has attained the age of 55 years` IS TRUE
    `has already withdrawn on the ground of having attained 55` IS TRUE
    `an anniversary of the date of birth has since passed, or the Minister has directed another period` IS TRUE
    `the sum standing to the member's credit` IS 50000
    `the prescribed retirement sum applicable to the member` IS 20000
    `a reserved amount standing to the member's credit` IS 0

`a citizen who withdrew at 55, same year` MEANS Member WITH
    `name` IS "B"
    `a citizen or permanent resident of Singapore` IS TRUE
    `of a class prescribed under section 77(1) as an applicable person` IS FALSE
    `has attained the age of 55 years` IS TRUE
    `has already withdrawn on the ground of having attained 55` IS TRUE
    `an anniversary of the date of birth has since passed, or the Minister has directed another period` IS FALSE
    `the sum standing to the member's credit` IS 50000
    `the prescribed retirement sum applicable to the member` IS 20000
    `a reserved amount standing to the member's credit` IS 0

#ASSERT `the member is entitled to a further withdrawal under section 15(3)` `a citizen who withdrew at 55, a year on`
#ASSERT NOT `the member is entitled to a further withdrawal under section 15(3)` `a citizen who withdrew at 55, same year`

-- The set-aside binds the further withdrawal too.
#ASSERT `the retirement sum must be set aside` `a citizen who withdrew at 55, a year on`
#ASSERT `the amount this member may withdraw` `a citizen who withdrew at 55, a year on` TRUE EQUALS 30000
