#ASSERT NOT `Dieu 99(2): the investment complies with the principles` `a portfolio with restructuring bonds`
#ASSERT `Dieu 99(2): the investment complies with the principles` `an entrusted portfolio with a licensed trustee`
#ASSERT NOT `Dieu 99(2): the investment complies with the principles` `an entrusted portfolio with an unlicensed trustee`
@@fx `real estate trading` : `An investment position` ; `is real estate business outside the exceptions` = TRUE
@@fx `foreclosed real estate held three years` : `An investment position` ; `is real estate held after foreclosure or set-off of debts` = TRUE ; `years real estate has been held after foreclosure or set-off` = 3
@@fx `foreclosed real estate held three and a half years` : `An investment position` ; `is real estate held after foreclosure or set-off of debts` = TRUE ; `years real estate has been held after foreclosure or set-off` = 3.5
@@fx `gold bars` : `An investment position` ; `is precious metals or stones` = TRUE
@@fx `an unrelated intangible asset` : `An investment position` ; `is intangible fixed assets not serving the insurance business` = TRUE
@@fx `speculative derivatives` : `An investment position` ; `is derivatives other than listed hedging derivatives` = TRUE
@@fx `government bonds` : `An investment position`
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `real estate trading` (YMD 2028 1 1))
#ASSERT NOT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `foreclosed real estate held three years` (YMD 2028 1 1))
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `foreclosed real estate held three and a half years` (YMD 2028 1 1))
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `gold bars` (YMD 2028 1 1))
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `an unrelated intangible asset` (YMD 2028 1 1))
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `speculative derivatives` (YMD 2028 1 1))
#ASSERT NOT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `government bonds` (YMD 2028 1 1))
#ASSERT REFUSED `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 99(3): the investment is a prohibited investment` `gold bars` (YMD 2027 12 31))
#ASSERT REFUSED `Dieu 99(4)-(5): the Minister of Finance's rules on valuing investment assets and the Government's investment limits`
@@fx `a permitted foreign investment` : `An investment abroad` ; `is establishing, funding or buying an insurer or reinsurer abroad, or a branch, representative office or other presence abroad` = TRUE ; `is funded from equity left after capital adequacy and solvency` = TRUE ; `keeps the capital adequacy ratio and solvency` = TRUE ; `complies with the insurance, investment and foreign exchange laws` = TRUE ; `is made in the name of the insurer or reinsurer` = TRUE ; `is managed and tracked separately` = TRUE ; `the Ministry of Finance approved in writing before the investment` = TRUE
@@fx `the same without prior approval` : `An investment abroad` ; `is establishing, funding or buying an insurer or reinsurer abroad, or a branch, representative office or other presence abroad` = TRUE ; `is funded from equity left after capital adequacy and solvency` = TRUE ; `keeps the capital adequacy ratio and solvency` = TRUE ; `complies with the insurance, investment and foreign exchange laws` = TRUE ; `is made in the name of the insurer or reinsurer` = TRUE ; `is managed and tracked separately` = TRUE
@@fx `the same by a foreign branch` : `An investment abroad` ; `is establishing, funding or buying an insurer or reinsurer abroad, or a branch, representative office or other presence abroad` = TRUE ; `is funded from equity left after capital adequacy and solvency` = TRUE ; `keeps the capital adequacy ratio and solvency` = TRUE ; `complies with the insurance, investment and foreign exchange laws` = TRUE ; `is made in the name of the insurer or reinsurer` = TRUE ; `is managed and tracked separately` = TRUE ; `the Ministry of Finance approved in writing before the investment` = TRUE ; `the investor is a foreign branch in Vietnam` = TRUE
@@fx `the same covering a loss with domestic policyholders' money` : `An investment abroad` ; `is establishing, funding or buying an insurer or reinsurer abroad, or a branch, representative office or other presence abroad` = TRUE ; `is funded from equity left after capital adequacy and solvency` = TRUE ; `keeps the capital adequacy ratio and solvency` = TRUE ; `complies with the insurance, investment and foreign exchange laws` = TRUE ; `is made in the name of the insurer or reinsurer` = TRUE ; `is managed and tracked separately` = TRUE ; `the Ministry of Finance approved in writing before the investment` = TRUE ; `covers a loss of the investment with money or assets of domestic policyholders` = TRUE
@@fx `an investment abroad from reserves of linked contracts` : `An investment abroad` ; `is buying or selling securities or investing through funds or intermediaries abroad as the Government provides` = TRUE ; `is funded from idle technical reserves of contracts linked to foreign investment indices or made with persons abroad` = TRUE ; `keeps the capital adequacy ratio and solvency` = TRUE ; `complies with the insurance, investment and foreign exchange laws` = TRUE ; `is made in the name of the insurer or reinsurer` = TRUE ; `is managed and tracked separately` = TRUE ; `the Ministry of Finance approved in writing before the investment` = TRUE
#ASSERT `Dieu 100: the investment abroad is permitted` `a permitted foreign investment`
#ASSERT NOT `Dieu 100: the investment abroad is permitted` `the same without prior approval`
#ASSERT NOT `Dieu 100: the investment abroad is permitted` `the same by a foreign branch`
#ASSERT NOT `Dieu 100: the investment abroad is permitted` `the same covering a loss with domestic policyholders' money`
#ASSERT `Dieu 100: the investment abroad is permitted` `an investment abroad from reserves of linked contracts`
#ASSERT REFUSED `Dieu 100(5): the Government's conditions, limits and procedure for investing abroad`

