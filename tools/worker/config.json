{
  "_about": "Policy for canon workers. Humans edit this file; workers only read it. See WORKER.md.",

  "gate": {
    "_about": "A run proceeds only if BOTH are under these ceilings. Each runner may lower them in their own routine prompt, never raise them.",
    "max_weekly_pct": 80,
    "max_five_hour_pct": 60
  },

  "claims": {
    "branch_prefix": "claim/",
    "ttl_hours": 6,
    "_about_ttl": "A claim branch with no commit for this long may be taken over by another runner."
  },

  "units": {
    "_about": "Rough output-token cost per unit, used to pick work that fits the allowance left. Tune from real runs.",
    "fetch_source": 15000,
    "encode_per_1000_chars": 1500,
    "encode_part_min_chars": 8000,
    "encode_part_max_chars": 60000,
    "respond_to_review": 40000
  },

  "priority": [
    "respond_to_review",
    "continue_own_claim",
    "encode_part",
    "fetch_source"
  ],

  "jurisdictions": {
    "_about": "licence: open | permission (conditions met) | conditional-pending | not-open | unclear. Only open and permission may receive text. fetch: have-text | ready | not-built | window:<spec> | needs-api-key | script-blocked. decided_by records who cleared a licence.",
    "western-australia":            {"licence": "open", "fetch": "have-text"},
    "singapore":                    {"licence": "permission", "fetch": "window:03:00-07:00 Asia/Singapore", "note": "SSO Terms cl.13; the nightly harvest fetches text, workers do not"},
