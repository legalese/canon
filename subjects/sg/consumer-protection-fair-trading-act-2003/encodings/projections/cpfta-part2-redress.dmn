  <decision id="decision_the_prescribed_limit" name="the_prescribed_limit" label="the prescribed limit">
    <variable id="decision_the_prescribed_limit_var" name="the_prescribed_limit" label="the prescribed limit" typeRef="number"/>
    <informationRequirement id="decision_the_prescribed_limit_ir1">
      <requiredInput href="#input_a"/>
    </informationRequirement>
    <literalExpression id="decision_the_prescribed_limit_literal">
      <text>if a.the_limit_prescribed_by_the_Minister_by_order_in_the_Gazette_in_place_of_30_000 != null then a.the_limit_prescribed_by_the_Minister_by_order_in_the_Gazette_in_place_of_30_000 else 30000</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_annual_rent_or_12_times_the_monthly_rent" name="the_annual_rent_or_12_times_the_monthly_rent" label="the annual rent, or 12 times the monthly rent">
    <variable id="decision_the_annual_rent_or_12_times_the_monthly_rent_var" name="the_annual_rent_or_12_times_the_monthly_rent" label="the annual rent, or 12 times the monthly rent" typeRef="number"/>
    <informationRequirement id="decision_the_annual_rent_or_12_times_the_monthly_rent_ir1">
      <requiredInput href="#input_v"/>
    </informationRequirement>
    <literalExpression id="decision_the_annual_rent_or_12_times_the_monthly_rent_literal">
      <text>if v.the_annual_rent_payable_by_the_tenant_in_respect_of_the_immovable_property != null then v.the_annual_rent_payable_by_the_tenant_in_respect_of_the_immovable_property else if v.the_monthly_rent_payable_by_the_tenant_in_respect_of_the_immovable_property != null then 12 * v.the_monthly_rent_payable_by_the_tenant_in_respect_of_the_immovable_property else null</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_value_of_residential_property" name="the_value_of_residential_property" label="the value of residential property">
    <description>REFUSE: no annual value, rent or last transacted price is given, so the value of the residential property cannot be determined under section 6(4)</description>
    <variable id="decision_the_value_of_residential_property_var" name="the_value_of_residential_property" label="the value of residential property" typeRef="number"/>
    <informationRequirement id="decision_the_value_of_residential_property_ir1">
      <requiredDecision href="#decision_the_annual_rent_or_12_times_the_monthly_rent"/>
    </informationRequirement>
    <informationRequirement id="decision_the_value_of_residential_property_ir2">
      <requiredInput href="#input_v_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_value_of_residential_property_literal">
      <text>if v_2.the_annual_value_of_the_immovable_property_appearing_in_the_Valuation_List_prepared_under_section_10_of_the_Property_Tax_Act_1960 != null then if the_annual_rent_or_12_times_the_monthly_rent != null then min(the_annual_rent_or_12_times_the_monthly_rent, v_2.the_annual_value_of_the_immovable_property_appearing_in_the_Valuation_List_prepared_under_section_10_of_the_Property_Tax_Act_1960) else v_2.the_annual_value_of_the_immovable_property_appearing_in_the_Valuation_List_prepared_under_section_10_of_the_Property_Tax_Act_1960 else if the_annual_rent_or_12_times_the_monthly_rent != null then the_annual_rent_or_12_times_the_monthly_rent else if v_2.the_last_transacted_price != null then v_2.the_last_transacted_price / 10 else null</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_amount_of_the_claim_exceeds_the_prescribed_limit" name="the_amount_of_the_claim_exceeds_the_prescribed_limit" label="the amount of the claim exceeds the prescribed limit">
    <variable id="decision_the_amount_of_the_claim_exceeds_the_prescribed_limit_var" name="the_amount_of_the_claim_exceeds_the_prescribed_limit" label="the amount of the claim exceeds the prescribed limit" typeRef="boolean"/>
    <informationRequirement id="decision_the_amount_of_the_claim_exceeds_the_prescribed_limit_ir1">
      <requiredDecision href="#decision_the_prescribed_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_amount_of_the_claim_exceeds_the_prescribed_limit_ir2">
      <requiredInput href="#input_a_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_amount_of_the_claim_exceeds_the_prescribed_limit_literal">
      <text>a_2.the_amount_of_the_claim &gt; the_prescribed_limit and (not(a_2.the_amount_claimed_is_a_balance_after_a_set_off_admitted_by_the_consumer_in_the_particulars_of_the_claim and a_2.the_balance_after_that_set_off &lt;= the_prescribed_limit) and not(a_2.the_consumer_has_abandoned_the_excess_over_the_prescribed_limit))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit" name="the_value_of_the_subject_matter_exceeds_the_prescribed_limit" label="the value of the subject matter exceeds the prescribed limit">
    <variable id="decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit_var" name="the_value_of_the_subject_matter_exceeds_the_prescribed_limit" label="the value of the subject matter exceeds the prescribed limit" typeRef="boolean"/>
    <informationRequirement id="decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit_ir1">
      <requiredDecision href="#decision_the_prescribed_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit_ir2">
      <requiredDecision href="#decision_the_value_of_residential_property"/>
    </informationRequirement>
    <informationRequirement id="decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit_ir3">
      <requiredInput href="#input_a_3"/>
    </informationRequirement>
    <literalExpression id="decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit_literal">
      <text>(IF (a's `the subject matter is residential property`) THEN (`the value of residential property` OF (a's `the valuation facts of the residential property`)) ELSE (a's `the value of the subject matter, where it is not residential property`)) GREATER THAN (`the prescribed limit` OF a)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply" name="the_right_to_commence_an_action_under_section_6_1_does_not_apply" label="the right to commence an action under section 6(1) does not apply">
    <variable id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_var" name="the_right_to_commence_an_action_under_section_6_1_does_not_apply" label="the right to commence an action under section 6(1) does not apply" typeRef="boolean"/>
    <informationRequirement id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_ir1">
      <requiredDecision href="#decision_the_amount_of_the_claim_exceeds_the_prescribed_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_ir2">
      <requiredDecision href="#decision_the_value_of_the_subject_matter_exceeds_the_prescribed_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_ir3">
      <requiredInput href="#input_a_4"/>
    </informationRequirement>
    <decisionTable id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the right to commence an action under section 6(1) does not apply">
      <input id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_i1" label="a&apos;s `the claim is a claim for money`">
        <inputExpression id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_i1_expr" typeRef="boolean">
          <text>a_4.the_claim_is_a_claim_for_money</text>
        </inputExpression>
      </input>
      <output id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_o1">
        <defaultOutputEntry id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_o1_default">
          <text>`the value of the subject matter exceeds the prescribed limit` OF a</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_r1">
        <description>a's `the claim is a claim for money`</description>
        <inputEntry id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_r1_i1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply_r1_o1">
          <text>the_amount_of_the_claim_exceeds_the_prescribed_limit</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_consumer_may_commence_an_action_under_section_6_1" name="the_consumer_may_commence_an_action_under_section_6_1" label="the consumer may commence an action under section 6(1)">
    <variable id="decision_the_consumer_may_commence_an_action_under_section_6_1_var" name="the_consumer_may_commence_an_action_under_section_6_1" label="the consumer may commence an action under section 6(1)" typeRef="boolean"/>
    <informationRequirement id="decision_the_consumer_may_commence_an_action_under_section_6_1_ir1">
      <requiredDecision href="#decision_the_right_to_commence_an_action_under_section_6_1_does_not_apply"/>
    </informationRequirement>
    <informationRequirement id="decision_the_consumer_may_commence_an_action_under_section_6_1_ir2">
      <requiredInput href="#input_a_5"/>
    </informationRequirement>
    <literalExpression id="decision_the_consumer_may_commence_an_action_under_section_6_1_literal">
      <text>a's `the consumer has entered a consumer transaction involving an unfair practice` AND a's `the action is commenced in a court of competent jurisdiction against the supplier` AND (NOT (`the right to commence an action under section 6(1) does not apply` OF a))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_most_that_the_consumer_may_recover_in_the_action" name="the_most_that_the_consumer_may_recover_in_the_action" label="the most that the consumer may recover in the action">
    <variable id="decision_the_most_that_the_consumer_may_recover_in_the_action_var" name="the_most_that_the_consumer_may_recover_in_the_action" label="the most that the consumer may recover in the action" typeRef="number"/>
    <informationRequirement id="decision_the_most_that_the_consumer_may_recover_in_the_action_ir1">
      <requiredDecision href="#decision_the_prescribed_limit"/>
    </informationRequirement>
    <informationRequirement id="decision_the_most_that_the_consumer_may_recover_in_the_action_ir2">
      <requiredInput href="#input_a_6"/>
    </informationRequirement>
    <decisionTable id="decision_the_most_that_the_consumer_may_recover_in_the_action_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the most that the consumer may recover in the action">
      <input id="decision_the_most_that_the_consumer_may_recover_in_the_action_i1" label="a&apos;s `the consumer has abandoned the excess over the prescribed limit`">
        <inputExpression id="decision_the_most_that_the_consumer_may_recover_in_the_action_i1_expr" typeRef="boolean">
          <text>a_6.the_consumer_has_abandoned_the_excess_over_the_prescribed_limit</text>
        </inputExpression>
      </input>
      <output id="decision_the_most_that_the_consumer_may_recover_in_the_action_o1">
        <defaultOutputEntry id="decision_the_most_that_the_consumer_may_recover_in_the_action_o1_default">
          <text>a_6.the_amount_of_the_claim</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_the_most_that_the_consumer_may_recover_in_the_action_r1">
        <description>a's `the consumer has abandoned the excess over the prescribed limit`</description>
        <inputEntry id="decision_the_most_that_the_consumer_may_recover_in_the_action_r1_i1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_the_most_that_the_consumer_may_recover_in_the_action_r1_o1">
          <text>the_prescribed_limit</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_a_party_may_apply_to_stay_the_proceedings" name="a_party_may_apply_to_stay_the_proceedings" label="a party may apply to stay the proceedings">
    <variable id="decision_a_party_may_apply_to_stay_the_proceedings_var" name="a_party_may_apply_to_stay_the_proceedings" label="a party may apply to stay the proceedings" typeRef="boolean"/>
    <informationRequirement id="decision_a_party_may_apply_to_stay_the_proceedings_ir1">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_a_party_may_apply_to_stay_the_proceedings_literal">
      <text>s.an_application_has_been_made_under_section_9_against_the_same_supplier and s.the_proceedings_relate_to_the_unfair_practice_to_which_the_application_relates</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_stay_the_proceedings" name="the_court_may_stay_the_proceedings" label="the court may stay the proceedings">
    <variable id="decision_the_court_may_stay_the_proceedings_var" name="the_court_may_stay_the_proceedings" label="the court may stay the proceedings" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_stay_the_proceedings_ir1">
      <requiredDecision href="#decision_a_party_may_apply_to_stay_the_proceedings"/>
    </informationRequirement>
    <informationRequirement id="decision_the_court_may_stay_the_proceedings_ir2">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_stay_the_proceedings_literal">
      <text>s.a_party_to_the_action_applies_for_a_stay and (a_party_may_apply_to_stay_the_proceedings and s.the_court_is_satisfied_that_the_determination_of_the_application_under_section_9_will_be_material_to_the_action)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_date_from_which_the_two_years_run" name="the_date_from_which_the_two_years_run" label="the date from which the two years run">
    <variable id="decision_the_date_from_which_the_two_years_run_var" name="the_date_from_which_the_two_years_run" label="the date from which the two years run" typeRef="date"/>
    <informationRequirement id="decision_the_date_from_which_the_two_years_run_ir1">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_the_date_from_which_the_two_years_run_literal">
      <text>if s.the_date_of_the_last_further_step_taken_by_any_party_after_the_stay_order != null then max(s.the_date_of_the_last_further_step_taken_by_any_party_after_the_stay_order, s.the_stay_order_was_made_on) else s.the_stay_order_was_made_on</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings" name="the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings" label="the court may of its own motion discontinue the stayed proceedings">
    <variable id="decision_the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings_var" name="the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings" label="the court may of its own motion discontinue the stayed proceedings" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings_ir1">
      <requiredDecision href="#decision_the_date_from_which_the_two_years_run"/>
    </informationRequirement>
    <informationRequirement id="decision_the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings_ir2">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_of_its_own_motion_discontinue_the_stayed_proceedings_literal">
      <text>s.the_date_on_which_the_court_considers_discontinuing_the_proceedings &gt;= the_date_from_which_the_two_years_run + duration("P24M")</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_contract_is_a_relevant_contract" name="the_contract_is_a_relevant_contract" label="the contract is a relevant contract">
    <variable id="decision_the_contract_is_a_relevant_contract_var" name="the_contract_is_a_relevant_contract" label="the contract is a relevant contract" typeRef="boolean"/>
    <informationRequirement id="decision_the_contract_is_a_relevant_contract_ir1">
      <requiredInput href="#input_t"/>
    </informationRequirement>
    <literalExpression id="decision_the_contract_is_a_relevant_contract_literal">
      <text>t.the_contract_is_a_contract_mentioned_in_paragraph_1_a_or_c_of_the_Schedule_to_the_Small_Claims_Tribunals_Act_1984 and not(t.the_contract_relates_to_the_sale_of_immovable_property)</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_small_claims_tribunal_has_jurisdiction" name="a_Small_Claims_Tribunal_has_jurisdiction" label="a Small Claims Tribunal has jurisdiction">
    <variable id="decision_a_small_claims_tribunal_has_jurisdiction_var" name="a_Small_Claims_Tribunal_has_jurisdiction" label="a Small Claims Tribunal has jurisdiction" typeRef="boolean"/>
    <informationRequirement id="decision_a_small_claims_tribunal_has_jurisdiction_ir1">
      <requiredDecision href="#decision_the_contract_is_a_relevant_contract"/>
    </informationRequirement>
    <informationRequirement id="decision_a_small_claims_tribunal_has_jurisdiction_ir2">
      <requiredInput href="#input_t"/>
    </informationRequirement>
    <decisionTable id="decision_a_small_claims_tribunal_has_jurisdiction_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="a Small Claims Tribunal has jurisdiction">
      <input id="decision_a_small_claims_tribunal_has_jurisdiction_i1" label="t&apos;s `kind of action`">
        <inputExpression id="decision_a_small_claims_tribunal_has_jurisdiction_i1_expr" typeRef="string">
          <text>t.kind_of_action</text>
        </inputExpression>
      </input>
      <output id="decision_a_small_claims_tribunal_has_jurisdiction_o1"/>
      <rule id="decision_a_small_claims_tribunal_has_jurisdiction_r1">
        <description>(t's `kind of action`) EQUALS `an action under section 6(1)`</description>
        <inputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r1_i1">
          <text>"an action under section 6(1)"</text>
        </inputEntry>
        <outputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r1_o1">
          <text>t.the_action_relates_to_an_unfair_practice_or_an_undertaking_in_respect_of_an_unfair_practice and the_contract_is_a_relevant_contract</text>
        </outputEntry>
      </rule>
      <rule id="decision_a_small_claims_tribunal_has_jurisdiction_r2">
        <description>(t's `kind of action`) EQUALS `an action under section 8(6), (7) or (8)`</description>
        <inputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r2_i1">
          <text>"an action under section 8(6), (7) or (8)"</text>
        </inputEntry>
        <outputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r2_o1">
          <text>t.the_action_relates_to_an_unfair_practice_or_an_undertaking_in_respect_of_an_unfair_practice and the_contract_is_a_relevant_contract</text>
        </outputEntry>
      </rule>
      <rule id="decision_a_small_claims_tribunal_has_jurisdiction_r3">
        <description>(t's `kind of action`) EQUALS `an action under regulations made under section 11`</description>
        <inputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r3_i1">
          <text>"an action under regulations made under section 11"</text>
        </inputEntry>
        <outputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r3_o1">
          <text>the_contract_is_a_relevant_contract or t.the_action_relates_to_a_time_share_contract_or_a_time_share_related_contract</text>
        </outputEntry>
      </rule>
      <rule id="decision_a_small_claims_tribunal_has_jurisdiction_r4">
        <description>(t's `kind of action`) EQUALS `an action under provisions specified under section 43(2)(j)`</description>
        <inputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r4_i1">
          <text>"an action under provisions specified under section 43(2)(j)"</text>
        </inputEntry>
        <outputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r4_o1">
          <text>the_contract_is_a_relevant_contract</text>
        </outputEntry>
      </rule>
      <rule id="decision_a_small_claims_tribunal_has_jurisdiction_r5">
        <description>(t's `kind of action`) EQUALS `an action relating to a deposit paid in relation to or in contemplation of a motor vehicle sale contract`</description>
        <inputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r5_i1">
          <text>"an action relating to a deposit paid in relation to or in contemplation of a motor vehicle sale contract"</text>
        </inputEntry>
        <outputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r5_o1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="decision_a_small_claims_tribunal_has_jurisdiction_r6">
        <description>(t's `kind of action`) EQUALS `any other action`</description>
        <inputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r6_i1">
          <text>"any other action"</text>
        </inputEntry>
        <outputEntry id="decision_a_small_claims_tribunal_has_jurisdiction_r6_o1">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits" name="the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits" label="the action is deemed a claim founded on contract for the court limits">
    <variable id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_var" name="the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits" label="the action is deemed a claim founded on contract for the court limits" typeRef="boolean"/>
    <informationRequirement id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_ir1">
      <requiredInput href="#input_k"/>
    </informationRequirement>
    <decisionTable id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the action is deemed a claim founded on contract for the court limits">
      <input id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_i1" label="k">
        <inputExpression id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_i1_expr" typeRef="string">
          <text>k</text>
        </inputExpression>
      </input>
      <output id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_o1">
        <defaultOutputEntry id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_o1_default">
          <text>false</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_r1">
        <description>k EQUALS `an action under section 6(1)`</description>
        <inputEntry id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_r1_i1">
          <text>"an action under section 6(1)"</text>
        </inputEntry>
        <outputEntry id="decision_the_action_is_deemed_a_claim_founded_on_contract_for_the_court_limits_r1_o1">
          <text>true</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_goods_or_services_are_intended_for_business_use" name="the_goods_or_services_are_intended_for_business_use" label="the goods or services are intended for business use">
    <variable id="decision_the_goods_or_services_are_intended_for_business_use_var" name="the_goods_or_services_are_intended_for_business_use" label="the goods or services are intended for business use" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_or_services_are_intended_for_business_use_ir1">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_or_services_are_intended_for_business_use_literal">
      <text>r.the_consumer_intends_to_resell_the_goods_or_services_in_the_course_of_the_consumer_s_business or (r.the_consumer_intends_to_use_up_or_transform_the_goods_in_the_course_of_the_consumer_s_business_in_a_process_of_production_or_manufacturing_or_in_repairing_or_treating_other_goods_or_fixtures or r.the_goods_or_services_are_otherwise_intended_for_business_use)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted" name="the_share_of_the_goods_or_services_for_which_relief_may_be_granted" label="the share of the goods or services for which relief may be granted">
    <variable id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_var" name="the_share_of_the_goods_or_services_for_which_relief_may_be_granted" label="the share of the goods or services for which relief may be granted" typeRef="number"/>
    <informationRequirement id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_ir1">
      <requiredDecision href="#decision_the_goods_or_services_are_intended_for_business_use"/>
    </informationRequirement>
    <informationRequirement id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_ir2">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <decisionTable id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the share of the goods or services for which relief may be granted">
      <input id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_i1" label="`the goods or services are intended for business use` OF r">
        <inputExpression id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_i1_expr" typeRef="boolean">
          <text>the_goods_or_services_are_intended_for_business_use</text>
        </inputExpression>
      </input>
      <input id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_i2" label="r&apos;s `the action is an action under section 6(1)`">
        <inputExpression id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_i2_expr" typeRef="boolean">
          <text>r.the_action_is_an_action_under_section_6_1</text>
        </inputExpression>
      </input>
      <output id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_o1">
        <defaultOutputEntry id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_o1_default">
          <text>1</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_r1">
        <description>(`the goods or services are intended for business use` OF r) AND r's `the action is an action under section 6(1)`</description>
        <inputEntry id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_r1_i1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_r1_i2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted_r1_o1">
          <text>if r.the_share_of_the_goods_or_services_attributed_by_the_court_to_non_business_use_where_it_has_apportioned_the_use != null then r.the_share_of_the_goods_or_services_attributed_by_the_court_to_non_business_use_where_it_has_apportioned_the_use else 0</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_court_may_grant_relief_under_section_7_5" name="the_court_may_grant_relief_under_section_7_5" label="the court may grant relief under section 7(5)">
    <variable id="decision_the_court_may_grant_relief_under_section_7_5_var" name="the_court_may_grant_relief_under_section_7_5" label="the court may grant relief under section 7(5)" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_grant_relief_under_section_7_5_ir1">
      <requiredDecision href="#decision_the_share_of_the_goods_or_services_for_which_relief_may_be_granted"/>
    </informationRequirement>
    <informationRequirement id="decision_the_court_may_grant_relief_under_section_7_5_ir2">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_grant_relief_under_section_7_5_literal">
      <text>not(r.the_court_is_a_Small_Claims_Tribunal) and (r.the_court_finds_that_the_supplier_has_engaged_in_an_unfair_practice and the_share_of_the_goods_or_services_for_which_relief_may_be_granted &gt; 0)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_reliefs_the_court_may_grant_under_section_7_5" name="the_reliefs_the_court_may_grant_under_section_7_5" label="the reliefs the court may grant under section 7(5)">
    <variable id="decision_the_reliefs_the_court_may_grant_under_section_7_5_var" name="the_reliefs_the_court_may_grant_under_section_7_5" label="the reliefs the court may grant under section 7(5)" typeRef="Any"/>
    <informationRequirement id="decision_the_reliefs_the_court_may_grant_under_section_7_5_ir1">
      <requiredDecision href="#decision_the_court_may_grant_relief_under_section_7_5"/>
    </informationRequirement>
    <informationRequirement id="decision_the_reliefs_the_court_may_grant_under_section_7_5_ir2">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <decisionTable id="decision_the_reliefs_the_court_may_grant_under_section_7_5_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the reliefs the court may grant under section 7(5)">
      <input id="decision_the_reliefs_the_court_may_grant_under_section_7_5_i1" label="`the court may grant relief under section 7(5)` OF r">
        <inputExpression id="decision_the_reliefs_the_court_may_grant_under_section_7_5_i1_expr" typeRef="boolean">
          <text>the_court_may_grant_relief_under_section_7_5</text>
        </inputExpression>
      </input>
      <output id="decision_the_reliefs_the_court_may_grant_under_section_7_5_o1">
        <defaultOutputEntry id="decision_the_reliefs_the_court_may_grant_under_section_7_5_o1_default">
          <text>"EMPTY"</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_the_reliefs_the_court_may_grant_under_section_7_5_r1">
        <description>`the court may grant relief under section 7(5)` OF r</description>
        <inputEntry id="decision_the_reliefs_the_court_may_grant_under_section_7_5_r1_i1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_the_reliefs_the_court_may_grant_under_section_7_5_r1_o1">
          <text>["restitution of money, property or other consideration given or furnished by the consumer", "damages in the amount of any loss or damage suffered by the consumer", "specific performance against the supplier", "an order to repair goods or provide parts for goods", "an order varying the contract between the supplier and the consumer"]</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_court_must_have_regard_to_the_consumer_s_efforts_to_minimise_loss_and_to_resolve_the_dispute" name="the_court_must_have_regard_to_the_consumer_s_efforts_to_minimise_loss_and_to_resolve_the_dispute" label="the court must have regard to the consumer&apos;s efforts to minimise loss and to resolve the dispute">
