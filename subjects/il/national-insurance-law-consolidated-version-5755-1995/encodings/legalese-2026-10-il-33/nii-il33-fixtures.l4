@lang en
IMPORT prelude
IMPORT daydate
IMPORT `nii-il33-nouns`

-- Builders for the tests of row IL-33. Rules in none of them: they only build records from a few
-- named facts and give every other field the value "no such fact". No assertion is in this module.

§ `Fixtures`

§§ `Residence`

-- A person who lives in Israel, stays under no permission section 2A names, is not absent, and became an
-- Israeli resident on the day given.
GIVEN first IS A DATE
GIVETH A `The residence facts of a person`
`a resident since` first MEANS
    `The residence facts of a person` WITH
        `lives in Israel`                                                                  IS TRUE
        `permission to stay`                                                               IS `no permission that section 2A names`
        `absent from Israel beyond a reasonable temporary absence`                        IS FALSE
        `the day the person first became an Israeli resident`                             IS JUST first
        `a temporary resident`                                                             IS FALSE

-- A resident since the day given, whom the Institute holds to be a temporary resident (s 158(1)).
GIVEN first IS A DATE
GIVETH A `The residence facts of a person`
`a temporary resident since` first MEANS
    `The residence facts of a person` WITH
        `lives in Israel`                                                                  IS TRUE
        `permission to stay`                                                               IS `no permission that section 2A names`
        `absent from Israel beyond a reasonable temporary absence`                        IS FALSE
        `the day the person first became an Israeli resident`                             IS JUST first
        `a temporary resident`                                                             IS TRUE

-- A person who lives in Israel under the permission given.
GIVEN permission IS A `The permission under which a person stays in Israel`
GIVETH A `The residence facts of a person`
`a person living in Israel under` permission MEANS
    `The residence facts of a person` WITH
        `lives in Israel`                                                                  IS TRUE
        `permission to stay`                                                               IS permission
        `absent from Israel beyond a reasonable temporary absence`                        IS FALSE
        `the day the person first became an Israeli resident`                             IS NOTHING
        `a temporary resident`                                                             IS FALSE

-- A person who does not live in Israel.
GIVETH A `The residence facts of a person`
`a person living abroad` MEANS
    `The residence facts of a person` WITH
        `lives in Israel`                                                                  IS FALSE
        `permission to stay`                                                               IS `no permission that section 2A names`
        `absent from Israel beyond a reasonable temporary absence`                        IS FALSE
        `the day the person first became an Israeli resident`                             IS NOTHING
        `a temporary resident`                                                             IS FALSE

§§ `Work`

GIVETH A `The work facts of a person`
`the work of an employee in Israel` MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS TRUE
        `a self-employed person`                                                                     IS FALSE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS FALSE
        `the employer is an Israeli resident`                                                        IS TRUE
        `the contract of employment was made in Israel`                                              IS TRUE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS TRUE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS FALSE

GIVETH A `The work facts of a person`
`the work of a person who does not work` MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS FALSE
        `a self-employed person`                                                                     IS FALSE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS FALSE
        `the employer is an Israeli resident`                                                        IS FALSE
        `the contract of employment was made in Israel`                                              IS FALSE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS FALSE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS FALSE

GIVETH A `The work facts of a person`
`the work of a self-employed person in Israel` MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS FALSE
        `a self-employed person`                                                                     IS TRUE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS FALSE
        `the employer is an Israeli resident`                                                        IS FALSE
        `the contract of employment was made in Israel`                                              IS FALSE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS FALSE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS FALSE

-- An employee working outside Israel, with the facts of s 76(a) and (b) given.
GIVEN `employer resident` IS A BOOLEAN
      `contract made in Israel` IS A BOOLEAN
      `no compulsory insurance` IS A BOOLEAN
      notice IS A BOOLEAN
      `over five years` IS A BOOLEAN
      permitted IS A BOOLEAN
GIVETH A `The work facts of a person`
`the work of an employee abroad, employer resident` `employer resident` `, contract made in Israel` `contract made in Israel` `, no compulsory insurance` `no compulsory insurance` `, notice given` notice `, over five years` `over five years` `, permitted` permitted MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS TRUE
        `a self-employed person`                                                                     IS FALSE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS TRUE
        `the employer is an Israeli resident`                                                        IS `employer resident`
        `the contract of employment was made in Israel`                                              IS `contract made in Israel`
        `no compulsory work injury insurance applies at the place of work`                           IS `no compulsory insurance`
        `notice of the contract of employment was given as the regulations prescribe`               IS notice
        `has stayed abroad for more than five consecutive years`                                     IS `over five years`
        `the Minister or his delegate permitted the insurance after the five years`                  IS permitted
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS TRUE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS FALSE

-- The work of an employee with the flags a test varies: controlling shareholder, kibbutz member, entitled
-- to wages, police-type employee, insured earlier.
GIVEN controlling IS A BOOLEAN
      kibbutz IS A BOOLEAN
      `entitled to wages` IS A BOOLEAN
      `police type` IS A BOOLEAN
      earlier IS A BOOLEAN
GIVETH A `The work facts of a person`
`the work of an employee in Israel, controlling` controlling `, kibbutz member` kibbutz `, entitled to wages` `entitled to wages` `, police type` `police type` `, insured earlier` earlier MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS TRUE
        `a self-employed person`                                                                     IS FALSE
        `a police officer, a prison officer or a security-service employee`                          IS `police type`
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS FALSE
        `the employer is an Israeli resident`                                                        IS TRUE
        `the contract of employment was made in Israel`                                              IS TRUE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS controlling
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS kibbutz
        `entitled to wages on which the employer must pay insurance contributions`                   IS `entitled to wages`
        `was insured as an employee under Chapter 5 at some earlier time`                            IS earlier

-- A person who does not work, with a further category of s 75(a)(3) to (8).
GIVEN category IS A `A further category insured under section 75(a)`
GIVETH A `The work facts of a person`
`the work of a person in the further category` category MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS FALSE
        `a self-employed person`                                                                     IS FALSE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS LIST category
        `works outside Israel`                                                                       IS FALSE
        `the employer is an Israeli resident`                                                        IS FALSE
        `the contract of employment was made in Israel`                                              IS FALSE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS FALSE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS FALSE

-- A self-employed person, abroad or in Israel, of a class the regulations exclude or not.
GIVEN abroad IS A BOOLEAN
      excluded IS A BOOLEAN
GIVETH A `The work facts of a person`
`the work of a self-employed person, abroad` abroad `, of an excluded class` excluded MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS FALSE
        `a self-employed person`                                                                     IS TRUE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS excluded
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS abroad
        `the employer is an Israeli resident`                                                        IS FALSE
        `the contract of employment was made in Israel`                                              IS FALSE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS FALSE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS FALSE

§§ `The person`

GIVETH A `The absorption facts of a person`
`no absorption facts` MEANS
    `The absorption facts of a person` WITH
        `immigrated under the Law of Return`                                                    IS FALSE
        `holds a permanent-residence visa and licence, or an A/5 temporary visa and licence`   IS FALSE
        `was given an absorption basket by the Ministry of Aliyah and Integration`             IS FALSE

GIVETH A `The Chapter 11 facts of a person`
`no Chapter 11 facts` MEANS
    `The Chapter 11 facts of a person` WITH
        `of a class the Minister has excluded from insurance under section 243`                 IS FALSE
        `insured at the person's own request under the regulations under section 243`           IS FALSE
        `has completed the qualifying period of section 246(a) as an insured employee`          IS FALSE

-- A person with the residence and work given, and no service, absorption or Chapter 11 facts.
GIVEN n IS A STRING
      dob IS A DATE
      sex IS A `Sex`
      residence IS A `The residence facts of a person`
      work IS A `The work facts of a person`
GIVETH A `A person for the statuses of the Law`
`a person` n `born` dob `who is` sex `with` residence `and` work MEANS
    `A person for the statuses of the Law` WITH
        `name`                                IS n
        `date of birth`                       IS dob
        `sex`                                 IS sex
        `residence`                           IS residence
        `work`                                IS work
        `released from regular service`       IS NOTHING
        `completed national or community service` IS NOTHING
        `absorption`                          IS `no absorption facts`
        `Chapter 11`                          IS `no Chapter 11 facts`

-- The common case: a resident employee of the sex and birth date given, resident since birth.
GIVEN n IS A STRING
      dob IS A DATE
      sex IS A `Sex`
GIVETH A `A person for the statuses of the Law`
`an Israeli employee` n `born` dob `who is` sex MEANS
    `a person` n `born` dob `who is` sex `with` (`a resident since` dob) `and` `the work of an employee in Israel`

§§ `Visas`

-- An A/1 temporary-residence visa and licence granted on the day given, the holder having lived lawfully in
-- Israel the number of days given in the determining year, and the Institute's s 2A(d) decision as given.
GIVEN granted IS A DATE
      lawful  IS A NUMBER
      decided IS A BOOLEAN
GIVETH A `The permission under which a person stays in Israel`
`an A/1 visa granted on` granted `with` lawful `days, section 2A(d) decision:` decided MEANS
    `a temporary-residence visa and licence of type A/1, under regulation 6(a) of the Entry Regulations` granted lawful decided

-- Another visa and licence (s 2A(c)).
GIVEN granted IS A DATE
      lawful  IS A NUMBER
GIVETH A `The permission under which a person stays in Israel`
`another visa granted on` granted `with` lawful `days` MEANS
    `another visa and licence for residence under the Entry to Israel Law, held by a person who is not an Israeli citizen, which section 2A(c) reaches` granted lawful

-- A man born 1 January 1990, working in Israel as an employee, living in Israel under the permission given.
GIVEN permission IS A `The permission under which a person stays in Israel`
GIVETH A `A person for the statuses of the Law`
`a man living in Israel under` permission MEANS
    `a person` "Man" `born` (YMD 1990 1 1) `who is` `male` `with` (`a person living in Israel under` permission) `and` `the work of an employee in Israel`

§§ `Setters`

-- A person with one field changed (a record cannot be updated in place; each setter rebuilds it).

GIVEN p IS A `A person for the statuses of the Law`
      x IS A `The residence facts of a person`
GIVETH A `A person for the statuses of the Law`
p `with the residence` x MEANS
    `A person for the statuses of the Law` WITH
        `name` IS p's `name`
        `date of birth` IS p's `date of birth`
        `sex` IS p's `sex`
        `residence` IS x
        `work` IS p's `work`
        `released from regular service` IS p's `released from regular service`
        `completed national or community service` IS p's `completed national or community service`
        `absorption` IS p's `absorption`
        `Chapter 11` IS p's `Chapter 11`

GIVEN p IS A `A person for the statuses of the Law`
      x IS A `The work facts of a person`
GIVETH A `A person for the statuses of the Law`
p `with the work` x MEANS
    `A person for the statuses of the Law` WITH
        `name` IS p's `name`
        `date of birth` IS p's `date of birth`
        `sex` IS p's `sex`
        `residence` IS p's `residence`
        `work` IS x
        `released from regular service` IS p's `released from regular service`
        `completed national or community service` IS p's `completed national or community service`
        `absorption` IS p's `absorption`
        `Chapter 11` IS p's `Chapter 11`

GIVEN p IS A `A person for the statuses of the Law`
      x IS A DATE
GIVETH A `A person for the statuses of the Law`
p `released from regular service on` x MEANS
    `A person for the statuses of the Law` WITH
        `name` IS p's `name`
        `date of birth` IS p's `date of birth`
        `sex` IS p's `sex`
        `residence` IS p's `residence`
        `work` IS p's `work`
        `released from regular service` IS JUST x
        `completed national or community service` IS p's `completed national or community service`
        `absorption` IS p's `absorption`
        `Chapter 11` IS p's `Chapter 11`

GIVEN p IS A `A person for the statuses of the Law`
      x IS A `A completed service`
GIVETH A `A person for the statuses of the Law`
p `with the completed service` x MEANS
    `A person for the statuses of the Law` WITH
        `name` IS p's `name`
        `date of birth` IS p's `date of birth`
        `sex` IS p's `sex`
        `residence` IS p's `residence`
        `work` IS p's `work`
        `released from regular service` IS p's `released from regular service`
        `completed national or community service` IS JUST x
        `absorption` IS p's `absorption`
        `Chapter 11` IS p's `Chapter 11`

GIVEN p IS A `A person for the statuses of the Law`
      x IS A `The absorption facts of a person`
GIVETH A `A person for the statuses of the Law`
p `with the absorption facts` x MEANS
    `A person for the statuses of the Law` WITH
        `name` IS p's `name`
        `date of birth` IS p's `date of birth`
        `sex` IS p's `sex`
        `residence` IS p's `residence`
        `work` IS p's `work`
        `released from regular service` IS p's `released from regular service`
        `completed national or community service` IS p's `completed national or community service`
        `absorption` IS x
        `Chapter 11` IS p's `Chapter 11`

GIVEN p IS A `A person for the statuses of the Law`
      x IS A `The Chapter 11 facts of a person`
GIVETH A `A person for the statuses of the Law`
p `with the Chapter 11 facts` x MEANS
    `A person for the statuses of the Law` WITH
        `name` IS p's `name`
        `date of birth` IS p's `date of birth`
        `sex` IS p's `sex`
        `residence` IS p's `residence`
        `work` IS p's `work`
        `released from regular service` IS p's `released from regular service`
        `completed national or community service` IS p's `completed national or community service`
        `absorption` IS p's `absorption`
        `Chapter 11` IS x


-- Records the tests use.
GIVEN m IS A NUMBER
      end IS A DATE
      civil IS A BOOLEAN
      before IS A BOOLEAN
      married IS A BOOLEAN
GIVETH A `A completed service`
`a service of` m `months ended` end `, civil-national:` civil `, began before 31 August 2026:` before `, woman married within 30 days:` married MEANS
    `A completed service` WITH
        `the day the service ended`                                                                  IS end
        `the months served`                                                                          IS m
        `civil-national service`                                                                     IS civil
        `the service began before 31 August 2026`                                                    IS before
        `a woman who served at least six months and married within 30 days of the day she stopped` IS married

GIVEN immigrated IS A BOOLEAN
      visa      IS A BOOLEAN
      basket    IS A BOOLEAN
GIVETH A `The absorption facts of a person`
`absorption facts: immigrant` immigrated `, visa holder` visa `, basket` basket MEANS
    `The absorption facts of a person` WITH
        `immigrated under the Law of Return`                                                    IS immigrated
        `holds a permanent-residence visa and licence, or an A/5 temporary visa and licence`   IS visa
        `was given an absorption basket by the Ministry of Aliyah and Integration`             IS basket

GIVEN excluded IS A BOOLEAN
      request  IS A BOOLEAN
GIVETH A `The Chapter 11 facts of a person`
`Chapter 11 facts: class excluded` excluded `, own request` request MEANS
    `The Chapter 11 facts of a person` WITH
        `of a class the Minister has excluded from insurance under section 243`                 IS excluded
        `insured at the person's own request under the regulations under section 243`           IS request
        `has completed the qualifying period of section 246(a) as an insured employee`          IS FALSE

GIVETH A `The work facts of a person`
`the work of a former employee` MEANS
    `The work facts of a person` WITH
        `an employee`                                                                                IS FALSE
        `a self-employed person`                                                                     IS FALSE
        `a police officer, a prison officer or a security-service employee`                          IS FALSE
        `of a class of self-employed persons the regulations exclude`                                IS FALSE
        `further categories insured under section 75(a)`                                             IS EMPTY
        `works outside Israel`                                                                       IS FALSE
        `the employer is an Israeli resident`                                                        IS FALSE
        `the contract of employment was made in Israel`                                              IS FALSE
        `no compulsory work injury insurance applies at the place of work`                           IS FALSE
        `notice of the contract of employment was given as the regulations prescribe`               IS FALSE
        `has stayed abroad for more than five consecutive years`                                     IS FALSE
        `the Minister or his delegate permitted the insurance after the five years`                  IS FALSE
        `a controlling shareholder in a closely-held company`                                        IS FALSE
        `a member of a collective or renewed kibbutz regarded as a worker under section 3 or 3A(a)` IS FALSE
        `entitled to wages on which the employer must pay insurance contributions`                   IS FALSE
        `was insured as an employee under Chapter 5 at some earlier time`                            IS TRUE
