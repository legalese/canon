    `is itself a registered qualified individual` IS FALSE
    `a partner is a registered qualified individual` IS FALSE
    `employs a registered qualified individual` IS TRUE
    `a key appointment holder is not fit and proper` IS FALSE
    `the applicant completed the prescribed course` IS FALSE
    `every key appointment holder completed the prescribed course` IS TRUE
