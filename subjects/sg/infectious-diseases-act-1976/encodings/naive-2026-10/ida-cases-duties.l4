IMPORT prelude
IMPORT `ida-duties`

-- Infectious Diseases Act 1976, ss 6, 15, 21A, 23 to 25, 46, 65 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_ida.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a person who knows and told the partner who accepted` MEANS Encounter WITH
    `knows they have HIV` IS TRUE
    `has reason to believe they may have HIV` IS FALSE
    `informed and the partner accepted the risk` IS TRUE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS FALSE

`a person who knows and did not tell` MEANS Encounter WITH
    `knows they have HIV` IS TRUE
    `has reason to believe they may have HIV` IS FALSE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS FALSE

`a person who knows with a sustained undetectable load` MEANS Encounter WITH
    `knows they have HIV` IS TRUE
    `has reason to believe they may have HIV` IS FALSE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS TRUE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS FALSE

`a person who knows and only took precautions` MEANS Encounter WITH
    `knows they have HIV` IS TRUE
    `has reason to believe they may have HIV` IS FALSE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS TRUE

`a person who suspects and took precautions` MEANS Encounter WITH
    `knows they have HIV` IS FALSE
    `has reason to believe they may have HIV` IS TRUE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS TRUE

`a person who suspects and tested negative` MEANS Encounter WITH
    `knows they have HIV` IS FALSE
    `has reason to believe they may have HIV` IS TRUE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS TRUE
    `took reasonable precautions` IS FALSE

`a person who suspects and did nothing` MEANS Encounter WITH
    `knows they have HIV` IS FALSE
    `has reason to believe they may have HIV` IS TRUE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS FALSE

`a person with no reason to suspect` MEANS Encounter WITH
    `knows they have HIV` IS FALSE
    `has reason to believe they may have HIV` IS FALSE
    `informed and the partner accepted the risk` IS FALSE
    `maintained an undetectable viral load` IS FALSE
    `tested negative beforehand` IS FALSE
    `took reasonable precautions` IS FALSE

§ `s 21A`

#ASSERT `the disease is in the Second Schedule` `Ebola`
#ASSERT `the disease is in the Second Schedule` `MERS`
#ASSERT `the disease is in the Second Schedule` `plague`
#ASSERT `the disease is in the Second Schedule` `SARS`
#ASSERT `the disease is in the Second Schedule` `yellow fever`
#ASSERT NOT `the disease is in the Second Schedule` `measles`
#ASSERT NOT `the disease is in the Second Schedule` `influenza`
#ASSERT NOT `the disease is in the Second Schedule` `tuberculosis`

#ASSERT `the person commits a section 21A offence` `SARS` TRUE TRUE FALSE
#ASSERT NOT `the person commits a section 21A offence` `SARS` TRUE TRUE TRUE
#ASSERT NOT `the person commits a section 21A offence` `measles` TRUE TRUE FALSE
#ASSERT NOT `the person commits a section 21A offence` `Ebola` FALSE TRUE FALSE

§ `s 15`

#ASSERT `the breach is an offence` `leaving the isolation place` TRUE FALSE
#ASSERT NOT `the breach is an offence` `leaving the isolation place` FALSE TRUE
#ASSERT NOT `the breach is an offence` `failing to go to the isolation place` TRUE FALSE
#ASSERT `the breach is an offence` `breaching an isolation condition` FALSE FALSE

§ `ss 23, 24`

#ASSERT NOT `the encounter is a section 23 offence` `a person who knows and told the partner who accepted`
#ASSERT `the encounter is a section 23 offence` `a person who knows and did not tell`
#ASSERT NOT `the encounter is a section 23 offence` `a person who knows with a sustained undetectable load`
#ASSERT `the encounter is a section 23 offence` `a person who knows and only took precautions`
#ASSERT NOT `the encounter is a section 23 offence` `a person who suspects and took precautions`
#ASSERT NOT `the encounter is a section 23 offence` `a person who suspects and tested negative`
#ASSERT `the encounter is a section 23 offence` `a person who suspects and did nothing`
#ASSERT NOT `the encounter is a section 23 offence` `a person with no reason to suspect`

#ASSERT `the person is deemed to know` TRUE TRUE
#ASSERT NOT `the person is deemed to know` TRUE FALSE

§ `s 25`

#ASSERT NOT `disclosure is permitted` `the patient's employer` FALSE
#ASSERT `disclosure is permitted` `the patient's treating doctor` FALSE
#ASSERT `disclosure is permitted` `a court that ordered it` FALSE
#ASSERT `disclosure is permitted` `the victim of a sexual assault by the patient` FALSE
#ASSERT NOT `disclosure is permitted` `a journalist` FALSE
#ASSERT `disclosure is permitted` `a blood bank that received their blood` FALSE
#ASSERT `disclosure is permitted` `the patient's employer` TRUE

§ `ss 46, 65`

#ASSERT `childhood vaccination is compulsory` `measles`
#ASSERT NOT `childhood vaccination is compulsory` `influenza`

#ASSERT `the general maximum fine` FALSE EQUALS 10000
#ASSERT `the general maximum fine` TRUE EQUALS 20000

