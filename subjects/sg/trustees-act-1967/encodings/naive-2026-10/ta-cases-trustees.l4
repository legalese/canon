IMPORT prelude
IMPORT `ta-trustees`

-- Trustees Act 1967, ss 3A, 4 to 10, 34, 36, 37, 41B, 41N, 41Q, 41R, 60, 61 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_trustees.py). Expected results were written by
-- hand from the text.

§ `s 3A`

#ASSERT `the statutory duty of care applies` FALSE
#ASSERT NOT `the statutory duty of care applies` TRUE

§ `ss 4 to 10`

#ASSERT `the advice requirement is met` TRUE FALSE
#ASSERT `the advice requirement is met` FALSE TRUE
#ASSERT NOT `the advice requirement is met` FALSE FALSE

#ASSERT `the loan-to-value is protected` 600000 900000 TRUE
#ASSERT NOT `the loan-to-value is protected` 610000 900000 TRUE
#ASSERT NOT `the loan-to-value is protected` 600000 900000 FALSE

#ASSERT `the trustee's liability for over-advancing` 800000 600000 EQUALS 200000
#ASSERT `the trustee's liability for over-advancing` 500000 600000 EQUALS 0

§ `s 34`

#ASSERT `the most that can still be advanced` 200000 0 EQUALS 100000
#ASSERT `the most that can still be advanced` 200000 60000 EQUALS 40000
#ASSERT `the most that can still be advanced` 200000 100000 EQUALS 0
#ASSERT `the most that can still be advanced` 200000 120000 EQUALS 0

#ASSERT `the advancement may prejudice the prior interest` FALSE FALSE
#ASSERT `the advancement may prejudice the prior interest` TRUE TRUE
#ASSERT NOT `the advancement may prejudice the prior interest` TRUE FALSE

§ `ss 36, 37`

#ASSERT `the number who are trustees` 6 FALSE EQUALS 4
#ASSERT `the number who are trustees` 3 FALSE EQUALS 3
#ASSERT `the number who are trustees` 6 TRUE EQUALS 6

#ASSERT `the trustee may be replaced on this ground` `death`
#ASSERT `the trustee may be replaced on this ground` `abroad for 18 months`
#ASSERT NOT `the trustee may be replaced on this ground` `abroad for 6 months`
#ASSERT `the trustee may be replaced on this ground` `wishes to retire`
#ASSERT `the trustee may be replaced on this ground` `unfit to act`
#ASSERT `the trustee may be replaced on this ground` `is an infant`
#ASSERT NOT `the trustee may be replaced on this ground` `disagrees with co-trustees`

§ `ss 41B, 41N`

#ASSERT `the function can be delegated` `managing the investments`
#ASSERT `the function can be delegated` `collecting rent`
#ASSERT NOT `the function can be delegated` `deciding which beneficiary gets a distribution`
#ASSERT NOT `the function can be delegated` `deciding whether a fee comes from income or capital`
#ASSERT NOT `the function can be delegated` `appointing a new trustee`

#ASSERT NOT `the trustee is liable for the agent's default` TRUE
#ASSERT `the trustee is liable for the agent's default` FALSE

§ `ss 41Q, 41R`

#ASSERT `the trustee has statutory remuneration` `a trust corporation` FALSE FALSE
#ASSERT `the trustee has statutory remuneration` `a professional co-trustee` FALSE TRUE
#ASSERT NOT `the trustee has statutory remuneration` `a professional co-trustee` FALSE FALSE
#ASSERT NOT `the trustee has statutory remuneration` `a professional sole trustee` FALSE FALSE
#ASSERT NOT `the trustee has statutory remuneration` `a lay trustee` FALSE TRUE
#ASSERT NOT `the trustee has statutory remuneration` `a trust corporation` TRUE FALSE

§ `ss 60, 61`

#ASSERT `the court may relieve the trustee` TRUE TRUE TRUE
#ASSERT NOT `the court may relieve the trustee` TRUE FALSE TRUE
#ASSERT NOT `the court may relieve the trustee` FALSE TRUE TRUE

#ASSERT `the beneficiary's interest may be impounded` `instigated the breach`
#ASSERT `the beneficiary's interest may be impounded` `requested the breach`
#ASSERT `the beneficiary's interest may be impounded` `consented in writing`
#ASSERT NOT `the beneficiary's interest may be impounded` `consented orally`
#ASSERT NOT `the beneficiary's interest may be impounded` `knew but said nothing`

