IMPORT prelude
IMPORT `pta-trusts`

-- Public Trustee Act 1915, ss 4(4), (5), 6(1), 7, 8(2), (4), 12A(4), 13(7), 17, 21 and 22 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_public-trustee-act-1915.py). Expected results were written by
-- hand from the text.

§ `s 4(4), (5)`

#ASSERT NOT `the Public Trustee must not accept the trust` FALSE FALSE FALSE FALSE
#ASSERT `the Public Trustee must not accept the trust` TRUE FALSE FALSE FALSE
#ASSERT NOT `the Public Trustee must not accept the trust` TRUE TRUE FALSE FALSE
#ASSERT `the Public Trustee must not accept the trust` FALSE FALSE TRUE FALSE
#ASSERT `the Public Trustee must not accept the trust` FALSE FALSE FALSE TRUE

#ASSERT NOT `declining the trust is permitted` TRUE
#ASSERT `declining the trust is permitted` FALSE

§ `s 6(1)`

#ASSERT `the Public Trustee must administer the small estate` TRUE 40000 50000 TRUE FALSE
