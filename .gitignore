# Python bytecode
__pycache__/
*.pyc

# Harvest logs — the run's own record, not the corpus's
logs/

# Generated spreadsheets. These are derivatives of the corpus and of
# tools/topics/*.json, and derivatives in trees drift (directory-conventions.md
# §10 Q5). Rebuild with tools/topics/build-progress-xlsx.py.
tools/topics/*.xlsx

# Stray scrape
wy.html

# The Singapore Statutes Online harvest's publisher PDFs. 499 files, ~216 MB,
# and git history is permanent. The .txt extract beside each one is what the
# corpus actually reads, and the meta.json records the PDF's URL and digest so
# a fresh download can be checked against it. The PDFs stay on disk; they are
# simply not committed.
#
# Subjects encoded before the harvest keep the PDFs they already committed —
# gitignore does not untrack — and penal-code-1871 is named so the exception
# is visible rather than surprising.
subjects/sg/*/registers/source-bundle/*.pdf
!subjects/sg/penal-code-1871/registers/source-bundle/PC1871.pdf
