    intentionally IS TRUE
    `omits to attend at the place or time` IS TRUE
    `departs from the place before the time at which it is lawful to depart` IS FALSE
    `the summons, notice, order or proclamation is to attend in person or by agent before a court` IS TRUE
    `the process` IS "a summons issued by a Magistrate to attend as a witness"
    `to wit` IS ""
-- s 174 illus (b)
#ASSERT `offence under s 174(1)` `174 illus (b)`
#ASSERT `offence under s 174(2)` `174 illus (b)`
#ASSERT (`charge under s 174(2)` `174 illus (b)`)'s section EQUALS "174(2)(a)"
-- not intentional: no offence under either subsection, and the refusal says why
