IMPORT prelude
IMPORT `vcc-core`

-- Variable Capital Companies Act 2018, ss 15 to 18, 29, 35, 46, 48, 53 and 58 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_vcc.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a proper proposal` MEANS Proposal WITH
    `the manager is qualified under section 46(2)` IS TRUE
    `a director is a director or qualified representative of the manager` IS TRUE
    `likely to be used for an unlawful or prejudicial purpose` IS FALSE
    `contrary to national security or interest` IS FALSE

`a proposal with an unlicensed manager` MEANS Proposal WITH
    `the manager is qualified under section 46(2)` IS FALSE
    `a director is a director or qualified representative of the manager` IS TRUE
    `likely to be used for an unlawful or prejudicial purpose` IS FALSE
    `contrary to national security or interest` IS FALSE

`a proposal with no manager-linked director` MEANS Proposal WITH
    `the manager is qualified under section 46(2)` IS TRUE
    `a director is a director or qualified representative of the manager` IS FALSE
    `likely to be used for an unlawful or prejudicial purpose` IS FALSE
    `contrary to national security or interest` IS FALSE

`a proposal for an unlawful purpose` MEANS Proposal WITH
    `the manager is qualified under section 46(2)` IS TRUE
    `a director is a director or qualified representative of the manager` IS TRUE
    `likely to be used for an unlawful or prejudicial purpose` IS TRUE
    `contrary to national security or interest` IS FALSE

`a proposal against national security` MEANS Proposal WITH
    `the manager is qualified under section 46(2)` IS TRUE
    `a director is a director or qualified representative of the manager` IS TRUE
    `likely to be used for an unlawful or prejudicial purpose` IS FALSE
    `contrary to national security or interest` IS TRUE

`sub-fund A's lender against sub-fund A` MEANS Claim WITH
    `the creditor dealt with sub-fund A` IS TRUE
    `the assets sought belong to sub-fund A` IS TRUE
    `a contract purports to give recourse to another sub-fund` IS FALSE

`sub-fund A's lender against sub-fund B` MEANS Claim WITH
    `the creditor dealt with sub-fund A` IS TRUE
    `the assets sought belong to sub-fund A` IS FALSE
    `a contract purports to give recourse to another sub-fund` IS FALSE

`sub-fund A's lender with a cross-guarantee from B, against B` MEANS Claim WITH
    `the creditor dealt with sub-fund A` IS TRUE
    `the assets sought belong to sub-fund A` IS FALSE
    `a contract purports to give recourse to another sub-fund` IS TRUE

`a full board` MEANS Board WITH
    `has a director ordinarily resident in Singapore` IS TRUE
    `has a director who is a director or representative of the manager` IS TRUE

`a board with no resident director` MEANS Board WITH
    `has a director ordinarily resident in Singapore` IS FALSE
    `has a director who is a director or representative of the manager` IS TRUE

`a board with no manager link` MEANS Board WITH
    `has a director ordinarily resident in Singapore` IS TRUE
    `has a director who is a director or representative of the manager` IS FALSE

`a knowing investor, debt at month 8` MEANS MemberExposure WITH
    `months trading without the required directors when the debt was contracted` IS 8
    `is a member` IS TRUE
    `knows the VCC is so trading` IS TRUE

`an unaware investor, debt at month 8` MEANS MemberExposure WITH
    `months trading without the required directors when the debt was contracted` IS 8
    `is a member` IS TRUE
    `knows the VCC is so trading` IS FALSE

`a knowing investor, debt at month 5` MEANS MemberExposure WITH
    `months trading without the required directors when the debt was contracted` IS 5
    `is a member` IS TRUE
    `knows the VCC is so trading` IS TRUE

`a knowing non-member, debt at month 8` MEANS MemberExposure WITH
    `months trading without the required directors when the debt was contracted` IS 8
    `is a member` IS FALSE
    `knows the VCC is so trading` IS TRUE

`a fined fraud conviction carrying up to 3 years` MEANS Conviction WITH
    `involves fraud or dishonesty` IS TRUE
    `maximum imprisonment in months` IS 36
    `was sentenced to imprisonment` IS FALSE

`a jailed cheating conviction` MEANS Conviction WITH
    `involves fraud or dishonesty` IS TRUE
    `maximum imprisonment in months` IS 120
    `was sentenced to imprisonment` IS TRUE

`a careless-driving conviction` MEANS Conviction WITH
    `involves fraud or dishonesty` IS FALSE
    `maximum imprisonment in months` IS 12
    `was sentenced to imprisonment` IS FALSE

`a fraud offence carrying up to 2 months` MEANS Conviction WITH
    `involves fraud or dishonesty` IS TRUE
    `maximum imprisonment in months` IS 2
    `was sentenced to imprisonment` IS FALSE

