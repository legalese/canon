    `having his face covered or otherwise found disguised`                                                                                              IS FALSE
    `with intent to commit any offence`                                                                                                                 IS FALSE
    `equipped with any article or instrument for use in the course of or in connection with any house-breaking`                                         IS FALSE

#ASSERT `offence under s 453` `found with a parang`
`found with a parang, a lawful purpose shown` MEANS `Found Armed Facts` WITH
    particulars                                                                                                                                         IS `the particulars`
    `the article`                                                                                                                                       IS "a parang"
    `found armed with any instrument for shooting, stabbing or cutting, or any instrument which, used as a weapon of offence, is likely to cause death` IS TRUE
    `with lawful authority or a lawful purpose`                                                                                                         IS TRUE
    `carried by a person listed in section 453(3)`                                                                                                      IS FALSE
    `having his face covered or otherwise found disguised`                                                                                              IS FALSE
    `with intent to commit any offence`                                                                                                                 IS FALSE
    `equipped with any article or instrument for use in the course of or in connection with any house-breaking`                                         IS FALSE

#ASSERT NOT `offence under s 453` `found with a parang, a lawful purpose shown`
-- s 453(3)(d): part of ceremonial dress on a ceremonial occasion
`a ceremonial sword` MEANS `Found Armed Facts` WITH
    particulars                                                                                                                                         IS `the particulars`
    `the article`                                                                                                                                       IS "a parang"
    `found armed with any instrument for shooting, stabbing or cutting, or any instrument which, used as a weapon of offence, is likely to cause death` IS TRUE
    `with lawful authority or a lawful purpose`                                                                                                         IS FALSE
    `carried by a person listed in section 453(3)`                                                                                                      IS TRUE
    `having his face covered or otherwise found disguised`                                                                                              IS FALSE
    `with intent to commit any offence`                                                                                                                 IS FALSE
    `equipped with any article or instrument for use in the course of or in connection with any house-breaking`                                         IS FALSE

#ASSERT NOT `offence under s 453` `a ceremonial sword`

-- ss 461, 462
`a cash box forced` MEANS `Receptacle Facts` WITH
    particulars                                                                     IS `the particulars`
    `the receptacle`                                                                IS ""
    dishonestly                                                                     IS TRUE
    `with intent to commit mischief`                                                IS FALSE
    `breaks open or unfastens`                                                      IS TRUE
    `any closed receptacle which contains or which he believes to contain property` IS TRUE
    `being entrusted with the receptacle`                                           IS FALSE
    `without having authority to open the same`                                     IS FALSE

#ASSERT `offence under s 461` `a cash box forced`
#ASSERT NOT `offence under s 462` `a cash box forced`
`a cash box forced by its custodian` MEANS `Receptacle Facts` WITH
    particulars                                                                     IS `the particulars`
    `the receptacle`                                                                IS ""
    dishonestly                                                                     IS TRUE
    `with intent to commit mischief`                                                IS FALSE
    `breaks open or unfastens`                                                      IS TRUE
    `any closed receptacle which contains or which he believes to contain property` IS TRUE
    `being entrusted with the receptacle`                                           IS TRUE
    `without having authority to open the same`                                     IS TRUE

#ASSERT `offence under s 462` `a cash box forced by its custodian`
