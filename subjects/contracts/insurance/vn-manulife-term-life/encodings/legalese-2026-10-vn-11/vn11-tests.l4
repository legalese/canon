§ `Article 15 — assignment (src:313-334)`
`an assignment of all rights in the insured's lifetime, not yet notified` MEANS
    `An assignment` WITH
        `the insured alive when it was made`           IS TRUE
        `the contract in force when it was made`       IS TRUE
        `lawful and of all the policyholder's rights`  IS TRUE
        `written notice received by the Company`       IS FALSE
        `original instrument submitted to the Company` IS FALSE
        `approved by the Company in writing`           IS FALSE
`an assignment after the insured's death` MEANS
    `An assignment` WITH
        `the insured alive when it was made`           IS FALSE
        `the contract in force when it was made`       IS TRUE
        `lawful and of all the policyholder's rights`  IS TRUE
        `written notice received by the Company`       IS TRUE
        `original instrument submitted to the Company` IS TRUE
        `approved by the Company in writing`           IS TRUE
`an assignment notified and submitted, not approved` MEANS
    `An assignment` WITH
        `the insured alive when it was made`           IS TRUE
        `the contract in force when it was made`       IS TRUE
        `lawful and of all the policyholder's rights`  IS TRUE
        `written notice received by the Company`       IS TRUE
        `original instrument submitted to the Company` IS TRUE
        `approved by the Company in writing`           IS FALSE
`an assignment notified, submitted and approved` MEANS
    `An assignment` WITH
        `the insured alive when it was made`           IS TRUE
        `the contract in force when it was made`       IS TRUE
        `lawful and of all the policyholder's rights`  IS TRUE
        `written notice received by the Company`       IS TRUE
        `original instrument submitted to the Company` IS TRUE
        `approved by the Company in writing`           IS TRUE
