#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-first` `in the tax year` 2026 EQUALS 140_000
#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-first` `in the tax year` 2027 EQUALS 140_000
#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-first` `in the tax year` 2028 EQUALS 140_000
#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-second` `in the tax year` 2029 EQUALS 140_000
#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-first` `in the tax year` 2030 EQUALS 150_000
#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-second` `in the tax year` 2030 EQUALS 140_000
#ASSERT `s 2(b) — the income ceiling for income received from a relative, at the readings` `R-all-first` `in the tax year` 2031 EQUALS 0
