#ASSERT NOT (`עבר את תקרת ההמתנה לדרגה` `דרגה 7` `לאחר` 40 `כאשר המכסה` FALSE)
#ASSERT NOT (`עבר את תקרת ההמתנה לדרגה` `דרגה 7` `לאחר` 30 `כאשר המכסה` TRUE)

