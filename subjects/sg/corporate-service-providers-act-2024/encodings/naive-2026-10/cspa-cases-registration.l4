IMPORT prelude
IMPORT `cspa-registration`

-- Corporate Service Providers Act 2024, ss 2, 7, 9, 11, 12, 14, 16, 17, 19, 21, 23, 27 and 42 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_corporate-service-providers-act-2024.py). Expected results were written by
-- hand from the text.

`an unregistered incorporation agent` MEANS Business WITH
    `the service` IS `forming a company for a client`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS FALSE
    `registration is suspended` IS FALSE
    `is an accounting entity` IS FALSE
    `is within the section 42 transitional period` IS FALSE

`a registered incorporation agent` MEANS Business WITH
    `the service` IS `forming a company for a client`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS TRUE
    `registration is suspended` IS FALSE
    `is an accounting entity` IS FALSE
    `is within the section 42 transitional period` IS FALSE

`a suspended incorporation agent` MEANS Business WITH
    `the service` IS `forming a company for a client`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS TRUE
    `registration is suspended` IS TRUE
    `is an accounting entity` IS FALSE
    `is within the section 42 transitional period` IS FALSE

`an accounting firm managing client money` MEANS Business WITH
    `the service` IS `managing client money in the course of an accounting service`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS FALSE
    `registration is suspended` IS FALSE
    `is an accounting entity` IS TRUE
    `is within the section 42 transitional period` IS FALSE

`a suspended accounting firm managing client money` MEANS Business WITH
    `the service` IS `managing client money in the course of an accounting service`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS FALSE
    `registration is suspended` IS TRUE
    `is an accounting entity` IS TRUE
    `is within the section 42 transitional period` IS FALSE

`an accounting firm offering registered office addresses` MEANS Business WITH
    `the service` IS `providing a registered office address`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS FALSE
    `registration is suspended` IS FALSE
    `is an accounting entity` IS TRUE
    `is within the section 42 transitional period` IS FALSE

`an existing agent in the transitional period` MEANS Business WITH
    `the service` IS `forming a company for a client`
    `carries on a business in Singapore of providing it` IS TRUE
    `is registered for that type of service` IS FALSE
    `registration is suspended` IS FALSE
    `is an accounting entity` IS FALSE
    `is within the section 42 transitional period` IS TRUE

`a company employing a registered qualified individual` MEANS ProviderApplicant WITH
    `form` IS `a company`
    `is itself a registered qualified individual` IS FALSE
    `a partner is a registered qualified individual` IS FALSE
    `employs a registered qualified individual` IS TRUE
    `a key appointment holder is not fit and proper` IS FALSE
    `the applicant completed the prescribed course` IS FALSE
    `every key appointment holder completed the prescribed course` IS TRUE
    `had a registration cancelled under section 19` IS FALSE
    `months since that cancellation` IS 0

`a company with no registered qualified individual` MEANS ProviderApplicant WITH
    `form` IS `a company`
    `is itself a registered qualified individual` IS FALSE
    `a partner is a registered qualified individual` IS FALSE
    `employs a registered qualified individual` IS FALSE
    `a key appointment holder is not fit and proper` IS FALSE
    `the applicant completed the prescribed course` IS FALSE
    `every key appointment holder completed the prescribed course` IS TRUE
    `had a registration cancelled under section 19` IS FALSE
    `months since that cancellation` IS 0

