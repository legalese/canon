IMPORT `cat-domain`
IMPORT `cat-part2-div1-registration`
IMPORT `cat-part2-div2-3-microchipping-sterilisation`
IMPORT `cat-regulations-2012`

-- Cat Act 2011 (WA) -- worked cases.
--
-- Every assertion here is a claim about the encoding, not about the law: it
-- fixes what the rules answer on stated facts, so that a later change which
-- alters an answer is caught. The cases in § `Findings` are the ones the
-- incident register cites; each is the reproduction that turns a reading of the
-- Act into a finding.
--
-- No library imports: see the note at the head of cat-domain.l4.

§ `Fixtures`

`the City of Perth` MEANS LocalGovernment WITH `name` IS "City of Perth"
`the City of Fremantle` MEANS LocalGovernment WITH `name` IS "City of Fremantle"

`Anne` MEANS Person WITH
    `name`                      IS "Anne"
    `age`                       IS `an adult`
    `an approved cat breeder`   IS FALSE

`Ben the breeder` MEANS Person WITH
    `name`                      IS "Ben"
    `age`                       IS `an adult`
    `an approved cat breeder`   IS TRUE

`Chloe, aged 12` MEANS Person WITH
    `name`                      IS "Chloe"
    `age`                       IS `a child under 18 years of age`
    `an approved cat breeder`   IS FALSE

-- A plain adult cat: eight months old, microchipped, sterilised by a vet,
-- registered with the local government of its district, tag on, at home.
`Mittens` MEANS Cat WITH
    `name`                          IS "Mittens"
    `age in months`                 IS 8
    `microchipped`                  IS TRUE
    `sterilised`                    IS TRUE
    `sterilised by a veterinarian`  IS TRUE
    `registered`                    IS TRUE
    `wearing its registration tag`  IS TRUE
    `in a public place`             IS FALSE

-- The same cat, unregistered and unmicrochipped: the ordinary non-compliant case.
`Smudge` MEANS Cat WITH
    `name`                          IS "Smudge"
    `age in months`                 IS 8
    `microchipped`                  IS FALSE
    `sterilised`                    IS FALSE
    `sterilised by a veterinarian`  IS FALSE
    `registered`                    IS FALSE
    `wearing its registration tag`  IS FALSE
    `in a public place`             IS FALSE

-- A kitten: under the 6-month threshold every duty in Part 2 turns on.
`Pip, a kitten` MEANS Cat WITH
    `name`                          IS "Pip"
    `age in months`                 IS 4
    `microchipped`                  IS FALSE
    `sterilised`                    IS FALSE
    `sterilised by a veterinarian`  IS FALSE
    `registered`                    IS FALSE
    `wearing its registration tag`  IS FALSE
    `in a public place`             IS FALSE

§§ `Situations`

-- Anne has kept Smudge for two months, has lived in the State for years, and
-- has not registered him. No prescribed exemption applies and no certificate
-- exists.
`Anne and Smudge` MEANS Situation WITH
    `cat`                           IS `Smudge`
    `owner`                         IS `Anne`
    `local government of the district where the cat is ordinarily kept` IS `the City of Perth`
    `the cat is registered with that local government` IS FALSE
    `days the cat has been kept by the owner` IS 60
    `days the owner has been resident in the State` IS 2000
    `of a class prescribed as exempt from registration` IS FALSE
    `of a class prescribed as exempt from wearing a tag in a public place` IS FALSE
    `of a class prescribed as exempt from sterilisation` IS FALSE
    `certificate about microchipping`   IS NOTHING
    `certificate about sterilisation`   IS NOTHING
    `owned for the purpose of breeding` IS FALSE
    `the owner has proceeded with all convenient speed` IS FALSE

-- The same, except Anne has had the cat for ten days: s 5(2)(a).
`Anne and Smudge, on day ten` MEANS Situation WITH
    `cat`                           IS `Smudge`
    `owner`                         IS `Anne`
    `local government of the district where the cat is ordinarily kept` IS `the City of Perth`
    `the cat is registered with that local government` IS FALSE
    `days the cat has been kept by the owner` IS 10
    `days the owner has been resident in the State` IS 2000
    `of a class prescribed as exempt from registration` IS FALSE
    `of a class prescribed as exempt from wearing a tag in a public place` IS FALSE
    `of a class prescribed as exempt from sterilisation` IS FALSE
    `certificate about microchipping`   IS NOTHING
    `certificate about sterilisation`   IS NOTHING
    `owned for the purpose of breeding` IS FALSE
    `the owner has proceeded with all convenient speed` IS FALSE

-- Anne's kitten: four months old, nothing done yet, and nothing owed yet.
`Anne and Pip` MEANS Situation WITH
    `cat`                           IS `Pip, a kitten`
    `owner`                         IS `Anne`
    `local government of the district where the cat is ordinarily kept` IS `the City of Perth`
    `the cat is registered with that local government` IS FALSE
    `days the cat has been kept by the owner` IS 100
    `days the owner has been resident in the State` IS 2000
    `of a class prescribed as exempt from registration` IS FALSE
    `of a class prescribed as exempt from wearing a tag in a public place` IS FALSE
    `of a class prescribed as exempt from sterilisation` IS FALSE
    `certificate about microchipping`   IS NOTHING
    `certificate about sterilisation`   IS NOTHING
    `owned for the purpose of breeding` IS FALSE
    `the owner has proceeded with all convenient speed` IS FALSE

§§ `5 -- illustrations`

#ASSERT `the owner contravenes section 5(1)` `Anne and Smudge`
#ASSERT NOT `the owner must ensure the cat is registered` `Anne and Smudge, on day ten`
#ASSERT `section 5(2) disapplies the duty to register` `Anne and Smudge, on day ten`
#ASSERT NOT `the owner must ensure the cat is registered` `Anne and Pip`

