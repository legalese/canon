`an assignee with full rights` MEANS Claimant WITH
    `entitled by assignment` IS TRUE
    `entitled by another derivative title` IS FALSE
    `has the right in equity to receive the moneys` IS TRUE
    `has the right to give the company an effectual discharge` IS TRUE

`a holder by another derivative title` MEANS Claimant WITH
    `entitled by assignment` IS FALSE
    `entitled by another derivative title` IS TRUE
    `has the right in equity to receive the moneys` IS TRUE
    `has the right to give the company an effectual discharge` IS TRUE

`an assignee who cannot give a discharge` MEANS Claimant WITH
    `entitled by assignment` IS TRUE
    `entitled by another derivative title` IS FALSE
    `has the right in equity to receive the moneys` IS TRUE
    `has the right to give the company an effectual discharge` IS FALSE

`an assignee without the equitable right` MEANS Claimant WITH
    `entitled by assignment` IS TRUE
    `entitled by another derivative title` IS FALSE
    `has the right in equity to receive the moneys` IS FALSE
    `has the right to give the company an effectual discharge` IS TRUE

`a stranger to the policy` MEANS Claimant WITH
