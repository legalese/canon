IMPORT prelude
IMPORT `pca-prices`

-- Price Control Act 1950, ss 2, 7-10, 14 and 16 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_price-control-act-1950.py). Expected results were written by
-- hand from the text.

§ `ss 2 and 9`

#ASSERT `the selling price` 12 2 EQUALS 10
#ASSERT `the selling price` 10 0 EQUALS 10

#ASSERT `selling above the maximum price is an offence` TRUE TRUE 12 0 10
#ASSERT NOT `selling above the maximum price is an offence` TRUE TRUE 10 0 10
#ASSERT NOT `selling above the maximum price is an offence` TRUE TRUE 12 3 10
#ASSERT `selling above the maximum price is an offence` TRUE TRUE 12 1 10
#ASSERT NOT `selling above the maximum price is an offence` FALSE TRUE 50 0 10
#ASSERT NOT `selling above the maximum price is an offence` TRUE FALSE 12 0 10

#ASSERT `buying above the maximum price is an offence` TRUE TRUE 12 10
#ASSERT NOT `buying above the maximum price is an offence` TRUE FALSE 12 10
#ASSERT NOT `buying above the maximum price is an offence` TRUE TRUE 10 10
#ASSERT NOT `buying above the maximum price is an offence` FALSE TRUE 12 10

§ `s 14`

#ASSERT `the buyer may be prosecuted` TRUE TRUE 12 10 FALSE FALSE
#ASSERT NOT `the buyer may be prosecuted` TRUE TRUE 12 10 TRUE TRUE
#ASSERT `the buyer may be prosecuted` TRUE TRUE 12 10 TRUE FALSE
#ASSERT `the buyer may be prosecuted` TRUE TRUE 12 10 FALSE TRUE

§ `ss 7 and 8`

#ASSERT NOT `failing to display the price list is an offence` TRUE TRUE FALSE FALSE TRUE
#ASSERT `failing to display the price list is an offence` TRUE FALSE FALSE FALSE TRUE
#ASSERT `failing to display the price list is an offence` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `failing to display the price list is an offence` TRUE TRUE TRUE TRUE TRUE
#ASSERT `failing to display the price list is an offence` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `failing to display the price list is an offence` FALSE FALSE FALSE FALSE FALSE

#ASSERT `failing to exhibit a retail price is an offence` TRUE TRUE FALSE
#ASSERT NOT `failing to exhibit a retail price is an offence` TRUE FALSE FALSE
#ASSERT NOT `failing to exhibit a retail price is an offence` TRUE TRUE TRUE
#ASSERT NOT `failing to exhibit a retail price is an offence` FALSE TRUE FALSE

§ `s 10`

#ASSERT `refusing to sell is an offence` TRUE TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `refusing to sell is an offence` TRUE TRUE FALSE TRUE TRUE FALSE
#ASSERT NOT `refusing to sell is an offence` TRUE TRUE FALSE TRUE FALSE TRUE
#ASSERT `refusing to sell is an offence` TRUE TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `refusing to sell is an offence` TRUE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT `refusing to sell is an offence` FALSE TRUE FALSE TRUE FALSE FALSE

§ `s 16(1), (2)`

#ASSERT `the maximum fine` `an individual` FALSE EQUALS 2000
#ASSERT `the maximum fine` `an individual` TRUE EQUALS 20000
#ASSERT `the maximum fine` `a body corporate` FALSE EQUALS 10000
#ASSERT `the maximum fine` `a body corporate` TRUE EQUALS 20000

#ASSERT `the maximum imprisonment in years` `an individual` FALSE EQUALS 2
#ASSERT `the maximum imprisonment in years` `an individual` TRUE EQUALS 5
#ASSERT `the maximum imprisonment in years` `a body corporate` FALSE EQUALS 0
#ASSERT `the maximum imprisonment in years` `a body corporate` TRUE EQUALS 0

§ `s 16(3)`

#ASSERT `the court may debar from business` TRUE TRUE FALSE
#ASSERT `the court may debar from business` TRUE FALSE TRUE
#ASSERT NOT `the court may debar from business` TRUE FALSE FALSE
#ASSERT NOT `the court may debar from business` FALSE TRUE FALSE

#ASSERT `the maximum fine for breaching a debarment order` EQUALS 20000
#ASSERT `the maximum imprisonment in years for breaching a debarment order` EQUALS 1

§ `s 16(4)`

#ASSERT `the director is deemed guilty` TRUE TRUE FALSE FALSE
#ASSERT NOT `the director is deemed guilty` TRUE TRUE TRUE FALSE
#ASSERT NOT `the director is deemed guilty` TRUE TRUE FALSE TRUE
#ASSERT NOT `the director is deemed guilty` FALSE TRUE FALSE FALSE

§ `s 16(6)`

#ASSERT `the principal is liable` TRUE FALSE
#ASSERT NOT `the principal is liable` TRUE TRUE

