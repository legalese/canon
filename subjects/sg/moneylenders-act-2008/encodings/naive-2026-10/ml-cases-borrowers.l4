IMPORT prelude
IMPORT `ml-borrowers`

-- Moneylenders Act 2008, ss 2, 3, 19, 35 to 37, 47 and 49 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_ml.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a loan shark` MEANS Lender WITH
    `is an excluded moneylender` IS FALSE
    `lent for a larger sum to be repaid` IS TRUE
    `proved no business of moneylending` IS FALSE
    `is licensed or exempt` IS FALSE

`a licensed moneylender` MEANS Lender WITH
    `is an excluded moneylender` IS FALSE
    `lent for a larger sum to be repaid` IS TRUE
    `proved no business of moneylending` IS FALSE
    `is licensed or exempt` IS TRUE

`a bank` MEANS Lender WITH
    `is an excluded moneylender` IS TRUE
    `lent for a larger sum to be repaid` IS TRUE
    `proved no business of moneylending` IS FALSE
    `is licensed or exempt` IS FALSE

`a friend lending $1,000 for $1,100 who proves it was a one-off` MEANS Lender WITH
    `is an excluded moneylender` IS FALSE
    `lent for a larger sum to be repaid` IS TRUE
    `proved no business of moneylending` IS TRUE
    `is licensed or exempt` IS FALSE

`a friend lending $1,000 for $1,100 who cannot rebut` MEANS Lender WITH
    `is an excluded moneylender` IS FALSE
    `lent for a larger sum to be repaid` IS TRUE
    `proved no business of moneylending` IS FALSE
    `is licensed or exempt` IS FALSE

`a friend lending interest-free` MEANS Lender WITH
    `is an excluded moneylender` IS FALSE
    `lent for a larger sum to be repaid` IS FALSE
    `proved no business of moneylending` IS FALSE
    `is licensed or exempt` IS FALSE

`a loan at the cap` MEANS LicensedLoan WITH
    `contract interest rate per month` IS 0.04
    `prescribed maximum rate per month` IS 0.04
    `principal` IS 5000
    `unpermitted charges paid` IS 0

`a loan just over the cap` MEANS LicensedLoan WITH
    `contract interest rate per month` IS 0.041
    `prescribed maximum rate per month` IS 0.04
    `principal` IS 5000
    `unpermitted charges paid` IS 0

`a loan under the cap with a $200 unpermitted fee` MEANS LicensedLoan WITH
    `contract interest rate per month` IS 0.03
    `prescribed maximum rate per month` IS 0.04
    `principal` IS 5000
    `unpermitted charges paid` IS 200

`threatening calls by a loan shark's runner` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS TRUE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS FALSE
    `caused hurt` IS FALSE
    `is a repeat offence` IS FALSE

`splashing paint on a debtor's door` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS TRUE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS TRUE
    `caused hurt` IS FALSE
    `is a repeat offence` IS FALSE

`assault while collecting` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS TRUE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS FALSE
    `caused hurt` IS TRUE
    `is a repeat offence` IS FALSE

`paint and assault` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS TRUE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS TRUE
    `caused hurt` IS TRUE
    `is a repeat offence` IS FALSE

`repeat paint and assault` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS TRUE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS TRUE
    `caused hurt` IS TRUE
    `is a repeat offence` IS TRUE

`repeat paint only` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS TRUE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS TRUE
    `caused hurt` IS FALSE
    `is a repeat offence` IS TRUE

`harassing calls by a licensed lender` MEANS Harassment WITH
    `by or for an unlicensed moneylender` IS FALSE
    `threatening, abusive, or likely to cause alarm or annoyance` IS TRUE
    `damaged property` IS FALSE
    `caused hurt` IS FALSE
    `is a repeat offence` IS FALSE

§ `ss 2, 3`

#ASSERT `the lender is presumed a moneylender` `a loan shark`
#ASSERT `the lender is presumed a moneylender` `a licensed moneylender`
#ASSERT NOT `the lender is presumed a moneylender` `a bank`
#ASSERT NOT `the lender is presumed a moneylender` `a friend lending $1,000 for $1,100 who proves it was a one-off`
#ASSERT `the lender is presumed a moneylender` `a friend lending $1,000 for $1,100 who cannot rebut`
#ASSERT NOT `the lender is presumed a moneylender` `a friend lending interest-free`

#ASSERT `the lender is an unlicensed moneylender` `a loan shark`
#ASSERT NOT `the lender is an unlicensed moneylender` `a licensed moneylender`
#ASSERT NOT `the lender is an unlicensed moneylender` `a bank`
#ASSERT NOT `the lender is an unlicensed moneylender` `a friend lending $1,000 for $1,100 who proves it was a one-off`
#ASSERT `the lender is an unlicensed moneylender` `a friend lending $1,000 for $1,100 who cannot rebut`
#ASSERT NOT `the lender is an unlicensed moneylender` `a friend lending interest-free`

§ `s 19`

#ASSERT `the amount the lender can recover in court` `a loan shark` 10000 EQUALS 0
#ASSERT `the amount the lender can recover in court` `a licensed moneylender` 10000 EQUALS 10000
#ASSERT `the amount the lender can recover in court` `a bank` 10000 EQUALS 10000
#ASSERT `the amount the lender can recover in court` `a friend lending $1,000 for $1,100 who proves it was a one-off` 10000 EQUALS 10000
#ASSERT `the amount the lender can recover in court` `a friend lending $1,000 for $1,100 who cannot rebut` 10000 EQUALS 0
#ASSERT `the amount the lender can recover in court` `a friend lending interest-free` 10000 EQUALS 10000

#ASSERT `the act assists unlicensed moneylending` `collecting repayments` TRUE
#ASSERT `the act assists unlicensed moneylending` `letting one's bank account receive the lender's money` TRUE
#ASSERT NOT `the act assists unlicensed moneylending` `running errands unconnected with the loans` TRUE
#ASSERT NOT `the act assists unlicensed moneylending` `collecting repayments` FALSE

§ `ss 35, 36`

#ASSERT NOT `the loan exceeds the cap` `a loan at the cap`
#ASSERT `the loan exceeds the cap` `a loan just over the cap`
#ASSERT NOT `the loan exceeds the cap` `a loan under the cap with a $200 unpermitted fee`

#ASSERT `the principal the licensee can recover` `a loan at the cap` EQUALS 5000
#ASSERT `the principal the licensee can recover` `a loan just over the cap` EQUALS 0
#ASSERT `the principal the licensee can recover` `a loan under the cap with a $200 unpermitted fee` EQUALS 5000

#ASSERT `the borrower's claim back for charges` `a loan at the cap` EQUALS 0
#ASSERT `the borrower's claim back for charges` `a loan just over the cap` EQUALS 0
#ASSERT `the borrower's claim back for charges` `a loan under the cap with a $200 unpermitted fee` EQUALS 200

§ `s 37`

#ASSERT `the court must reopen the loan` TRUE TRUE
#ASSERT NOT `the court must reopen the loan` TRUE FALSE
#ASSERT NOT `the court must reopen the loan` FALSE TRUE

§ `s 47`

#ASSERT `the act is a section 47 offence` `threatening calls by a loan shark's runner`
#ASSERT `the act is a section 47 offence` `splashing paint on a debtor's door`
#ASSERT `the act is a section 47 offence` `assault while collecting`
#ASSERT `the act is a section 47 offence` `paint and assault`
#ASSERT `the act is a section 47 offence` `repeat paint and assault`
#ASSERT `the act is a section 47 offence` `repeat paint only`
