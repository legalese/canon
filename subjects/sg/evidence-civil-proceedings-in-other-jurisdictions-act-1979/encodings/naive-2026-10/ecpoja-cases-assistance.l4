    `the requesting court sits outside Singapore` IS TRUE
    `the matter is civil or commercial` IS TRUE
    `the proceedings arise out of a fiscal, monetary or revenue law` IS FALSE
    `the proceedings are instituted or contemplated` IS TRUE

