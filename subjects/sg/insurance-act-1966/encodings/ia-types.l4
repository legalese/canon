IMPORT prelude
IMPORT daydate

-- Insurance Act 1966 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- A fact is one a document, a register or a witness could give ("the
-- company holds 22% of the issued shares"); whether that is "effective
-- control" is a rule (s 26(7)).
--
-- Source: ../source/IA1966.txt (SSO PDF, current version as at 07 Oct 2026).

§ `Insurance Act 1966 — the nouns`

§§ `Classes of business and the person's standing`

-- s 3(1): two classes.
DECLARE `Class of business` IS ONE OF
    `life business`
    `general business`

-- What the Authority has granted, or what the person is, under the Act.
DECLARE Standing HAS
    `licensed for life business`                         IS A BOOLEAN   -- s 11
    `licensed for general business`                      IS A BOOLEAN   -- s 11
    `an authorised reinsurer`                            IS A BOOLEAN   -- s 42
    `a foreign insurer under a foreign insurer scheme`   IS A BOOLEAN   -- Part 2A
    `a registered insurance broker of the type`          IS A BOOLEAN   -- s 76, for the broking in question
    `an exempt insurance broker under s 92(1)(a)-(f), notified` IS A BOOLEAN
    `exempted by the Authority from the provision`       IS A BOOLEAN   -- s 138
    `an individual`                                      IS A BOOLEAN

§§ `Where the act happens (s 145)`

DECLARE `Place of the act` IS ONE OF
    `wholly in Singapore`
    `partly in and partly outside Singapore`
    `outside Singapore, with a substantial and reasonably foreseeable effect in Singapore`
    `outside Singapore, with no such effect`

§§ `Ownership and control (ss 26, 27, 34, 87)`

DECLARE `Shareholding facts` HAS
    `percentage of issued shares held with associates`   IS A NUMBER
    `percentage of voting power controlled with associates` IS A NUMBER
    `the directors act on the person's directions`       IS A BOOLEAN   -- s 26(7)(a)(ii)
    `the person can determine the insurer's policy`      IS A BOOLEAN   -- s 26(7)(a)(iii)
    `an approved director or officer, or a professional adviser only` IS A BOOLEAN -- s 26(7)(b)

§§ `Insurance funds (s 16)`

DECLARE `Fund facts` HAS
    `allocated to participating policies by way of bonus this period` IS A NUMBER  -- s 16(7)(b)
    `proposed allocation to the surplus account this period`          IS A NUMBER  -- s 16(7)(c)
    `approved by the directors on the appointed actuary's written recommendation` IS A BOOLEAN
    `would breach the fund solvency requirement or a prescribed condition` IS A BOOLEAN

§§ `The activity`

DECLARE `Activity` IS ONE OF
    -- s 4(1), 3(6): carrying on insurance business in Singapore as an insurer
    `carrying on a class of insurance business in Singapore as an insurer` HAS
        `class`                                          IS A `Class of business`
        `only short-term accident and health business`   IS A BOOLEAN   -- s 4(3)
        `reinsurance with every activity outside Singapore and no presence, but premiums` IS A BOOLEAN -- s 3(6)
    -- s 4(2): reinsurance from outside Singapore to persons in Singapore
    `providing reinsurance from outside Singapore to persons in Singapore` HAS
        `unsolicited, initiated by a licensed insurer, registered broker or notified exempt broker` IS A BOOLEAN
    -- s 5: holding out
    `holding out as a licensed insurer or authorised reinsurer`
    -- s 6(1), (2), (5): the word "insurance"
    `using the word "insurance" in a business name` HAS
        `the Authority's written consent`                IS A BOOLEAN
        `as an insurance intermediary allowed by s 6(4)` IS A BOOLEAN
        `the name indicates the business is as an intermediary` IS A BOOLEAN
        `an association of insurers`                     IS A BOOLEAN
    -- s 7: co-branding
    `co-branding with an unlicensed insurer's name or mark` HAS
        `the Authority's prior written consent`          IS A BOOLEAN
    -- s 8: solicitation
    `soliciting insurance business for an insurer` HAS
        `the insurer may carry on insurance business in Singapore` IS A BOOLEAN
        `for a branch outside Singapore or the head office` IS A BOOLEAN
        `a person prescribed under s 8(5)`               IS A BOOLEAN
    -- s 9: representative office
    `operating a representative office` HAS
        `registered with the Authority`                  IS A BOOLEAN
    -- s 64: agent's written agreement
    `arranging a contract as agent for a licensed insurer` HAS
        `a written agreement authorises it`              IS A BOOLEAN
        `an employee of the insurer, in the course of duty` IS A BOOLEAN
        `a financial adviser or insurer arranging life policies (s 64(4)-(5))` IS A BOOLEAN
    -- s 70: agent for an insurer not entitled
    `acting as agent for an insurer not entitled to carry on that business in Singapore` HAS
        `the Authority's approval`                       IS A BOOLEAN
    -- s 75: broking
    `carrying on business as an insurance broker`
    -- ss 83-85: placement
    `a broker negotiating a contract with an insurer that is not licensed` HAS
        `reinsurance, risks outside Singapore or prescribed risks` IS A BOOLEAN
        `the Authority's permission under s 84`          IS A BOOLEAN
        `a s 85 licence for a foreign insurer under a scheme` IS A BOOLEAN
    -- s 86: volume-based remuneration
    `paying or receiving broker remuneration varied solely by volume` HAS
        `a profit commission`                            IS A BOOLEAN
        `reinsurance broking`                            IS A BOOLEAN
    -- s 90, 91: holding out as broker; "insurance broking"
    `holding out as a registered insurance broker`
    `using the words "insurance broking"` HAS
        `"life insurance broking" only`                  IS A BOOLEAN
        `an association of brokers with the Authority's approval` IS A BOOLEAN
    -- s 26: effective control of a licensed insurer incorporated in Singapore
    `obtaining control of a licensed insurer incorporated in Singapore` HAS
        `holding`                                        IS A `Shareholding facts`
        `becomes a substantial shareholder (Companies Act 1967 s 81)` IS A BOOLEAN
        `an agreement to act together over voting shares, with percentage` IS A NUMBER  -- s 27(2)
        `the Authority's prior written approval`         IS A BOOLEAN
    -- s 34: major stake
    `a licensed insurer acquiring or holding a stake in a corporation` HAS
        `percentage of shares`                           IS A NUMBER
        `percentage of voting power`                     IS A NUMBER
        `the insurer directs the corporation's directors or policy` IS A BOOLEAN
        `security, debt satisfaction or a prescribed interest` IS A BOOLEAN    -- s 34(6)
        `the Authority's prior approval`                 IS A BOOLEAN
    -- s 87: control of a broker
    `agreeing to acquire shares of a registered insurance broker` HAS
        `percentage of share capital with associates`    IS A NUMBER
        `percentage of voting power with associates`     IS A NUMBER
        `notified and approved by the Authority`         IS A BOOLEAN
    -- s 35, 36: appointments
    `appointing a key executive person, chairperson or director` HAS
        `the Authority's approval`                       IS A BOOLEAN
        `a disqualification under s 36(1)(c)-(h)`        IS A BOOLEAN
        `the Authority's consent despite it`             IS A BOOLEAN
    -- s 37, 89: unsecured loans
    `granting an unsecured loan or advance` HAS
        `by a registered insurance broker (s 89)`        IS A BOOLEAN
        `to a director (or a director's relative)`       IS A BOOLEAN
        `a director who is the broker's employee`        IS A BOOLEAN
        `aggregate outstanding`                          IS A NUMBER
        `the employee's one year of emolument`           IS A NUMBER
    -- s 16(7)(c): surplus account
    `allocating to the surplus account of a participating fund` HAS
        `fund`                                           IS A `Fund facts`
    -- s 16(10): withdrawal from a fund
    `withdrawing from an insurance fund` HAS
        `amount`                                         IS A NUMBER
        `surplus of assets over liabilities, per the latest lodged accounts` IS A NUMBER
        `the fund solvency requirement`                  IS A NUMBER
        `an instrument or contract disallows it`         IS A BOOLEAN
    -- s 22: premiums
    `issuing a life or long-term accident and health policy` HAS
        `at rates fixed or approved by the appointed actuary` IS A BOOLEAN

DECLARE `Regulatory case` HAS
    `person`                                             IS A Standing
    `activity`                                           IS AN Activity
    `place`                                              IS A `Place of the act`
    `prescribed as a compoundable offence`               IS A BOOLEAN

§§ `Policies (First Schedule; ss 146-151)`

-- First Schedule para 2(4)(a): the residence facts of an individual.
DECLARE `Residence status` IS ONE OF
    `a citizen`
    `a permanent resident`
    `a work pass or permit holder`
    `a holder of another pass longer than 90 days`
    `none of these`

DECLARE `Residence facts` HAS
    `status`                                             IS A `Residence status`
    `years resided continuously outside Singapore before the proposal` IS A NUMBER  -- citizens
    `currently residing in Singapore`                    IS A BOOLEAN
    `days resided in Singapore in the 12 months before the proposal` IS A NUMBER
    `days continuously resided in Singapore in those 12 months` IS A NUMBER

DECLARE `Kind of policy` IS ONE OF
    `a life policy`
    `an accident and health policy`
    `a general insurance policy`

-- s 146(1)(b): whose life is insured, relative to the person effecting it.
DECLARE `Life insured` IS ONE OF
    `the person's own life`
    `the person's spouse`
    `the person's child or ward under 18`
    `a person on whom the person is wholly or partly dependent`
    `another person`

DECLARE `Policy case` HAS
    `kind`                                               IS A `Kind of policy`
    `issued on`                                          IS A DATE
    `issued in the course of business in Singapore`      IS A BOOLEAN
    `the owner (or insured) is an individual`            IS A BOOLEAN
    `residence of the owner or insured`                  IS A `Residence facts`
    `a non-individual: Singapore address, residence or permanent establishment` IS A BOOLEAN -- First Sch para 2(1)(a)(ii), (b)(ii)
    `the risk arises in Singapore`                       IS A BOOLEAN   -- para 2(1)(b)
    `cargo carried between places outside Singapore`     IS A BOOLEAN   -- para 2(2)
    `insurance on ships or goods, or a contract of indemnity` IS A BOOLEAN -- s 151(4)
    `may be in force more than 5 years, insurer cannot end it but for fraud or non-disclosure` IS A BOOLEAN -- First Sch para 9
    `life insured`                                       IS A `Life insured`
    `insurable interest of the person effecting it`      IS A NUMBER     -- 0 if none
    `a trust policy meeting s 146(3) or (4)`             IS A BOOLEAN
    `sum insured`                                        IS A NUMBER
    `age of the person entering the contract`            IS A NUMBER
    `written consent of a parent or guardian`            IS A BOOLEAN
    `years in force`                                     IS A NUMBER
    `an annuity, or no policy moneys necessarily payable` IS A BOOLEAN   -- s 149(5)

§§ `Nominations and payout (Part 3C; s 150)`

DECLARE `Nomination kind` IS ONE OF
    `no nomination`
    `a trust nomination under s 132`
    `a revocable nomination under s 133`

DECLARE `Nominee` HAS
    `name`                                               IS A STRING
    `the owner's spouse or child`                        IS A BOOLEAN
    `portion`                                            IS A NUMBER    -- the share of the moneys, as a fraction
    `alive`                                              IS A BOOLEAN

DECLARE `Estate facts` HAS
    `nomination`                                         IS A `Nomination kind`
    `nominees`                                           IS A LIST OF `Nominee`
    `owner's age at nomination`                          IS A NUMBER
    `intends to create a trust`                          IS A BOOLEAN
    `nomination revoked or deemed revoked`               IS A BOOLEAN
    `dealt with the policy, or a later will or nomination disposes of it` IS A BOOLEAN  -- s 133(7)
    `a will disposing of all death benefits, not revoked` IS A BOOLEAN
    `the insurer has written notice of the nomination or will` IS A BOOLEAN
