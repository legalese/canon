IMPORT prelude
IMPORT `oca-offences`

-- Organised Crime Act 2015, ss 2, 5, 6, 7, 8-13, 17, 22, 26, 27, 39, 44, 74 and 79 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_organised-crime-act-2015.py). Expected results were written by
-- hand from the text.

`a local drug syndicate of five` MEANS Group WITH
    `number of individuals` IS 5
    `seeks benefit from a serious offence` IS TRUE
    `seeks benefit from a foreign act that would be a serious offence` IS FALSE
    `seeks benefit from a serious scam offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious scam offence` IS FALSE

`a pair of drug dealers` MEANS Group WITH
    `number of individuals` IS 2
    `seeks benefit from a serious offence` IS TRUE
    `seeks benefit from a foreign act that would be a serious offence` IS FALSE
    `seeks benefit from a serious scam offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious scam offence` IS FALSE

`an overseas syndicate profiting only from acts abroad` MEANS Group WITH
    `number of individuals` IS 10
    `seeks benefit from a serious offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious offence` IS TRUE
    `seeks benefit from a serious scam offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious scam offence` IS FALSE

`a scam syndicate` MEANS Group WITH
    `number of individuals` IS 20
    `seeks benefit from a serious offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious offence` IS FALSE
    `seeks benefit from a serious scam offence` IS TRUE
    `seeks benefit from a foreign act that would be a serious scam offence` IS FALSE

`an overseas scam call centre` MEANS Group WITH
    `number of individuals` IS 30
    `seeks benefit from a serious offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious offence` IS FALSE
    `seeks benefit from a serious scam offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious scam offence` IS TRUE

`a social club` MEANS Group WITH
    `number of individuals` IS 40
    `seeks benefit from a serious offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious offence` IS FALSE
    `seeks benefit from a serious scam offence` IS FALSE
    `seeks benefit from a foreign act that would be a serious scam offence` IS FALSE

`a person in Singapore who knows` MEANS Accused WITH
    `is in Singapore` IS TRUE
    `is an individual` IS TRUE
    `knows what the group is` IS TRUE
    `has reasonable grounds to believe what the group is` IS TRUE

`a person in Singapore with grounds only` MEANS Accused WITH
    `is in Singapore` IS TRUE
    `is an individual` IS TRUE
    `knows what the group is` IS FALSE
    `has reasonable grounds to believe what the group is` IS TRUE

`an unwitting person in Singapore` MEANS Accused WITH
    `is in Singapore` IS TRUE
    `is an individual` IS TRUE
    `knows what the group is` IS FALSE
    `has reasonable grounds to believe what the group is` IS FALSE

`a person abroad who knows` MEANS Accused WITH
    `is in Singapore` IS FALSE
    `is an individual` IS TRUE
    `knows what the group is` IS TRUE
    `has reasonable grounds to believe what the group is` IS TRUE

`a person abroad with grounds only` MEANS Accused WITH
    `is in Singapore` IS FALSE
    `is an individual` IS TRUE
    `knows what the group is` IS FALSE
    `has reasonable grounds to believe what the group is` IS TRUE

