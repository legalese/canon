@lang en
IMPORT prelude
IMPORT daydate

-- AIA Khoe Tron Ven, product rules and terms V012022 (approved by Ministry of Finance letter
-- 14632/BTC-QLBH of 23 December 2021). THE NOUNS: DECLARE and nothing else. Every rule
-- module imports this one.
--
-- Source: ../../source/raw/aia-khoe-tron-ven.txt (pdftotext -layout of the insurer's PDF,
-- retrieved 2026-10-06). A `src:N` comment quotes line N of that file, generated by
-- tools/vnsrc.py; `@N` in a `vi:` note below points at the line where the Vietnamese term
-- appears. Nothing in Vietnamese here is typed by hand: each quoted run is checked against
-- the source by `vnsrc.py check`.
--
-- Money is Vietnamese dong (VND) as a bare NUMBER. Ages are in completed years (NOTES.md,
-- fork F2). Dates are calendar dates; durations named "months", "days" or "hours" are counts
-- of that unit as a medical record or a certificate states them.
--
-- Membership test for this module: a witness of ordinary competence could testify to the
-- fact, or a certificate, a medical record or the Company's books record it. Whether the
-- fact makes a benefit payable is a rule, and belongs in the module of the Article or Annex
-- that says so.

§ `Nouns of the Khoe Tron Ven rules and terms`

§§ `Parties`

-- src:43 | Những từ “Công ty”, “AIA Việt Nam” được hiểu là Công ty Trách Nhiệm Hữu Hạn Bảo hiểm Nhân
-- src:44 | thọ AIA (Việt Nam); từ “Khách hàng” được hiểu là Bên mua bảo hiểm và/hoặc Người được bảo
-- src:45 | hiểm.
-- where: preamble
DECLARE Party IS ONE OF
    `the Company`                -- vi: "Công ty" @43
    `the policyowner`            -- vi: "Bên mua bảo hiểm" @44
    `the insured`                -- vi: "Người được bảo hiểm" @44
    `a beneficiary`              -- vi: "Người thụ hưởng" @703

-- What a party does under the regulative rules (Articles 11, 16, 25, 27, 33, 36).
-- where: Điều 11, 16, 25, 27, 33, 36
DECLARE `Act under the contract` IS ONE OF
    `give notice refusing to continue the contract`                -- vi: "từ chối tiếp tục tham gia Hợp đồng bảo hiểm" @388
    `terminate the contract and refund the premiums`
        HAS `the refund` IS A NUMBER                                -- vi: "chấm dứt Hợp đồng bảo hiểm" @393
    `submit the claim file`                                        -- vi: "nộp hồ sơ yêu cầu giải quyết quyền lợi bảo hiểm" @860
    `pay the benefit`
        HAS `the amount` IS A NUMBER                                -- vi: "chi trả quyền lợi bảo hiểm" @909
    `pay the benefit with interest on the late amount`
        HAS `the amount` IS A NUMBER                                -- vi: "trả lãi trên số tiền chậm trả" @910
    `request a change of premium frequency`                        -- vi: "Yêu cầu thay đổi định kỳ đóng phí" @509
    `notify the Company of travel abroad or a change of occupation` -- vi: "thông báo trước cho Công ty" @1089
    `notify the Company in writing of a United States tax matter`  -- vi: "thông báo cho Công ty bằng văn bản" @1200

§§ `The persons — Annex 1`

-- where: Phụ lục 4
DECLARE Sex IS ONE OF
    `male`                       -- vi: "Nam" @1868
    `female`                     -- vi: "Nữ" @1922

-- where: Phụ lục 1
DECLARE `Kind of policyowner` IS ONE OF
    `an individual`              -- vi: "cá nhân" @1311
    `an organisation`            -- vi: "tổ chức" @1311

-- `age in completed years` matters only for an individual; `lawfully established and
-- operating in Vietnam` only for an organisation. `alive` is what Article 28 asks.
-- where: Phụ lục 1
DECLARE Policyowner HAS
    `kind`                                            IS A `Kind of policyowner`     -- vi: "Bên mua bảo hiểm" @1311
    `age in completed years`                          IS A NUMBER                    -- vi: "từ 18 tuổi trở lên" @1311
    `full civil legal capacity`                       IS A BOOLEAN                   -- vi: "năng lực hành vi dân sự đầy đủ" @1311
    `lawfully established and operating in Vietnam`   IS A BOOLEAN                   -- vi: "thành lập và hoạt động hợp pháp tại Việt Nam" @1312
    `alive`                                           IS A BOOLEAN                   -- vi: "đã tử vong" @948

-- where: Phụ lục 1
DECLARE `Insured person` HAS
    `date of birth`                                       IS A DATE                  -- vi: "tuổi" @1307
    `sex`                                                 IS A Sex                   -- vi: "giới tính" @1719
    `living in Vietnam when the application was submitted` IS A BOOLEAN              -- vi: "hiện đang sinh sống tại Việt Nam tại thời điểm" @1306
    `one in whom the policyowner has an insurable interest` IS A BOOLEAN             -- vi: "có quyền lợi có thể được bảo hiểm với Bên mua bảo hiểm" @1305
    `accepted for insurance by the Company`               IS A BOOLEAN               -- vi: "Công ty chấp thuận bảo hiểm" @1306

-- `designated share` is the fraction of the death benefit the policyowner designated for
-- this beneficiary (0 to 1).
-- where: Điều 23, 28
DECLARE Beneficiary HAS
    `designated share`                                IS A NUMBER                    -- vi: "phần quyền lợi bảo hiểm mà Người thụ hưởng này được chỉ định" @711
    `took part in the insurance fraud`                IS A BOOLEAN                   -- vi: "tham gia vào các hành vi đó" @710
    `died before or at the same time as the insured`  IS A BOOLEAN                   -- vi: "tử vong trước hoặc cùng thời điểm tử vong" @945

§§ `The policy and its accounts`

-- where: Phụ lục 1
DECLARE `Premium frequency` IS ONE OF
    `monthly`                    -- vi: "hàng tháng" @1416
    `quarterly`                  -- vi: "hàng quý" @1416
    `half-yearly`                -- vi: "nửa năm" @1416
    `yearly`                     -- vi: "năm" @1416

-- What the certificate (Giấy chứng nhận bảo hiểm) and the Company's books record.
-- `date the Company accepted the insurance` is the date Article 23(c)(i) counts its 90 days
-- from; it is not the effective date, which Annex 1 defines as the day the application was
-- completed and the first premium paid (NOTES.md, finding X4).
-- where: Phụ lục 1; Điều 23
DECLARE Policy HAS
    `effective date`                           IS A DATE                             -- vi: "Ngày có hiệu lực của hợp đồng" @1384
    `date the Company accepted the insurance`  IS A DATE                             -- vi: "ngày Công ty chấp thuận bảo hiểm" @756
    `date of the latest reinstatement`         IS A MAYBE DATE                       -- vi: "ngày khôi phục hiệu lực hợp đồng gần nhất" @757
    `premium frequency`                        IS A `Premium frequency`              -- vi: "Định kỳ đóng phí" @1415
    `the insured`                              IS AN `Insured person`                -- vi: "Người được bảo hiểm" @1305
    `the policyowner`                          IS A Policyowner                      -- vi: "Bên mua bảo hiểm" @1311

-- The figures a benefit formula reads, as they stand at one date (the diagnosis, the death,
-- the disablement, a withdrawal). Each is in the Company's books on that date.
-- `debts` is 0 where there are none ("các khoản nợ (nếu có)").
-- where: Điều 1, 2, 6, 12, 22, 24
DECLARE `Account snapshot` HAS
    `sum insured`                IS A NUMBER                                         -- vi: "Số tiền bảo hiểm" @1372
    `basic account value`        IS A NUMBER                                         -- vi: "Giá trị tài khoản cơ bản" @1447
    `top-up account value`       IS A NUMBER                                         -- vi: "Giá trị tài khoản đóng thêm" @1453
    `debts`                      IS A NUMBER                                         -- vi: "Khoản nợ" @1507
    `annualised basic premium`   IS A NUMBER                                         -- vi: "Phí bảo hiểm cơ bản quy năm" @234

§§ `Benefits`

-- where: Phụ lục 5
DECLARE `Kind of cancer` IS ONE OF
    `early-stage cancer`         -- vi: "Ung thư giai đoạn sớm" @1995
    `carcinoma in situ`          -- vi: "Ung thư biểu mô tại chỗ" @1996
    `major cancer`               -- vi: "Ung thư nghiêm trọng" @1997
    `extended major cancer`      -- vi: "Ung thư nghiêm trọng mở rộng" @1998

-- where: Phụ lục 6
DECLARE `Early-stage critical illness` IS ONE OF
    `minimally invasive coronary artery bypass surgery`            -- vi: "Phẫu thuật bắc cầu động mạch vành xâm lấn tối thiểu" @2303
    `percutaneous coronary intervention`                           -- vi: "Thủ thuật can thiệp mạch vành qua da" @2308
    `implantation of a pacemaker or defibrillator`                 -- vi: "Đặt máy tạo nhịp tim hoặc máy khử rung tim" @2326
    `carotid artery angioplasty and stenting`                      -- vi: "Nong và đặt stent động mạch cảnh" @2339
    `minimally invasive treatment of heart valve disease`          -- vi: "Điều trị bệnh van tim ít xâm lấn" @2357
    `insertion of a vena cava filter`                              -- vi: "Đặt màng lọc tĩnh mạch chủ" @2376
    `coma lasting at least 48 hours`                               -- vi: "Hôn mê kéo dài ít nhất 48 giờ" @2385
    `cerebral ventricular shunt surgery`                           -- vi: "Phẫu thuật dẫn lưu não thất" @2397
    `surgical removal of a pituitary tumour`                       -- vi: "Phẫu thuật cắt bỏ u tuyến yên" @2401
    `brain damage`                                                 -- vi: "Tổn thương não" @2408
    `small bowel transplant`                                       -- vi: "Ghép ruột non" @2443
    `liver surgery`                                                -- vi: "Phẫu thuật gan" @2461
    `cirrhosis due to viral hepatitis`                             -- vi: "Xơ gan do viêm gan siêu vi" @2480
    `removal of one lung`                                          -- vi: "Phẫu thuật cắt bỏ một bên phổi" @2485
    `kidney disease`                                               -- vi: "Bệnh thận" @2495
    `less severe systemic lupus erythematosus`                     -- vi: "Bệnh Lupus ban đỏ hệ thống ít nghiêm trọng" @2510
    `temporary aplastic anaemia`                                   -- vi: "Thiếu máu bất sản tạm thời" @2538
    `corneal transplant`                                           -- vi: "Ghép giác mạc" @2563
    `loss of sight in one eye`                                     -- vi: "Mất thị lực một mắt" @2578
    `loss of hearing in one ear`                                   -- vi: "Mất thính lực một tai" @2585
    `minor burns`                                                  -- vi: "Bỏng mức độ nhẹ" @2594
    `paralysis of one limb`                                        -- vi: "Liệt một chi" @2598
    `reconstructive surgery of a face injured in an Accident`      -- vi: "Phẫu thuật phục hồi khuôn mặt bị tổn thương do Tai nạn" @2603

-- where: Phụ lục 7
DECLARE `Severe-stage critical illness` IS ONE OF
    `coronary artery bypass surgery`                               -- vi: "Phẫu thuật bắc cầu động mạch vành" @2641
    `heart attack`                                                 -- vi: "Nhồi máu cơ tim" @2647
    `severe cardiomyopathy`                                        -- vi: "Bệnh cơ tim nặng" @2664
    `heart valve surgery`                                          -- vi: "Phẫu thuật van tim" @2695
    `surgery to the aorta`                                         -- vi: "Phẫu thuật động mạch chủ" @2716
    `primary pulmonary arterial hypertension`                      -- vi: "Tăng áp lực động mạch phổi nguyên phát" @2724
    `coma lasting at least 96 hours`                               -- vi: "Hôn mê kéo dài ít nhất 96 giờ" @2739
    `stroke`                                                       -- vi: "Đột quỵ" @2750
    `benign brain tumour`                                          -- vi: "U não lành tính" @2776
    `severe head injury`                                           -- vi: "Chấn thương đầu nặng" @2801
    `open brain surgery`                                           -- vi: "Phẫu thuật não hở" @2829
    `Alzheimer disease or dementia`                                -- vi: "Bệnh Alzheimer hoặc Sa sút trí tuệ" @2840
    `motor neurone disease`                                        -- vi: "Bệnh tế bào thần kinh vận động" @2852
    `multiple sclerosis`                                           -- vi: "Bệnh xơ cứng rải rác" @2871
    `severe viral encephalitis`                                    -- vi: "Viêm não nặng do vi rút" @2896
    `bacterial meningitis`                                         -- vi: "Viêm màng não do vi khuẩn" @2915
    `severe Parkinson disease`                                     -- vi: "Bệnh Parkinson nặng" @2920
    `poliomyelitis`                                                -- vi: "Bại liệt" @2942
    `chronic liver failure`                                        -- vi: "Suy gan mạn" @2961
    `fulminant viral hepatitis`                                    -- vi: "Viêm gan siêu vi tối cấp" @2978
    `chronic relapsing pancreatitis`                               -- vi: "Viêm tụy mạn tính tái phát" @3006
    `chronic lung disease`                                         -- vi: "Bệnh phổi mạn tính" @3022
    `kidney failure`                                               -- vi: "Suy thận" @3035
    `systemic lupus erythematosus`                                 -- vi: "Bệnh Lupus ban đỏ hệ thống" @3039
    `aplastic anaemia`                                             -- vi: "Thiếu máu bất sản" @3073
    `bone marrow transplant`                                       -- vi: "Ghép tủy xương" @3106
    `major organ transplant`                                       -- vi: "Ghép tạng" @3111
    `severe burns`                                                 -- vi: "Bỏng nặng" @3121
    `loss of independent existence`                                -- vi: "Mất khả năng sống độc lập" @3125
    `HIV infection from an occupational accident`                  -- vi: "Nhiễm HIV do tai nạn nghề nghiệp" @3155
    `muscular dystrophy`                                           -- vi: "Loạn dưỡng cơ" @3208
    `loss of hearing`                                              -- vi: "Mất thính lực" @3229
    `loss of speech`                                               -- vi: "Mất khả năng phát âm" @3235
    `terminal illness`                                             -- vi: "Bệnh giai đoạn cuối" @3244
    `Still disease`                                                -- vi: "Bệnh Still" @3260
    `severe haemophilia`                                           -- vi: "Bệnh Hemophilia nặng" @3274
    `rheumatic heart disease`                                      -- vi: "Bệnh thấp tim" @3306
    `osteogenesis imperfecta`                                      -- vi: "Bệnh xương thủy tinh" @3314
    `type 1 diabetes`                                              -- vi: "Tiểu đường tuýp 1" @3329
    `Kawasaki disease with cardiac complications`                  -- vi: "Bệnh Kawasaki có biến chứng tim" @3340
    `glomerulonephritis with nephrotic syndrome`                   -- vi: "Viêm cầu thận có hội chứng thận hư" @3362
    `severe hand, foot and mouth disease`                          -- vi: "Bệnh tay chân miệng nặng" @3380
    `Wilson disease`                                               -- vi: "Bệnh Wilson" @3410
    `generalised tetanus`                                          -- vi: "Uốn ván thể toàn thân" @3421
    `status epilepticus`                                           -- vi: "Trạng thái động kinh" @3436

-- Every benefit the document names, so that a payment can be recorded against it.
-- where: Điều 1-10, 29
DECLARE Benefit IS ONE OF
    `the cancer benefit for`
        HAS `the kind of cancer` IS A `Kind of cancer`              -- vi: "Quyền lợi bảo hiểm Bệnh ung thư" @54
    `the early-stage critical illness benefit for`
        HAS `the early-stage condition` IS AN `Early-stage critical illness`   -- vi: "Bệnh hiểm nghèo giai đoạn sớm" @136
    `the severe-stage critical illness benefit for`
        HAS `the severe-stage condition` IS A `Severe-stage critical illness`  -- vi: "Bệnh hiểm nghèo giai đoạn nghiêm trọng" @140
    `the ICU benefit`                                              -- vi: "Quyền lợi bảo hiểm khi điều trị tại Phòng Chăm sóc đặc biệt" @220
    `the premium-support benefit`                                  -- vi: "quyền lợi hỗ trợ duy trì hiệu lực hợp đồng" @244
    `the cancer-screening support`                                 -- vi: "Khoản hỗ trợ chi phí tầm soát Bệnh ung thư" @281
    `the TPD benefit`                                              -- vi: "Quyền lợi bảo hiểm TTTB&VV" @731
    `the death benefit`                                            -- vi: "quyền lợi bảo hiểm tử vong" @691
    `the loyalty bonus`                                            -- vi: "Quyền lợi thưởng duy trì đóng phí" @344
    `the maturity benefit`                                         -- vi: "quyền lợi đáo hạn" @939
    `the temporary-cover benefit`                                  -- vi: "bảo hiểm tạm thời" @968

-- where: Điều 1, 2, 3, 4, 6, 24
DECLARE `Payment already made` HAS
    `the benefit`                IS A Benefit                                        -- vi: "đã được chi trả" @106
    `the amount`                 IS A NUMBER                                         -- vi: "Tổng quyền lợi bảo hiểm đã chi trả" @779

§§ `The circumstances of an insured event — Article 23 and Annex 1`

-- where: Phụ lục 1
DECLARE `Person who can commit insurance fraud` IS ONE OF
    `the policyowner, as fraudster`        -- vi: "Bên mua bảo hiểm" @1514
    `the insured, as fraudster`            -- vi: "Người được bảo hiểm" @1514
    `a beneficiary, as fraudster`          -- vi: "Người thụ hưởng" @1514

-- where: Phụ lục 1 (Hành vi gian lận bảo hiểm)
DECLARE `Act of insurance fraud` HAS
    `committed by`                                                         IS A `Person who can commit insurance fraud`   -- vi: "Hành vi gian lận bảo hiểm" @1514
    `using forged documents or deliberately falsifying the claim file`     IS A BOOLEAN  -- vi: "sử dụng các chứng từ, tài liệu giả mạo hoặc cố ý làm sai lệch thông tin" @1515
    `harming the life or health of the insured to claim a benefit`         IS A BOOLEAN  -- vi: "gây thiệt hại về tính mạng, sức khỏe của Người được bảo hiểm" @1521

-- The activities Article 23(b)(vi) names after "như" (such as), and the rest.
-- where: Điều 23(b)(vi)
DECLARE `Sport or recreational activity` IS ONE OF
    `scuba diving`                         -- vi: "lặn có bình dưỡng khí" @743
    `bungee jumping`                       -- vi: "nhảy bungee" @744
    `mountain climbing`                    -- vi: "leo núi" @745
    `horse racing`                         -- vi: "đua ngựa" @745
    `vehicle racing`                       -- vi: "đua xe" @745
    `another sport or recreational activity`  -- vi: "các hoạt động thể thao hoặc giải trí" @743

-- Each field records whether the insured event was caused by ("do") the thing named.
-- `air travel other than ...` already carries the exception of Article 23(b)(vii).
-- where: Điều 23
DECLARE `Circumstances of the insured event` HAS
    `suicide by the insured`                                                IS A BOOLEAN  -- vi: "Hành vi tự tử của Người được bảo hiểm" @693
    `acts of insurance fraud`                                               IS A LIST OF `Act of insurance fraud`  -- vi: "Hành vi gian lận bảo hiểm" @703
    `a breach of the law on alcohol concentration`                          IS A BOOLEAN  -- vi: "Vi phạm quy định của pháp luật về nồng độ cồn" @739
    `use of narcotics without a doctor's prescription`                      IS A BOOLEAN  -- vi: "Sử dụng chất ma túy không có chỉ định của Bác sĩ" @740
    `use of medicine without a doctor's prescription`                       IS A BOOLEAN  -- vi: "Sử dụng thuốc không có chỉ định của Bác sĩ" @761
    `fighting or resisting arrest by a competent authority`                 IS A BOOLEAN  -- vi: "Đánh nhau hay chống lại việc bắt giữ của cơ quan có thẩm quyền" @741
    `self-inflicted injury`                                                 IS A BOOLEAN  -- vi: "Tự gây thương tích cho bản thân" @742
    `a sport or recreational activity`                                      IS A MAYBE `Sport or recreational activity`  -- vi: "Tham gia các hoạt động thể thao hoặc giải trí nguy hiểm" @743
    `air travel`                                                            IS A BOOLEAN  -- vi: "Di chuyển trên các phương tiện hàng không" @746
    `as passenger or crew on a licensed, regularly scheduled commercial flight` IS A BOOLEAN  -- vi: "hành khách hoặc phi hành đoàn trên các chuyến bay" @747

§§ `Medical facilities, doctors, accidents — Annex 1`

-- where: Phụ lục 1 (Bệnh viện)
DECLARE `Medical facility` HAS
    `established and operating under the law of Vietnam or of the host country`  IS A BOOLEAN  -- vi: "được thành lập và hoạt động theo pháp luật của" @1650
    `licensed as a hospital under the rules of Vietnam or of the host country`    IS A BOOLEAN  -- vi: "được cấp phép như một Bệnh viện" @1655
    `in Vietnam`                                                                  IS A BOOLEAN  -- vi: "trong lãnh thổ Việt Nam" @1662
    `its official seal shows the word for hospital`                               IS A BOOLEAN  -- vi: "trên con dấu chính thức" @1663
    `its status is shown in the local language by a word understood as hospital`  IS A BOOLEAN  -- vi: "lãnh thổ đó mà được hiểu là" @1670
    `established for convalescence, nursing, elderly care, or alcohol or drug rehabilitation, or a similar purpose` IS A BOOLEAN  -- vi: "điều dưỡng, dưỡng bệnh, người già an dưỡng" @1676
    `at provincial level or higher, or equivalent`                                IS A BOOLEAN  -- vi: "Bệnh viện tuyến tỉnh trở lên hoặc tương đương" @219

-- where: Phụ lục 1 (Phòng Chăm sóc đặc biệt)
DECLARE `Intensive care unit` HAS
    `the hospital it belongs to`                                       IS A `Medical facility`  -- vi: "là một bộ phận của Bệnh viện" @1553
    `established for special care and treatment`                       IS A BOOLEAN  -- vi: "được thành lập để chăm sóc và điều trị đặc biệt" @1560
    `reserved for critically ill patients needing a Doctor's continuous monitoring` IS A BOOLEAN  -- vi: "dành riêng cho các bệnh nhân trong điều kiện nguy kịch" @1567
    `equipped to save patients' lives quickly`                         IS A BOOLEAN  -- vi: "được trang bị các thiết bị, thuốc, phương tiện khác cần thiết cho việc cứu" @1574
    `a post-operative recovery room or an emergency room`              IS A BOOLEAN  -- vi: "phòng hậu phẫu hoặc phòng cấp cứu" @1581

-- where: Phụ lục 1 (Bác sĩ); Điều 38
DECLARE Doctor HAS
    `medically qualified in western medicine`                           IS A BOOLEAN  -- vi: "bằng cấp chuyên môn y khoa trong lĩnh vực tây y" @1617
    `licensed or recognised to practise medicine lawfully`              IS A BOOLEAN  -- vi: "có thẩm quyền cấp phép hoặc thừa nhận được hành nghề y hợp pháp" @1623
    `acting within the scope of the licence where the examination or treatment takes place` IS A BOOLEAN  -- vi: "trong phạm vi giấy phép" @1624
    `the insured's spouse, parent, child or sibling`                    IS A BOOLEAN  -- vi: "vợ/chồng, cha/mẹ, con, anh chị em ruột" @1246

-- where: Phụ lục 1 (Tai nạn)
DECLARE Accident HAS
    `an objective event or continuous chain of events`                  IS A BOOLEAN  -- vi: "một sự kiện hoặc một chuỗi sự kiện liên tục, khách quan" @1637
    `caused by a sudden external force or object`                       IS A BOOLEAN  -- vi: "do tác động của một lực hoặc một vật bất ngờ, từ bên ngoài" @1637
    `unintended and against the insured's will`                         IS A BOOLEAN  -- vi: "ngoài ý muốn của Người được bảo hiểm" @1641
    `caused injury or death to the insured`                             IS A BOOLEAN  -- vi: "gây ra thương tật hoặc cái chết cho Người được bảo hiểm" @1641
    `the direct and sole cause, unrelated to any other cause`           IS A BOOLEAN  -- vi: "duy nhất và không liên quan đến bất kỳ nguyên nhân nào" @1644
    `days from the event to the injury or death`                        IS A NUMBER   -- vi: "trong vòng 180 ngày kể từ ngày xảy ra sự kiện" @1645

§§ `Total and permanent disability — Annex 1`

-- where: Phụ lục 1 (TTTB&VV)
DECLARE `Part of the body` IS ONE OF
    `a hand`                     -- vi: "tay" @1586
    `a foot`                     -- vi: "chân" @1587
    `an eye`                     -- vi: "mắt" @1589

-- where: Phụ lục 1 (TTTB&VV)
DECLARE `Manner of loss` IS ONE OF
    `physical loss`                                       -- vi: "mất hẳn mắt" @1597
    `complete and irrecoverable paralysis or blindness`   -- vi: "liệt hoàn toàn và không thể phục hồi" @1607

-- `at or above the wrist or the ankle` is asked of a hand or a foot lost physically.
-- where: Phụ lục 1 (TTTB&VV)
DECLARE `Loss of a hand, a foot or an eye` HAS
    `the part`                                  IS A `Part of the body`              -- vi: "chức năng của" @1584
    `the manner`                                IS A `Manner of loss`                -- vi: "Bị mất hoặc liệt hoàn toàn và không thể phục hồi" @1584
    `at or above the wrist or the ankle`        IS A BOOLEAN                         -- vi: "được tính từ mắt cá chân trở lên" @1605
    `date confirmed`                            IS A DATE                            -- vi: "Việc xác nhận" @1605

-- where: Phụ lục 1 (TTTB&VV); Điều 6, 26
DECLARE Disablement HAS
    `date of the insured event`                                         IS A DATE     -- vi: "ngày xảy ra sự kiện bảo hiểm" @1609
    `the losses`                                                        IS A LIST OF `Loss of a hand, a foot or an eye`  -- vi: "Bị mất hoặc liệt hoàn toàn" @1584
    `assessed percentage of bodily injury or permanent loss of working capacity` IS A MAYBE NUMBER  -- vi: "tỷ lệ tổn thương cơ thể hoặc mất sức lao động vĩnh viễn" @1611
    `assessed by a provincial Medical Assessment Council or a lawful medical organisation the Company approves` IS A BOOLEAN  -- vi: "Hội Đồng Giám Định Y Khoa cấp tỉnh" @1612
    `date of the assessment`                                            IS A DATE     -- vi: "không sớm hơn 6 tháng kể từ ngày xảy ra sự kiện" @1614

§§ `Daily activities, used by several Annex 6 and 7 definitions`

-- where: Phụ lục 6 (10); Phụ lục 7 (10, 17, 29)
DECLARE `Activity of daily living` IS ONE OF
    `feeding oneself`                                     -- vi: "Tự ăn uống" @2429
    `washing oneself`                                     -- vi: "Tự tắm rửa" @2434
    `control of bladder and bowel`                        -- vi: "Tiểu tiện và đại tiện tự chủ" @2435
    `dressing without help`                               -- vi: "Thay quần áo không cần trợ giúp" @2436
    `sitting down on and getting up from a chair without help`  -- vi: "Ngồi và đứng lên khỏi ghế không cần trợ giúp" @2438
    `moving from room to room without help`               -- vi: "Di chuyển từ phòng này sang phòng khác không cần trợ giúp" @2439

§§ `Cancer — Annex 5`

-- The histological classes the Annex 5 exclusions name, and a class for everything else.
-- where: Phụ lục 5 (1)(a), (2)(a), (3)(a)
DECLARE `Histological classification` IS ONE OF
    `pre-cancerous`                                       -- vi: "tiền ung thư" @2123
    `borderline malignancy`                               -- vi: "giáp biên ung thư" @2123
    `of malignant potential`                              -- vi: "có nguy cơ ác tính" @2123
    `of low malignant potential`                          -- vi: "có nguy cơ ác tính thấp" @2210
    `suspected malignant`                                 -- vi: "nghi ngờ ác tính" @2124
    `neoplasm of uncertain behaviour`                     -- vi: "tân sinh không xác định" @2124
    `non-invasive`                                        -- vi: "không xâm lấn" @2209
    `carcinoma in situ, by histology`                     -- vi: "ung thư biểu mô tại chỗ" @2209
    `CIN I`                                               -- vi: "loạn sản nhẹ" @2211
    `CIN II`                                              -- vi: "loạn sản trung bình" @2211
    `CIN III, severe dysplasia`                           -- vi: "loạn sản nặng" @2125
    `CIN III, carcinoma in situ`                          -- vi: "loạn sản nặng hoặc ung thư biểu mô tại chỗ" @2212
    `none of the classes the exclusions name`

-- where: Phụ lục 5
DECLARE `Primary site` IS ONE OF
    `the prostate`                                        -- vi: "Ung thư tuyến tiền liệt" @2175
    `the thyroid`                                         -- vi: "Ung thư tuyến giáp" @2188
    `the bladder`                                         -- vi: "Ung thư bàng quang" @2200
    `a gastrointestinal stromal tumour`                   -- vi: "U mô đệm đường tiêu hóa" @2227
    `the skin`                                            -- vi: "Ung thư da" @2217
    `another site`

-- One record serves the three cancers of Annex 5 (1)-(3): the classification of one tumour.
-- `RAI stage of chronic lymphocytic leukaemia` is NOTHING for anything that is not CLL.
-- `mitotic count per 50 high-power fields` matters only for a GIST.
-- where: Phụ lục 5 (1)-(3)
DECLARE `Findings on a cancer` HAS
    `diagnosed by an oncologist`                                        IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa ung bướu chẩn đoán xác định" @2119
    `confirmed by histopathology or anatomical pathology`               IS A BOOLEAN  -- vi: "xét nghiệm mô bệnh học hoặc giải phẫu bệnh" @2152
    `confirmed positive on a biopsy examined under a microscope`        IS A BOOLEAN  -- vi: "xác định dương tính trên mẫu sinh thiết được quan sát dưới kính hiển vi" @2153
    `diagnosed from clinical signs only`                                IS A BOOLEAN  -- vi: "Không dựa vào chẩn đoán từ dấu hiệu lâm sàng" @2154
    `new cancer cells confined to the primary site, not invading or destroying surrounding tissue` IS A BOOLEAN  -- vi: "giới hạn tại vị trí nguyên phát, chưa xâm lấn" @2141
    `uncontrolled growth of malignant cells invading surrounding tissue` IS A BOOLEAN  -- vi: "tăng trưởng tế bào ác tính không kiểm soát và xâm lấn vào các mô xung quanh" @2206
    `a malignant tumour, leukaemia, lymphoma or sarcoma`                IS A BOOLEAN  -- vi: "u ác tính" @2205
    `histological classification`                                       IS A `Histological classification`  -- vi: "phân loại mô bệnh học" @2123
    `RAI stage of chronic lymphocytic leukaemia`                        IS A MAYBE NUMBER  -- vi: "Bệnh bạch cầu mạn dòng lympho" @2126
    `primary site`                                                      IS A `Primary site`  -- vi: "vị trí nguyên phát" @2141
    `a melanoma`                                                        IS A BOOLEAN  -- vi: "u hắc tố ác tính" @2128
    `described histologically as in situ`                               IS A BOOLEAN  -- vi: "trên mô bệnh học được mô tả là" @2127
    `invading beyond the epidermis`                                     IS A BOOLEAN  -- vi: "xâm lấn qua lớp thượng bì" @2217
    `spread to lymph nodes or distant sites`                            IS A BOOLEAN  -- vi: "di căn hạch hoặc di căn xa" @2218
    `TNM T1N0M0 or lower, or an equivalent or lower classification`     IS A BOOLEAN  -- vi: "T1N0M0 (theo phân loại TNM) hoặc thấp hơn" @2175
    `mitotic count per 50 high-power fields`                            IS A NUMBER   -- vi: "số lượng phân bào" @2227
    `in a person infected with HIV`                                     IS A BOOLEAN  -- vi: "Ung thư ở người có nhiễm HIV" @2129

-- where: Phụ lục 5 (4)(a)
DECLARE `Further finding after a major cancer` IS ONE OF
    `the major cancer has not been cured`                 -- vi: "Ung thư nghiêm trọng chưa được điều trị khỏi" @2253
    `the major cancer has recurred`                       -- vi: "Ung thư nghiêm trọng tái phát" @2255
    `the major cancer has spread to other parts of the body`  -- vi: "Ung thư nghiêm trọng đã di căn đến các bộ phận khác của cơ thể" @2256
    `another major cancer unrelated to the earlier one`   -- vi: "không liên quan đến Ung thư nghiêm trọng đã được chẩn đoán trước đó" @2260

-- where: Phụ lục 5 (4)
DECLARE `Findings on extended major cancer` HAS
    `the further finding`                                 IS A `Further finding after a major cancer`  -- vi: "tiếp tục được chẩn đoán hoặc xác nhận là" @2252
    `findings on the other cancer`                        IS A MAYBE `Findings on a cancer`  -- vi: "thỏa mãn định nghĩa tại Điều 3 Phụ Lục này" @2259
    `date of the major cancer diagnosis`                  IS A DATE      -- vi: "kể từ ngày Người được bảo hiểm được chẩn" @2272
    `the major cancer benefit was accepted for payment`   IS A BOOLEAN   -- vi: "đã được Công ty" @2273
    `date of the further diagnosis or confirmation`       IS A DATE      -- vi: "được chẩn đoán hoặc xác nhận" @2272

§§ `Early-stage critical illnesses — Annex 6, one record per definition`

-- The general conditions every critical illness must meet (Annex 1, "Bệnh hiểm nghèo") ride
-- on the diagnosis record, below; these records hold what each Annex 6 item adds.

DECLARE `Findings: minimally invasive coronary artery bypass surgery` HAS
    `keyhole surgery through a small incision between the ribs to treat a narrowed or blocked coronary artery` IS A BOOLEAN  -- vi: "phẫu thuật rạch một đường nhỏ giữa các xương sườn" @2304
    `medically necessary`                                 IS A BOOLEAN  -- vi: "cần thiết về mặt y khoa" @2306
    `performed by a cardiologist`                         IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa tim mạch thực hiện" @2306

DECLARE `Coronary procedure` IS ONE OF
    `angioplasty or stenting`                             -- vi: "Nong hoặc đặt stent" @2310
    `atherectomy, laser recanalisation or another endovascular technique`  -- vi: "Bóc nội mạc, tái thông mạch máu bằng laser" @2311
    `another coronary procedure`

DECLARE `Findings: percutaneous coronary intervention` HAS
    `the procedure`                                       IS A `Coronary procedure`  -- vi: "Là một trong các thủ thuật sau" @2309
    `to treat a narrowed or blocked coronary artery`      IS A BOOLEAN  -- vi: "để điều trị mạch vành bị hẹp hoặc bị tắc nghẽn" @2310
    `confirmed medically necessary`                       IS A BOOLEAN  -- vi: "được xác nhận là cần thiết về mặt y khoa" @2313
    `performed by a specialist`                           IS A BOOLEAN  -- vi: "do Bác sĩ chuyên khoa thực" @2313
    `greatest narrowing of a coronary branch on angiography, percent` IS A NUMBER  -- vi: "ít nhất một nhánh động mạch vành bị" @2314

DECLARE `Findings: implantation of a pacemaker or defibrillator` HAS
    `a pacemaker or defibrillator implanted`              IS A BOOLEAN  -- vi: "Đặt máy tạo nhịp tim hoặc máy khử rung tim" @2327
    `for a serious arrhythmia untreatable by other methods` IS A BOOLEAN  -- vi: "rối loạn nhịp tim nghiêm trọng không thể" @2327
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa xác nhận là cần thiết về" @2333

DECLARE `Findings: carotid artery angioplasty and stenting` HAS
    `angioplasty and stenting of a carotid artery`        IS A BOOLEAN  -- vi: "Nong và đặt stent động mạch cảnh để điều trị động mạch cảnh" @2340
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "xác nhận là cần thiết về mặt y khoa" @2341
    `greatest narrowing of a carotid artery on angiography, percent` IS A NUMBER  -- vi: "hẹp ít nhất 50% của một hay nhiều động mạch" @2345
    `an endovascular intervention such as angioplasty, stenting or endarterectomy` IS A BOOLEAN  -- vi: "Có can thiệp nội mạch như nong, đặt stent hoặc bóc nội mạc động mạch cảnh" @2351

DECLARE `Findings: minimally invasive treatment of heart valve disease` HAS
    `a percutaneous valve procedure such as valvotomy, valvuloplasty or valve replacement` IS A BOOLEAN  -- vi: "thủ thuật điều trị bệnh van tim qua da" @2358
    `confirmed medically necessary`                       IS A BOOLEAN  -- vi: "được xác nhận là cần thiết về mặt y khoa" @2364
    `performed by a specialist`                           IS A BOOLEAN  -- vi: "được Bác sĩ chuyên khoa thực hiện" @2370

DECLARE `Findings: insertion of a vena cava filter` HAS
    `surgery performed for recurrent pulmonary embolism`  IS A BOOLEAN  -- vi: "khi có thuyên tắc phổi tái phát" @2382
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa xác nhận là cần thiết về mặt y khoa" @2383

DECLARE `Findings: coma lasting at least 48 hours` HAS
    `hours of continuous coma without response to external stimuli` IS A NUMBER  -- vi: "Không đáp ứng với các kích thích bên ngoài" @2387
    `treated with mechanical ventilation`                 IS A BOOLEAN  -- vi: "Được điều trị thở máy" @2388
    `months the permanent neurological deficit from the brain damage has lasted since diagnosis` IS A NUMBER  -- vi: "di chứng thần kinh vĩnh viễn kéo dài ít nhất 3 tháng" @2389
    `confirmed by a neurologist or neurosurgeon`          IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa thần kinh hoặc ngoại thần kinh" @2391
    `caused by abuse of alcohol or addictive substances`  IS A BOOLEAN  -- vi: "lạm dụng thức uống có cồn hoặc chất gây nghiện" @2393
    `induced deliberately at a specialist's request`      IS A BOOLEAN  -- vi: "hôn mê chủ động" @2393

DECLARE `Findings: cerebral ventricular shunt surgery` HAS
    `a shunt placed in a cerebral ventricle to drain cerebrospinal fluid` IS A BOOLEAN  -- vi: "đặt ống dẫn lưu vào não thất" @2398
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa xác nhận là cần thiết về mặt y khoa" @2399

DECLARE `Findings: surgical removal of a pituitary tumour` HAS
    `the pituitary tumour was removed surgically`         IS A BOOLEAN  -- vi: "Phẫu thuật cắt bỏ u tuyến yên" @2402
    `the tumour caused raised intracranial pressure, endocrine disorder or neurological impairment by compression` IS A BOOLEAN  -- vi: "tăng áp lực nội sọ" @2402
    `diagnosis confirmed by a specialist on CT or MRI`    IS A BOOLEAN  -- vi: "chụp cắt lớp (CT) hoặc chụp cộng" @2404
    `size of the tumour, mm`                              IS A NUMBER   -- vi: "kích thước nhỏ hơn hoặc bằng 8mm" @2406

DECLARE `Findings: brain damage` HAS
    `brain damage from a head injury`                     IS A BOOLEAN  -- vi: "Chấn thương đầu gây tổn thương não" @2409
    `months the permanent neurological impairment has lasted since diagnosis` IS A NUMBER  -- vi: "suy giảm chức năng thần kinh vĩnh viễn kéo dài ít" @2409
    `activities of daily living the insured cannot perform` IS A LIST OF `Activity of daily living`  -- vi: "Hoạt động sinh hoạt hàng ngày" @2416

DECLARE `Findings: small bowel transplant` HAS
    `metres of small bowel transplanted`                  IS A NUMBER   -- vi: "ít nhất 01 (một) mét ruột non" @2448
    `with its whole blood supply, by open abdominal surgery` IS A BOOLEAN  -- vi: "kèm toàn bộ mạch máu nuôi bằng phẫu thuật mở ổ" @2448
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa xác nhận là cần thiết về mặt y khoa" @2455

DECLARE `Findings: liver surgery` HAS
    `complete removal of the left or right lobe of the liver` IS A BOOLEAN  -- vi: "cắt bỏ hoàn toàn thùy trái hoặc thùy phải gan" @2467
    `because of illness or an Accident`                   IS A BOOLEAN  -- vi: "do bệnh hoặc Tai nạn" @2467
    `for an illness related to alcohol abuse or addictive substances` IS A BOOLEAN  -- vi: "lạm dụng thức uống có cồn, sử dụng" @2468
    `to donate liver`                                     IS A BOOLEAN  -- vi: "phẫu thuật hiến gan" @2474

DECLARE `Findings: cirrhosis due to viral hepatitis` HAS
    `cirrhosis from viral hepatitis diagnosed by a gastroenterologist` IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa tiêu hóa chẩn đoán" @2481
    `on a liver biopsy`                                   IS A BOOLEAN  -- vi: "kết quả sinh" @2481
    `fibrosis at Metavir stage F4 or Knodell stage 4`     IS A BOOLEAN  -- vi: "giai đoạn F4 theo hệ thống phân loại mức độ xơ gan" @2482

DECLARE `Findings: removal of one lung` HAS
    `complete removal of one lung`                        IS A BOOLEAN  -- vi: "cắt bỏ hoàn toàn một phổi" @2486
    `because of illness or an Accident`                   IS A BOOLEAN  -- vi: "do bệnh hoặc" @2486
    `only part of a lung removed`                         IS A BOOLEAN  -- vi: "cắt bỏ một phần của phổi" @2488

DECLARE `Findings: kidney disease` HAS
    `advanced chronic kidney failure diagnosed by a specialist` IS A BOOLEAN  -- vi: "Suy thận mạn tính giai đoạn tiến triển" @2503
    `glomerular filtration rate, mL per minute per 1.73 m2` IS A NUMBER  -- vi: "độ lọc cầu" @2503
    `consecutive days the condition has lasted`           IS A NUMBER   -- vi: "kéo dài ít nhất 90 ngày liên tục" @2505
    `complete removal of the left or right kidney because of illness or an Accident` IS A BOOLEAN  -- vi: "cắt bỏ hoàn toàn thận trái hoặc thận phải" @2506
    `that removal confirmed medically necessary by a specialist` IS A BOOLEAN  -- vi: "phải được Bác sĩ chuyên khoa xác nhận là cần thiết về mặt y khoa" @2507
    `to donate a kidney`                                  IS A BOOLEAN  -- vi: "hiến thận" @2508

DECLARE `Findings: less severe systemic lupus erythematosus` HAS
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh phải được Bác sĩ chuyên khoa chẩn đoán" @2512
    `non-degenerative arthritis of two or more joints`    IS A BOOLEAN  -- vi: "Viêm khớp không thoái hóa từ 2 khớp trở lên" @2513
    `pleurisy or pericarditis`                            IS A BOOLEAN  -- vi: "Viêm màng phổi hoặc viêm màng ngoài tim" @2519
    `renal disorder: proteinuria above 0.5 g per day or cellular casts` IS A BOOLEAN  -- vi: "Rối loạn chức năng thận" @2520
    `haematological disorder: haemolytic anaemia, leukopenia or thrombocytopenia` IS A BOOLEAN  -- vi: "Rối loạn huyết học" @2526
    `positive ANA, anti-dsDNA or anti-Smith test`         IS A BOOLEAN  -- vi: "Xét nghiệm dương tính của kháng thể kháng nhân" @2532

DECLARE `Findings: temporary aplastic anaemia` HAS
    `acute reversible bone-marrow failure with anaemia, leukopenia and thrombocytopenia` IS A BOOLEAN  -- vi: "suy giảm cấp tính có khả năng hồi phục chức năng của tủy xương" @2540
    `treated by blood transfusion`                        IS A BOOLEAN  -- vi: "Truyền máu" @2545
    `treated with marrow-stimulating drugs`               IS A BOOLEAN  -- vi: "Thuốc kích thích tủy xương" @2550
    `treated with immunosuppressants`                     IS A BOOLEAN  -- vi: "Thuốc ức chế miễn dịch" @2551
    `confirmed by a haematologist`                        IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa huyết học xác nhận" @2557

DECLARE `Findings: corneal transplant` HAS
    `transplant of the whole cornea`                      IS A BOOLEAN  -- vi: "ghép toàn bộ giác mạc" @2569
    `for corneal scarring reducing sight that other methods cannot treat` IS A BOOLEAN  -- vi: "do sẹo giác mạc gây ra giảm thị lực" @2569
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "Ghép giác mạc phải được Bác sĩ chuyên khoa xác nhận" @2570

DECLARE `Findings: loss of sight in one eye` HAS
    `complete irreversible loss of sight of one eye from illness or injury` IS A BOOLEAN  -- vi: "Mất hoàn toàn và không thể phục hồi thị lực của một mắt" @2579
    `confirmed by an ophthalmologist`                     IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa mắt xác nhận" @2580
    `corrected visual acuity, Snellen denominator over 6` IS A NUMBER   -- vi: "6/60 hoặc thấp hơn bằng biểu đồ thị lực Snellen" @2581
    `remaining visual field, degrees`                     IS A NUMBER   -- vi: "trường thị giác còn 20 độ trở xuống" @2582
    `caused by abuse of alcohol or drugs`                 IS A BOOLEAN  -- vi: "Loại trừ mất thị lực do lạm dụng rượu" @2582

DECLARE `Findings: loss of hearing in one ear` HAS
    `complete irreversible loss of hearing in one ear from illness or injury` IS A BOOLEAN  -- vi: "Mất hoàn toàn và không thể phục hồi thính lực của một tai" @2586
    `confirmed by an ear, nose and throat specialist`     IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa tai mũi họng xác nhận" @2587
    `hearing loss at every frequency, decibels`           IS A NUMBER   -- vi: "từ 80 decibels (dB) trở lên ở tất cả các tần số nghe" @2588
    `months from the diagnosis to the audiometry`         IS A NUMBER   -- vi: "thực hiện không sớm hơn 3" @2588

DECLARE `Findings: minor burns` HAS
    `third-degree burns caused by an accident`            IS A BOOLEAN  -- vi: "Bỏng độ 3 do tai nạn" @2595
    `percent of the body surface burnt`                   IS A NUMBER   -- vi: "ít nhất 10% diện tích bề mặt da" @2595
    `percent of the face burnt`                           IS A NUMBER   -- vi: "30% diện tích" @2595

DECLARE `Findings: paralysis of one limb` HAS
    `complete permanent loss of function of at least one arm or one leg from illness or injury` IS A BOOLEAN  -- vi: "mất chức năng hoàn toàn và vĩnh viễn chức năng của ít nhất một tay hoặc một chân" @2599
    `months it has lasted since diagnosis`                IS A NUMBER   -- vi: "kéo dài ít nhất 3 tháng kể từ ngày được chẩn đoán" @2600
    `muscle power grade`                                  IS A NUMBER   -- vi: "sức cơ được" @2600

DECLARE `Findings: reconstructive surgery of a face injured in an Accident` HAS
    `reconstructive or plastic surgery of a face injured in an Accident` IS A BOOLEAN  -- vi: "phẫu thuật tái tạo hoặc tạo hình khuôn mặt bị tổn thương do Tai nạn" @2604
    `requiring admission to hospital`                     IS A BOOLEAN  -- vi: "cần phải nhập viện" @2604
    `confirmed medically necessary by a specialist`       IS A BOOLEAN  -- vi: "Phẫu thuật này phải được Bác sĩ chuyên khoa xác nhận là cần thiết về mặt y khoa" @2605
    `cosmetic surgery, dental reconstruction, treatment of a nasal fracture or of facial skin injury` IS A BOOLEAN  -- vi: "phẫu thuật thẩm mỹ khuôn mặt, tạo hình răng" @2606

DECLARE `Findings on an early-stage critical illness` IS ONE OF
    `findings on minimally invasive coronary artery bypass surgery`  HAS `the findings 1`  IS A `Findings: minimally invasive coronary artery bypass surgery`
    `findings on percutaneous coronary intervention`                 HAS `the findings 2`  IS A `Findings: percutaneous coronary intervention`
    `findings on implantation of a pacemaker or defibrillator`       HAS `the findings 3`  IS A `Findings: implantation of a pacemaker or defibrillator`
    `findings on carotid artery angioplasty and stenting`            HAS `the findings 4`  IS A `Findings: carotid artery angioplasty and stenting`
    `findings on minimally invasive treatment of heart valve disease` HAS `the findings 5` IS A `Findings: minimally invasive treatment of heart valve disease`
    `findings on insertion of a vena cava filter`                    HAS `the findings 6`  IS A `Findings: insertion of a vena cava filter`
    `findings on coma lasting at least 48 hours`                     HAS `the findings 7`  IS A `Findings: coma lasting at least 48 hours`
    `findings on cerebral ventricular shunt surgery`                 HAS `the findings 8`  IS A `Findings: cerebral ventricular shunt surgery`
    `findings on surgical removal of a pituitary tumour`             HAS `the findings 9`  IS A `Findings: surgical removal of a pituitary tumour`
    `findings on brain damage`                                       HAS `the findings 10` IS A `Findings: brain damage`
    `findings on small bowel transplant`                             HAS `the findings 11` IS A `Findings: small bowel transplant`
    `findings on liver surgery`                                      HAS `the findings 12` IS A `Findings: liver surgery`
    `findings on cirrhosis due to viral hepatitis`                   HAS `the findings 13` IS A `Findings: cirrhosis due to viral hepatitis`
    `findings on removal of one lung`                                HAS `the findings 14` IS A `Findings: removal of one lung`
    `findings on kidney disease`                                     HAS `the findings 15` IS A `Findings: kidney disease`
    `findings on less severe systemic lupus erythematosus`           HAS `the findings 16` IS A `Findings: less severe systemic lupus erythematosus`
    `findings on temporary aplastic anaemia`                         HAS `the findings 17` IS A `Findings: temporary aplastic anaemia`
    `findings on corneal transplant`                                 HAS `the findings 18` IS A `Findings: corneal transplant`
    `findings on loss of sight in one eye`                           HAS `the findings 19` IS A `Findings: loss of sight in one eye`
    `findings on loss of hearing in one ear`                         HAS `the findings 20` IS A `Findings: loss of hearing in one ear`
    `findings on minor burns`                                        HAS `the findings 21` IS A `Findings: minor burns`
    `findings on paralysis of one limb`                              HAS `the findings 22` IS A `Findings: paralysis of one limb`
    `findings on reconstructive surgery of a face injured in an Accident` HAS `the findings 23` IS A `Findings: reconstructive surgery of a face injured in an Accident`

§§ `Severe-stage critical illnesses — Annex 7, one record per definition`

DECLARE `Findings: coronary artery bypass surgery` HAS
    `open-chest surgery grafting a vessel to bypass a diseased coronary artery` IS A BOOLEAN  -- vi: "phẫu thuật mở lồng ngực để điều trị bệnh động mạch vành" @2642
    `by angioplasty, another endovascular procedure, a catheter, keyhole surgery or laser` IS A BOOLEAN  -- vi: "Loại trừ nong mạch vành và các phẫu thuật can thiệp nội mạch khác" @2644

DECLARE `Findings: heart attack` HAS
    `death of heart muscle from ischaemia`                IS A BOOLEAN  -- vi: "Vùng cơ tim bị chết do thiếu máu" @2648
    `history of typical prolonged chest pain`             IS A BOOLEAN  -- vi: "Tiền sử bệnh có cơn đau thắt ngực điển hình kéo dài" @2649
    `new ECG changes of infarction`                       IS A BOOLEAN  -- vi: "Các thay đổi mới trên điện tâm đồ do nhồi máu cơ tim" @2650
    `CK-MB above the normal threshold`                    IS A BOOLEAN  -- vi: "Tăng men tim CPK-MB trên mức ngưỡng bình thường" @2651
    `troponin T, ng per ml`                               IS A NUMBER   -- vi: "troponin T > 1.0 ng/ml" @2651
    `troponin I at the equivalent level`                  IS A BOOLEAN  -- vi: "tương đương đối với troponin I" @2652
    `angina only`                                         IS A BOOLEAN  -- vi: "Loại trừ cơn đau thắt ngực" @2658

DECLARE `Findings: severe cardiomyopathy` HAS
    `cardiomyopathy diagnosed by a specialist`            IS A BOOLEAN  -- vi: "được Bác sĩ chuyên khoa chẩn đoán là bệnh cơ tim" @2670
    `NYHA class of the permanent physical impairment`     IS A NUMBER   -- vi: "Độ III hay Độ IV" @2671
    `months the impairment has lasted`                    IS A NUMBER   -- vi: "trong thời gian ít nhất 6 tháng" @2671
    `echocardiogram assessing ventricular function`       IS A BOOLEAN  -- vi: "siêu âm tim để đánh giá chức năng tâm thất" @2675
    `related to alcohol or addictive substances`          IS A BOOLEAN  -- vi: "liên quan đến sử dụng thức uống có cồn hay chất gây nghiện" @2689

DECLARE `Findings: heart valve surgery` HAS
    `open-heart surgery to replace or repair a defective or abnormal heart valve` IS A BOOLEAN  -- vi: "Phẫu thuật mổ tim hở để thay thế hay sửa chữa van tim" @2696
    `repair by an endovascular procedure, keyhole surgery or a similar procedure` IS A BOOLEAN  -- vi: "Loại trừ sửa chữa van tim bằng các phẫu thuật can thiệp nội mạch" @2708

DECLARE `Findings: surgery to the aorta` HAS
    `surgery opening the chest or abdomen to treat aneurysm, occlusion, coarctation or dissection of the aorta` IS A BOOLEAN  -- vi: "phẫu thuật có mở lồng ngực hay ổ bụng để điều trị phình động mạch chủ" @2717
    `on the thoracic or abdominal aorta itself, not a branch` IS A BOOLEAN  -- vi: "không phải là các nhánh của các động" @2719
    `by angioplasty, another endovascular procedure, a catheter, keyhole surgery or laser` IS A BOOLEAN  -- vi: "Loại trừ các thủ thuật nong và can thiệp nội mạch" @2721

DECLARE `Findings: primary pulmonary arterial hypertension` HAS
    `primary pulmonary hypertension with marked right ventricular enlargement on cardiac catheterisation` IS A BOOLEAN  -- vi: "với thất phải giãn lớn được đánh giá bằng thủ thuật" @2725
    `NYHA class of the permanent irreversible physical impairment` IS A NUMBER  -- vi: "độ III hoặc độ IV theo phân loại" @2726
    `months the impairment has lasted`                    IS A NUMBER   -- vi: "trong thời gian ít nhất 6 tháng" @2727
    `pulmonary hypertension from another cause`           IS A BOOLEAN  -- vi: "Loại trừ tăng áp lực động mạch phổi do các nguyên nhân khác" @2728

DECLARE `Findings: coma lasting at least 96 hours` HAS
    `hours of continuous unconsciousness without response to external stimuli or internal needs` IS A NUMBER  -- vi: "Tình trạng mất ý thức không có đáp ứng với các kích thích bên ngoài" @2740
    `on a ventilator to sustain life`                     IS A BOOLEAN  -- vi: "được điều trị thở máy để duy trì sự sống" @2741
    `months the permanent neurological deficit has lasted since diagnosis` IS A NUMBER  -- vi: "suy giảm chức" @2741
    `confirmed by a specialist`                           IS A BOOLEAN  -- vi: "Các điều kiện nêu trên phải được Bác sĩ chuyên khoa xác nhận" @2743
    `caused by self-inflicted injury, alcohol or drug abuse` IS A BOOLEAN  -- vi: "Loại trừ hôn mê do tự gây ra chấn thương" @2744

DECLARE `Findings: stroke` HAS
    `cerebrovascular event with permanent neurological sequelae, including infarction, haemorrhage or embolism` IS A BOOLEAN  -- vi: "tai biến mạch máu não có di chứng thần kinh vĩnh viễn" @2756
    `days the sequelae have lasted`                       IS A NUMBER   -- vi: "kéo dài ít nhất 45 ngày" @2756
    `changes shown on MRI or CT, confirmed by a specialist` IS A BOOLEAN  -- vi: "thể hiện trên kết quả chụp cộng hưởng từ (MRI), chụp cắt lớp (CT)" @2763
    `of a kind the definition excludes: TIA, reversible ischaemic deficit, vertebrobasilar ischaemia, migraine, traumatic or hypoxic brain injury, or vascular disease of the eye, optic nerve or vestibular function` IS A BOOLEAN  -- vi: "Loại trừ các triệu chứng thần kinh do cơn thiếu máu não thoáng qua" @2767

DECLARE `Findings: benign brain tumour` HAS
    `life-threatening benign tumour of the brain or meninges` IS A BOOLEAN  -- vi: "U não hay u màng não lành tính đe dọa tính mạng" @2781
    `characteristic signs of raised intracranial pressure such as papilloedema, mental symptoms, seizures or sensory disturbance` IS A BOOLEAN  -- vi: "tăng áp lực nội sọ như phù gai thị" @2782
    `diagnosed on MRI or CT`                              IS A BOOLEAN  -- vi: "được chẩn đoán dựa vào kết quả chụp cộng hưởng từ (MRI) hoặc chụp cắt lớp (CT)" @2788
    `a cyst, granuloma, cerebral arterial or venous malformation, haemangioma, pituitary tumour, spinal tumour or acoustic neuroma` IS A BOOLEAN  -- vi: "Loại trừ các trường hợp u nang, u hạt" @2789

DECLARE `Findings: severe head injury` HAS
    `head injury from an accident with severe permanent neurological dysfunction` IS A BOOLEAN  -- vi: "chấn thương sọ não do tai nạn" @2807
    `months it has lasted since the injury`               IS A NUMBER   -- vi: "kéo dài ít nhất 3 tháng kể từ ngày bị chấn thương" @2813
    `confirmed by a neurologist`                          IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa thần kinh xác nhận" @2814
    `activities of daily living permanently lost`         IS A LIST OF `Activity of daily living`  -- vi: "làm mất vĩnh viễn khả năng thực hiện độc" @2814

DECLARE `Findings: open brain surgery` HAS
    `brain or intracranial surgery under anaesthesia with craniotomy` IS A BOOLEAN  -- vi: "phẫu thuật não hoặc nội sọ có gây mê và mở hộp sọ" @2836
    `burr-hole, transsphenoidal or other minimally invasive surgery for accidental head injury` IS A BOOLEAN  -- vi: "Loại trừ phẫu thuật lỗ Burr" @2837

DECLARE `Findings: Alzheimer disease or dementia` HAS
    `dementia, loss of intellect or abnormal behaviour from Alzheimer disease or severe impairment of mental and social function` IS A BOOLEAN  -- vi: "Sa sút hoặc mất trí tuệ hoặc có hành vi bất thường do bệnh Alzheimer" @2841
    `needing continuous supervision`                      IS A BOOLEAN  -- vi: "cần có sự giám sát liên tục" @2842
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh cần được Bác" @2842
    `a non-organic brain disorder such as neurosis or a psychiatric illness` IS A BOOLEAN  -- vi: "Các rối loạn não không phải tổn thương thực thể" @2845
    `brain damage related to alcohol or addictive substances` IS A BOOLEAN  -- vi: "Các tổn thương não liên quan đến thức uống có cồn hoặc chất gây nghiện" @2846

DECLARE `Findings: motor neurone disease` HAS
    `progressive degeneration of the corticospinal tracts and anterior horn cells or bulbar motor neurons` IS A BOOLEAN  -- vi: "Thoái hóa tiến triển của bó vỏ não tủy sống" @2853
    `diagnosed by a specialist, who confirms it is progressing` IS A BOOLEAN  -- vi: "xác nhận tình trạng bệnh đang tiến triển" @2866
    `months the permanent neurological deficit has lasted since diagnosis` IS A NUMBER  -- vi: "có di chứng thần kinh vĩnh viễn kéo dài ít" @2866

DECLARE `Findings: multiple sclerosis` HAS
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh phải được Bác sĩ chuyên khoa chẩn đoán" @2872
    `months during which all the conditions have continued` IS A NUMBER -- vi: "liên tục ít nhất 6 tháng" @2873
    `symptoms of the nerve tracts, white matter, optic nerve, brain stem and spinal cord impairing neurological function` IS A BOOLEAN  -- vi: "Triệu chứng liên quan bó thần kinh" @2877
    `separate or multiple lesions`                        IS A BOOLEAN  -- vi: "Các tổn thương tách biệt hoặc đa dạng" @2883
    `a history clearly confirming severe relapses and remissions` IS A BOOLEAN  -- vi: "Tiền sử bệnh xác nhận rõ các cơn tiến triển nghiêm trọng và thuyên giảm" @2884

DECLARE `Findings: severe viral encephalitis` HAS
    `severe inflammation of the brain tissue`             IS A BOOLEAN  -- vi: "Viêm nhu mô não nặng" @2902
    `days the permanent neurological sequelae have lasted` IS A NUMBER  -- vi: "trong thời gian ít nhất 30 ngày" @2902
    `confirmed by a specialist`                           IS A BOOLEAN  -- vi: "được Bác sĩ chuyên khoa xác nhận" @2903
    `HIV-related encephalitis`                            IS A BOOLEAN  -- vi: "Loại trừ viêm não liên quan đến HIV" @2909

DECLARE `Findings: bacterial meningitis` HAS
    `bacterial inflammation of the meninges of the brain or spinal cord` IS A BOOLEAN  -- vi: "Bệnh viêm màng não do vi khuẩn làm viêm màng não hoặc tủy sống" @2916
    `days the permanent neurological sequelae have lasted` IS A NUMBER  -- vi: "trong thời gian ít nhất 30 ngày" @2917
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh phải được Bác sĩ chuyên khoa chẩn đoán" @2917
    `bacteria found in cerebrospinal fluid on lumbar puncture` IS A BOOLEAN  -- vi: "có vi khuẩn trong dịch não tủy khi chọc dò tủy sống" @2918

DECLARE `Findings: severe Parkinson disease` HAS
    `Parkinson disease diagnosed by a specialist`         IS A BOOLEAN  -- vi: "Bệnh Parkinson được Bác sĩ chuyên khoa chẩn đoán" @2921
    `not controllable by medication`                      IS A BOOLEAN  -- vi: "Không thể kiểm soát được bằng thuốc" @2922
    `signs of progression`                                IS A BOOLEAN  -- vi: "Có dấu hiệu bệnh tiến triển" @2923
    `activities of daily living permanently lost`         IS A LIST OF `Activity of daily living`  -- vi: "Mất vĩnh viễn khả năng thực hiện độc lập ít nhất 3 Hoạt động sinh hoạt hàng ngày" @2930
    `drug-induced or toxic parkinsonism`                  IS A BOOLEAN  -- vi: "Loại trừ các hội chứng Parkinson do thuốc hoặc do nhiễm độc" @2933

DECLARE `Findings: poliomyelitis` HAS
    `caused by the poliovirus`                            IS A BOOLEAN  -- vi: "Bệnh gây ra do vi rút bại liệt" @2949
    `months the paralysis of limb or respiratory muscles has lasted` IS A NUMBER  -- vi: "Liệt các cơ của chi hoặc các cơ hô hấp kéo dài ít nhất 3 tháng" @2955

DECLARE `Findings: chronic liver failure` HAS
    `permanent jaundice`                                  IS A BOOLEAN  -- vi: "Vàng da liên tục" @2966
    `ascites`                                             IS A BOOLEAN  -- vi: "Cổ trướng" @2968
    `hepatic encephalopathy`                              IS A BOOLEAN  -- vi: "Hội chứng não do gan" @2969
    `from alcohol, addictive substances or poisoning`     IS A BOOLEAN  -- vi: "Loại trừ suy gan do rượu, chất gây nghiện hoặc ngộ độc" @2973

DECLARE `Findings: fulminant viral hepatitis` HAS
    `severe liver necrosis from viral hepatitis leading to liver failure` IS A BOOLEAN  -- vi: "hoại tử gan nghiêm trọng do viêm gan siêu vi dẫn đến suy gan" @2979
    `rapid shrinking of the liver with necrosis of all the lobules` IS A BOOLEAN  -- vi: "Giảm nhanh chóng kích thước gan kèm hoại tử toàn bộ các tiểu thùy gan" @2986
    `rapid fall in liver enzymes`                         IS A BOOLEAN  -- vi: "Suy giảm nhanh chóng men gan" @2992
    `deep jaundice`                                       IS A BOOLEAN  -- vi: "Vàng da sậm" @2998
    `hepatic encephalopathy`                              IS A BOOLEAN  -- vi: "Bệnh não do gan" @2999

DECLARE `Findings: chronic relapsing pancreatitis` HAS
    `progressive destruction of the pancreas from recurrent acute pancreatitis` IS A BOOLEAN  -- vi: "phá hủy tiến triển của tuyến tụy do viêm tụy cấp tái phát" @3007
    `years over which acute pancreatitis has recurred`    IS A NUMBER   -- vi: "Nhiều lần bị viêm tụy cấp tính trong khoảng thời gian ít nhất 2 năm" @3009
    `diffuse calcification of the pancreas on CT, MRI or ultrasound` IS A BOOLEAN  -- vi: "Vôi hóa lan tỏa khắp tuyến tụy" @3010
    `continuous chronic pancreatic dysfunction with malabsorption or insulin-dependent diabetes` IS A BOOLEAN  -- vi: "Rối loạn chức năng tuyến tụy liên tục mạn tính" @3012
    `from alcohol abuse, a congenital defect or a hereditary disease` IS A BOOLEAN  -- vi: "Loại trừ viêm tụy do lạm dụng thức uống có cồn" @3014

DECLARE `Findings: chronic lung disease` HAS
    `end-stage lung disease with chronic respiratory failure` IS A BOOLEAN  -- vi: "Bệnh phổi giai đoạn cuối gây ra suy hô hấp mạn tính" @3029
    `needing continuous supplementary oxygen`             IS A BOOLEAN  -- vi: "Cần thở oxy hỗ trợ liên tục" @3030
    `FEV1, litres`                                        IS A NUMBER   -- vi: "thể tích thở ra gắng sức trong giây đầu tiên" @3030
    `arterial oxygen partial pressure, mmHg`              IS A NUMBER   -- vi: "Áp suất riêng phần oxy trong khí máu động mạch" @3032
    `breathless at rest`                                  IS A BOOLEAN  -- vi: "Khó thở ngay cả khi nghỉ ngơi" @3033

DECLARE `Findings: kidney failure` HAS
    `irreversible end-stage chronic failure of both kidneys` IS A BOOLEAN  -- vi: "Suy thận mạn tính giai đoạn cuối không thể phục hồi chức năng của cả hai thận" @3036
    `needing regular dialysis or a kidney transplant`     IS A BOOLEAN  -- vi: "chạy thận nhân tạo định kỳ hay ghép thận" @3037

DECLARE `Findings: systemic lupus erythematosus` HAS
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh Lupus ban đỏ hệ thống phải được Bác sĩ chuyên khoa chẩn" @3046
    `WHO lupus nephritis class on kidney biopsy`          IS A NUMBER   -- vi: "từ loại III đến loại V" @3047
    `discoid lupus, or lupus with only haematological and joint involvement` IS A BOOLEAN  -- vi: "Loại trừ bệnh lupus dạng đĩa" @3053

DECLARE `Findings: aplastic anaemia` HAS
    `permanent irreversible bone-marrow failure with anaemia, leukopenia and thrombocytopenia` IS A BOOLEAN  -- vi: "Suy giảm chức năng tủy xương vĩnh viễn, không thể phục hồi" @3078
    `treated by blood transfusion`                        IS A BOOLEAN  -- vi: "Truyền máu" @3085
    `treated with marrow-stimulating drugs`               IS A BOOLEAN  -- vi: "Thuốc kích thích tủy xương" @3086
    `treated with immunosuppressants`                     IS A BOOLEAN  -- vi: "Thuốc ức chế miễn dịch" @3093
    `treated by bone marrow transplant`                   IS A BOOLEAN  -- vi: "Ghép tủy xương" @3094
    `confirmed on bone-marrow biopsy`                     IS A BOOLEAN  -- vi: "kết quả sinh thiết tủy xương" @3100

DECLARE `Findings: bone marrow transplant` HAS
    `human bone marrow transplant using haematopoietic stem cells after total marrow ablation` IS A BOOLEAN  -- vi: "Ghép tủy xương người bằng việc sử dụng các tế bào gốc tạo máu" @3107
    `a transplant of other stem cells`                    IS A BOOLEAN  -- vi: "Loại trừ cấy ghép các tế bào gốc khác" @3109

DECLARE `Findings: major organ transplant` HAS
    `transplant of the heart, a lung, the liver, a kidney or the pancreas` IS A BOOLEAN  -- vi: "tim, phổi, gan, thận, tụy" @3112
    `for irreversible end-stage failure of that organ`    IS A BOOLEAN  -- vi: "giai đoạn cuối không phục hồi của cơ quan này" @3113
    `a transplant of stem cells or islet cells`           IS A BOOLEAN  -- vi: "Loại trừ ghép tế bào gốc và tế bào tiểu đảo" @3114

DECLARE `Findings: severe burns` HAS
    `percent of the body surface with third-degree burns` IS A NUMBER   -- vi: "chiếm ít nhất 20% diện tích bề mặt da" @3122
    `percent of the body surface treated by skin grafting` IS A NUMBER  -- vi: "da ít nhất 10% diện tích bề mặt da" @3123

DECLARE `Findings: loss of independent existence` HAS
    `confirmed by a specialist`                           IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa xác nhận mất khả năng sống độc lập" @3126
    `months it has lasted`                                IS A NUMBER   -- vi: "kéo dài trong thời gian ít nhất sáu" @3126
    `activities of daily living permanently lost`         IS A LIST OF `Activity of daily living`  -- vi: "mất vĩnh viễn khả năng thực hiện độc lập ít nhất 3 Hoạt động sinh hoạt hàng ngày" @3127
    `from a psychiatric cause`                            IS A BOOLEAN  -- vi: "Loại trừ mất khả năng sống độc lập do nguyên nhân tâm thần" @3131

DECLARE `Health-care occupation` IS ONE OF
    `a medical doctor`                                    -- vi: "Bác sĩ y" @3191
    `a medical student`                                   -- vi: "sinh viên y khoa" @3197
    `a nurse`                                             -- vi: "y tá" @3197
    `a nursing carer`                                     -- vi: "điều dưỡng" @3197
    `a medical technician`                                -- vi: "kỹ thuật viên y tế" @3197
    `a dentist`                                           -- vi: "nha sĩ" @3197
    `another member of the medical staff`                 -- vi: "nhân viên y tế" @3197

DECLARE `Findings: HIV infection from an occupational accident` HAS
    `infected in an Accident while performing professional duties as Vietnamese law prescribes` IS A BOOLEAN  -- vi: "đang thực hiện nhiệm vụ theo đúng" @3158
    `months from the Accident to the seroconversion`      IS A NUMBER   -- vi: "trong vòng 6 tháng kể từ ngày xảy ra Tai nạn" @3165
    `days from the Accident to a negative HIV test`       IS A MAYBE NUMBER  -- vi: "được thực hiện trong vòng 7 ngày kể từ ngày xảy ra Tai nạn" @3170
    `evidence clearly identifying the source of infection` IS A BOOLEAN  -- vi: "Có bằng chứng xác định rõ nguồn lây nhiễm HIV" @3171
    `days from the Accident to notice to the Company`     IS A MAYBE NUMBER  -- vi: "trong vòng 30 ngày kể từ ngày xảy ra Tai nạn" @3178
    `infected by another route such as sex, transfusion or drug injection` IS A BOOLEAN  -- vi: "Loại trừ nhiễm HIV qua các đường khác" @3184
    `the insured's occupation`                            IS A MAYBE `Health-care occupation`  -- vi: "khi Người được bảo hiểm là" @3191
    `working or studying at a lawfully established health-care facility in Vietnam` IS A BOOLEAN  -- vi: "việc hoặc học tập tại các cơ sở khám chữa bệnh" @3203
    `an effective treatment for HIV exists`               IS A BOOLEAN  -- vi: "đã có phương pháp điều trị" @3205

DECLARE `Findings: muscular dystrophy` HAS
    `confirmed by a specialist`                           IS A BOOLEAN  -- vi: "Chẩn đoán cần được Bác sĩ chuyên khoa xác nhận" @3209
    `family history of other members with the disease`    IS A BOOLEAN  -- vi: "Tiền sử gia đình có các thành viên khác cũng mắc bệnh" @3210
    `no sensory disturbance, normal cerebrospinal fluid and mildly reduced tendon reflexes` IS A BOOLEAN  -- vi: "Biểu hiện lâm sàng không có rối loạn cảm giác" @3211
    `characteristic electromyogram`                       IS A BOOLEAN  -- vi: "Điện cơ đồ có bất thường đặc trưng của bệnh loạn dưỡng cơ" @3213
    `muscle biopsy showing muscular dystrophy`            IS A BOOLEAN  -- vi: "Kết quả sinh thiết cơ có bất thường của bệnh loạn dưỡng cơ" @3219
    `first signs or symptoms appeared before age 18`      IS A BOOLEAN  -- vi: "dấu hiệu, triệu chứng bệnh đầu tiên xuất hiện trước khi" @3226

DECLARE `Findings: loss of hearing` HAS
    `complete irreversible loss of hearing in both ears from illness or accidental injury` IS A BOOLEAN  -- vi: "Mất hoàn toàn và không thể phục hồi chức năng nghe của cả hai tai" @3230
    `confirmed by a specialist`                           IS A BOOLEAN  -- vi: "Chẩn đoán phải được Bác sĩ chuyên khoa xác nhận" @3231
    `hearing loss at every frequency in both ears, decibels` IS A NUMBER  -- vi: "từ 80 decibels (dB) trở lên ở tất cả các tần số nghe của hai tai" @3232
    `months from the diagnosis to the audiometry`         IS A NUMBER   -- vi: "không sớm hơn 3 tháng kể từ ngày được chẩn đoán" @3233

DECLARE `Findings: loss of speech` HAS
    `complete irreversible loss of the ability to speak from an Accident or illness` IS A BOOLEAN  -- vi: "Mất hoàn toàn và không phục hồi khả năng phát âm" @3236
    `continuous months without speech`                    IS A NUMBER   -- vi: "liên tục 12 tháng" @3236
    `specialist medical evidence of injury or disease of the vocal cords` IS A BOOLEAN  -- vi: "bằng chứng y tế của Bác sĩ chuyên khoa xác nhận tổn thương hay bệnh của dây thanh" @3237
    `from a psychiatric cause`                            IS A BOOLEAN  -- vi: "Loại trừ mất khả năng phát âm do tâm thần" @3238

DECLARE `Findings: terminal illness` HAS
    `specialists confirming it`                           IS A NUMBER   -- vi: "được 2 Bác sĩ chuyên khoa xác nhận" @3250
    `incurable or without any effective treatment`        IS A BOOLEAN  -- vi: "không thể điều trị khỏi hay không có" @3250
    `months within which death is expected`               IS A NUMBER   -- vi: "tiên lượng sẽ tử vong trong vòng 6 tháng" @3251
    `based on appropriate evidence, records and tests`    IS A BOOLEAN  -- vi: "bằng chứng phù hợp bao gồm hồ sơ khám và các xét nghiệm" @3257

DECLARE `Findings: Still disease` HAS
    `chronic juvenile arthritis diagnosed by a specialist` IS A BOOLEAN  -- vi: "một dạng bệnh viêm khớp mạn tính ở trẻ em" @3262
    `hip or knee replacement for extensive joint destruction` IS A BOOLEAN  -- vi: "phẫu thuật thay khớp háng hoặc khớp gối" @3263

DECLARE `Findings: severe haemophilia` HAS
    `haemophilia A or B`                                  IS A BOOLEAN  -- vi: "hemophilia A (thiếu hụt yếu tố VIII)" @3280
    `factor VIII or IX level, percent`                    IS A NUMBER   -- vi: "thấp hơn một phần" @3281
    `confirmed by a specialist`                           IS A BOOLEAN  -- vi: "Chẩn đoán phải được Bác sĩ chuyên khoa xác nhận" @3287

DECLARE `Findings: rheumatic heart disease` HAS
    `acute rheumatic fever diagnosed by a paediatric specialist on the revised Jones criteria (2015)` IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa nhi chẩn đoán có sốt thấp khớp cấp tính" @3307
    `heart valves damaged by rheumatism on echocardiogram` IS A NUMBER  -- vi: "ít nhất một van tim bị tổn thương do thấp" @3308

DECLARE `Findings: osteogenesis imperfecta` HAS
    `type III confirmed by a specialist`                  IS A BOOLEAN  -- vi: "Bác sĩ chuyên khoa xác nhận thuộc loại III" @3316
    `growth retardation and hearing loss on clinical examination` IS A BOOLEAN  -- vi: "Khám lâm sàng có chậm phát triển và giảm thính lực" @3322
    `multiple fractures and progressive kyphoscoliosis on X-ray` IS A BOOLEAN  -- vi: "nhiều xương gãy và gù vẹo cột sống tiến triển" @3323
    `positive skin biopsy`                                IS A BOOLEAN  -- vi: "Kết quả sinh thiết da dương tính" @3324

DECLARE `Findings: type 1 diabetes` HAS
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh tiểu đường tuýp 1 phải được" @3330
    `months of exogenous insulin treatment`               IS A NUMBER   -- vi: "được điều trị insulin ngoại sinh ít nhất 6 tháng" @3331

DECLARE `Findings: Kawasaki disease with cardiac complications` HAS
    `diagnosis established and confirmed by a specialist` IS A BOOLEAN  -- vi: "Chẩn đoán phải được xác định bởi Bác sĩ chuyên khoa" @3347
    `coronary artery dilatation or aneurysm on echocardiogram, mm` IS A NUMBER  -- vi: "giãn hoặc phình động mạch vành ít nhất 5 mm" @3348
    `months from onset to the echocardiogram`             IS A NUMBER   -- vi: "không sớm hơn 12 tháng kể từ ngày khởi bệnh" @3354

DECLARE `Findings: glomerulonephritis with nephrotic syndrome` HAS
    `diagnosed and treated by a specialist`               IS A BOOLEAN  -- vi: "phải được Bác sĩ chuyên khoa chẩn đoán và điều trị" @3365
    `continuous months of nephrotic syndrome`             IS A NUMBER   -- vi: "kéo dài liên tục trong khoảng thời gian ít nhất 6 tháng" @3366

DECLARE `Complication of hand, foot and mouth disease` IS ONE OF
    `encephalitis`                                        -- vi: "Viêm não" @3393
    `acute paralysis`                                     -- vi: "Liệt cấp tính" @3399
    `acute pulmonary oedema or cardiopulmonary failure`   -- vi: "Phù phổi cấp hoặc suy tim phổi" @3405
    `another complication`

DECLARE `Findings: severe hand, foot and mouth disease` HAS
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh tay chân miệng phải được Bác sĩ chuyên khoa chẩn đoán" @3386
    `treated in an intensive care unit`                   IS A BOOLEAN  -- vi: "được điều trị tại Phòng" @3386
    `the complication treated`                            IS A `Complication of hand, foot and mouth disease`  -- vi: "do một trong các biến chứng sau" @3392

DECLARE `Findings: Wilson disease` HAS
    `diagnosed by a specialist`                           IS A BOOLEAN  -- vi: "Bệnh phải được Bác sĩ chuyên khoa chẩn đoán" @3412
    `months of copper-chelation treatment`                IS A NUMBER   -- vi: "điều trị bằng thuốc thải" @3412

DECLARE `Findings: generalised tetanus` HAS
    `diagnosis established by a specialist`               IS A BOOLEAN  -- vi: "Chẩn đoán bệnh uốn ván thể toàn thân phải được Bác sĩ chuyên khoa xác định" @3428
    `days of continuous mechanical ventilation`           IS A NUMBER   -- vi: "Được điều trị thở máy liên tục ít nhất 3 ngày" @3430
    `treated with tetanus immune serum`                   IS A BOOLEAN  -- vi: "Được điều trị bằng huyết thanh miễn dịch uốn ván" @3431

DECLARE `Findings: status epilepticus` HAS
    `continuous generalised convulsive seizure, or several without recovery of consciousness between them` IS A BOOLEAN  -- vi: "cơn động kinh co giật toàn thể liên" @3437
    `needing intubation and ventilation to sustain life`  IS A BOOLEAN  -- vi: "đặt nội khí quản và thở máy để duy trì sự sống" @3439
    `confirmed by a specialist with medical records and an EEG` IS A BOOLEAN  -- vi: "kết quả điện não đồ" @3445

DECLARE `Findings on a severe-stage critical illness` IS ONE OF
    `findings on coronary artery bypass surgery`                     HAS `the severe findings 1`  IS A `Findings: coronary artery bypass surgery`
    `findings on heart attack`                                       HAS `the severe findings 2`  IS A `Findings: heart attack`
    `findings on severe cardiomyopathy`                              HAS `the severe findings 3`  IS A `Findings: severe cardiomyopathy`
    `findings on heart valve surgery`                                HAS `the severe findings 4`  IS A `Findings: heart valve surgery`
    `findings on surgery to the aorta`                               HAS `the severe findings 5`  IS A `Findings: surgery to the aorta`
    `findings on primary pulmonary arterial hypertension`            HAS `the severe findings 6`  IS A `Findings: primary pulmonary arterial hypertension`
    `findings on coma lasting at least 96 hours`                     HAS `the severe findings 7`  IS A `Findings: coma lasting at least 96 hours`
    `findings on stroke`                                             HAS `the severe findings 8`  IS A `Findings: stroke`
    `findings on benign brain tumour`                                HAS `the severe findings 9`  IS A `Findings: benign brain tumour`
    `findings on severe head injury`                                 HAS `the severe findings 10` IS A `Findings: severe head injury`
    `findings on open brain surgery`                                 HAS `the severe findings 11` IS A `Findings: open brain surgery`
    `findings on Alzheimer disease or dementia`                      HAS `the severe findings 12` IS A `Findings: Alzheimer disease or dementia`
    `findings on motor neurone disease`                              HAS `the severe findings 13` IS A `Findings: motor neurone disease`
    `findings on multiple sclerosis`                                 HAS `the severe findings 14` IS A `Findings: multiple sclerosis`
    `findings on severe viral encephalitis`                          HAS `the severe findings 15` IS A `Findings: severe viral encephalitis`
    `findings on bacterial meningitis`                               HAS `the severe findings 16` IS A `Findings: bacterial meningitis`
    `findings on severe Parkinson disease`                           HAS `the severe findings 17` IS A `Findings: severe Parkinson disease`
    `findings on poliomyelitis`                                      HAS `the severe findings 18` IS A `Findings: poliomyelitis`
    `findings on chronic liver failure`                              HAS `the severe findings 19` IS A `Findings: chronic liver failure`
    `findings on fulminant viral hepatitis`                          HAS `the severe findings 20` IS A `Findings: fulminant viral hepatitis`
    `findings on chronic relapsing pancreatitis`                     HAS `the severe findings 21` IS A `Findings: chronic relapsing pancreatitis`
    `findings on chronic lung disease`                               HAS `the severe findings 22` IS A `Findings: chronic lung disease`
    `findings on kidney failure`                                     HAS `the severe findings 23` IS A `Findings: kidney failure`
    `findings on systemic lupus erythematosus`                       HAS `the severe findings 24` IS A `Findings: systemic lupus erythematosus`
    `findings on aplastic anaemia`                                   HAS `the severe findings 25` IS A `Findings: aplastic anaemia`
    `findings on bone marrow transplant`                             HAS `the severe findings 26` IS A `Findings: bone marrow transplant`
    `findings on major organ transplant`                             HAS `the severe findings 27` IS A `Findings: major organ transplant`
    `findings on severe burns`                                       HAS `the severe findings 28` IS A `Findings: severe burns`
    `findings on loss of independent existence`                      HAS `the severe findings 29` IS A `Findings: loss of independent existence`
    `findings on HIV infection from an occupational accident`        HAS `the severe findings 30` IS A `Findings: HIV infection from an occupational accident`
    `findings on muscular dystrophy`                                 HAS `the severe findings 31` IS A `Findings: muscular dystrophy`
    `findings on loss of hearing`                                    HAS `the severe findings 32` IS A `Findings: loss of hearing`
    `findings on loss of speech`                                     HAS `the severe findings 33` IS A `Findings: loss of speech`
    `findings on terminal illness`                                   HAS `the severe findings 34` IS A `Findings: terminal illness`
    `findings on Still disease`                                      HAS `the severe findings 35` IS A `Findings: Still disease`
    `findings on severe haemophilia`                                 HAS `the severe findings 36` IS A `Findings: severe haemophilia`
    `findings on rheumatic heart disease`                            HAS `the severe findings 37` IS A `Findings: rheumatic heart disease`
    `findings on osteogenesis imperfecta`                            HAS `the severe findings 38` IS A `Findings: osteogenesis imperfecta`
    `findings on type 1 diabetes`                                    HAS `the severe findings 39` IS A `Findings: type 1 diabetes`
    `findings on Kawasaki disease with cardiac complications`        HAS `the severe findings 40` IS A `Findings: Kawasaki disease with cardiac complications`
    `findings on glomerulonephritis with nephrotic syndrome`         HAS `the severe findings 41` IS A `Findings: glomerulonephritis with nephrotic syndrome`
    `findings on severe hand, foot and mouth disease`                HAS `the severe findings 42` IS A `Findings: severe hand, foot and mouth disease`
    `findings on Wilson disease`                                     HAS `the severe findings 43` IS A `Findings: Wilson disease`
    `findings on generalised tetanus`                                HAS `the severe findings 44` IS A `Findings: generalised tetanus`
    `findings on status epilepticus`                                 HAS `the severe findings 45` IS A `Findings: status epilepticus`

§§ `Diagnoses and claims`

-- The Annex 1 definition of a critical illness adds three conditions to every Annex 6 and 7
-- item: the illness arises for the first time, it is diagnosed or treated at a Hospital, and
-- in line with usual medical practice.
-- where: Phụ lục 1 (Bệnh hiểm nghèo)
DECLARE `Diagnosis of an early-stage critical illness` HAS
    `date of diagnosis`                                   IS A DATE     -- vi: "ngày được chẩn đoán" @861
    `arising for the first time for the insured`          IS A BOOLEAN  -- vi: "đầu tiên đối với Người được bảo hiểm" @1540
    `diagnosed or treated at a Hospital`                  IS A BOOLEAN  -- vi: "phải được thực hiện tại Bệnh viện" @1546
    `in line with usual standards of medical practice`    IS A BOOLEAN  -- vi: "phù hợp với các tiêu chuẩn thông thường về thực hành y khoa" @1546
    `the early-stage findings`                            IS A `Findings on an early-stage critical illness`  -- vi: "thỏa các điều kiện được quy định tại" @1540

-- where: Phụ lục 1 (Bệnh hiểm nghèo)
DECLARE `Diagnosis of a severe-stage critical illness` HAS
    `date of diagnosis`                                   IS A DATE     -- vi: "ngày được chẩn đoán" @861
    `arising for the first time for the insured`          IS A BOOLEAN  -- vi: "đầu tiên đối với Người được bảo hiểm" @1540
    `diagnosed or treated at a Hospital`                  IS A BOOLEAN  -- vi: "phải được thực hiện tại Bệnh viện" @1546
    `in line with usual standards of medical practice`    IS A BOOLEAN  -- vi: "phù hợp với các tiêu chuẩn thông thường về thực hành y khoa" @1546
    `the severe-stage findings`                           IS A `Findings on a severe-stage critical illness`  -- vi: "thỏa các điều kiện được quy định tại" @1540

-- where: Phụ lục 5; Điều 1
DECLARE `Diagnosis of cancer` HAS
    `date of diagnosis`                                   IS A DATE     -- vi: "ngày được chẩn đoán" @861
    `the cancer findings`                                 IS A `Findings on a cancer`  -- vi: "thỏa các điều kiện tại Phụ lục 5" @1534

-- The facts every claim for a benefit that turns on a diagnosis needs, besides the diagnosis.
-- `in force on the date of the event` is decided by Articles 19-21 and 34
-- (ktv-part3-premiums-and-account.l4, `the contract is in force on`); a caller supplies the
-- answer that rule gives, or the Company's record of it.
-- where: Điều 1, 2, 23, 24
DECLARE `Claim context` HAS
    `the policy`                                          IS A Policy                    -- vi: "Hợp đồng bảo hiểm" @1340
    `the account at the event`                            IS AN `Account snapshot`       -- vi: "được xác định tại thời điểm" @122
    `benefits already paid`                               IS A LIST OF `Payment already made`   -- vi: "đã được chi trả" @106
    `in force on the date of the event`                   IS A BOOLEAN                   -- vi: "còn hiệu lực" @333
    `the circumstances`                                   IS A `Circumstances of the insured event`  -- vi: "sự kiện bảo hiểm xảy ra do" @692

-- where: Điều 3; Phụ lục 1
DECLARE `Cause of ICU treatment` IS ONE OF
    `a cancer or a critical illness as these rules and terms define them`  -- vi: "Bệnh ung thư hoặc Bệnh hiểm nghèo theo định nghĩa tại Quy Tắc và" @205
    `an Accident`                                         -- vi: "Tai nạn" @217
    `another illness`                                     -- vi: "các bệnh khác" @217

-- where: Điều 3
DECLARE `ICU stay` HAS
    `start date`                                          IS A DATE     -- vi: "tại thời điểm bắt đầu điều" @223
    `consecutive days of treatment in the unit`           IS A NUMBER   -- vi: "điều trị liên tục từ 5 ngày trở" @192
    `the direct cause`                                    IS A `Cause of ICU treatment`  -- vi: "việc điều trị này có nguyên" @198
    `the unit`                                            IS AN `Intensive care unit`   -- vi: "Phòng Chăm sóc đặc biệt" @198
    `ICU benefits already paid to the insured under the insured's other contracts` IS A NUMBER  -- vi: "cho tất cả các Hợp đồng bảo hiểm của Người được bảo" @191

-- where: Điều 26
DECLARE `Claim file` HAS
    `claim form completed fully and accurately as the Company requires` IS A BOOLEAN  -- vi: "Phiếu Yêu cầu giải quyết quyền lợi bảo hiểm đã được điền đầy đủ và chính" @867
    `certified extract of the death record`               IS A BOOLEAN  -- vi: "Trích lục khai tử" @870
    `certificate of the rate of bodily injury or permanent loss of working capacity` IS A BOOLEAN  -- vi: "Chứng nhận hoặc xác nhận về tỷ lệ tổn thương cơ thể" @871
    `medical evidence from the doctor who examined, diagnosed or treated` IS A BOOLEAN  -- vi: "Các bằng chứng y tế được bác sĩ khám, chẩn đoán hoặc điều trị" @885
    `evidence of entitlement and identity papers of the person entitled` IS A BOOLEAN  -- vi: "Bằng chứng về quyền thụ hưởng quyền lợi bảo hiểm" @896

§§ `Premiums and the account — Articles 19-22, Annex 2`

-- where: Điều 20; Phụ lục 2
DECLARE `Kind of premium` IS ONE OF
    `basic premium`              -- vi: "Phí bảo hiểm cơ bản" @1423
    `top-up premium`             -- vi: "Phí đóng thêm" @1436

-- `premium year` is the "Năm đóng phí" the payment counts towards (Annex 1): 1, 2, 3, or 4
-- and later. Which premium year a payment counts towards is a fact of the Company's books.
-- where: Điều 20; Phụ lục 1, 2
DECLARE `Premium payment` HAS
    `kind`                       IS A `Kind of premium`                              -- vi: "Tỷ lệ phân bổ" @556
    `amount`                     IS A NUMBER                                         -- vi: "khoản tiền" @1423
    `premium year`               IS A NUMBER                                         -- vi: "Năm đóng phí" @1411

-- The facts for one monthly anniversary (Article 22(a)(ii) and (b)(ii)): the balances on the
-- previous monthly anniversary and what happened since. Interest is an amount, not a rate:
-- the document names the rate (the crediting rate of the previous month, Annex 3) but not
-- how an annual rate becomes a month's interest, nor on what balance (NOTES.md, fork F14).
-- where: Điều 22; Phụ lục 2
DECLARE `Month of the account` HAS
    `basic account value at the previous monthly anniversary`   IS A NUMBER          -- vi: "Giá trị tài khoản cơ bản vào Ngày kỷ niệm tháng của tháng trước" @638
    `top-up account value at the previous monthly anniversary`  IS A NUMBER          -- vi: "Giá trị tài khoản đóng thêm vào Ngày kỷ niệm tháng của tháng trước" @661
    `premiums paid since the previous monthly anniversary`      IS A LIST OF `Premium payment`  -- vi: "được đóng từ Ngày kỷ" @640
    `interest on the basic account`                             IS A NUMBER          -- vi: "Tiền lãi tính theo Lãi suất tích lũy của tháng trước" @642
    `interest on the top-up account`                            IS A NUMBER          -- vi: "Tiền lãi tính theo Lãi suất tích lũy của tháng trước" @665
    `loyalty bonus`                                             IS A MAYBE NUMBER    -- vi: "Quyền lợi thưởng duy trì đóng phí (nếu có)" @643
    `cancer-screening support`                                  IS A MAYBE NUMBER    -- vi: "Quyền lợi hỗ trợ tầm soát Bệnh ung thư (nếu có)" @671
    `cost of insurance for the month`                           IS A NUMBER          -- vi: "Chi phí bảo hiểm rủi ro" @1483
    `calendar year of the deduction`                            IS A NUMBER          -- vi: "năm dương lịch tại" @1737
    `withdrawals from the basic account since`                  IS A MAYBE NUMBER    -- vi: "Các khoản tiền rút từ Giá trị tài khoản cơ bản" @655
    `withdrawals from the top-up account since`                 IS A MAYBE NUMBER    -- vi: "Các khoản tiền rút từ Giá trị tài khoản đóng thêm" @685

-- What one monthly anniversary leaves: the two balances, and any deduction the accounts could
-- not meet (which Article 9 turns into a debt when its guarantee applies).
-- where: Điều 9, 22
DECLARE `Account after a monthly anniversary` HAS
    `basic account value`        IS A NUMBER                                         -- vi: "Giá trị tài khoản cơ bản" @637
    `top-up account value`       IS A NUMBER                                         -- vi: "Giá trị tài khoản đóng thêm" @660
    `deduction left unpaid`      IS A NUMBER                                         -- vi: "Khoản khấu trừ hàng tháng chưa được thanh toán" @364

-- The premium history Articles 5, 8 and 9 test, summarised as the Company's books show it.
-- where: Điều 5, 8, 9
DECLARE `Premium record` HAS
    `the contract has ever lapsed`                                         IS A BOOLEAN  -- vi: "Hợp đồng chưa từng mất hiệu lực" @277
    `annual basic premium paid in full before each policy anniversary so far` IS A BOOLEAN  -- vi: "Phí bảo hiểm cơ bản hàng năm được đóng đầy đủ trước mỗi Ngày" @278
    `lowest sum insured during the term so far`                            IS A NUMBER   -- vi: "được duy trì tối thiểu là 1 tỷ" @272
    `basic premiums of the first 4 contract years paid in full`            IS A BOOLEAN  -- vi: "đóng đầy đủ Phí bảo" @355
    `a withdrawal has ever been made from the basic account`               IS A BOOLEAN  -- vi: "chưa từng thực hiện rút tiền từ" @356

-- An unpaid premium, and what Article 21 asks about it.
-- `date the contract account value became zero` matters from contract year 5.
-- where: Điều 19, 21
DECLARE `Unpaid premium` HAS
    `contract year`                                       IS A NUMBER     -- vi: "Năm hợp đồng" @1408
    `due date`                                            IS A DATE       -- vi: "Ngày đến hạn đóng phí" @1394
    `date the contract account value became zero`         IS A MAYBE DATE -- vi: "Ngày Giá trị tài khoản hợp đồng bằng không" @594
    `the amount required was paid in full by the end of the grace period` IS A BOOLEAN  -- vi: "không đóng đủ khoản phí bảo hiểm theo yêu cầu" @607

-- One row of the Annex 4 table: the lowest and highest ratio of sum insured to annualised
-- basic premium the Company accepts for an issue age.
-- where: Phụ lục 4
DECLARE `Coefficient limits` HAS
    `minimum coefficient`        IS A NUMBER                                         -- vi: "Hệ số bảo hiểm tối thiểu" @1870
    `maximum coefficient`        IS A NUMBER                                         -- vi: "Hệ số bảo hiểm tối đa" @1870

§§ `The policyowner's requests — Part II`

-- where: Điều 11
DECLARE `Free-look notice` HAS
    `date the contract was received`                      IS A DATE       -- vi: "ngày nhận được Hợp đồng bảo hiểm" @387
    `date of the notice`                                  IS A DATE       -- vi: "gửi thông" @388
    `premiums paid`                                       IS A NUMBER     -- vi: "số phí bảo hiểm mà Khách hàng đã đóng" @394
    `costs of the medical examination`                    IS A MAYBE NUMBER  -- vi: "chi phí kiểm tra sức khỏe, nếu có" @400

-- `minimum withdrawal` is the amount the Company publishes on its website from time to time.
-- where: Điều 12
DECLARE `Withdrawal request` HAS
    `date of the request`                                 IS A DATE       -- vi: "Vào bất kỳ thời điểm nào" @408
    `amount requested`                                    IS A NUMBER     -- vi: "số tiền yêu cầu" @423
    `minimum withdrawal`                                  IS A NUMBER     -- vi: "Số tiền rút mỗi lần không thấp hơn mức tối" @431
    `the account before the withdrawal`                   IS AN `Account snapshot`  -- vi: "Giá trị tài khoản hợp đồng" @402

-- where: Điều 13
DECLARE `Kind of change` IS ONE OF
    `an increase`                -- vi: "Trường hợp tăng Số tiền bảo hiểm" @441
    `a decrease`                 -- vi: "Trường hợp giảm Số tiền bảo hiểm" @445

-- `minimum sum insured` is the figure the Company sets from time to time (Article 13(a)(ii)).
-- where: Điều 13
DECLARE `Request to change the sum insured` HAS
    `date of the request`                                 IS A DATE       -- vi: "tại thời điểm yêu cầu" @442
    `kind of change`                                      IS A `Kind of change`  -- vi: "yêu cầu tăng" @439
    `new sum insured`                                     IS A NUMBER     -- vi: "Số tiền bảo hiểm sau khi giảm" @445
    `minimum sum insured`                                 IS A NUMBER     -- vi: "Số tiền bảo hiểm tối thiểu do Công ty quy định" @446
    `date approved`                                       IS A DATE       -- vi: "Trường hợp được Công ty chấp thuận" @456
    `the basic premium changes because the coefficient limits of Annex 4 are not met` IS A BOOLEAN  -- vi: "dẫn đến thay đổi Phí bảo hiểm cơ bản do không đáp ứng giới hạn" @457

§§ `General terms — Part V`

-- where: Điều 29
DECLARE `Temporary-cover claim` HAS
    `date the application was completed and the first premium paid in full` IS A DATE  -- vi: "hoàn tất Hồ sơ" @964
    `date the certificate was issued`                     IS A MAYBE DATE -- vi: "cấp Giấy chứng nhận bảo hiểm" @966
    `date the insurance was declined`                     IS A MAYBE DATE -- vi: "từ chối chấp thuận bảo hiểm" @966
    `date the policyowner asked to cancel the application` IS A MAYBE DATE -- vi: "yêu cầu hủy bỏ Hồ sơ yêu cầu bảo hiểm" @967
    `date of death`                                       IS A DATE       -- vi: "tử vong" @956
    `death caused by an Accident`                         IS A BOOLEAN    -- vi: "tử vong do Tai nạn" @956
    `death by suicide`                                    IS A BOOLEAN    -- vi: "tử vong do tự tử, dù trong trạng thái tỉnh táo hay mất trí" @981
    `total sum insured of all applications for the same insured` IS A NUMBER  -- vi: "tổng Số tiền bảo" @957
    `total first premium paid on all applications for the same insured` IS A NUMBER  -- vi: "tổng phí bảo hiểm đầu tiên đã" @959
    `costs of the medical examination`                    IS A MAYBE NUMBER  -- vi: "chi phí kiểm tra y tế, nếu có" @988

-- where: Điều 30
DECLARE `What the Company would have done with correct information` IS ONE OF
    `declined the insurance`                              -- vi: "Không thể bảo hiểm được cho Khách hàng" @1008
    `accepted with limited benefits or an extra premium`  -- vi: "Chấp thuận bảo hiểm nhưng có giới hạn quyền lợi bảo hiểm" @1028
    `accepted on the same terms`

-- where: Điều 30, 40
DECLARE `Refund account` HAS
    `premiums paid`                                       IS A NUMBER     -- vi: "phí bảo hiểm đã đóng" @1015
    `benefits paid`                                       IS A NUMBER     -- vi: "các quyền lợi bảo hiểm đã chi trả trước đó" @1016
    `debts`                                               IS A NUMBER     -- vi: "khoản nợ" @1016
    `costs of the medical examination`                    IS A NUMBER     -- vi: "chi phí kiểm tra y tế" @1270
    `withdrawals from the contract account`               IS A NUMBER     -- vi: "khoản rút tiền từ Giá trị tài khoản hợp đồng" @1271

-- where: Điều 34
DECLARE `Reinstatement request` HAS
    `date of the lapse`                                   IS A DATE       -- vi: "ngày mất hiệu lực" @1103
    `date of the request`                                 IS A DATE       -- vi: "yêu cầu khôi phục hiệu lực Hợp đồng bảo hiểm" @1102
    `contract year of the lapse`                          IS A NUMBER     -- vi: "thời điểm" @1107
    `all overdue basic premiums paid`                     IS A BOOLEAN    -- vi: "tất cả các kỳ Phí bảo" @1114
    `one due basic premium paid`                          IS A BOOLEAN    -- vi: "1 kỳ Phí bảo hiểm cơ bản đến hạn" @1120
    `all overdue and due rider premiums paid`             IS A BOOLEAN    -- vi: "phải đóng tất cả các khoản phí" @1129
    `evidence of health given and insurability conditions met` IS A BOOLEAN  -- vi: "Cung cấp bằng chứng về tình trạng sức khỏe của Người được bảo" @1131
    `the insured alive when the Company approves`         IS A BOOLEAN    -- vi: "phải còn sống vào thời điểm Công ty" @1146

§§ `Outcomes the document names`

-- where: Điều 23(a)
DECLARE `Outcome of a death claim` IS ONE OF
    `the death benefit is paid`                                            -- vi: "quyền lợi bảo hiểm tử vong" @691
    `only the beneficiaries who took no part in the fraud are paid, in their designated shares`  -- vi: "chỉ chi trả phần" @704
    `the contract ends and the contract account value at death is paid`   -- vi: "chấm dứt hợp đồng và chi trả Giá trị tài khoản hợp đồng" @724

-- where: Điều 28
DECLARE Payee IS ONE OF
    `the policyowner, as payee`                                            -- vi: "Bên mua bảo hiểm nếu Bên mua bảo hiểm là cá nhân" @940
    `the insured, as payee`                                                -- vi: "Người được bảo hiểm, nếu Bên mua bảo hiểm là tổ chức" @941
    `the beneficiaries, as payees`                                         -- vi: "Người thụ hưởng" @943
    `the lawful heirs of the policyowner`                                  -- vi: "người thừa kế hợp pháp của Bên mua" @949

-- where: Điều 29
DECLARE `Outcome of a temporary-cover claim` IS ONE OF
    `the temporary-cover benefit is paid`
        HAS `the benefit amount` IS A NUMBER                               -- vi: "Công ty sẽ chi trả 100 triệu đồng" @957
    `the first premium is refunded, without interest`
        HAS `the refund amount` IS A NUMBER                                -- vi: "hoàn lại tổng phí bảo hiểm đầu tiên đã" @962
    `the temporary cover does not respond`                                 -- vi: "Bảo hiểm tạm thời sẽ không được chi trả" @975

-- where: Điều 30(b)(ii)
DECLARE `Option under Article 30(b)(ii)` IS ONE OF
    `pay the benefit in full after collecting or deducting the extra premium`  -- vi: "Chi trả đầy đủ quyền lợi bảo hiểm sau khi đã thu thêm hoặc khấu trừ" @1041
    `pay a sum insured reduced in proportion to the premium paid`          -- vi: "Chi trả Số tiền bảo hiểm đã giảm tương ứng với mức phí bảo hiểm" @1043
    `pay the benefits outside the insurable limits`                        -- vi: "Chi trả quyền lợi bảo hiểm nằm ngoài giới hạn có thể được bảo hiểm" @1045

-- The answer ktv-assessment.l4 gives a claim: an amount, or the provision that stops it.
-- where: Điều 1-6, 23, 24
DECLARE `Answer to a claim` IS ONE OF
    `payable`
        HAS `the amount payable` IS A NUMBER                               -- vi: "Công ty sẽ chi trả" @307
    `not payable, because`
        HAS `the reason` IS A STRING                                       -- vi: "Công ty sẽ không chi trả" @691
