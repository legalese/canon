IMPORT prelude
IMPORT `lsa-practice`

-- Land Surveyors Act 1991, ss 3, 10, 12, 15, 17, 19, 25-30, 34 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_land-surveyors-act-1991.py). Expected results were written by
-- hand from the text.

`a qualified 25-year-old` MEANS Applicant WITH
    `age` IS 25
    `has a qualifying route under s 12(1)(a)` IS TRUE
    `passed the professional interview` IS TRUE
    `paid the prescribed fee` IS TRUE
    `of good character and reputation in the Board's opinion` IS TRUE

`a qualified 21-year-old` MEANS Applicant WITH
    `age` IS 21
    `has a qualifying route under s 12(1)(a)` IS TRUE
    `passed the professional interview` IS TRUE
    `paid the prescribed fee` IS TRUE
    `of good character and reputation in the Board's opinion` IS TRUE

`a qualified 20-year-old` MEANS Applicant WITH
    `age` IS 20
    `has a qualifying route under s 12(1)(a)` IS TRUE
    `passed the professional interview` IS TRUE
    `paid the prescribed fee` IS TRUE
    `of good character and reputation in the Board's opinion` IS TRUE

`a 30-year-old without the interview` MEANS Applicant WITH
    `age` IS 30
    `has a qualifying route under s 12(1)(a)` IS TRUE
    `passed the professional interview` IS FALSE
    `paid the prescribed fee` IS TRUE
    `of good character and reputation in the Board's opinion` IS TRUE

`a 30-year-old without a qualifying route` MEANS Applicant WITH
    `age` IS 30
    `has a qualifying route under s 12(1)(a)` IS FALSE
    `passed the professional interview` IS TRUE
    `paid the prescribed fee` IS TRUE
    `of good character and reputation in the Board's opinion` IS TRUE

`a qualified 30-year-old of bad character` MEANS Applicant WITH
    `age` IS 30
    `has a qualifying route under s 12(1)(a)` IS TRUE
    `passed the professional interview` IS TRUE
    `paid the prescribed fee` IS TRUE
    `of good character and reputation in the Board's opinion` IS FALSE

`a compliant firm` MEANS Corporation WITH
    `survey services are a primary object` IS TRUE
    `paid-up capital` IS 1000000
    `directors` IS 5
    `qualified directors` IS 3
    `has a controlling surveyor director authorised by resolution` IS TRUE
    `is insured under s 21` IS TRUE

`a firm with $999,999 capital` MEANS Corporation WITH
    `survey services are a primary object` IS TRUE
    `paid-up capital` IS 999999
    `directors` IS 5
    `qualified directors` IS 3
    `has a controlling surveyor director authorised by resolution` IS TRUE
    `is insured under s 21` IS TRUE

`a firm with half its directors qualified` MEANS Corporation WITH
    `survey services are a primary object` IS TRUE
    `paid-up capital` IS 2000000
    `directors` IS 4
    `qualified directors` IS 2
    `has a controlling surveyor director authorised by resolution` IS TRUE
    `is insured under s 21` IS TRUE

`an uninsured firm` MEANS Corporation WITH
    `survey services are a primary object` IS TRUE
    `paid-up capital` IS 2000000
    `directors` IS 3
    `qualified directors` IS 2
    `has a controlling surveyor director authorised by resolution` IS TRUE
    `is insured under s 21` IS FALSE

`a firm without a controlling surveyor` MEANS Corporation WITH
    `survey services are a primary object` IS TRUE
    `paid-up capital` IS 2000000
    `directors` IS 3
    `qualified directors` IS 3
    `has a controlling surveyor director authorised by resolution` IS FALSE
    `is insured under s 21` IS TRUE

