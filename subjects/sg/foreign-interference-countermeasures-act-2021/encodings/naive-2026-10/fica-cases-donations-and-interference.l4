§ `s 4`

#ASSERT NOT `the actor is a foreign principal` `a Singapore citizen`
#ASSERT `the actor is a foreign principal` `a Singapore permanent resident`
#ASSERT `the actor is a foreign principal` `a company with its principal place of business abroad`
#ASSERT NOT `the actor is a foreign principal` `a Singapore company doing business in Singapore`

§ `s 14`

#ASSERT `the recipient is politically significant` `a senior political party official`
#ASSERT NOT `the recipient is politically significant` `a private individual`

§ `ss 17 to 19`

#ASSERT `the conduct is a section 17 offence` TRUE TRUE TRUE TRUE
#ASSERT NOT `the conduct is a section 17 offence` TRUE TRUE TRUE FALSE
#ASSERT NOT `the conduct is a section 17 offence` TRUE FALSE TRUE TRUE

#ASSERT NOT `the conduct is a section 18 offence` TRUE TRUE TRUE FALSE

#ASSERT `the maximum fine` `section 17 interference` TRUE EQUALS 50000
#ASSERT `the maximum fine` `section 18 targeted interference` FALSE EQUALS 1000000
#ASSERT `the maximum fine` `preparing section 18 interference` TRUE EQUALS 60000

#ASSERT `the maximum imprisonment in years` `section 18 targeted interference` TRUE EQUALS 14
#ASSERT `the maximum imprisonment in years` `section 17 interference` FALSE EQUALS 0

§ `s 45`

#ASSERT `the maximum fine for an individual who ignores it` `a Class 4 must-carry direction` EQUALS 40000

#ASSERT `the further daily fine for an individual who keeps ignoring it` `an account restriction direction` EQUALS 100000

#ASSERT `the maximum fine for ignoring an access blocking direction` 10 EQUALS 200000
#ASSERT `the maximum fine for ignoring an access blocking direction` 30 EQUALS 500000

