IMPORT prelude
IMPORT `ftza-zones`

-- Free Trade Zones Act 1966, ss 5, 6, 8, 9, 10, 10A, 14A, 14J, 14M, 14P, 14Z, 18(2), 23(1), 23A -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_free-trade-zones-act-1966.py). Expected results were written by
-- hand from the text.

§ `s 5`

#ASSERT `the goods may be brought into the zone` FALSE
#ASSERT NOT `the goods may be brought into the zone` TRUE

#ASSERT `the handling is permitted under s 5` `storage for transhipment` TRUE FALSE FALSE
#ASSERT `the handling is permitted under s 5` `survey and repacking` TRUE FALSE TRUE
#ASSERT NOT `the handling is permitted under s 5` `survey and repacking` TRUE FALSE FALSE
#ASSERT NOT `the handling is permitted under s 5` `sale or exhibition` TRUE FALSE FALSE
#ASSERT `the handling is permitted under s 5` `sale or exhibition` FALSE FALSE FALSE
#ASSERT NOT `the handling is permitted under s 5` `repacking or sorting` FALSE TRUE FALSE

§ `s 6`

#ASSERT `prior written permission is needed` TRUE FALSE FALSE FALSE
#ASSERT `prior written permission is needed` FALSE TRUE TRUE TRUE
#ASSERT NOT `prior written permission is needed` FALSE TRUE TRUE FALSE
#ASSERT NOT `prior written permission is needed` FALSE TRUE FALSE TRUE
#ASSERT NOT `prior written permission is needed` FALSE FALSE FALSE FALSE

§ `ss 8, 9, 10`

#ASSERT `the retail trade is an offence` TRUE FALSE
#ASSERT NOT `the retail trade is an offence` TRUE TRUE

#ASSERT `the use is an offence under s 9` TRUE TRUE FALSE
#ASSERT NOT `the use is an offence under s 9` TRUE TRUE TRUE
#ASSERT NOT `the use is an offence under s 9` FALSE TRUE FALSE

#ASSERT `the person may enter or reside in the zone` TRUE FALSE
#ASSERT NOT `the person may enter or reside in the zone` TRUE TRUE
#ASSERT NOT `the person may enter or reside in the zone` FALSE FALSE

§ `s 10A`

#ASSERT `the maximum fine under s 10A` `unauthorised retail trade under s 8` 50000 EQUALS 10000
#ASSERT `the maximum fine under s 10A` `unauthorised entry under s 10` 50000 EQUALS 5000
#ASSERT `the maximum fine under s 10A` `using unpaid-duty goods under s 9` 3000 EQUALS 10000
#ASSERT `the maximum fine under s 10A` `using unpaid-duty goods under s 9` 50000 EQUALS 50000
#ASSERT `the maximum fine under s 10A` `manufacturing without permission under s 6(1)` 25000 EQUALS 25000

#ASSERT `the maximum months of imprisonment under s 10A` `unauthorised retail trade under s 8` EQUALS 0
#ASSERT `the maximum months of imprisonment under s 10A` `using unpaid-duty goods under s 9` EQUALS 12

§ `ss 14A, 14P`

#ASSERT `operating the zone is an offence` TRUE FALSE
#ASSERT NOT `operating the zone is an offence` TRUE TRUE

#ASSERT NOT `the ground supports suspension or revocation` `conviction for an offence before the licence`
#ASSERT `the ground supports suspension or revocation` `conviction for an offence under this Act during the licence`
#ASSERT `the ground supports suspension or revocation` `public interest or national security`

