IMPORT prelude
IMPORT daydate

§ `Singapore Companies Act 1967 — shared domain`

-- ===========================================================================
-- THE SHARED ONTOLOGY for Singapore's Companies Act 1967 (Cap. 50).
--
-- This module owns the nouns. Each Part module (starting with Part 3 —
-- Constitution of Companies) owns its own verbs, imports these types,
-- and never redeclares them.
--
-- Source: Singapore Statutes Online, current version as at 07 Sep 2026.
-- Citation: Companies Act 1967 (2020 Revised Edition).
-- URL: https://sso.agc.gov.sg/Act/CoA1967
--
-- INERT STYLE. Nothing here is exported. The types carry the Act's own
-- words in their field names so a domain expert can read a record
-- declaration against the section it comes from.
-- ===========================================================================


§§ `Company types — s 17`

-- s 17(2): three company types by liability
DECLARE `Company Type` IS ONE OF
    `company limited by shares`
    `company limited by guarantee`
    `unlimited company`

-- s 18(1): a private company is a sub-classification
DECLARE `Company Classification` IS ONE OF
    `public company`
    `private company`


§§ `Company`

DECLARE Company HAS
    `name`                     IS A STRING
    `company type`             IS A `Company Type`
    `classification`           IS A `Company Classification`
    `date of incorporation`    IS A DATE
    `has constitution`         IS A BOOLEAN
    `has share capital`        IS A BOOLEAN
    `number of members`        IS A NUMBER
    `member limit in constitution` IS A NUMBER
    `restricts share transfer` IS A BOOLEAN


§§ `Persons and roles`

-- s 4(1): general interpretation
DECLARE Person HAS
    `name`       IS A STRING
    `is member`  IS A BOOLEAN
    `is officer` IS A BOOLEAN

-- s 25D: persons connected with directors
DECLARE `Director Connection` IS ONE OF
    `family member`
    `connected body corporate`
    `trustee of connected trust`
    `partner of director`
    `partner firm`

DECLARE Director HAS
    `name`                IS A STRING
    `is director`         IS A BOOLEAN
    `is secretary`        IS A BOOLEAN
    `connected persons`   IS A LIST OF `Connected Person`

DECLARE `Connected Person` HAS
    `name`           IS A STRING
    `connection type` IS A `Director Connection`


§§ `Name-related types — ss 27–29`

-- s 27: name reservation and registration
DECLARE `Entity Type For Name Check` IS ONE OF
    `existing company`
    `limited liability partnership`
    `limited partnership`
    `registered business name`
    `foreign company`
    `VCC`

DECLARE `Dissolved Entity` HAS
    `name`                IS A STRING
    `entity type`         IS A `Entity Type For Name Check`
    `date of dissolution` IS A DATE
    `dissolution method`  IS A `Dissolution Method`

DECLARE `Dissolution Method` IS ONE OF
    `wound up`
    `struck off register`
    `registration cancelled`
    `ceased business`


§§ `Constitution-related types — ss 22, 26, 26A`

DECLARE `Entrenching Provision` HAS
    `description`                IS A STRING
    `requires unanimous consent`  IS A BOOLEAN
    `minimum majority if not unanimous` IS A NUMBER


§§ `Execution-related types — s 41B`

-- s 41B: how a company may execute deeds
DECLARE `Signing Configuration` IS ONE OF
    `director and secretary`
    `two directors`
    `director and witness`
