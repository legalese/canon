IMPORT prelude
IMPORT daydate

-- Sale of Food Act 1973 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../source/SFA1973.txt (SSO informal consolidation, version in
-- force from 1 May 2026, deposited in this repository).

§ `Sale of Food Act 1973 — the nouns`

§§ `The article (ss 2A, 2C, 2D, 25)`

-- s 2A(3): what is not food, whatever else it is.
DECLARE `Excluded product` IS ONE OF
    `none`
    `a health product`
    `a medicinal product`
    `a controlled drug, psychoactive substance, controlled material or substance`
    `a poison`
    `cosmetics`
    `a tobacco product or tobacco substitute`
    `a package (not edible packaging)`
    `fodder or feeding stuffs for animals`
    `declared by the Minister not to be food`

DECLARE Article HAS
    `used, capable of use, or represented as for human consumption` IS A BOOLEAN   -- s 2A(1)(a)
    `an ingredient, additive or substance used in preparing such food` IS A BOOLEAN -- s 2A(1)(b)-(c)
    `chewing gum, or its ingredient`                IS A BOOLEAN                    -- s 2A(1)(d)
    `declared by the Minister to be food`           IS A BOOLEAN                    -- s 2A(1)(e)
    `excluded as`                                   IS AN `Excluded product`         -- s 2A(3)
    `a food contact article`                        IS A BOOLEAN

-- s 2C(1): the likely effect of consumption, assuming proper processing and
-- intended use; (2): what does not make food unsafe.
DECLARE `Safety facts` HAS
    `likely to cause illness, injury or physical harm when used as intended` IS A BOOLEAN
    `objection only by preference, belief, quantity, allergy or health condition` IS A BOOLEAN

-- s 2D(1)(a)-(e); (2).
DECLARE `Suitability facts` HAS
    `damaged, deteriorated or perished, affecting its intended use`   IS A BOOLEAN
    `contains or carries a damaged or contaminated thing, affecting use` IS A BOOLEAN
    `product of a diseased animal or one not slaughtered, not declared safe` IS A BOOLEAN
    `contains an unexpected and unreasonable foreign agent`          IS A BOOLEAN
    `packaging damaged or contaminated, affecting its intended use`  IS A BOOLEAN
    `only a lawful chemical, or an objection by preference, belief, quantity or allergy` IS A BOOLEAN

-- s 25(a)-(e): adulteration.
DECLARE `Adulteration facts` HAS
    `mixed with something diminishing its properties or prejudicing the buyer` IS A BOOLEAN
    `something extracted or omitted, to its detriment`                IS A BOOLEAN
    `mixed with something of lower commercial value`                  IS A BOOLEAN
    `does not comply with the prescribed standard`                    IS A BOOLEAN
    `contains a substance rendering it injurious to health`           IS A BOOLEAN

§§ `The business (ss 2B, 2F)`

DECLARE `Business facts` HAS
    `handles food for sale, sells food, or carries on primary food production` IS A BOOLEAN  -- s 2B(1)
    `excluded under s 2B(2)`                         IS A BOOLEAN   -- intermediary, furniture hire, declared
    `for a purpose in the First Schedule to the Environmental Public Health Act 1987` IS A BOOLEAN -- retail
    `has a non-retail component`                     IS A BOOLEAN   -- s 2F(1) "but includes"
    `a primary food production business`             IS A BOOLEAN
    `licensed under Part 4`                          IS A BOOLEAN

§§ `What the person did`

DECLARE Conduct IS ONE OF
    `selling adulterated food` HAS `told the purchaser the nature of the adulteration` IS A BOOLEAN   -- s 11
    `selling food with a prohibited substance`                                                      -- s 12
    `selling food with a substance over the permitted proportion`                                   -- s 13
    `selling food with methyl, isopropyl or denatured alcohol` HAS `parts per million` IS A NUMBER  -- s 14
    `selling unsafe food` HAS `knew or ought reasonably to have known` IS A BOOLEAN                -- s 15(1)
    `selling unsuitable food` HAS `knew or ought reasonably to have known` IS A BOOLEAN            -- s 15(2)
    `selling food packaged or labelled non-compliantly`                                             -- s 16
    `publishing a non-compliant food advertisement` HAS                                             -- s 16A
        `a seller or promoter, or its agent or employee`  IS A BOOLEAN
        `a carrier with no control over content, or a publisher in the ordinary course` IS A BOOLEAN
        `ought to have known, warned, or in the food business` IS A BOOLEAN
    `selling food falsely or misleadingly labelled or advertised`                                   -- s 17
    `selling food not of the nature, substance or quality demanded, to the purchaser's prejudice`   -- s 18
    `selling food prepared under insanitary conditions`                                             -- s 19
    `carrying on a food business` HAS `business` IS A `Business facts`                              -- s 21
    `a licensee failing to have staff immunised as required`                                        -- s 22(5)
    `transporting food in an unclean vehicle, or without required equipment`                        -- s 23
    `failing to comply with a food safety direction` HAS `with reasonable excuse` IS A BOOLEAN       -- s 10K(1)
    `removing a direction affixed to food premises` HAS `while the direction remains in force` IS A BOOLEAN -- s 10K(3)
    `importing, advertising or selling a prohibited food contact article` HAS                       -- s 40
        `a carrier with no control over content, or a publisher in the ordinary course` IS A BOOLEAN
        `ought to have known, or warned`                  IS A BOOLEAN
    `obstructing an officer, or interfering with an official mark` HAS `with authority` IS A BOOLEAN -- s 41
    `refusing to give information required by an officer`                                           -- s 5(4)
    `an officer breaching secrecy`                                                                  -- s 5(5)
    `refusing to give a sample` HAS `the demand was one the officer could lawfully make` IS A BOOLEAN -- s 6(3)-(4), 7(1)-(2)
    `using an analysis result as an advertisement`                                                  -- s 10(3)
    `giving a false written warranty` HAS `had reason to believe it true` IS A BOOLEAN             -- s 33(5)
    `wilfully giving false information in a licence application`                                    -- s 46(6)
    `refusing or mis-stating name and address`                                                      -- s 48(3)
    `contravening food regulations`                                                                 -- s 56(1)(r)

-- s 33: the written warranty defence.
DECLARE `Warranty facts` HAS
    `bought in reliance on a signed written warranty as to its nature` IS A BOOLEAN
    `no reason to believe the food did not conform`  IS A BOOLEAN
    `had it conformed, there would be no offence`    IS A BOOLEAN
    `the warrantor resides outside Singapore`        IS A BOOLEAN
    `took reasonable steps and believed the warranty` IS A BOOLEAN
    `summons served on`                              IS A DATE
    `notice with a copy delivered to the prosecutor on` IS A MAYBE DATE
    `like notice posted to the warrantor on`         IS A MAYBE DATE

DECLARE `Food case` HAS
    `article`                                        IS AN Article
    `conduct`                                        IS A Conduct
    `a second or subsequent conviction`              IS A BOOLEAN
    `did not act wilfully, and took all reasonable steps to ascertain the sale was lawful` IS A BOOLEAN   -- s 32
    `warranty`                                       IS A MAYBE `Warranty facts`
    `prescribed as compoundable`                     IS A BOOLEAN
