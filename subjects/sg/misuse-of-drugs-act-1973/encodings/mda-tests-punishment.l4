IMPORT prelude
IMPORT `mda-types`
IMPORT `mda-second-schedule`
IMPORT `mda-section-punishments`
IMPORT `mda-punishment`

-- Tests for mda-punishment.l4, mda-second-schedule.l4 and mda-section-punishments.l4 (Misuse of Drugs Act 1973, ss 33, 33A, 33B and the Second Schedule).
-- Expected values are the Schedule's cells as printed, parsed by generators/mda_tests_2.py.  Generated by generators/mda_tests_2.py.

`nothing manufactured in particular` MEANS `Scheduled Quantity Facts` WITH
    `the drug manufactured is morphine or a salt, ester or salt of ester of morphine` IS FALSE
    `the drug manufactured is diamorphine or a salt of diamorphine` IS FALSE
    `the drug manufactured is cocaine or a salt of cocaine` IS FALSE
    `the drug manufactured is methamphetamine or a salt of methamphetamine` IS FALSE

`morphine manufactured` MEANS `Scheduled Quantity Facts` WITH
    `the drug manufactured is morphine or a salt, ester or salt of ester of morphine` IS TRUE
    `the drug manufactured is diamorphine or a salt of diamorphine` IS FALSE
    `the drug manufactured is cocaine or a salt of cocaine` IS FALSE
    `the drug manufactured is methamphetamine or a salt of methamphetamine` IS FALSE

`diamorphine manufactured` MEANS `Scheduled Quantity Facts` WITH
    `the drug manufactured is morphine or a salt, ester or salt of ester of morphine` IS FALSE
    `the drug manufactured is diamorphine or a salt of diamorphine` IS TRUE
    `the drug manufactured is cocaine or a salt of cocaine` IS FALSE
    `the drug manufactured is methamphetamine or a salt of methamphetamine` IS FALSE

`cocaine manufactured` MEANS `Scheduled Quantity Facts` WITH
    `the drug manufactured is morphine or a salt, ester or salt of ester of morphine` IS FALSE
    `the drug manufactured is diamorphine or a salt of diamorphine` IS FALSE
    `the drug manufactured is cocaine or a salt of cocaine` IS TRUE
    `the drug manufactured is methamphetamine or a salt of methamphetamine` IS FALSE

`methamphetamine manufactured` MEANS `Scheduled Quantity Facts` WITH
    `the drug manufactured is morphine or a salt, ester or salt of ester of morphine` IS FALSE
    `the drug manufactured is diamorphine or a salt of diamorphine` IS FALSE
    `the drug manufactured is cocaine or a salt of cocaine` IS FALSE
    `the drug manufactured is methamphetamine or a salt of methamphetamine` IS TRUE

