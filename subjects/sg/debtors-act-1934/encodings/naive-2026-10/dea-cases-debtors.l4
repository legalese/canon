§ `ss 3 and 8(1)`

#ASSERT NOT `the court may order the debtor's arrest` `a debtor still owing 5000 who is staying put`
#ASSERT `the court may order the debtor's arrest` `a debtor who has paid part and is booked to emigrate`

#ASSERT `the debtor may actually be arrested` `a debtor about to fly out owing 20000, no deposit rule`
#ASSERT NOT `the debtor may actually be arrested` `a debtor about to fly out, deposit required but not made`
#ASSERT `the debtor may actually be arrested` `a debtor about to fly out, deposit made`

§ `ss 6, 8(1) and 24(7)-(9)`

#ASSERT `the court may commit the debtor for default` `a debtor who could pay and did not`
#ASSERT NOT `the court may commit the debtor for default` `a debtor who never had the means`
#ASSERT NOT `the court may commit the debtor for default` `a debtor who showed sufficient cause`
#ASSERT NOT `the court may commit the debtor for default` `a debtor never personally served`
#ASSERT NOT `the court may commit the debtor for default` `a debtor who is up to date`

#ASSERT NOT `the committal order may be executed` `a committal awaiting the subsistence deposit`
#ASSERT `the committal order may be executed` `a committal with the subsistence deposit made`

#ASSERT `the court may commit the debtor after examination` TRUE TRUE
#ASSERT NOT `the court may commit the debtor after examination` TRUE FALSE

§ `ss 9 and 12`

#ASSERT `the judgment debt with expenses` 10000 800 FALSE EQUALS 10800
#ASSERT `the judgment debt with expenses` 10000 800 TRUE EQUALS 10000

#ASSERT `the debt still owed after imprisonment` 10000 2500 6 EQUALS 7500

§ `ss 10 and 22`

#ASSERT `the court may commit the trustee` TRUE FALSE FALSE
#ASSERT NOT `the court may commit the trustee` TRUE TRUE FALSE
#ASSERT NOT `the court may commit the trustee` TRUE FALSE TRUE

§ `maximum terms`

#ASSERT `the maximum length` `committal after examination` EQUALS 6
#ASSERT `the maximum length` `committal of a defaulting trustee` EQUALS 6
#ASSERT `the maximum length` `imprisonment for a fraudulent-debtor offence` EQUALS 1

#ASSERT `the unit of the maximum` `committal after examination` EQUALS weeks
#ASSERT `the unit of the maximum` `committal of a defaulting trustee` EQUALS months
#ASSERT `the unit of the maximum` `imprisonment for a fraudulent-debtor offence` EQUALS years

§ `ss 13 and 15`

#ASSERT `an order to arrest the defendant may issue` `a local trader about to flee to dodge judgment`
#ASSERT NOT `an order to arrest the defendant may issue` `a visitor with no business or home here, about to leave`
#ASSERT NOT `an order to arrest the defendant may issue` `a tenant in a possession action about to flee`
#ASSERT NOT `an order to arrest the defendant may issue` `a resident going on holiday with no intent to evade`
#ASSERT `an order to arrest the defendant may issue` `a resident who moved his assets abroad to defeat judgment`

#ASSERT `the defendant may be arrested before judgment` `a local trader about to flee to dodge judgment`
#ASSERT NOT `the defendant may be arrested before judgment` `the same trader after paying the specified sum`

#ASSERT `further detention for want of security is lawful` 3 FALSE
#ASSERT NOT `further detention for want of security is lawful` 6 FALSE
#ASSERT NOT `further detention for want of security is lawful` 2 TRUE

§ `ss 17 and 20`

#ASSERT `the property may be seized before judgment` `a defendant who vanished abroad`
#ASSERT NOT `the property may be seized before judgment` `a vanished defendant before any claim is issued`
#ASSERT `the property may be seized before judgment` `a defendant hiding assets`
#ASSERT NOT `the property may be seized before judgment` `assets held by a Government officer, no consent`
#ASSERT `the property may be seized before judgment` `assets held by a Government officer, Attorney-General consents`

#ASSERT `the earlier judgment creditor has priority` 8 TRUE
#ASSERT NOT `the earlier judgment creditor has priority` 13 TRUE
#ASSERT NOT `the earlier judgment creditor has priority` 8 FALSE

