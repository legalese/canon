DECLARE `A governing text` IS ONE OF
    `the law in force when the contract was made`
    `Law 08/2022/QH15`

DECLARE `A contract made before the commencement` HAS
    `date the contract was made`                             IS A DATE
    `the contract is still running on 1 January 2023`        IS A BOOLEAN
    `the parties agreed to amend it to conform to this Law and to apply this Law` IS A BOOLEAN

