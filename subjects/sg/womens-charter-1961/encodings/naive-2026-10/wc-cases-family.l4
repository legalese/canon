§ `ss 22, 23, 40 -- REQ-0006 (Registry of Marriages, 18 May 2029)`

#ASSERT `the officiant may solemnise a marriage` `the Registrar`
#ASSERT `the officiant may solemnise a marriage` `a licensed solemniser`
#ASSERT NOT `the officiant may solemnise a marriage` `a religious leader without a solemniser's licence`
#ASSERT NOT `the officiant may solemnise a marriage` `a friend of the couple`

`a Registry wedding done properly` MEANS Solemnisation WITH
    `the officiant` IS `the Registrar`
    `on a valid licence` IS TRUE
    `witnesses present` IS 2
    `all present together or remote with permission` IS TRUE
    `both parties freely consented` IS TRUE

`a licensed solemniser with one witness` MEANS Solemnisation WITH
    `the officiant` IS `a licensed solemniser`
    `on a valid licence` IS TRUE
    `witnesses present` IS 1
    `all present together or remote with permission` IS TRUE
    `both parties freely consented` IS TRUE

`a wedding with no licence` MEANS Solemnisation WITH
    `the officiant` IS `a licensed solemniser`
    `on a valid licence` IS FALSE
    `witnesses present` IS 2
    `all present together or remote with permission` IS TRUE
    `both parties freely consented` IS TRUE

`a religious leader without a licence` MEANS Solemnisation WITH
    `the officiant` IS `a religious leader without a solemniser's licence`
    `on a valid licence` IS TRUE
    `witnesses present` IS 2
    `all present together or remote with permission` IS TRUE
    `both parties freely consented` IS TRUE

#ASSERT NOT `the ceremony is void under section 13` `a Registry wedding done properly`
#ASSERT NOT `the ceremony is void under section 13` `a licensed solemniser with one witness`
#ASSERT `the ceremony is void under section 13` `a wedding with no licence`
#ASSERT `the ceremony is void under section 13` `a religious leader without a licence`

#ASSERT `the ceremony meets section 23` `a Registry wedding done properly`
#ASSERT NOT `the ceremony meets section 23` `a licensed solemniser with one witness`
#ASSERT `the ceremony meets section 23` `a wedding with no licence`
#ASSERT `the ceremony meets section 23` `a religious leader without a licence`

#ASSERT NOT `the solemniser commits a section 40 offence` `a Registry wedding done properly`
#ASSERT `the solemniser commits a section 40 offence` `a licensed solemniser with one witness`
#ASSERT `the solemniser commits a section 40 offence` `a wedding with no licence`
#ASSERT NOT `the solemniser commits a section 40 offence` `a religious leader without a licence`

