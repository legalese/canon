IMPORT prelude
IMPORT daydate

-- Metrication Act 1970 (Singapore) — THE NOUNS.
--
-- Source: ../source/MA1970.txt (SSO PDF, current version as at 07 Oct 2026; its text is identical to the 05 Oct 2026 PDF's).

§ `Metrication Act 1970 — the nouns`

-- Every unit the Act's four Schedules name, and one for any other.
DECLARE Unit IS ONE OF
    -- First Schedule, the 6 basic units
    metre, kilogram, second, ampere, kelvin, candela
    -- Second Schedule, supplementary and derived units
    hertz, newton, joule, watt, coulomb, volt, farad, ohm, weber, tesla, henry, lumen, lux, radian, steradian
    -- Fourth Schedule, units used in conjunction with them
    hectare, `metric tonne`, litre, `centigrade or Celsius`
    -- Third Schedule, units that may be converted (s 5)
    yard, pound, gallon, tahil, kati, chhun, chhek
    `another unit`

DECLARE Schedule IS ONE OF
    `the First Schedule`
    `the Second Schedule`
    `the Fourth Schedule`
    `the Third Schedule`
    `no Schedule`

-- A row of the First, Second or Fourth Schedule: "Unit, Symbol, Quantity".
DECLARE `Unit row` HAS
    `schedule` IS A Schedule
    `symbol`   IS A STRING
    `quantity` IS A STRING

-- A row of the Third Schedule: "1 yard = 0.9144 metre exactly".
DECLARE Conversion HAS
    `SI value of one unit` IS A NUMBER
    `SI unit`              IS A STRING
    `exactly`              IS A BOOLEAN    -- "exactly" or "approximately"

-- s 5(a)-(b): which system the unit comes from.
DECLARE `System of the unit` IS ONE OF
    `an imperial standard of extension, weight or capacity`   -- s 5(a)
    `the local customary system of weights and measures`       -- s 5(b)
    `neither`

-- s 4: an order the Minister makes.
DECLARE `Section 4 order` HAS
    `replaces references to non-metric units in written law with SI units` IS A BOOLEAN
    `each replacement is equivalent or a desirable approximation` IS A BOOLEAN   -- s 4(1)(a), (b)
    `published in the Gazette`                                   IS A BOOLEAN   -- s 4(2)

-- Goal 1: where a unit sits in the International System of Units (s 3(2)).
DECLARE `SI role` IS ONE OF
    `a basic unit`                          -- First Schedule
    `a supplementary or derived unit`       -- Second Schedule
    `a unit used in conjunction with them`  -- Fourth Schedule
    `not a unit of the International System`

DECLARE `SI status` HAS
    `a unit of the International System of Units` IS A BOOLEAN
    `role`     IS AN `SI role`
    `symbol`   IS A MAYBE STRING
    `quantity` IS A MAYBE STRING

-- Goal 2: the legal force of using a unit.
DECLARE `Legal force of the use` IS ONE OF
    `legal force and validity under s 3(1)`
    `its own legal force, preserved by s 7(2)`
    `no legal force from this Act`

-- Goal 3: a conversion under s 5.
DECLARE `Converted value` HAS
    `SI value`  IS A NUMBER
    `SI unit`   IS A STRING
    `exact`     IS A BOOLEAN
    `s 5 limb`  IS A `System of the unit`

-- Goal 4: a challenge to an act done in a non-SI unit.
DECLARE `Challenge outcome` IS ONE OF
    `barred by s 7(1)`
    `not barred: the act was done after the order`
    `not barred: the challenge rests on other grounds too`
    `not applicable: the act was done in an SI unit`

-- The top-level goal: one measurement, as used in Singapore.
DECLARE Measurement HAS
    `amount`                                     IS A NUMBER
    `unit`                                       IS A Unit
    `used on`                                    IS A DATE
    `the context excludes the Fourth Schedule`   IS A BOOLEAN    -- s 2(1)(b)
    `the use is lawful in Singapore under another system` IS A BOOLEAN   -- s 7(2)
    `the s 4 order touching it was made on`      IS A MAYBE DATE  -- s 7(1)
    `challenged only on the units ground`        IS A BOOLEAN     -- s 7(1)
