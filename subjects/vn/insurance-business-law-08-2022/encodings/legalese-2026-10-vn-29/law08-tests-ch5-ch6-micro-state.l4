`a name with the word insurance, by an insurer` MEANS `A proposed enterprise name` WITH
    `contains the words bao hiem or tai bao hiem or a term that could be mistaken for an insurer, reinsurer or foreign branch` IS TRUE
    `contains the words moi gioi bao hiem or moi gioi tai bao hiem or a term that could be mistaken for an insurance broker` IS FALSE
    `the applicant is an insurer, reinsurer, foreign branch or mutual organisation` IS TRUE
    `the applicant is an insurance broker` IS FALSE
`a name with the word insurance, by a trader` MEANS `A proposed enterprise name` WITH
    `contains the words bao hiem or tai bao hiem or a term that could be mistaken for an insurer, reinsurer or foreign branch` IS TRUE
    `contains the words moi gioi bao hiem or moi gioi tai bao hiem or a term that could be mistaken for an insurance broker` IS FALSE
    `the applicant is an insurer, reinsurer, foreign branch or mutual organisation` IS FALSE
    `the applicant is an insurance broker` IS FALSE
`a name without the word` MEANS `A proposed enterprise name` WITH
    `contains the words bao hiem or tai bao hiem or a term that could be mistaken for an insurer, reinsurer or foreign branch` IS FALSE
    `contains the words moi gioi bao hiem or moi gioi tai bao hiem or a term that could be mistaken for an insurance broker` IS FALSE
    `the applicant is an insurer, reinsurer, foreign branch or mutual organisation` IS FALSE
    `the applicant is an insurance broker` IS FALSE
`a name with the word broker, by a broker` MEANS `A proposed enterprise name` WITH
    `contains the words bao hiem or tai bao hiem or a term that could be mistaken for an insurer, reinsurer or foreign branch` IS FALSE
    `contains the words moi gioi bao hiem or moi gioi tai bao hiem or a term that could be mistaken for an insurance broker` IS TRUE
    `the applicant is an insurer, reinsurer, foreign branch or mutual organisation` IS FALSE
    `the applicant is an insurance broker` IS TRUE
`a name with the word broker, by a trader` MEANS `A proposed enterprise name` WITH
    `contains the words bao hiem or tai bao hiem or a term that could be mistaken for an insurer, reinsurer or foreign branch` IS FALSE
    `contains the words moi gioi bao hiem or moi gioi tai bao hiem or a term that could be mistaken for an insurance broker` IS TRUE
    `the applicant is an insurer, reinsurer, foreign branch or mutual organisation` IS FALSE
    `the applicant is an insurance broker` IS FALSE
#ASSERT `Dieu 152(4): the business registry may approve the name of the enterprise as an insurer name` `a name with the word insurance, by an insurer`
#ASSERT NOT `Dieu 152(4): the business registry may approve the name of the enterprise as an insurer name` `a name with the word insurance, by a trader`
#ASSERT `Dieu 152(4): the business registry may approve the name of the enterprise as an insurer name` `a name without the word`
#ASSERT `Dieu 152(5): the business registry may approve the name of the enterprise as a broker name` `a name with the word broker, by a broker`
#ASSERT NOT `Dieu 152(5): the business registry may approve the name of the enterprise as a broker name` `a name with the word broker, by a trader`
