§ `s 11(2)`

#ASSERT NOT `the candidate is disqualified from the Board` `an ordinary business leader`
#ASSERT `the candidate is disqualified from the Board` `an undischarged bankrupt`
#ASSERT `the candidate is disqualified from the Board` `a district judge`
#ASSERT `the candidate is disqualified from the Board` `a person once jailed for 6 months`
#ASSERT NOT `the candidate is disqualified from the Board` `a person once jailed for 5 months`
#ASSERT NOT `the candidate is disqualified from the Board` `a person jailed for 2 years and pardoned`

§ `ss 18 and 20(1)`

#ASSERT `the term of office in years` 0 EQUALS 3
#ASSERT `the term of office in years` 2 EQUALS 2
#ASSERT `the term of office in years` 5 EQUALS 3

#ASSERT `the event vacates the office` `the member is removed by the Minister`
#ASSERT `the event vacates the office` `the term expires without re-appointment`
#ASSERT `the event vacates the office` `the member fails to disclose an interest and the Minister is notified`
#ASSERT NOT `the event vacates the office` `the member fails to disclose an interest but no notice is given`
#ASSERT NOT `the event vacates the office` `the member is criticised by the Board`

#ASSERT `absence vacates the office` 3 FALSE
#ASSERT NOT `absence vacates the office` 4 TRUE

