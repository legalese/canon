DECLARE `A deposit` HAS
    `minimum charter capital or minimum allocated capital at the time of establishment` IS A NUMBER
    `amount deposited`                                       IS A NUMBER
    `the deposit is used to meet commitments to policyholders because solvency is short` IS A BOOLEAN
    `the Ministry of Finance approved the use in writing`    IS A BOOLEAN
    `date the deposit was used`                              IS A DATE
    `date the deposit used was replenished`                  IS A DATE
    `the business has ceased`                                IS A BOOLEAN
    `the whole deposit is being withdrawn`                   IS A BOOLEAN

