§ `s 2`

#ASSERT `the creature is an animal` `a dog`
#ASSERT `the creature is an animal` `a prawn`
#ASSERT `the creature is an animal` `a land snail`
#ASSERT NOT `the creature is an animal` `a butterfly`
#ASSERT NOT `the creature is an animal` `a human being`

#ASSERT NOT `the act is veterinary practice` `grooming a pet`

#ASSERT `the act is an excluded act` `diagnosing a disease or injury`
#ASSERT `the act is an excluded act` `performing surgery`
#ASSERT NOT `the act is an excluded act` `administering an anaesthetic`
#ASSERT NOT `the act is an excluded act` `giving non-surgical medical treatment`

§ `ss 3 and 90`

#ASSERT `is a duly qualified veterinarian` `a registered vet with a valid certificate`
#ASSERT NOT `is a duly qualified veterinarian` `a registered vet whose registration is suspended`
#ASSERT `is a duly qualified veterinarian` `a former licensee 6 months after commencement`
#ASSERT NOT `is a duly qualified veterinarian` `a former licensee 13 months after commencement`
#ASSERT NOT `is a duly qualified veterinarian` `a former licensee whose application was refused`

§ `s 29`

#ASSERT `doing the act is an offence under s 29` `a pet groomer` `administering an anaesthetic`
#ASSERT NOT `doing the act is an offence under s 29` `a supervised vet nurse` `administering an anaesthetic`
#ASSERT `doing the act is an offence under s 29` `a supervised vet nurse` `performing surgery`
#ASSERT `doing the act is an offence under s 29` `a suspended vet working under supervision` `administering an anaesthetic`
#ASSERT NOT `doing the act is an offence under s 29` `a supervised vet student` `performing surgery`
#ASSERT `doing the act is an offence under s 29` `an unsupervised vet student` `diagnosing a disease or injury`
#ASSERT NOT `doing the act is an offence under s 29` `a licensed inoculator` `inoculating with veterinary biologics`

§ `ss 30 and 33`

#ASSERT `the holding out is an offence under s 30` `a pet groomer` `using the title vet` FALSE FALSE
#ASSERT NOT `the holding out is an offence under s 30` `a pet groomer` `using the title vet` TRUE FALSE
#ASSERT `the holding out is an offence under s 30` `a pet groomer` `wilfully pretending to be a vet` TRUE FALSE
#ASSERT `the holding out is an offence under s 30` `a pet groomer` `advertising as a vet` TRUE TRUE
#ASSERT NOT `the holding out is an offence under s 30` `a pet groomer` `advertising as a vet` TRUE FALSE
#ASSERT NOT `the holding out is an offence under s 30` `a supervised vet student` `wearing a badge implying qualification` FALSE FALSE

#ASSERT NOT `the employer is guilty under s 30(6)` TRUE FALSE TRUE
#ASSERT `the employer is guilty under s 30(6)` TRUE TRUE TRUE

#ASSERT `the vet is guilty under s 33` TRUE FALSE TRUE
#ASSERT NOT `the vet is guilty under s 33` TRUE TRUE TRUE

§ `penalties`

#ASSERT NOT `breach is a criminal offence` `s 34 false specialist title`
#ASSERT `breach is a criminal offence` `s 32 holding another out as a vet`

#ASSERT `the maximum fine` `s 36 fraudulent registration or forged certificate` EQUALS 50000
#ASSERT `the maximum fine` `s 35 holding another out as a specialist` EQUALS 0

#ASSERT `the maximum imprisonment in months` `s 31 permitting another to hold one out` EQUALS 12

