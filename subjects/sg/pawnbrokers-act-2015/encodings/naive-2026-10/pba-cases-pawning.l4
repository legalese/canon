IMPORT prelude
IMPORT `pba-pawning`

-- Pawnbrokers Act 2015, ss 6, 48-51, 54, 56-57, 60-61, 63, 65, 67, 72, 74A, 79 and First to Third Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_pawnbrokers-act-2015.py). Expected results were written by
-- hand from the text.

`a compliant ticket holder` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS TRUE
    `repays loan and profit` IS TRUE
    `provides identification information` IS TRUE
    `pledge already forfeited` IS FALSE
    `pawnbroker knows presenter not entitled` IS FALSE
    `doubt persists after reasonable steps` IS FALSE
    `replacement ticket application found false` IS FALSE

`a holder without identification` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS TRUE
    `repays loan and profit` IS TRUE
    `provides identification information` IS FALSE
    `pledge already forfeited` IS FALSE
    `pawnbroker knows presenter not entitled` IS FALSE
    `doubt persists after reasonable steps` IS FALSE
    `replacement ticket application found false` IS FALSE

`a holder with a cancelled ticket` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS FALSE
    `repays loan and profit` IS TRUE
    `provides identification information` IS TRUE
    `pledge already forfeited` IS FALSE
    `pawnbroker knows presenter not entitled` IS FALSE
    `doubt persists after reasonable steps` IS FALSE
    `replacement ticket application found false` IS FALSE

`a holder after forfeiture` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS TRUE
    `repays loan and profit` IS TRUE
    `provides identification information` IS TRUE
    `pledge already forfeited` IS TRUE
    `pawnbroker knows presenter not entitled` IS FALSE
    `doubt persists after reasonable steps` IS FALSE
    `replacement ticket application found false` IS FALSE

`a presenter the pawnbroker knows is not entitled` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS TRUE
    `repays loan and profit` IS TRUE
    `provides identification information` IS TRUE
    `pledge already forfeited` IS FALSE
    `pawnbroker knows presenter not entitled` IS TRUE
    `doubt persists after reasonable steps` IS FALSE
    `replacement ticket application found false` IS FALSE

`a presenter still doubted after inquiry` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS TRUE
    `repays loan and profit` IS TRUE
    `provides identification information` IS TRUE
    `pledge already forfeited` IS FALSE
    `pawnbroker knows presenter not entitled` IS FALSE
    `doubt persists after reasonable steps` IS TRUE
    `replacement ticket application found false` IS FALSE

`a holder of a falsely obtained replacement ticket` MEANS `Redemption attempt` WITH
    `presents an uncancelled pawn ticket` IS TRUE
    `repays loan and profit` IS TRUE
    `provides identification information` IS TRUE
    `pledge already forfeited` IS FALSE
    `pawnbroker knows presenter not entitled` IS FALSE
    `doubt persists after reasonable steps` IS FALSE
    `replacement ticket application found false` IS TRUE

`an ordinary sober adult pawn` MEANS `Pawn taken` WITH
    `pawner's age` IS 30
    `pawner appears intoxicated` IS FALSE
    `took reasonable steps on provenance` IS TRUE
    `advanced in Singapore legal tender` IS TRUE

`a pawn from a 17-year-old` MEANS `Pawn taken` WITH
    `pawner's age` IS 17
    `pawner appears intoxicated` IS FALSE
    `took reasonable steps on provenance` IS TRUE
    `advanced in Singapore legal tender` IS TRUE

`a pawn from an 18-year-old` MEANS `Pawn taken` WITH
    `pawner's age` IS 18
    `pawner appears intoxicated` IS FALSE
    `took reasonable steps on provenance` IS TRUE
    `advanced in Singapore legal tender` IS TRUE

`a pawn from an intoxicated adult` MEANS `Pawn taken` WITH
    `pawner's age` IS 40
    `pawner appears intoxicated` IS TRUE
    `took reasonable steps on provenance` IS TRUE
    `advanced in Singapore legal tender` IS TRUE

`a pawn with no provenance checks` MEANS `Pawn taken` WITH
    `pawner's age` IS 40
    `pawner appears intoxicated` IS FALSE
    `took reasonable steps on provenance` IS FALSE
    `advanced in Singapore legal tender` IS TRUE

`a pawn advanced in gold bars` MEANS `Pawn taken` WITH
    `pawner's age` IS 40
    `pawner appears intoxicated` IS FALSE
    `took reasonable steps on provenance` IS TRUE
    `advanced in Singapore legal tender` IS FALSE

