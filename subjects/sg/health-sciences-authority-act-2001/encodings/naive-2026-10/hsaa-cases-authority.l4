IMPORT prelude
IMPORT `hsaa-authority`

-- Health Sciences Authority Act 2001, ss 4(3), 5, 7, 9, 11(5), 12, 16, 18, 22, 38, 39, 40, 41 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_health-sciences-authority-act-2001.py). Expected results were written by
-- hand from the text.

`a cough syrup sold to the public` MEANS Product WITH
    `is represented for use by humans` IS TRUE
    `is likely to be taken for use by humans` IS FALSE
    `is in a class ordinarily intended for humans` IS FALSE
    `is principally for a therapeutic, preventive, palliative or diagnostic purpose` IS TRUE
    `is principally for a cosmetic purpose` IS FALSE
    `is principally for promoting or preserving human health and wellbeing` IS FALSE

`a shampoo` MEANS Product WITH
    `is represented for use by humans` IS TRUE
    `is likely to be taken for use by humans` IS FALSE
    `is in a class ordinarily intended for humans` IS FALSE
    `is principally for a therapeutic, preventive, palliative or diagnostic purpose` IS FALSE
    `is principally for a cosmetic purpose` IS TRUE
    `is principally for promoting or preserving human health and wellbeing` IS FALSE

`an unlabelled pill likely to be swallowed` MEANS Product WITH
    `is represented for use by humans` IS FALSE
    `is likely to be taken for use by humans` IS TRUE
    `is in a class ordinarily intended for humans` IS FALSE
    `is principally for a therapeutic, preventive, palliative or diagnostic purpose` IS FALSE
    `is principally for a cosmetic purpose` IS FALSE
    `is principally for promoting or preserving human health and wellbeing` IS TRUE

`a veterinary dewormer` MEANS Product WITH
    `is represented for use by humans` IS FALSE
    `is likely to be taken for use by humans` IS FALSE
    `is in a class ordinarily intended for humans` IS FALSE
    `is principally for a therapeutic, preventive, palliative or diagnostic purpose` IS TRUE
    `is principally for a cosmetic purpose` IS FALSE
    `is principally for promoting or preserving human health and wellbeing` IS FALSE

`a kitchen knife` MEANS Product WITH
    `is represented for use by humans` IS TRUE
    `is likely to be taken for use by humans` IS FALSE
    `is in a class ordinarily intended for humans` IS FALSE
    `is principally for a therapeutic, preventive, palliative or diagnostic purpose` IS FALSE
    `is principally for a cosmetic purpose` IS FALSE
    `is principally for promoting or preserving human health and wellbeing` IS FALSE

`a former officer telling a journalist about a pending product approval` MEANS Disclosure WITH
    `by a present or former member, officer, employee, agent or committee member` IS TRUE
    `of information obtained in performing duties` IS TRUE
    `for performing duties or functions` IS FALSE
    `lawfully required by a court` IS FALSE
    `required or allowed by a written law` IS FALSE

`an officer giving evidence under a court order` MEANS Disclosure WITH
    `by a present or former member, officer, employee, agent or committee member` IS TRUE
    `of information obtained in performing duties` IS TRUE
    `for performing duties or functions` IS FALSE
    `lawfully required by a court` IS TRUE
    `required or allowed by a written law` IS FALSE

`an officer sharing data with a colleague for the job` MEANS Disclosure WITH
    `by a present or former member, officer, employee, agent or committee member` IS TRUE
    `of information obtained in performing duties` IS TRUE
    `for performing duties or functions` IS TRUE
    `lawfully required by a court` IS FALSE
    `required or allowed by a written law` IS FALSE

`an officer reporting as another Act requires` MEANS Disclosure WITH
    `by a present or former member, officer, employee, agent or committee member` IS TRUE
    `of information obtained in performing duties` IS TRUE
    `for performing duties or functions` IS FALSE
    `lawfully required by a court` IS FALSE
    `required or allowed by a written law` IS TRUE

`a member of the public repeating what was in the newspaper` MEANS Disclosure WITH
    `by a present or former member, officer, employee, agent or committee member` IS FALSE
    `of information obtained in performing duties` IS TRUE
    `for performing duties or functions` IS FALSE
    `lawfully required by a court` IS FALSE
    `required or allowed by a written law` IS FALSE

§ `s 4(3)`

#ASSERT `the sealed instrument is properly signed` 2 FALSE
#ASSERT `the sealed instrument is properly signed` 1 TRUE
#ASSERT NOT `the sealed instrument is properly signed` 1 FALSE

