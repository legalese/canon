IMPORT prelude
IMPORT `psa-restriction-orders`

-- Protection from Scams Act 2025, ss 2-7, 9 and the Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_protection-from-scams-act-2025.py). Expected results were written by
-- hand from the text.

§ `s 2 and the Schedule`

#ASSERT `the section is listed in the Schedule` `section 416A`
#ASSERT `the section is listed in the Schedule` `section 420`
#ASSERT `the section is listed in the Schedule` `section 424B`
#ASSERT NOT `the section is listed in the Schedule` `any other Penal Code section`

#ASSERT `the offence is a scam offence` `section 420` TRUE
#ASSERT NOT `the offence is a scam offence` `any other Penal Code section` TRUE

#ASSERT `the person is a scam victim` TRUE TRUE FALSE
#ASSERT `the person is a scam victim` TRUE FALSE TRUE
#ASSERT NOT `the person is a scam victim` FALSE TRUE FALSE

#ASSERT `the person is a scammer` TRUE TRUE TRUE
#ASSERT NOT `the person is a scammer` TRUE FALSE FALSE

#ASSERT `the account is the victim's bank account` `in the victim's sole name`
#ASSERT `the account is the victim's bank account` `joint, with the victim as one holder`
#ASSERT NOT `the account is the victim's bank account` `in the name of the victim's company`

§ `s 3`

#ASSERT `the bank must refuse the transaction` `a transfer out of the account` TRUE TRUE FALSE
#ASSERT `the bank must refuse the transaction` `a cash withdrawal` TRUE TRUE FALSE
#ASSERT `the bank must refuse the transaction` `granting a new loan` TRUE TRUE FALSE
#ASSERT `the bank must refuse the transaction` `a drawdown on an existing credit line` TRUE TRUE FALSE
#ASSERT NOT `the bank must refuse the transaction` `a deposit into the account` TRUE TRUE FALSE
#ASSERT NOT `the bank must refuse the transaction` `a transfer out of the account` TRUE TRUE TRUE
#ASSERT NOT `the bank must refuse the transaction` `a transfer out of the account` FALSE TRUE FALSE
#ASSERT NOT `the bank must refuse the transaction` `a cash withdrawal` TRUE FALSE FALSE

§ `s 4`

#ASSERT `a restriction order may be issued` TRUE TRUE FALSE FALSE TRUE FALSE
#ASSERT `a restriction order may be issued` TRUE FALSE FALSE TRUE TRUE FALSE
#ASSERT NOT `a restriction order may be issued` TRUE TRUE FALSE FALSE FALSE TRUE

#ASSERT `the person is a relative under section 4` `spouse`
#ASSERT `the person is a relative under section 4` `adopted child`
#ASSERT `the person is a relative under section 4` `step-nephew or step-niece`
#ASSERT NOT `the person is a relative under section 4` `parent`
#ASSERT NOT `the person is a relative under section 4` `grandparent`
#ASSERT NOT `the person is a relative under section 4` `cousin`

§ `s 5`

#ASSERT `the initial period is lawful` 30
#ASSERT NOT `the initial period is lawful` 31

#ASSERT `the order may be extended` TRUE 4 30 TRUE
#ASSERT NOT `the order may be extended` TRUE 5 30 TRUE
#ASSERT NOT `the order may be extended` TRUE 0 31 TRUE

#ASSERT `the longest the order can last in days` 0 EQUALS 30
#ASSERT `the longest the order can last in days` 2 EQUALS 90
#ASSERT `the longest the order can last in days` 5 EQUALS 180

#ASSERT `may apply for a variation` `the scam victim`
#ASSERT `may apply for a variation` `a joint account holder`
#ASSERT NOT `may apply for a variation` `a relative of the victim`

§ `s 6`

#ASSERT `the bank commits an offence` TRUE FALSE
#ASSERT NOT `the bank commits an offence` TRUE TRUE

#ASSERT `the maximum fine on a bank` EQUALS 3000

#ASSERT `the maximum composition sum` EQUALS 1500

#ASSERT `the composition sum is within the cap` 1500
#ASSERT NOT `the composition sum is within the cap` 3000

§ `s 7`

#ASSERT `may appeal to the Commissioner` `a joint account holder`
#ASSERT NOT `may appeal to the Commissioner` `the bank`

#ASSERT `the Commissioner may reject the appeal for non-compliance` TRUE TRUE FALSE
#ASSERT NOT `the Commissioner may reject the appeal for non-compliance` TRUE TRUE TRUE

#ASSERT `the order must still be complied with` TRUE FALSE
#ASSERT NOT `the order must still be complied with` TRUE TRUE

§ `s 9`

#ASSERT `the immunity applies` TRUE TRUE TRUE TRUE
#ASSERT NOT `the immunity applies` TRUE TRUE FALSE TRUE

