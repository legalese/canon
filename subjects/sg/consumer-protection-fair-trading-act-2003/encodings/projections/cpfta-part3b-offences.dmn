  <inputData id="input_p" name="p">
    <variable id="input_p_var" name="p" typeRef="Any"/>
  </inputData>
  <inputData id="input_m" name="m">
    <variable id="input_m_var" name="m" typeRef="Any"/>
  </inputData>
  <inputData id="input_k_2" name="k_2" label="k">
    <variable id="input_k_2_var" name="k_2" label="k" typeRef="Any"/>
  </inputData>
  <inputData id="input_b" name="b">
    <variable id="input_b_var" name="b" typeRef="Any"/>
  </inputData>
