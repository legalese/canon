IMPORT prelude
IMPORT `cpa-plants`

-- Control of Plants Act 1993, ss 7-11, 13, 15-16, 18, 21, 25-26, 33, 45, 47 and the penalties -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_control-of-plants-act-1993.py). Expected results were written by
-- hand from the text.

`a compliant consignment` MEANS Consignment WITH
    `has a permit for this consignment` IS TRUE
    `conforms to the permit description` IS TRUE
    `free of prohibited pesticide residue` IS TRUE
    `residues within prescribed levels` IS TRUE
    `meets sanitary standards` IS TRUE
    `satisfactory evidence given` IS TRUE
    `containers bear producer name and address` IS TRUE

`a consignment over the residue limit` MEANS Consignment WITH
    `has a permit for this consignment` IS TRUE
    `conforms to the permit description` IS TRUE
    `free of prohibited pesticide residue` IS TRUE
    `residues within prescribed levels` IS FALSE
    `meets sanitary standards` IS TRUE
    `satisfactory evidence given` IS TRUE
    `containers bear producer name and address` IS TRUE

`a consignment with unlabelled cartons` MEANS Consignment WITH
    `has a permit for this consignment` IS TRUE
    `conforms to the permit description` IS TRUE
    `free of prohibited pesticide residue` IS TRUE
    `residues within prescribed levels` IS TRUE
    `meets sanitary standards` IS TRUE
    `satisfactory evidence given` IS TRUE
    `containers bear producer name and address` IS FALSE

`a consignment without a permit` MEANS Consignment WITH
    `has a permit for this consignment` IS FALSE
    `conforms to the permit description` IS TRUE
    `free of prohibited pesticide residue` IS TRUE
    `residues within prescribed levels` IS TRUE
    `meets sanitary standards` IS TRUE
    `satisfactory evidence given` IS TRUE
    `containers bear producer name and address` IS TRUE

`no defence` MEANS Defence WITH
    `due to another person` IS FALSE
    `due to another cause beyond control` IS FALSE
    `took all reasonable precautions` IS FALSE
    `clear days before hearing notice was served` IS 0
    `notice was served` IS FALSE
    `court gave permission` IS FALSE

`supplier's fault with notice 10 clear days ahead` MEANS Defence WITH
    `due to another person` IS TRUE
    `due to another cause beyond control` IS FALSE
    `took all reasonable precautions` IS TRUE
    `clear days before hearing notice was served` IS 10
    `notice was served` IS TRUE
    `court gave permission` IS FALSE

`supplier's fault with notice 3 clear days ahead` MEANS Defence WITH
    `due to another person` IS TRUE
    `due to another cause beyond control` IS FALSE
    `took all reasonable precautions` IS TRUE
    `clear days before hearing notice was served` IS 3
    `notice was served` IS TRUE
    `court gave permission` IS FALSE

`supplier's fault, late notice, court permits` MEANS Defence WITH
    `due to another person` IS TRUE
    `due to another cause beyond control` IS FALSE
    `took all reasonable precautions` IS TRUE
    `clear days before hearing notice was served` IS 3
    `notice was served` IS TRUE
    `court gave permission` IS TRUE

`supplier's fault but no precautions` MEANS Defence WITH
    `due to another person` IS TRUE
    `due to another cause beyond control` IS FALSE
    `took all reasonable precautions` IS FALSE
    `clear days before hearing notice was served` IS 10
    `notice was served` IS TRUE
    `court gave permission` IS FALSE

`cause beyond control with precautions` MEANS Defence WITH
    `due to another person` IS FALSE
    `due to another cause beyond control` IS TRUE
    `took all reasonable precautions` IS TRUE
    `clear days before hearing notice was served` IS 0
    `notice was served` IS FALSE
    `court gave permission` IS FALSE

§ `ss 2, 7`

#ASSERT `a licence under s 7 is required` `import for sale` TRUE
#ASSERT `a licence under s 7 is required` `import for supply or distribution` TRUE
#ASSERT NOT `a licence under s 7 is required` `import for own consumption` TRUE
#ASSERT `a licence under s 7 is required` `transhipment` TRUE
#ASSERT NOT `a licence under s 7 is required` `transit without leaving the conveyance` TRUE

#ASSERT `the movement is an offence under s 7` `import for sale` TRUE FALSE
#ASSERT NOT `the movement is an offence under s 7` `import for sale` TRUE TRUE

§ `s 8`

#ASSERT `the import complies with s 8(1)` `a compliant consignment`
#ASSERT NOT `the import complies with s 8(1)` `a consignment over the residue limit`
#ASSERT NOT `the import complies with s 8(1)` `a consignment with unlabelled cartons`

#ASSERT `the s 8(4) defence is made out` `supplier's fault with notice 10 clear days ahead`
#ASSERT NOT `the s 8(4) defence is made out` `supplier's fault with notice 3 clear days ahead`
#ASSERT `the s 8(4) defence is made out` `supplier's fault, late notice, court permits`
#ASSERT NOT `the s 8(4) defence is made out` `supplier's fault but no precautions`
#ASSERT `the s 8(4) defence is made out` `cause beyond control with precautions`

#ASSERT NOT `the licensee is guilty under s 8(3)` `a compliant consignment` `no defence`
#ASSERT `the licensee is guilty under s 8(3)` `a consignment over the residue limit` `no defence`
#ASSERT NOT `the licensee is guilty under s 8(3)` `a consignment over the residue limit` `supplier's fault with notice 10 clear days ahead`

