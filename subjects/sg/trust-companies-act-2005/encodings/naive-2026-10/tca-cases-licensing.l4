IMPORT prelude
IMPORT `tca-licensing`

-- Trust Companies Act 2005, ss 3, 13, 14(1), 15, 16, 20, 21, 22, 23, 26, 27, 30, 56, 60, 66, 67 and First and Second Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_trust-companies-act-2005.py). Expected results were written by
-- hand from the text.

`a clean candidate` MEANS Individual WITH
    `convicted of a fraud or dishonesty offence` IS FALSE
    `that offence carries 3 months' imprisonment or more` IS FALSE
    `an undischarged bankrupt` IS FALSE
    `has an unsatisfied judgment debt enforcement order` IS FALSE
    `in a creditors' compromise still in operation` IS FALSE
    `under a prohibition order in force` IS FALSE
    `ran a financial institution wound up or stripped of its licence` IS FALSE

`a bankrupt` MEANS Individual WITH
    `convicted of a fraud or dishonesty offence` IS FALSE
    `that offence carries 3 months' imprisonment or more` IS FALSE
    `an undischarged bankrupt` IS TRUE
    `has an unsatisfied judgment debt enforcement order` IS FALSE
    `in a creditors' compromise still in operation` IS FALSE
    `under a prohibition order in force` IS FALSE
    `ran a financial institution wound up or stripped of its licence` IS FALSE

`a minor fraud convict` MEANS Individual WITH
    `convicted of a fraud or dishonesty offence` IS TRUE
    `that offence carries 3 months' imprisonment or more` IS FALSE
    `an undischarged bankrupt` IS FALSE
    `has an unsatisfied judgment debt enforcement order` IS FALSE
    `in a creditors' compromise still in operation` IS FALSE
    `under a prohibition order in force` IS FALSE
    `ran a financial institution wound up or stripped of its licence` IS FALSE

`a serious fraud convict` MEANS Individual WITH
    `convicted of a fraud or dishonesty offence` IS TRUE
    `that offence carries 3 months' imprisonment or more` IS TRUE
    `an undischarged bankrupt` IS FALSE
    `has an unsatisfied judgment debt enforcement order` IS FALSE
    `in a creditors' compromise still in operation` IS FALSE
    `under a prohibition order in force` IS FALSE
    `ran a financial institution wound up or stripped of its licence` IS FALSE

`a former director of a failed bank` MEANS Individual WITH
    `convicted of a fraud or dishonesty offence` IS FALSE
    `that offence carries 3 months' imprisonment or more` IS FALSE
    `an undischarged bankrupt` IS FALSE
    `has an unsatisfied judgment debt enforcement order` IS FALSE
    `in a creditors' compromise still in operation` IS FALSE
    `under a prohibition order in force` IS FALSE
    `ran a financial institution wound up or stripped of its licence` IS TRUE

