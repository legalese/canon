  <decision id="decision_the_specified_body_may_publicise_the_agreement_and_recover_the_costs_as_a_civil_debt" name="the_specified_body_may_publicise_the_agreement_and_recover_the_costs_as_a_civil_debt" label="the specified body may publicise the agreement and recover the costs as a civil debt">
