#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2026 12 31) EQUALS `The basic amounts for the child allowance` OF 173, 219, 162
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2026 1 1)   EQUALS `The basic amounts for the child allowance` OF 173, 219, 162
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2025 12 31) EQUALS `The basic amounts for the child allowance` OF 169, 214, 158
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2024 1 1)   EQUALS `The basic amounts for the child allowance` OF 169, 214, 158
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2023 12 31) EQUALS `The basic amounts for the child allowance` OF 164, 207, 153
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2019 1 1)   EQUALS `The basic amounts for the child allowance` OF 152, 191, 142
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2018 1 1)   EQUALS `The basic amounts for the child allowance` OF 150, 189, 140
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2017 12 31) EQUALS `The basic amounts for the child allowance` OF 150, 188, 140
#ASSERT `the basic amounts for the child allowance the Institute published for` (YMD 2015 5 1)   EQUALS `The basic amounts for the child allowance` OF 150, 188, 140
#ASSERT REFUSED `the basic amounts for the child allowance the Institute published for` (YMD 2027 1 1) BECAUSE "the basic amounts for the child allowance from 1 January 2027 had not been published when this model's sources were fetched"
#ASSERT REFUSED `the basic amounts for the child allowance the Institute published for` (YMD 2015 4 30) BECAUSE "this model answers days from 1 May 2015, when sections 1 and 68 took their present wording; the text in force before then is not in its sources"

-- [text, line 187-189 + nii-basic] The figures the text prints are the Institute's row from 1 May 2015.
#ASSERT `the basic amounts printed in paragraph (2)` EQUALS `the basic amounts for the child allowance the Institute published for` (YMD 2015 5 1)

§§ `Section 1, paragraph (2) — which limb fixes the basic amount for a place`

-- [text, lines 187-188] (a): first, fifth and later; (b): second, third, fourth.
#ASSERT `paragraph (2)(a) fixes the basic amount for the child at place` 1
#ASSERT NOT `paragraph (2)(a) fixes the basic amount for the child at place` 2
#ASSERT NOT `paragraph (2)(a) fixes the basic amount for the child at place` 3
#ASSERT NOT `paragraph (2)(a) fixes the basic amount for the child at place` 4
#ASSERT `paragraph (2)(a) fixes the basic amount for the child at place` 5
#ASSERT `paragraph (2)(a) fixes the basic amount for the child at place` 6

§§ `Section 65 — "insured"`

-- [text, lines 802-803]
#ASSERT `s 65 — insured` (`insured` "Avi")
#ASSERT NOT `s 65 — insured` (`a person` "Avi" TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 65 — insured` (`a person` "Avi" FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `s 65 — insured` (`a person` "Avi" FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `s 65 — insured` (`not insured` "Avi")
-- [fork F18, reading (A)] a resident s 238 housewife, not insured under Chapter 11: excluded from
-- limb (2) as well as limb (1). On reading (B), held by the independent tester (finding 4), she is
-- insured under limb (2) and this assertion would fail. Waits on Meng's ruling (BACKLOG IL-24).
#ASSERT NOT `s 65 — insured` (`a housewife` "Batya")
#ASSERT `s 65 — one who was insured` (`formerly insured` "Avi")
#ASSERT NOT `s 65 — one who was insured` (`a person` "Avi" TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE)

§§ `Section 65 — "child": age, Israel, marriage, whose child`

-- [text, line 807] "has not reached 18": a child the day before the 18th birthday, not on it.
#ASSERT `s 65 — under 18 on` (YMD 2026 6 14) `:` (`a child` "Noa" (YMD 2008 6 15) `Avi and Batya, with both`)
#ASSERT NOT `s 65 — under 18 on` (YMD 2026 6 15) `:` (`a child` "Noa" (YMD 2008 6 15) `Avi and Batya, with both`)
-- [fork F2, reading (i), clamp; DATE in BACKLOG IL-24] born 29 February: reaches 18 on 28 February
-- in a common year. On reading (ii) (roll) the second assertion would fail; on reading (iii) it
-- would refuse.
#ASSERT `s 65 — under 18 on` (YMD 2026 2 27) `:` (`a child` "Noa" (YMD 2008 2 29) `Avi and Batya, with both`)
#ASSERT NOT `s 65 — under 18 on` (YMD 2026 2 28) `:` (`a child` "Noa" (YMD 2008 2 29) `Avi and Batya, with both`)

-- [text, line 809] Left 10 January 2026, not yet back: in Israel up to and including 10 April
-- (three months, "not exceeding"), abroad from 11 April, unless the Institute decides otherwise.
-- [fork F3] for the absence not yet ended.
#ASSERT `s 65 — in Israel on` (YMD 2026 4 10) `:` (`a child abroad` "Noa" (YMD 2016 5 5) `Avi and Batya, with both` (YMD 2026 1 10) NOTHING FALSE)
#ASSERT NOT `s 65 — in Israel on` (YMD 2026 4 11) `:` (`a child abroad` "Noa" (YMD 2016 5 5) `Avi and Batya, with both` (YMD 2026 1 10) NOTHING FALSE)
#ASSERT `s 65 — in Israel on` (YMD 2026 4 11) `:` (`a child abroad` "Noa" (YMD 2016 5 5) `Avi and Batya, with both` (YMD 2026 1 10) NOTHING TRUE)
-- [fork F2, reading (i), clamp; DATE in BACKLOG IL-24] Left 30 November 2025: three months end on
-- 28 February 2026 (the shorter month clamps). On reading (ii) they end on 1 March 2026 (2 March,
-- if the two missing days overflow), and the second assertion (back on 1 March) would fail.
#ASSERT `s 65 — in Israel on` (YMD 2026 2 1) `:` (`a child abroad` "Noa" (YMD 2016 5 5) `Avi and Batya, with both` (YMD 2025 11 30) (JUST (YMD 2026 2 28)) FALSE)
#ASSERT NOT `s 65 — in Israel on` (YMD 2026 2 1) `:` (`a child abroad` "Noa" (YMD 2016 5 5) `Avi and Batya, with both` (YMD 2025 11 30) (JUST (YMD 2026 3 1)) FALSE)

-- [text, line 170, fork F1] a married 17-year-old is not a "child".
#ASSERT NOT `s 65 — a child for this Chapter, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `:` (`a married child` "Noa" (YMD 2009 1 1) `Avi and Batya, with both`)
#ASSERT `s 65 — a child for this Chapter, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `:` (`a child` "Noa" (YMD 2009 1 1) `Avi and Batya, with both`)

-- [text, lines 805-806] Whose child: the child of one who was insured is a "child"; a child
-- whose only link to an insured person is support counts only if the support is proven.
-- (The first holds on both readings of fork F18; the second rests on reading (A): on reading (B)
-- Batya is insured and Noa is her child.)
#ASSERT `s 65 — a child for this Chapter, in` (`the family on` `15 June 2026` `of` (LIST `formerly insured` "Avi", `a housewife` "Batya") `and` EMPTY) `:` (`Noa, with` `Avi and Batya, with both`)
#ASSERT NOT `s 65 — a child for this Chapter, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `a housewife` "Batya") `and` EMPTY) `:` (`Noa, with` `Avi and Batya, with both`)
#ASSERT `s 65 — a child for this Chapter, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Ezra") `and` EMPTY) `:` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`a supporter, support proven,` "Ezra" TRUE)))
#ASSERT NOT `s 65 — a child for this Chapter, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Ezra") `and` EMPTY) `:` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`a supporter, support not proven,` "Ezra" TRUE)))

§§ `Section 66 — the right, and its exception`

-- [text, line 814]
#ASSERT `s 66 — entitled to a monthly child allowance for each child in the count` (`insured` "Avi")
#ASSERT NOT `s 66 — entitled to a monthly child allowance for each child in the count` (`insured, with income chargeable to additional tax,` "Avi")
#ASSERT NOT `s 66 — entitled to a monthly child allowance for each child in the count` (`not insured` "Avi")
#ASSERT `s 66 — an insured parent with income chargeable to additional tax` (`insured, with income chargeable to additional tax,` "Avi")
-- Additional-tax income does not matter to a person who is not insured: the exception is of an
-- insured parent.
#ASSERT NOT `s 66 — an insured parent with income chargeable to additional tax` (`a person` "Avi" FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)

§§ `Section 67 — in whose count`

-- [text, line 818, first limb] Two parents, both insured: the father, unless with the mother only.
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" TRUE), (`natural mother` "Batya" TRUE))) EQUALS JUST "Avi"
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`natural mother` "Batya" TRUE))) EQUALS JUST "Batya"
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" TRUE), (`natural mother` "Batya" FALSE))) EQUALS JUST "Avi"
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`natural mother` "Batya" FALSE))) EQUALS JUST "Avi"
-- [fork F8] an adoptive father and a natural mother are the child's own two parents: first limb.
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` (LIST (`adoptive father` "Avi" TRUE), (`natural mother` "Batya" TRUE))) EQUALS JUST "Avi"

-- [fork F7] One insured parent: that parent's count, wherever the child is.
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" TRUE), (`natural mother` "Batya" FALSE))) EQUALS JUST "Batya"
-- No insured parent and none formerly insured: not a "child", in no count. [fork F18, reading (A):
-- on reading (B) Batya, a resident housewife, is insured and the answer is JUST "Batya".]
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `a housewife` "Batya") `and` EMPTY) `, is` (`Noa, with` `Avi and Batya, with both`) EQUALS NOTHING

-- [text, line 818, second limb] A natural mother and an insured step-father: the one the child is with.
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Batya", `insured` "Gadi") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`natural mother` "Batya" TRUE), (`step-father` "Gadi" FALSE))) EQUALS JUST "Batya"
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Batya", `insured` "Gadi") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`natural mother` "Batya" FALSE), (`step-father` "Gadi" TRUE))) EQUALS JUST "Gadi"
-- [fork F9] with both of them: the second limb does not say.
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Batya", `insured` "Gadi") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`natural mother` "Batya" TRUE), (`step-father` "Gadi" TRUE))) BECAUSE "section 67(b) does not say in whose count a child is counted who has a natural parent and another insured parent and is with both of them, or with neither"
-- [fork F10] two insured mothers: the first limb names a father and a mother.
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Batya", `insured` "Dina") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural mother` "Batya" TRUE), (`adoptive mother` "Dina" TRUE))) BECAUSE "section 67(b) does not say in whose count a child is counted whose two insured parents are both its fathers or both its mothers"
-- [fork F11] three insured parents.
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya", `insured` "Gadi") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`natural mother` "Batya" TRUE), (`step-father` "Gadi" TRUE))) BECAUSE "section 67(b) does not say in whose count a child with more than two insured parents is counted"
-- [fork F11] a step-father and a supporter, neither a natural parent.
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Gadi", `insured` "Ezra") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`step-father` "Gadi" TRUE), (`a supporter, support proven,` "Ezra" FALSE))) BECAUSE "section 67(b) does not say in whose count a child is counted whose two insured parents are neither the child's own two parents nor a natural parent and another parent"
-- A supporter whose support is proven, and no other insured parent: the supporter's count.
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `not insured` "Avi", `insured` "Ezra") `and` EMPTY) `, is` (`Noa, with` (LIST (`natural father` "Avi" FALSE), (`a supporter, support proven,` "Ezra" TRUE))) EQUALS JUST "Ezra"

-- [text, line 843] s 69A reaches an insured man with children by more than one woman.
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `insured, with children by more than one woman,` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` `Avi and Batya, with both`) BECAUSE "section 69A, for an insured man with children by more than one woman, displaces sections 67 and 68 and is not encoded in this model"
-- [text, line 851] s 71: the father has died, the mother is not insured. [fork F18, reading (A):
-- on reading (B) Batya, a resident housewife, is insured and entitled, and s 71's proviso puts
-- Noa in her count, JUST "Batya", as in the next assertion.]
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `formerly insured` "Avi", `a housewife` "Batya") `and` EMPTY) `, is` (`Noa, with` `Avi and Batya, with both`) BECAUSE "section 71, on the allowance paid by virtue of a parent who died or ceased to be insured, is not encoded in this model"
-- s 71's proviso: the mother is insured and entitled, so the child is in her count.
#ASSERT `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `formerly insured` "Avi", `insured` "Batya") `and` EMPTY) `, is` (`Noa, with` `Avi and Batya, with both`) EQUALS JUST "Batya"
-- ... and when the mother is insured but not entitled (s 66), s 71 decides: declined.
#ASSERT REFUSED `s 67 — the insured parent in whose count, in` (`the family on` `15 June 2026` `of` (LIST `formerly insured` "Avi", `insured, with income chargeable to additional tax,` "Batya") `and` EMPTY) `, is` (`Noa, with` `Avi and Batya, with both`) BECAUSE "section 71, on the allowance paid by virtue of a parent who died or ceased to be insured, is not encoded in this model"

-- [text, line 817] s 67(a) holds for the family of six.
#ASSERT `s 67(a) — no child is counted with more than one insured parent, in` (`the family on` `15 June 2026` `of` (LIST `insured` "Avi", `insured` "Batya") `and` `the six children`)

§§ `Section 68 — which provision fixes the allowance`

-- [text, lines 821-825] (b) needs BOTH a birth before 1 June 2003 and a fourth or later place.
#ASSERT `s 68 — the provision that fixes the allowance for the child at place` 4 `:` (`a child` "Noa" (YMD 2003 5 31) EMPTY) EQUALS `section 68(b)(2), a fourth child born before 1 June 2003`
#ASSERT `s 68 — the provision that fixes the allowance for the child at place` 4 `:` (`a child` "Noa" (YMD 2003 6 1) EMPTY) EQUALS `section 68(a), at the basic amount in paragraph (2)(b) of section 1`
#ASSERT `s 68 — the provision that fixes the allowance for the child at place` 5 `:` (`a child` "Noa" (YMD 2003 5 31) EMPTY) EQUALS `section 68(b)(3), a fifth or later child born before 1 June 2003`
#ASSERT `s 68 — the provision that fixes the allowance for the child at place` 5 `:` (`a child` "Noa" (YMD 2003 6 1) EMPTY) EQUALS `section 68(a), at the basic amount in paragraph (2)(a) of section 1`
#ASSERT `s 68 — the provision that fixes the allowance for the child at place` 3 `:` (`a child` "Noa" (YMD 2003 5 31) EMPTY) EQUALS `section 68(a), at the basic amount in paragraph (2)(b) of section 1`
#ASSERT `s 68 — the provision that fixes the allowance for the child at place` 1 `:` (`a child` "Noa" (YMD 2003 5 31) EMPTY) EQUALS `section 68(a), at the basic amount in paragraph (2)(a) of section 1`

