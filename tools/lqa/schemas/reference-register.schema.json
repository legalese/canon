{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/reference-register.schema.json",
  "title": "Reference register (2A, confirmed at 3H)",
  "description": "Every cross-reference the instrument makes, and its disposition.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "entries"
  ],
  "properties": {
    "kind": {
      "const": "reference-register"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "disposition",
          "depth"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "description": "the citing provision",
            "type": "string",
            "minLength": 1
          },
          "to": {
            "description": "the cited provision, with its Act",
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "encoded",
              "fact",
              "out-of-scope"
            ]
          },
          "module": {
            "description": "for encoded: the L4 file, relative to the subject, or _jurisdiction/library/...",
            "type": "string"
          },
          "reason": {
            "description": "required for fact and out-of-scope",
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 1
          },
          "deeper_because": {
            "description": "required when depth > 1: the finding id that needed it",
            "type": "string"
          }
        }
      }
    }
  }
}
