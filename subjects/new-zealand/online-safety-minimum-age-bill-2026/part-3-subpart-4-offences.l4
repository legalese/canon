IMPORT prelude
IMPORT types

-- Online Safety (Minimum Age and Child Safety Risk Assessment) Bill (NZ)
-- Part 3 Subpart 4 -- Offences (cll 57 to 60).
-- Source: registers/source-bundle/LMS1592864.xml, 2026 No 339-1, retrieved 2026-09-11.
--
-- Four offences, each requiring knowledge. Three are committed by "a person";
-- cl 57 alone is committed only by an individual designated under cl 18, which
-- is the subject of incident OS-013 in NOTES.md.

§ `Part 3 Subpart 4 -- Offences`

§§ `Maximum criminal penalties`

`maximum imprisonment months for an individual under sections 57 and 58` MEANS 12

`maximum fine for an individual under sections 57 and 58` MEANS   500000
`maximum fine for a body under section 58`                MEANS 40000000
`maximum fine for an individual under sections 59 and 60` MEANS   100000
`maximum fine for a body under sections 59 and 60`        MEANS  4000000

§§ `57. Offence relating to false or misleading risk assessments`

DECLARE `accuracy confirmation` HAS
    name                                                                                IS A STRING
    -- cl 57(1): the subject of the offence
    `the person is an individual designated under section 18`                            IS A BOOLEAN
    -- cl 57(1)(a)
    `they confirmed the accuracy of a risk assessment`                                   IS A BOOLEAN
    `they knew it to be false or misleading in a material particular`                    IS A BOOLEAN
    -- cl 57(1)(b)
    `a copy of that risk assessment was provided to the regulator`                       IS A BOOLEAN

@ref Online Safety (Minimum Age and Child Safety Risk Assessment) Bill (NZ) cl 57
@export Decide whether an offence under clause 57 is committed
GIVEN c IS A `accuracy confirmation` @desc Whether the person is an individual designated under cl 18, whether they confirmed the accuracy of a risk assessment knowing it to be false or misleading in a material particular, and whether a copy of that assessment reached the regulator.
GIVETH A BOOLEAN
DECIDE `an offence under section 57 is committed` IF
        c's `the person is an individual designated under section 18`
    AND c's `they confirmed the accuracy of a risk assessment`
    AND c's `they knew it to be false or misleading in a material particular`
    AND c's `a copy of that risk assessment was provided to the regulator`

§§ `58. Offence relating to information requirements under section 21`

DECLARE `information response` HAS
    name                                                                                IS A STRING
    -- cl 58(1)
    `the person knowingly failed to comply with a section 21 requirement`                IS A BOOLEAN
    `the person had a reasonable excuse`                                                 IS A BOOLEAN
    -- cl 58(2)
    `the person provided information they knew to be false or misleading in a material particular` IS A BOOLEAN
    -- cl 58(3)
    `the person is an individual`                                                        IS A BOOLEAN

GIVEN r IS A `information response`
GIVETH A BOOLEAN
DECIDE `an offence under section 58(1) is committed` IF
        r's `the person knowingly failed to comply with a section 21 requirement`
    AND NOT r's `the person had a reasonable excuse`

GIVEN r IS A `information response`
GIVETH A BOOLEAN
DECIDE `an offence under section 58(2) is committed` IF
    r's `the person provided information they knew to be false or misleading in a material particular`

@ref Online Safety (Minimum Age and Child Safety Risk Assessment) Bill (NZ) cl 58
@export Decide whether an offence under clause 58 is committed
GIVEN r IS A `information response` @desc How the person responded to a cl 21 requirement: whether they knowingly failed to comply and whether they had a reasonable excuse, or whether they supplied information they knew to be false or misleading in a material particular.
GIVETH A BOOLEAN
DECIDE `an offence under section 58 is committed` IF
        `an offence under section 58(1) is committed` r
    OR  `an offence under section 58(2) is committed` r

-- cl 58(3): the maximum fine turns on whether the offender is an individual.
-- Imprisonment is available only against an individual.
GIVEN r IS A `information response`
GIVETH A NUMBER
DECIDE `the maximum fine under section 58 for` r IS
    IF   r's `the person is an individual`
    THEN `maximum fine for an individual under sections 57 and 58`
    ELSE `maximum fine for a body under section 58`

§§ `59. Offence relating to conditions imposed in relation to information`

DECLARE `condition breach` HAS
    name                                                                                IS A STRING
    `the person knowingly breached a condition imposed under section 22(3)`              IS A BOOLEAN
    `the person is an individual`                                                        IS A BOOLEAN

@ref Online Safety (Minimum Age and Child Safety Risk Assessment) Bill (NZ) cl 59
@export Decide whether an offence under clause 59 is committed
GIVEN b IS A `condition breach` @desc Whether the person knowingly breached a condition the regulator imposed under cl 22(3) on information provided to an agency or overseas regulator.
GIVETH A BOOLEAN
DECIDE `an offence under section 59 is committed` IF
    b's `the person knowingly breached a condition imposed under section 22(3)`

§§ `60. Offence relating to unauthorised disclosure of information`

DECLARE `unauthorised disclosure` HAS
    name                                                                                IS A STRING
    `the person knowingly published or disclosed information in contravention of section 23` IS A BOOLEAN
    -- cl 60(1): the good faith exception
    `the person acted in good faith in the course of exercising their section 21 or 22 powers` IS A BOOLEAN
    `the person is an individual`                                                        IS A BOOLEAN

@ref Online Safety (Minimum Age and Child Safety Risk Assessment) Bill (NZ) cl 60
@export Decide whether an offence under clause 60 is committed
GIVEN d IS A `unauthorised disclosure` @desc Whether the person knowingly published or disclosed information in contravention of cl 23, and whether they did so in good faith in the course of exercising the powers for which they are authorised under cl 21 or 22.
GIVETH A BOOLEAN
DECIDE `an offence under section 60 is committed` IF
        d's `the person knowingly published or disclosed information in contravention of section 23`
    AND NOT d's `the person acted in good faith in the course of exercising their section 21 or 22 powers`

§§ `Scenario fixtures`

-- The cl 57 case as drafted: a designated individual certifies a false
-- assessment and it reaches the regulator.
`a designated individual who certifies falsely` MEANS `accuracy confirmation` WITH
    name                                                                                IS "designated officer, false certification"
    `the person is an individual designated under section 18`                            IS TRUE
    `they confirmed the accuracy of a risk assessment`                                   IS TRUE
    `they knew it to be false or misleading in a material particular`                    IS TRUE
    `a copy of that risk assessment was provided to the regulator`                       IS TRUE

-- The same conduct by someone the operator never designated. The operator has
-- breached cl 18 -- a cl 34(3)(g) specified liability act at Tier 2 -- but no
-- individual is within cl 57 at all. See NOTES.md, incident OS-013.
`an undesignated officer who certifies falsely` MEANS `accuracy confirmation` WITH
    name                                                                                IS "no cl 18 designation ever made"
    `the person is an individual designated under section 18`                            IS FALSE
    `they confirmed the accuracy of a risk assessment`                                   IS TRUE
    `they knew it to be false or misleading in a material particular`                    IS TRUE
    `a copy of that risk assessment was provided to the regulator`                       IS TRUE

-- cl 57(1)(b): the false certification never reaches the regulator.
`a false certification never filed` MEANS `accuracy confirmation` WITH
    name                                                                                IS "false certification withdrawn before filing"
    `the person is an individual designated under section 18`                            IS TRUE
    `they confirmed the accuracy of a risk assessment`                                   IS TRUE
    `they knew it to be false or misleading in a material particular`                    IS TRUE
    `a copy of that risk assessment was provided to the regulator`                       IS FALSE

`a body corporate giving false information` MEANS `information response` WITH
    name                                                                                IS "platform company, false return"
    `the person knowingly failed to comply with a section 21 requirement`                IS FALSE
    `the person had a reasonable excuse`                                                 IS FALSE
    `the person provided information they knew to be false or misleading in a material particular` IS TRUE
    `the person is an individual`                                                        IS FALSE

`an authorised person acting in good faith` MEANS `unauthorised disclosure` WITH
    name                                                                                IS "delegate disclosing while exercising cl 22 powers"
    `the person knowingly published or disclosed information in contravention of section 23` IS TRUE
    `the person acted in good faith in the course of exercising their section 21 or 22 powers` IS TRUE
    `the person is an individual`                                                        IS TRUE

§§ `Machine-evaluated cases`

#ASSERT `an offence under section 57 is committed` `a designated individual who certifies falsely` EQUALS TRUE

-- OS-013: identical conduct, no offence, because cl 57 reaches only an
-- individual designated under cl 18.
#EVAL `an offence under section 57 is committed` `an undesignated officer who certifies falsely`
#ASSERT `an offence under section 57 is committed` `an undesignated officer who certifies falsely` EQUALS FALSE

-- cl 57(1)(b): the assessment must reach the regulator for the offence to be complete.
#ASSERT `an offence under section 57 is committed` `a false certification never filed` EQUALS FALSE

-- cl 58(2) with cl 58(3)(b): $40 million for a body corporate.
#ASSERT `an offence under section 58 is committed` `a body corporate giving false information` EQUALS TRUE
#ASSERT `the maximum fine under section 58 for` `a body corporate giving false information` EQUALS 40000000

-- cl 60(1): the good faith exception takes the conduct outside the offence.
#ASSERT `an offence under section 60 is committed` `an authorised person acting in good faith` EQUALS FALSE
