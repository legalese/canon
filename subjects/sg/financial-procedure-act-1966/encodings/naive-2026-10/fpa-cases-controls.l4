IMPORT prelude
IMPORT `fpa-controls`

-- Financial Procedure Act 1966, the controls on public money (ss 2, 2A, 4, 6, 7, 7A, 11, 12, 15, 17, 17A, 20 to 23) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_financial-procedure-act-1966.py). Expected results were written by
-- hand from the text.

`unvouched payment, half surcharged` MEANS `Surcharge matter` WITH
    `is or was a Government employee` IS TRUE
    `the ground` IS `a payment not duly vouched`
    `gave a satisfactory explanation in time` IS FALSE
    `the Minister referred it` IS TRUE
    `the body` IS `the Public Service Commission`
    `the amount at stake` IS 10000
    `the surcharge` IS 5000

`retired officer, whole loss surcharged` MEANS `Surcharge matter` WITH
    `is or was a Government employee` IS TRUE
    `the ground` IS `destruction of Government property`
    `gave a satisfactory explanation in time` IS FALSE
    `the Minister referred it` IS TRUE
    `the body` IS `the Public Service Commission`
    `the amount at stake` IS 8000
    `the surcharge` IS 8000

