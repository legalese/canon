`a cover on survival` MEANS `A cover` WITH
    `covers the insured person living or dying` IS TRUE
    `covers injury, accident, illness, disease or health care` IS FALSE
    `covers damage to property and other losses` IS FALSE
    `covers civil liability to a third person` IS FALSE
    `is directed at low-income individuals or households` IS FALSE
    `protects against risks to life, health and property` IS FALSE
`a cover on property` MEANS `A cover` WITH
    `covers the insured person living or dying` IS FALSE
    `covers injury, accident, illness, disease or health care` IS FALSE
    `covers damage to property and other losses` IS TRUE
    `covers civil liability to a third person` IS FALSE
    `is directed at low-income individuals or households` IS FALSE
    `protects against risks to life, health and property` IS FALSE
`a cover on civil liability` MEANS `A cover` WITH
    `covers the insured person living or dying` IS FALSE
    `covers injury, accident, illness, disease or health care` IS FALSE
    `covers damage to property and other losses` IS FALSE
    `covers civil liability to a third person` IS TRUE
    `is directed at low-income individuals or households` IS FALSE
    `protects against risks to life, health and property` IS FALSE
`a cover on illness` MEANS `A cover` WITH
    `covers the insured person living or dying` IS FALSE
    `covers injury, accident, illness, disease or health care` IS TRUE
    `covers damage to property and other losses` IS FALSE
    `covers civil liability to a third person` IS FALSE
    `is directed at low-income individuals or households` IS FALSE
    `protects against risks to life, health and property` IS FALSE
`a combined life and health cover` MEANS `A cover` WITH
    `covers the insured person living or dying` IS TRUE
    `covers injury, accident, illness, disease or health care` IS TRUE
    `covers damage to property and other losses` IS FALSE
    `covers civil liability to a third person` IS FALSE
    `is directed at low-income individuals or households` IS FALSE
    `protects against risks to life, health and property` IS FALSE
`a micro cover for a poor household` MEANS `A cover` WITH
    `covers the insured person living or dying` IS FALSE
    `covers injury, accident, illness, disease or health care` IS FALSE
    `covers damage to property and other losses` IS TRUE
    `covers civil liability to a third person` IS FALSE
    `is directed at low-income individuals or households` IS TRUE
    `protects against risks to life, health and property` IS TRUE
`a cover for the well-off` MEANS `A cover` WITH
    `covers the insured person living or dying` IS FALSE
    `covers injury, accident, illness, disease or health care` IS FALSE
    `covers damage to property and other losses` IS FALSE
    `covers civil liability to a third person` IS FALSE
    `is directed at low-income individuals or households` IS FALSE
    `protects against risks to life, health and property` IS TRUE

#ASSERT `Dieu 4(13): the cover is life insurance` `a cover on survival`
#ASSERT NOT `Dieu 4(13): the cover is life insurance` `a cover on illness`
#ASSERT `Dieu 4(14): the cover is non-life insurance` `a cover on property`
#ASSERT `Dieu 4(14): the cover is non-life insurance` `a cover on civil liability`
#ASSERT NOT `Dieu 4(14): the cover is non-life insurance` `a cover on survival`
#ASSERT `Dieu 4(15): the cover is health insurance` `a cover on illness`
#ASSERT `Dieu 4(13): the cover is life insurance` `a combined life and health cover`
#ASSERT `Dieu 4(15): the cover is health insurance` `a combined life and health cover`
#ASSERT `Dieu 4(22): the cover is microinsurance` `a micro cover for a poor household`
#ASSERT NOT `Dieu 4(22): the cover is microinsurance` `a cover for the well-off`

