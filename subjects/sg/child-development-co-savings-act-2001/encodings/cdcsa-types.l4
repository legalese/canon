IMPORT prelude
IMPORT daydate

-- Child Development Co-Savings Act 2001 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- A fact is one a witness, a document or a register could give ("the child
-- was born on 3 May 2025 and became a citizen on 1 August 2025"); whether
-- that makes the child an "April 2025 Scheme child" is a rule.
--
-- Source: ../source/CDCSA2001.txt (SSO PDF, current version as at 07 Oct 2026).

§ `Child Development Co-Savings Act 2001 — the nouns`

§§ `The parent`

DECLARE `Parent role` IS ONE OF
    `the natural mother`
    `the natural father`
    `the adoptive mother`
    `the adoptive father`

DECLARE `Work status` IS ONE OF
    `an employee`
    `a self-employed person`
    `neither`

§§ `The child and the event`

-- s 2(1) "confinement", "estimated delivery date", "stillborn child".
DECLARE Birth HAS
    `confinement on`                         IS A DATE
    `estimated delivery date`                IS A DATE
    `stillborn`                              IS A BOOLEAN
    `a citizen at birth (or would have been, if stillborn)` IS A BOOLEAN
    `became a citizen on`                    IS A MAYBE DATE

-- s 2(1) "eligibility date", "dependant's pass".
DECLARE Adoption HAS
    `child born on`                          IS A DATE
    `application made on`                    IS A DATE
    `the child is a citizen or permanent resident when the application is made` IS A BOOLEAN
    `the child is a permanent resident (not a citizen) then` IS A BOOLEAN
    `dependant's pass issued on`             IS A MAYBE DATE
    `an applicant (or the joint applicant spouse) is a citizen on the relevant date` IS A BOOLEAN  -- s 12AC(1)(da)-(e), 12I(2)(ba)-(c)
    `the applicant is the natural parent`    IS A BOOLEAN
    `joint application with spouse`          IS A BOOLEAN

DECLARE `Child event` IS ONE OF
    `a birth`     HAS `birth` IS A Birth
    `an adoption` HAS `adoption` IS AN Adoption

-- s 2(2): a woman's earlier specified event, and why it may be disregarded.
DECLARE `Earlier specified event` HAS
    `occurred on`                            IS A DATE   -- the relevant (later) event's date decides which limb applies
    `each child is dead or was stillborn`    IS A BOOLEAN
    `each child adopted by another person, not jointly with her` IS A BOOLEAN
    `an adoption application since withdrawn or refused` IS A BOOLEAN

§§ `Work (First Schedule; ss 9A, 12AC, 12I)`

-- First Schedule Part 1: the work pattern.
DECLARE `Work pattern` IS ONE OF
    `the same number of work days every week` HAS `days` IS A NUMBER
    `a pattern repeated over a fixed number of weeks` HAS
        `T, the work days in the repeated weeks` IS A NUMBER
        `W, the number of weeks repeated`        IS A NUMBER
    `no regular pattern` HAS
        `T, the work days in the 3 weeks before the applicable date` IS A NUMBER

DECLARE `Work facts` HAS
    `status`                                 IS A `Work status`
    `months of service or of carrying on before the event` IS A NUMBER  -- 9A(1)(c)-(d), 12AC(1)(b)-(c), 12I(1)(d)-(e)
    `days employed or self-employed in the 12 months before` IS A NUMBER -- 9A(2)(c), 12AC(2)(b), 12I(4A)(b), counted per 9A(2A)
    `the 90-day overseas conditions are met, if any days were outside Singapore` IS A BOOLEAN -- 9A(2)(d), 12AC(2)(c), 12I(4A)(e)
    `weekly index`                           IS A NUMBER    -- First Schedule
    `gross pay (or lost income) per week of work days` IS A NUMBER
    `total income per day in the prescribed period` IS A NUMBER     -- s 9(7): for the Government-paid benefits

§§ `The case`

DECLARE `Parent case` HAS
    `role`                                   IS A `Parent role`
    `event`                                  IS A `Child event`
    `specified event number`                 IS A NUMBER     -- 1, 2, 3 ...; s 2(2) decides it, see `the specified event number`
    `work`                                   IS A `Work facts`
    `lawfully married to the other parent in time` IS A BOOLEAN  -- ss 12F(1)(c), 12I(1)(c)
    `the other parent is also eligible for shared parental leave` IS A BOOLEAN -- s 12DD(1), (3)
    `units allocated under the arrangement`  IS A MAYBE NUMBER  -- s 12DD; NOTHING = the Second Schedule's default
    `weeks elected by the mother under s 12E(5)` IS A NUMBER    -- 0 if none
