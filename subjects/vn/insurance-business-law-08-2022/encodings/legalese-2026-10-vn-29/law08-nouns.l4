@ref Dieu 116 (src:2502-2535)
DECLARE `A bankruptcy distribution` HAS
    `assets to be divided`                                   IS A NUMBER
    `bankruptcy costs`                                       IS A NUMBER
    `wages, severance, social and health insurance owed to employees` IS A NUMBER
    `claims for compensation or payment already accepted, surrender values, account values or premium refunds` IS A NUMBER
    `obligations to the State, unsecured debts on the list, and secured debts not covered by the security` IS A NUMBER
    `claims of the owners, members and shareholders`         IS A NUMBER

DECLARE `A rank in bankruptcy` IS ONE OF
    `costs of bankruptcy`
    `employees`
    `accepted insurance claims, surrender values and premium refunds`
    `State, unsecured creditors and under-secured creditors`
    `owners, members and shareholders`

