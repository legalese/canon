#ASSERT     `the officer is guilty of the same offence:` (`officer` TRUE  FALSE FALSE TRUE)  `, the body having committed it:` TRUE
#ASSERT NOT `the officer is guilty of the same offence:` (`officer` TRUE  TRUE  FALSE FALSE) `, the body having committed it:` FALSE
#ASSERT NOT `the officer is guilty of the same offence:` (`officer` FALSE TRUE  TRUE  TRUE)  `, the body having committed it:` TRUE
#ASSERT NOT `the officer is guilty of the same offence:` (`officer` TRUE  FALSE FALSE FALSE) `, the body having committed it:` TRUE
-- s 77
#ASSERT NOT `may be prosecuted under the Act, the accused being the Government:` TRUE

§§ `Administration (ss 18(1), 21, 40, 47-47G, 60, 70)`

#ASSERT `what the insurer pays of an order of` 500000 `, insured for` 300000 EQUALS 300000
#ASSERT `what the insurer pays of an order of` 200000 `, insured for` 300000 EQUALS 200000
-- s 40(2)
#ASSERT `the employer's indemnity to its insurer, assistance given:` FALSE `, insurer paid` 20000 EQUALS 20000
#ASSERT `the employer's indemnity to its insurer, assistance given:` TRUE  `, insurer paid` 20000 EQUALS 0
-- s 47A
#ASSERT `the relevant platform operator, serving` (LIST "Alpha") `, designated` NOTHING EQUALS "Alpha"
#ASSERT `the relevant platform operator, serving` (LIST "Alpha", "Beta") `, designated` (JUST "Beta") EQUALS "Beta"
#ASSERT REFUSED `the relevant platform operator, serving` (LIST "Alpha", "Beta") `, designated` NOTHING
-- s 47C(6)-(7)
#ASSERT `who reimburses the relevant PO's insurer, Z insured:` TRUE  EQUALS `the other operator's insurer (Y), s 47C(6)`
#ASSERT `who reimburses the relevant PO's insurer, Z insured:` FALSE EQUALS `the other operator itself (Z), s 47C(7)`
#ASSERT `the reimbursement for a share of` 0.25 `of compensation of` 80000 EQUALS 20000
-- s 47G(3): the later of the end of the prescribed period and the s 47E(9)(b) order
#ASSERT `the day recovery may begin, period ending` (YMD 2026 6 30) `, order on` (JUST (YMD 2026 8 1)) EQUALS YMD 2026 8 1
#ASSERT `the day recovery may begin, period ending` (YMD 2026 6 30) `, order on` (JUST (YMD 2026 6 1)) EQUALS YMD 2026 6 30
#ASSERT `the day recovery may begin, period ending` (YMD 2026 6 30) `, order on` NOTHING EQUALS YMD 2026 6 30
-- s 70
#ASSERT     `an ex gratia payment of` 5000 `is within s 70, entitled to` 6000
#ASSERT NOT `an ex gratia payment of` 7000 `is within s 70, entitled to` 6000
-- s 21(2)(b)(i)
#ASSERT `the funeral expenses payable from a deposit, of` 8000 `, capped at` 6000 EQUALS 6000
-- s 60(2)
#ASSERT `the court that may order the enforcement step, a sale of immovable property:` TRUE EQUALS "the General Division of the High Court"
#ASSERT `the court that may order the enforcement step, a sale of immovable property:` FALSE EQUALS "a District Court"
