    `uses identifiable biological material` IS FALSE
    `uses identifiable health information` IS FALSE
    `involves gametes, embryos or human-animal combinations` IS TRUE
    `is a clinical trial under the Health Products or Medicines Act` IS FALSE
    `studies normal psychology or intelligence at minimal risk` IS FALSE
    `is public health research, a registry or statistics` IS FALSE

