§ `s 12`

#ASSERT `the dealing is an offence under section 12` `a shop selling a non-complying air-conditioner after the effective date`
#ASSERT NOT `the dealing is an offence under section 12` `a shop selling the same model before the effective date`
#ASSERT NOT `the dealing is an offence under section 12` `a shop selling a complying air-conditioner`
#ASSERT NOT `the dealing is an offence under section 12` `a household selling its old non-complying fridge to a neighbour`
#ASSERT `the dealing is an offence under section 12` `a household selling its old non-complying fridge to a second-hand dealer`
#ASSERT `the dealing is an offence under section 12` `a household importing a non-complying air-conditioner for its own use`
#ASSERT NOT `the dealing is an offence under section 12` `a developer handing over flats with air-conditioners that complied when bought`
#ASSERT `the dealing is an offence under section 12` `a developer that imported the air-conditioners itself`
#ASSERT NOT `the dealing is an offence under section 12` `a contractor in the developer's supply chain`
#ASSERT NOT `the dealing is an offence under section 12` `a supplier to a self-builder of goods prescribed for subsection (6)`
#ASSERT `the dealing is an offence under section 12` `a supplier to a self-builder of goods not prescribed for subsection (6)`

#ASSERT `the dealing is a prohibited supply` `a household selling its old non-complying fridge to a second-hand dealer`
#ASSERT NOT `the dealing is a prohibited supply` `a household importing a non-complying air-conditioner for its own use`

#ASSERT `the dealing is a prohibited import` `a household importing a non-complying air-conditioner for its own use`
#ASSERT NOT `the dealing is a prohibited import` `a shop selling a non-complying air-conditioner after the effective date`

