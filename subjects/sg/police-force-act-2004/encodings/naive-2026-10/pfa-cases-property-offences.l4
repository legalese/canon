IMPORT prelude
IMPORT `pfa-property-offences`

-- Police Force Act 2004, ss 86A, 108 to 110A, 111, 112A, 115 and 120A -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_pfa.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a wallet claimed on day 5` MEANS LostProperty WITH
    `days since deposit` IS 5
    `an apparent owner has been identified` IS TRUE
    `the owner was located and claimed within 30 days` IS FALSE
    `the owner is claiming now` IS TRUE

`a wallet with a known owner not yet found on day 10` MEANS LostProperty WITH
    `days since deposit` IS 10
    `an apparent owner has been identified` IS TRUE
    `the owner was located and claimed within 30 days` IS FALSE
    `the owner is claiming now` IS FALSE

`a wallet nobody claims by day 30` MEANS LostProperty WITH
    `days since deposit` IS 30
    `an apparent owner has been identified` IS FALSE
    `the owner was located and claimed within 30 days` IS FALSE
    `the owner is claiming now` IS FALSE

`a wallet the owner claims on day 200` MEANS LostProperty WITH
    `days since deposit` IS 200
    `an apparent owner has been identified` IS TRUE
    `the owner was located and claimed within 30 days` IS FALSE
    `the owner is claiming now` IS TRUE

`a wallet the owner claims on day 400` MEANS LostProperty WITH
    `days since deposit` IS 400
    `an apparent owner has been identified` IS TRUE
    `the owner was located and claimed within 30 days` IS FALSE
    `the owner is claiming now` IS TRUE

`a wallet claimed on day 29` MEANS LostProperty WITH
    `days since deposit` IS 29
    `an apparent owner has been identified` IS TRUE
    `the owner was located and claimed within 30 days` IS FALSE
    `the owner is claiming now` IS TRUE

`a wallet claimed within the month and collected on day 45` MEANS LostProperty WITH
    `days since deposit` IS 45
    `an apparent owner has been identified` IS TRUE
    `the owner was located and claimed within 30 days` IS TRUE
    `the owner is claiming now` IS TRUE

