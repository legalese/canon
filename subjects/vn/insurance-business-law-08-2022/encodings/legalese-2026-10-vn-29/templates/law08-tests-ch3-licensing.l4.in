@@fx `an actuary with no other post` : `A person's posts` ; `main post` = `actuary`
@@fx `an actuary who also heads pricing` : `A person's posts` ; `main post` = `actuary` ; `other posts held in the same organisation` = LIST `head of the pricing department`
@@fx `an actuary who also heads something else` : `A person's posts` ; `main post` = `actuary` ; `other posts held in the same organisation` = LIST `another management post`
@@fx `an actuary working at a second insurer` : `A person's posts` ; `main post` = `actuary` ; `works at another insurer, reinsurer or foreign branch in Vietnam at the same time` = TRUE
@@fx `a head of risk who also heads pricing` : `A person's posts` ; `main post` = `head of risk management` ; `other posts held in the same organisation` = LIST `head of the pricing department`
@@fx `a chief accountant with no other post` : `A person's posts` ; `main post` = `chief accountant`
@@fx `a chief accountant who also heads finance and accounting` : `A person's posts` ; `main post` = `chief accountant` ; `other posts held in the same organisation` = LIST `head of finance and accounting`
@@fx `a head of internal audit who also heads finance and accounting` : `A person's posts` ; `main post` = `head of internal audit` ; `other posts held in the same organisation` = LIST `head of finance and accounting`
@@fx `a chief accountant at two insurers` : `A person's posts` ; `main post` = `chief accountant` ; `works at another insurer, reinsurer or foreign branch in Vietnam at the same time` = TRUE
