#ASSERT NOT `the fare contravenes section 41` `a bus or train fare` 1.80 2.00 1.80 TRUE
#ASSERT `the fare contravenes section 41` `a street-hail or ride-hail fare` 20 99 18 TRUE
#ASSERT `the fare contravenes section 41` `a bus or train fare` 1.80 2.00 1.80 FALSE

