IMPORT prelude
IMPORT `gst-charge`

-- Goods and Services Tax Act 1993, ss 8, 16, 17(2), 40 and First and Fourth Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_gst.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a registered cafe selling coffee` MEANS Supply WITH
    `made in Singapore` IS TRUE
    `by a person registered or required to be` IS TRUE
    `in the course of business` IS TRUE
    `for a consideration` IS TRUE
    `exempt` IS FALSE

`an unregistered hawker selling noodles` MEANS Supply WITH
    `made in Singapore` IS TRUE
    `by a person registered or required to be` IS FALSE
    `in the course of business` IS TRUE
    `for a consideration` IS TRUE
    `exempt` IS FALSE

`a registered company giving away samples` MEANS Supply WITH
    `made in Singapore` IS TRUE
    `by a person registered or required to be` IS TRUE
    `in the course of business` IS TRUE
    `for a consideration` IS FALSE
    `exempt` IS FALSE

`a registered bank charging account fees` MEANS Supply WITH
    `made in Singapore` IS TRUE
    `by a person registered or required to be` IS TRUE
    `in the course of business` IS TRUE
    `for a consideration` IS TRUE
    `exempt` IS TRUE

`a registered director selling their own car privately` MEANS Supply WITH
    `made in Singapore` IS TRUE
    `by a person registered or required to be` IS TRUE
    `in the course of business` IS FALSE
    `for a consideration` IS TRUE
    `exempt` IS FALSE

`a business that made 1.2 million last year` MEANS Turnover WITH
    `taxable supplies last year` IS 1200000
    `expected taxable supplies next 12 months` IS 900000
    `Comptroller satisfied next year stays under` IS FALSE

`a business that made exactly 1 million` MEANS Turnover WITH
    `taxable supplies last year` IS 1000000
    `expected taxable supplies next 12 months` IS 1000000
    `Comptroller satisfied next year stays under` IS FALSE

`a business over last year but satisfying the Comptroller` MEANS Turnover WITH
    `taxable supplies last year` IS 1200000
    `expected taxable supplies next 12 months` IS 800000
    `Comptroller satisfied next year stays under` IS TRUE

`a start-up with a signed 1.5 million contract` MEANS Turnover WITH
    `taxable supplies last year` IS 0
    `expected taxable supplies next 12 months` IS 1500000
    `Comptroller satisfied next year stays under` IS FALSE

`a small shop` MEANS Turnover WITH
    `taxable supplies last year` IS 300000
    `expected taxable supplies next 12 months` IS 350000
    `Comptroller satisfied next year stays under` IS FALSE

§ `s 8`

#ASSERT `GST is charged on the supply` `a registered cafe selling coffee`
#ASSERT NOT `GST is charged on the supply` `an unregistered hawker selling noodles`
#ASSERT NOT `GST is charged on the supply` `a registered company giving away samples`
#ASSERT NOT `GST is charged on the supply` `a registered bank charging account fees`
#ASSERT NOT `GST is charged on the supply` `a registered director selling their own car privately`

§ `s 16`

#ASSERT `the GST rate in percent` 20240101 EQUALS 9
#ASSERT `the GST rate in percent` 20231231 EQUALS 8
#ASSERT `the GST rate in percent` 20230101 EQUALS 8
#ASSERT `the GST rate in percent` 20221231 EQUALS 7
#ASSERT `the GST rate in percent` 20070701 EQUALS 7
#ASSERT `the GST rate in percent` 20070630 EQUALS 5
#ASSERT `the GST rate in percent` 20030615 EQUALS 4
#ASSERT `the GST rate in percent` 19980101 EQUALS 0

§ `ss 17(2), 40`

#ASSERT `the GST contained in the price` 109 9 EQUALS 9
#ASSERT `the GST contained in the price` 1090 9 EQUALS 90
#ASSERT `the GST contained in the price` 107 7 EQUALS 7

#ASSERT `the price the supplier may charge` 1070 7 8 FALSE EQUALS 1080
#ASSERT `the price the supplier may charge` 1070 7 8 TRUE EQUALS 1070
#ASSERT `the price the supplier may charge` 1080 8 9 FALSE EQUALS 1090
#ASSERT `the price the supplier may charge` 1090 9 9 FALSE EQUALS 1090

§ `First Schedule`

#ASSERT `the person is liable to register` `a business that made 1.2 million last year`
#ASSERT NOT `the person is liable to register` `a business that made exactly 1 million`
#ASSERT NOT `the person is liable to register` `a business over last year but satisfying the Comptroller`
#ASSERT `the person is liable to register` `a start-up with a signed 1.5 million contract`
#ASSERT NOT `the person is liable to register` `a small shop`

#ASSERT `the overseas digital supplier is liable to register` 5000000 150000
#ASSERT NOT `the overseas digital supplier is liable to register` 5000000 90000
#ASSERT NOT `the overseas digital supplier is liable to register` 800000 500000

#ASSERT `the date registration takes effect` 2025 EQUALS 20260301

§ `Fourth Schedule`

#ASSERT `the supply is exempt` `renting out a flat`
#ASSERT `the supply is exempt` `selling a flat`
#ASSERT NOT `the supply is exempt` `renting out a shop`
#ASSERT `the supply is exempt` `a bank account fee`
#ASSERT `the supply is exempt` `a personal loan`
#ASSERT `the supply is exempt` `a life insurance premium`
#ASSERT NOT `the supply is exempt` `a motor insurance premium`
#ASSERT `the supply is exempt` `investment-grade gold`
#ASSERT NOT `the supply is exempt` `a collector's coin`
#ASSERT `the supply is exempt` `exchanging bitcoin for dollars`
#ASSERT NOT `the supply is exempt` `a haircut`

