    </bpmn:task>
    <bpmn:boundaryEvent id="Boundary_0" name="after P14D" attachedToRef="Task_0" cancelActivity="true">
      <bpmn:documentation>LEST: the obligation is not discharged within 14</bpmn:documentation>
      <bpmn:timerEventDefinition id="Timer_Boundary_0">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_1" name="Fulfilled" />
    <bpmn:endEvent id="End_2" name="Breach">
