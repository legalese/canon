IMPORT prelude
IMPORT `eessa-pse`

-- Education Endowment and Savings Schemes Act 1992, Parts 3A and 3B -- worked cases. Expected results written by hand from the
-- text. Every assertion is a claim about the ENCODING on stated facts, not about the law.

§ `Fixtures`

GIVEN age IS A NUMBER, who IS A Applicant, approved IS A BOOLEAN
GIVETH A `Withdrawal request`
`tuition for` age who approved MEANS
    `Withdrawal request` WITH
        `member's age` IS age
        `who applies` IS who
        `for fees of a course attended by the member or a sibling` IS TRUE
        `course or programme approved by the Minister` IS approved
        `institution approved by the Minister` IS approved
        `for another prescribed purpose` IS FALSE

§ `REQ-0014 (cradle-to-grave-simone e030)`

-- A 19-year-old citizen matriculating at a local university in August 2022: the balance may pay her tuition, for an approved
-- course at an approved institution (s 22(2)(a)). Because she is under 21, the person entitled to withdraw is her PARENT,
-- not she herself; the PSE Scheme Administrator authorises (ss 22(1), 25(1)).
#ASSERT `is a member of the PSE Fund` TRUE TRUE EQUALS TRUE
#ASSERT `who may withdraw` (`tuition for` 19 `a parent of the member` TRUE) EQUALS `a parent of the member`
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`tuition for` 19 `a parent of the member` TRUE) EQUALS TRUE
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`tuition for` 19 `the member` TRUE) EQUALS FALSE
#ASSERT `who authorises a withdrawal` EQUALS "the PSE Scheme Administrator"

§ `22(2) -- age, purpose, approval`

#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`tuition for` 21 `the member` TRUE) EQUALS TRUE
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`tuition for` 21 `a parent of the member` TRUE) EQUALS FALSE
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`tuition for` 19 `a parent of the member` FALSE) EQUALS FALSE
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`tuition for` 19 `someone else` TRUE) EQUALS FALSE
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`Withdrawal request` WITH `member's age` IS 25, `who applies` IS `the member`, `for fees of a course attended by the member or a sibling` IS FALSE, `course or programme approved by the Minister` IS FALSE, `institution approved by the Minister` IS FALSE, `for another prescribed purpose` IS TRUE) EQUALS TRUE
#ASSERT `the applicant is entitled to withdraw under section 22(2)` (`Withdrawal request` WITH `member's age` IS 25, `who applies` IS `the member`, `for fees of a course attended by the member or a sibling` IS FALSE, `course or programme approved by the Minister` IS TRUE, `institution approved by the Minister` IS TRUE, `for another prescribed purpose` IS FALSE) EQUALS FALSE

§ `20 -- membership`

#ASSERT `is a member of the PSE Fund` FALSE TRUE EQUALS FALSE
#ASSERT `is a member of the PSE Fund` TRUE FALSE EQUALS FALSE

§ `22(3) -- the whole sum, if just and equitable`

#ASSERT `the whole sum may be withdrawn under section 22(3)` 19 `a parent of the member` TRUE EQUALS TRUE
#ASSERT `the whole sum may be withdrawn under section 22(3)` 25 `a parent of the member` TRUE EQUALS FALSE
#ASSERT `the whole sum may be withdrawn under section 22(3)` 25 `the member` FALSE EQUALS FALSE

§ `23 -- donation`

#ASSERT `may donate the PSE moneys` 17 `a parent of the member` TRUE EQUALS TRUE
#ASSERT `may donate the PSE moneys` 22 `a parent of the member` TRUE EQUALS FALSE
#ASSERT `may donate the PSE moneys` 22 `the member` FALSE EQUALS FALSE

§ `24 -- closing the account`

#ASSERT `may apply to transfer the whole sum to the CPF ordinary account` 20 EQUALS FALSE
#ASSERT `may apply to transfer the whole sum to the CPF ordinary account` 21 EQUALS TRUE
#ASSERT `the Administrator must transfer the sum to the CPF ordinary account` TRUE 7 6 FALSE FALSE EQUALS TRUE
#ASSERT `the Administrator must transfer the sum to the CPF ordinary account` TRUE 5 6 FALSE FALSE EQUALS FALSE
#ASSERT `the Administrator must transfer the sum to the CPF ordinary account` TRUE 13 18 FALSE FALSE EQUALS TRUE
#ASSERT `the Administrator must transfer the sum to the CPF ordinary account` TRUE 7 6 TRUE FALSE EQUALS FALSE
#ASSERT `the Administrator must transfer the sum to the CPF ordinary account` TRUE 7 6 FALSE TRUE EQUALS FALSE

§ `26 -- creditors`

#ASSERT `PSE moneys can be attached for the member's debts` EQUALS FALSE
