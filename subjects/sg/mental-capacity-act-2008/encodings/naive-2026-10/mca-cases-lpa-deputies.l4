IMPORT prelude
IMPORT `mca-lpa-deputies`

-- Mental Capacity Act 2008, ss 11 to 15 and 25 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_mca.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`an unpaid adult daughter` MEANS Donee WITH
    `age` IS 45
    `is an individual` IS TRUE
    `is paid` IS FALSE
    `is a professional donee` IS FALSE
    `is related to P by blood or marriage` IS TRUE
    `is an undischarged bankrupt` IS FALSE

`a 20-year-old unpaid grandson` MEANS Donee WITH
    `age` IS 20
    `is an individual` IS TRUE
    `is paid` IS FALSE
    `is a professional donee` IS FALSE
    `is related to P by blood or marriage` IS TRUE
    `is an undischarged bankrupt` IS FALSE

`a paid unrelated professional` MEANS Donee WITH
    `age` IS 50
    `is an individual` IS TRUE
    `is paid` IS TRUE
    `is a professional donee` IS TRUE
    `is related to P by blood or marriage` IS FALSE
    `is an undischarged bankrupt` IS FALSE

`a paid professional who is the donor's son` MEANS Donee WITH
    `age` IS 50
    `is an individual` IS TRUE
    `is paid` IS TRUE
    `is a professional donee` IS TRUE
    `is related to P by blood or marriage` IS TRUE
    `is an undischarged bankrupt` IS FALSE

`a trust company` MEANS Donee WITH
    `age` IS 0
    `is an individual` IS FALSE
    `is paid` IS TRUE
    `is a professional donee` IS TRUE
    `is related to P by blood or marriage` IS FALSE
    `is an undischarged bankrupt` IS FALSE

`an unpaid adult son who is bankrupt` MEANS Donee WITH
    `age` IS 45
    `is an individual` IS TRUE
    `is paid` IS FALSE
    `is a professional donee` IS FALSE
    `is related to P by blood or marriage` IS TRUE
    `is an undischarged bankrupt` IS TRUE

`a full LPA` MEANS LPATerms WITH
    `covers personal welfare` IS TRUE
    `covers property and affairs` IS TRUE
    `expressly covers medical treatment` IS TRUE
    `expressly covers life-sustaining treatment` IS TRUE
    `expressly authorises gifts` IS TRUE

`a basic LPA` MEANS LPATerms WITH
    `covers personal welfare` IS TRUE
    `covers property and affairs` IS TRUE
    `expressly covers medical treatment` IS FALSE
    `expressly covers life-sustaining treatment` IS FALSE
    `expressly authorises gifts` IS FALSE

§ `ss 11, 12`

#ASSERT `the person may be a donee` `an unpaid adult daughter` TRUE
#ASSERT NOT `the person may be a donee` `a 20-year-old unpaid grandson` TRUE
#ASSERT `the person may be a donee` `a paid unrelated professional` TRUE
#ASSERT NOT `the person may be a donee` `a paid professional who is the donor's son` TRUE
#ASSERT `the person may be a donee` `a trust company` TRUE
#ASSERT NOT `the person may be a donee` `an unpaid adult son who is bankrupt` TRUE
#ASSERT `the person may be a donee` `an unpaid adult daughter` FALSE
#ASSERT NOT `the person may be a donee` `a 20-year-old unpaid grandson` FALSE
#ASSERT `the person may be a donee` `a paid unrelated professional` FALSE
#ASSERT NOT `the person may be a donee` `a paid professional who is the donor's son` FALSE
#ASSERT NOT `the person may be a donee` `a trust company` FALSE
#ASSERT `the person may be a donee` `an unpaid adult son who is bankrupt` FALSE

#ASSERT `the whole LPA fails` `jointly` TRUE
#ASSERT `the whole LPA fails` `unspecified` TRUE
#ASSERT NOT `the whole LPA fails` `jointly and severally` TRUE
#ASSERT NOT `the whole LPA fails` `jointly` FALSE

#ASSERT `the donor may make an LPA` 21 TRUE
#ASSERT NOT `the donor may make an LPA` 20 TRUE
#ASSERT NOT `the donor may make an LPA` 80 FALSE

§ `s 13`

#ASSERT `the donee may make the decision` `a full LPA` `everyday care`
#ASSERT `the donee may make the decision` `a full LPA` `ordinary medical treatment`
#ASSERT NOT `the donee may make the decision` `a full LPA` `life-sustaining treatment`
#ASSERT NOT `the donee may make the decision` `a full LPA` `treatment to prevent serious deterioration`
#ASSERT `the donee may make the decision` `a full LPA` `selling P's shares`
#ASSERT NOT `the donee may make the decision` `a full LPA` `executing a will for P`
#ASSERT NOT `the donee may make the decision` `a full LPA` `an insurance nomination`
#ASSERT NOT `the donee may make the decision` `a full LPA` `a CPF nomination`
#ASSERT `the donee may make the decision` `a full LPA` `a gift from P's estate`
#ASSERT `the donee may make the decision` `a basic LPA` `everyday care`
#ASSERT NOT `the donee may make the decision` `a basic LPA` `ordinary medical treatment`
#ASSERT `the donee may make the decision` `a basic LPA` `selling P's shares`
#ASSERT NOT `the donee may make the decision` `a basic LPA` `a gift from P's estate`

#ASSERT `the third party may refuse the donee's authority` FALSE TRUE
#ASSERT NOT `the third party may refuse the donee's authority` TRUE TRUE
#ASSERT NOT `the third party may refuse the donee's authority` FALSE FALSE

