IMPORT prelude
IMPORT daydate

-- Building (Strata Management) Act 2004 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../source/BSMA2004.txt (SSO informal consolidation, version in
-- force from 1 October 2026, deposited in this repository).

§ `Building (Strata Management) Act 2004 — the nouns`

§§ `Resolutions and votes (s 2(2)-(8), First Schedule)`

DECLARE `Resolution kind` IS ONE OF
    `an ordinary resolution`        -- s 2(2)
    `a special resolution`          -- s 2(3)
    `a unanimous resolution`        -- s 2(4)
    `a 90% resolution`              -- s 2(5)
    `a comprehensive resolution`    -- s 2(6)
    `a resolution by consensus`     -- s 2(7)

-- The facts of one motion at a general meeting. Counts and share values are
-- of VALID votes (s 2(8)): votes given both for and against, unmarked, or
-- void for uncertainty are left out before they are put here.
DECLARE Motion HAS
    `a duly convened general meeting`                   IS A BOOLEAN
    `days from notice to meeting`                       IS A NUMBER
    `a poll taken`                                      IS A BOOLEAN
    `valid votes for`                                   IS A NUMBER
    `valid votes against`                               IS A NUMBER
    `share value of lots with valid votes for`          IS A NUMBER
    `share value of lots with valid votes against`      IS A NUMBER
    -- ss 2(6)-(7): counted at the end of 12 weeks after the meeting
    `weeks since the meeting`                           IS A NUMBER
    `share value voting for, at the end of 12 weeks`    IS A NUMBER
    `aggregate share value of all subsidiary proprietors, at the end of 12 weeks` IS A NUMBER
    `every subsidiary proprietor supports it in writing, at the end of 12 weeks` IS A BOOLEAN

-- A matter the management corporation may decide; each takes the resolution
-- the Act names for it.
DECLARE Matter IS ONE OF
    `making, amending or repealing by-laws (s 32(3))`
    `a by-law for parking lots with fixed EV chargers (s 32(3A))`
    `an exclusive use by-law` HAS `term in years, with every renewal option` IS A NUMBER -- s 33(1)
    `improving common property: facilities, use or structures (s 29(1)(d))`
    `transferring common property (s 34(1)(a))`
    `leasing common property` HAS `term in years, with every renewal option` IS A NUMBER -- s 34(1)(b), (2)
    `leasing common property for a fixed EV charger` HAS `term in years, with every renewal option` IS A NUMBER -- s 34A
    `accepting land to create additional common property (s 34(3))`
    `approving a subdivision or amalgamation of lots creating common property (s 34(4))`
    `amalgamating common property of 2 or more corporations (s 34(5))`
    `granting, accepting or surrendering an easement or restrictive covenant (s 35)`
    `authorising an improvement increasing floor area (s 37(2))`
    `determining contributions (s 39)`
    `levying contributions by a different formula after a change of use (s 41(6))`
    `levying contributions by any other method (s 41(8))`
    `allowing a discount for early payment (s 41(9))`
    `selling a lot under a charge for unpaid contributions (s 43(3)(a))`
    `altering or building on common property during the initial period (s 50)`
    `removing a council member at a general meeting (s 54(2)(b))`
    `reserving matters to the general meeting (s 59)`
    `appointing or terminating a managing agent (ss 66(1)(a), (6)(a))`
    `delegating council functions to the managing agent (s 67(3))`
    `an insurance decision under s 71 (s 71(3A))`
    `not insuring the building under a damage policy (s 70(1))`
    `designating limited common property (s 78(1)(a)(ii), (b))`
    `terminating the strata scheme (s 84(1))`
    `dissolving a subsidiary management corporation (s 84(2))`
    `instituting proceedings or representing subsidiary proprietors (s 85(1A))`
    `proceedings or an appeal on a non-lot acquisition (s 85A(1))`
    `claiming compensation on a non-lot acquisition (s 85A(2))`
    `distributing non-lot acquisition compensation (s 85A(4))`
    `asking for the whole land to be acquired (s 85A(5))`
    `approving a budget for social activities or legal services (s 38(3A))`
    `a general meeting on short notice (First Schedule para 1A(6))`
    `holding meetings at a physical place (First Schedule para 1C(2)(b))`

§§ `The developer and the initial period (Parts 4, 5 Division 1; ss 23, 26, 49)`

DECLARE `Development facts` HAS
    `planning permission for strata subdivision after completion` IS A BOOLEAN -- ss 10(1), 15(1)(a)
    `lots or proposed lots`                             IS A NUMBER    -- s 15(1)(b)
    `lots sold`                                         IS A NUMBER    -- s 15(2)
    `purchasers`                                        IS A NUMBER
    `first temporary occupation permit issued on`       IS A MAYBE DATE
    `the Division first applied on`                     IS A MAYBE DATE
    `has limited common property`                       IS A BOOLEAN

-- s 11, s 13: a disposal of a lot by the owner developer.
DECLARE Disposal HAS
    `a schedule of strata units showing the share value accepted` IS A BOOLEAN
    `a lease of 21 years or less without option to renew or purchase` IS A BOOLEAN
    `under a collective sale contract, before legal completion` IS A BOOLEAN

-- s 49(1)(a)-(g): things a management corporation may not do in its initial
-- period unless authorised.
DECLARE `Initial-period act` IS ONE OF
    `(a) by-laws conferring rights or obligations on some but not all`
    `(b) altering or building on common property`
    `(c) granting an easement or restrictive covenant`
    `(d) transferring common property or conferring exclusive use`
    `(e) a contract over common property beyond the initial period`
    `(f) borrowing or giving securities`
    `(g) appointing a managing agent beyond the initial period`

§§ `Contributions and charges (ss 40-43)`

DECLARE `Contribution facts` HAS
    `due on`                                            IS A DATE
    `paid on`                                           IS A MAYBE DATE
    `demand served on`                                  IS A MAYBE DATE
    `the corporation resolved it bears no interest`     IS A BOOLEAN   -- s 40(6)(b)

-- s 43(3): conditions for selling a charged lot.
DECLARE `Sale facts` HAS
    `a special resolution to sell`                      IS A BOOLEAN
    `notice of sale published in an approved daily newspaper on` IS A MAYBE DATE
    `paid in full after publication`                    IS A BOOLEAN
    `legal action pending to restrain the sale`         IS A BOOLEAN
    `as at`                                             IS A DATE

§§ `Funds and improvements (ss 37, 38)`

DECLARE `Fund purpose` IS ONE OF
    `a s 39(1) liability`
    `a s 39(2) liability`
    `the corporation's powers and duties`
    `a transfer to the sinking fund`
    `a social, cultural, educational or sports activity for all`
    `legal services for the corporation`
    `a collective sale, other than its general meeting`
    `installing or removing a fixed EV charger`
    `something else`

DECLARE Improvement IS ONE OF
    `increasing floor area`
    `affecting appearance`
    `safety equipment under s 37A`
    `neither`

§§ `The council (Division 3)`

DECLARE Candidate HAS
    `age`                                               IS A NUMBER
    `capacity`                                          IS A `Candidate capacity`
    `arrears on the lot 3 days before the election`     IS A BOOLEAN   -- s 53(7)
    `a joint proprietor whose co-proprietor also stands or nominates` IS A BOOLEAN -- s 53(8)(a)
    `the nominator's nominees exceed its threshold number` IS A BOOLEAN -- s 53(8)(b), (12)
    `an undischarged bankrupt`                          IS A BOOLEAN   -- s 53(9)
    `bankruptcy declared in writing at nomination`      IS A BOOLEAN
    `already elected to another of chairperson, secretary, treasurer` IS A BOOLEAN -- s 53(9A)
    `standing for`                                      IS A `Council office`
    `consecutive terms already served as treasurer`     IS A NUMBER    -- s 53(9B)

DECLARE `Candidate capacity` IS ONE OF
    `a subsidiary proprietor`
    `nominated by a company subsidiary proprietor`
    `an immediate family member nominated by a subsidiary proprietor`
    `none of these`

DECLARE `Council office` IS ONE OF
    `chairperson`
    `secretary`
    `treasurer`
    `an ordinary member`

-- s 54(1)(a)-(j): events that vacate a council member's office.
DECLARE `Vacating event` IS ONE OF
    `(a) ceased to be a subsidiary proprietor`
    `(b) the nominating proprietor ceased or notified vacation`
    `(c) missed council meetings without permission` HAS `consecutive meetings missed` IS A NUMBER
    `(d) resigned in writing`
    `(e) the next annual general meeting ended, or a successor was elected`
    `(f) more than 3 proprietors and the first AGM after has elected the council`
    `(g) removed by the management corporation`
    `(h) died`
    `(i) mentally disordered and incapable`
    `(j) convicted of fraud or dishonesty` HAS `on or after 1 April 2005` IS A BOOLEAN
    `none`

§§ `Strata Titles Boards (Part 6)`

DECLARE `Dismissal ground` IS ONE OF
    `(a) frivolous, vexatious, misconceived or lacking in substance`
    `(b) a decision for the applicant is outside jurisdiction`
    `(c) the applicant unreasonably delayed information`
    `(d) the applicant proprietor has unpaid contributions`
    `(e) suitable for mediation, and mediation pending`

DECLARE `Interim order facts` HAS
    `made on`                                           IS A DATE
    `period specified in months`                        IS A NUMBER
    `renewal requested on`                              IS A MAYBE DATE
    `renewal decided`                                   IS A BOOLEAN
    `renewed`                                           IS A BOOLEAN
    `as at`                                             IS A DATE

§§ `Offences and service (Parts 4-6, 8)`

DECLARE `BSMA offence` IS ONE OF
    `s 14 selling without an accepted schedule, or changing it`
    `s 16(4) failing to establish maintenance funds`
    `s 17(9) maintenance fund payment, trust or accounts duties`
    `s 17(10) inspection, register of purchasers or copy duties`
    `s 18(2) collecting maintenance charges without approval`
    `s 20(8) a Commissioner's managing agent failing to pay in or report`
    `s 26(9) failing to hold the first annual general meeting`
    `s 27(4) annual general meeting not held in time`
    `s 28(4) failing to notify a change of address`
    `s 31(2) obstructing entry by the management corporation`
    `s 40(10) not paying contributions 14 days after a demand`
    `s 48(1A) failing to deliver records, keys or property`
    `s 48(3) failing to retain records for 5 years`
    `s 60(10) failing to disclose an interest`
    `s 61(3)(b) a council member's or officer's dishonesty or misuse of position`
    `s 68(3) a managing agent canvassing at an election`
    `s 96(2) disobeying a Board summons`
    `s 118(7) a false statement for an interim order`
    `s 120(2) contravening a Board order`
    `s 126(6) obstructing or refusing the Commissioner`
    `s 127 false information to the Commissioner, or falsifying records`
    `s 134(4) breaching an exemption condition`
    `a lift or escalator regulation (s 136(4)(a))`
    `any other regulation (s 136(4)(b))`

DECLARE `BSMA penalty` HAS
    `fine`                        IS A NUMBER
    `imprisonment in months`      IS A NUMBER
    `fine per day continuing`     IS A NUMBER
    `fine and imprisonment both`  IS A BOOLEAN

DECLARE `Service mode` IS ONE OF
    `by prepaid registered post`
    `by ordinary post`
    `by delivery to, or affixing on, the front door of the lot`
    `by fax, acknowledged`
    `by electronic communication, retrievable`

§§ `The strata case`

-- One question put to the top-level goal: a motion on a matter; a candidate
-- for the council; and a contribution owed.
DECLARE `Strata case` HAS
    `matter`                                            IS A Matter
    `motion`                                            IS A Motion
    `candidate`                                         IS A MAYBE Candidate
    `contribution`                                      IS A MAYBE `Contribution facts`
    `as at`                                             IS A DATE
