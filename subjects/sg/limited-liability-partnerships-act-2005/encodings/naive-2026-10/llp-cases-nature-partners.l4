IMPORT prelude
IMPORT `llp-nature-partners`

-- Limited Liability Partnerships Act 2005, ss 4 to 17, 28, 29, 33 and 58 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_llp.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a deed signed by two partners` MEANS DeedExecution WITH
    `the number of partners who signed` IS 2
    `a witness attested a partner's signature` IS FALSE
    `the signatory signs for more than one LLP` IS FALSE
    `signed separately in each capacity` IS FALSE
    `the common seal was affixed` IS FALSE

`a deed signed by one partner with a witness` MEANS DeedExecution WITH
    `the number of partners who signed` IS 1
    `a witness attested a partner's signature` IS TRUE
    `the signatory signs for more than one LLP` IS FALSE
    `signed separately in each capacity` IS FALSE
    `the common seal was affixed` IS FALSE

`a deed signed by one partner alone` MEANS DeedExecution WITH
    `the number of partners who signed` IS 1
    `a witness attested a partner's signature` IS FALSE
    `the signatory signs for more than one LLP` IS FALSE
    `signed separately in each capacity` IS FALSE
    `the common seal was affixed` IS FALSE

`a deed signed by one partner alone but sealed` MEANS DeedExecution WITH
    `the number of partners who signed` IS 1
    `a witness attested a partner's signature` IS FALSE
    `the signatory signs for more than one LLP` IS FALSE
    `signed separately in each capacity` IS FALSE
    `the common seal was affixed` IS TRUE

`a deed signed once for two LLPs` MEANS DeedExecution WITH
    `the number of partners who signed` IS 2
    `a witness attested a partner's signature` IS FALSE
    `the signatory signs for more than one LLP` IS TRUE
    `signed separately in each capacity` IS FALSE
    `the common seal was affixed` IS FALSE

`a deed signed separately for two LLPs` MEANS DeedExecution WITH
    `the number of partners who signed` IS 2
    `a witness attested a partner's signature` IS FALSE
    `the signatory signs for more than one LLP` IS TRUE
    `signed separately in each capacity` IS TRUE
    `the common seal was affixed` IS FALSE

`an unsigned sealed deed` MEANS DeedExecution WITH
    `the number of partners who signed` IS 0
    `a witness attested a partner's signature` IS FALSE
    `the signatory signs for more than one LLP` IS FALSE
    `signed separately in each capacity` IS FALSE
    `the common seal was affixed` IS TRUE

`a client hurt by a partner's negligent advice` MEANS TortClaim WITH
    `the partner is liable for their own wrongful act` IS TRUE
    `in the course of the LLP's business or with its authority` IS TRUE
    `the claimant is another partner` IS FALSE

`a fellow partner hurt by a partner's negligence at work` MEANS TortClaim WITH
    `the partner is liable for their own wrongful act` IS TRUE
    `in the course of the LLP's business or with its authority` IS TRUE
    `the claimant is another partner` IS TRUE

`a stranger hurt by a partner on holiday` MEANS TortClaim WITH
    `the partner is liable for their own wrongful act` IS TRUE
    `in the course of the LLP's business or with its authority` IS FALSE
    `the claimant is another partner` IS FALSE

`a claim where the partner is not liable` MEANS TortClaim WITH
    `the partner is liable for their own wrongful act` IS FALSE
    `in the course of the LLP's business or with its authority` IS TRUE
    `the claimant is another partner` IS FALSE

`an authorised order` MEANS Dealing WITH
    `the partner had actual authority` IS TRUE
    `the person knew the partner lacked authority` IS FALSE
    `the person knew or believed the partner to be a partner` IS TRUE

`an unauthorised order to a supplier who believes them a partner` MEANS Dealing WITH
    `the partner had actual authority` IS FALSE
    `the person knew the partner lacked authority` IS FALSE
    `the person knew or believed the partner to be a partner` IS TRUE

`an unauthorised order to a supplier who knows the limits` MEANS Dealing WITH
    `the partner had actual authority` IS FALSE
    `the person knew the partner lacked authority` IS TRUE
    `the person knew or believed the partner to be a partner` IS TRUE

`an unauthorised order to a supplier who thinks they are an employee` MEANS Dealing WITH
    `the partner had actual authority` IS FALSE
    `the person knew the partner lacked authority` IS FALSE
    `the person knew or believed the partner to be a partner` IS FALSE

`an authorised order to someone who did not know they were a partner` MEANS Dealing WITH
    `the partner had actual authority` IS TRUE
    `the person knew the partner lacked authority` IS FALSE
    `the person knew or believed the partner to be a partner` IS FALSE

`a former partner nobody was told about` MEANS FormerPartner WITH
    `the person dealing had notice of the cessation` IS FALSE
    `notice of the cessation was delivered to the Registrar` IS FALSE

`a former partner whose exit was filed` MEANS FormerPartner WITH
    `the person dealing had notice of the cessation` IS FALSE
    `notice of the cessation was delivered to the Registrar` IS TRUE

`a former partner the supplier knew had left` MEANS FormerPartner WITH
    `the person dealing had notice of the cessation` IS TRUE
    `notice of the cessation was delivered to the Registrar` IS FALSE

`a partner giving 30 days' notice under no agreement` MEANS Departure WITH
    `the agreement provides for leaving` IS FALSE
    `left as the agreement provides` IS FALSE
    `days of notice given` IS 30
    `died or was dissolved` IS FALSE

`a partner giving 29 days' notice under no agreement` MEANS Departure WITH
    `the agreement provides for leaving` IS FALSE
    `left as the agreement provides` IS FALSE
    `days of notice given` IS 29
    `died or was dissolved` IS FALSE

`a partner leaving as the agreement allows` MEANS Departure WITH
    `the agreement provides for leaving` IS TRUE
    `left as the agreement provides` IS TRUE
    `days of notice given` IS 0
    `died or was dissolved` IS FALSE

`a partner giving 30 days against a 90-day agreement` MEANS Departure WITH
    `the agreement provides for leaving` IS TRUE
    `left as the agreement provides` IS FALSE
    `days of notice given` IS 30
    `died or was dissolved` IS FALSE

`a partner who died` MEANS Departure WITH
    `the agreement provides for leaving` IS FALSE
    `left as the agreement provides` IS FALSE
    `days of notice given` IS 0
    `died or was dissolved` IS TRUE

`a bankrupt partner managing under the default terms` MEANS BankruptPartner WITH
    `the agreement provides that bankruptcy ends partnership` IS FALSE
    `takes part in management` IS TRUE
    `has the court's or the Official Assignee's permission` IS FALSE

`a bankrupt partner managing with the Official Assignee's permission` MEANS BankruptPartner WITH
    `the agreement provides that bankruptcy ends partnership` IS FALSE
    `takes part in management` IS TRUE
    `has the court's or the Official Assignee's permission` IS TRUE

`a bankrupt partner who stays out of management` MEANS BankruptPartner WITH
    `the agreement provides that bankruptcy ends partnership` IS FALSE
    `takes part in management` IS FALSE
    `has the court's or the Official Assignee's permission` IS FALSE

`a bankrupt partner under an agreement ending partnership on bankruptcy` MEANS BankruptPartner WITH
    `the agreement provides that bankruptcy ends partnership` IS TRUE
    `takes part in management` IS FALSE
    `has the court's or the Official Assignee's permission` IS FALSE

`a debt at 30 months, known` MEANS SolePartnerDebt WITH
    `months trading with fewer than 2 partners when the debt was incurred` IS 30
    `the person was a partner when the debt was incurred` IS TRUE
    `the person knew it had been more than 2 years` IS TRUE

`a debt at 30 months, unknown` MEANS SolePartnerDebt WITH
    `months trading with fewer than 2 partners when the debt was incurred` IS 30
    `the person was a partner when the debt was incurred` IS TRUE
    `the person knew it had been more than 2 years` IS FALSE

`a debt at 24 months, known` MEANS SolePartnerDebt WITH
    `months trading with fewer than 2 partners when the debt was incurred` IS 24
    `the person was a partner when the debt was incurred` IS TRUE
    `the person knew it had been more than 2 years` IS TRUE

`a debt at 30 months by a non-partner` MEANS SolePartnerDebt WITH
    `months trading with fewer than 2 partners when the debt was incurred` IS 30
    `the person was a partner when the debt was incurred` IS FALSE
    `the person knew it had been more than 2 years` IS TRUE

`a resident adult` MEANS ManagerCandidate WITH
    `is a natural person` IS TRUE
    `age` IS 40
    `of full legal capacity` IS TRUE
    `ordinarily resident in Singapore` IS TRUE
    `is an undischarged bankrupt without permission` IS FALSE

`a seventeen-year-old` MEANS ManagerCandidate WITH
    `is a natural person` IS TRUE
    `age` IS 17
    `of full legal capacity` IS TRUE
    `ordinarily resident in Singapore` IS TRUE
    `is an undischarged bankrupt without permission` IS FALSE

`a non-resident adult` MEANS ManagerCandidate WITH
    `is a natural person` IS TRUE
    `age` IS 40
    `of full legal capacity` IS TRUE
    `ordinarily resident in Singapore` IS FALSE
    `is an undischarged bankrupt without permission` IS FALSE

`a company` MEANS ManagerCandidate WITH
    `is a natural person` IS FALSE
    `age` IS 0
    `of full legal capacity` IS TRUE
    `ordinarily resident in Singapore` IS TRUE
    `is an undischarged bankrupt without permission` IS FALSE

`a resident bankrupt` MEANS ManagerCandidate WITH
    `is a natural person` IS TRUE
    `age` IS 40
    `of full legal capacity` IS TRUE
    `ordinarily resident in Singapore` IS TRUE
    `is an undischarged bankrupt without permission` IS TRUE

§ `ss 4, 10, 11`

#ASSERT `the business is a limited liability partnership` TRUE
#ASSERT NOT `the business is a limited liability partnership` FALSE

#ASSERT NOT `the change affects the LLP's existence, rights or liabilities` TRUE

#ASSERT `the person may be a partner` `an individual`
#ASSERT `the person may be a partner` `a company`
#ASSERT `the person may be a partner` `another LLP`
#ASSERT `the person may be a partner` `a foreign company`
#ASSERT NOT `the person may be a partner` `a registered trade union`
#ASSERT NOT `the person may be a partner` `a platform work association`
#ASSERT NOT `the person may be a partner` `an unincorporated firm`
#ASSERT NOT `the person may be a partner` `an unincorporated society`

§ `ss 6 to 8 -- deeds`

#ASSERT `the deed is validly executed without a seal` `a deed signed by two partners`
#ASSERT `the deed is validly executed without a seal` `a deed signed by one partner with a witness`
#ASSERT NOT `the deed is validly executed without a seal` `a deed signed by one partner alone`
#ASSERT NOT `the deed is validly executed without a seal` `a deed signed by one partner alone but sealed`
#ASSERT NOT `the deed is validly executed without a seal` `a deed signed once for two LLPs`
#ASSERT `the deed is validly executed without a seal` `a deed signed separately for two LLPs`
#ASSERT NOT `the deed is validly executed without a seal` `an unsigned sealed deed`

#ASSERT `the deed binds as a deed` `a deed signed by two partners`
#ASSERT `the deed binds as a deed` `a deed signed by one partner with a witness`
#ASSERT NOT `the deed binds as a deed` `a deed signed by one partner alone`
#ASSERT `the deed binds as a deed` `a deed signed by one partner alone but sealed`
#ASSERT NOT `the deed binds as a deed` `a deed signed once for two LLPs`
#ASSERT `the deed binds as a deed` `a deed signed separately for two LLPs`
#ASSERT `the deed binds as a deed` `an unsigned sealed deed`

§ `s 12 -- limited liability`

#ASSERT `the partner is personally liable` `the partner's own tort` FALSE
#ASSERT `the partner is personally liable` `the partner's own tort` TRUE
#ASSERT NOT `the partner is personally liable` `another partner's tort` FALSE
#ASSERT NOT `the partner is personally liable` `another partner's tort` TRUE
#ASSERT NOT `the partner is personally liable` `the LLP's contract` FALSE
#ASSERT `the partner is personally liable` `the LLP's contract` TRUE
#ASSERT NOT `the partner is personally liable` `the LLP's debt` FALSE
#ASSERT `the partner is personally liable` `the LLP's debt` TRUE

#ASSERT `the LLP is liable to the same extent as the partner` `a client hurt by a partner's negligent advice`
#ASSERT NOT `the LLP is liable to the same extent as the partner` `a fellow partner hurt by a partner's negligence at work`
#ASSERT NOT `the LLP is liable to the same extent as the partner` `a stranger hurt by a partner on holiday`
#ASSERT NOT `the LLP is liable to the same extent as the partner` `a claim where the partner is not liable`

§ `s 13 -- binding the LLP`

#ASSERT `the LLP is bound by the partner's act` `an authorised order`
#ASSERT `the LLP is bound by the partner's act` `an unauthorised order to a supplier who believes them a partner`
#ASSERT NOT `the LLP is bound by the partner's act` `an unauthorised order to a supplier who knows the limits`
#ASSERT NOT `the LLP is bound by the partner's act` `an unauthorised order to a supplier who thinks they are an employee`
#ASSERT `the LLP is bound by the partner's act` `an authorised order to someone who did not know they were a partner`

#ASSERT `the former partner is still regarded as a partner` `a former partner nobody was told about`
#ASSERT NOT `the former partner is still regarded as a partner` `a former partner whose exit was filed`
#ASSERT NOT `the former partner is still regarded as a partner` `a former partner the supplier knew had left`

§ `s 15 -- leaving`

#ASSERT `the partner has ceased to be a partner` `a partner giving 30 days' notice under no agreement`
#ASSERT NOT `the partner has ceased to be a partner` `a partner giving 29 days' notice under no agreement`
#ASSERT `the partner has ceased to be a partner` `a partner leaving as the agreement allows`
#ASSERT NOT `the partner has ceased to be a partner` `a partner giving 30 days against a 90-day agreement`
#ASSERT `the partner has ceased to be a partner` `a partner who died`

#ASSERT `the default payout to a departing partner` 100000 50000 20000 EQUALS 130000
#ASSERT `the default payout to a departing partner` 100000 0 30000 EQUALS 70000
#ASSERT `the default payout to a departing partner` 100000 0 0 EQUALS 100000

§ `ss 16, 17, 58 -- bankruptcy and assignment`

#ASSERT `the bankrupt remains a partner` `a bankrupt partner managing under the default terms`
#ASSERT `the bankrupt remains a partner` `a bankrupt partner managing with the Official Assignee's permission`
#ASSERT `the bankrupt remains a partner` `a bankrupt partner who stays out of management`
#ASSERT NOT `the bankrupt remains a partner` `a bankrupt partner under an agreement ending partnership on bankruptcy`

#ASSERT `the bankrupt partner commits the section 58 offence` `a bankrupt partner managing under the default terms`
#ASSERT NOT `the bankrupt partner commits the section 58 offence` `a bankrupt partner managing with the Official Assignee's permission`
#ASSERT NOT `the bankrupt partner commits the section 58 offence` `a bankrupt partner who stays out of management`
#ASSERT NOT `the bankrupt partner commits the section 58 offence` `a bankrupt partner under an agreement ending partnership on bankruptcy`

#ASSERT `the assignee acquires the right` `receiving distributions`
#ASSERT NOT `the assignee acquires the right` `taking part in management`
#ASSERT NOT `the assignee acquires the right` `voting`
#ASSERT NOT `the assignee acquires the right` `becoming a partner`

