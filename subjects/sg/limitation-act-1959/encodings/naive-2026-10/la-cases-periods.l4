IMPORT prelude
IMPORT `la-periods`

-- Limitation Act 1959, ss 3, 4, 6, 6A, 9, 20 to 29, 33 and 35 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_la.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a car-crash injury sued after 2 years` MEANS Negligence WITH
    `personal injury` IS TRUE
    `years since accrual` IS 2
    `years since knowledge` IS 2
    `years since the negligent act` IS 2

`a car-crash injury sued after 4 years` MEANS Negligence WITH
    `personal injury` IS TRUE
    `years since accrual` IS 4
    `years since knowledge` IS 4
    `years since the negligent act` IS 4

`an asbestos disease discovered 2 years ago, 12 years after exposure` MEANS Negligence WITH
    `personal injury` IS TRUE
    `years since accrual` IS 12
    `years since knowledge` IS 2
    `years since the negligent act` IS 12

`a building defect found 2 years ago, 10 years after construction` MEANS Negligence WITH
    `personal injury` IS FALSE
    `years since accrual` IS 10
    `years since knowledge` IS 2
    `years since the negligent act` IS 10

`a building defect found 7 years after construction, sued at year 8` MEANS Negligence WITH
    `personal injury` IS FALSE
    `years since accrual` IS 8
    `years since knowledge` IS 1
    `years since the negligent act` IS 8

`a building defect found last year, 16 years after construction` MEANS Negligence WITH
    `personal injury` IS FALSE
    `years since accrual` IS 1
    `years since knowledge` IS 1
    `years since the negligent act` IS 16

`a child injured, suing 2 years after reaching majority` MEANS Disability WITH
    `under disability when the right accrued` IS TRUE
    `years since disability ended` IS 2
    `personal injury` IS TRUE

`the same suing 4 years after` MEANS Disability WITH
    `under disability when the right accrued` IS TRUE
    `years since disability ended` IS 4
    `personal injury` IS TRUE

`a child owed a contract debt, suing 5 years after` MEANS Disability WITH
    `under disability when the right accrued` IS TRUE
    `years since disability ended` IS 5
    `personal injury` IS FALSE

`an adult claimant` MEANS Disability WITH
    `under disability when the right accrued` IS FALSE
    `years since disability ended` IS 1
    `personal injury` IS FALSE

`a debt 7 years old, never acknowledged` MEANS Debt WITH
    `years since the last signed acknowledgment or payment` IS 0
    `years since accrual` IS 7
    `there has been a signed acknowledgment or payment` IS FALSE
    `the acknowledgment was oral only` IS FALSE

`a debt 10 years old acknowledged in writing last year` MEANS Debt WITH
    `years since the last signed acknowledgment or payment` IS 1
    `years since accrual` IS 10
    `there has been a signed acknowledgment or payment` IS TRUE
    `the acknowledgment was oral only` IS FALSE

`a debt 10 years old acknowledged orally last year` MEANS Debt WITH
    `years since the last signed acknowledgment or payment` IS 1
    `years since accrual` IS 10
    `there has been a signed acknowledgment or payment` IS TRUE
    `the acknowledgment was oral only` IS TRUE

`a debt 5 years old` MEANS Debt WITH
    `years since the last signed acknowledgment or payment` IS 0
    `years since accrual` IS 5
    `there has been a signed acknowledgment or payment` IS FALSE
    `the acknowledgment was oral only` IS FALSE

§ `s 4`

#ASSERT `the claim is barred` TRUE TRUE
#ASSERT NOT `the claim is barred` TRUE FALSE
#ASSERT NOT `the claim is barred` FALSE TRUE

§ `periods`

#ASSERT `the primary period` `contract` EQUALS 6
#ASSERT `the primary period` `tort other than personal injury` EQUALS 6
#ASSERT `the primary period` `personal injury` EQUALS 3
#ASSERT `the primary period` `enforcing a judgment` EQUALS 12
#ASSERT `the primary period` `a statutory penalty` EQUALS 1
#ASSERT `the primary period` `contribution from a co-wrongdoer` EQUALS 2
#ASSERT `the primary period` `recovering unregistered land` EQUALS 12
#ASSERT `the primary period` `arrears of rent` EQUALS 6
#ASSERT `the primary period` `mortgage principal` EQUALS 12
#ASSERT `the primary period` `a share of a deceased's estate` EQUALS 12
#ASSERT `the primary period` `breach of trust` EQUALS 6

§ `s 22`

#ASSERT `no limitation period applies against the trustee` TRUE FALSE
#ASSERT `no limitation period applies against the trustee` FALSE TRUE
