#ASSERT `providing the service is an offence under s 46` `a video-on-demand service` TRUE FALSE
#ASSERT NOT `providing the service is an offence under s 46` `a video-on-demand service` TRUE TRUE
#ASSERT NOT `providing the service is an offence under s 46` `a video-on-demand service` FALSE FALSE
#ASSERT NOT `providing the service is an offence under s 46` `a delivery system that only provides facilities` TRUE FALSE

#ASSERT `the maximum fine for unlicensed broadcasting` 0 EQUALS 200000
#ASSERT `the maximum fine for unlicensed broadcasting` 10 EQUALS 300000

