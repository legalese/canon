IMPORT prelude
IMPORT `wa-wills`

-- Wills Act 1838, ss 4-6, 9, 10, 13-17, 26, 27 and 28 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_wills-act-1838.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a typed will signed and witnessed by two together` MEANS Execution WITH
    `in writing` IS TRUE
    `signed by the testator` IS TRUE
    `signed by another in the testator's presence and by direction` IS FALSE
    `signature placed so as to show it gives effect to the will` IS TRUE
    `witnesses present together when the signature was made or acknowledged` IS 2
    `each witness signed in the testator's presence` IS TRUE

`a will signed for a frail testator at her direction` MEANS Execution WITH
    `in writing` IS TRUE
    `signed by the testator` IS FALSE
    `signed by another in the testator's presence and by direction` IS TRUE
    `signature placed so as to show it gives effect to the will` IS TRUE
    `witnesses present together when the signature was made or acknowledged` IS 2
    `each witness signed in the testator's presence` IS TRUE

`a will with only one witness` MEANS Execution WITH
    `in writing` IS TRUE
    `signed by the testator` IS TRUE
    `signed by another in the testator's presence and by direction` IS FALSE
    `signature placed so as to show it gives effect to the will` IS TRUE
    `witnesses present together when the signature was made or acknowledged` IS 1
    `each witness signed in the testator's presence` IS TRUE

`a will the witnesses signed after the testator left` MEANS Execution WITH
    `in writing` IS TRUE
    `signed by the testator` IS TRUE
    `signed by another in the testator's presence and by direction` IS FALSE
    `signature placed so as to show it gives effect to the will` IS TRUE
    `witnesses present together when the signature was made or acknowledged` IS 2
    `each witness signed in the testator's presence` IS FALSE

`an oral will` MEANS Execution WITH
    `in writing` IS FALSE
    `signed by the testator` IS TRUE
    `signed by another in the testator's presence and by direction` IS FALSE
    `signature placed so as to show it gives effect to the will` IS TRUE
    `witnesses present together when the signature was made or acknowledged` IS 2
    `each witness signed in the testator's presence` IS TRUE

