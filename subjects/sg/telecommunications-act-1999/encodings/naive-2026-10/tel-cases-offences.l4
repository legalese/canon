IMPORT prelude
IMPORT `tel-offences`

-- Telecommunications Act 1999, ss 33 to 36, 53 to 69 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_tel.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`planned roadworks done properly` MEANS Earthworks WITH
    `near a telecommunication cable` IS TRUE
    `gave 7 days written notice` IS TRUE
    `obtained cable information and consulted` IS TRUE
    `used a licensed cable detection worker` IS TRUE
    `reasonably believed urgent for safety` IS FALSE
    `gave notice within 7 days after starting` IS FALSE

`planned roadworks without a licensed detector` MEANS Earthworks WITH
    `near a telecommunication cable` IS TRUE
    `gave 7 days written notice` IS TRUE
    `obtained cable information and consulted` IS TRUE
    `used a licensed cable detection worker` IS FALSE
    `reasonably believed urgent for safety` IS FALSE
    `gave notice within 7 days after starting` IS FALSE

`planned roadworks with only 3 days notice` MEANS Earthworks WITH
    `near a telecommunication cable` IS TRUE
    `gave 7 days written notice` IS FALSE
    `obtained cable information and consulted` IS TRUE
    `used a licensed cable detection worker` IS TRUE
    `reasonably believed urgent for safety` IS FALSE
    `gave notice within 7 days after starting` IS FALSE

`an emergency burst-pipe dig notified after 5 days` MEANS Earthworks WITH
    `near a telecommunication cable` IS TRUE
    `gave 7 days written notice` IS FALSE
    `obtained cable information and consulted` IS FALSE
    `used a licensed cable detection worker` IS FALSE
    `reasonably believed urgent for safety` IS TRUE
    `gave notice within 7 days after starting` IS TRUE

`an emergency dig never notified` MEANS Earthworks WITH
    `near a telecommunication cable` IS TRUE
    `gave 7 days written notice` IS FALSE
    `obtained cable information and consulted` IS FALSE
    `used a licensed cable detection worker` IS FALSE
    `reasonably believed urgent for safety` IS TRUE
    `gave notice within 7 days after starting` IS FALSE

`garden digging nowhere near a cable` MEANS Earthworks WITH
    `near a telecommunication cable` IS FALSE
    `gave 7 days written notice` IS FALSE
    `obtained cable information and consulted` IS FALSE
    `used a licensed cable detection worker` IS FALSE
    `reasonably believed urgent for safety` IS FALSE
    `gave notice within 7 days after starting` IS FALSE

§ `ss 33 to 36`

#ASSERT `the earthworks comply with section 33` `planned roadworks done properly`
#ASSERT NOT `the earthworks comply with section 33` `planned roadworks without a licensed detector`
#ASSERT NOT `the earthworks comply with section 33` `planned roadworks with only 3 days notice`
#ASSERT `the earthworks comply with section 33` `an emergency burst-pipe dig notified after 5 days`
#ASSERT NOT `the earthworks comply with section 33` `an emergency dig never notified`
#ASSERT `the earthworks comply with section 33` `garden digging nowhere near a cable`

#ASSERT `the digging is a section 36 offence` TRUE FALSE
#ASSERT NOT `the digging is a section 36 offence` TRUE TRUE
#ASSERT NOT `the digging is a section 36 offence` FALSE FALSE

#ASSERT `the fee recoverable for detection work` TRUE 800 EQUALS 800
#ASSERT `the fee recoverable for detection work` FALSE 800 EQUALS 0

§ `ss 68, 69`

#ASSERT `the maximum fine for the damage` `wilful damage outside earthworks` FALSE EQUALS 50000
#ASSERT `the maximum fine for the damage` `damage to a cable during earthworks` FALSE EQUALS 1000000
#ASSERT `the maximum fine for the damage` `damage to a cable during earthworks` TRUE EQUALS 0
#ASSERT `the maximum fine for the damage` `accidental damage outside earthworks` FALSE EQUALS 0

#ASSERT `compensation is payable for the damage` `accidental damage outside earthworks`
#ASSERT `compensation is payable for the damage` `wilful damage outside earthworks`

#ASSERT NOT `the employer is liable for the employee's cable damage` FALSE FALSE
#ASSERT `the employer is liable for the employee's cable damage` TRUE FALSE
#ASSERT `the employer is liable for the employee's cable damage` FALSE TRUE

§ `ss 53 to 57`

#ASSERT `the possessor is taken to have operated it` TRUE FALSE
#ASSERT NOT `the possessor is taken to have operated it` TRUE TRUE

#ASSERT `the occupier commits an offence` TRUE FALSE
#ASSERT NOT `the occupier commits an offence` TRUE TRUE
#ASSERT NOT `the occupier commits an offence` FALSE FALSE

#ASSERT `the seized equipment is forfeited` FALSE 3 FALSE
#ASSERT NOT `the seized equipment is forfeited` FALSE 1 FALSE
#ASSERT NOT `the seized equipment is forfeited` FALSE 3 TRUE
#ASSERT NOT `the seized equipment is forfeited` TRUE 3 FALSE

§ `ss 59 to 64`

#ASSERT `using the unlawful service is an offence` TRUE
#ASSERT NOT `using the unlawful service is an offence` FALSE

#ASSERT `the employee commits a section 62 offence` `reading a customer's messages out of curiosity`
#ASSERT NOT `the employee commits a section 62 offence` `acting on a Minister's order`
#ASSERT NOT `the employee commits a section 62 offence` `acting on a court direction`
#ASSERT NOT `the employee commits a section 62 offence` `routine maintenance`
#ASSERT NOT `the employee commits a section 62 offence` `tracing a call at the subscriber's request`

#ASSERT `the maximum imprisonment in years for possessing a fraud device` TRUE EQUALS 10
#ASSERT `the maximum imprisonment in years for possessing a fraud device` FALSE EQUALS 0

