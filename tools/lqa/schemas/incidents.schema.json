{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/incidents.schema.json",
  "title": "Incident register (7A-10A)",
  "description": "The findings. INCIDENTS.md is the prose; this is what the checker, the report and the console scheme are built from.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "findings"
  ],
  "properties": {
    "kind": {
      "const": "incidents"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "triage": {
      "type": "object",
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "by": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "number",
        "category",
        "title",
        "provision",
        "print",
        "found_by",
        "status",
        "severity",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[DRLTUPEMIXWFS]-\\d{2,}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "category": {
          "enum": [
            "D",
            "R",
            "L",
            "T",
            "U",
            "P",
            "E",
            "M",
            "I",
            "X",
            "W",
            "F",
            "S"
          ]
        },
        "also": {
          "type": "array",
          "items": {
            "enum": [
              "D",
              "R",
              "L",
              "T",
              "U",
              "P",
              "E",
              "M",
              "I",
              "X",
              "W",
              "F",
              "S"
            ]
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "provision": {
          "type": "string",
          "minLength": 1
        },
        "print": {
          "description": "the print the finding was made against",
          "type": "string",
          "minLength": 1
        },
        "found_by": {
          "enum": [
            "RD",
            "CMP",
            "ENC",
            "CHK",
            "TST",
            "SIM",
            "EXT"
          ]
        },
        "external_source": {
          "description": "required for EXT: who found it first",
          "type": "string"
        },
        "status": {
          "enum": [
            "CANDIDATE",
            "OPEN",
            "FIXED",
            "WAIVED",
            "VERIFIED-NO-DEFECT"
          ]
        },
        "severity": {
          "type": "string",
          "pattern": "^(none|low|medium|high)(-(low|medium|high))?$"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "opinion": {
          "description": "true when no evidence can be produced",
          "type": "boolean"
        },
        "fork": {
          "description": "for U: the fork-register entry id",
          "type": "string"
        },
        "challenged": {
          "type": "object",
          "required": [
            "date"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "answered_by": {
          "type": "object",
          "required": [
            "citation",
            "source"
          ],
          "properties": {
            "citation": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "description": "a reference-set item id or a source-bundle document id",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "checked_print": {
          "type": "object",
          "required": [
            "print",
            "date"
          ],
          "properties": {
            "print": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "repair": {
          "type": "string"
        },
        "tier": {
          "description": "9A triage of an OPEN finding: a headline (a real person gets a wrong, unfair or uncertain result in a plausible situation), a drafting note, or merged into another finding that shares its cause or its fix",
          "enum": [
            "headline",
            "note",
            "merged"
          ]
        },
        "rank": {
          "description": "headline: its place in the report and console, 1 = most consequential",
          "type": "integer",
          "minimum": 1
        },
        "plain_title": {
          "description": "headline: what happens to whom, in words a non-lawyer understands",
          "type": "string",
          "minLength": 1
        },
        "story": {
          "description": "headline: about three sentences: who, what happens, why it matters",
          "type": "string",
          "minLength": 1
        },
        "merged_into": {
          "description": "merged: the ID of the finding it is reported under",
          "type": "string",
          "pattern": "^[DRLTUPEMIXWFS]-\\d{2,}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "assert",
            "scenario",
            "simulation",
            "quote"
          ]
        },
        "file": {
          "description": "assert: the L4 file, relative to the subject",
          "type": "string"
        },
        "text": {
          "description": "assert: the assertion as it appears in the file",
          "type": "string"
        },
        "label": {
          "description": "scenario: its label in the scheme",
          "type": "string"
        },
        "seed": {
          "description": "simulation: the seed",
          "type": "integer"
        },
        "days": {
          "description": "simulation: days to run",
          "type": "integer"
        },
        "params": {
          "description": "simulation: parameters that differ from the defaults",
          "type": "object"
        },
        "document": {
          "description": "quote: a source-bundle document id or a reference-set item id",
          "type": "string"
        },
        "location": {
          "description": "quote: where in the document",
          "type": "string"
        },
        "quote": {
          "description": "quote: the words, which must appear in the pinned copy",
          "type": "string"
        }
      }
    }
  }
}
