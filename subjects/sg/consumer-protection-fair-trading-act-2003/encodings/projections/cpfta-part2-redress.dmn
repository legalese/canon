    <knowledgeRequirement id="decision_the_court_may_order_the_individual_to_inform_the_commission_of_notifiable_events_for_the_specified_period_kr1">
      <requiredKnowledge href="#bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period"/>
    </knowledgeRequirement>
    <literalExpression id="decision_the_court_may_order_the_individual_to_inform_the_commission_of_notifiable_events_for_the_specified_period_literal">
      <text>the_court_may_grant_an_injunction_under_section_10_1 and (a_9.the_person_is_an_individual and the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period(period: a_9.the_specified_period_in_years, the_period_the_Minister_has_prescribed_in_place_of_5_years: a_9.the_period_in_years_that_the_Minister_has_prescribed_in_place_of_5_years))</text>
    </literalExpression>
