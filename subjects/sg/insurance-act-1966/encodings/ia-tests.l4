#ASSERT NOT `the activity is permitted` `a life insurer` (`granting an unsecured loan or advance` FALSE TRUE FALSE 5001 0)
#ASSERT `the activity is permitted` `a life insurer` (`granting an unsecured loan or advance` FALSE FALSE FALSE 60000 60000)
-- s 89: a broker's non-employee director, nothing; an employee, $3,000
#ASSERT NOT `the activity is permitted` `a broker` (`granting an unsecured loan or advance` TRUE TRUE FALSE 100 0)
#ASSERT `the activity is permitted` `a broker` (`granting an unsecured loan or advance` TRUE TRUE TRUE 3000 0)
#ASSERT NOT `the activity is permitted` `a broker` (`granting an unsecured loan or advance` TRUE FALSE FALSE 3001 0)
-- s 16(7)(c)(iv): $900,000 of bonus allows $100,000 to the surplus account
`fund` MEANS `Fund facts` OF 900000, 100000, TRUE, FALSE
#ASSERT `the most that may be allocated to the surplus account` `fund` EQUALS 100000
#ASSERT `the activity is permitted` `a life insurer` (`allocating to the surplus account of a participating fund` `fund`)
#ASSERT NOT `the activity is permitted` `a life insurer` (`allocating to the surplus account of a participating fund` (`Fund facts` OF 900000, 100001, TRUE, FALSE))
#ASSERT NOT `the activity is permitted` `a life insurer` (`allocating to the surplus account of a participating fund` (`Fund facts` OF 900000, 50000, FALSE, FALSE))
-- s 16(10): surplus $5m, requirement $3m: up to $2m
#ASSERT `the most that may be withdrawn from a fund, surplus` 5000000 `, solvency requirement` 3000000 `, disallowed:` FALSE EQUALS 2000000
#ASSERT `the most that may be withdrawn from a fund, surplus` 5000000 `, solvency requirement` 3000000 `, disallowed:` TRUE EQUALS 0
#ASSERT NOT `the activity is permitted` `a life insurer` (`withdrawing from an insurance fund` 2000001 5000000 3000000 FALSE)
