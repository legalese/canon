§§ `The thresholds each definition states`

-- A condition whose definition states no number answers `all of` EMPTY, which every
-- diagnosis meets: its definition is wholly qualitative, and the specialist's certificate
-- (cstd-annex-rules.l4) carries it. Each arm is under the lines that state its numbers.
GIVEN c IS A `A listed condition`
GIVETH A `A criterion`
`the measured criteria of` c MEANS
    CONSIDER c
    -- E1b
    -- src:1421 | T1N0M0 theo phân loại TNM hoặc ung thư biểu mô thể
    -- src:1422 | nhú của tuyến giáp với đường kính nhỏ hơn 2cm.
    WHEN `early thyroid cancer` THEN
        `any of` (LIST (`the stated qualitative alternative`), (`less than` `thyroid tumour diameter in cm` 2))
    -- E1d
    -- src:1427 | Ung thư máu dòng lympho mạn tính (CLL) Giai đoạn 1
    -- src:1428 | hoặc 2 theo phân loại RAI. Loại trừ CLL giai đoạn 0 hoặc
    -- src:1429 | sớm hơn theo RAI.
    WHEN `early chronic lymphocytic leukaemia` THEN
        `all of` (LIST (`at least` `RAI stage` 1), (`at most` `RAI stage` 2))
    -- E1e
    -- src:1431 | Ung thư hắc tố xâm lấn hoặc dưới 1.5 mm bề dày theo
    -- src:1432 | Breslow hoặc dưới mức 3 theo Clark. Loại trừ ung thư
    WHEN `early melanoma` THEN
        `any of` (LIST (`the stated qualitative alternative`), (`less than` `Breslow thickness in mm` 1.5), (`less than` `Clark level` 3))
    -- E3
    -- src:1458 | nghiệm trạng thái tâm thần tối thiểu với số điểm từ 24
    -- src:1459 | (hai mươi bốn) trở xuống theo thang điểm 30 (ba mươi)
    WHEN `diagnosed dementia including Alzheimer's disease` THEN
        `any of` (LIST (`at most` `MMSE score out of 30` 24), (`the stated qualitative alternative`))
    -- E5
    -- src:1480 | Công ty chỉ định. Tình trạng này kéo dài ít nhất 1 (một)
    -- src:1481 | tháng kể từ ngày được chẩn đoán.
    WHEN `akinetic mutism` THEN
        `at least` `months the qualifying state has lasted` 1
    -- E6
    -- src:1485 | • Không đáp ứng với kích thích bên ngoài trong vòng
    -- src:1486 | ít nhất là 48 giờ;
    -- src:1489 | viễn được đánh giá ít nhất 30 (ba mươi) ngày sau
    WHEN `coma of at least 48 hours` THEN
        `all of` (LIST (`at least` `hours without response to external stimuli` 48), (`at least` `days after the coma at which the permanent neurological deficit is assessed` 30))
    -- E9
    -- src:1533 | kinh và tổn thương kéo dài ít nhất 6 (sáu) tháng.
    WHEN `spinal cord disease or injury causing bowel and bladder dysfunction` THEN
        `at least` `months the qualifying state has lasted` 6
    -- E11
    -- src:1541 | Hẹp tối thiểu 60% lòng mạch của 2 (hai) động mạch
    WHEN `mild coronary artery disease` THEN
        `at least` `number of named coronary arteries narrowed by at least 60%` 2
    -- E14
    -- src:1589 | tổn thương thực thể vĩnh viễn không hồi phục tương
    -- src:1590 | ứng với nhóm 3 của bảng phân loại suy tim của Hiệp hội
    WHEN `early pulmonary arterial hypertension` THEN
        `all of` (LIST (`at least` `NYHA class` 3), (`at most` `NYHA class` 3))
    -- E16
    -- src:1634 | đường kính lớn hơn 55mm và chẩn đoán phải được xác
    WHEN `large asymptomatic aortic aneurysm` THEN
        `more than` `aortic diameter in mm` 55
    -- E18
    -- src:1646 | Phẫu thuật cần thiết cắt bỏ của ít nhất toàn bộ 1 (một)
    -- src:1647 | thùy gan do bệnh hoặc tai nạn.
    WHEN `liver surgery` THEN
        `at least` `whole liver lobes removed` 1
    -- E20b
    -- src:1677 | chức năng thận bị suy giảm nghiêm trọng với eGFR ít
    -- src:1678 | hơn 30ml/phút/1,73m2 diện tích bề mặt cơ thể, kéo dài
    -- src:1679 | trong 90 (chín mươi) ngày trở lên.
    WHEN `chronic kidney damage` THEN
        `all of` (LIST (`less than` `eGFR in ml per minute per 1.73 square metres of body surface` 30), (`at least` `days the qualifying state has lasted` 90))
    -- E23
    -- src:1705 | nhiễm virus phải được thông báo cho Công ty
    -- src:1706 | trong vòng 30 (ba mươi) ngày kể từ khi xảy ra
    -- src:1707 | sự việc; và
    -- src:1711 | HIV âm tính sang dương tính xảy ra trong thời
    -- src:1712 | gian 180 (một trăm tám mươi) ngày sau cuộc
    -- src:1713 | tấn công. Bằng chứng này phải bao gồm xét
    -- src:1724 | vòng 5 (năm) ngày sau khi sự việc xảy ra.
    WHEN `HIV infection from an assault or at work` THEN
        `all of` (LIST (`at most` `days from the incident to notice to the Company` 30), (`at most` `days from the incident to seroconversion` 180), (`at most` `days from the incident to the negative HIV antibody test` 5))
    -- E27
