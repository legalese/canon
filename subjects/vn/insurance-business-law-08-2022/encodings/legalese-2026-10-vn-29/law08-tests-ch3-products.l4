`a licensed insurer co-insuring` MEANS `A would-be co-insurer` WITH
    `is an insurer or a branch of a foreign non-life insurer` IS TRUE
    `holds a licence to establish and operate under this Law` IS TRUE
`an unlicensed insurer co-insuring` MEANS `A would-be co-insurer` WITH
    `is an insurer or a branch of a foreign non-life insurer` IS TRUE
    `holds a licence to establish and operate under this Law` IS FALSE
`a reinsurer co-insuring` MEANS `A would-be co-insurer` WITH
    `is an insurer or a branch of a foreign non-life insurer` IS FALSE
    `holds a licence to establish and operate under this Law` IS TRUE
#ASSERT `Dieu 89(2): the enterprise may take part in co-insurance` `a licensed insurer co-insuring`
#ASSERT NOT `Dieu 89(2): the enterprise may take part in co-insurance` `an unlicensed insurer co-insuring`
#ASSERT NOT `Dieu 89(2): the enterprise may take part in co-insurance` `a reinsurer co-insuring`
#ASSERT REFUSED `Dieu 89(5): the Minister of Finance's rules on reinsurance, ceding and co-insurance`

