IMPORT prelude
IMPORT `ptca-fares`

-- Public Transport Council Act 1987, ss 2, 28, 33, 40, 41, 49, 52-58, 64, 67 and Third Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_public-transport-council-act-1987.py). Expected results were written by
-- hand from the text.

§ `s 2 invalid ticket`

#ASSERT NOT `the ticket is invalid` `a ticket in order`
#ASSERT `the ticket is invalid` `a ticket used to over-travel without reasonable excuse`
#ASSERT NOT `the ticket is invalid` `a ticket used to over-travel with a reasonable excuse`
#ASSERT `the ticket is invalid` `a non-transferable ticket used by someone other than its first user`
#ASSERT `the ticket is invalid` `an expired ticket`

§ `s 54(4) evasion`

#ASSERT `the individual evades the fare` TRUE `having travelled` `did not tap out` FALSE
#ASSERT NOT `the individual evades the fare` TRUE `attempting to travel` `did not tap out` FALSE
#ASSERT `the individual evades the fare` TRUE `attempting to travel` `did not tap in` FALSE
#ASSERT NOT `the individual evades the fare` TRUE `having travelled` `did not pay the fare` TRUE
#ASSERT NOT `the individual evades the fare` FALSE `having travelled` `did not pay the fare` FALSE
#ASSERT NOT `the individual evades the fare` TRUE `having travelled` `paid and tapped in and out` FALSE

§ `s 54(5) presumption`

#ASSERT `evasion is presumed` `produced no ticket` FALSE
#ASSERT NOT `evasion is presumed` `produced no ticket` TRUE
#ASSERT `evasion is presumed` `produced a concession ticket but no evidence of entitlement` FALSE
#ASSERT `evasion is presumed` `produced an invalid ticket and then no valid ticket` FALSE
#ASSERT NOT `evasion is presumed` `produced an invalid ticket and then a valid ticket` FALSE

§ `s 53(8) penalty fee`

#ASSERT NOT `may still be prosecuted or offered composition for evasion` TRUE TRUE TRUE
#ASSERT `may still be prosecuted or offered composition for evasion` TRUE TRUE FALSE

§ `ss 52(2), 57`

#ASSERT `refusing to identify oneself is an offence` TRUE TRUE FALSE
#ASSERT NOT `refusing to identify oneself is an offence` TRUE TRUE TRUE

§ `s 58`

#ASSERT `may arrest without warrant` TRUE TRUE TRUE FALSE
#ASSERT NOT `may arrest without warrant` TRUE FALSE TRUE FALSE

§ `s 56`

#ASSERT `not paying the hail fare is an offence` `a ride-hail bookable vehicle` TRUE TRUE TRUE FALSE
#ASSERT NOT `not paying the hail fare is an offence` `a street-hail taxi` TRUE FALSE TRUE FALSE
#ASSERT NOT `not paying the hail fare is an offence` `a public bus` TRUE TRUE TRUE FALSE

§ `ss 54(2), 56(4), (5) repeat offenders`

#ASSERT `the offender is a repeat offender` `bus or train fare evasion (s 54(1))` `an earlier old s 24C(5) conviction`
#ASSERT NOT `the offender is a repeat offender` `street-hail non-payment (s 56(1))` `an earlier s 56(2) conviction`
#ASSERT `the offender is a repeat offender` `street-hail non-payment (s 56(1))` `an earlier old s 24D conviction`
#ASSERT NOT `the offender is a repeat offender` `ride-hail non-payment (s 56(2))` `an earlier s 54(1) conviction`

§ `maximum punishments`

#ASSERT `the maximum fine` `bus or train fare evasion (s 54(1))` FALSE EQUALS 1000
#ASSERT `the maximum fine` `bus or train fare evasion (s 54(1))` TRUE EQUALS 2000
#ASSERT `the maximum fine` `licensee offering fares off the pricing policy (s 41(5))` FALSE EQUALS 100000
#ASSERT `the maximum fine` `unlicensed ticket payment service (s 64)` FALSE EQUALS 50000

#ASSERT `the maximum imprisonment in months` `ride-hail non-payment (s 56(2))` TRUE EQUALS 6
#ASSERT `the maximum imprisonment in months` `charging an unlawful fare (s 41(7))` FALSE EQUALS 6

#ASSERT `the further fine for an unlicensed ticket payment service` 3 EQUALS 15000

§ `s 28`

#ASSERT `the ticket payment service is unlicensed` TRUE FALSE
#ASSERT NOT `the ticket payment service is unlicensed` TRUE TRUE

