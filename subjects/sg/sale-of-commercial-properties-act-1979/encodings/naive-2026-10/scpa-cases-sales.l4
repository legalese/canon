IMPORT prelude
IMPORT `scpa-sales`

-- Sale of Commercial Properties Act 1979, ss 3 to 5A, 5D, 5E, 6 to 9A, 10(3) and 11 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_sale-of-commercial-properties-act-1979.py). Expected results were written by
-- hand from the text.

§ `s 11(1)`

#ASSERT `the Act applies to the sale` 20 FALSE FALSE FALSE FALSE
#ASSERT NOT `the Act applies to the sale` 4 FALSE FALSE FALSE FALSE
#ASSERT `the Act applies to the sale` 5 FALSE FALSE FALSE FALSE
#ASSERT `the Act applies to the sale` 20 TRUE TRUE FALSE FALSE
#ASSERT NOT `the Act applies to the sale` 20 TRUE TRUE TRUE FALSE
#ASSERT NOT `the Act applies to the sale` 20 FALSE FALSE FALSE TRUE

§ `s 3(2), (3)`

#ASSERT `the transaction is a sale` TRUE FALSE FALSE 0 FALSE
#ASSERT `the transaction is a sale` FALSE TRUE FALSE 0 FALSE
#ASSERT NOT `the transaction is a sale` TRUE FALSE TRUE 7 FALSE
#ASSERT `the transaction is a sale` TRUE FALSE TRUE 8 FALSE
#ASSERT `the transaction is a sale` TRUE FALSE TRUE 3 TRUE

§ `s 3(1) and s 6`

#ASSERT `the sale breaches s 3` TRUE TRUE FALSE
#ASSERT NOT `the sale breaches s 3` TRUE TRUE TRUE
#ASSERT NOT `the sale breaches s 3` FALSE TRUE FALSE

