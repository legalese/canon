#ASSERT NOT `the regulatory action is open to the Director-General` `false or misleading application` `suspension or revocation` 0 13 TRUE
#ASSERT NOT `the regulatory action is open to the Director-General` `breach of a licence condition` `suspension or revocation` 0 14 FALSE
#ASSERT `the regulatory action is open to the Director-General` `breach of a licence condition` `censure` 0 14 FALSE

