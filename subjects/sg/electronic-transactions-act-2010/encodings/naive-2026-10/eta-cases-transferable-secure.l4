    `issued there` IS TRUE
    `transferred there` IS TRUE
    `controlled there` IS TRUE
    `presented there` IS TRUE
    `stored there` IS TRUE
    `all during the provider's registration` IS TRUE

`a record issued elsewhere then moved to an accredited system` MEANS SystemUse WITH
    `on an accredited system of a registered, licensed, accredited or recognised provider` IS TRUE
    `issued there` IS FALSE
    `transferred there` IS TRUE
    `controlled there` IS TRUE
    `presented there` IS TRUE
    `stored there` IS TRUE
    `all during the provider's registration` IS TRUE

`a record on an accredited system after the provider's registration lapsed` MEANS SystemUse WITH
    `on an accredited system of a registered, licensed, accredited or recognised provider` IS TRUE
    `issued there` IS TRUE
    `transferred there` IS TRUE
    `controlled there` IS TRUE
    `presented there` IS TRUE
    `stored there` IS TRUE
    `all during the provider's registration` IS FALSE

`a record on an unaccredited system` MEANS SystemUse WITH
    `on an accredited system of a registered, licensed, accredited or recognised provider` IS FALSE
    `issued there` IS TRUE
    `transferred there` IS TRUE
    `controlled there` IS TRUE
    `presented there` IS TRUE
    `stored there` IS TRUE
    `all during the provider's registration` IS TRUE

`a paper bill converted with a statement` MEANS ChangeOfMedium WITH
    `paper to electronic` IS TRUE
    `a reliable method is used` IS TRUE
    `the core information is accurately reproduced` IS TRUE
    `the section 16C additional information is reproduced` IS FALSE
    `a statement of the change of medium is inserted` IS TRUE

`a paper bill converted without a statement` MEANS ChangeOfMedium WITH
    `paper to electronic` IS TRUE
    `a reliable method is used` IS TRUE
    `the core information is accurately reproduced` IS TRUE
    `the section 16C additional information is reproduced` IS FALSE
    `a statement of the change of medium is inserted` IS FALSE

`an electronic bill printed without its vessel tracking data` MEANS ChangeOfMedium WITH
    `paper to electronic` IS FALSE
    `a reliable method is used` IS TRUE
    `the core information is accurately reproduced` IS TRUE
    `the section 16C additional information is reproduced` IS FALSE
    `a statement of the change of medium is inserted` IS TRUE

`an electronic bill printed with a missing clause` MEANS ChangeOfMedium WITH
    `paper to electronic` IS FALSE
    `a reliable method is used` IS TRUE
    `the core information is accurately reproduced` IS FALSE
    `the section 16C additional information is reproduced` IS TRUE
    `a statement of the change of medium is inserted` IS TRUE

`an electronic bill printed by an unreliable method` MEANS ChangeOfMedium WITH
    `paper to electronic` IS FALSE
    `a reliable method is used` IS FALSE
    `the core information is accurately reproduced` IS TRUE
    `the section 16C additional information is reproduced` IS TRUE
    `a statement of the change of medium is inserted` IS TRUE

`a digital signature on a smart card` MEANS SignatureFacts WITH
    `the procedure` IS `a specified security procedure`
    `properly applied` IS TRUE
    `unique to the person` IS TRUE
    `capable of identifying the person` IS TRUE
    `under the sole control of the person` IS TRUE
    `invalidated if the record changes` IS TRUE

`an agreed bank token signature` MEANS SignatureFacts WITH
    `the procedure` IS `a commercially reasonable procedure agreed by the parties`
    `properly applied` IS TRUE
    `unique to the person` IS TRUE
    `capable of identifying the person` IS TRUE
    `under the sole control of the person` IS TRUE
    `invalidated if the record changes` IS TRUE

`a shared-password signature` MEANS SignatureFacts WITH
    `the procedure` IS `a commercially reasonable procedure agreed by the parties`
    `properly applied` IS TRUE
    `unique to the person` IS FALSE
    `capable of identifying the person` IS TRUE
    `under the sole control of the person` IS FALSE
    `invalidated if the record changes` IS TRUE

`a signature not tied to the record` MEANS SignatureFacts WITH
    `the procedure` IS `a specified security procedure`
    `properly applied` IS TRUE
    `unique to the person` IS TRUE
    `capable of identifying the person` IS TRUE
    `under the sole control of the person` IS TRUE
    `invalidated if the record changes` IS FALSE

`an unagreed procedure signature` MEANS SignatureFacts WITH
    `the procedure` IS `a commercially reasonable procedure not agreed`
    `properly applied` IS TRUE
    `unique to the person` IS TRUE
    `capable of identifying the person` IS TRUE
    `under the sole control of the person` IS TRUE
    `invalidated if the record changes` IS TRUE

`a scanned handwritten signature` MEANS SignatureFacts WITH
    `the procedure` IS `no procedure`
    `properly applied` IS FALSE
    `unique to the person` IS FALSE
    `capable of identifying the person` IS TRUE
    `under the sole control of the person` IS FALSE
    `invalidated if the record changes` IS FALSE

`a signature under an accredited CA certificate` MEANS DigitalSignature WITH
    `the issuer` IS `an accredited certification authority`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS FALSE

`a signature under a government CA certificate` MEANS DigitalSignature WITH
    `the issuer` IS `a public agency approved by the Minister`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS FALSE

`a signature under a foreign recognised CA certificate` MEANS DigitalSignature WITH
    `the issuer` IS `a recognised certification authority`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS FALSE

`a signature under a commercial CA with no agreement` MEANS DigitalSignature WITH
    `the issuer` IS `an unaccredited commercial authority`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS FALSE

`a signature under a commercial CA the parties agreed to use` MEANS DigitalSignature WITH
    `the issuer` IS `an unaccredited commercial authority`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS TRUE

`a self-signed signature the parties agreed to use` MEANS DigitalSignature WITH
    `the issuer` IS `the subscriber itself`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS TRUE

`a signature made after the certificate was revoked` MEANS DigitalSignature WITH
    `the issuer` IS `an accredited certification authority`
    `the subscriber accepted the certificate` IS TRUE
    `created within the certificate's operational period` IS FALSE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS FALSE

`a signature under a certificate never accepted` MEANS DigitalSignature WITH
    `the issuer` IS `an accredited certification authority`
    `the subscriber accepted the certificate` IS FALSE
    `created within the certificate's operational period` IS TRUE
    `verified by the public key in the certificate` IS TRUE
    `sender and recipient expressly agreed to use digital signatures` IS FALSE

`a forged signature an accredited CA handled correctly` MEANS CALoss WITH
    `the CA is accredited, public or recognised` IS TRUE
    `the CA waived paragraph 11` IS FALSE
    `the loss was caused by a forged signature of a subscriber` IS TRUE
    `the CA complied with the Act as to that signature` IS TRUE
    `the loss was caused by a misrepresentation in the certificate or a breach of paragraphs 14 and 15` IS FALSE
    `the loss` IS 500000
    `the recommended reliance limit` IS 10000
    `the CA's liability apart from paragraph 11` IS 500000

`a forged signature an accredited CA mishandled` MEANS CALoss WITH
    `the CA is accredited, public or recognised` IS TRUE
    `the CA waived paragraph 11` IS FALSE
    `the loss was caused by a forged signature of a subscriber` IS TRUE
    `the CA complied with the Act as to that signature` IS FALSE
    `the loss was caused by a misrepresentation in the certificate or a breach of paragraphs 14 and 15` IS FALSE
    `the loss` IS 500000
    `the recommended reliance limit` IS 10000
    `the CA's liability apart from paragraph 11` IS 500000

`a false identity in an accredited certificate` MEANS CALoss WITH
    `the CA is accredited, public or recognised` IS TRUE
    `the CA waived paragraph 11` IS FALSE
    `the loss was caused by a forged signature of a subscriber` IS FALSE
    `the CA complied with the Act as to that signature` IS FALSE
    `the loss was caused by a misrepresentation in the certificate or a breach of paragraphs 14 and 15` IS TRUE
    `the loss` IS 500000
    `the recommended reliance limit` IS 10000
    `the CA's liability apart from paragraph 11` IS 500000

`a false identity in a certificate within the limit` MEANS CALoss WITH
    `the CA is accredited, public or recognised` IS TRUE
    `the CA waived paragraph 11` IS FALSE
    `the loss was caused by a forged signature of a subscriber` IS FALSE
    `the CA complied with the Act as to that signature` IS FALSE
    `the loss was caused by a misrepresentation in the certificate or a breach of paragraphs 14 and 15` IS TRUE
    `the loss` IS 4000
    `the recommended reliance limit` IS 10000
    `the CA's liability apart from paragraph 11` IS 4000

`a false identity where the CA waived the cap` MEANS CALoss WITH
    `the CA is accredited, public or recognised` IS TRUE
    `the CA waived paragraph 11` IS TRUE
    `the loss was caused by a forged signature of a subscriber` IS FALSE
    `the CA complied with the Act as to that signature` IS FALSE
    `the loss was caused by a misrepresentation in the certificate or a breach of paragraphs 14 and 15` IS TRUE
    `the loss` IS 500000
    `the recommended reliance limit` IS 10000
    `the CA's liability apart from paragraph 11` IS 500000

`a false identity in an unaccredited CA's certificate` MEANS CALoss WITH
    `the CA is accredited, public or recognised` IS FALSE
    `the CA waived paragraph 11` IS FALSE
    `the loss was caused by a forged signature of a subscriber` IS FALSE
    `the CA complied with the Act as to that signature` IS FALSE
