@lang en
IMPORT prelude
IMPORT daydate
IMPORT `law08-vintage`
IMPORT `law08-nouns`
IMPORT `law08-ch2-general`
IMPORT `law08-ch2-property`

-- Tests for Chuong II, Muc 3-4 (Dieu 43-61). Expected values are worked by hand from the cited lines.

§ `Tests: Chuong II, Muc 3 and 4`

§§ `Dieu 43 and 44`

@@q 897 911
#ASSERT `Dieu 43: the object of insurance of a property or damage contract` `a property insurance contract` EQUALS `property as the Civil Code defines it`
#ASSERT `Dieu 43: the object of insurance of a property or damage contract` `a damage insurance contract` EQUALS `an economic interest or an obligation under a contract or by law that the insured person bears on a loss`
#ASSERT REFUSED `Dieu 43: the object of insurance of a property or damage contract` `a life insurance contract`
@@fx `an owner` : `A property or damage contract and a loss` ; `the policyholder is owner, holds another right in the property or possesses or uses it without owning` = TRUE
@@fx `a policyholder with a financial interest` : `A property or damage contract and a loss` ; `the policyholder has a financial interest, financial obligation or liability, or economic loss in respect of the object` = TRUE
@@fx `a stranger` : `A property or damage contract and a loss`
@@fx `a policyholder with interest at the loss` : `A property or damage contract and a loss` ; `the policyholder or insured person has the insurable interest at the time of the loss` = TRUE
#ASSERT `Dieu 44(1): the policyholder has an insurable interest in the insured property` `an owner`
#ASSERT NOT `Dieu 44(1): the policyholder has an insurable interest in the insured property` `a stranger`
#ASSERT `Dieu 44(2): the policyholder has an insurable interest in the damage` `a policyholder with a financial interest`
#ASSERT NOT `Dieu 44(2): the policyholder has an insurable interest in the damage` `a stranger`
#ASSERT `Dieu 44(3): the insurable interest exists at the time of the loss` `a policyholder with interest at the loss`
#ASSERT NOT `Dieu 44(3): the insurable interest exists at the time of the loss` `an owner`

§§ `Dieu 46`

@@q 918 932
@ref Dieu 46 (src:918-932)
@@fx `a late notice under a contract with sanctions` : `A notice of the insured event` ; `the contract agrees the policyholder's responsibility and the sanctions for failing or delaying to notify` = TRUE ; `the loss the insurer bears because of the failure or delay` = 15_000_000 ; `compensation otherwise payable` = 100_000_000
@@fx `a late notice under a contract without sanctions` : `A notice of the insured event` ; `the loss the insurer bears because of the failure or delay` = 15_000_000 ; `compensation otherwise payable` = 100_000_000
@@fx `a late notice excused by force majeure` : `A notice of the insured event` ; `force majeure or an objective obstacle prevented timely notice` = TRUE ; `the contract agrees the policyholder's responsibility and the sanctions for failing or delaying to notify` = TRUE ; `the loss the insurer bears because of the failure or delay` = 15_000_000 ; `compensation otherwise payable` = 100_000_000
@@fx `a timely notice under a contract with sanctions` : `A notice of the insured event` ; `the policyholder notified within the time the contract agrees` = TRUE ; `the contract agrees the policyholder's responsibility and the sanctions for failing or delaying to notify` = TRUE ; `the loss the insurer bears because of the failure or delay` = 15_000_000 ; `compensation otherwise payable` = 100_000_000
@@fx `a late notice costing more than the compensation` : `A notice of the insured event` ; `the contract agrees the policyholder's responsibility and the sanctions for failing or delaying to notify` = TRUE ; `the loss the insurer bears because of the failure or delay` = 150_000_000 ; `compensation otherwise payable` = 100_000_000
#ASSERT `Dieu 46: the insurer may reduce the compensation` `a late notice under a contract with sanctions`
#ASSERT NOT `Dieu 46: the insurer may reduce the compensation` `a late notice under a contract without sanctions`
#ASSERT NOT `Dieu 46: the insurer may reduce the compensation` `a late notice excused by force majeure`
#ASSERT NOT `Dieu 46: the insurer may reduce the compensation` `a timely notice under a contract with sanctions`
#ASSERT `Dieu 46: the compensation after the reduction` `a late notice under a contract with sanctions` EQUALS 85_000_000
#ASSERT `Dieu 46: the compensation after the reduction` `a late notice under a contract without sanctions` EQUALS 100_000_000
#ASSERT `Dieu 46: the compensation after the reduction` `a late notice excused by force majeure` EQUALS 100_000_000
#ASSERT `Dieu 46: the compensation after the reduction` `a late notice costing more than the compensation` EQUALS 0

§§ `Dieu 47`

@@q 934 952
@ref Dieu 47 (src:934-952)
@@fx `an unintended over-insurance, no event` : `A property or damage contract and a loss` ; `sum insured` = 120_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `premium paid` = 60_000_000 ; `reasonable costs the contract allows to be deducted` = 500_000 ; `the over-insurance was made through the policyholder's unintentional fault` = TRUE
@@fx `a deliberate over-insurance` : `A property or damage contract and a loss` ; `sum insured` = 120_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `premium paid` = 60_000_000 ; `the over-insurance was made deliberately` = TRUE
@@fx `an unintended over-insurance after an event` : `A property or damage contract and a loss` ; `sum insured` = 120_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `market value of the property at the time and place of the loss` = 90_000_000 ; `actual loss` = 150_000_000 ; `premium paid` = 60_000_000 ; `the over-insurance was made through the policyholder's unintentional fault` = TRUE ; `the insured event has occurred` = TRUE
@@fx `the same with a small loss` : `A property or damage contract and a loss` ; `sum insured` = 120_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `market value of the property at the time and place of the loss` = 90_000_000 ; `actual loss` = 50_000_000 ; `premium paid` = 60_000_000 ; `the over-insurance was made through the policyholder's unintentional fault` = TRUE ; `the insured event has occurred` = TRUE
@@fx `a sum insured equal to the value` : `A property or damage contract and a loss` ; `sum insured` = 100_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `the over-insurance was made through the policyholder's unintentional fault` = TRUE
@@fx `costs above the premium for the excess` : `A property or damage contract and a loss` ; `sum insured` = 120_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `premium paid` = 60_000_000 ; `reasonable costs the contract allows to be deducted` = 11_000_000 ; `the over-insurance was made through the policyholder's unintentional fault` = TRUE
#ASSERT `Dieu 47(1): the contract insures above value` `an unintended over-insurance, no event`
#ASSERT NOT `Dieu 47(1): the contract insures above value` `a sum insured equal to the value`
#ASSERT `Dieu 47(1): the making of the contract is prohibited` `a deliberate over-insurance`
#ASSERT NOT `Dieu 47(1): the making of the contract is prohibited` `an unintended over-insurance, no event`
#ASSERT `Dieu 47(2): the premium the insurer must refund` `an unintended over-insurance, no event` EQUALS 9_500_000
#ASSERT REFUSED `Dieu 47(2): the premium the insurer must refund` `a deliberate over-insurance`
#ASSERT REFUSED `Dieu 47(2): the premium the insurer must refund` `a sum insured equal to the value`
#ASSERT REFUSED `Dieu 47(2): the premium the insurer must refund` `costs above the premium for the excess`
#ASSERT `Dieu 47(2)(b): the compensation for the loss` `an unintended over-insurance after an event` EQUALS 90_000_000
#ASSERT `Dieu 47(2)(b): the compensation for the loss` `the same with a small loss` EQUALS 50_000_000
#ASSERT REFUSED `Dieu 47(2)(b): the compensation for the loss` `an unintended over-insurance, no event`

§§ `Dieu 48`

@@q 956 963
@ref Dieu 48 (src:956-963)
@@fx `an under-insurance` : `A property or damage contract and a loss` ; `sum insured` = 60_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `actual loss` = 40_000_000
@@fx `an under-insurance with another agreement` : `A property or damage contract and a loss` ; `sum insured` = 60_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `actual loss` = 40_000_000 ; `the contract agrees otherwise on compensation` = TRUE
@@fx `full insurance` : `A property or damage contract and a loss` ; `sum insured` = 100_000_000 ; `market value of the property at the time of making` = 100_000_000 ; `actual loss` = 40_000_000
#ASSERT `Dieu 48(1): the contract insures below value` `an under-insurance`
#ASSERT NOT `Dieu 48(1): the contract insures below value` `full insurance`
#ASSERT `Dieu 48(2): the compensation for the loss` `an under-insurance` EQUALS 24_000_000
#ASSERT REFUSED `Dieu 48(2): the compensation for the loss` `an under-insurance with another agreement`
#ASSERT REFUSED `Dieu 48(2): the compensation for the loss` `full insurance`

§§ `Dieu 49`

@@q 965 973
@ref Dieu 49 (src:965-973)
@@fx `the first of two contracts` : `A contract in a double insurance` ; `sum insured` = 60_000_000
@@fx `the second of two contracts` : `A contract in a double insurance` ; `sum insured` = 40_000_000
@@fx `two contracts above the value` : `A double insurance` ; `contracts` = LIST `the first of two contracts`, `the second of two contracts` ; `market value of the property at the time of making` = 80_000_000 ; `actual loss` = 50_000_000 ; `the contracts cover the same scope, object, term and insured event` = TRUE
@@fx `two contracts within the value` : `A double insurance` ; `contracts` = LIST `the first of two contracts`, `the second of two contracts` ; `market value of the property at the time of making` = 100_000_000 ; `actual loss` = 50_000_000 ; `the contracts cover the same scope, object, term and insured event` = TRUE
@@fx `two contracts with different cover` : `A double insurance` ; `contracts` = LIST `the first of two contracts`, `the second of two contracts` ; `market value of the property at the time of making` = 80_000_000 ; `actual loss` = 50_000_000
@@fx `one contract` : `A double insurance` ; `contracts` = LIST `the first of two contracts` ; `market value of the property at the time of making` = 10_000_000 ; `actual loss` = 5_000_000 ; `the contracts cover the same scope, object, term and insured event` = TRUE
#ASSERT `Dieu 49(1): the contracts are in double insurance` `two contracts above the value`
#ASSERT NOT `Dieu 49(1): the contracts are in double insurance` `two contracts within the value`
#ASSERT NOT `Dieu 49(1): the contracts are in double insurance` `two contracts with different cover`
#ASSERT NOT `Dieu 49(1): the contracts are in double insurance` `one contract`
#ASSERT `Dieu 49(2): the compensation under the contract` `two contracts above the value` `the first of two contracts` EQUALS 30_000_000
#ASSERT `Dieu 49(2): the compensation under the contract` `two contracts above the value` `the second of two contracts` EQUALS 20_000_000
#ASSERT REFUSED `Dieu 49(2): the compensation under the contract` `two contracts within the value` `the first of two contracts`

§§ `Dieu 50 and 51`

@@q 975 996
@ref Dieu 50-51 (src:975-996)
@@fx `a loss by wear and tear` : `A property or damage contract and a loss` ; `the loss is natural wear and tear or the inherent nature of the property` = TRUE
@@fx `a loss by wear and tear covered by agreement` : `A property or damage contract and a loss` ; `the loss is natural wear and tear or the inherent nature of the property` = TRUE ; `the contract agrees otherwise on compensation` = TRUE
@@fx `a loss by fire` : `A property or damage contract and a loss`
#ASSERT `Dieu 50: the insurer is not liable for the loss` `a loss by wear and tear`
#ASSERT NOT `Dieu 50: the insurer is not liable for the loss` `a loss by wear and tear covered by agreement`
#ASSERT NOT `Dieu 50: the insurer is not liable for the loss` `a loss by fire`
@@fx `a loss below the sum insured` : `A property or damage contract and a loss` ; `sum insured` = 100_000_000 ; `actual loss` = 70_000_000 ; `costs reasonably and necessarily incurred to prevent and limit the loss` = 2_000_000 ; `costs the policyholder or insured person incurred in following the insurer's instructions` = 1_000_000
@@fx `a loss above the sum insured` : `A property or damage contract and a loss` ; `sum insured` = 100_000_000 ; `actual loss` = 120_000_000
@@fx `a loss at the sum insured` : `A property or damage contract and a loss` ; `sum insured` = 100_000_000 ; `actual loss` = 100_000_000
@@fx `a loss with another basis agreed` : `A property or damage contract and a loss` ; `sum insured` = 100_000_000 ; `actual loss` = 120_000_000 ; `the contract agrees otherwise on compensation` = TRUE
#ASSERT `Dieu 51(1)-(2): the compensation` `a loss below the sum insured` EQUALS 70_000_000
#ASSERT `Dieu 51(1)-(2): the compensation` `a loss above the sum insured` EQUALS 100_000_000
#ASSERT `Dieu 51(1)-(2): the compensation` `a loss at the sum insured` EQUALS 100_000_000
#ASSERT REFUSED `Dieu 51(1)-(2): the compensation` `a loss with another basis agreed`
#ASSERT `Dieu 51(3): the costs the insurer must pay besides the compensation` `a loss below the sum insured` EQUALS 3_000_000

§§ `Dieu 52`

@@q 998 1010
@ref Dieu 52 (src:998-1010)
@@fx `repair agreed` : `A form agreed for compensation` ; `form agreed` = JUST `repair of the damaged property`
@@fx `replacement agreed and done` : `A form agreed for compensation` ; `form agreed` = JUST `replacement of the damaged property by other property` ; `the damaged property was replaced or fully compensated at market value` = TRUE
@@fx `money paid in full` : `A form agreed for compensation` ; `form agreed` = JUST `payment of compensation in money` ; `the damaged property was replaced or fully compensated at market value` = TRUE
@@fx `no form agreed` : `A form agreed for compensation`
@@fx `no form agreed, paid in full` : `A form agreed for compensation` ; `the damaged property was replaced or fully compensated at market value` = TRUE
@@fx `replacement agreed, not yet done` : `A form agreed for compensation` ; `form agreed` = JUST `replacement of the damaged property by other property`
@@fx `repair agreed and paid` : `A form agreed for compensation` ; `form agreed` = JUST `repair of the damaged property` ; `the damaged property was replaced or fully compensated at market value` = TRUE
#ASSERT `Dieu 52: the form of compensation` `repair agreed` EQUALS `repair of the damaged property`
#ASSERT `Dieu 52: the form of compensation` `no form agreed` EQUALS `payment of compensation in money`
#ASSERT `Dieu 52(3): the insurer may recover the damaged property` `replacement agreed and done`
#ASSERT `Dieu 52(3): the insurer may recover the damaged property` `money paid in full`
#ASSERT `Dieu 52(3): the insurer may recover the damaged property` `no form agreed, paid in full`
#ASSERT NOT `Dieu 52(3): the insurer may recover the damaged property` `replacement agreed, not yet done`
#ASSERT NOT `Dieu 52(3): the insurer may recover the damaged property` `repair agreed and paid`

§§ `Dieu 53, 54, 55 and 56`

@@q 1012 1064
@ref Dieu 53-55 (src:1012-1064)
@@fx `a dispute on the extent of the loss` : `A loss adjustment and recourse`
@@fx `agreement on the extent of the loss` : `A loss adjustment and recourse` ; `the parties agree on the cause and extent of the loss` = TRUE
@@fx `a dispute with an adjuster agreed` : `A loss adjustment and recourse` ; `the parties agreed to hire an independent loss adjuster` = TRUE
@@fx `a dispute under a contract that provides otherwise` : `A loss adjustment and recourse` ; `the contract provides otherwise` = TRUE
#ASSERT `Dieu 53(2): the parties may agree to hire an independent loss adjuster` `a dispute on the extent of the loss`
#ASSERT NOT `Dieu 53(2): the parties may agree to hire an independent loss adjuster` `agreement on the extent of the loss`
#ASSERT NOT `Dieu 53(2): the parties may agree to hire an independent loss adjuster` `a dispute under a contract that provides otherwise`
#ASSERT `Dieu 53(2): a party may ask the court or arbitration to obtain an independent loss adjuster` `a dispute on the extent of the loss`
#ASSERT NOT `Dieu 53(2): a party may ask the court or arbitration to obtain an independent loss adjuster` `a dispute with an adjuster agreed`
@@fx `a paid claim with a liable third person` : `A loss adjustment and recourse` ; `a third person is liable for the loss` = TRUE ; `compensation paid` = 10_000_000
@@fx `a paid claim, transfer refused` : `A loss adjustment and recourse` ; `a third person is liable for the loss` = TRUE ; `compensation paid` = 10_000_000 ; `the insured person refused to transfer the right to claim against the third person` = TRUE
@@fx `a claim not yet paid` : `A loss adjustment and recourse` ; `a third person is liable for the loss` = TRUE
@@fx `a paid claim, the third person is a child` : `A loss adjustment and recourse` ; `a third person is liable for the loss` = TRUE ; `compensation paid` = 10_000_000 ; `the third person is the insured person's parent, spouse or child` = TRUE
@@fx `a paid claim, the child caused it deliberately` : `A loss adjustment and recourse` ; `a third person is liable for the loss` = TRUE ; `compensation paid` = 10_000_000 ; `the third person is the insured person's parent, spouse or child` = TRUE ; `that person deliberately caused the loss` = TRUE
#ASSERT `Dieu 54(1)(a): the insured person must transfer the right to claim reimbursement` `a paid claim with a liable third person`
#ASSERT NOT `Dieu 54(1)(a): the insured person must transfer the right to claim reimbursement` `a claim not yet paid`
#ASSERT `Dieu 54(1)(b): the insurer may deduct from the compensation` `a paid claim, transfer refused`
#ASSERT NOT `Dieu 54(1)(b): the insurer may deduct from the compensation` `a paid claim with a liable third person`
#ASSERT REFUSED `Dieu 54(1)(b): the amount the insurer may deduct` `a paid claim, transfer refused`
#ASSERT `Dieu 54(3): the insurer may claim reimbursement from the third person` `a paid claim with a liable third person`
#ASSERT NOT `Dieu 54(3): the insurer may claim reimbursement from the third person` `a paid claim, the third person is a child`
#ASSERT `Dieu 54(3): the insurer may claim reimbursement from the third person` `a paid claim, the child caused it deliberately`
@@fx `no safety measures, time not fixed` : `A safety measure` ; `the insured person failed to take the safety measures` = TRUE
@@fx `no safety measures, time fixed and running` : `A safety measure` ; `the insured person failed to take the safety measures` = TRUE ; `the insurer fixed a time for taking them` = TRUE
@@fx `no safety measures, time expired` : `A safety measure` ; `the insured person failed to take the safety measures` = TRUE ; `the insurer fixed a time for taking them` = TRUE ; `the time has expired and they are still not taken` = TRUE
#ASSERT NOT `Dieu 55(3): the insurer may raise the premium or terminate the contract` `no safety measures, time not fixed`
#ASSERT NOT `Dieu 55(3): the insurer may raise the premium or terminate the contract` `no safety measures, time fixed and running`
#ASSERT `Dieu 55(3): the insurer may raise the premium or terminate the contract` `no safety measures, time expired`
#ASSERT NOT `Dieu 56: the insured person may abandon the insured property` FALSE
#ASSERT `Dieu 56: the insured person may abandon the insured property` TRUE

§§ `Dieu 57 to 61`

@@q 1077 1124
#ASSERT `Dieu 57: the object of insurance of a liability contract` `a liability insurance contract` EQUALS `the civil liability of the insured person to a third person under the law`
#ASSERT REFUSED `Dieu 57: the object of insurance of a liability contract` `a property insurance contract`
@@fx `a claim within the term` : `A liability contract and a claim` ; `a third person claimed compensation from the insured person` = TRUE ; `the act causing the damage occurred within the insurance term` = TRUE ; `limit of liability` = 500_000_000 ; `amount the insured person must pay the third person by law` = 300_000_000 ; `costs of resolving the dispute on liability to the third person` = 40_000_000 ; `interest payable to the third person for the insured person's late payment as the insurer directed` = 10_000_000
@@fx `a claim above the limit` : `A liability contract and a claim` ; `a third person claimed compensation from the insured person` = TRUE ; `the act causing the damage occurred within the insurance term` = TRUE ; `limit of liability` = 500_000_000 ; `amount the insured person must pay the third person by law` = 480_000_000 ; `costs of resolving the dispute on liability to the third person` = 30_000_000 ; `interest payable to the third person for the insured person's late payment as the insurer directed` = 10_000_000
@@fx `a claim above the limit with another agreement` : `A liability contract and a claim` ; `a third person claimed compensation from the insured person` = TRUE ; `the act causing the damage occurred within the insurance term` = TRUE ; `limit of liability` = 500_000_000 ; `amount the insured person must pay the third person by law` = 480_000_000 ; `the contract agrees otherwise on the limit` = TRUE
@@fx `an act before the term` : `A liability contract and a claim` ; `a third person claimed compensation from the insured person` = TRUE ; `limit of liability` = 500_000_000 ; `amount the insured person must pay the third person by law` = 100_000_000
@@fx `no claim by a third person` : `A liability contract and a claim` ; `the act causing the damage occurred within the insurance term` = TRUE
@@fx `a direct claim where the law allows it` : `A liability contract and a claim` ; `the third person claims directly from the insurer` = TRUE ; `the law provides that the third person may claim directly` = TRUE
@@fx `a direct claim where the law is silent` : `A liability contract and a claim` ; `the third person claims directly from the insurer` = TRUE
@@fx `a bond requested and agreed` : `A liability contract and a claim` ; `the insured person must post a bond or deposit to keep the property from detention or to avoid a suit` = TRUE ; `the insured person asks the insurer to give the bond or deposit` = TRUE ; `the contract so agrees` = TRUE
@@fx `a bond requested but not agreed` : `A liability contract and a claim` ; `the insured person must post a bond or deposit to keep the property from detention or to avoid a suit` = TRUE ; `the insured person asks the insurer to give the bond or deposit` = TRUE
@@fx `a representation excluded by the contract` : `A liability contract and a claim` ; `the contract agrees otherwise on representation` = TRUE
@@fx `representation by default` : `A liability contract and a claim`
#ASSERT `Dieu 58(1): the insurer's liability arises` `a claim within the term`
#ASSERT NOT `Dieu 58(1): the insurer's liability arises` `an act before the term`
#ASSERT NOT `Dieu 58(1): the insurer's liability arises` `no claim by a third person`
#ASSERT `Dieu 58(2): the third person may claim directly from the insurer` `a direct claim where the law allows it`
#ASSERT NOT `Dieu 58(2): the third person may claim directly from the insurer` `a direct claim where the law is silent`
#ASSERT `Dieu 59(2)-(4): the total the insurer pays` `a claim within the term` EQUALS 350_000_000
#ASSERT `Dieu 59(2)-(4): the total the insurer pays` `a claim above the limit` EQUALS 500_000_000
#ASSERT REFUSED `Dieu 59(2)-(4): the total the insurer pays` `a claim above the limit with another agreement`
#ASSERT REFUSED `Dieu 59(2)-(4): the total the insurer pays` `an act before the term`
#ASSERT `Dieu 59(5): the insurer must give the bond or deposit` `a bond requested and agreed`
#ASSERT NOT `Dieu 59(5): the insurer must give the bond or deposit` `a bond requested but not agreed`
#ASSERT NOT `Dieu 60: the insurer may negotiate for the insured person` `a representation excluded by the contract`
#ASSERT `Dieu 60: the insurer may negotiate for the insured person` `representation by default`
#ASSERT `Dieu 61: the insurer may compensate the insured person directly or the damaged third person` TRUE
#ASSERT NOT `Dieu 61: the insurer may compensate the insured person directly or the damaged third person` FALSE
