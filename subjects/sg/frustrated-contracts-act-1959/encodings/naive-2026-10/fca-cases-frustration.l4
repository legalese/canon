IMPORT prelude
IMPORT `fca-frustration`

-- Frustrated Contracts Act 1959, ss 2 and 3 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_frustrated-contracts-act-1959.py). Expected results were written by
-- hand from the text.

§ `s 3(1), (2), (5)`

#ASSERT `the Act applies` `an ordinary contract` TRUE 2026
#ASSERT `the Act applies` `a contract with the Government` TRUE 2026
#ASSERT `the Act applies` `a time charterparty` TRUE 2026
#ASSERT `the Act applies` `a charterparty by way of demise` TRUE 2026
#ASSERT NOT `the Act applies` `a voyage charterparty` TRUE 2026
#ASSERT NOT `the Act applies` `a contract for carriage of goods by sea` TRUE 2026
#ASSERT NOT `the Act applies` `a contract of insurance` TRUE 2026
#ASSERT NOT `the Act applies` `a sale of specific goods frustrated by their perishing` TRUE 2026
#ASSERT `the Act applies` `a sale of specific goods frustrated otherwise` TRUE 2026

#ASSERT NOT `the Act applies` `an ordinary contract` FALSE 2026
#ASSERT NOT `the Act applies` `an ordinary contract` TRUE 1958
#ASSERT `the Act applies` `an ordinary contract` TRUE 1959

§ `s 3(3)`

#ASSERT `how the parties' positions are adjusted` `an ordinary contract` TRUE 2026 FALSE EQUALS `section 2 in full`
#ASSERT `how the parties' positions are adjusted` `an ordinary contract` TRUE 2026 TRUE EQUALS `the contract's own clause, with section 2 only so far as consistent`
#ASSERT `how the parties' positions are adjusted` `a voyage charterparty` TRUE 2026 FALSE EQUALS `the Act does not apply`
#ASSERT `how the parties' positions are adjusted` `an ordinary contract` TRUE 1958 TRUE EQUALS `the Act does not apply`

§ `s 3(4)`

#ASSERT `the part is treated as a separate unfrustrated contract` TRUE TRUE FALSE
#ASSERT `the part is treated as a separate unfrustrated contract` TRUE FALSE TRUE
#ASSERT NOT `the part is treated as a separate unfrustrated contract` FALSE TRUE TRUE
#ASSERT NOT `the part is treated as a separate unfrustrated contract` TRUE FALSE FALSE

§ `s 2(2), (3), (5)`

-- A wedding venue: $10,000 deposit paid, $5,000 balance payable, $3,000 spent preparing before the venue closed.
-- A tailor: $1,000 paid, $4,000 payable, $3,000 spent before the frustrating event.

#ASSERT `the expenses the court may count` 2000 500 1000 EQUALS 3500

#ASSERT `the most the payee may be allowed` 10000 5000 3000 EQUALS 3000
#ASSERT `the most the payee may be allowed` 1000 4000 3000 EQUALS 3000
#ASSERT `the most the payee may be allowed` 1000 0 3000 EQUALS 1000
#ASSERT `the most the payee may be allowed` 0 0 500 EQUALS 0

#ASSERT `the allowance is within section 2(3)` 10000 5000 3000 3000
#ASSERT NOT `the allowance is within section 2(3)` 10000 5000 3000 3001
#ASSERT NOT `the allowance is within section 2(3)` 1000 0 3000 2000
#ASSERT `the allowance is within section 2(3)` 1000 4000 3000 2500

#ASSERT `the refund to the payer` 10000 3000 EQUALS 7000
#ASSERT `the refund to the payer` 10000 0 EQUALS 10000
#ASSERT `the refund to the payer` 1000 3000 EQUALS 0

#ASSERT `the sum the payee may still recover` 1000 3000 EQUALS 2000
#ASSERT `the sum the payee may still recover` 10000 3000 EQUALS 0

§ `s 2(4), (7)`

#ASSERT `a claim for a benefit lies` TRUE TRUE FALSE
#ASSERT NOT `a claim for a benefit lies` TRUE TRUE TRUE
#ASSERT NOT `a claim for a benefit lies` FALSE TRUE FALSE

#ASSERT `the award is within section 2(4)` 5000 5000
#ASSERT NOT `the award is within section 2(4)` 5000 5001
#ASSERT `the award is within section 2(4)` 5000 0

#ASSERT `the benefit may be treated as the obligor's` TRUE TRUE
#ASSERT NOT `the benefit may be treated as the obligor's` TRUE FALSE

