#ASSERT `the Court may declare the removal wrongful` TRUE TRUE TRUE
#ASSERT NOT `the Court may declare the removal wrongful` FALSE TRUE TRUE

§ `ss 17, 18`

#ASSERT `may be granted legal aid under the Act` `Singapore citizen` `parent resisting return under s 8`
#ASSERT NOT `may be granted legal aid under the Act` `no link to Singapore or a Contracting State` `applicant for return under s 8`
#ASSERT `may be granted legal aid under the Act` `habitually resident in a Contracting State` `applicant for a declaration under s 14`
#ASSERT NOT `may be granted legal aid under the Act` `Singapore citizen` `respondent to a declaration under s 14`

#ASSERT `may receive legal advice under the Act` `citizen of a Contracting State`
#ASSERT NOT `may receive legal advice under the Act` `no link to Singapore or a Contracting State`

