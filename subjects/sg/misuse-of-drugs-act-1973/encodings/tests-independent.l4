-- ===== E. consumption =====
-- E1 first consumption 33(3A)
#ASSERT pun (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of another controlled drug (section 8(b)(i))` aNone) FALSE FALSE 120 12 20000 0 0 0 FALSE
-- E1b first consumption of specified drug 33(3A)
#ASSERT pun (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aNone) FALSE FALSE 120 12 20000 0 0 0 FALSE
-- E2 prev conviction nonspecified: min 3y
#ASSERT (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of another controlled drug (section 8(b)(i))` aConv1)'s `the minimum imprisonment in months` EQUALS 36
-- E2b prev conviction, 33(4) no strokes
#ASSERT (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of another controlled drug (section 8(b)(i))` aConv1)'s `the maximum strokes of the cane` EQUALS 0
-- E3 specified, 2 admissions
#ASSERT pun (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aAdm2) FALSE FALSE 84 60 0 0 3 6 FALSE
-- E4 specified, 1 adm + 1 conv
#ASSERT pun (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aAdm1Conv1) FALSE FALSE 84 60 0 0 3 6 FALSE
-- E5 specified, 1 conviction only: min 3y
#ASSERT (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aConv1)'s `the minimum imprisonment in months` EQUALS 36
-- E5b specified, 1 conviction only: no strokes
#ASSERT (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aConv1)'s `the minimum strokes of the cane` EQUALS 0
-- E6 again after 33A
#ASSERT pun (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aConv2Done) FALSE FALSE 156 84 0 0 6 12 FALSE
-- E7 nonspecified, 2 admissions: min 3y not 33A
#ASSERT (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of another controlled drug (section 8(b)(i))` aAdm2)'s `the minimum imprisonment in months` EQUALS 36
-- E7b nonspecified, 2 admissions: no strokes
#ASSERT (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of another controlled drug (section 8(b)(i))` aAdm2)'s `the maximum strokes of the cane` EQUALS 0
-- E8 specified, 1 conv + 1 urine conv (33A(1)(f))
#ASSERT pun (`the punishment on conviction of consumption or of failing to provide a specimen` `Consumption of a specified drug (section 8(b)(ii))` aConv1Urine1) FALSE FALSE 84 60 0 0 3 6 FALSE

