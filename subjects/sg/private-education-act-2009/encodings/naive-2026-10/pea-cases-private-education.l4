#ASSERT `the course is private education` `a part-time evening diploma`
#ASSERT `the course is private education` `a full-time certificate course`
#ASSERT NOT `the course is private education` `a part-time certificate course`
#ASSERT `the course is private education` `an international school`
#ASSERT NOT `the course is private education` `a weekend tuition class`
#ASSERT `the course is private education` `a full-time IELTS crash course`
#ASSERT NOT `the course is private education` `a two-week full-time exam boot camp`
#ASSERT NOT `the course is private education` `a full-time hobby cooking course`
#ASSERT NOT `the course is private education` `an apprenticeship with a diploma`
#ASSERT NOT `the course is private education` `an in-house staff diploma`
#ASSERT NOT `the course is private education` `a four-days-a-week certificate course`

§ `s 45`

#ASSERT `the Act applies to the provider` `a private company`
#ASSERT NOT `the Act applies to the provider` `ITE`
#ASSERT NOT `the Act applies to the provider` `an autonomous university`
#ASSERT NOT `the Act applies to the provider` `a purely religious school`
#ASSERT NOT `the Act applies to the provider` `a licensed childcare or preschool centre`

§ `s 7`

#ASSERT `offering the course is an offence` `a private company` `a full-time certificate course` FALSE
#ASSERT NOT `offering the course is an offence` `a private company` `a weekend tuition class` FALSE
#ASSERT `offering the course is an offence` `a sole proprietor` `an international school` FALSE

#ASSERT `the fees can be sued for` `a private company` `a part-time evening diploma` TRUE TRUE
#ASSERT NOT `the fees can be sued for` `a private company` `a part-time evening diploma` TRUE FALSE
#ASSERT `the fees can be sued for` `a private company` `a weekend tuition class` FALSE FALSE

§ `ss 10 and 11`

#ASSERT NOT `the form of the institution is a ground for refusal` `a private company`
#ASSERT NOT `the form of the institution is a ground for refusal` `a registered society`
#ASSERT `the form of the institution is a ground for refusal` `a sole proprietor`
#ASSERT `the form of the institution is a ground for refusal` `a partnership`

#ASSERT `the teaching staff is a ground for refusal` 6 10
#ASSERT NOT `the teaching staff is a ground for refusal` 5 10
#ASSERT `the teaching staff is a ground for refusal` 1 1

#ASSERT `the suspension is within the cap` 6
#ASSERT NOT `the suspension is within the cap` 7

#ASSERT NOT `the suspension may already take effect` 10
#ASSERT `the suspension may already take effect` 20

§ `s 14(1)(b)`

#ASSERT `the minimum days of notice to students` `registration cancelled` EQUALS 14
#ASSERT `the minimum days of notice to students` `the owners decide to close` EQUALS 30

#ASSERT NOT `the students had enough notice` `the owners decide to close` 20
#ASSERT `the students had enough notice` `registration not renewed` 20

§ `s 33`

#ASSERT `the Agency may direct a refund` `the course did not start on the agreed day` FALSE
#ASSERT `the Agency may direct a refund` `the course was cut short by regulatory action` FALSE
#ASSERT NOT `the Agency may direct a refund` `the course stopped part-way` TRUE
#ASSERT NOT `the Agency may direct a refund` `the student changed their mind` FALSE
#ASSERT NOT `the Agency may direct a refund` `the student was unhappy with the teaching` FALSE

#ASSERT `the student can sue for the refund` TRUE FALSE FALSE
#ASSERT NOT `the student can sue for the refund` TRUE TRUE TRUE
#ASSERT `the student can sue for the refund` TRUE TRUE FALSE

§ `s 19`

#ASSERT `the advertisement is taken to be misleading` FALSE FALSE TRUE FALSE
#ASSERT NOT `the advertisement is taken to be misleading` TRUE FALSE FALSE TRUE

§ `ss 21, 34 and 40`

#ASSERT NOT `the administrative penalty is within the cap` 5001

#ASSERT `the maximum fine` `running an unregistered institution` EQUALS 10000
#ASSERT `the maximum fine` `publishing a misleading advertisement` EQUALS 5000

#ASSERT `the maximum months of imprisonment` `ignoring a refund direction` EQUALS 12

#ASSERT `the maximum total fine` `running an unregistered institution` 30 EQUALS 40000
#ASSERT `the maximum total fine` `publishing a misleading advertisement` 30 EQUALS 5000

#ASSERT `the maximum composition sum` `running an unregistered institution` EQUALS 5000
#ASSERT `the maximum composition sum` `lying in a registration application` EQUALS 2500

