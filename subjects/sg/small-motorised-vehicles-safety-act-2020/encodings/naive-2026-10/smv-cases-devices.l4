IMPORT prelude
IMPORT `smv-devices`

-- Small Motorised Vehicles (Safety) Act 2020, ss 2, 5, 8A, 8B, 10(2), 11, 12(6), 13, 14, 15 and 19 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_small-motorised-vehicles-safety-act-2020.py). Expected results were written by
-- hand from the text.

`an e-scooter` MEANS Vehicle WITH
    `is wheeled` IS TRUE
    `is built to transport people only` IS TRUE
    `is suitable for land other than a railway` IS TRUE
    `has an electric motor` IS TRUE
    `is a bicycle` IS FALSE
    `is a trolley, inline skates or a wheeled toy` IS FALSE
    `is a prescribed type of motorised land vehicle` IS FALSE
    `assembly` IS `fully assembled`

`an electric hoverboard` MEANS Vehicle WITH
    `is wheeled` IS TRUE
    `is built to transport people only` IS TRUE
    `is suitable for land other than a railway` IS TRUE
    `has an electric motor` IS TRUE
    `is a bicycle` IS FALSE
    `is a trolley, inline skates or a wheeled toy` IS FALSE
    `is a prescribed type of motorised land vehicle` IS FALSE
    `assembly` IS `fully assembled`

