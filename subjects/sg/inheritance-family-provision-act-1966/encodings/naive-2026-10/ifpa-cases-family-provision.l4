IMPORT prelude
IMPORT `ifpa-family-provision`

-- Inheritance (Family Provision) Act 1966, ss 1 to 6 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_inheritance-family-provision-act-1966.py). Expected results were written by
-- hand from the text.

§ `fixtures`

`widow-of-60` MEANS Claimant WITH
    `relation` IS `a wife or husband`
    `age` IS 60
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`unmarried-daughter-of-45` MEANS Claimant WITH
    `relation` IS `a daughter`
    `age` IS 45
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`divorced-daughter-of-40` MEANS Claimant WITH
    `relation` IS `a daughter`
    `age` IS 40
    `has ever been married` IS TRUE
    `cannot maintain themself through mental or physical disability` IS FALSE

`widowed-daughter-disabled` MEANS Claimant WITH
    `relation` IS `a daughter`
    `age` IS 50
    `has ever been married` IS TRUE
    `cannot maintain themself through mental or physical disability` IS TRUE

`son-of-17` MEANS Claimant WITH
    `relation` IS `a son`
    `age` IS 17
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`son-of-20` MEANS Claimant WITH
    `relation` IS `a son`
    `age` IS 20
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`son-of-25` MEANS Claimant WITH
    `relation` IS `a son`
    `age` IS 25
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`disabled-son-of-35` MEANS Claimant WITH
    `relation` IS `a son`
    `age` IS 35
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS TRUE

`dependent-mother` MEANS Claimant WITH
    `relation` IS `a parent`
    `age` IS 80
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS TRUE

`disabled-brother` MEANS Claimant WITH
    `relation` IS `a sibling`
    `age` IS 50
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS TRUE

`divorced-wife` MEANS Claimant WITH
    `relation` IS `a former spouse`
    `age` IS 55
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`unadopted-stepdaughter` MEANS Claimant WITH
    `relation` IS `an unadopted stepchild`
    `age` IS 12
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS FALSE

`unmarried-disabled-daughter` MEANS Claimant WITH
    `relation` IS `a daughter`
    `age` IS 30
    `has ever been married` IS FALSE
    `cannot maintain themself through mental or physical disability` IS TRUE

`nothing-yet` MEANS `Later events` WITH
    `has died` IS FALSE
    `has married or remarried` IS FALSE
    `disability has ceased` IS FALSE
    `has turned 21` IS FALSE

`died` MEANS `Later events` WITH
    `has died` IS TRUE
    `has married or remarried` IS FALSE
    `disability has ceased` IS FALSE
    `has turned 21` IS FALSE

`married` MEANS `Later events` WITH
    `has died` IS FALSE
    `has married or remarried` IS TRUE
    `disability has ceased` IS FALSE
    `has turned 21` IS FALSE

`disability-ended` MEANS `Later events` WITH
    `has died` IS FALSE
    `has married or remarried` IS FALSE
    `disability has ceased` IS TRUE
    `has turned 21` IS FALSE

`married-and-disability-ended` MEANS `Later events` WITH
    `has died` IS FALSE
    `has married or remarried` IS TRUE
    `disability has ceased` IS TRUE
    `has turned 21` IS FALSE

`turned-21` MEANS `Later events` WITH
    `has died` IS FALSE
    `has married or remarried` IS FALSE
    `disability has ceased` IS FALSE
    `has turned 21` IS TRUE

§ `ss 1 and 3(1) -- whose estate`

#ASSERT `the Act applies to the estate` TRUE TRUE FALSE
#ASSERT NOT `the Act applies to the estate` TRUE TRUE TRUE
#ASSERT NOT `the Act applies to the estate` TRUE FALSE FALSE
#ASSERT NOT `the Act applies to the estate` FALSE TRUE FALSE

