#ASSERT NOT `the question is carried` 5 2 3 TRUE

§ `s 11(5)`

#ASSERT `the product is a health product` `a cough syrup sold to the public`
#ASSERT `the product is a health product` `a shampoo`
#ASSERT `the product is a health product` `an unlabelled pill likely to be swallowed`
#ASSERT NOT `the product is a health product` `a veterinary dewormer`
#ASSERT NOT `the product is a health product` `a kitchen knife`

#ASSERT `the item is a tobacco product` TRUE

§ `ss 12, 22, 41`

#ASSERT NOT `the Minister's approval is needed` `entering into a contract`
#ASSERT `the Minister's approval is needed` `acquiring property`
#ASSERT `the Minister's approval is needed` `forming a company or joint venture`
#ASSERT NOT `the Minister's approval is needed` `borrowing from the Government`
#ASSERT `the Minister's approval is needed` `borrowing from a bank`
#ASSERT `the Minister's approval is needed` `making regulations`

§ `s 16`

#ASSERT `a personal suit is barred` TRUE TRUE TRUE
#ASSERT NOT `a personal suit is barred` TRUE FALSE TRUE
#ASSERT NOT `a personal suit is barred` FALSE TRUE TRUE

#ASSERT `the Authority is shielded from liability for the information error` TRUE TRUE
#ASSERT NOT `the Authority is shielded from liability for the information error` FALSE TRUE

§ `s 18`

#ASSERT `the financial year beginning in` 2025 4 EQUALS 2025
#ASSERT `the financial year beginning in` 2026 3 EQUALS 2025

§ `s 38`

#ASSERT `the symbol offence is committed` TRUE TRUE FALSE
#ASSERT `the symbol offence is committed` TRUE FALSE TRUE
#ASSERT NOT `the symbol offence is committed` TRUE FALSE FALSE

§ `s 39`

#ASSERT `the secrecy offence is committed` `a former officer telling a journalist about a pending product approval`
#ASSERT NOT `the secrecy offence is committed` `an officer giving evidence under a court order`
#ASSERT NOT `the secrecy offence is committed` `an officer sharing data with a colleague for the job`
#ASSERT NOT `the secrecy offence is committed` `an officer reporting as another Act requires`
#ASSERT NOT `the secrecy offence is committed` `a member of the public repeating what was in the newspaper`

§ `ss 38(2), 39(2)`

#ASSERT `the maximum fine` `misusing the Authority's symbol` EQUALS 10000
#ASSERT `the maximum fine` `breaching secrecy` EQUALS 2000

#ASSERT `the maximum imprisonment in months` `misusing the Authority's symbol` EQUALS 6
#ASSERT `the maximum imprisonment in months` `breaching secrecy` EQUALS 12

§ `s 40`

#ASSERT `the composition is lawful` TRUE TRUE 1000
#ASSERT NOT `the composition is lawful` TRUE TRUE 1500
#ASSERT NOT `the composition is lawful` FALSE TRUE 500

#ASSERT `further proceedings are barred` TRUE TRUE
#ASSERT NOT `further proceedings are barred` TRUE FALSE

