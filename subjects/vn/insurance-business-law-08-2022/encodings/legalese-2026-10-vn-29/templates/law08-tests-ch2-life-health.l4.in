@lang en
IMPORT prelude
IMPORT daydate
IMPORT `law08-vintage`
IMPORT `law08-nouns`
IMPORT `law08-ch2-general`
IMPORT `law08-ch2-life-health`

-- Tests for Chuong II, Muc 2 (Dieu 33-42). Expected values from the cited lines.

§ `Tests: Chuong II, Muc 2`

§§ `Persons used in these tests`

@@fx `an ordinary adult` : `A person`
@@fx `a minor` : `A person` ; `is a minor` = TRUE
@@fx `an adult without capacity` : `A person` ; `has lost civil act capacity` = TRUE
@@fx `an adult with difficulty in cognition` : `A person` ; `has difficulty in cognition or in controlling behaviour` = TRUE
@@fx `an adult with limited capacity` : `A person` ; `has limited civil act capacity` = TRUE

§§ `Dieu 33`

@@q 744 746
#ASSERT `Dieu 33: the object of insurance of a life or health contract` `a life insurance contract` EQUALS `the life span and the life of a human being`
#ASSERT `Dieu 33: the object of insurance of a life or health contract` `a health insurance contract` EQUALS `the health of a human being`
#ASSERT REFUSED `Dieu 33: the object of insurance of a life or health contract` `a property insurance contract`

§§ `Dieu 34`

@@q 749 759
@ref Dieu 34 (src:749-759)
@@fx `the policyholder insures themself` : `The policyholder's relation to the insured person` ; `is the policyholder themself` = TRUE
@@fx `the policyholder insures a spouse` : `The policyholder's relation to the insured person` ; `is the policyholder's spouse, parent or child` = TRUE
@@fx `the policyholder insures a full sibling` : `The policyholder's relation to the insured person` ; `is the policyholder's full sibling or in a relation of fostering or maintenance with the policyholder` = TRUE
@@fx `the policyholder insures an employee` : `The policyholder's relation to the insured person` ; `has a financial interest or an employment relationship with the policyholder` = TRUE
@@fx `the policyholder insures a stranger who consented in writing` : `The policyholder's relation to the insured person` ; `agreed in writing to the policyholder buying health insurance for them` = TRUE
@@fx `the policyholder insures a stranger` : `The policyholder's relation to the insured person`
#ASSERT `Dieu 34: the policyholder has an insurable interest in the insured person` `the policyholder insures themself`
#ASSERT `Dieu 34: the policyholder has an insurable interest in the insured person` `the policyholder insures a spouse`
#ASSERT `Dieu 34: the policyholder has an insurable interest in the insured person` `the policyholder insures a full sibling`
#ASSERT `Dieu 34: the policyholder has an insurable interest in the insured person` `the policyholder insures an employee`
#ASSERT `Dieu 34: the policyholder has an insurable interest in the insured person` `the policyholder insures a stranger who consented in writing`
#ASSERT NOT `Dieu 34: the policyholder has an insurable interest in the insured person` `the policyholder insures a stranger`

§§ `Dieu 35`

@@q 760 769
@ref Dieu 35 (src:760-769)
@@fx `a one-year contract` : `A contract of insurance` ; `class of contract` = `a life insurance contract` ; `insurer` = `a life insurer` ; `policyholder` = `an ordinary adult` ; `insured person` = `an ordinary adult` ; `first day of the insurance term` = YMD 2025 1 1 ; `last day of the insurance term` = YMD 2026 1 1
@@fx `a contract one day over a year` : `A contract of insurance` ; `class of contract` = `a life insurance contract` ; `insurer` = `a life insurer` ; `policyholder` = `an ordinary adult` ; `insured person` = `an ordinary adult` ; `first day of the insurance term` = YMD 2025 1 1 ; `last day of the insurance term` = YMD 2026 1 2
@@fx `a ten-year property contract` : `A contract of insurance` ; `class of contract` = `a property insurance contract` ; `insurer` = `a non-life insurer` ; `policyholder` = `an ordinary adult` ; `insured person` = `an ordinary adult` ; `first day of the insurance term` = YMD 2025 1 1 ; `last day of the insurance term` = YMD 2035 1 1
@@fx `a refusal on day 21` : `A decision to withdraw` ; `date the policyholder received the contract` = YMD 2025 2 1 ; `date the policyholder refused to continue` = YMD 2025 2 22 ; `premium paid` = 10_000_000 ; `reasonable costs the contract allows to be deducted` = 1_000_000
@@fx `a refusal on day 22` : `A decision to withdraw` ; `date the policyholder received the contract` = YMD 2025 2 1 ; `date the policyholder refused to continue` = YMD 2025 2 23 ; `premium paid` = 10_000_000 ; `reasonable costs the contract allows to be deducted` = 1_000_000
@@fx `a refusal on the day of receipt` : `A decision to withdraw` ; `date the policyholder received the contract` = YMD 2025 2 1 ; `date the policyholder refused to continue` = YMD 2025 2 1 ; `premium paid` = 10_000_000
@@fx `a refusal before receipt` : `A decision to withdraw` ; `date the policyholder received the contract` = YMD 2025 2 1 ; `date the policyholder refused to continue` = YMD 2025 1 31 ; `premium paid` = 10_000_000
@@fx `a refusal with costs above the premium` : `A decision to withdraw` ; `date the policyholder received the contract` = YMD 2025 2 1 ; `date the policyholder refused to continue` = YMD 2025 2 5 ; `premium paid` = 10_000_000 ; `reasonable costs the contract allows to be deducted` = 11_000_000
#ASSERT NOT `Dieu 35: the contract has a term of more than one year` `a one-year contract`
#ASSERT `Dieu 35: the contract has a term of more than one year` `a contract one day over a year`
#ASSERT `Dieu 35: the last day to refuse to go on` `a refusal on day 21` EQUALS YMD 2025 2 22
#ASSERT `Dieu 35: the policyholder may refuse to go on` `a refusal on day 21` `a contract one day over a year`
#ASSERT NOT `Dieu 35: the policyholder may refuse to go on` `a refusal on day 22` `a contract one day over a year`
#ASSERT NOT `Dieu 35: the policyholder may refuse to go on` `a refusal on day 21` `a one-year contract`
#ASSERT `Dieu 35: the policyholder may refuse to go on` `a refusal on the day of receipt` `a contract one day over a year`
#ASSERT NOT `Dieu 35: the policyholder may refuse to go on` `a refusal before receipt` `a contract one day over a year`
#ASSERT `Dieu 35: the policyholder may refuse to go on` `a refusal on day 21` `a ten-year property contract`
#ASSERT `Dieu 35: the premium refunded on refusing to go on` `a refusal on day 21` `a contract one day over a year` EQUALS 9_000_000
#ASSERT `Dieu 35: the premium refunded on refusing to go on` `a refusal on the day of receipt` `a contract one day over a year` EQUALS 10_000_000
#ASSERT REFUSED `Dieu 35: the premium refunded on refusing to go on` `a refusal on day 22` `a contract one day over a year`
#ASSERT REFUSED `Dieu 35: the premium refunded on refusing to go on` `a refusal with costs above the premium` `a contract one day over a year`

§§ `Dieu 36`

@@q 771 776
@ref Dieu 36 (src:771-776)
@@fx `interim cover accepted on 10 March` : `Interim cover` ; `date the insurer received the request for insurance and the provisional premium` = YMD 2025 3 1 ; `date the insurer accepted or refused the insurance` = JUST (YMD 2025 3 10)
@@fx `interim cover ended earlier by agreement` : `Interim cover` ; `date the insurer received the request for insurance and the provisional premium` = YMD 2025 3 1 ; `date the insurer accepted or refused the insurance` = JUST (YMD 2025 3 10) ; `other event the parties agreed ends the cover` = JUST (YMD 2025 3 5)
@@fx `interim cover ended later by agreement` : `Interim cover` ; `date the insurer received the request for insurance and the provisional premium` = YMD 2025 3 1 ; `date the insurer accepted or refused the insurance` = JUST (YMD 2025 3 10) ; `other event the parties agreed ends the cover` = JUST (YMD 2025 3 20)
@@fx `interim cover ended by agreement only` : `Interim cover` ; `date the insurer received the request for insurance and the provisional premium` = YMD 2025 3 1 ; `other event the parties agreed ends the cover` = JUST (YMD 2025 3 20)
@@fx `interim cover still running` : `Interim cover` ; `date the insurer received the request for insurance and the provisional premium` = YMD 2025 3 1
#ASSERT `Dieu 36: the date interim cover begins` `interim cover accepted on 10 March` EQUALS YMD 2025 3 1
#ASSERT `Dieu 36: the date interim cover ends` `interim cover accepted on 10 March` EQUALS JUST (YMD 2025 3 10)
#ASSERT `Dieu 36: the date interim cover ends` `interim cover ended earlier by agreement` EQUALS JUST (YMD 2025 3 5)
#ASSERT `Dieu 36: the date interim cover ends` `interim cover ended later by agreement` EQUALS JUST (YMD 2025 3 10)
#ASSERT `Dieu 36: the date interim cover ends` `interim cover ended by agreement only` EQUALS JUST (YMD 2025 3 20)
#ASSERT `Dieu 36: the date interim cover ends` `interim cover still running` EQUALS NOTHING

§§ `Dieu 37`

@@q 780 791
@ref Dieu 37 (src:780-791)
@@fx `instalments with the next one unpayable` : `The payment of life insurance premium` ; `premium is paid by instalments` = TRUE ; `some instalments have been paid` = TRUE ; `the policyholder cannot pay the next instalments` = TRUE ; `date the grace period began` = YMD 2025 5 1
@@fx `a single premium` : `The payment of life insurance premium`
@@fx `a restoration on the last day of the second year` : `The payment of life insurance premium` ; `date the contract was terminated under Dieu 26(1)` = YMD 2025 5 1 ; `date the parties agreed to restore the contract` = YMD 2027 5 1 ; `the missing premium has been paid` = TRUE
@@fx `a restoration a day too late` : `The payment of life insurance premium` ; `date the contract was terminated under Dieu 26(1)` = YMD 2025 5 1 ; `date the parties agreed to restore the contract` = YMD 2027 5 2 ; `the missing premium has been paid` = TRUE
@@fx `a restoration without the missing premium` : `The payment of life insurance premium` ; `date the contract was terminated under Dieu 26(1)` = YMD 2025 5 1 ; `date the parties agreed to restore the contract` = YMD 2026 1 1
@@fx `an unauthorised deduction` : `The payment of life insurance premium` ; `the insurer deducted unpaid premium from the surrender value` = TRUE
@@fx `an agreed deduction` : `The payment of life insurance premium` ; `the insurer deducted unpaid premium from the surrender value` = TRUE ; `the policyholder agreed to the deduction` = TRUE
@@fx `a suit for premium` : `The payment of life insurance premium` ; `the insurer sued for the premium` = TRUE
@@fx `nothing done to recover` : `The payment of life insurance premium`
#ASSERT `Dieu 37(2): the last day of the grace period` `instalments with the next one unpayable` EQUALS YMD 2025 6 30
#ASSERT REFUSED `Dieu 37(2): the last day of the grace period` `a single premium`
#ASSERT `Dieu 37(3): the contract may be restored` `a restoration on the last day of the second year`
#ASSERT NOT `Dieu 37(3): the contract may be restored` `a restoration a day too late`
#ASSERT NOT `Dieu 37(3): the contract may be restored` `a restoration without the missing premium`
#ASSERT `Dieu 37(4): the insurer's recovery of the premium breaches Dieu 37(4)` `an unauthorised deduction` FALSE
#ASSERT NOT `Dieu 37(4): the insurer's recovery of the premium breaches Dieu 37(4)` `an agreed deduction` FALSE
#ASSERT `Dieu 37(4): the insurer's recovery of the premium breaches Dieu 37(4)` `a suit for premium` FALSE
#ASSERT NOT `Dieu 37(4): the insurer's recovery of the premium breaches Dieu 37(4)` `a suit for premium` TRUE
#ASSERT NOT `Dieu 37(4): the insurer's recovery of the premium breaches Dieu 37(4)` `an unauthorised deduction` TRUE
#ASSERT NOT `Dieu 37(4): the insurer's recovery of the premium breaches Dieu 37(4)` `nothing done to recover` FALSE

§§ `Dieu 38`

@@q 793 802
@ref Dieu 38 (src:793-802)
@@fx `a death caused by a third person` : `A death or injury of the insured person` ; `a third person caused it directly or indirectly` = TRUE
@@fx `a death by illness` : `A death or injury of the insured person`
#ASSERT NOT `Dieu 38: the insurer may claim reimbursement from the third person` `a death caused by a third person`
#ASSERT REFUSED `Dieu 38: the insurer may claim reimbursement from the third person` `a death by illness`

§§ `Dieu 39`

@@q 805 814
@ref Dieu 39 (src:805-814)
@@fx `an adult who agreed in writing` : `A contract on the death of another` ; `person` = `an ordinary adult` ; `the person agreed in writing` = TRUE ; `the writing states the sum insured and the beneficiary` = TRUE
@@fx `an adult who agreed but the writing omits the sum` : `A contract on the death of another` ; `person` = `an ordinary adult` ; `the person agreed in writing` = TRUE
@@fx `an adult who did not agree` : `A contract on the death of another` ; `person` = `an ordinary adult` ; `the writing states the sum insured and the beneficiary` = TRUE
@@fx `a minor whose parent agreed` : `A contract on the death of another` ; `person` = `a minor` ; `a parent or guardian agreed in writing` = TRUE ; `the writing states the sum insured and the beneficiary` = TRUE
@@fx `a minor whose parent did not agree` : `A contract on the death of another` ; `person` = `a minor` ; `the person agreed in writing` = TRUE ; `the writing states the sum insured and the beneficiary` = TRUE
@@fx `a person without capacity who agreed` : `A contract on the death of another` ; `person` = `an adult without capacity` ; `the person agreed in writing` = TRUE ; `a parent or guardian agreed in writing` = TRUE ; `the writing states the sum insured and the beneficiary` = TRUE
@@fx `a person with difficulty in cognition who agreed` : `A contract on the death of another` ; `person` = `an adult with difficulty in cognition` ; `the person agreed in writing` = TRUE ; `the writing states the sum insured and the beneficiary` = TRUE
@@fx `a person with limited capacity who agreed` : `A contract on the death of another` ; `person` = `an adult with limited capacity` ; `the person agreed in writing` = TRUE ; `the writing states the sum insured and the beneficiary` = TRUE
#ASSERT `Dieu 39: the contract on the death of another may be made` `an adult who agreed in writing`
#ASSERT NOT `Dieu 39: the contract on the death of another may be made` `an adult who agreed but the writing omits the sum`
#ASSERT NOT `Dieu 39: the contract on the death of another may be made` `an adult who did not agree`
#ASSERT `Dieu 39: the contract on the death of another may be made` `a minor whose parent agreed`
#ASSERT NOT `Dieu 39: the contract on the death of another may be made` `a minor whose parent did not agree`
#ASSERT NOT `Dieu 39: the contract on the death of another may be made` `a person without capacity who agreed`
#ASSERT NOT `Dieu 39: the contract on the death of another may be made` `a person with difficulty in cognition who agreed`
#ASSERT NOT `Dieu 39: the contract on the death of another may be made` `a person with limited capacity who agreed`

§§ `Dieu 40`

@@q 816 840
@ref Dieu 40 (src:816-840)
@@fx `a suicide on the last day of the second year` : `A death or injury of the insured person` ; `the insured person died by suicide` = TRUE ; `date of the first premium payment or of the restoration of the contract` = YMD 2023 3 1 ; `date of death` = YMD 2025 3 1 ; `surrender value or premium paid, less reasonable costs` = 4_000_000
@@fx `a suicide a day after the second year` : `A death or injury of the insured person` ; `the insured person died by suicide` = TRUE ; `date of the first premium payment or of the restoration of the contract` = YMD 2023 3 1 ; `date of death` = YMD 2025 3 2
@@fx `a death by the policyholder's deliberate fault` : `A death or injury of the insured person` ; `died through the deliberate fault of the policyholder` = TRUE
@@fx `a disability by the insured person's own deliberate fault` : `A death or injury of the insured person` ; `suffered permanent disability through the insured person's own deliberate fault` = TRUE
@@fx `a disability by the policyholder's deliberate fault` : `A death or injury of the insured person` ; `suffered permanent disability through the deliberate fault of the policyholder` = TRUE
@@fx `an execution` : `A death or injury of the insured person` ; `died by execution of a death sentence` = TRUE
@@fx `an excluded case` : `A death or injury of the insured person` ; `the contract excludes the case` = TRUE
@@fx `a sole beneficiary who killed the insured person` : `A death or injury of the insured person` ; `died through the deliberate fault of a beneficiary` = TRUE ; `surrender value or premium paid, less reasonable costs` = 6_000_000 ; `the policyholder is dead` = TRUE
@@fx `one of several beneficiaries who killed the insured person` : `A death or injury of the insured person` ; `died through the deliberate fault of a beneficiary` = TRUE ; `the beneficiary who caused it is one among several` = TRUE
@@fx `an accident` : `A death or injury of the insured person` ; `date of death` = YMD 2025 3 1
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `a suicide on the last day of the second year` FALSE
#ASSERT NOT `Dieu 40(1): the insurer need not pay the claimant` `a suicide a day after the second year` FALSE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `a death by the policyholder's deliberate fault` FALSE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `a disability by the insured person's own deliberate fault` FALSE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `a disability by the policyholder's deliberate fault` FALSE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `an execution` FALSE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `an excluded case` FALSE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `a sole beneficiary who killed the insured person` TRUE
#ASSERT `Dieu 40(1): the insurer need not pay the claimant` `one of several beneficiaries who killed the insured person` TRUE
#ASSERT NOT `Dieu 40(1): the insurer need not pay the claimant` `one of several beneficiaries who killed the insured person` FALSE
#ASSERT NOT `Dieu 40(1): the insurer need not pay the claimant` `an accident` FALSE
#ASSERT `Dieu 40(3): the amount the insurer must return to the policyholder` `a suicide on the last day of the second year` EQUALS 4_000_000
#ASSERT REFUSED `Dieu 40(3): the amount the insurer must return to the policyholder` `an accident`
#ASSERT `Dieu 40(3): the amount returned is settled under the law on inheritance` `a sole beneficiary who killed the insured person`
#ASSERT NOT `Dieu 40(3): the amount returned is settled under the law on inheritance` `a suicide on the last day of the second year`

§§ `Dieu 41`

@@q 842 865
@ref Dieu 41 (src:842-865)
@@fx `a policyholder insuring themself and designating` : `A designation of a beneficiary` ; `the policyholder is also the insured person` = TRUE
@@fx `a policyholder designating with the insured's consent` : `A designation of a beneficiary` ; `the insured person agreed in writing` = TRUE
@@fx `a policyholder designating without the insured's consent` : `A designation of a beneficiary`
@@fx `a designation in a group contract` : `A designation of a beneficiary` ; `is a group contract` = TRUE ; `the policyholder is also the insured person` = TRUE
@@fx `a designation for a minor without the representative` : `A designation of a beneficiary` ; `the insured person agreed in writing` = TRUE ; `the insured person is a minor or lacks or has limited capacity or has difficulty in cognition` = TRUE
@@fx `a designation for a minor with the representative` : `A designation of a beneficiary` ; `the insured person agreed in writing` = TRUE ; `the insured person is a minor or lacks or has limited capacity or has difficulty in cognition` = TRUE ; `the legal representative agreed` = TRUE
@@fx `three beneficiaries with no order` : `A designation of a beneficiary` ; `number of beneficiaries` = 3
@@fx `three beneficiaries with fixed proportions` : `A designation of a beneficiary` ; `number of beneficiaries` = 3 ; `an order or proportions were fixed` = TRUE
@@fx `no beneficiary` : `A designation of a beneficiary`
@@fx `a valid change` : `A designation of a beneficiary` ; `the insured person agreed in writing` = TRUE ; `the policyholder notified the insurer in writing` = TRUE
@@fx `a change without notice` : `A designation of a beneficiary` ; `the insured person agreed in writing` = TRUE
@@fx `a change without the insured's consent` : `A designation of a beneficiary` ; `the policyholder notified the insurer in writing` = TRUE
@@fx `a change for a minor without the representative` : `A designation of a beneficiary` ; `the insured person agreed in writing` = TRUE ; `the policyholder notified the insurer in writing` = TRUE ; `the insured person is a minor or lacks or has limited capacity or has difficulty in cognition` = TRUE
#ASSERT `Dieu 41(1): the designation of the beneficiary is valid` `a policyholder insuring themself and designating`
#ASSERT `Dieu 41(1): the designation of the beneficiary is valid` `a policyholder designating with the insured's consent`
#ASSERT NOT `Dieu 41(1): the designation of the beneficiary is valid` `a policyholder designating without the insured's consent`
#ASSERT NOT `Dieu 41(1): the designation of the beneficiary is valid` `a designation in a group contract`
#ASSERT NOT `Dieu 41(1): the designation of the beneficiary is valid` `a designation for a minor without the representative`
#ASSERT `Dieu 41(1): the designation of the beneficiary is valid` `a designation for a minor with the representative`
#ASSERT `Dieu 41(2): the share of each beneficiary` `three beneficiaries with no order` EQUALS 1 / 3
#ASSERT REFUSED `Dieu 41(2): the share of each beneficiary` `three beneficiaries with fixed proportions`
#ASSERT REFUSED `Dieu 41(2): the share of each beneficiary` `no beneficiary`
#ASSERT `Dieu 41(3): the change of the beneficiary is valid` `a valid change`
#ASSERT NOT `Dieu 41(3): the change of the beneficiary is valid` `a change without notice`
#ASSERT NOT `Dieu 41(3): the change of the beneficiary is valid` `a change without the insured's consent`
#ASSERT NOT `Dieu 41(3): the change of the beneficiary is valid` `a change for a minor without the representative`
#ASSERT `Dieu 41(3): the insurer must confirm the change` `a valid change`
#ASSERT NOT `Dieu 41(3): the insurer must confirm the change` `a change without notice`

§§ `Dieu 42`

@@q 867 887
@ref Dieu 42 (src:867-887)
@@fx `a group formed for work` : `A group contract` ; `the group was formed for a purpose other than taking part in insurance` = TRUE ; `the contract states the conditions of joining` = TRUE ; `the contract states the conditions and procedure of converting to an individual contract` = TRUE
@@fx `a group formed to buy insurance` : `A group contract` ; `the contract states the conditions of joining` = TRUE
@@fx `a group where a member left` : `A group contract` ; `at least one insured person is no longer a member of the group` = TRUE
@@fx `a group where a premium was not paid` : `A group contract` ; `the premium for an insured person was not paid as the contract agrees` = TRUE
@@fx `a group with another agreed case` : `A group contract` ; `the contract agrees another case for amending it` = TRUE
@@fx `a group with no ground to amend` : `A group contract`
#ASSERT `Dieu 42(2): the group may take part in a group contract` `a group formed for work`
#ASSERT NOT `Dieu 42(2): the group may take part in a group contract` `a group formed to buy insurance`
#ASSERT `Dieu 42(5): the parties may amend the group contract` `a group where a member left`
#ASSERT `Dieu 42(5): the parties may amend the group contract` `a group where a premium was not paid`
#ASSERT `Dieu 42(5): the parties may amend the group contract` `a group with another agreed case`
#ASSERT NOT `Dieu 42(5): the parties may amend the group contract` `a group with no ground to amend`
#ASSERT `Dieu 42(6): the group contract has the additional contents` `a group formed for work`
#ASSERT NOT `Dieu 42(6): the group contract has the additional contents` `a group formed to buy insurance`
