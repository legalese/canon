    <literalExpression id="decision_the_court_may_extend_the_specified_period_literal">
      <text>o.the_Commission_applies_for_the_extension and (o.the_supplier_or_individual_has_failed_to_comply_with_an_order and o.the_aggregate_in_years_of_the_specified_period_and_all_extensions &lt;= (if o.the_period_in_years_that_the_Minister_has_prescribed_in_place_of_10_years != null then o.the_period_in_years_that_the_Minister_has_prescribed_in_place_of_10_years else 10))</text>
    </literalExpression>
  </decision>
