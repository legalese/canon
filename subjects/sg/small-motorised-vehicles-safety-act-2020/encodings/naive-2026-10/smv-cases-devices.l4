#ASSERT `the maximum fine for unapproved import` TRUE TRUE EQUALS 10000
#ASSERT `the maximum fine for unapproved import` FALSE FALSE EQUALS 10000
#ASSERT `the maximum fine for unapproved import` FALSE TRUE EQUALS 20000

#ASSERT `the maximum months for unapproved import` FALSE TRUE EQUALS 0

§ `ss 8A, 8B`

#ASSERT `keeping is an offence` TRUE TRUE FALSE
#ASSERT NOT `keeping is an offence` TRUE FALSE FALSE

#ASSERT `the maximum fine for keeping an unsafe device` TRUE FALSE EQUALS 2000
#ASSERT `the maximum fine for keeping an unsafe device` FALSE FALSE EQUALS 4000

#ASSERT `the maximum months for keeping an unsafe device` TRUE TRUE EQUALS 6

#ASSERT `who is presumed to keep the device` TRUE TRUE TRUE FALSE EQUALS `the registered owner`
#ASSERT `who is presumed to keep the device` FALSE TRUE TRUE FALSE EQUALS `the person in immediate possession`
#ASSERT `who is presumed to keep the device` FALSE FALSE TRUE FALSE EQUALS `the occupier of the premises`
#ASSERT `who is presumed to keep the device` FALSE FALSE TRUE TRUE EQUALS `no one is presumed`

