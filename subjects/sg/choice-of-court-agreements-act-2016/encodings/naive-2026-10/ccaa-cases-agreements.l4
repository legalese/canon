§ `s 2(2), (3)`

#ASSERT `the designation includes the SICC` `the High Court` FALSE
#ASSERT NOT `the designation includes the SICC` `the High Court` TRUE
#ASSERT `the designation includes the SICC` `the General Division of the High Court` FALSE

§ `s 2(1) and s 10`

#ASSERT `the route under Part 3` `a consent order` EQUALS `recognition and enforcement as a judgment`
#ASSERT `the route under Part 3` `a settlement contract recorded by the court` EQUALS `enforcement as a judicial settlement`
#ASSERT `the route under Part 3` `an interim injunction` EQUALS `not under this Act`

§ `s 3`

#ASSERT `the agreement is exclusive` `Singapore clause, cross-border supply`
#ASSERT `the agreement is exclusive` `clause silent on exclusivity`
#ASSERT NOT `the agreement is exclusive` `clause expressly non-exclusive`
#ASSERT NOT `the agreement is exclusive` `oral clause`

§ `ss 4(1), 6`

#ASSERT `the case is international for Part 2` `Singapore clause, cross-border supply`
#ASSERT NOT `the case is international for Part 2` `purely domestic case`
#ASSERT `the case is international for Part 2` `same residence, foreign goods`

#ASSERT `the company resides in the State` FALSE FALSE FALSE TRUE
#ASSERT `the company resides in the State` FALSE TRUE FALSE FALSE

§ `s 5`

#ASSERT NOT `the clause can be held invalid` TRUE FALSE
#ASSERT `the clause can be held invalid` FALSE TRUE

§ `ss 9, 10, 24`

#ASSERT `the matter is excluded` `a contract with a consumer` TRUE
#ASSERT `the matter is excluded` `an arbitration` FALSE
#ASSERT `the matter is excluded` `a personal injury claim` FALSE
#ASSERT NOT `the matter is excluded` `a personal injury claim` TRUE
#ASSERT NOT `the matter is excluded` `the validity of a copyright` FALSE
#ASSERT `the matter is excluded` `the validity of a patent` FALSE

#ASSERT `the Act applies` `Singapore clause, cross-border supply`
#ASSERT NOT `the Act applies` `clause expressly non-exclusive`
#ASSERT NOT `the Act applies` `purely domestic case`
#ASSERT NOT `the Act applies` `consumer purchase`
#ASSERT NOT `the Act applies` `employment contract`
#ASSERT `the Act applies` `patent licence breach`
#ASSERT `the Act applies` `insolvency raised as a defence`
#ASSERT NOT `the Act applies` `insolvency claim`
#ASSERT NOT `the Act applies` `Singapore clause of 2015`
#ASSERT `the Act applies` `foreign clause of 2015, Convention already in force there`
#ASSERT NOT `the Act applies` `foreign clause before the Convention bound that State`

§ `s 11`

#ASSERT `the Singapore court must hear the dispute` `Singapore clause, cross-border supply` FALSE
#ASSERT NOT `the Singapore court must hear the dispute` `Singapore clause, cross-border supply` TRUE

§ `s 12`

#ASSERT `the Singapore court must stay or dismiss` `foreign clause, cross-border supply` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `the Singapore court must stay or dismiss` `foreign clause, cross-border supply` FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT `the Singapore court must stay or dismiss` `interim injunction, foreign clause` FALSE FALSE FALSE FALSE FALSE

§ `ss 13 to 16`

#ASSERT `what the General Division must do` `clean judgment` EQUALS `must recognise and enforce`
#ASSERT `what the General Division must do` `judgment not enforceable at origin` EQUALS `must recognise but not enforce`
#ASSERT `what the General Division must do` `judgment with no effect at origin` EQUALS `must refuse`
#ASSERT `what the General Division must do` `judgment of a non-chosen court` EQUALS `outside Part 3`
#ASSERT `what the General Division must do` `judgment on late notice` EQUALS `must refuse`
#ASSERT `what the General Division must do` `judgment on late notice not challenged` EQUALS `must recognise and enforce`
#ASSERT `what the General Division must do` `judgment got by procedural fraud` EQUALS `must refuse`
#ASSERT `what the General Division must do` `judgment on a void clause` EQUALS `may refuse`
#ASSERT `what the General Division must do` `judgment on a void clause upheld at origin` EQUALS `must recognise and enforce`
#ASSERT `what the General Division must do` `judgment for punitive damages` EQUALS `may refuse`
#ASSERT `what the General Division must do` `judgment under appeal` EQUALS `may refuse`

§ `s 20`

#ASSERT `what the General Division must do with the settlement` TRUE TRUE FALSE FALSE EQUALS `must enforce the settlement`
#ASSERT `what the General Division must do with the settlement` TRUE FALSE FALSE FALSE EQUALS `must refuse`
#ASSERT `what the General Division must do with the settlement` TRUE TRUE TRUE FALSE EQUALS `must refuse`
#ASSERT `what the General Division must do with the settlement` TRUE TRUE FALSE TRUE EQUALS `may refuse`

