    `known or ought to be known to the assured` IS TRUE
    `disclosed` IS FALSE
    `the insurer asked about it` IS FALSE
    `it diminishes the risk` IS TRUE
    `known or presumed known to the insurer` IS FALSE
    `information waived by the insurer` IS FALSE
    `superfluous because of a warranty` IS FALSE

