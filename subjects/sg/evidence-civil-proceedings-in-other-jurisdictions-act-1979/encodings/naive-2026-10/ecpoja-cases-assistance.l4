    `privileged in the requesting country's civil proceedings` IS TRUE
    `the foreign privilege is supported by a statement in the request` IS TRUE
    `any conditions on that statement are fulfilled` IS FALSE
    `the foreign privilege is conceded by the applicant` IS FALSE
    `giving it would prejudice the security of Singapore` IS FALSE
    `the Minister has certified prejudice to security` IS FALSE

`a foreign privilege conceded by the applicant` MEANS Claim WITH
    `privileged in Singapore civil proceedings` IS FALSE
    `privileged in the requesting country's civil proceedings` IS TRUE
    `the foreign privilege is supported by a statement in the request` IS FALSE
    `any conditions on that statement are fulfilled` IS FALSE
    `the foreign privilege is conceded by the applicant` IS TRUE
    `giving it would prejudice the security of Singapore` IS FALSE
    `the Minister has certified prejudice to security` IS FALSE

`a foreign privilege neither supported nor conceded` MEANS Claim WITH
    `privileged in Singapore civil proceedings` IS FALSE
    `privileged in the requesting country's civil proceedings` IS TRUE
    `the foreign privilege is supported by a statement in the request` IS FALSE
    `any conditions on that statement are fulfilled` IS FALSE
    `the foreign privilege is conceded by the applicant` IS FALSE
    `giving it would prejudice the security of Singapore` IS FALSE
    `the Minister has certified prejudice to security` IS FALSE

`a Minister's security certificate` MEANS Claim WITH
    `privileged in Singapore civil proceedings` IS FALSE
    `privileged in the requesting country's civil proceedings` IS FALSE
    `the foreign privilege is supported by a statement in the request` IS FALSE
    `any conditions on that statement are fulfilled` IS FALSE
    `the foreign privilege is conceded by the applicant` IS FALSE
    `giving it would prejudice the security of Singapore` IS FALSE
    `the Minister has certified prejudice to security` IS TRUE

`prejudice to security without a certificate` MEANS Claim WITH
    `privileged in Singapore civil proceedings` IS FALSE
    `privileged in the requesting country's civil proceedings` IS FALSE
    `the foreign privilege is supported by a statement in the request` IS FALSE
    `any conditions on that statement are fulfilled` IS FALSE
    `the foreign privilege is conceded by the applicant` IS FALSE
    `giving it would prejudice the security of Singapore` IS TRUE
    `the Minister has certified prejudice to security` IS FALSE

`a supporting statement with no foreign privilege` MEANS Claim WITH
    `privileged in Singapore civil proceedings` IS FALSE
    `privileged in the requesting country's civil proceedings` IS FALSE
    `the foreign privilege is supported by a statement in the request` IS TRUE
    `any conditions on that statement are fulfilled` IS TRUE
