    `holding the device in hand` IS TRUE
    `operating any of its functions` IS TRUE
    `the vehicle is moving on a public path` IS FALSE
    `the vehicle is driving itself` IS FALSE
    `the device is a wearable worn as the manufacturer intended` IS FALSE

