IMPORT prelude
IMPORT `ec-act`
IMPORT `ec-death-and-transfer`

-- Executive Condominium Housing Scheme Act 1996, ss 3, 4, 8 and 10 to 13
-- -- worked cases.

§ `3 -- how little of the scheme is in the Act`

-- Income, family size, citizenship and other property holdings -- the things an
-- applicant would call "the eligibility rules" -- are all left to regulations.
#ASSERT `the matter is left to regulations rather than stated in the Act` `qualifications as to income`
#ASSERT `the matter is left to regulations rather than stated in the Act` `the minimum size of the family`
#ASSERT `the matter is left to regulations rather than stated in the Act` `citizenship of the purchasers`
#ASSERT `the matter is left to regulations rather than stated in the Act` `ownership of any other properties`
#ASSERT NOT `the matter is left to regulations rather than stated in the Act` `something stated in the Act itself`

-- s 3(2)(c): the prescribed penalty is payable IN LIEU OF action under s 5 or
-- s 9, so paying it displaces losing the home rather than adding to it.
#ASSERT `action under section 5 or 9 is displaced by payment of the penalty` TRUE TRUE
#ASSERT NOT `action under section 5 or 9 is displaced by payment of the penalty` TRUE FALSE
#ASSERT NOT `action under section 5 or 9 is displaced by payment of the penalty` FALSE TRUE

§ `4 -- gazetting is a condition`

#ASSERT `the developer is duly appointed` TRUE TRUE
#ASSERT NOT `the developer is duly appointed` TRUE FALSE

§ `8 -- death of the owner, and the three clocks`

GIVEN `within 10 years` IS A BOOLEAN, `consent` IS A BOOLEAN, `rep in 12m` IS A BOOLEAN
    , `applied in 6m` IS A BOOLEAN, `effected in time` IS A BOOLEAN, `refused` IS A BOOLEAN
GIVETH A DeathOfOwner
DECIDE `a death` `within 10 years` `consent` `rep in 12m` `applied in 6m` `effected in time` `refused` IS
    DeathOfOwner WITH
        `the owner has died` IS TRUE
        `the death or transfer is within 10 years of the temporary occupation permit` IS `within 10 years`
        `the Minister gave prior written consent to the transmission or transfer` IS `consent`
        `representation was taken out within 12 months from the death` IS `rep in 12m`
        `the personal representatives applied for consent within 6 months from the date of representation` IS `applied in 6m`
        `the transmission or transfer was effected within the period the Minister specified` IS `effected in time`
        `the Minister refused consent` IS `refused`
        `written notice of the intention to lodge was served` IS TRUE
        `the notice stated the compensation and a lodging date at least 28 days after service` IS TRUE

-- s 8(1): no registration without the Minister's prior written consent. A will
-- makes no difference -- the section catches testate and intestate alike.
#ASSERT `the transmission may not be registered` (`a death` TRUE FALSE TRUE TRUE TRUE FALSE)
#ASSERT NOT `the transmission may not be registered` (`a death` TRUE TRUE TRUE TRUE TRUE FALSE)
-- Outside the 10 years, s 8 does not apply at all.
#ASSERT NOT `the transmission may not be registered` (`a death` FALSE FALSE TRUE TRUE TRUE FALSE)

-- THE THREE CLOCKS. Each is independent, and a family can comply with one and
-- lose the home on the next.
--
-- (a) no representation within 12 months.
#ASSERT `limb (a) of section 8(3) is made out` (`a death` TRUE FALSE FALSE TRUE TRUE FALSE)
#ASSERT `the Minister may lodge an instrument vesting the home in the Board` (`a death` TRUE FALSE FALSE TRUE TRUE FALSE)

-- (b) PROMPT PROBATE, LATE LETTER. Representation taken out well within the
-- 12 months, then more than 6 months before applying for consent. Limb (a) is
-- satisfied and the home is still lost.
#ASSERT NOT `limb (a) of section 8(3) is made out` (`a death` TRUE FALSE TRUE FALSE TRUE FALSE)
#ASSERT `limb (b) of section 8(3) is made out` (`a death` TRUE FALSE TRUE FALSE TRUE FALSE)
#ASSERT `the Minister may lodge an instrument vesting the home in the Board` (`a death` TRUE FALSE TRUE FALSE TRUE FALSE)

-- (c) consent obtained, transfer not effected in the period specified.
#ASSERT `limb (c) of section 8(3) is made out` (`a death` TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT `the Minister may lodge an instrument vesting the home in the Board` (`a death` TRUE TRUE TRUE TRUE FALSE FALSE)

-- Everything done in time, consent given, transfer effected: no ground.
#ASSERT NOT `the Minister may lodge an instrument vesting the home in the Board` (`a death` TRUE TRUE TRUE TRUE TRUE FALSE)

-- s 8(2): a refusal of consent is a ground on its own, independent of the clocks.
#ASSERT `the Minister may lodge an instrument vesting the home in the Board` (`a death` TRUE FALSE TRUE TRUE TRUE TRUE)

-- s 8(4): the notice requirements gate the lodging.
`a death with no notice served` MEANS DeathOfOwner WITH
    `the owner has died` IS TRUE
    `the death or transfer is within 10 years of the temporary occupation permit` IS TRUE
    `the Minister gave prior written consent to the transmission or transfer` IS FALSE
    `representation was taken out within 12 months from the death` IS FALSE
    `the personal representatives applied for consent within 6 months from the date of representation` IS FALSE
    `the transmission or transfer was effected within the period the Minister specified` IS FALSE
    `the Minister refused consent` IS FALSE
    `written notice of the intention to lodge was served` IS FALSE
    `the notice stated the compensation and a lodging date at least 28 days after service` IS FALSE

#ASSERT `the Minister may lodge an instrument vesting the home in the Board` `a death with no notice served`
#ASSERT NOT `the Minister may lawfully lodge the instrument now` `a death with no notice served`
#ASSERT `the Minister may lawfully lodge the instrument now` (`a death` TRUE FALSE FALSE TRUE TRUE FALSE)

-- s 8(5): registration overreaches the mortgage. The lender's security goes
-- with the family's title.
#ASSERT `any mortgage, charge or assurance is overreached and cancelled` TRUE
#ASSERT NOT `any mortgage, charge or assurance is overreached and cancelled` FALSE

§ `10 -- the premium with no stated amount`

#ASSERT `a premium is payable to the Board under section 10` TRUE TRUE
#ASSERT NOT `a premium is payable to the Board under section 10` FALSE TRUE
#ASSERT NOT `a premium is payable to the Board under section 10` TRUE FALSE

§ `11 -- service, including by pinning a notice to the door`

#ASSERT `service is deemed to have been effected` `registered post to the last known address`
#ASSERT `service is deemed to have been effected` `affixed on a conspicuous part of the housing accommodation`
#ASSERT NOT `service is deemed to have been effected` `some other method`

-- s 11(2): and addressed to nobody by name.
#ASSERT `the notice is properly addressed under section 11(2)` TRUE

§ `12 -- good faith alone`

#ASSERT `no suit lies under section 12` `the Board` TRUE TRUE
#ASSERT `no suit lies under section 12` `a public officer` TRUE TRUE
#ASSERT NOT `no suit lies under section 12` `the Board` FALSE TRUE
#ASSERT NOT `no suit lies under section 12` `the Board` TRUE FALSE
#ASSERT NOT `no suit lies under section 12` `someone outside the section 12 list` TRUE TRUE

-- GOOD FAITH IS THE ONLY TEST. There is no reasonable-care limb, so an honest
-- but negligent decision is protected. Compare s 19(1) of the Silver Support
-- Scheme Act 2015, which requires good faith AND reasonable care.

§ `13 -- transfer to a non-citizen`

#ASSERT `the transfer is forbidden by section 13(1)` FALSE FALSE
#ASSERT NOT `the transfer is forbidden by section 13(1)` TRUE FALSE
#ASSERT NOT `the transfer is forbidden by section 13(1)` FALSE TRUE
