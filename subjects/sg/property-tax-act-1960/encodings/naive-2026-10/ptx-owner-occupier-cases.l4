IMPORT prelude
IMPORT `ptx-owner-occupier`

-- Property Tax (Rates for Residential Premises) Order 2013, and the earlier owner-occupier rates as IRAS publishes them --
-- worked cases. Every assertion is a claim about the ENCODING, not the law.

§ `REQ-0010 (cradle-to-grave-simone e072)`

-- An owner-occupied HDB flat with an annual value of $12,000 for 2032: nil (0% on the first $12,000).
#ASSERT `the owner-occupier property tax` 12000 2032 EQUALS 0

§ `IRAS worked examples (tax for 2026 on the rates from 1 January 2025)`

#ASSERT `the owner-occupier property tax` 12000 2026 EQUALS 0
#ASSERT `the owner-occupier property tax` 36000 2026 EQUALS 960
#ASSERT `the owner-occupier property tax` 84000 2026 EQUALS 5480

§ `The cumulative column of each IRAS table`

#ASSERT `the owner-occupier property tax` 40000 2025 EQUALS 1120
#ASSERT `the owner-occupier property tax` 50000 2025 EQUALS 1720
#ASSERT `the owner-occupier property tax` 75000 2025 EQUALS 4220
#ASSERT `the owner-occupier property tax` 85000 2025 EQUALS 5620
#ASSERT `the owner-occupier property tax` 100000 2025 EQUALS 8620
#ASSERT `the owner-occupier property tax` 140000 2025 EQUALS 19020
#ASSERT `the owner-occupier property tax` 150000 2025 EQUALS 22220

#ASSERT `the owner-occupier property tax` 30000 2024 EQUALS 880
#ASSERT `the owner-occupier property tax` 55000 2024 EQUALS 2980
#ASSERT `the owner-occupier property tax` 100000 2024 EQUALS 11980

#ASSERT `the owner-occupier property tax` 40000 2023 EQUALS 1380
#ASSERT `the owner-occupier property tax` 100000 2023 EQUALS 8730

#ASSERT `the owner-occupier property tax` 55000 2020 EQUALS 1880
#ASSERT `the owner-occupier property tax` 130000 2022 EQUALS 9380

§ `The same flat in earlier years`

-- $12,000 in 2024: 4% on $4,000 above $8,000 = $160; the same in 2015 to 2023.
#ASSERT `the owner-occupier property tax` 12000 2024 EQUALS 160
#ASSERT `the owner-occupier property tax` 12000 2023 EQUALS 160
#ASSERT `the owner-occupier property tax` 12000 2018 EQUALS 160
#ASSERT `the owner-occupier property tax` 8000 2024 EQUALS 0

§ `Fixtures`

GIVEN `two homes` IS A BOOLEAN, chosen IS A BOOLEAN, satisfied IS A BOOLEAN
GIVETH A Premises
`a home occupied by its owner` `two homes` chosen satisfied MEANS
    Premises WITH
        `owner named in the Valuation List` IS TRUE
        `principally occupied by the owner` IS TRUE
        `the Comptroller is satisfied` IS satisfied
        `chosen by the Comptroller as the couple's one owner-occupied home` IS chosen
        `the couple between them own 2 or more residential premises` IS `two homes`
        `separated and living apart, or one of several lawful spouses' homes` IS FALSE

§ `Schedule Part 2 -- not owner-occupied`

#ASSERT `the non-owner-occupied residential tax` 12000 2032 EQUALS 1440
#ASSERT `the non-owner-occupied residential tax` 30000 2024 EQUALS 3600
#ASSERT `the non-owner-occupied residential tax` 60000 2026 EQUALS 10800
#ASSERT `the non-owner-occupied residential tax` 100000 2026 EQUALS 25200
#ASSERT `the non-owner-occupied residential tax` 30000 2023 EQUALS 3300
#ASSERT `the non-owner-occupied residential tax` 100000 2023 EQUALS 19650

§ `Paragraphs 4 and 6(2) -- owner-occupation`

-- REQ-0010's flat, owner-occupied and approved: nil. Without the Comptroller's approval, 12% of $12,000 = $1,440.
#ASSERT `the residential property tax` 12000 2032 (`a home occupied by its owner` FALSE FALSE TRUE) EQUALS 0
#ASSERT `the residential property tax` 12000 2032 (`a home occupied by its owner` FALSE FALSE FALSE) EQUALS 1440
-- A couple with two homes: only the one the Comptroller picks gets the owner-occupier rates.
#ASSERT `the owner-occupier rates apply` (`a home occupied by its owner` TRUE TRUE TRUE) EQUALS TRUE
#ASSERT `the owner-occupier rates apply` (`a home occupied by its owner` TRUE FALSE TRUE) EQUALS FALSE
-- Death: owner-occupied until the earlier of transfer and two years, if not let.
#ASSERT `still owner-occupied after the owner's death` TRUE FALSE 18 FALSE EQUALS TRUE
#ASSERT `still owner-occupied after the owner's death` TRUE FALSE 25 FALSE EQUALS FALSE
#ASSERT `still owner-occupied after the owner's death` TRUE FALSE 6 TRUE EQUALS FALSE
#ASSERT `still owner-occupied after the owner's death` TRUE TRUE 6 FALSE EQUALS FALSE
#ASSERT `still owner-occupied after the owner's death` FALSE FALSE 6 FALSE EQUALS FALSE
