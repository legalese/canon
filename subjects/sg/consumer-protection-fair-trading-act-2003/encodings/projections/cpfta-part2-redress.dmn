  <decision id="decision_the_earliest_date_on_which_the_consumer_had_knowledge" name="the_earliest_date_on_which_the_consumer_had_knowledge" label="the earliest date on which the consumer had knowledge">
    <variable id="decision_the_earliest_date_on_which_the_consumer_had_knowledge_var" name="the_earliest_date_on_which_the_consumer_had_knowledge" label="the earliest date on which the consumer had knowledge" typeRef="date"/>
    <informationRequirement id="decision_the_earliest_date_on_which_the_consumer_had_knowledge_ir1">
      <requiredInput href="#input_k_2"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_the_earliest_date_on_which_the_consumer_had_knowledge_kr1">
      <requiredKnowledge href="#bkm_the_earlier_of_two_possible_dates"/>
    </knowledgeRequirement>
    <literalExpression id="decision_the_earliest_date_on_which_the_consumer_had_knowledge_literal">
      <text>the_earlier_of_two_possible_dates(a: the_earlier_of_two_possible_dates(a: k_2.the_date_on_which_the_consumer_actually_had_knowledge_of_the_unfair_practice, b: k_2.the_date_on_which_the_consumer_might_reasonably_have_been_expected_to_acquire_knowledge_from_facts_observable_or_ascertainable_by_the_consumer), b: (if k_2.the_consumer_has_taken_all_reasonable_steps_to_obtain_and_where_appropriate_to_act_on_that_expert_advice then null else k_2.the_date_on_which_the_consumer_might_reasonably_have_been_expected_to_acquire_knowledge_from_facts_ascertainable_with_appropriate_expert_advice_which_it_is_reasonable_to_seek))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_last_day_for_commencing_the_action" name="the_last_day_for_commencing_the_action" label="the last day for commencing the action">
    <variable id="decision_the_last_day_for_commencing_the_action_var" name="the_last_day_for_commencing_the_action" label="the last day for commencing the action" typeRef="date"/>
    <informationRequirement id="decision_the_last_day_for_commencing_the_action_ir1">
      <requiredDecision href="#decision_the_earliest_date_on_which_the_consumer_had_knowledge"/>
    </informationRequirement>
    <informationRequirement id="decision_the_last_day_for_commencing_the_action_ir2">
      <requiredInput href="#input_l"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_the_last_day_for_commencing_the_action_kr1">
      <requiredKnowledge href="#bkm_the_later_of_a_date_and_a_possible_date"/>
    </knowledgeRequirement>
    <decisionTable id="decision_the_last_day_for_commencing_the_action_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the last day for commencing the action">
      <input id="decision_the_last_day_for_commencing_the_action_i1" label="l&apos;s `kind of action`">
        <inputExpression id="decision_the_last_day_for_commencing_the_action_i1_expr" typeRef="string">
          <text>l.kind_of_action</text>
        </inputExpression>
      </input>
      <output id="decision_the_last_day_for_commencing_the_action_o1"/>
      <rule id="decision_the_last_day_for_commencing_the_action_r1">
        <description>(l's `kind of action`) EQUALS `an action under section 6`</description>
        <inputEntry id="decision_the_last_day_for_commencing_the_action_r1_i1">
          <text>"an action under section 6"</text>
        </inputEntry>
        <outputEntry id="decision_the_last_day_for_commencing_the_action_r1_o1">
          <text>the_later_of_a_date_and_a_possible_date(a: l.the_date_of_the_occurrence_of_the_last_material_event_on_which_the_action_is_based, b: the_earliest_date_on_which_the_consumer_had_knowledge) + duration("P24M")</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_last_day_for_commencing_the_action_r2">
        <description>(l's `kind of action`) EQUALS `an action under section 8(6), (7) or (8)`</description>
        <inputEntry id="decision_the_last_day_for_commencing_the_action_r2_i1">
          <text>"an action under section 8(6), (7) or (8)"</text>
        </inputEntry>
        <outputEntry id="decision_the_last_day_for_commencing_the_action_r2_o1">
          <text>l.the_date_of_the_failure_to_comply_with_the_undertaking + duration("P12M")</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_last_day_for_commencing_the_action_r3">
        <description>(l's `kind of action`) EQUALS `an action under section 9`</description>
        <inputEntry id="decision_the_last_day_for_commencing_the_action_r3_i1">
          <text>"an action under section 9"</text>
        </inputEntry>
        <outputEntry id="decision_the_last_day_for_commencing_the_action_r3_o1">
          <text>the_later_of_a_date_and_a_possible_date(a: l.the_date_of_the_occurrence_of_the_last_material_event_on_which_the_action_is_based, b: (if l.the_Commission_alleges_in_the_action_an_unfair_practice_in_respect_of_a_consumer then the_earliest_date_on_which_the_consumer_had_knowledge else null)) + duration("P24M")</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_last_day_for_commencing_the_action_r4">
        <description>(l's `kind of action`) EQUALS `an action under section 10`</description>
        <inputEntry id="decision_the_last_day_for_commencing_the_action_r4_i1">
          <text>"an action under section 10"</text>
        </inputEntry>
        <outputEntry id="decision_the_last_day_for_commencing_the_action_r4_o1">
          <text>l.the_date_of_the_occurrence_of_the_last_material_event_on_which_the_action_is_based + duration("P24M")</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_last_day_for_commencing_the_action_r5">
        <description>(l's `kind of action`) EQUALS `an action under regulations made under section 11`</description>
        <inputEntry id="decision_the_last_day_for_commencing_the_action_r5_i1">
          <text>"an action under regulations made under section 11"</text>
        </inputEntry>
        <outputEntry id="decision_the_last_day_for_commencing_the_action_r5_o1">
          <text>l.the_date_of_the_cancellation_of_the_contract + duration("P12M")</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_fourth_schedule_extends_the_time_for_commencing_the_action" name="the_Fourth_Schedule_extends_the_time_for_commencing_the_action" label="the Fourth Schedule extends the time for commencing the action">
    <variable id="decision_the_fourth_schedule_extends_the_time_for_commencing_the_action_var" name="the_Fourth_Schedule_extends_the_time_for_commencing_the_action" label="the Fourth Schedule extends the time for commencing the action" typeRef="boolean"/>
    <informationRequirement id="decision_the_fourth_schedule_extends_the_time_for_commencing_the_action_ir1">
      <requiredInput href="#input_l"/>
    </informationRequirement>
    <literalExpression id="decision_the_fourth_schedule_extends_the_time_for_commencing_the_action_literal">
      <text>l's `the person to whom the action accrued was under a disability on the date after which the period of limitation begins to run` AND (CONSIDER l's `kind of action` WHEN `an action under section 6` THEN TRUE WHEN `an action under section 8(6), (7) or (8)` THEN TRUE WHEN `an action under regulations made under section 11` THEN TRUE OTHERWISE FALSE) AND (CONSIDER l's `the date on which that person ceased to be under a disability or died, whichever first occurred` WHEN JUST ended THEN (l's `the date on which the action is commenced`) AT MOST (`add months` OF ended, 12) WHEN NOTHING THEN FALSE)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_action_is_commenced_in_time" name="the_action_is_commenced_in_time" label="the action is commenced in time">
    <variable id="decision_the_action_is_commenced_in_time_var" name="the_action_is_commenced_in_time" label="the action is commenced in time" typeRef="boolean"/>
    <informationRequirement id="decision_the_action_is_commenced_in_time_ir1">
      <requiredDecision href="#decision_the_fourth_schedule_extends_the_time_for_commencing_the_action"/>
    </informationRequirement>
    <informationRequirement id="decision_the_action_is_commenced_in_time_ir2">
      <requiredDecision href="#decision_the_last_day_for_commencing_the_action"/>
    </informationRequirement>
    <informationRequirement id="decision_the_action_is_commenced_in_time_ir3">
      <requiredInput href="#input_l"/>
    </informationRequirement>
    <literalExpression id="decision_the_action_is_commenced_in_time_literal">
      <text>l.the_date_on_which_the_action_is_commenced &lt;= the_last_day_for_commencing_the_action or the_Fourth_Schedule_extends_the_time_for_commencing_the_action</text>
    </literalExpression>
  </decision>
  <businessKnowledgeModel id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court" name="the_court_is_the_District_Court_or_the_General_Division_of_the_High_Court" label="the court is the District Court or the General Division of the High Court">
    <variable id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_var" name="the_court_is_the_District_Court_or_the_General_Division_of_the_High_Court" label="the court is the District Court or the General Division of the High Court" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_logic">
      <formalParameter id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_p1" name="k" typeRef="Any"/>
      <decisionTable id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the court is the District Court or the General Division of the High Court">
        <input id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_i1" label="k">
          <inputExpression id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_i1_expr" typeRef="string">
            <text>k</text>
          </inputExpression>
        </input>
        <output id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_o1"/>
        <rule id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r1">
          <description>k EQUALS `the District Court`</description>
          <inputEntry id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r1_i1">
            <text>"the District Court"</text>
          </inputEntry>
          <outputEntry id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r1_o1">
            <text>true</text>
          </outputEntry>
        </rule>
        <rule id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r2">
          <description>k EQUALS `the General Division of the High Court`</description>
          <inputEntry id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r2_i1">
            <text>"the General Division of the High Court"</text>
          </inputEntry>
          <outputEntry id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r2_o1">
            <text>true</text>
          </outputEntry>
        </rule>
        <rule id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r3">
          <description>k EQUALS `any other court`</description>
          <inputEntry id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r3_i1">
            <text>"any other court"</text>
          </inputEntry>
          <outputEntry id="bkm_the_court_is_the_district_court_or_the_general_division_of_the_high_court_r3_o1">
            <text>false</text>
          </outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period" name="the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period" label="the specified period is within the ceiling of 5 years or the prescribed period">
    <variable id="bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period_var" name="the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period" label="the specified period is within the ceiling of 5 years or the prescribed period" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period_logic">
      <formalParameter id="bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period_p1" name="period" typeRef="number"/>
      <formalParameter id="bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period_p2" name="the_period_the_Minister_has_prescribed_in_place_of_5_years" label="the period the Minister has prescribed in place of 5 years" typeRef="number"/>
      <literalExpression id="bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period_literal">
        <text>period &lt;= (if the_period_the_Minister_has_prescribed_in_place_of_5_years != null then the_period_the_Minister_has_prescribed_in_place_of_5_years else 5)</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_the_earlier_of_two_possible_dates" name="the_earlier_of_two_possible_dates" label="the earlier of two possible dates">
    <variable id="bkm_the_earlier_of_two_possible_dates_var" name="the_earlier_of_two_possible_dates" label="the earlier of two possible dates" typeRef="date"/>
    <encapsulatedLogic id="bkm_the_earlier_of_two_possible_dates_logic">
      <formalParameter id="bkm_the_earlier_of_two_possible_dates_p1" name="a" typeRef="date"/>
      <formalParameter id="bkm_the_earlier_of_two_possible_dates_p2" name="b" typeRef="date"/>
      <literalExpression id="bkm_the_earlier_of_two_possible_dates_literal">
        <text>if a != null then if b != null then (if a &lt; b then a else b) else a else b</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <businessKnowledgeModel id="bkm_the_later_of_a_date_and_a_possible_date" name="the_later_of_a_date_and_a_possible_date" label="the later of a date and a possible date">
    <variable id="bkm_the_later_of_a_date_and_a_possible_date_var" name="the_later_of_a_date_and_a_possible_date" label="the later of a date and a possible date" typeRef="date"/>
    <encapsulatedLogic id="bkm_the_later_of_a_date_and_a_possible_date_logic">
      <formalParameter id="bkm_the_later_of_a_date_and_a_possible_date_p1" name="a" typeRef="date"/>
      <formalParameter id="bkm_the_later_of_a_date_and_a_possible_date_p2" name="b" typeRef="date"/>
      <literalExpression id="bkm_the_later_of_a_date_and_a_possible_date_literal">
        <text>if b != null then max(b, a) else a</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
