IMPORT prelude
IMPORT `larpa-leases`

-- Lease Agreements for Retail Premises Act 2023, ss 2, 6, 9, 10, 12, 14, 17, 18, 25-27, 35 and First and Second Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_lease-agreements-for-retail-premises-act-2023.py). Expected results were written by
-- hand from the text.

`a three-year shop lease` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 36
    `is an extension or renewal` IS FALSE
    `original lease signed before Part 3 commenced` IS FALSE
    `extension terms were agreed in the original lease` IS FALSE
    `extension terms remain unchanged` IS FALSE

`an eleven-month kiosk licence` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 11
    `is an extension or renewal` IS FALSE
    `original lease signed before Part 3 commenced` IS FALSE
    `extension terms were agreed in the original lease` IS FALSE
    `extension terms remain unchanged` IS FALSE

`a six-month lease with renewal options` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 6
    `is an extension or renewal` IS FALSE
    `original lease signed before Part 3 commenced` IS FALSE
    `extension terms were agreed in the original lease` IS FALSE
    `extension terms remain unchanged` IS FALSE

`a back-office lease` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `administrative work for supplying services`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 24
    `is an extension or renewal` IS FALSE
    `original lease signed before Part 3 commenced` IS FALSE
    `extension terms were agreed in the original lease` IS FALSE
    `extension terms remain unchanged` IS FALSE

`a Johor Bahru shop lease` MEANS Lease WITH
    `the premises are in Singapore` IS FALSE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 36
    `is an extension or renewal` IS FALSE
    `original lease signed before Part 3 commenced` IS FALSE
    `extension terms were agreed in the original lease` IS FALSE
    `extension terms remain unchanged` IS FALSE

`a shop lease signed before Part 3` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS FALSE
    `months of term, ignoring options` IS 36
    `is an extension or renewal` IS FALSE
    `original lease signed before Part 3 commenced` IS FALSE
    `extension terms were agreed in the original lease` IS FALSE
    `extension terms remain unchanged` IS FALSE

`a pre-agreed unchanged renewal` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 36
    `is an extension or renewal` IS TRUE
    `original lease signed before Part 3 commenced` IS TRUE
    `extension terms were agreed in the original lease` IS TRUE
    `extension terms remain unchanged` IS TRUE

`a pre-agreed renewal with new rent` MEANS Lease WITH
    `the premises are in Singapore` IS TRUE
    `the primary use` IS `selling goods by retail`
    `signed on or after Part 3 commenced` IS TRUE
    `months of term, ignoring options` IS 36
    `is an extension or renewal` IS TRUE
    `original lease signed before Part 3 commenced` IS TRUE
    `extension terms were agreed in the original lease` IS TRUE
    `extension terms remain unchanged` IS FALSE

§ `s 2(1) and Second Schedule`

#ASSERT `the premises are retail premises` TRUE `selling goods by retail`
#ASSERT `the premises are retail premises` TRUE `supplying services`
#ASSERT NOT `the premises are retail premises` TRUE `administrative work for supplying services`
#ASSERT NOT `the premises are retail premises` TRUE `wholesale or storage`

§ `s 2(1), 2(5), 35(1) and First Schedule`

#ASSERT `the lease is a qualifying lease` `a three-year shop lease`
#ASSERT NOT `the lease is a qualifying lease` `an eleven-month kiosk licence`
#ASSERT NOT `the lease is a qualifying lease` `a six-month lease with renewal options`
#ASSERT NOT `the lease is a qualifying lease` `a back-office lease`
#ASSERT NOT `the lease is a qualifying lease` `a Johor Bahru shop lease`
#ASSERT NOT `the lease is a qualifying lease` `a shop lease signed before Part 3`
#ASSERT `the lease is a qualifying lease` `a pre-agreed unchanged renewal`

#ASSERT `the Act applies to the lease` `a three-year shop lease`
#ASSERT NOT `the Act applies to the lease` `a pre-agreed unchanged renewal`
#ASSERT `the Act applies to the lease` `a pre-agreed renewal with new rent`

§ `s 2(2)-(4), 6(1), 6(5)`

#ASSERT `there is non-compliance with the leasing principle` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `there is non-compliance with the leasing principle` TRUE TRUE TRUE FALSE TRUE FALSE
#ASSERT `there is non-compliance with the leasing principle` TRUE TRUE FALSE TRUE FALSE TRUE
#ASSERT NOT `there is non-compliance with the leasing principle` TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT `there is non-compliance with the leasing principle` TRUE TRUE FALSE TRUE TRUE FALSE
#ASSERT `there is non-compliance with the leasing principle` TRUE TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT `there is non-compliance with the leasing principle` TRUE FALSE TRUE FALSE FALSE FALSE

§ `s 6(4), 23(5), 24(5)`

#ASSERT `the permitted deviation is void` TRUE FALSE FALSE
#ASSERT NOT `the permitted deviation is void` TRUE FALSE TRUE
#ASSERT NOT `the permitted deviation is void` FALSE FALSE FALSE

§ `ss 9(1), 10(4), 12(1)`

#ASSERT `may file a complaint of non-compliance` `the landlord` TRUE
#ASSERT `may file a complaint of non-compliance` `the tenant` TRUE
#ASSERT NOT `may file a complaint of non-compliance` `a guarantor of the tenant` TRUE
#ASSERT NOT `may file a complaint of non-compliance` `the tenant` FALSE

#ASSERT `may apply for an adjudicator` TRUE FALSE TRUE
#ASSERT NOT `may apply for an adjudicator` FALSE FALSE TRUE
#ASSERT NOT `may apply for an adjudicator` TRUE TRUE TRUE

#ASSERT `may be appointed adjudicator on this complaint` TRUE FALSE
#ASSERT NOT `may be appointed adjudicator on this complaint` TRUE TRUE

§ `s 14`

#ASSERT `the adjudicator may make B pay A's fees` FALSE TRUE
#ASSERT NOT `the adjudicator may make B pay A's fees` FALSE FALSE

§ `ss 17, 18(1)`

#ASSERT `the mediation communication may be disclosed` `with the consent of all parties and the maker` FALSE
#ASSERT `the mediation communication may be disclosed` `to seek legal advice` FALSE
#ASSERT `the mediation communication may be disclosed` `under an order of court` FALSE
#ASSERT NOT `the mediation communication may be disclosed` `to tell the press` FALSE
#ASSERT NOT `the mediation communication may be disclosed` `with the consent of all parties and the maker` TRUE

§ `s 25(6)`

#ASSERT `the determination binds the parties` FALSE FALSE FALSE
#ASSERT NOT `the determination binds the parties` FALSE FALSE TRUE

§ `s 26`

#ASSERT `may apply to record the settlement` FALSE TRUE
#ASSERT NOT `may apply to record the settlement` TRUE TRUE

#ASSERT `the court may record it without a ground to refuse` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `the court may record it without a ground to refuse` TRUE TRUE TRUE FALSE FALSE

§ `s 27(4), (6)`

#ASSERT `the security condition is met` 20000 20000
#ASSERT NOT `the security condition is met` 20000 5000

#ASSERT `may rely on the ground to set aside` FALSE FALSE FALSE FALSE
#ASSERT NOT `may rely on the ground to set aside` TRUE FALSE FALSE FALSE
#ASSERT `may rely on the ground to set aside` TRUE FALSE FALSE TRUE

