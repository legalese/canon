-- Own damage (Chapter II): the sum insured is the amount on the policy (Article 1.15).
-- `deductible stated on the policy` is NOTHING where the policy states none; Article 15.1.5 sets
-- the minimum.
DECLARE `An own-damage section` HAS
    `sum insured`                    IS A NUMBER
    `deductible stated on the policy` IS A MAYBE NUMBER

-- Driver and passenger accident (Chapter III): an amount per person per accident (Article 20.2),
-- and the number of persons (seats) insured (Article 20.3).
DECLARE `An accident section` HAS
    `sum insured per person per accident` IS A NUMBER
    `number of persons insured`           IS A NUMBER

-- Owner's liability for goods carried (Chapter IV): Article 25 settles "theo số tiền bảo hiểm
-- tham gia/ tấn" and Article 26 takes its deductible from "tổng mức trách nhiệm bảo hiểm".
DECLARE `A goods section` HAS
    `sum insured per tonne`      IS A NUMBER
    `total limit of liability`   IS A NUMBER

-- Voluntary third-party liability (Chapter V): Article 29 names one "Mức trách nhiệm tự nguyện"
-- for bodily injury and one "mức trách nhiệm" for property; each is a figure on the policy.
DECLARE `A third-party section` HAS
    `voluntary limit for bodily injury per person per accident` IS A NUMBER
    `voluntary limit for property per accident`                  IS A NUMBER

-- The additional clauses of Chapter VI, by the code each carries.
DECLARE `An additional clause` IS ONE OF
    `BS01 new for old`                                  -- no depreciation on replacement
    `BS02 choice of repairer`
    `BS03 water damage to engine and electrics`
    `BS04 theft of parts`
    `BS05 own damage outside Vietnam`
    `BS06 duty-free or temporarily imported vehicle`
    `BS07 hire car during repair`
    `BS08 temporary circulation`
    `BS09 vehicle used only inside a closed site`
    `BS10 added equipment`
    `BS11 driving-school vehicle`
    `BS12 vandalism in riots`
    `BS13 special equipment`
    `BS14 the owner's own goods`
    `BS15 converted goods vehicle`
    `BS16 another clause agreed in writing`              -- item 16: terms not in the rules

-- Article 31: a clause is effective only when requested, its premium paid, and accepted by Tasco
-- in writing. `accepted in writing with premium paid` records all three.
-- src:1284 | Điều khoản bảo hiểm bồ sung chỉ có hiệu lực khi Bên mua bảo hiểm/ Chủ xe yêu
-- src:1286 | cầu, đã đóng phí bảo hiểm bổ sung và được Bảo hiểm Tasco chấp nhận bảo hiểm
-- src:1288 | bằng văn bản.
DECLARE `An additional clause on the policy` HAS
    `code`                                IS AN `An additional clause`
    `accepted in writing with premium paid` IS A BOOLEAN
    `start`                               IS A DATE
    `end`                                 IS A DATE

-- BS10: each added item must be listed on the policy with its own sum insured.
DECLARE `A listed item of added equipment` HAS
    `name`        IS A STRING
    `sum insured` IS A NUMBER

-- The policy (Article 1.13, 1.14): what the certificate or contract records.
-- `application signed` and `premium paid` are the two facts Article 1.12 turns on.
-- `premium before tax` is the base of the refunds in Article 3.2.
-- `countries named for BS05` and `added equipment listed` are what BS05 and BS10 require the
-- policy to name.
DECLARE `A policy` HAS
    `the vehicle`                         IS A `A vehicle`
    `date of conclusion`                  IS A DATE
    `start of the period of insurance`    IS A DATE
    `end of the period of insurance`      IS A DATE
    `application signed`                  IS A BOOLEAN
    `premium paid in full and on time`    IS A BOOLEAN
    `premium before tax`                  IS A NUMBER
    `own damage`                          IS A MAYBE `An own-damage section`
    `driver and passenger accident`       IS A MAYBE `An accident section`
    `goods liability`                     IS A MAYBE `A goods section`
    `voluntary third-party liability`     IS A MAYBE `A third-party section`
    `additional clauses`                  IS A LIST OF `An additional clause on the policy`
    `countries named for BS05`            IS A LIST OF STRING
    `added equipment listed`              IS A LIST OF `A listed item of added equipment`

§§ `The circumstances of a loss (Article 10 and Article 1.9, 1.10)`

-- Article 1.9 "Xe đang hoạt động" and 1.10 "Xe tham gia giao thông" are states of the vehicle a
-- witness can describe; the exclusions in Article 10.5 and 10.7 bite only while the first holds.
-- src:147 | 9. Xe đang hoạt động là trạng thái động cơ của xe đang được vận hành (nỗ máy, động cơ
-- src:148 | điện đang hoạt động) và/hoặc có sự điều kiến của Lái xe (bao gồm xe đang di chuyển,
-- src:149 | dừng đỗ xe hoặc vận hành động cơ để hỗ trợ thiết bị chuyên dùng trên xe hoạt động).
-- src:151 | 10. Xe tham gia giao thông là việc lái xe điều khiển xe cơ giới tham gia giao thông đường
-- src:152 | bộ.

-- Article 10.4.1 to 10.4.3 name three modifications that do not attract the inspection
-- exclusion; anything else is `another modification`.
-- src:632 | 4.1. Thay đổi thông số lốp và/hoặc đường kính la-zăng của xe với điều kiện các thông số này
-- src:633 | phù hợp với thông số kỹ thuật theo khuyến cáo/ hồ sơ của nhà sản xuất.
-- src:635 | 42. Lắp thêm các thiết bị bảo vệ cản trước/ cản sau, bodykits, giá chở hàng trên nóc xe, tời,
-- src:636 | móc kéo xe.
-- src:638 | 4.3. Lắp thêm ghế trên xe với điều kiện khi xảy ra tổn thất xe không được chở quá số người
-- src:639 | quy định.
DECLARE `A modification` IS ONE OF
    `tyres or rims changed within the manufacturer's specification`   -- 10.4.1
    `bumper guards, body kit, roof rack, winch or tow hook added`      -- 10.4.2
    `seats added`                                                      -- 10.4.3
    `another modification`

-- Article 10.5: the driving licence at the time of the loss.
-- src:641 | 5. Tại thời điểm xảy ra tổn thất khi xe đang hoạt động, lái xe không đủ điều kiện về độ tuổi
-- src:642 | theo quy định của Luật Giao thông đường bộ; Lái xe không có giấy phép lái xe hoặc sử
-- src:643 | dụng giấy phép lái xe không hợp lệ theo quy định của pháp luật về đào tạo, sát hạch, cấp
-- src:644 | giấy phép lái xe cơ giới đường bộ, giấy phép lái xe bị tẩy xóa hoặc sử dụng giấy phép lái
-- src:645 | xe hết hạn sử dụng tại thời điểm xảy ra tai nạn hoặc sử dụng giấy phép lái xe không phù
-- src:646 | hợp. đối với xe cơ giới bắt buộc phải có giấy phép lái xe. Trường hợp người lái xe bị tước
-- src:647 | quyền sử dụng giấy phép lái xe có thời hạn hoặc bị thu hồi giấy phép lái xe thì được coi
-- src:648 | là không có giấy phép lái xe.
DECLARE `A driving licence` IS ONE OF
    `a valid licence for this vehicle`
    `no licence`
    `an invalid licence`
    `an altered licence`
    `an expired licence`
    `a licence for another class of vehicle`
    `a licence suspended or revoked`           -- "được coi là không có giấy phép lái xe"
    `no licence needed for this vehicle`

-- Article 10.8: the traffic offences that exclude cover.
-- src:658 | 8. Xe đi vào đường cấm, khu vực cấm, đi ngược chiều (đi ngược chiều của đường một
-- src:659 | chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều”), rẽ/ quay đầu/ lùi xe tại
-- src:660 | nơi bị cấm; xe dừng/ đỗ tại nơi cấm dừng/ đỗ; xe đi vào hoặc dừng/ đỗ trong phạm vi giới
-- src:661 | hạn hành lang an toàn đường sắt; xe vượt đèn đỏ hoặc không chấp hành theo hiệu lệnh
-- src:662 | của người điều khiển giao thông: xe đi đêm không có thiết bị chiếu sáng theo quy định
-- src:663 | của pháp luật.
DECLARE `A traffic offence` IS ONE OF
    `entering a prohibited road or area`
    `driving against the direction of traffic`
    `turning, making a U-turn or reversing where prohibited`
    `stopping or parking where prohibited`
    `entering or stopping in a railway safety corridor`
    `running a red light or disobeying a traffic controller`
    `driving at night without the required lights`

-- Article 10.9: the uses of the vehicle that exclude cover.
-- src:665 | 9. Đuaxe (hợp pháp hoặc trái phép); xe dùng để kéo/ đầy phương tiện khác hoặc được kéo/
-- src:666 | đầy bởi phương tiện khác không tuân thủ quy định của pháp luật; xe được sử dụng làm
-- src:667 | phương tiện trong các hoạt động trộm/ cướp; xe chở hàng trái phép, hàng bị cấm theo quy
-- src:672 | định của pháp luật.
DECLARE `A prohibited use` IS ONE OF
    `racing`
    `towing or pushing, or being towed or pushed, unlawfully`
    `use in a theft or robbery`
    `carrying illegal or prohibited goods`

-- The facts every chapter's general exclusions (Article 10) read. Speeds are km/h, loads tonnes,
-- alcohol in the units of Article 10.7. `persons carried, not counting children under 7` is the
-- count Article 10.10 and 14.1.4 use.
DECLARE `The circumstances` HAS
    `date of the loss`                                       IS A DATE
    `in Vietnam`                                             IS A BOOLEAN
    `country`                                                IS A STRING
    `war or terrorism`                                       IS A BOOLEAN
    `deliberate destruction by the policyholder, owner, driver or another interested person` IS A BOOLEAN
    `valid inspection certificate`                           IS A BOOLEAN
    `modifications`                                          IS A LIST OF `A modification`
    `vehicle in operation`                                   IS A BOOLEAN
    `vehicle in traffic`                                     IS A BOOLEAN
    `driver of the age the Road Traffic Law requires`        IS A BOOLEAN
    `driving licence`                                        IS A `A driving licence`
    `special equipment operated without a required licence`  IS A BOOLEAN
    `blood alcohol, mg per 100 ml`                           IS A MAYBE NUMBER
    `breath alcohol, mg per litre`                           IS A MAYBE NUMBER
    `drugs or prohibited stimulants used`                    IS A BOOLEAN
    `traffic offences`                                       IS A LIST OF `A traffic offence`
    `prohibited uses`                                        IS A LIST OF `A prohibited use`
    `load carried in tonnes`                                 IS A NUMBER
    `persons carried, not counting children under 7`         IS A NUMBER
    `speed`                                                  IS A NUMBER
    `speed limit`                                            IS A NUMBER
    `force majeure or objective obstacle, in days`           IS A NUMBER

§§ `Conduct after a loss (Article 5.2.7, 14 and 24)`

-- What the owner and driver did after the loss, as a witness or the file would record it. Each
-- field is one limb of Article 14 (and of its twin, Article 24); the limb is on the right.
-- `written notice of the loss sent on` is NOTHING where no written notice was sent.
-- src:809 | a. Chủ xe/ Lái xe không thực hiện đầy đủ các biện pháp cứu chữa, hạn chế thiệt hại về
-- src:810 | người và tài sản; không bảo vệ hiện trường tổn thất (trừ trường hợp phải thi hành
-- src:811 | theo yêu cầu của cơ quan có thẩm quyền); không thông báo ngay cho cơ quan công
-- src:812 | an có thẩm quyền nơi xảy ra tổn thất; không thông báo ngay và/hoặc làm theo hướng
-- src:813 | dẫn của Bảo hiểm Tasco.
-- src:815 | b. Chủ xe/ Lái xe không gửi thông báo tổn thất và yêu cầu bồi thường bằng văn bản
-- src:816 | hoặc thông qua hình thức điện tử cho Bảo hiểm Tasco (Văn bản được hiểu là bản
-- src:817 | giấy có chữ ký của Chủ xe/lái xe hoặc bản khai điện tử có chữ ký điện tử của Chủ xe/
-- src:818 | lái xe) trong thời hạn 05 ngày kể từ ngày xảy ra tổn thất của xe được bảo hiểm (trừ
-- src:819 | trường hợp bất khả kháng hoặc đã được Bảo hiểm Tasco giám định thiệt hại trong
-- src:820 | thời gian này).
DECLARE `The conduct after the loss` HAS
    `rescue or limitation measures not fully taken`                       IS A BOOLEAN  -- 14.1.1(a)
    `scene not protected, without an authority's direction`               IS A BOOLEAN  -- 14.1.1(a)
    `police not notified immediately`                                     IS A BOOLEAN  -- 14.1.1(a)
    `Tasco not notified immediately or its instructions not followed`     IS A BOOLEAN  -- 14.1.1(a)
    `written notice of the loss sent on`                                  IS A MAYBE DATE -- 14.1.1(b), 5.2.7(c)
    `force majeure prevented the written notice`                          IS A BOOLEAN  -- 14.1.1(b), 5.2.7(c)
    `objective obstacle prevented the written notice`                     IS A BOOLEAN  -- 5.2.7(c) only
    `Tasco assessed the damage within the notice period`                  IS A BOOLEAN  -- 14.1.1(b)
    `driver drowsy or asleep at the wheel`                                IS A BOOLEAN  -- 14.1.1(c)
    `vehicle moved, dismantled or repaired without Tasco's consent, when not necessary` IS A BOOLEAN -- 14.1.2(a)
    `driver left the scene or did not follow alcohol or drug testing instructions`      IS A BOOLEAN -- 14.1.2(b)
    `incomplete or untruthful declaration, or an increase in risk not notified`         IS A BOOLEAN -- 14.1.2(d)
    `right of recourse not preserved or transferred, or a settlement made with the third party` IS A BOOLEAN -- 14.1.3(a)
    `information given dishonestly, concealed or falsified`               IS A BOOLEAN  -- 14.1.3(b)

-- Where Article 14 gives a band ("từ 20% đến 50%", "từ 50% đến toàn bộ"), the rules give Tasco
-- no criterion for the point in the band (finding X-06). What Tasco decided is a record; NOTHING
-- where Tasco has not decided.
DECLARE `Tasco's determinations` HAS
    `rate chosen in the 20 to 50 per cent band`   IS A MAYBE NUMBER
    `rate chosen in the 50 to 100 per cent band`  IS A MAYBE NUMBER
    `salvage value of a vehicle the owner keeps`  IS A MAYBE NUMBER   -- Article 16.2.2
    `fault ratio of the owner or driver`          IS A MAYBE NUMBER   -- Article 29.3

§§ `Own damage (Chapter II)`

-- Article 11.1: the five named causes, and the case of a cause the article does not name.
-- src:686 | 1 Bảo hiểm Tasco chịu trách nhiệm bồi thường những thiệt hại vật chất của xe ô tô do thiên
-- src:687 | tai, tai nạn bất ngờ, không lường trước được trong những trường hợp sau:
-- src:688 | 11 Đâm,va, lật, đồ, chìm, rơi toàn bộ xe, bị các vật thể khác từ bên ngoài tác động vào.
-- src:689 | 1.2 Hỏa hoạn, cháy, nổ.
-- src:690 | 13 Những tai họa bất khả kháng do thiên nhiên.
-- src:691 | 1.4 Mất toàn bộ xe do trộm, cướp.
-- src:693 | 1.5 Hành vi ác ý, cố tình phá hoại nhưng loại trừ hành vi ác ý, cố tình phá hoại của Bên mua
-- src:694 | bảo hiểm, chủ xe, lái xe, những người có quyền lợi và nghĩa vụ liên quan đến việc sở hữu
-- src:696 | và sử dụng xe.
DECLARE `A cause of own damage` IS ONE OF
    `collision, overturning, falling, sinking or impact by an external object`  -- 11.1.1
    `fire or explosion`                                                         -- 11.1.2
    `a natural catastrophe beyond control`                                      -- 11.1.3
    `theft or robbery of the whole vehicle`                                     -- 11.1.4
    `a malicious act by someone else`                                           -- 11.1.5
    `vandalism in a demonstration, riot or public disorder`                     -- BS12
    `theft or robbery of a part`                                                -- BS04 (13.3)
    `a cause Article 11 does not name`

-- The kinds of item Articles 13 and 15 treat differently.
-- src:762 | Tổn thất đối với săm lốp, bạt thùng xe, nhãn mác, chắn bùn, chụp đầu trục bánh xe, lót
-- src:763 | gầm xe; tổn thất của pin xe điện, pin ô tô lai sạc điện trừ trường hợp tổn thất xây ra do
-- src:764 | cùng một nguyên nhân và đồng thời với các bộ phận khác của xe trong cùng một vụ tai
-- src:765 | nạn.
-- src:940 | e. Quy định khác:
-- src:942 | - Các bộ phận như săm lốp, ắc quy, lọc gió, lọc dầu, lọc xăng, gioăng phớt, má
-- src:943 | phanh, bạt thùng; các loại dung dịch như dầu động cơ, dầu phanh, đầu hộp số, dầu
-- src:944 | trợ lực lái; nước làm mát, gas điều hòa áp dụng mức khấu hao 50% giá trị bộ phận
-- src:946 | thay mới.
-- src:947 | - Các bộ phận như kính chắn gió, mặt gương chiếu hậu không áp dụng khấu hao giá
-- src:948 | trị bộ phận thay mới.
DECLARE `A kind of damaged item` IS ONE OF
    `an ordinary part`                                                     -- 15.1.3(c)
    `a tyre or inner tube`                                                 -- 13.7; 50% under 15.1.3(e)
    `a goods-body canvas`                                                  -- 13.7; 50% under 15.1.3(e)
    `a label, mudguard, hub cap or underbody liner`                        -- 13.7
    `the traction battery`                                                 -- 13.7, 13.8, 15.1.3(d)
    `a part on the 50 per cent list`                                       -- 15.1.3(e): 12 V battery, filters, gaskets, brake pads, fluids, coolant, refrigerant gas
    `windscreen or mirror glass`                                           -- 15.1.3(e): no depreciation
    `an electrical or electronic part, or an engine`                       -- 13.6, 13.9
    `the key or remote`                                                    -- 13.3
    `equipment added after manufacture`                                    -- 13.10, BS10
    `special equipment`                                                    -- 13.11, BS13

-- One damaged item. `cost` is the actual reasonable cost of repair or, where it cannot be repaired,
-- replacement (Article 15.1.1). `replaced` says which; depreciation bites only on replacement
-- (15.1.3(a)).
DECLARE `A damaged item` HAS
    `kind`                                                     IS A `A kind of damaged item`
    `cost`                                                     IS A NUMBER
    `replaced`                                                 IS A BOOLEAN
    `damaged by the same cause at the same time as other parts in the same accident` IS A BOOLEAN  -- 13.7
    `stolen`                                                   IS A BOOLEAN  -- 13.3
    `damaged by overload, overpressure, short circuit, self-heating, arcing or leakage` IS A BOOLEAN -- 13.9
    `years the traction battery has been used`                 IS A NUMBER   -- 15.1.3(d); 0 for other items
    `sum insured listed for this added equipment`              IS A MAYBE NUMBER -- BS10; NOTHING if not listed

-- One own-damage loss. The costs of Article 11.2 are amounts actually spent at Tasco's request.
-- `estimated cost of repair` is the estimate Article 15.2.1(a) compares with 75% of the market
-- value immediately before the loss.
DECLARE `An own-damage loss` HAS
    `cause`                                                          IS A `A cause of own damage`
    `sudden and unforeseen`                                          IS A BOOLEAN
    `items`                                                          IS A LIST OF `A damaged item`
    `cost of preventing further loss`                                IS A NUMBER  -- 11.2.1
    `cost of rescue and towing to the nearest repairer`              IS A NUMBER  -- 11.2.2
    `market value immediately before the loss`                       IS A NUMBER  -- 15.2
    `estimated cost of repair`                                       IS A NUMBER  -- 15.2.1(a)
    `investigation concluded or suspended, or prosecution declined`  IS A BOOLEAN -- 15.2.1(b)
    `more than half the paint area damaged`                          IS A BOOLEAN -- 15.1.2
    `cost of repainting the whole vehicle`                           IS A NUMBER  -- 15.1.2
    `whole vehicle lost by fraud, breach of trust, civil dispute or unknown cause` IS A BOOLEAN -- 13.4
    `wear and tear, inherent vice, loss of value, defect or faulty repair`        IS A BOOLEAN -- 13.5
    `vehicle operating in a flooded area`                            IS A BOOLEAN -- 13.6, BS03
    `caused by the traction battery`                                 IS A BOOLEAN -- 13.8.1
    `caused by incompatible equipment`                               IS A BOOLEAN -- 13.8.2
    `caused by handling outside the manufacturer's standards`        IS A BOOLEAN -- 13.8.3
    `caused by equipment added after manufacture`                    IS A BOOLEAN -- 13.10
    `during operation of special equipment`                          IS A BOOLEAN -- 13.11, BS13
    `caused by a bomb, mine or explosive device`                     IS A BOOLEAN -- BS12(b)
    `repaired in Vietnam`                                            IS A BOOLEAN -- BS06(c)
    `the owner keeps the vehicle`                                    IS A BOOLEAN -- 16.2.2
    `sums insured by other contracts on the same vehicle`            IS A NUMBER  -- Article 8; 0 if none

§§ `Driver and passenger accident (Chapter III)`

-- Article 17: the driver and the others carried. Article 20.3 counts persons "không bao gồm trẻ
-- em dưới 7 tuổi" and gives a child under 7 the full benefit.
-- src:999 | Lái xe và những người khác được chở trên xe (gọi chung là Người được bảo hiểm).
DECLARE `A role on board` IS ONE OF
    `the driver of the vehicle`
    `a person carried`

-- A row of the injury table that the injury falls in, and the rate the assessment fixed in that
-- row's range. `table section` and `table item` are the row's printed numbering ("B.VI",
-- "4.6.1"); `permanent` separates Article 20.2.2(a) from (b).
DECLARE `An injury` HAS
    `table section`   IS A STRING
    `table item`      IS A STRING
    `assessed rate`   IS A NUMBER
    `permanent`       IS A BOOLEAN

-- The outcome of the accident for one person. For a death, special case 6 of the appendix
-- turns on whether the deceased was identified and left a lawful heir, and on the burial costs.
DECLARE `An outcome for the person` IS ONE OF
    `death`         HAS `identified, with a lawful heir`                     IS A BOOLEAN
                        `cost of burial and of keeping the remains for identification` IS A NUMBER
    `bodily injury` HAS `the injuries`                    IS A LIST OF `An injury`
                        `medical costs actually incurred` IS A NUMBER
                        `days of treatment`               IS A NUMBER

-- One insured person's accident (Articles 18 to 20).
-- src:1002 | Thiệt hại về sức khỏe, tính mạng đối với người được bảo hiểm do tai nạn khi đang ở trên
-- src:1003 | xe, lên xuống xe trong quá trình tham gia giao thông.
DECLARE `An accident to a person on board` HAS
    `role`                                            IS A `A role on board`
    `on the vehicle, or getting on or off it`         IS A BOOLEAN   -- Article 18
    `under 7`                                         IS A BOOLEAN   -- Article 20.3
    `fighting, not in self-defence`                   IS A BOOLEAN   -- Article 19.3
    `sudden illness, stroke or disease`               IS A BOOLEAN   -- Article 19.4
    `outcome`                                         IS AN `An outcome for the person`

§§ `Goods carried (Chapter IV)`

-- src:1063 | Bảo hiểm Tasco nhận bảo hiểm trách nhiệm dân sự của Chủ xe ô tô đối với những thiệt
-- src:1064 | hại hàng hoá vận chuyển trên xe theo hợp đồng vận chuyển giữa Chủ xe và Chủ hàng
-- src:1065 | theo quy định của Bộ Luật Dân sự trong trường hợp xe bị đâm, va, lật, đỏ, chìm, rơi toàn
-- src:1066 | bộ xe; bị các vật thể khác từ bên ngoài tác động vào; hỏa hoạn, cháy, nổ; mất cắp/ mất
-- src:1067 | cướp toàn bộ xe; những tai họa bất khả kháng do thiên nhiên như bão, lũ lụt, sụt lở, sét
-- src:1068 | đánh, động đất, mưa đá, sóng thần.
DECLARE `A cause of loss of goods` IS ONE OF
    `collision, overturning, falling or sinking of the vehicle`
    `impact by an external object`
    `fire or explosion`
    `theft or robbery of the whole vehicle`
    `a natural catastrophe`
    `a cause Article 21 does not name`

-- One loss of goods. `actual damage` is the damage to the goods valued as Article 22 says;
-- `tonnes of goods damaged` is the quantity Article 25's per-tonne sum is applied to (NOTES.md,
-- fork F-23). Each BOOLEAN is one exclusion of Article 23, numbered on the right.
DECLARE `A loss of goods` HAS
    `cause`                                                         IS A `A cause of loss of goods`
    `carried under a contract of carriage between owner and cargo owner` IS A BOOLEAN -- 21.1
    `actual damage`                                                 IS A NUMBER
    `tonnes of goods damaged`                                       IS A NUMBER
    `cost of preventing or reducing the loss`                       IS A NUMBER  -- 21.2.1
    `cost of storing, handling and warehousing after the accident`  IS A NUMBER  -- 21.2.2
    `goods left unguarded or not preserved`                         IS A BOOLEAN -- 23.3
    `goods stolen or robbed without the whole vehicle`              IS A BOOLEAN -- 23.4
    `seizure or requisition by the State`                           IS A BOOLEAN -- 23.5
    `shifting or knocking in transit, not from an accident`         IS A BOOLEAN -- 23.6
    `natural deterioration, poor quality, packing or stowage`       IS A BOOLEAN -- 23.7
    `late, misdirected, short or wrong delivery`                    IS A BOOLEAN -- 23.8
    `consequential or indirect loss`                                IS A BOOLEAN -- 23.9
    `special property`                                              IS A BOOLEAN -- 23.10: gold, gems, money, antiques, remains, live plants, radioactive
    `goods owned by the owner or driver`                            IS A BOOLEAN -- 23.11, BS14
    `the owner is both driver and cargo owner`                      IS A BOOLEAN -- BS14(b)

§§ `Third-party liability (Chapter V)`

-- One head of the owner's liability to a third party or passenger, as it stands when the owner
-- has paid. The compulsory-insurance figures come from the compulsory scheme (Decree
-- 67/2023, the brief's citation; the rules name only "the compulsory insurance"): they are inputs.
-- `rate under the compulsory table` is the rate that scheme's own table gives the injury.
DECLARE `A head of third-party loss` IS ONE OF
    `bodily injury to a person` HAS `rate under the compulsory table` IS A NUMBER
    `damage to property`        HAS `actual damage`                   IS A NUMBER

DECLARE `A third-party claim` HAS
    `head`                                                   IS A `A head of third-party loss`
    `amount the owner actually paid`                         IS A NUMBER
    `compulsory limit for this head`                         IS A NUMBER
    `compulsory insurance in force`                          IS A BOOLEAN   -- 27, 30.1
    `excluded under the compulsory scheme`                   IS A BOOLEAN   -- 30.4

§§ `Facts the additional clauses turn on (Chapter VI)`

-- One record for the conditions and exclusions of the additional clauses, each field labelled
-- with its clause. A field that a clause on the policy does not read is never consulted.
DECLARE `Facts for the additional clauses` HAS
    `part thefts already claimed under this contract`                               IS A NUMBER  -- BS04
    `licensed to circulate in that country`                                         IS A BOOLEAN -- BS05(a)
    `driver licensed in that country`                                               IS A BOOLEAN -- BS05(a)
    `temporarily imported for re-export, duty-free, or a diplomatic vehicle`        IS A BOOLEAN -- BS06(a)
    `days of repair, from the repair contract to the acceptance record`             IS A NUMBER  -- BS07(a)
    `hire cost per day, before VAT`                                                 IS A NUMBER  -- BS07(b)
    `days of hire already paid in the period`                                       IS A NUMBER  -- BS07(b)
    `new with a factory quality slip, or imported with a quality certificate and customs papers` IS A BOOLEAN -- BS08(a)
    `used only inside a closed site, never on public roads, with chassis and engine numbers`     IS A BOOLEAN -- BS09(a)
    `loss inside the closed site`                                                   IS A BOOLEAN -- BS09(b)
    `a qualifying driving-school vehicle driven by a learner in traffic`            IS A BOOLEAN -- BS11(a)
    `learner not listed, or without card, learner's permit or papers`               IS A BOOLEAN -- BS11(b)
    `instructor without a practising certificate`                                   IS A BOOLEAN -- BS11(b)
    `no learner sign or no auxiliary brake`                                         IS A BOOLEAN -- BS11(b)
    `outside the school's permitted time or route`                                  IS A BOOLEAN -- BS11(b)
    `no instructor beside the learner, outside a test`                              IS A BOOLEAN -- BS11(b)
    `special vehicle not technically safe`                                          IS A BOOLEAN -- BS13(b)
    `operator without the right licence for the special equipment`                  IS A BOOLEAN -- BS13(b)
    `operator deliberately broke the operating instructions`                        IS A BOOLEAN -- BS13(b)
    `a converted or modified goods vehicle`                                         IS A BOOLEAN -- BS15
    `inspection certificate expired at the loss`                                    IS A BOOLEAN -- BS15(b)

§§ `Duties and their dates (Articles 3, 4, 5, 9)`

-- The dates a claim file records. NOTHING where the step has not happened.
DECLARE `A claim file` HAS
    `date the complete and valid file was received`          IS A MAYBE DATE
    `verification needed`                                    IS A BOOLEAN
    `date Tasco asked the authority to verify`               IS A MAYBE DATE
    `date the settlement notice was received`                IS A MAYBE DATE
    `date the dispute arose`                                 IS A MAYBE DATE

-- Article 7: the facts the claim-file items' own conditions turn on ("trường hợp ...").
DECLARE `The kind of claim` HAS
    `damage to the vehicle or property`           IS A BOOLEAN
    `whole vehicle stolen or robbed`              IS A BOOLEAN
    `part of the vehicle stolen or robbed`        IS A BOOLEAN
    `damage to goods carried`                     IS A BOOLEAN
    `injury or death of a person`                 IS A BOOLEAN
    `a person died`                               IS A BOOLEAN
    `claimed through an authorised person`        IS A BOOLEAN
    `settled by conciliation`                     IS A BOOLEAN
    `decided by a court`                          IS A BOOLEAN
    `a third party is liable`                     IS A BOOLEAN
    `investigated by the police`                  IS A BOOLEAN

§§ `The injury table (Appendix)`

-- What a printed row of the appendix shows in its "%" column: a range ("6 - 10"), one figure
-- ("61"), or nothing (a heading row, or a row that refers to another row or table).
DECLARE `The rate printed in a row` IS ONE OF
    `a range`       HAS `lowest`  IS A NUMBER
                        `highest` IS A NUMBER
    `one figure`    HAS `figure`  IS A NUMBER
    `no figure`

-- One printed row of the appendix "Bảng tỷ lệ trả tiền bảo hiểm thương tật" (its printed title is
-- quoted in tasco-injury-table.l4): its section ("A", or "B.I" to "B.X"), its item number as
-- printed, and what its "%" column shows, in per cent as printed (6 means 6%).
-- `source line` is the OCR line carrying the item number, `figure line` the OCR line carrying
-- the figure (often the same; 0 when there is none), and `page` the PDF page.
DECLARE `An injury table row` HAS
    `section`      IS A STRING
    `item`         IS A STRING
    `rate printed` IS A `The rate printed in a row`
    `source line`  IS A NUMBER
    `figure line`  IS A NUMBER
    `page`         IS A NUMBER
