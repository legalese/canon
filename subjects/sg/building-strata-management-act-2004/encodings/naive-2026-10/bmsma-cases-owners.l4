IMPORT prelude
IMPORT `bmsma-owners`

-- Building Maintenance and Strata Management Act 2004, ss 37 to 44, 53, 54, 63 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_bmsma.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`arrears with every step taken` MEANS Arrears WITH
    `days since demand` IS 120
    `charge registered` IS TRUE
    `special resolution passed` IS TRUE
    `newspaper notice published` IS TRUE
    `weeks since publication` IS 7
    `paid after publication` IS FALSE
    `restraining action pending` IS FALSE

`arrears 20 days after demand` MEANS Arrears WITH
    `days since demand` IS 20
    `charge registered` IS FALSE
    `special resolution passed` IS FALSE
    `newspaper notice published` IS FALSE
    `weeks since publication` IS 0
    `paid after publication` IS FALSE
    `restraining action pending` IS FALSE

`arrears without a special resolution` MEANS Arrears WITH
    `days since demand` IS 120
    `charge registered` IS TRUE
    `special resolution passed` IS FALSE
    `newspaper notice published` IS TRUE
    `weeks since publication` IS 7
    `paid after publication` IS FALSE
    `restraining action pending` IS FALSE

`arrears only 4 weeks after publication` MEANS Arrears WITH
    `days since demand` IS 120
    `charge registered` IS TRUE
    `special resolution passed` IS TRUE
    `newspaper notice published` IS TRUE
    `weeks since publication` IS 4
    `paid after publication` IS FALSE
    `restraining action pending` IS FALSE

`arrears paid after publication` MEANS Arrears WITH
    `days since demand` IS 120
    `charge registered` IS TRUE
    `special resolution passed` IS TRUE
    `newspaper notice published` IS TRUE
    `weeks since publication` IS 7
    `paid after publication` IS TRUE
    `restraining action pending` IS FALSE

`arrears with an injunction application pending` MEANS Arrears WITH
    `days since demand` IS 120
    `charge registered` IS TRUE
    `special resolution passed` IS TRUE
    `newspaper notice published` IS TRUE
    `weeks since publication` IS 7
    `paid after publication` IS FALSE
    `restraining action pending` IS TRUE

§ `ss 37, 37A`

#ASSERT `what the renovation needs` `enclosing a balcony to add floor area` EQUALS "a 90% resolution"
#ASSERT `what the renovation needs` `changing the facade colour of the windows` EQUALS "management corporation approval"
#ASSERT `what the renovation needs` `installing window grilles` EQUALS "nothing: section 37A overrides the by-laws"
#ASSERT `what the renovation needs` `installing a cat-proof mesh` EQUALS "nothing: section 37A overrides the by-laws"
#ASSERT `what the renovation needs` `installing a CCTV intruder monitoring system` EQUALS "nothing: section 37A overrides the by-laws"
#ASSERT `what the renovation needs` `re-tiling the kitchen` EQUALS "nothing under section 37"

#ASSERT `the owner can be required to remedy an unauthorised improvement` FALSE TRUE
#ASSERT `the owner can be required to remedy an unauthorised improvement` TRUE TRUE
#ASSERT NOT `the owner can be required to remedy an unauthorised improvement` TRUE FALSE

§ `ss 39 to 41`

#ASSERT `my contribution` 100000 10 1000 FALSE EQUALS 1000
#ASSERT `my contribution` 100000 10 1000 TRUE EQUALS 250

#ASSERT `who is liable for the arrears` TRUE EQUALS `the seller and the buyer jointly and severally`
#ASSERT `who is liable for the arrears` FALSE EQUALS `the buyer only`

#ASSERT `interest is running` 31
#ASSERT NOT `interest is running` 30

#ASSERT `non-payment is an offence` TRUE 14 FALSE
#ASSERT NOT `non-payment is an offence` TRUE 10 FALSE
#ASSERT NOT `non-payment is an offence` TRUE 20 TRUE
#ASSERT NOT `non-payment is an offence` FALSE 60 FALSE

§ `s 43`

#ASSERT `a charge may be registered` `arrears with every step taken`
#ASSERT NOT `a charge may be registered` `arrears 20 days after demand`
#ASSERT `a charge may be registered` `arrears without a special resolution`
#ASSERT `a charge may be registered` `arrears only 4 weeks after publication`
#ASSERT `a charge may be registered` `arrears paid after publication`
#ASSERT `a charge may be registered` `arrears with an injunction application pending`

#ASSERT `the management corporation may sell the flat` `arrears with every step taken`
#ASSERT NOT `the management corporation may sell the flat` `arrears 20 days after demand`
#ASSERT NOT `the management corporation may sell the flat` `arrears without a special resolution`
#ASSERT NOT `the management corporation may sell the flat` `arrears only 4 weeks after publication`
#ASSERT NOT `the management corporation may sell the flat` `arrears paid after publication`
#ASSERT NOT `the management corporation may sell the flat` `arrears with an injunction application pending`

§ `s 44`

#ASSERT `my guarantee liability` 500000 10 1000 EQUALS 5000

§ `ss 53, 54`

#ASSERT `the candidate is eligible` FALSE
#ASSERT NOT `the candidate is eligible` TRUE

#ASSERT `the member can be removed without a general meeting` 4
#ASSERT NOT `the member can be removed without a general meeting` 3

§ `s 63`

#ASSERT `section 63 binds the person` `owner`
#ASSERT `section 63 binds the person` `tenant`
#ASSERT `section 63 binds the person` `mortgagee in possession`
#ASSERT NOT `section 63 binds the person` `visitor`

