#ASSERT `a Part 3 Direction may be issued to the person` TRUE TRUE FALSE TRUE FALSE TRUE
#ASSERT NOT `a Part 3 Direction may be issued to the person` TRUE TRUE FALSE FALSE TRUE FALSE
#ASSERT NOT `a Part 3 Direction may be issued to the person` FALSE TRUE FALSE TRUE TRUE FALSE

