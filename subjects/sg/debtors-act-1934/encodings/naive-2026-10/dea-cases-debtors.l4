IMPORT prelude
IMPORT `dea-debtors`

-- Debtors Act 1934, ss 3, 6, 8-10, 12, 13, 15, 17, 20, 21, 22, 24, 26, 27 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_debtors-act-1934.py). Expected results were written by
-- hand from the text.

§ `fixtures`

`a debtor still owing 5000 who is staying put` MEANS JudgmentDebtor WITH
    `amount still unpaid` IS 5000
    `likely to leave Singapore to avoid payment or examination` IS FALSE
    `creditor must deposit the arrest expenses` IS FALSE
    `arrest expenses deposited` IS FALSE

`a debtor who has paid part and is booked to emigrate` MEANS JudgmentDebtor WITH
    `amount still unpaid` IS 1500
    `likely to leave Singapore to avoid payment or examination` IS TRUE
    `creditor must deposit the arrest expenses` IS FALSE
    `arrest expenses deposited` IS FALSE

`a debtor about to fly out owing 20000, no deposit rule` MEANS JudgmentDebtor WITH
    `amount still unpaid` IS 20000
    `likely to leave Singapore to avoid payment or examination` IS TRUE
    `creditor must deposit the arrest expenses` IS FALSE
    `arrest expenses deposited` IS FALSE

`a debtor about to fly out, deposit required but not made` MEANS JudgmentDebtor WITH
    `amount still unpaid` IS 20000
    `likely to leave Singapore to avoid payment or examination` IS TRUE
    `creditor must deposit the arrest expenses` IS TRUE
    `arrest expenses deposited` IS FALSE

`a debtor about to fly out, deposit made` MEANS JudgmentDebtor WITH
    `amount still unpaid` IS 20000
    `likely to leave Singapore to avoid payment or examination` IS TRUE
    `creditor must deposit the arrest expenses` IS TRUE
    `arrest expenses deposited` IS TRUE

`a debtor who could pay and did not` MEANS PaymentDefault WITH
    `defaulted under the payment order` IS TRUE
    `notice to show cause served personally` IS TRUE
    `sufficient cause shown` IS FALSE
    `had sufficient means since the order` IS TRUE
    `creditor must deposit subsistence` IS FALSE
    `subsistence deposited` IS FALSE

`a debtor who never had the means` MEANS PaymentDefault WITH
    `defaulted under the payment order` IS TRUE
    `notice to show cause served personally` IS TRUE
    `sufficient cause shown` IS FALSE
    `had sufficient means since the order` IS FALSE
    `creditor must deposit subsistence` IS FALSE
    `subsistence deposited` IS FALSE

`a debtor who showed sufficient cause` MEANS PaymentDefault WITH
