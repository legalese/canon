IMPORT prelude
IMPORT daydate

-- Housing and Development Act 1959 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../source/HDA1959.txt (SSO informal consolidation, version in
-- force from 15 July 2026, deposited in this repository).

§ `Housing and Development Act 1959 — the nouns`

§§ `Buying a flat (s 50)`

-- s 50(1): the applicant, spouse or any authorised occupier.
DECLARE `Purchase facts` HAS
    `owns any other flat, house, building or land, or an interest in one` IS A BOOLEAN   -- (a)
    `disposed of such property on`                    IS A LIST OF DATE                  -- (b): every disposal
    `application made on`                             IS A DATE
    `purchase completed on`                           IS A MAYBE DATE
    `exempted by the Board or on the Minister's direction` IS A BOOLEAN                  -- (10)
    `a body corporate declared under s 57`            IS A BOOLEAN

-- s 50(12): grounds on which the Board may cancel an application.
DECLARE `Cancellation ground` IS ONE OF
    `(a) a material misrepresentation or false statement`
    `(b) a killing-or-hurt conviction for throwing things from Board property`
    `(c) a Government CPF cash grant not returned when required`
    `(d) an immigration conviction for harbouring or assisting`
    `none`

§§ `Dealing with a flat the Board has sold (ss 52, 55, 56, 58, 59)`

DECLARE Dealing IS ONE OF
    `selling or agreeing to sell within the minimum occupation period`     -- s 55(1)
    `a sale contract not in the prescribed form`                           -- s 55(2)
    `selling, leasing, mortgaging or otherwise disposing of the flat`      -- s 56(1)
    `using the flat or its proceeds as security for a debt` HAS            -- s 58(1), (4)
        `in favour of the Board, an approved financial institution or a prescribed person` IS A BOOLEAN
    `creating a trust of the flat`                                         -- s 58(9)-(10)
    `claiming under a resulting or constructive trust`                     -- s 58(11)
    `registering a transmission or transfer on the owner's death`          -- s 59(1)
    `using the flat for a purpose the lease does not permit`               -- s 52(3)

DECLARE `Dealing facts` HAS
    `dealing`                                         IS A Dealing
    `the Board's prior written consent or approval`   IS A BOOLEAN
    `made on or after 20 November 1998`               IS A BOOLEAN   -- s 55(3)

§§ `The Board's remedies against an owner (ss 62, 63, 74)`

-- s 62(1): re-entry and determination of the lease.
DECLARE `Re-entry facts` HAS
    `months rent unpaid after it became payable`      IS A NUMBER
    `a written demand sent by registered post`        IS A BOOLEAN
    `breach of a non-assignment condition, or an irremediable breach, notified` IS A BOOLEAN
    `days since notice of a remediable breach, still unremedied` IS A NUMBER   -- -1 if none
    `a false statement in the application form`       IS A BOOLEAN
    `a breach of rules under s 74(1)(g), in the Board's opinion` IS A BOOLEAN
    `used otherwise than as the lease permits, without approval` IS A BOOLEAN

-- s 63(1)(a)-(o): compulsory acquisition grounds.
DECLARE `Acquisition ground` IS ONE OF
    `(a) owner and spouse have ceased to occupy`
    `(b) owner, spouse or occupier acquired other property` HAS
        `commercial property bought with consent, value`  IS A MAYBE NUMBER   -- s 63(2)
        `a higher value the Minister allows`               IS A MAYBE NUMBER
        `used or intended for business`                    IS A BOOLEAN
    `(c) used otherwise than as permitted, without approval`
    `(d) a person other than an authorised occupier resides there`
    `(e) a lease condition unobserved after written notice`
    `(f) a misleading or false statement in the application`
    `(g) a material misrepresentation relating to the purchase`
    `(ga) a false statement or misrepresentation on a transfer with a related person`
    `(h) assigned, underlet or parted with possession without consent`
    `(i) not occupied by the minimum number or persons the Board requires`
    `(j) the owner ceased to be a citizen or permanent resident`
    `(k) rent or payment unpaid 3 months after due, with notice of demand` HAS `months unpaid` IS A NUMBER
    `(l) a CPF cash grant not returned when required`
    `(m) a conviction for throwing things from Board property` HAS
        `age of the convicted person`                     IS A NUMBER
        `the convicted person is an authorised occupier, not the owner or spouse` IS A BOOLEAN
        `convicted on or after 1 March 1984`              IS A BOOLEAN
    `(n) an immigration harbouring conviction`
    `(o) repeated abatement or exclusion offences` HAS
        `other such offences convicted, considered or compounded` IS A NUMBER
        `the owner, or an authorised occupier who is a related person or above 18` IS A BOOLEAN
        `convicted on or after the appointed date`        IS A BOOLEAN

§§ `Upgrading works (Part 4A)`

DECLARE `Upgrading works` IS ONE OF
    `general upgrading works`
    `specified upgrading works`
    `special upgrading works`
    `flat upgrading works`
    `commercial property upgrading works`

DECLARE `Poll result` HAS
    `value in votes cast in favour`                   IS A NUMBER
    `total value in votes of all prescribed owners`   IS A NUMBER

§§ `The Board (Parts 2, 3, 5)`

DECLARE `Member facts` HAS
    `an undischarged bankrupt`                        IS A BOOLEAN
    `months of imprisonment on a Singapore conviction, unpardoned` IS A NUMBER
    `a mental disorder, incapable of managing affairs` IS A BOOLEAN
    `consecutive meetings missed without acceptable cause` IS A NUMBER
    `dead or resigned`                                IS A BOOLEAN

§§ `Offences`

DECLARE `HDA offence` IS ONE OF
    `s 13(2) using a symbol like the Board's`
    `s 14(3) using the name of the Board or "HDB"`
    `s 70 a false statement to the Board`
    `s 72(2) failing to remove a dangerous article as directed`
    `s 84(7) obstructing upgrading works`
    `s 107 obstructing an officer of the Board`
    `s 108(3) refusing access, information or a lawful demand`
    `s 108(5) refusing or misstating identity information`
    `an offence under rules made under s 31(2)(f)`
    `an offence under renovation rules made under s 31(3)(g)`

DECLARE `HDA penalty` HAS
    `fine`                        IS A NUMBER
    `imprisonment in months`      IS A NUMBER
    `fine per day continuing`     IS A NUMBER
    `fine and imprisonment both`  IS A BOOLEAN

§§ `The owner's case`

DECLARE `Flat case` HAS
    `purchase`                                        IS A `Purchase facts`
    `dealing`                                         IS A MAYBE `Dealing facts`
    `acquisition grounds`                             IS A LIST OF `Acquisition ground`
    `re-entry`                                        IS A `Re-entry facts`
    `all owners are non-citizens`                     IS A BOOLEAN    -- s 58(8)
    `a breach to be penalised instead, on`            IS A MAYBE DATE -- s 74(1)(i)-(k)
