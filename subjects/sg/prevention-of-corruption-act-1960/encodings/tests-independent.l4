§ `ss 32(1), 33 to 35, 37: procedure`

#ASSERT `every offence under the Act is deemed an arrestable offence`
#ASSERT `a District Court may try any offence under the Act and award the full punishment for it`
#ASSERT `the prosecution under the Act may be instituted` prByPP
#ASSERT `the prosecution under the Act may be instituted` prConsent
-- no consent of the Public Prosecutor
#ASSERT NOT (`the prosecution under the Act may be instituted` prNone)
#ASSERT `the court may require one or more of the persons charged to give evidence for the prosecution` prTwo
#ASSERT NOT (`the court may require one or more of the persons charged to give evidence for the prosecution` prNone)
#ASSERT `the person is entitled to a certificate of indemnity` prIndemnity
#ASSERT NOT (`the person is entitled to a certificate of indemnity` prIndemnityNoDisc)
#ASSERT NOT (`the person is entitled to a certificate of indemnity` prIndemnityNotRequired)
#ASSERT `the person may be dealt with as if the offence had been committed within Singapore` prCitizenAbroad
#ASSERT NOT (`the person may be dealt with as if the offence had been committed within Singapore` prCitizenHome)
#ASSERT NOT (`the person may be dealt with as if the offence had been committed within Singapore` prAlienAbroad)
