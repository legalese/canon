§ `The form of a charge - tests`

`Lewis Christine particulars` MEANS Particulars WITH
    accused            IS "Christine Lewis"
    date               IS "the 24th day of April 2000"
    time               IS "8.10 pm"
    place              IS "the Seiyu Departmental Store at Parkway Parade Shopping Centre"
    `co-accused`       IS ""
    `common intention` IS FALSE

`Sarjit Singh particulars` MEANS Particulars WITH
    accused            IS "Sarjit Singh Rapati"
    date               IS "10 July 2003"
    time               IS "12.30 pm"
    place              IS "Newton Hawker Centre car-park"
    `co-accused`       IS "one Paramjit Singh s/o Buta Singh (M/43 yrs, NRIC No. S1436488-I)"
    `common intention` IS TRUE

-- The reference row's assertions, unchanged: the shared machinery must frame
-- exactly what it framed there.
#ASSERT `the opening words of the charge` `Lewis Christine particulars` EQUALS "You, Christine Lewis, are charged that you, on or about the 24th day of April 2000, at about 8.10 pm, at the Seiyu Departmental Store at Parkway Parade Shopping Centre, Singapore, "
#ASSERT `the closing words of the charge` `Lewis Christine particulars` "420" EQUALS ", and you have thereby committed an offence punishable under section 420 of the Penal Code 1871."
#ASSERT `the opening words of the charge` `Sarjit Singh particulars` EQUALS "You, Sarjit Singh Rapati, are charged that you, on or about 10 July 2003, at about 12.30 pm, at Newton Hawker Centre car-park, Singapore, together with one Paramjit Singh s/o Buta Singh (M/43 yrs, NRIC No. S1436488-I) and in furtherance of the common intention of you all, "
#ASSERT `the closing words of the charge` `Sarjit Singh particulars` "384" EQUALS ", and you have thereby committed an offence punishable under section 384 read with section 34 of the Penal Code 1871."
#ASSERT `joined with` "; " (LIST "a", "b", "c") EQUALS "a; b; c"
#ASSERT `joined with` "; " (LIST "a") EQUALS "a"
#ASSERT `one` "Wong Fei Hsia" "the cashier of Seiyu Departmental Store" EQUALS "one Wong Fei Hsia, the cashier of Seiyu Departmental Store"
#ASSERT `one person` (Person WITH name IS "Wong Fei Hsia", `described as` IS "", pronoun IS she, kind IS `a human being`) EQUALS "one Wong Fei Hsia"

-- The read-with form: with no further section it is the plain closing words ...
#ASSERT `the closing words of the charge read with` `Lewis Christine particulars` "420" EMPTY EQUALS `the closing words of the charge` `Lewis Christine particulars` "420"
#ASSERT `the closing words of the charge read with` `Sarjit Singh particulars` "384" EMPTY EQUALS `the closing words of the charge` `Sarjit Singh particulars` "384"
-- ... an attempt (s 511), and an attempt with common intention
#ASSERT `the closing words of the charge read with` `Lewis Christine particulars` "379" (LIST "511") EQUALS ", and you have thereby committed an offence punishable under section 379 read with section 511 of the Penal Code 1871."
#ASSERT `the closing words of the charge read with` `Sarjit Singh particulars` "392" (LIST "511") EQUALS ", and you have thereby committed an offence punishable under section 392 read with section 511 and section 34 of the Penal Code 1871."

-- A framed charge, and a refused one, through the read-with builder
#ASSERT (`frame the charge read with` `Lewis Christine particulars` "379" (LIST "511") "attempted theft" "..." TRUE "did attempt to commit theft of one handphone" EMPTY)'s section EQUALS "379 read with 511"
#ASSERT (`frame the charge read with` `Lewis Christine particulars` "379" (LIST "511") "attempted theft" "..." TRUE "did attempt to commit theft of one handphone" EMPTY)'s text EQUALS "You, Christine Lewis, are charged that you, on or about the 24th day of April 2000, at about 8.10 pm, at the Seiyu Departmental Store at Parkway Parade Shopping Centre, Singapore, did attempt to commit theft of one handphone, and you have thereby committed an offence punishable under section 379 read with section 511 of the Penal Code 1871."
#ASSERT (`frame the charge read with` `Lewis Christine particulars` "379" (LIST "511") "attempted theft" "..." FALSE "" (LIST "a substantial step"))'s refusal EQUALS "A charge under section 379 read with section 511 would assert that the facts fulfil every legal condition of attempted theft (CPC s 123(5)). On the facts given they do not: a substantial step."
#ASSERT (`frame the charge read with` `Lewis Christine particulars` "379" (LIST "511") "attempted theft" "..." FALSE "" (LIST "a substantial step"))'s text EQUALS ""
