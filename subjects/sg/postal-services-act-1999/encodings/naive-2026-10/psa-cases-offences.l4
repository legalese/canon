§ `s 2(2) -- what is a letter`

#ASSERT `the item is a letter` `an ordinary addressed letter`
#ASSERT `the item is a letter` `a 500-gram addressed document`
#ASSERT NOT `the item is a letter` `a 600-gram addressed document`
#ASSERT NOT `the item is a letter` `an addressed catalogue`
#ASSERT NOT `the item is a letter` `an email`

§ `ss 4, 5 and 33 -- the letter monopoly`

#ASSERT `a section 5 exception applies` `a neighbour carrying 3 letters for free`
#ASSERT NOT `a section 5 exception applies` `a neighbour carrying 4 letters for free`
#ASSERT NOT `a section 5 exception applies` `a courier carrying 2 letters for a fee`
#ASSERT `a section 5 exception applies` `an employee carrying the employer's own letters`
#ASSERT NOT `a section 5 exception applies` `a consignee's letter carried with the goods for a fee`
#ASSERT `a section 5 exception applies` `a paid direct mail run`
#ASSERT `a section 5 exception applies` `a firm's paid messenger service`

#ASSERT NOT `conveying the letters is an offence under s 33` `a neighbour carrying 3 letters for free` FALSE
#ASSERT `conveying the letters is an offence under s 33` `a neighbour carrying 4 letters for free` FALSE
#ASSERT `conveying the letters is an offence under s 33` `a courier carrying 2 letters for a fee` FALSE
#ASSERT NOT `conveying the letters is an offence under s 33` `a courier carrying 2 letters for a fee` TRUE
#ASSERT `conveying the letters is an offence under s 33` `a consignee's letter carried with the goods for a fee` FALSE
#ASSERT NOT `conveying the letters is an offence under s 33` `a paid direct mail run` FALSE

§ `s 19 -- stamps bearing Singapore`

#ASSERT `providing the stamps is an offence under s 19` TRUE FALSE FALSE
#ASSERT NOT `providing the stamps is an offence under s 19` TRUE FALSE TRUE
#ASSERT NOT `providing the stamps is an offence under s 19` TRUE TRUE FALSE
#ASSERT NOT `providing the stamps is an offence under s 19` FALSE FALSE FALSE

§ `ss 36 and 39I -- other people's mail and parcels`

#ASSERT `the act is an offence under s 36` `retaining a postal article in transmission` FALSE TRUE
#ASSERT NOT `the act is an offence under s 36` `opening a letter that ought to have been delivered` FALSE TRUE
#ASSERT `the act is an offence under s 36` `opening a letter that ought to have been delivered` FALSE FALSE
#ASSERT NOT `the act is an offence under s 36` `impeding the due delivery of a letter` TRUE FALSE

#ASSERT `keeping or opening the parcel is an offence under s 39I` FALSE FALSE FALSE FALSE
#ASSERT NOT `keeping or opening the parcel is an offence under s 39I` FALSE FALSE TRUE FALSE
#ASSERT NOT `keeping or opening the parcel is an offence under s 39I` TRUE FALSE FALSE FALSE
#ASSERT NOT `keeping or opening the parcel is an offence under s 39I` FALSE FALSE FALSE TRUE

§ `s 39J -- prohibited items`

#ASSERT `placing the thing is an offence under s 39J` TRUE TRUE
#ASSERT NOT `placing the thing is an offence under s 39J` TRUE FALSE
#ASSERT NOT `placing the thing is an offence under s 39J` FALSE TRUE

§ `ss 23A and 39G -- rival parcel lockers`

#ASSERT `the place is specified premises` `HDB common property` FALSE
#ASSERT NOT `the place is specified premises` `condominium common property` FALSE
#ASSERT `the place is specified premises` `a shopping mall` TRUE

#ASSERT `operating a parcel locker there is an offence under s 39G` `HDB common property` FALSE FALSE
#ASSERT NOT `operating a parcel locker there is an offence under s 39G` `HDB common property` FALSE TRUE
#ASSERT NOT `operating a parcel locker there is an offence under s 39G` `condominium common property` FALSE FALSE
#ASSERT `operating a parcel locker there is an offence under s 39G` `an MRT station` FALSE FALSE

§ `penalties -- ss 29(7), 31, 34(2), 39E, 39H(2), 52`

#ASSERT `the maximum fine` `unlicensed conveyance of letters` EQUALS 10000
#ASSERT `the maximum fine` `damaging postal plant` EQUALS 50000
#ASSERT `the maximum fine` `damaging a public parcel locker` EQUALS 50000
#ASSERT `the maximum fine` `defacing a parcel's identifying mark` EQUALS 5000
#ASSERT `the maximum fine` `disfiguring postal plant` EQUALS 10000

#ASSERT `the maximum imprisonment in months` `unlicensed conveyance of letters` EQUALS 36
#ASSERT `the maximum imprisonment in months` `disfiguring postal plant` EQUALS 0
#ASSERT `the maximum imprisonment in months` `fraudulent official mark by a postal officer` EQUALS 12

#ASSERT `the maximum further fine for a continuing offence` 5 EQUALS 5000

§ `s 51 -- composition`

#ASSERT `the maximum composition sum` `unlicensed conveyance of letters` EQUALS 5000
#ASSERT `the maximum composition sum` `damaging postal plant` EQUALS 5000
#ASSERT `the maximum composition sum` `defacing a parcel's identifying mark` EQUALS 2500

§ `s 57 -- exclusion of liability`

#ASSERT `section 57 excludes the licensee's liability` TRUE `an accident`
#ASSERT NOT `section 57 excludes the licensee's liability` TRUE `the licensee's own default`
#ASSERT NOT `section 57 excludes the licensee's liability` FALSE `another person's act or default`
#ASSERT `section 57 excludes the licensee's liability` TRUE `another person's act or default`

