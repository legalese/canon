IMPORT prelude
IMPORT daydate

-- Cat Act 2011 (WA) and Cat Regulations 2012 — THE NOUNS.
--
-- Every entity, field and enumeration the rule modules read, and nothing
-- else: no DECIDE, no MEANS, no #EVAL. Every other module imports this one.
--
-- The membership test: could a witness of ordinary competence testify to
-- this fact, or does answering it need the Act? Only the first kind is
-- here. "The cat was implanted with a device by Dr Smith on 3 March" is a
-- fact; whether the cat is therefore "microchipped" (s 3(1), regs 5, 7, 8)
-- is a rule, and lives in cat-part1-preliminary.l4.
--
-- Sources: inputs/cat-act-2011.txt (00-l0-01, from 25 Sep 2025) and
-- inputs/cat-regulations-2012.txt (02-b0-00, from 24 Jul 2025).

§ `Cat Act 2011 — the nouns`

§§ `Other written laws a conviction can be under`

-- s 9(2)(e), s 10(b), s 37(2)(d), reg 23(b), s 74(1)(b): each counts
-- convictions "against any of the following — (i) this Act; (ii) the Dog
-- Act 1976; (iii) the Animal Welfare Act 2002".
DECLARE `Written law` IS ONE OF
    `the Cat Act 2011`
    `the Dog Act 1976`
    `the Animal Welfare Act 2002`
    `another written law`

-- s 74(1), s 9(2)(e), s 10(b): an offence "against this Act". Whether the
-- offence was against the Act itself or against subsidiary legislation made
-- under it matters (fork F-07, resolved: only the first counts).
DECLARE `Instrument offended against` IS ONE OF
    `the Act itself`
    `subsidiary legislation made under it`

DECLARE Conviction HAS
    `date of the conviction` IS A DATE
    `offence against`        IS A `Written law`
    `instrument`             IS AN `Instrument offended against`

§§ `Named bodies`

-- Every organisation the Regulations name, so that a rule can test whether
-- a body is one the Regulations prescribe. Names are the Regulations' own,
-- shortened only where the full name carries a trading name in quotes.
DECLARE Organisation IS ONE OF
    `Cat Welfare Society Inc., trading as Cat Haven`                                   -- regs 4(a), 9(2)(a), 9(3)(a)(i)
    `The Royal Society for the Prevention of Cruelty to Animals, Western Australia`   -- regs 4(b), 9(2)(b), 9(3)(a)(ii)
    `Saving Animals from Euthanasia Incorporated`                                     -- reg 9(1)(a)
    `S.A.F.E. Hedland Inc`                                                            -- reg 9(1)(b)
    `Saving Animals from Euthanasia Busselton Inc`                                    -- reg 9(1)(c)
    `the Commonwealth Department administering the Biosecurity Act 2015`              -- reg 9(2)(c)
    `Central Animal Records (Aust) Pty Ltd`                                           -- reg 6(a)
    `Global Microchip Registry Pty Ltd, trading as Global Micro Animal Registry`       -- reg 6(ba)
    `PetBase Pty Ltd, trading as Petsafe`                                             -- reg 6(c)
    `Royal Agricultural Society of NSW, trading as Australasian Animal Registry`      -- reg 6(d)
    `a local government`
    `another organisation`

-- reg 10(1)(a)-(d) and reg 23(c)(i)-(iv): the same four cat-fancy bodies.
DECLARE `Cat fancy body` IS ONE OF
    `Cat Owners' Association of Western Australia Incorporated`
    `the Feline Control Council of Western Australia (Inc)`
    `Australian National Cats Incorporated`
    `Cats United WA Incorporated`

-- reg 10(1): who held the cat show.
DECLARE `Show organiser` IS ONE OF
    `one of the cat fancy bodies` HAS `the body` IS A `Cat fancy body`
    `a body affiliated with`      HAS `the body` IS A `Cat fancy body`
    `another show organiser`

§§ `People`

DECLARE `Infringement notice outcome` IS ONE OF
    `paid`
    `dealt with by court proceedings`
    `withdrawn`
    `not yet resolved`

-- reg 22: an infringement notice "under the Act" issued to a person.
DECLARE `Infringement notice record` HAS
    `date given` IS A DATE
    `outcome`    IS AN `Infringement notice outcome`

DECLARE Person HAS
    `name`                                  IS A STRING
    `date of birth`                         IS A DATE
    `parents or guardians`                  IS A LIST OF STRING      -- names; s 4(1)(c)
    `resident in the State since`           IS A DATE                -- s 5(2)(b)
    `convictions`                           IS A LIST OF Conviction
    `infringement notices under the Act`    IS A LIST OF `Infringement notice record`   -- reg 22
    `an eligible pensioner`                 IS A BOOLEAN             -- Sch 3 cl 1(1): as defined in the Rates and Charges (Rebates and Deferments) Act 1992 s 3(1); an input
    `current memberships`                   IS A LIST OF `Cat fancy body`   -- reg 23(c)
    `a veterinarian`                        IS A BOOLEAN             -- s 3(1), Veterinary Practice Act 2021 s 3; an input
    `a veterinary nurse`                    IS A BOOLEAN             -- reg 7(1)(b); an input
    `units of competency completed`         IS A LIST OF STRING      -- reg 7(2)(a), by code, e.g. "ACMMIC401"
    `courses completed`                     IS A LIST OF STRING      -- reg 7(2)(b), by code, e.g. "ACM40412"
    `holds an approval to breed cats`       IS A BOOLEAN             -- s 3(1) "approved cat breeder", s 37

§§ `The cat`

-- reg 12(1): "either one year or 3 years; or for the life of the cat".
DECLARE `Registration term` IS ONE OF
    `one year`
    `3 years`
    `the life of the cat`

DECLARE Registration HAS
    `local government`       IS A STRING      -- the district's name, as the register records it
    `registered owner`       IS A STRING      -- s 3(1): "the person in whose name the cat is registered"
    `term`                   IS A `Registration term`
    `has effect from`        IS A DATE        -- reg 12(2)(a): "the period specified in the registration certificate"
    `cancelled on`           IS A MAYBE DATE  -- s 10

-- s 3(1) microchip; regs 5, 7, 8.
DECLARE `Implanted device` HAS
    `capable of being implanted in a cat`                        IS A BOOLEAN   -- s 3(1) microchip (a)
    `designed to record information that can be electronically retrieved` IS A BOOLEAN   -- s 3(1) microchip (b)
    `complies with AS 5018-2001`                                 IS A BOOLEAN   -- reg 5(1)(a)
    `complies with AS 5019-2001`                                 IS A BOOLEAN   -- reg 5(1)(b)
    `implanted by`                                               IS A Person
    `date implanted`                                             IS A DATE

-- s 3(1) sterilised: "made permanently infertile by a surgical procedure".
DECLARE `Sterilising procedure` HAS
    `made permanently infertile by a surgical procedure` IS A BOOLEAN
    `performed by a veterinarian`                        IS A BOOLEAN   -- s 18(1) "sterilised by a veterinarian"
    `date performed`                                     IS A DATE

-- s 14(2) and s 18(2)(a): "a certificate given by a veterinarian stating
-- that [the procedure] may adversely affect the health and welfare of the cat".
DECLARE `Veterinary certificate` HAS
    `given by a veterinarian`                                          IS A BOOLEAN
    `states the procedure may adversely affect the cat's health and welfare` IS A BOOLEAN

-- reg 9(2): who has custody of the cat.
DECLARE Custodian IS ONE OF
    `an organisation`            HAS `the organisation` IS AN Organisation
    `a cat management facility`                       -- reg 9(2)(d)
    `veterinary premises`                             -- reg 9(2)(e), as defined in the Veterinary Practice Act 2021 s 3
    `a private person`

-- reg 9(3): foster care.
DECLARE `Foster placement` HAS
    `placed by`                       IS AN Organisation
    `total weeks in foster care`      IS A NUMBER

-- s 4(1)(b) and s 5(2)(a): who ordinarily keeps and cares for the cat, and
-- since when. "an owner of a business or organisation that ... ordinarily
-- keeps and cares for the cat" is entered as that owner, with
-- `through a business or organisation` set.
DECLARE Keeping HAS
    `keeper`                                   IS A Person
    `since`                                    IS A DATE
    `through a business or organisation`       IS A BOOLEAN

DECLARE Cat HAS
    `name`                                     IS A STRING
    `date of birth`                            IS A DATE
    `district where ordinarily kept`           IS A STRING
    `kept in the State`                        IS A BOOLEAN
    `date of death`                            IS A MAYBE DATE
    `registration`                             IS A MAYBE Registration
    `registered with another local government since` IS A BOOLEAN   -- s 10(a)(iii)
    `implanted device`                         IS A MAYBE `Implanted device`
    `sterilising procedure`                    IS A MAYBE `Sterilising procedure`
    `certificate against microchipping`        IS A MAYBE `Veterinary certificate`   -- s 14(2)
    `certificate against sterilisation`        IS A MAYBE `Veterinary certificate`   -- s 18(2)(a)
    `keepings`                                 IS A LIST OF Keeping
    `name recorded as owner in a microchip database` IS A MAYBE STRING        -- s 4(2)
    `custodian`                                IS A MAYBE Custodian            -- reg 9(2)
    `foster placement`                         IS A MAYBE `Foster placement`   -- reg 9(3)
    `owned for the purpose of breeding`        IS A BOOLEAN                    -- s 18(2)(b)
    `sterilisation tattoo on the ear`          IS A BOOLEAN                    -- reg 18

-- s 6, reg 10: what was seen on one occasion.
DECLARE Occasion HAS
    `date`                                     IS A DATE
    `in a public place`                        IS A BOOLEAN
    `wearing its registration tag`             IS A BOOLEAN
    `being exhibited at a show held by`        IS A MAYBE `Show organiser`

§§ `Things done with cats`

-- s 3(1) transfer, s 22, s 23, s 24; reg 19.
DECLARE Transfer HAS
    `date of the transfer`                                  IS A DATE
    `seller`                                                IS A Person
    `purchaser`                                             IS A Person
    `purchasing for the purpose of breeding`                IS A BOOLEAN   -- s 23(2)(a)(ii)
    `seller satisfied a microchipping certificate applies`  IS A BOOLEAN   -- s 23(1)
    `seller satisfied a sterilisation certificate applies`  IS A BOOLEAN   -- s 23(2)(a)(i)
    `seller satisfied the purchaser is an approved breeder buying to breed` IS A BOOLEAN   -- s 23(2)(a)(ii)
    `voucher for later sterilisation at no cost given`      IS A BOOLEAN   -- s 23(2)(b)
    `transferred to`                                        IS A MAYBE Custodian            -- reg 19, reg 9(2)
    `transferred into foster care placed by`                IS A MAYBE Organisation         -- reg 19, reg 9(3)

-- s 8(2)(b), Sch 3: the kind of application.
DECLARE `Grant or renewal` IS ONE OF `a grant`, `a renewal`

DECLARE `Registration application` HAS
    `applicant`                   IS A Person
    `grant or renewal`            IS A `Grant or renewal`
    `term applied for`            IS A `Registration term`
    `date made`                   IS A DATE
    `date determined`             IS A DATE

-- s 9(5)-(6), s 37(3)-(4): a request for further documents or information.
DECLARE `Information request` HAS
    `days allowed`                IS A NUMBER
    `complied with in time`       IS A BOOLEAN

-- s 37(2)(b), (c), (e): matters on which the local government must be
-- "satisfied". The local government's findings are inputs (entry 8.4: a
-- determination is a record, not a flag computed here).
DECLARE `Breeding application findings` HAS
    `no, or insufficient, facilities to breed cats in a safe and ethical way` IS A BOOLEAN   -- s 37(2)(b)
    `no, or unsuitable, premises where cats can be bred in a safe and ethical way` IS A BOOLEAN   -- s 37(2)(c)
    `not a fit and proper person to breed cats`                                IS A BOOLEAN   -- s 37(2)(e)

DECLARE `Breeding application` HAS
    `applicant`                   IS A Person
    `grant or renewal`            IS A `Grant or renewal`
    `date made`                   IS A DATE
    `date determined`             IS A DATE
    `number of breeding cats`     IS A NUMBER     -- Sch 3 item 4
    `findings`                    IS A `Breeding application findings`

§§ `Cat management facilities`

-- s 3(1) cat management facility (a)-(c); reg 4.
DECLARE `Facility operator` IS ONE OF
    `operated by a local government`
    `operated by an organisation`   HAS `the organisation` IS AN Organisation
    `operated by a person or body approved in writing by a local government`
    `operated by another person or body`

DECLARE Facility HAS
    `used, or may be used, for keeping cats` IS A BOOLEAN
    `operator`                               IS A `Facility operator`

-- s 30-34: one cat's stay at a facility.
DECLARE `Facility stay` HAS
    `date the cat entered`                       IS A DATE
    `kept temporarily at the owner's request`    IS A BOOLEAN       -- s 29
    `operator knew the owner on entry`           IS A BOOLEAN       -- s 30(1), s 34(1)(a)
    `date the owner was identified`              IS A MAYBE DATE    -- s 34(1)(a)
    `date notice given under section 32`         IS A MAYBE DATE    -- s 32, s 34(1)(b)
    `holding period specified in the notice, in working days` IS A NUMBER   -- s 32(b)
    `date reclaimed`                             IS A MAYBE DATE    -- s 34(1)(b)
    `surrendered by the owner`                   IS A BOOLEAN       -- s 34(1)(c)
    `operator believes the cat feral, diseased or dangerous` IS A BOOLEAN   -- s 34(2)(a)(i)
    `operator believes the cat has caused, or is likely to cause, serious injury or illness` IS A BOOLEAN   -- s 34(2)(a)(ii)

§§ `Enforcement`

-- s 51(2)-(3): a notice of intended entry.
DECLARE `Entry notice` HAS
    `states the wish to enter`           IS A BOOLEAN    -- s 51(2)(a)
    `specifies the purpose`              IS A BOOLEAN    -- s 51(2)(b)
    `specifies the right to object`      IS A BOOLEAN    -- s 51(2)(c)
    `objection period in hours`          IS A NUMBER     -- s 51(2)(c): "not less than 24 hours"
    `specifies how to object`            IS A BOOLEAN    -- s 51(2)(d)
    `date the objection period ends`     IS A DATE
    `objection made`                     IS A BOOLEAN
    `date the purpose was effected`      IS A MAYBE DATE

-- s 44-47: a delegation.
DECLARE Delegator IS ONE OF `the local government`, `the CEO`
DECLARE Delegate  IS ONE OF `the CEO of the local government`, `an employee of the local government`, `another person`

DECLARE Delegation HAS
    `delegator`                          IS A Delegator
    `delegate`                           IS A Delegate
    `delegate is an authorised person`   IS A BOOLEAN      -- s 45(6)
    `in writing`                         IS A BOOLEAN      -- s 44(2), s 45(2)
    `decided by an absolute majority`    IS A BOOLEAN      -- s 44(3)
    `power or duty under section`        IS A NUMBER       -- the section of the Act the delegated power or duty is in

-- s 62-67: an infringement notice.
DECLARE `Infringement notice` HAS
    `date of the alleged offence`        IS A DATE
    `date given`                         IS A DATE
    `modified penalty specified`         IS A NUMBER
    `extended time to pay, in days`      IS A NUMBER     -- s 64; 0 if none allowed
    `date paid`                          IS A MAYBE DATE
    `date withdrawn`                     IS A MAYBE DATE

-- s 68-72: a decision that can be objected to and reviewed.
DECLARE `Reviewable decision` IS ONE OF
    `refusal to grant registration`             -- s 68(a), s 9
    `refusal to renew registration`             -- s 68(a), s 9; s 72(a)
    `cancellation of registration`              -- s 68(b), s 10; s 72(b)
    `refusal to grant an approval to breed`     -- s 68(c), s 37
    `refusal to renew an approval to breed`     -- s 68(c), s 37; s 72(c)
    `cancellation of an approval to breed`      -- s 68(d), s 38; s 72(d)
    `another decision`

DECLARE `Objection history` HAS
    `decision`                                   IS A `Reviewable decision`
    `date of the decision`                       IS A DATE
    `date notice of the decision was given`      IS A MAYBE DATE   -- s 13 / s 40
    `date objection lodged`                      IS A MAYBE DATE   -- s 69(2)
    `further time allowed by the local government, in days` IS A NUMBER   -- s 69(2)
    `date notice of disposal of the objection given` IS A MAYBE DATE      -- s 70(5), s 71(1)(b), (2)
    `date review applied for`                    IS A MAYBE DATE   -- s 71

-- s 74(1): sentencing a repeat offender.
DECLARE `Conviction before the court` HAS
    `offender`                                   IS A Person
    `date of the conviction`                     IS A DATE
    `against the Act`                            IS A BOOLEAN

§§ `Offences`

-- Every provision of the Act and the Regulations that carries "Penalty: a
-- fine of $5 000." — 22 in the Act (s 23 carries two), 2 in the
-- Regulations. Counted mechanically from the sources; NOTES.md shows the count.
DECLARE Offence IS ONE OF
    `s 5(1) — cat not registered`
    `s 6(1) — registered cat in a public place not wearing its tag`
    `s 7 — removing or interfering with a registration tag`
    `s 14(1) — cat not microchipped`
    `s 15 — implanter not giving the database company the prescribed information`
    `s 16 — database company not keeping the prescribed information`
    `s 17 — removing or interfering with a microchip`
    `s 18(1) — cat not sterilised`
    `s 19 — identifying as sterilised a cat that is not`
    `s 20 — veterinarian not notifying the database company of a sterilisation`
    `s 21 — veterinarian not giving a certificate of sterilisation`
    `s 23(1) — transferring a cat that is not microchipped`
    `s 23(2) — transferring a cat that is not sterilised`
    `s 24 — seller not giving notice of a transfer`
    `s 25 — owner not giving notice of a change to recorded information`
    `s 30(1) — facility operator not attempting to identify the owner`
    `s 32 — facility operator not notifying the owner`
    `s 35(1) — breeding cats without approval`
    `s 41 — offering a cat as a prize`
    `s 50(2) — refusing to give name, residence and date of birth`
    `s 54 — obstructing an authorised person`
    `s 85 — false or misleading information`
    `reg 5(2) — selling or supplying a non-complying microchip`
    `reg 5(3) — implanting a non-complying microchip`

§§ `Parties and acts, for the duties with a time limit`

DECLARE Actor IS ONE OF
    `the owner of the cat`
    `the microchip implanter`
    `the veterinarian`
    `the seller of the cat`
    `the local government`
    `the operator of the cat management facility`

DECLARE `Act required` IS ONE OF
    `give the microchip database company notice of the prescribed information`       -- s 15
    `give the microchip database company notice of the sterilisation`               -- s 20
    `give the local government notice of the purchaser and of other changes`        -- s 24(a)
    `give the microchip database company notice of the purchaser and of other changes` -- s 24(b)
    `give the local government notice of the change`                                -- s 25(a)
    `give the microchip database company notice of the change`                      -- s 25(b)
    `give notice of the decision, the reasons and the rights of objection and review` -- s 13, s 40

§§ `Authorised persons and seizures`

-- s 3(1) "authorised person means — (a) a police officer; or (ba) a person
-- designated as an authorised officer under the Public Health Act 2016
-- section 24(1) for the purposes of this Act; or (b) a person appointed under
-- the Local Government Act 1995 section 9.10(2) to be an authorised person
-- for the purposes of this Act".
DECLARE Authorisation IS ONE OF
    `a police officer`
    `designated under the Public Health Act 2016 s 24(1) for the purposes of the Cat Act`
    `appointed under the Local Government Act 1995 s 9.10(2) for the purposes of the Cat Act`
    `no authorisation under the Cat Act`

DECLARE Officer HAS
    `authorisation`                      IS AN Authorisation
    `an employee of the local government` IS A BOOLEAN    -- s 62(3)

-- s 27: where, and on what footing, a cat was seized.
DECLARE `Place of seizure` IS ONE OF
    `a public place`
    `premises lawfully entered`
    `elsewhere`

DECLARE Seizure HAS
    `place`                                                    IS A `Place of seizure`
    `believes or suspects on reasonable grounds the cat is the subject of an offence` IS A BOOLEAN   -- s 27(a)
    `at the request or with the consent of the owner or occupier` IS A BOOLEAN   -- s 27(b)(i)
    `under a warrant issued under Part 4 Division 3 Subdivision 3` IS A BOOLEAN  -- s 27(b)(ii)

§§ `At the cat management facility`

-- s 30: the operator's attempt to identify the owner.
DECLARE `Identification attempt` HAS
    `made every reasonable attempt as soon as practicable`  IS A BOOLEAN
    `scanning was possible`                                 IS A BOOLEAN
    `scanned the cat`                                       IS A BOOLEAN
    `the cat behaved aggressively`                          IS A BOOLEAN   -- s 30(2)(a)
    `believed on reasonable grounds scanning was dangerous` IS A BOOLEAN   -- s 30(2)(b)

-- s 32: the notice to an identified owner.
DECLARE `Section 32 notice` HAS
    `states the facility's name and address`                       IS A BOOLEAN   -- (a)
    `states the cat may be re-housed, offered for sale or destroyed if not reclaimed` IS A BOOLEAN   -- (b)
    `holding period specified, in working days`                    IS A NUMBER    -- (b)
    `states the costs the owner may be liable for under s 31`      IS A BOOLEAN   -- (c)
    `states the cat is to be microchipped unless shown exempt`     IS A BOOLEAN   -- (d)(i)
    `states the cat is to be sterilised unless shown exempt`       IS A BOOLEAN   -- (d)(ii)

-- s 31(1)(a)-(e): reasonable costs incurred, in dollars.
DECLARE `Facility costs` HAS
    `removing and impounding the cat`                IS A NUMBER   -- (a)
    `keeping and caring for the cat`                 IS A NUMBER   -- (b)
    `implanting a microchip under section 33`        IS A NUMBER   -- (c)
    `sterilising the cat under section 33`           IS A NUMBER   -- (d)
    `destroying and disposing of the cat under section 34` IS A NUMBER   -- (e)

§§ `Inputs to particular sections`

-- s 6(3): the defence findings.
DECLARE `Section 6(3) findings` HAS
    `due to the act or default of another person`        IS A BOOLEAN
    `due to an accident`                                  IS A BOOLEAN
    `due to some other cause beyond the accused's control` IS A BOOLEAN
    `took reasonable precautions`                         IS A BOOLEAN
    `could not by due diligence have prevented it`        IS A BOOLEAN

-- s 19, reg 18(1): how someone identified a cat as sterilised.
DECLARE `Means of identifying a cat as sterilised` IS ONE OF
    `a sterilisation certificate given under section 21`
    `a sterilisation tattoo on the cat's ear`
    `some other means`

-- s 25: a change to recorded information.
DECLARE `Change to recorded information` HAS
    `date of the change`                       IS A DATE
    `changes reg 16 register information`      IS A BOOLEAN
    `changes reg 17 database information`      IS A BOOLEAN
