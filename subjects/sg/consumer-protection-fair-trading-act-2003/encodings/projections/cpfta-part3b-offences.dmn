  <decision id="decision_the_maximum_penalty_for_the_offence" name="the_maximum_penalty_for_the_offence" label="the maximum penalty for the offence">
    <variable id="decision_the_maximum_penalty_for_the_offence_var" name="the_maximum_penalty_for_the_offence" label="the maximum penalty for the offence" typeRef="Any"/>
    <informationRequirement id="decision_the_maximum_penalty_for_the_offence_ir1">
      <requiredInput href="#input_k"/>
    </informationRequirement>
    <decisionTable id="decision_the_maximum_penalty_for_the_offence_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the maximum penalty for the offence">
      <input id="decision_the_maximum_penalty_for_the_offence_i1" label="k">
        <inputExpression id="decision_the_maximum_penalty_for_the_offence_i1_expr" typeRef="string">
          <text>k</text>
        </inputExpression>
      </input>
      <output id="decision_the_maximum_penalty_for_the_offence_o1"/>
      <rule id="decision_the_maximum_penalty_for_the_offence_r1">
        <description>k EQUALS `an offence of failing to comply with a requirement (section 27)`</description>
        <inputEntry id="decision_the_maximum_penalty_for_the_offence_r1_i1">
          <text>"an offence of failing to comply with a requirement (section 27)"</text>
        </inputEntry>
        <outputEntry id="decision_the_maximum_penalty_for_the_offence_r1_o1">
          <text>Penalty OF 10000, 12</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_maximum_penalty_for_the_offence_r2">
        <description>k EQUALS `an offence of destroying or falsifying documents (section 28)`</description>
        <inputEntry id="decision_the_maximum_penalty_for_the_offence_r2_i1">
          <text>"an offence of destroying or falsifying documents (section 28)"</text>
        </inputEntry>
        <outputEntry id="decision_the_maximum_penalty_for_the_offence_r2_o1">
          <text>Penalty OF 10000, 12</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_maximum_penalty_for_the_offence_r3">
        <description>k EQUALS `an offence of giving false or misleading information (section 29)`</description>
        <inputEntry id="decision_the_maximum_penalty_for_the_offence_r3_i1">
          <text>"an offence of giving false or misleading information (section 29)"</text>
        </inputEntry>
        <outputEntry id="decision_the_maximum_penalty_for_the_offence_r3_o1">
          <text>Penalty OF 10000, 12</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_maximum_penalty_for_the_offence_r4">
        <description>k EQUALS `an offence of obstructing an officer of the Commission (section 30)`</description>
        <inputEntry id="decision_the_maximum_penalty_for_the_offence_r4_i1">
          <text>"an offence of obstructing an officer of the Commission (section 30)"</text>
        </inputEntry>
        <outputEntry id="decision_the_maximum_penalty_for_the_offence_r4_o1">
          <text>Penalty OF 10000, 12</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_defence_in_section_27_2_is_made_out" name="the_defence_in_section_27_2_is_made_out" label="the defence in section 27(2) is made out">
    <variable id="decision_the_defence_in_section_27_2_is_made_out_var" name="the_defence_in_section_27_2_is_made_out" label="the defence in section 27(2) is made out" typeRef="boolean"/>
    <informationRequirement id="decision_the_defence_in_section_27_2_is_made_out_ir1">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_defence_in_section_27_2_is_made_out_literal">
      <text>r.the_requirement_is_to_produce_a_document and (not(r.the_document_was_in_the_person_s_possession_or_under_the_person_s_control) and not(r.it_was_reasonably_practicable_for_the_person_to_comply))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_defence_in_section_27_3_is_made_out" name="the_defence_in_section_27_3_is_made_out" label="the defence in section 27(3) is made out">
    <variable id="decision_the_defence_in_section_27_3_is_made_out_var" name="the_defence_in_section_27_3_is_made_out" label="the defence in section 27(3) is made out" typeRef="boolean"/>
    <informationRequirement id="decision_the_defence_in_section_27_3_is_made_out_ir1">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_defence_in_section_27_3_is_made_out_literal">
      <text>r.the_requirement_is_to_provide_information_to_provide_an_explanation_of_a_document_or_to_state_where_a_document_is_to_be_found and r.the_person_had_a_reasonable_excuse_for_failing_to_comply</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_guilty_of_an_offence_under_section_27_1" name="the_person_is_guilty_of_an_offence_under_section_27_1" label="the person is guilty of an offence under section 27(1)">
    <variable id="decision_the_person_is_guilty_of_an_offence_under_section_27_1_var" name="the_person_is_guilty_of_an_offence_under_section_27_1" label="the person is guilty of an offence under section 27(1)" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_guilty_of_an_offence_under_section_27_1_ir1">
      <requiredDecision href="#decision_the_defence_in_section_27_2_is_made_out"/>
    </informationRequirement>
    <informationRequirement id="decision_the_person_is_guilty_of_an_offence_under_section_27_1_ir2">
      <requiredDecision href="#decision_the_defence_in_section_27_3_is_made_out"/>
    </informationRequirement>
    <informationRequirement id="decision_the_person_is_guilty_of_an_offence_under_section_27_1_ir3">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_guilty_of_an_offence_under_section_27_1_literal">
      <text>r.the_person_fails_to_comply_with_a_requirement_imposed_under_section_20_21_22_24_or_25 and (not(r.the_person_imposing_the_requirement_failed_to_act_in_accordance_with_the_section_under_which_it_was_imposed) and (not(the_defence_in_section_27_2_is_made_out) and not(the_defence_in_section_27_3_is_made_out)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_guilty_of_an_offence_under_section_28" name="the_person_is_guilty_of_an_offence_under_section_28" label="the person is guilty of an offence under section 28">
    <variable id="decision_the_person_is_guilty_of_an_offence_under_section_28_var" name="the_person_is_guilty_of_an_offence_under_section_28" label="the person is guilty of an offence under section 28" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_guilty_of_an_offence_under_section_28_ir1">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_guilty_of_an_offence_under_section_28_literal">
      <text>d.the_person_has_been_required_to_produce_a_document_under_section_20_21_22_or_24 and (d.the_person_intentionally_or_recklessly_destroys_disposes_of_falsifies_or_conceals_the_document or d.the_person_causes_or_permits_the_destruction_disposal_falsification_or_concealment_of_the_document)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_guilty_of_an_offence_under_section_29" name="the_person_is_guilty_of_an_offence_under_section_29" label="the person is guilty of an offence under section 29">
    <variable id="decision_the_person_is_guilty_of_an_offence_under_section_29_var" name="the_person_is_guilty_of_an_offence_under_section_29" label="the person is guilty of an offence under section 29" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_guilty_of_an_offence_under_section_29_ir1">
      <requiredInput href="#input_f"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_guilty_of_an_offence_under_section_29_literal">
      <text>(f.the_person_provides_information_to_the_Commission_an_investigation_officer_or_an_authorised_assistant_in_connection_with_an_investigation_under_section_19_1_or_an_offence_in_Part_3B or f.the_person_provides_information_to_another_person_knowing_it_is_to_be_used_to_provide_information_to_the_Commission_an_investigation_officer_or_an_authorised_assistant_in_connection_with_a_function_or_duty_under_the_Act) and (f.the_information_is_false_or_misleading_in_a_material_particular and (f.the_person_knows_the_information_to_be_false_or_misleading_in_a_material_particular or f.the_person_is_reckless_as_to_whether_the_information_is_false_or_misleading_in_a_material_particular))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_guilty_of_an_offence_under_section_30" name="the_person_is_guilty_of_an_offence_under_section_30" label="the person is guilty of an offence under section 30">
    <variable id="decision_the_person_is_guilty_of_an_offence_under_section_30_var" name="the_person_is_guilty_of_an_offence_under_section_30" label="the person is guilty of an offence under section 30" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_guilty_of_an_offence_under_section_30_ir1">
      <requiredInput href="#input_o"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_guilty_of_an_offence_under_section_30_literal">
      <text>o.the_person_obstructs_hinders_or_impedes_a_member_officer_or_employee_of_the_Commission_or_an_investigation_officer_or_authorised_assistant and (o.the_person_does_so_in_the_discharge_of_duties_or_the_exercise_of_powers_under_the_Act_or_its_regulations and not(o.the_person_has_a_reasonable_excuse))</text>
    </literalExpression>
  </decision>
  <decision id="decision_costs_damages_or_other_relief_is_barred" name="costs_damages_or_other_relief_is_barred" label="costs, damages or other relief is barred">
    <variable id="decision_costs_damages_or_other_relief_is_barred_var" name="costs_damages_or_other_relief_is_barred" label="costs, damages or other relief is barred" typeRef="boolean"/>
    <informationRequirement id="decision_costs_damages_or_other_relief_is_barred_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_costs_damages_or_other_relief_is_barred_literal">
      <text>p.the_proceedings_are_before_a_court_in_respect_of_equipment_goods_an_article_or_a_document_seized_in_the_exercise_or_purported_exercise_of_a_power_under_the_Act and (not(p.the_relief_sought_is_an_order_for_the_return_of_the_item_or_the_payment_of_its_value) and not(p.the_seizure_was_made_without_reasonable_or_probable_cause))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_state_of_mind_of_the_body_is_evidenced" name="the_state_of_mind_of_the_body_is_evidenced" label="the state of mind of the body is evidenced">
    <variable id="decision_the_state_of_mind_of_the_body_is_evidenced_var" name="the_state_of_mind_of_the_body_is_evidenced" label="the state of mind of the body is evidenced" typeRef="boolean"/>
    <informationRequirement id="decision_the_state_of_mind_of_the_body_is_evidenced_ir1">
      <requiredInput href="#input_k_2"/>
    </informationRequirement>
    <informationRequirement id="decision_the_state_of_mind_of_the_body_is_evidenced_ir2">
      <requiredInput href="#input_m"/>
    </informationRequirement>
    <literalExpression id="decision_the_state_of_mind_of_the_body_is_evidenced_literal">
      <text>m's `it is necessary in a proceeding for an offence under the Act to prove the state of mind of the body in relation to particular conduct` AND m's `that person had that state of mind` AND (CONSIDER k WHEN `a corporation, including a limited liability partnership` THEN m's `an officer of the body engaged in that conduct within the scope of actual or apparent authority` OR m's `an employee of the body engaged in that conduct within the scope of actual or apparent authority` OR m's `an agent of the body engaged in that conduct within the scope of actual or apparent authority` OTHERWISE m's `an employee of the body engaged in that conduct within the scope of actual or apparent authority` OR m's `an agent of the body engaged in that conduct within the scope of actual or apparent authority`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches" name="the_person_is_in_a_role_that_section_32_2_or_33_2_reaches" label="the person is in a role that section 32(2) or 33(2) reaches">
    <variable id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_var" name="the_person_is_in_a_role_that_section_32_2_or_33_2_reaches" label="the person is in a role that section 32(2) or 33(2) reaches" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_ir1">
      <requiredInput href="#input_b"/>
    </informationRequirement>
    <decisionTable id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_table" hitPolicy="FIRST" preferredOrientation="Rule-as-Row" outputLabel="the person is in a role that section 32(2) or 33(2) reaches">
      <input id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_i1" label="b&apos;s `kind of body`">
        <inputExpression id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_i1_expr" typeRef="string">
          <text>b.kind_of_body</text>
        </inputExpression>
      </input>
      <input id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_i2" label="b&apos;s `the person&apos;s role`">
        <inputExpression id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_i2_expr" typeRef="string">
          <text>b.the_person_s_role</text>
        </inputExpression>
      </input>
      <output id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_o1"/>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r1">
        <description>(b's `kind of body`) EQUALS `a corporation, including a limited liability partnership` AND (b's `the person's role`) EQUALS `none of those`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r1_i1">
          <text>"a corporation, including a limited liability partnership"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r1_i2">
          <text>"none of those"</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r1_o1">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r2">
        <description>(b's `kind of body`) EQUALS `a corporation, including a limited liability partnership`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r2_i1">
          <text>"a corporation, including a limited liability partnership"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r2_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r2_o1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r3">
        <description>(b's `kind of body`) EQUALS `an unincorporated association` AND (b's `the person's role`) EQUALS `an officer of the corporation, unincorporated association or a member of its governing body`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r3_i1">
          <text>"an unincorporated association"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r3_i2">
          <text>"an officer of the corporation, unincorporated association or a member of its governing body"</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r3_o1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r4">
        <description>(b's `kind of body`) EQUALS `an unincorporated association` AND (b's `the person's role`) EQUALS `an individual involved in the management of the body who is in a position to influence its conduct in relation to the commission of the offence`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r4_i1">
          <text>"an unincorporated association"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r4_i2">
          <text>"an individual involved in the management of the body who is in a position to influence its conduct in relation to the commission of the offence"</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r4_o1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r5">
        <description>(b's `kind of body`) EQUALS `an unincorporated association`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r5_i1">
          <text>"an unincorporated association"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r5_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r5_o1">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r6">
        <description>(b's `kind of body`) EQUALS `a partnership` AND (b's `the person's role`) EQUALS `a partner, or a person purporting to act as a partner`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r6_i1">
          <text>"a partnership"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r6_i2">
          <text>"a partner, or a person purporting to act as a partner"</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r6_o1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r7">
        <description>(b's `kind of body`) EQUALS `a partnership` AND (b's `the person's role`) EQUALS `an individual involved in the management of the body who is in a position to influence its conduct in relation to the commission of the offence`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r7_i1">
          <text>"a partnership"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r7_i2">
          <text>"an individual involved in the management of the body who is in a position to influence its conduct in relation to the commission of the offence"</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r7_o1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r8">
        <description>(b's `kind of body`) EQUALS `a partnership`</description>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r8_i1">
          <text>"a partnership"</text>
        </inputEntry>
        <inputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r8_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches_r8_o1">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches" name="the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches" label="the person did one of the things that section 32(2) or 33(2) reaches">
    <variable id="decision_the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches_var" name="the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches" label="the person did one of the things that section 32(2) or 33(2) reaches" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches_ir1">
      <requiredInput href="#input_b"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches_literal">
      <text>b.the_person_consented_or_connived_or_conspired_with_others_to_effect_the_commission_of_the_offence or (b.the_person_is_in_any_other_way_by_act_or_omission_knowingly_concerned_in_or_party_to_the_commission_of_the_offence or b.the_person_knew_or_ought_reasonably_to_have_known_that_the_offence_or_an_offence_of_the_same_type_would_be_or_is_being_committed and b.the_person_failed_to_take_all_reasonable_steps_to_prevent_or_stop_the_commission_of_the_offence)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_guilty_of_the_same_offence_as_the_body" name="the_person_is_guilty_of_the_same_offence_as_the_body" label="the person is guilty of the same offence as the body">
    <variable id="decision_the_person_is_guilty_of_the_same_offence_as_the_body_var" name="the_person_is_guilty_of_the_same_offence_as_the_body" label="the person is guilty of the same offence as the body" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_guilty_of_the_same_offence_as_the_body_ir1">
      <requiredDecision href="#decision_the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches"/>
    </informationRequirement>
    <informationRequirement id="decision_the_person_is_guilty_of_the_same_offence_as_the_body_ir2">
      <requiredDecision href="#decision_the_person_is_in_a_role_that_section_32_2_or_33_2_reaches"/>
    </informationRequirement>
    <informationRequirement id="decision_the_person_is_guilty_of_the_same_offence_as_the_body_ir3">
      <requiredInput href="#input_b"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_guilty_of_the_same_offence_as_the_body_literal">
      <text>b.the_body_commits_an_offence_under_the_Act and (the_person_is_in_a_role_that_section_32_2_or_33_2_reaches and the_person_did_one_of_the_things_that_section_32_2_or_33_2_reaches)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_most_that_may_be_collected_in_composition" name="the_most_that_may_be_collected_in_composition" label="the most that may be collected in composition">
    <variable id="decision_the_most_that_may_be_collected_in_composition_var" name="the_most_that_may_be_collected_in_composition" label="the most that may be collected in composition" typeRef="number"/>
    <informationRequirement id="decision_the_most_that_may_be_collected_in_composition_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_most_that_may_be_collected_in_composition_literal">
      <text>min(c.the_maximum_fine_prescribed_for_the_offence / 2, 5000)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_offence_may_be_compounded_for_the_sum_proposed" name="the_offence_may_be_compounded_for_the_sum_proposed" label="the offence may be compounded for the sum proposed">
    <variable id="decision_the_offence_may_be_compounded_for_the_sum_proposed_var" name="the_offence_may_be_compounded_for_the_sum_proposed" label="the offence may be compounded for the sum proposed" typeRef="boolean"/>
    <informationRequirement id="decision_the_offence_may_be_compounded_for_the_sum_proposed_ir1">
      <requiredDecision href="#decision_the_most_that_may_be_collected_in_composition"/>
    </informationRequirement>
    <informationRequirement id="decision_the_offence_may_be_compounded_for_the_sum_proposed_ir2">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_offence_may_be_compounded_for_the_sum_proposed_literal">
      <text>c.the_offence_is_prescribed_as_a_compoundable_offence and (c.the_person_compounding_is_the_chief_executive_or_an_officer_of_the_Commission_authorised_by_the_chief_executive and c.the_sum_proposed_to_be_collected &lt;= the_most_that_may_be_collected_in_composition)</text>
    </literalExpression>
  </decision>
  <decision id="decision_no_further_proceedings_may_be_taken_against_the_person_in_respect_of_the_offence" name="no_further_proceedings_may_be_taken_against_the_person_in_respect_of_the_offence" label="no further proceedings may be taken against the person in respect of the offence">
    <variable id="decision_no_further_proceedings_may_be_taken_against_the_person_in_respect_of_the_offence_var" name="no_further_proceedings_may_be_taken_against_the_person_in_respect_of_the_offence" label="no further proceedings may be taken against the person in respect of the offence" typeRef="boolean"/>
    <informationRequirement id="decision_no_further_proceedings_may_be_taken_against_the_person_in_respect_of_the_offence_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_no_further_proceedings_may_be_taken_against_the_person_in_respect_of_the_offence_literal">
      <text>c.the_sum_has_been_paid</text>
    </literalExpression>
  </decision>
  <decision id="decision_no_regulations_under_section_43_2_n_prescribing_compoundable_offences_are_encoded_in_this_model" name="no_regulations_under_section_43_2_n_prescribing_compoundable_offences_are_encoded_in_this_model" label="no regulations under section 43(2)(n) prescribing compoundable offences are encoded in this model">
    <description>REFUSE: no regulations under section 43(2)(n) prescribing compoundable offences are encoded in this model</description>
    <variable id="decision_no_regulations_under_section_43_2_n_prescribing_compoundable_offences_are_encoded_in_this_model_var" name="no_regulations_under_section_43_2_n_prescribing_compoundable_offences_are_encoded_in_this_model" label="no regulations under section 43(2)(n) prescribing compoundable offences are encoded in this model" typeRef="boolean"/>
    <literalExpression id="decision_no_regulations_under_section_43_2_n_prescribing_compoundable_offences_are_encoded_in_this_model_literal">
      <text>null</text>
    </literalExpression>
  </decision>
