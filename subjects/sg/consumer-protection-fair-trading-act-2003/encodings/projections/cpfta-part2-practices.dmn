<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_part_2_unfair_practices" name="Part 2 -- Unfair practices" namespace="https://legalese.com/l4/dmn/part_2_unfair_practices" exporter="jl4">
  <inputData id="input_a" name="a">
    <variable id="input_a_var" name="a" typeRef="Any"/>
  </inputData>
  <inputData id="input_u" name="u">
    <variable id="input_u_var" name="u" typeRef="Any"/>
  </inputData>
  <inputData id="input_a_2" name="a_2" label="a">
    <variable id="input_a_2_var" name="a_2" label="a" typeRef="Any"/>
  </inputData>
  <inputData id="input_f" name="f">
    <variable id="input_f_var" name="f" typeRef="Any"/>
  </inputData>
  <inputData id="input_g" name="g">
    <variable id="input_g_var" name="g" typeRef="Any"/>
  </inputData>
  <inputData id="input_r" name="r">
    <variable id="input_r_var" name="r" typeRef="Any"/>
  </inputData>
  <inputData id="input_p" name="p">
    <variable id="input_p_var" name="p" typeRef="Any"/>
  </inputData>
  <decision id="decision_part_2_applies" name="Part_2_applies" label="Part 2 applies">
    <variable id="decision_part_2_applies_var" name="Part_2_applies" label="Part 2 applies" typeRef="boolean"/>
    <informationRequirement id="decision_part_2_applies_ir1">
      <requiredInput href="#input_a"/>
    </informationRequirement>
    <literalExpression id="decision_part_2_applies_literal">
      <text>a.the_supplier_is_resident_in_Singapore or (a.the_consumer_is_resident_in_Singapore or (a.the_offer_relating_to_the_consumer_transaction_is_made_in_Singapore or (a.the_offer_relating_to_the_consumer_transaction_is_sent_from_Singapore or (a.the_acceptance_relating_to_the_consumer_transaction_is_made_in_Singapore or a.the_acceptance_relating_to_the_consumer_transaction_is_sent_from_Singapore))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_section_4_a_is_satisfied" name="section_4_a_is_satisfied" label="section 4(a) is satisfied">
    <variable id="decision_section_4_a_is_satisfied_var" name="section_4_a_is_satisfied" label="section 4(a) is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_section_4_a_is_satisfied_ir1">
      <requiredInput href="#input_u"/>
    </informationRequirement>
    <literalExpression id="decision_section_4_a_is_satisfied_literal">
      <text>u.the_supplier_does_or_says_something_or_omits_to_do_or_say_something and u.as_a_result_a_consumer_might_reasonably_be_deceived_or_misled</text>
    </literalExpression>
  </decision>
  <decision id="decision_section_4_b_is_satisfied" name="section_4_b_is_satisfied" label="section 4(b) is satisfied">
    <variable id="decision_section_4_b_is_satisfied_var" name="section_4_b_is_satisfied" label="section 4(b) is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_section_4_b_is_satisfied_ir1">
      <requiredInput href="#input_u"/>
    </informationRequirement>
    <literalExpression id="decision_section_4_b_is_satisfied_literal">
      <text>u.the_supplier_makes_a_false_claim</text>
    </literalExpression>
  </decision>
  <decision id="decision_section_4_c_is_satisfied" name="section_4_c_is_satisfied" label="section 4(c) is satisfied">
    <variable id="decision_section_4_c_is_satisfied_var" name="section_4_c_is_satisfied" label="section 4(c) is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_section_4_c_is_satisfied_ir1">
      <requiredInput href="#input_u"/>
    </informationRequirement>
    <literalExpression id="decision_section_4_c_is_satisfied_literal">
      <text>u.the_supplier_takes_advantage_of_a_consumer and (u.the_supplier_knows_or_ought_reasonably_to_know_that_the_consumer_is_not_in_a_position_to_protect_his_or_her_own_interests or u.the_supplier_knows_or_ought_reasonably_to_know_that_the_consumer_is_not_reasonably_able_to_understand_the_character_nature_language_or_effect_of_the_transaction_or_any_matter_related_to_the_transaction)</text>
    </literalExpression>
  </decision>
  <decision id="decision_section_4_d_is_satisfied" name="section_4_d_is_satisfied" label="section 4(d) is satisfied">
    <variable id="decision_section_4_d_is_satisfied_var" name="section_4_d_is_satisfied" label="section 4(d) is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_section_4_d_is_satisfied_ir1">
      <requiredDecision href="#decision_the_practice_is_specified_in_the_second_schedule"/>
    </informationRequirement>
    <informationRequirement id="decision_section_4_d_is_satisfied_ir2">
      <requiredDecision href="#decision_the_representation_is_made_and_is_untrue"/>
    </informationRequirement>
    <informationRequirement id="decision_section_4_d_is_satisfied_ir3">
      <requiredInput href="#input_u"/>
    </informationRequirement>
    <literalExpression id="decision_section_4_d_is_satisfied_literal">
      <text>any OF (GIVEN p YIELD `the practice is specified in the Second Schedule` OF p), (u's `the practices specified in the Second Schedule that the supplier engages in`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_supplier_engages_in_an_unfair_practice" name="the_supplier_engages_in_an_unfair_practice" label="the supplier engages in an unfair practice">
    <variable id="decision_the_supplier_engages_in_an_unfair_practice_var" name="the_supplier_engages_in_an_unfair_practice" label="the supplier engages in an unfair practice" typeRef="boolean"/>
    <informationRequirement id="decision_the_supplier_engages_in_an_unfair_practice_ir1">
      <requiredDecision href="#decision_section_4_a_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_the_supplier_engages_in_an_unfair_practice_ir2">
      <requiredDecision href="#decision_section_4_b_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_the_supplier_engages_in_an_unfair_practice_ir3">
      <requiredDecision href="#decision_section_4_c_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_the_supplier_engages_in_an_unfair_practice_ir4">
      <requiredDecision href="#decision_section_4_d_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_the_supplier_engages_in_an_unfair_practice_ir5">
      <requiredInput href="#input_u"/>
    </informationRequirement>
    <literalExpression id="decision_the_supplier_engages_in_an_unfair_practice_literal">
      <text>u.the_supplier_acts_in_relation_to_a_consumer_transaction and (section_4_a_is_satisfied or (section_4_b_is_satisfied or (section_4_c_is_satisfied or section_4_d_is_satisfied)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_act_or_omission_of_an_employee_or_agent_is_also_that_of_the_person" name="the_act_or_omission_of_an_employee_or_agent_is_also_that_of_the_person" label="the act or omission of an employee or agent is also that of the person">
    <variable id="decision_the_act_or_omission_of_an_employee_or_agent_is_also_that_of_the_person_var" name="the_act_or_omission_of_an_employee_or_agent_is_also_that_of_the_person" label="the act or omission of an employee or agent is also that of the person" typeRef="boolean"/>
    <informationRequirement id="decision_the_act_or_omission_of_an_employee_or_agent_is_also_that_of_the_person_ir1">
      <requiredInput href="#input_a_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_act_or_omission_of_an_employee_or_agent_is_also_that_of_the_person_literal">
      <text>a_2.the_act_or_omission_is_that_of_an_employee and a_2.the_employee_acted_in_the_course_of_the_employee_s_employment_with_the_person or a_2.the_act_or_omission_is_that_of_an_agent and (a_2.the_agent_was_exercising_powers_or_performing_duties_on_behalf_of_the_person and a_2.the_agent_acted_within_the_scope_of_the_agent_s_actual_or_apparent_authority)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_goods_or_services_were_requested_by_the_consumer" name="the_goods_or_services_were_requested_by_the_consumer" label="the goods or services were requested by the consumer">
    <variable id="decision_the_goods_or_services_were_requested_by_the_consumer_var" name="the_goods_or_services_were_requested_by_the_consumer" label="the goods or services were requested by the consumer" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_or_services_were_requested_by_the_consumer_ir1">
      <requiredInput href="#input_f"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_or_services_were_requested_by_the_consumer_literal">
      <text>f.the_consumer_requested_the_goods_or_services and not(f.the_only_ground_for_finding_a_request_is_one_of_payment_use_dealing_or_disposal_a_request_to_purchase_another_similar_good_or_service_or_inaction)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_consumer_consented_to_the_material_change" name="the_consumer_consented_to_the_material_change" label="the consumer consented to the material change">
    <variable id="decision_the_consumer_consented_to_the_material_change_var" name="the_consumer_consented_to_the_material_change" label="the consumer consented to the material change" typeRef="boolean"/>
    <informationRequirement id="decision_the_consumer_consented_to_the_material_change_ir1">
      <requiredInput href="#input_f"/>
    </informationRequirement>
    <literalExpression id="decision_the_consumer_consented_to_the_material_change_literal">
      <text>f.the_consumer_consented_in_writing_to_the_material_change and not(f.the_only_ground_for_finding_consent_to_the_material_change_is_payment_use_dealing_or_disposal_a_request_to_purchase_another_similar_good_or_service_or_inaction)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a" name="the_goods_or_services_are_unsolicited_under_paragraph_1_a" label="the goods or services are unsolicited under paragraph 1(a)">
    <variable id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a_var" name="the_goods_or_services_are_unsolicited_under_paragraph_1_a" label="the goods or services are unsolicited under paragraph 1(a)" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a_ir1">
      <requiredDecision href="#decision_the_goods_or_services_were_requested_by_the_consumer"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a_ir2">
      <requiredInput href="#input_f"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a_literal">
      <text>f.the_goods_or_services_are_supplied_in_relation_to_a_consumer_transaction_to_a_consumer and (not(the_goods_or_services_were_requested_by_the_consumer) and not(f.the_consumer_knows_or_ought_to_have_known_that_the_goods_or_services_were_intended_for_delivery_to_another_person and not(f.it_was_reasonable_to_believe_that_the_goods_or_services_if_delivered_to_that_other_person_would_have_been_unsolicited)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b" name="the_goods_or_services_are_unsolicited_under_paragraph_1_b" label="the goods or services are unsolicited under paragraph 1(b)">
    <variable id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b_var" name="the_goods_or_services_are_unsolicited_under_paragraph_1_b" label="the goods or services are unsolicited under paragraph 1(b)" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b_ir1">
      <requiredDecision href="#decision_the_consumer_consented_to_the_material_change"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b_ir2">
      <requiredInput href="#input_f"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b_literal">
      <text>f.the_goods_or_services_are_supplied_on_a_continuing_basis and (f.there_is_a_material_change_in_the_goods_or_services_or_in_their_supply and not(the_consumer_consented_to_the_material_change))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_goods_or_services_are_unsolicited_goods_or_services" name="the_goods_or_services_are_unsolicited_goods_or_services" label="the goods or services are unsolicited goods or services">
    <variable id="decision_the_goods_or_services_are_unsolicited_goods_or_services_var" name="the_goods_or_services_are_unsolicited_goods_or_services" label="the goods or services are unsolicited goods or services" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_goods_or_services_ir1">
      <requiredDecision href="#decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_goods_or_services_ir2">
      <requiredDecision href="#decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_or_services_are_unsolicited_goods_or_services_ir3">
      <requiredInput href="#input_f"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_or_services_are_unsolicited_goods_or_services_literal">
      <text>the_goods_or_services_are_unsolicited_under_paragraph_1_a or the_goods_or_services_are_unsolicited_under_paragraph_1_b</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_agreement_is_an_applicable_agreement" name="the_agreement_is_an_applicable_agreement" label="the agreement is an applicable agreement">
    <variable id="decision_the_agreement_is_an_applicable_agreement_var" name="the_agreement_is_an_applicable_agreement" label="the agreement is an applicable agreement" typeRef="boolean"/>
    <informationRequirement id="decision_the_agreement_is_an_applicable_agreement_ir1">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_agreement_is_an_applicable_agreement_literal">
      <text>g.the_agreement_is_between_a_supplier_and_a_consumer_for_the_supply_of_goods_or_services and (g.the_agreement_expressly_provides_that_the_goods_or_services_will_not_be_supplied_or_begin_to_be_supplied_until_the_price_or_part_of_the_price_has_been_paid and (g.the_agreement_expressly_provides_that_the_price_is_to_be_paid_by_instalments and g.the_number_of_instalments_not_counting_any_deposit + (if g.the_consumer_has_paid_a_deposit then 1 else 0) &gt;= 2))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_representation_is_made_and_is_untrue" name="the_representation_is_made_and_is_untrue" label="the representation is made and is untrue">
    <variable id="decision_the_representation_is_made_and_is_untrue_var" name="the_representation_is_made_and_is_untrue" label="the representation is made and is untrue" typeRef="boolean"/>
    <informationRequirement id="decision_the_representation_is_made_and_is_untrue_ir1">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_representation_is_made_and_is_untrue_literal">
      <text>r.the_representation_is_made and not(r.the_representation_is_accurate)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_practice_is_specified_in_the_second_schedule" name="the_practice_is_specified_in_the_Second_Schedule" label="the practice is specified in the Second Schedule">
    <variable id="decision_the_practice_is_specified_in_the_second_schedule_var" name="the_practice_is_specified_in_the_Second_Schedule" label="the practice is specified in the Second Schedule" typeRef="boolean"/>
    <informationRequirement id="decision_the_practice_is_specified_in_the_second_schedule_ir1">
      <requiredDecision href="#decision_the_representation_is_made_and_is_untrue"/>
    </informationRequirement>
    <informationRequirement id="decision_the_practice_is_specified_in_the_second_schedule_ir2">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_the_practice_is_specified_in_the_second_schedule_literal">
      <text>CONSIDER p WHEN `Paragraph 1` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 2` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 3` r fm THEN r's `the representation is made` AND fm WHEN `Paragraph 4` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 5` r det THEN r's `the representation is made` AND ((NOT r's `the representation is accurate`) OR det) WHEN `Paragraph 6` r kn THEN (`the representation is made and is untrue` OF r) AND kn WHEN `Paragraph 7` r kn lim THEN (`the representation is made and is untrue` OF r) AND kn AND (NOT lim) WHEN `Paragraph 8` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 9` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 10` est hi agreed THEN est AND hi AND (NOT agreed) WHEN `Paragraph 11` r dec THEN r's `the representation is made` AND dec WHEN `Paragraph 12` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 13` inc harsh uncon THEN inc AND harsh AND uncon WHEN `Paragraph 14` pressure THEN pressure WHEN `Paragraph 15` rep kn THEN rep AND kn WHEN `Paragraph 16` obj sell adv THEN obj AND sell AND (NOT adv) WHEN `Paragraph 17` rep did THEN rep AND (NOT did) WHEN `Paragraph 18` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 19` offer kn THEN offer AND kn WHEN `Paragraph 20` rep kn THEN rep AND kn WHEN `Paragraph 21` r THEN `the representation is made and is untrue` OF r WHEN `Paragraph 22` inv intent ra rb rc rd THEN inv AND intent AND (ra OR rb OR rc OR rd) WHEN `Paragraph 23` omit small mislead knows conn THEN (omit OR small OR mislead) AND (`the information is a material fact` OF knows) AND conn WHEN `Paragraph 24` accepts specified knowsperiod knowsreasonable THEN accepts AND (IF specified THEN knowsperiod ELSE knowsreasonable) WHEN `Paragraph 25` asserts unsol THEN asserts AND unsol WHEN `Paragraph 26` sends unsol prominent acked THEN sends AND unsol AND (NOT prominent) AND (NOT acked) WHEN `Paragraph 27` written nocopy requested refuses THEN written AND nocopy AND requested AND refuses</text>
    </literalExpression>
  </decision>
  <decisionService id="service__4_meaning_of_unfair_practice" name="_4_Meaning_of_unfair_practice" label="4. Meaning of unfair practice">
    <variable id="service__4_meaning_of_unfair_practice_var" name="_4_Meaning_of_unfair_practice" label="4. Meaning of unfair practice" typeRef="boolean"/>
    <outputDecision href="#decision_the_supplier_engages_in_an_unfair_practice"/>
    <encapsulatedDecision href="#decision_section_4_a_is_satisfied"/>
    <encapsulatedDecision href="#decision_section_4_b_is_satisfied"/>
    <encapsulatedDecision href="#decision_section_4_c_is_satisfied"/>
    <encapsulatedDecision href="#decision_section_4_d_is_satisfied"/>
    <inputDecision href="#decision_the_practice_is_specified_in_the_second_schedule"/>
    <inputDecision href="#decision_the_representation_is_made_and_is_untrue"/>
    <inputData href="#input_u"/>
  </decisionService>
  <decisionService id="service_second_schedule_part_2_interpretation" name="Second_Schedule_Part_2_Interpretation" label="Second Schedule, Part 2 -- Interpretation">
    <variable id="service_second_schedule_part_2_interpretation_var" name="Second_Schedule_Part_2_Interpretation" label="Second Schedule, Part 2 -- Interpretation" typeRef="Any"/>
    <outputDecision href="#decision_the_goods_or_services_are_unsolicited_goods_or_services"/>
    <outputDecision href="#decision_the_agreement_is_an_applicable_agreement"/>
    <encapsulatedDecision href="#decision_the_goods_or_services_were_requested_by_the_consumer"/>
    <encapsulatedDecision href="#decision_the_consumer_consented_to_the_material_change"/>
    <encapsulatedDecision href="#decision_the_goods_or_services_are_unsolicited_under_paragraph_1_a"/>
    <encapsulatedDecision href="#decision_the_goods_or_services_are_unsolicited_under_paragraph_1_b"/>
    <inputData href="#input_f"/>
    <inputData href="#input_g"/>
  </decisionService>
  <decisionService id="service_second_schedule_part_1_specific_unfair_practices" name="Second_Schedule_Part_1_Specific_unfair_practices" label="Second Schedule, Part 1 -- Specific unfair practices">
    <variable id="service_second_schedule_part_1_specific_unfair_practices_var" name="Second_Schedule_Part_1_Specific_unfair_practices" label="Second Schedule, Part 1 -- Specific unfair practices" typeRef="boolean"/>
    <outputDecision href="#decision_the_practice_is_specified_in_the_second_schedule"/>
    <encapsulatedDecision href="#decision_the_representation_is_made_and_is_untrue"/>
    <inputData href="#input_r"/>
    <inputData href="#input_p"/>
  </decisionService>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="definitions_part_2_unfair_practices_diagram" name="Part 2 -- Unfair practices">
      <dmndi:DMNShape id="input_a_shape" dmnElementRef="input_a">
        <dc:Bounds x="60" y="700" width="180" height="80"/>
      </dmndi:DMNShape>
