@lang en
IMPORT prelude
IMPORT daydate
IMPORT `tasco-vn19-nouns`
IMPORT `tasco-vn19-ch1-general`
IMPORT `tasco-vn19-art10-waiting`
IMPORT `tasco-vn19-ch3-exclusions`
IMPORT `tasco-vn19-ch2-cover`
