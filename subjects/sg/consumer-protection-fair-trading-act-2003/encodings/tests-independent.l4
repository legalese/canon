IMPORT prelude
IMPORT daydate
IMPORT `cpfta-types`
IMPORT `cpfta-part1`
IMPORT `cpfta-part2-practices`
IMPORT `cpfta-part2-redress`
IMPORT `cpfta-part3-goods`
IMPORT `cpfta-part3a-investigation`
IMPORT `cpfta-part3b-offences`
IMPORT `cpfta-part4-general`

-- Independent tests for the Consumer Protection (Fair Trading) Act 2003.
-- Written from source/CPFTA2003.txt BEFORE reading the encoding's rule bodies.
-- Expected values are the test author's reading of the statute.  A failing
-- assertion is a finding, not a value to be adjusted.

§ `Part 1 -- definitions`

§§ `helpers`

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN, f IS A BOOLEAN
GIVETH A `Supplier Facts`
supF MEANS `Supplier Facts` OF a, b, c, d, e, f

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN
GIVETH A `Consumer Facts`
conF MEANS `Consumer Facts` OF a, b, c, d, e

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN
GIVETH A `Residential Property Facts`
resF MEANS `Residential Property Facts` OF a, b, c

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN
GIVETH A `Voucher Facts`
vouF MEANS `Voucher Facts` OF a, b, c

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN
GIVETH A `Regulated Thing Facts`
regF MEANS `Regulated Thing Facts` OF a, b, c, d

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN
GIVETH A `Time Share Facts`
tsF MEANS `Time Share Facts` OF a, b, c, d, 3

GIVEN yrs IS A NUMBER
GIVETH A `Time Share Facts`
tsYears MEANS `Time Share Facts` OF TRUE, TRUE, FALSE, FALSE, yrs

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN, f IS A BOOLEAN
GIVETH A `Transaction Facts`
trF MEANS `Transaction Facts` OF a, b, c, d, e, f

-- Column ruler for supF: business, provides, manufactures, promotes, receives, employee/agent
§§ `2(1) supplier`
#ASSERT `the person is a supplier` (supF TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT `the person is a supplier` (supF TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `the person is a supplier` (supF TRUE FALSE FALSE TRUE FALSE FALSE)
#ASSERT `the person is a supplier` (supF TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT `the person is a supplier` (supF TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the person is a supplier` (supF FALSE TRUE TRUE TRUE TRUE FALSE)
#ASSERT `the person is a supplier` (supF FALSE FALSE FALSE FALSE FALSE TRUE)

§§ `2(1) consumer and 2(2)`
-- individual, exclusively-in-business, holds-out, receives, obliged-to-pay
#ASSERT `the person is a consumer` (conF TRUE FALSE FALSE TRUE FALSE)
#ASSERT `the person is a consumer` (conF TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT `the person is a consumer` (conF FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT `the person is a consumer` (conF TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT `the person is a consumer` (conF TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT `the person is a consumer` (conF TRUE FALSE FALSE FALSE FALSE)
#ASSERT `the person is treated as acting exclusively in the course of business` (conF TRUE FALSE TRUE TRUE FALSE)

§§ `2(1) financial product / services; 2(3)`
#ASSERT `the thing is a financial product` (regF TRUE FALSE FALSE FALSE)
#ASSERT `the thing is a financial product` (regF FALSE TRUE FALSE FALSE)
#ASSERT `the thing is a financial product` (regF FALSE FALSE TRUE FALSE)
#ASSERT `the thing is a financial product` (regF FALSE FALSE FALSE TRUE)
#ASSERT NOT `the thing is a financial product` (regF FALSE FALSE FALSE FALSE)
#ASSERT `the service is financial services` (regF TRUE FALSE FALSE FALSE)
#ASSERT NOT `the service is financial services` (regF FALSE FALSE FALSE FALSE)

§§ `2(1) residential property`
#ASSERT `the thing is residential property` (resF TRUE TRUE FALSE)
#ASSERT `the thing is residential property` (resF TRUE FALSE TRUE)
#ASSERT NOT `the thing is residential property` (resF TRUE FALSE FALSE)
#ASSERT NOT `the thing is residential property` (resF FALSE TRUE TRUE)

§§ `2(1) voucher`
#ASSERT `the thing is a voucher` (vouF TRUE TRUE FALSE)
#ASSERT `the thing is a voucher` (vouF TRUE FALSE TRUE)
#ASSERT NOT `the thing is a voucher` (vouF FALSE TRUE TRUE)
#ASSERT NOT `the thing is a voucher` (vouF TRUE FALSE FALSE)

§§ `2(1) time share contract: not less than 3 years`
#ASSERT `the contract is a time share contract` (tsYears 3)
#ASSERT `the contract is a time share contract` (tsYears 10)
#ASSERT NOT `the contract is a time share contract` (tsYears 2)
#ASSERT NOT `the contract is a time share contract` (tsYears 2.9)
-- employment or insurance rights are not time share rights
#ASSERT NOT `the contract is a time share contract` (`Time Share Facts` OF TRUE, TRUE, TRUE, FALSE, 5)
#ASSERT NOT `the contract is a time share contract` (`Time Share Facts` OF TRUE, TRUE, FALSE, TRUE, 5)
#ASSERT NOT `the contract is a time share contract` (`Time Share Facts` OF TRUE, FALSE, FALSE, FALSE, 5)

§§ `2(1) goods`
-- Goods Facts: personal property, chattel, credit, regulation, residential, voucher
#ASSERT `the thing is goods` (`Goods Facts` OF TRUE, FALSE, FALSE, regF FALSE FALSE FALSE FALSE, resF FALSE FALSE FALSE, vouF FALSE FALSE FALSE)
#ASSERT `the thing is goods` (`Goods Facts` OF FALSE, TRUE, FALSE, regF FALSE FALSE FALSE FALSE, resF FALSE FALSE FALSE, vouF FALSE FALSE FALSE)
#ASSERT `the thing is goods` (`Goods Facts` OF FALSE, FALSE, TRUE, regF FALSE FALSE FALSE FALSE, resF FALSE FALSE FALSE, vouF FALSE FALSE FALSE)
#ASSERT `the thing is goods` (`Goods Facts` OF FALSE, FALSE, FALSE, regF TRUE FALSE FALSE FALSE, resF FALSE FALSE FALSE, vouF FALSE FALSE FALSE)
#ASSERT `the thing is goods` (`Goods Facts` OF FALSE, FALSE, FALSE, regF FALSE FALSE FALSE FALSE, resF TRUE TRUE FALSE, vouF FALSE FALSE FALSE)
#ASSERT `the thing is goods` (`Goods Facts` OF FALSE, FALSE, FALSE, regF FALSE FALSE FALSE FALSE, resF FALSE FALSE FALSE, vouF TRUE TRUE FALSE)
#ASSERT NOT `the thing is goods` (`Goods Facts` OF FALSE, FALSE, FALSE, regF FALSE FALSE FALSE FALSE, resF FALSE FALSE FALSE, vouF FALSE FALSE FALSE)

§§ `First Schedule and consumer transaction`
-- supplies, agreement, acquisition of immovable property, lease of res. property for rent, time share contract, employment
#ASSERT `the transaction is a consumer transaction` (trF TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the transaction is a consumer transaction` (trF FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the transaction is a consumer transaction` (trF FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the transaction is a consumer transaction` (trF TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `the transaction is a consumer transaction` (trF TRUE FALSE TRUE TRUE FALSE FALSE)
#ASSERT `the transaction is a consumer transaction` (trF TRUE FALSE TRUE FALSE TRUE FALSE)
#ASSERT NOT `the transaction is a consumer transaction` (trF TRUE FALSE FALSE FALSE FALSE TRUE)
#ASSERT `the transaction is an excluded transaction` (trF FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT `the transaction is an excluded transaction` (trF FALSE FALSE TRUE TRUE FALSE FALSE)

§§ `2(1) material fact; motor vehicle sale contract`
#ASSERT `the information is a material fact` TRUE
#ASSERT NOT `the information is a material fact` FALSE
#ASSERT `the contract is a motor vehicle sale contract` TRUE TRUE
#ASSERT NOT `the contract is a motor vehicle sale contract` TRUE FALSE
#ASSERT NOT `the contract is a motor vehicle sale contract` FALSE TRUE

§ `Part 2 -- unfair practices`

§§ `3. Application of Part`
-- supplier resident, consumer resident, offer in, offer from, acceptance in, acceptance from
#ASSERT `Part 2 applies` (`Application Facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `Part 2 applies` (`Application Facts` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `Part 2 applies` (`Application Facts` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE)
#ASSERT `Part 2 applies` (`Application Facts` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)
#ASSERT `Part 2 applies` (`Application Facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE)
#ASSERT `Part 2 applies` (`Application Facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE)
#ASSERT NOT `Part 2 applies` (`Application Facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)

§§ `4. Meaning of unfair practice`
-- acts in relation to CT, does/omits, misled, false claim, takes advantage, cannot protect, cannot understand, schedule practices
GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN, f IS A BOOLEAN, g IS A BOOLEAN
GIVETH A `Unfair Practice Facts`
upF MEANS `Unfair Practice Facts` OF a, b, c, d, e, f, g, EMPTY

#ASSERT `the supplier engages in an unfair practice` (upF TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the supplier engages in an unfair practice` (upF TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the supplier engages in an unfair practice` (upF TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT `the supplier engages in an unfair practice` (upF TRUE FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `the supplier engages in an unfair practice` (upF TRUE FALSE FALSE FALSE TRUE TRUE FALSE)
#ASSERT `the supplier engages in an unfair practice` (upF TRUE FALSE FALSE FALSE TRUE FALSE TRUE)
#ASSERT NOT `the supplier engages in an unfair practice` (upF TRUE FALSE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT `the supplier engages in an unfair practice` (upF TRUE FALSE FALSE FALSE FALSE TRUE TRUE)
-- not in relation to a consumer transaction: not an unfair practice under s 4
#ASSERT NOT `the supplier engages in an unfair practice` (upF FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
-- 4(d): a Second Schedule practice suffices
#ASSERT `the supplier engages in an unfair practice` (`Unfair Practice Facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, LIST (`Paragraph 14` TRUE))
#ASSERT NOT `the supplier engages in an unfair practice` (`Unfair Practice Facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, LIST (`Paragraph 14` FALSE))

§§ `5(3)(b). Acts of employees and agents`
-- employee, in course of employment, agent, on behalf, within actual or apparent authority
#ASSERT `the act or omission of an employee or agent is also that of the person` (`Attribution Facts` OF TRUE, TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT `the act or omission of an employee or agent is also that of the person` (`Attribution Facts` OF TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the act or omission of an employee or agent is also that of the person` (`Attribution Facts` OF FALSE, FALSE, TRUE, TRUE, TRUE)
#ASSERT NOT `the act or omission of an employee or agent is also that of the person` (`Attribution Facts` OF FALSE, FALSE, TRUE, TRUE, FALSE)
#ASSERT NOT `the act or omission of an employee or agent is also that of the person` (`Attribution Facts` OF FALSE, FALSE, TRUE, FALSE, TRUE)

§§ `Second Schedule Part 2 para 1-2. Unsolicited goods or services`
-- supplied, requested, request-only-inferred, knows-for-another, reasonable-to-believe-unsolicited, continuing, material change, consent in writing, consent-only-inferred
GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN
GIVETH AN `Unsolicited Facts`
unsF MEANS `Unsolicited Facts` OF TRUE, a, b, c, d, FALSE, FALSE, FALSE, FALSE

#ASSERT `the goods or services are unsolicited goods or services` (unsF FALSE FALSE FALSE FALSE)
#ASSERT NOT `the goods or services are unsolicited goods or services` (unsF TRUE FALSE FALSE FALSE)
-- para 2: payment/use/inaction alone does not show a request
#ASSERT `the goods or services are unsolicited goods or services` (unsF TRUE TRUE FALSE FALSE)
-- para 1(a): consumer knew goods were meant for another person
#ASSERT NOT `the goods or services are unsolicited goods or services` (unsF FALSE FALSE TRUE FALSE)
#ASSERT `the goods or services are unsolicited goods or services` (unsF FALSE FALSE TRUE TRUE)
-- para 1(b): continuing supply, material change
#ASSERT `the goods or services are unsolicited goods or services` (`Unsolicited Facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE)
#ASSERT NOT `the goods or services are unsolicited under paragraph 1(b)` (`Unsolicited Facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE)
-- consent to change inferred only from inaction is not consent
#ASSERT `the goods or services are unsolicited under paragraph 1(b)` (`Unsolicited Facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE)
-- no material change
#ASSERT NOT `the goods or services are unsolicited under paragraph 1(b)` (`Unsolicited Facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE)

§§ `Second Schedule Part 2 para 3. Applicable agreement (deposit counts as an instalment)`
-- between supplier and consumer, no supply until paid, by instalments, number of instalments excl deposit, deposit paid
#ASSERT `the agreement is an applicable agreement` (`Applicable Agreement Facts` OF TRUE, TRUE, TRUE, 2, FALSE)
#ASSERT `the agreement is an applicable agreement` (`Applicable Agreement Facts` OF TRUE, TRUE, TRUE, 1, TRUE)
#ASSERT NOT `the agreement is an applicable agreement` (`Applicable Agreement Facts` OF TRUE, TRUE, TRUE, 1, FALSE)
#ASSERT NOT `the agreement is an applicable agreement` (`Applicable Agreement Facts` OF TRUE, TRUE, TRUE, 0, FALSE)
#ASSERT NOT `the agreement is an applicable agreement` (`Applicable Agreement Facts` OF TRUE, FALSE, TRUE, 3, FALSE)
#ASSERT NOT `the agreement is an applicable agreement` (`Applicable Agreement Facts` OF FALSE, TRUE, TRUE, 3, FALSE)

§§ `Second Schedule Part 1. Specific unfair practices`
GIVEN made IS A BOOLEAN, acc IS A BOOLEAN
GIVETH A Representation
rep MEANS Representation OF made, acc

-- para 1
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 1` (rep TRUE FALSE))
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 1` (rep TRUE TRUE))
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 1` (rep FALSE FALSE))
-- paras 2, 4, 8, 9, 12, 18, 21: plain untrue representation
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 2` (rep TRUE FALSE))
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 4` (rep TRUE FALSE))
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 8` (rep TRUE FALSE))
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 9` (rep TRUE FALSE))
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 12` (rep TRUE FALSE))
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 18` (rep TRUE FALSE))
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 21` (rep TRUE FALSE))
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 21` (rep TRUE TRUE))
-- para 3: false or misleading
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 3` (rep TRUE TRUE) TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 3` (rep TRUE TRUE) FALSE)
-- para 5: new/unused if not, or deteriorated/altered/reconditioned/reclaimed
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 5` (rep TRUE FALSE) FALSE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 5` (rep TRUE TRUE) TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 5` (rep TRUE TRUE) FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 5` (rep FALSE FALSE) TRUE)
-- para 6: only if the supplier knows it is not so
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 6` (rep TRUE FALSE) TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 6` (rep TRUE FALSE) FALSE)
-- para 7: knows or can reasonably be expected to know; unless clearly states limitation
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 7` (rep TRUE FALSE) TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 7` (rep TRUE FALSE) TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 7` (rep TRUE FALSE) FALSE FALSE)
-- para 10: substantially higher than estimate unless expressly agreed in advance
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 10` TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 10` TRUE TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 10` FALSE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 10` TRUE FALSE FALSE)
-- para 11: deceptive or misleading
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 11` (rep TRUE FALSE) TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 11` (rep TRUE FALSE) FALSE)
-- para 13: harsh terms so as to be unconscionable
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 13` TRUE TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 13` TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 13` FALSE TRUE TRUE)
-- para 14
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 14` TRUE)
-- para 15
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 15` TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 15` TRUE FALSE)
-- para 16: unless states advertisement or promotion
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 16` TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 16` TRUE TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 16` TRUE FALSE FALSE)
-- para 17
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 17` TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 17` TRUE TRUE)
-- paras 19, 20
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 19` TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 19` TRUE FALSE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 20` TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 20` TRUE FALSE)
-- para 22: any one of (a) to (d) with intention to promote different goods
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 22` TRUE TRUE TRUE FALSE FALSE FALSE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 22` TRUE TRUE FALSE TRUE FALSE FALSE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 22` TRUE TRUE FALSE FALSE TRUE FALSE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 22` TRUE TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 22` TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 22` TRUE FALSE TRUE TRUE TRUE TRUE)
-- para 23: omits / small print / misleads as to a material fact
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 23` TRUE FALSE FALSE TRUE TRUE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 23` FALSE TRUE FALSE TRUE TRUE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 23` FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 23` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 23` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 23` FALSE FALSE FALSE TRUE TRUE)
-- para 24: period specified -> that period; none -> reasonable period
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 24` TRUE TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 24` TRUE TRUE FALSE TRUE)
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 24` TRUE FALSE FALSE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 24` TRUE FALSE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 24` FALSE TRUE TRUE TRUE)
-- para 25
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 25` TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 25` TRUE FALSE)
-- para 26: no prominent text and no written acknowledgment
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 26` TRUE TRUE FALSE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 26` TRUE TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 26` TRUE TRUE FALSE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 26` TRUE FALSE FALSE FALSE)
-- para 27: written agreement, no copy given, requested, refused
#ASSERT `the practice is specified in the Second Schedule` (`Paragraph 27` TRUE TRUE TRUE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 27` TRUE TRUE FALSE TRUE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 27` TRUE TRUE TRUE FALSE)
#ASSERT NOT `the practice is specified in the Second Schedule` (`Paragraph 27` FALSE TRUE TRUE TRUE)

§ `Part 2 -- redress (ss 6 to 12)`

§§ `6. The prescribed limit of $30,000`
noVal MEANS `Residential Valuation Facts` OF NOTHING, NOTHING, NOTHING, NOTHING

-- entered CT with UP, commenced in court, claim for money, amount, set-off flag, balance,
-- subject is residential, value if not residential, valuation facts, abandoned, Minister's limit
GIVEN money IS A BOOLEAN, amount IS A NUMBER, setoff IS A BOOLEAN, bal IS A NUMBER, aband IS A BOOLEAN, lim IS A MAYBE NUMBER
GIVETH A `Consumer Action Facts`
actF MEANS `Consumer Action Facts` OF TRUE, TRUE, money, amount, setoff, bal, FALSE, 0, noVal, aband, lim

GIVEN value IS A NUMBER, lim IS A MAYBE NUMBER
GIVETH A `Consumer Action Facts`
actNM MEANS `Consumer Action Facts` OF TRUE, TRUE, FALSE, 0, FALSE, 0, FALSE, value, noVal, FALSE, lim

GIVEN v IS A `Residential Valuation Facts`
GIVETH A `Consumer Action Facts`
actRes MEANS `Consumer Action Facts` OF TRUE, TRUE, FALSE, 0, FALSE, 0, TRUE, 0, v, FALSE, NOTHING

-- money claims: both sides of $30,000
#ASSERT `the prescribed limit` (actF TRUE 1 FALSE 0 FALSE NOTHING) EQUALS 30_000
#ASSERT `the consumer may commence an action under section 6(1)` (actF TRUE 30_000 FALSE 0 FALSE NOTHING)
#ASSERT `the consumer may commence an action under section 6(1)` (actF TRUE 29_999 FALSE 0 FALSE NOTHING)
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actF TRUE 30_001 FALSE 0 FALSE NOTHING)
-- 6(5): abandoning the excess
#ASSERT `the consumer may commence an action under section 6(1)` (actF TRUE 45_000 FALSE 0 TRUE NOTHING)
#ASSERT `the most that the consumer may recover in the action` (actF TRUE 45_000 FALSE 0 TRUE NOTHING) EQUALS 30_000
#ASSERT `the most that the consumer may recover in the action` (actF TRUE 20_000 FALSE 0 FALSE NOTHING) EQUALS 20_000
-- 6(3): set-off admitted by the consumer
#ASSERT `the consumer may commence an action under section 6(1)` (actF TRUE 35_000 TRUE 28_000 FALSE NOTHING)
#ASSERT `the consumer may commence an action under section 6(1)` (actF TRUE 35_000 TRUE 30_000 FALSE NOTHING)
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actF TRUE 35_000 TRUE 30_001 FALSE NOTHING)
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actF TRUE 35_000 FALSE 28_000 FALSE NOTHING)
-- 6(6): the Minister may prescribe another amount in place of $30,000
#ASSERT `the prescribed limit` (actF TRUE 1 FALSE 0 FALSE (JUST 50_000)) EQUALS 50_000
#ASSERT `the consumer may commence an action under section 6(1)` (actF TRUE 50_000 FALSE 0 FALSE (JUST 50_000))
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actF TRUE 50_001 FALSE 0 FALSE (JUST 50_000))
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actF TRUE 30_001 FALSE 0 FALSE (JUST 20_000))
-- 6(2)(b): no claim for money, value of the subject matter
#ASSERT `the consumer may commence an action under section 6(1)` (actNM 30_000 NOTHING)
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actNM 30_001 NOTHING)
-- the consumer must have entered a consumer transaction involving an unfair practice
#ASSERT NOT `the consumer may commence an action under section 6(1)` (`Consumer Action Facts` OF FALSE, TRUE, TRUE, 100, FALSE, 0, FALSE, 0, noVal, FALSE, NOTHING)

§§ `6(4). Value of residential property`
GIVEN av IS A MAYBE NUMBER, ar IS A MAYBE NUMBER, mr IS A MAYBE NUMBER, lp IS A MAYBE NUMBER
GIVETH A `Residential Valuation Facts`
valF MEANS `Residential Valuation Facts` OF av, ar, mr, lp

-- (a) annual value; (b) annual rent or 12 x monthly rent, if lower
#ASSERT `the value of residential property` (valF (JUST 24_000) (JUST 20_000) NOTHING NOTHING) EQUALS 20_000
#ASSERT `the value of residential property` (valF (JUST 24_000) (JUST 30_000) NOTHING NOTHING) EQUALS 24_000
#ASSERT `the value of residential property` (valF (JUST 24_000) NOTHING (JUST 1_500) NOTHING) EQUALS 18_000
#ASSERT `the value of residential property` (valF (JUST 24_000) NOTHING (JUST 2_500) NOTHING) EQUALS 24_000
#ASSERT `the value of residential property` (valF (JUST 24_000) NOTHING NOTHING NOTHING) EQUALS 24_000
-- (c) one-tenth of the last transacted price if value/rent cannot be ascertained
#ASSERT `the value of residential property` (valF NOTHING NOTHING NOTHING (JUST 400_000)) EQUALS 40_000
#ASSERT `the consumer may commence an action under section 6(1)` (actRes (valF NOTHING NOTHING NOTHING (JUST 300_000)))
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actRes (valF NOTHING NOTHING NOTHING (JUST 300_001)))
#ASSERT NOT `the consumer may commence an action under section 6(1)` (actRes (valF (JUST 40_000) (JUST 36_000) NOTHING NOTHING))
#ASSERT `the consumer may commence an action under section 6(1)` (actRes (valF (JUST 40_000) (JUST 30_000) NOTHING NOTHING))

§§ `6(7) to (9). Stay and discontinuance`
-- apply for stay, s 9 application made, proceedings relate to that practice, material, stay order date, last step, date considered
GIVEN considered IS A DATE, laststep IS A MAYBE DATE
GIVETH A `Stay Facts`
stayF MEANS `Stay Facts` OF TRUE, TRUE, TRUE, TRUE, YMD 2024 1 1, laststep, considered

#ASSERT `the court may of its own motion discontinue the stayed proceedings` (stayF (YMD 2026 1 1) NOTHING)
#ASSERT `the court may of its own motion discontinue the stayed proceedings` (stayF (YMD 2027 6 1) NOTHING)
#ASSERT NOT `the court may of its own motion discontinue the stayed proceedings` (stayF (YMD 2025 12 31) NOTHING)
#ASSERT `the court may of its own motion discontinue the stayed proceedings` (stayF (YMD 2026 6 1) (JUST (YMD 2024 6 1)))
#ASSERT NOT `the court may of its own motion discontinue the stayed proceedings` (stayF (YMD 2026 5 31) (JUST (YMD 2024 6 1)))
#ASSERT `the court may stay the proceedings` (`Stay Facts` OF TRUE, TRUE, TRUE, TRUE, YMD 2024 1 1, NOTHING, YMD 2024 1 2)
#ASSERT NOT `the court may stay the proceedings` (`Stay Facts` OF TRUE, TRUE, TRUE, FALSE, YMD 2024 1 1, NOTHING, YMD 2024 1 2)
#ASSERT NOT `the court may stay the proceedings` (`Stay Facts` OF TRUE, FALSE, TRUE, TRUE, YMD 2024 1 1, NOTHING, YMD 2024 1 2)
#ASSERT NOT `the court may stay the proceedings` (`Stay Facts` OF FALSE, TRUE, TRUE, TRUE, YMD 2024 1 1, NOTHING, YMD 2024 1 2)
#ASSERT `a party may apply to stay the proceedings` (`Stay Facts` OF FALSE, TRUE, TRUE, FALSE, YMD 2024 1 1, NOTHING, YMD 2024 1 2)
#ASSERT NOT `a party may apply to stay the proceedings` (`Stay Facts` OF FALSE, FALSE, TRUE, FALSE, YMD 2024 1 1, NOTHING, YMD 2024 1 2)

§§ `7. Small Claims Tribunal jurisdiction`
