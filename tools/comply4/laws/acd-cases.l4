-- Art 1(3) Notify each regulatory authority before marketing: due
#ASSERT (`the Directive applies to the product` `case 20`) AND (`Article 1(3) binds you` `case 20`) AND (NOT (`case 20`'s `every regulatory authority concerned has been notified`)) AND (`the time to notify has not passed` `case 20`)
-- Art 11(1) No national prohibition or special conditions: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`no Article 11 measure stands against the product` `case 20`)
-- Art 3(1) The product must not damage human health: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the product meets the safety requirement of Article 3` `case 20`)
-- Art 4(2)(a), 4(3) No prohibited substances: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the product is clear of Annex II` `case 20`)
-- Art 4(2)(b) Restricted substances within their limits: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the restricted substances are within Annex III` `case 20`)
-- Art 4(2)(c)–(d), 4(4)(b), 5 Colouring agents are permitted ones: breach
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the colouring agent rules apply` `case 20`) AND (NOT (`the colouring agents are permitted` `case 20`))
-- Art 4(2)(e)–(f), 4(4)(c), 5 Preservatives are permitted ones: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the preservative rules apply` `case 20`) AND (`the preservatives are permitted` `case 20`)
-- Art 4(2)(g)–(h), 4(4)(d), 5 UV filters are permitted ones: na
#ASSERT NOT ((`the Directive applies to the product` `case 20`) AND (`the UV filter rules apply` `case 20`))
-- Art 5(1)(c) Distinctive indication for a nationally authorised substance: na
#ASSERT NOT ((`the Directive applies to the product` `case 20`) AND (`the product relies on an Article 5 authorisation` `case 20`))
-- Art 6(1); App II C.1(a) Name of the product: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the label shows the name` `case 20`)
-- App II C.1(a) Function of the product: met
#ASSERT (`the Directive applies to the product` `case 20`) AND (`the label shows the function or it is clear` `case 20`)
