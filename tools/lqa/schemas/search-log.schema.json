{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/search-log.schema.json",
  "title": "Search log (2A)",
  "description": "Every search Gather made, including the routes that failed. What was searched is as much a deliverable as what was found.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "searches"
  ],
  "properties": {
    "kind": {
      "const": "search-log"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "searches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "route",
          "performed",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "performed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "outcome": {
            "enum": [
              "found",
              "not-found",
              "refused",
              "partial"
            ]
          },
          "found": {
            "description": "source-bundle document ids",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
