IMPORT `fa-offences`

-- Fisheries Act 1966, ss 2, 5, 7, 8, 10, 12, 13, 15, 17-20, 22 and 25 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_fisheries-act-1966.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a Singapore citizen` MEANS Offender WITH
    `is a citizen` IS TRUE
    `is ordinarily resident` IS FALSE
    `is crew or owner of a Singapore-registered fishing vessel` IS FALSE

`a foreign resident of Singapore` MEANS Offender WITH
    `is a citizen` IS FALSE
    `is ordinarily resident` IS TRUE
    `is crew or owner of a Singapore-registered fishing vessel` IS FALSE

`a foreign crewman on a Singapore-registered fishing boat` MEANS Offender WITH
    `is a citizen` IS FALSE
    `is ordinarily resident` IS FALSE
    `is crew or owner of a Singapore-registered fishing vessel` IS TRUE

`a foreign fisherman on a foreign boat` MEANS Offender WITH
    `is a citizen` IS FALSE
    `is ordinarily resident` IS FALSE
    `is crew or owner of a Singapore-registered fishing vessel` IS FALSE

