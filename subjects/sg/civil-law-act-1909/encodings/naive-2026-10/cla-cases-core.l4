IMPORT prelude
IMPORT `cla-core`

-- Civil Law Act 1909, ss 5, 5B, 6, 15, 20 to 22, 30, 35 and 37 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_cla.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a liable tortfeasor against a co-tortfeasor` MEANS ContributionClaim WITH
    `the claimant settled in good faith` IS FALSE
    `the claimant would have been liable on the facts alleged` IS FALSE
    `the claimant was actually liable` IS TRUE
    `the other party's liability was extinguished by limitation` IS FALSE
    `the other party was liable for the same damage` IS TRUE

`a good-faith settler who would have been liable` MEANS ContributionClaim WITH
    `the claimant settled in good faith` IS TRUE
    `the claimant would have been liable on the facts alleged` IS TRUE
    `the claimant was actually liable` IS FALSE
    `the other party's liability was extinguished by limitation` IS FALSE
    `the other party was liable for the same damage` IS TRUE

`a good-faith settler on a hopeless claim` MEANS ContributionClaim WITH
    `the claimant settled in good faith` IS TRUE
    `the claimant would have been liable on the facts alleged` IS FALSE
    `the claimant was actually liable` IS FALSE
    `the other party's liability was extinguished by limitation` IS FALSE
    `the other party was liable for the same damage` IS TRUE

`a liable tortfeasor against a time-barred co-tortfeasor` MEANS ContributionClaim WITH
    `the claimant settled in good faith` IS FALSE
    `the claimant would have been liable on the facts alleged` IS FALSE
    `the claimant was actually liable` IS TRUE
    `the other party's liability was extinguished by limitation` IS TRUE
    `the other party was liable for the same damage` IS TRUE

`a liable tortfeasor against a stranger to the damage` MEANS ContributionClaim WITH
    `the claimant settled in good faith` IS FALSE
    `the claimant would have been liable on the facts alleged` IS FALSE
    `the claimant was actually liable` IS TRUE
    `the other party's liability was extinguished by limitation` IS FALSE
    `the other party was liable for the same damage` IS FALSE

`a widow with two children` MEANS Survivors WITH
    `a spouse survives` IS TRUE
    `children survive` IS 2
    `parents survive` IS 2
    `siblings survive` IS 0

`three children` MEANS Survivors WITH
    `a spouse survives` IS FALSE
    `children survive` IS 3
    `parents survive` IS 0
    `siblings survive` IS 0

`two parents` MEANS Survivors WITH
    `a spouse survives` IS FALSE
    `children survive` IS 0
    `parents survive` IS 2
    `siblings survive` IS 1

`four siblings` MEANS Survivors WITH
    `a spouse survives` IS FALSE
    `children survive` IS 0
    `parents survive` IS 0
    `siblings survive` IS 4

`no relatives` MEANS Survivors WITH
    `a spouse survives` IS FALSE
    `children survive` IS 0
    `parents survive` IS 0
    `siblings survive` IS 0

`full disclosure backed by logical peer opinion` MEANS Advice WITH
    `accepted by a respectable body of medical opinion` IS TRUE
    `that opinion is logical` IS TRUE
    `gave the information a reasonable patient would require` IS TRUE
    `gave information known to matter to this patient` IS TRUE
    `reasonable justification for any withholding` IS FALSE

`peer-backed but illogical` MEANS Advice WITH
    `accepted by a respectable body of medical opinion` IS TRUE
    `that opinion is logical` IS FALSE
    `gave the information a reasonable patient would require` IS TRUE
    `gave information known to matter to this patient` IS TRUE
    `reasonable justification for any withholding` IS FALSE

`generic risks only, nothing on this patient's known concern` MEANS Advice WITH
    `accepted by a respectable body of medical opinion` IS TRUE
    `that opinion is logical` IS TRUE
    `gave the information a reasonable patient would require` IS TRUE
    `gave information known to matter to this patient` IS FALSE
    `reasonable justification for any withholding` IS FALSE

`withholding with reasonable justification` MEANS Advice WITH
    `accepted by a respectable body of medical opinion` IS TRUE
    `that opinion is logical` IS TRUE
    `gave the information a reasonable patient would require` IS FALSE
    `gave information known to matter to this patient` IS FALSE
    `reasonable justification for any withholding` IS TRUE

`full disclosure but no supporting peer body` MEANS Advice WITH
    `accepted by a respectable body of medical opinion` IS FALSE
    `that opinion is logical` IS TRUE
    `gave the information a reasonable patient would require` IS TRUE
    `gave information known to matter to this patient` IS TRUE
    `reasonable justification for any withholding` IS FALSE

§ `s 5`

#ASSERT NOT `the contract is enforceable despite section 5` `a private bet between friends`
#ASSERT `the contract is enforceable despite section 5` `a bet with a licensed operator`
#ASSERT NOT `the contract is enforceable despite section 5` `credit extended by a licensed operator for betting`
#ASSERT `the contract is enforceable despite section 5` `a contract for differences entered into by way of business`
#ASSERT `the contract is enforceable despite section 5` `a prize for a lawful sporting competition`

§ `s 5B`

#ASSERT `the funder can enforce the funding contract` TRUE TRUE TRUE
#ASSERT NOT `the funder can enforce the funding contract` FALSE TRUE TRUE
#ASSERT NOT `the funder can enforce the funding contract` TRUE FALSE TRUE
#ASSERT NOT `the funder can enforce the funding contract` TRUE TRUE FALSE

§ `s 6`

#ASSERT `the agreement must be evidenced in signed writing` `a guarantee`
#ASSERT `the agreement must be evidenced in signed writing` `a sale of land`
#ASSERT `the agreement must be evidenced in signed writing` `a lease`
#ASSERT `the agreement must be evidenced in signed writing` `a contract lasting more than a year`
#ASSERT NOT `the agreement must be evidenced in signed writing` `a sale of goods to be completed next week`
#ASSERT `the agreement must be evidenced in signed writing` `an agreement in consideration of marriage`

#ASSERT NOT `an action can be brought on the agreement` `a guarantee` FALSE
#ASSERT `an action can be brought on the agreement` `a guarantee` TRUE
#ASSERT NOT `an action can be brought on the agreement` `a sale of land` FALSE
#ASSERT `an action can be brought on the agreement` `a sale of goods to be completed next week` FALSE

