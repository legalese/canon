-- src:2618 | chi nhánh nước ngoài tại Việt Nam gây ảnh hưởng trọng yếu đến vốn, khả năng
-- src:2619 | thanh toán, quản trị rủi ro và quản trị doanh nghiệp;
-- src:2620 | m) Tổn thất tài sản có giá trị từ 10% vốn chủ sở hữu trở lên;
-- src:2621 | n) Chuyển giao danh mục hợp đồng bảo hiểm;
-- src:2622 | o) Thông tin khác theo quy định của pháp luật.
@ref Dieu 117-120 (src:2542-2622)
DECLARE `A kind of information to disclose` IS ONE OF
    `periodic information (Dieu 118)`
    `regular information (Dieu 119)`
    `unusual information (Dieu 120)`

DECLARE `A disclosure event` HAS
    `kind`                                                   IS A `A kind of information to disclose`
    `date the period for sending the report ended, or the event occurred` IS A DATE
    `date the information was published on the insurer's website` IS A DATE
    `date the insurer notified the Ministry of Finance of what it published` IS A DATE
    `the insurer is a public company`                        IS A BOOLEAN

DECLARE `A loss of property` HAS
    `value of the loss`                                      IS A NUMBER
    `owners' equity`                                         IS A NUMBER

DECLARE `A transfer of shares` HAS
    `holding before as a share of charter capital`           IS A NUMBER
    `holding after as a share of charter capital`            IS A NUMBER

§§ `Chuong III, Muc 1-2: licence, ownership, governance, officers`

-- Dieu 64-66: the people who found an insurer or reinsurer and the shape of its ownership.
