#ASSERT NOT `disqualified from a responsible position` FALSE TRUE 2018 TRUE 2022 FALSE 2027
#ASSERT `disqualified from a responsible position` TRUE FALSE 1990 FALSE 0 FALSE 2025
#ASSERT `disqualified from a responsible position` FALSE FALSE 0 FALSE 0 TRUE 2025

