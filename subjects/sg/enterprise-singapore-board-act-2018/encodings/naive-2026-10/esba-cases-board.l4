    `has entered into a composition with creditors` IS FALSE
    `is a Judge or judicial officer` IS FALSE
    `longest sentence of imprisonment in months` IS 0
    `received a free pardon` IS FALSE
    `is currently disqualified from acting as a director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

