IMPORT prelude
IMPORT `ars-operation`

-- Amusement Rides Safety Act 2011, ss 2, 13, 15, 16, 18, 19, 22, 35, 54, 59, 62 and the penalties -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_amusement-rides-safety-act-2011.py). Expected results were written by
-- hand from the text.

`a theme park roller coaster` MEANS Device WITH
    `mechanised or power-driven` IS TRUE
    `driven solely by human physical effort` IS FALSE
    `designed to carry patrons on a course for amusement` IS TRUE
    `available to members of the public` IS TRUE
    `fixed to a non-moving base` IS FALSE
    `operates as a children's ride on inserting a coin or token` IS FALSE
    `playground equipment` IS FALSE
    `prescribed to be an amusement ride` IS FALSE
    `prescribed as not being an amusement ride` IS FALSE

`a mall coin-operated kiddie ride` MEANS Device WITH
    `mechanised or power-driven` IS TRUE
    `driven solely by human physical effort` IS FALSE
    `designed to carry patrons on a course for amusement` IS TRUE
    `available to members of the public` IS TRUE
    `fixed to a non-moving base` IS TRUE
    `operates as a children's ride on inserting a coin or token` IS TRUE
    `playground equipment` IS FALSE
    `prescribed to be an amusement ride` IS FALSE
    `prescribed as not being an amusement ride` IS FALSE

