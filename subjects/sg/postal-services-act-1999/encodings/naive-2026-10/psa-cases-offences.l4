    `is for hire, reward or profit` IS FALSE
    `is by an employee of a correspondent about that correspondent's affairs` IS FALSE
    `is an open consignee's letter carried with the goods` IS FALSE
    `is direct mail` IS FALSE
    `is by the sender personally` IS FALSE
    `is a document another law lets be served otherwise than by post` IS FALSE
    `is an intra-organisational mailroom service` IS FALSE
    `is a messenger service` IS FALSE

