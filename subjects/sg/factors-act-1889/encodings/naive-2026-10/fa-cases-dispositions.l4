    `the taker had notice consent had ended` IS FALSE

`a seller resells and delivers goods still in the shop` MEANS Resale WITH
    `the seller stayed in possession after selling` IS TRUE
    `the buyer got possession with the seller's consent` IS FALSE
    `the goods or documents were delivered or transferred` IS TRUE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS FALSE
    `the second taker had notice of the seller's lien or right` IS FALSE
    `in the ordinary course of business` IS FALSE

`a seller resells but delivers nothing` MEANS Resale WITH
    `the seller stayed in possession after selling` IS TRUE
    `the buyer got possession with the seller's consent` IS FALSE
    `the goods or documents were delivered or transferred` IS FALSE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS FALSE
    `the second taker had notice of the seller's lien or right` IS FALSE
    `in the ordinary course of business` IS FALSE

`a seller resells to someone who knew of the first sale` MEANS Resale WITH
    `the seller stayed in possession after selling` IS TRUE
    `the buyer got possession with the seller's consent` IS FALSE
    `the goods or documents were delivered or transferred` IS TRUE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS TRUE
    `the second taker had notice of the seller's lien or right` IS FALSE
    `in the ordinary course of business` IS FALSE

`a buyer on credit resells in a shop` MEANS Resale WITH
    `the seller stayed in possession after selling` IS FALSE
    `the buyer got possession with the seller's consent` IS TRUE
    `the goods or documents were delivered or transferred` IS TRUE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS FALSE
    `the second taker had notice of the seller's lien or right` IS FALSE
    `in the ordinary course of business` IS TRUE

`a buyer on credit resells privately` MEANS Resale WITH
    `the seller stayed in possession after selling` IS FALSE
    `the buyer got possession with the seller's consent` IS TRUE
    `the goods or documents were delivered or transferred` IS TRUE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS FALSE
    `the second taker had notice of the seller's lien or right` IS FALSE
    `in the ordinary course of business` IS FALSE

`a buyer resells to someone who knew the seller was unpaid` MEANS Resale WITH
    `the seller stayed in possession after selling` IS FALSE
    `the buyer got possession with the seller's consent` IS TRUE
    `the goods or documents were delivered or transferred` IS TRUE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS FALSE
    `the second taker had notice of the seller's lien or right` IS TRUE
    `in the ordinary course of business` IS TRUE

`a buyer who took the goods without consent resells` MEANS Resale WITH
    `the seller stayed in possession after selling` IS FALSE
    `the buyer got possession with the seller's consent` IS FALSE
    `the goods or documents were delivered or transferred` IS TRUE
    `the second taker acted in good faith` IS TRUE
    `the second taker had notice of the first sale` IS FALSE
    `the second taker had notice of the seller's lien or right` IS FALSE
    `in the ordinary course of business` IS TRUE

§ `ss 1(2), 2, 6`

#ASSERT `the agent is in possession` `a dealer sells a consigned car to a shopper`
#ASSERT `the agent is in possession` `a dealer sells a car held in a third party's yard`
#ASSERT NOT `the agent is in possession` `a dealer who never had possession sells`

#ASSERT `the owner consented to the agent's possession` `a dealer sells a consigned car to a shopper`
#ASSERT NOT `the owner consented to the agent's possession` `a dealer sells a car the owner never handed over`
#ASSERT `the owner consented to the agent's possession` `a dealer pledges a log book got through a consented car`

#ASSERT `the disposition binds the owner` `a dealer sells a consigned car to a shopper`
#ASSERT `the disposition binds the owner` `a dealer sells a car held in a third party's yard`
#ASSERT NOT `the disposition binds the owner` `a friend who is not a mercantile agent sells the car`
#ASSERT NOT `the disposition binds the owner` `a dealer sells a car the owner never handed over`
#ASSERT `the disposition binds the owner` `a dealer pledges a log book got through a consented car`
#ASSERT NOT `the disposition binds the owner` `a dealer sells outside the ordinary course`
#ASSERT NOT `the disposition binds the owner` `a dealer sells to a buyer acting in bad faith`
#ASSERT NOT `the disposition binds the owner` `a dealer sells to a buyer who knew he had no authority`
#ASSERT `the disposition binds the owner` `a dealer sells after the owner revoked consent, buyer unaware`
#ASSERT NOT `the disposition binds the owner` `a dealer sells after the owner revoked consent, buyer aware`
#ASSERT NOT `the disposition binds the owner` `a dealer who never had possession sells`
#ASSERT NOT `the disposition binds the owner` `a stranger signs a sale in the dealer's name`

§ `ss 3, 4, 5`

#ASSERT `the goods are pledged` TRUE FALSE
#ASSERT NOT `the goods are pledged` FALSE FALSE

#ASSERT `the most the pledgee can claim on the goods` `a fresh cash advance` 50000 0 0 EQUALS 50000
#ASSERT `the most the pledgee can claim on the goods` `goods, documents or a negotiable security given in exchange` 50000 30000 0 EQUALS 30000
#ASSERT `the most the pledgee can claim on the goods` `goods, documents or a negotiable security given in exchange` 20000 30000 0 EQUALS 20000
#ASSERT `the most the pledgee can claim on the goods` `a debt already owed by the agent` 40000 0 10000 EQUALS 10000
#ASSERT `the most the pledgee can claim on the goods` `a debt already owed by the agent` 40000 0 0 EQUALS 0

§ `s 7`

#ASSERT `the consignee has a lien against the owner` TRUE FALSE TRUE
#ASSERT NOT `the consignee has a lien against the owner` TRUE TRUE TRUE
#ASSERT NOT `the consignee has a lien against the owner` FALSE FALSE TRUE

§ `ss 8, 9`

#ASSERT `the seller's second disposition binds the first buyer` `a seller resells and delivers goods still in the shop`
#ASSERT NOT `the seller's second disposition binds the first buyer` `a seller resells but delivers nothing`
#ASSERT NOT `the seller's second disposition binds the first buyer` `a seller resells to someone who knew of the first sale`
#ASSERT NOT `the seller's second disposition binds the first buyer` `a buyer on credit resells in a shop`

#ASSERT `the buyer's disposition defeats the original seller` `a buyer on credit resells in a shop`
#ASSERT NOT `the buyer's disposition defeats the original seller` `a buyer on credit resells privately`
#ASSERT NOT `the buyer's disposition defeats the original seller` `a buyer resells to someone who knew the seller was unpaid`
#ASSERT NOT `the buyer's disposition defeats the original seller` `a buyer who took the goods without consent resells`

§ `ss 10, 11`

#ASSERT `the vendor's lien or stoppage is defeated` TRUE TRUE TRUE TRUE
#ASSERT NOT `the vendor's lien or stoppage is defeated` TRUE TRUE TRUE FALSE
#ASSERT NOT `the vendor's lien or stoppage is defeated` TRUE TRUE FALSE TRUE
#ASSERT NOT `the vendor's lien or stoppage is defeated` FALSE TRUE TRUE TRUE

#ASSERT `the document is transferred` `by endorsement` FALSE FALSE
#ASSERT NOT `the document is transferred` `by delivery alone` FALSE FALSE
#ASSERT `the document is transferred` `by delivery alone` TRUE FALSE
#ASSERT `the document is transferred` `by delivery alone` FALSE TRUE

§ `s 12`

#ASSERT `the agent remains answerable to the owner` TRUE TRUE
#ASSERT NOT `the agent remains answerable to the owner` FALSE TRUE

#ASSERT `the owner may take the goods back from the agent` FALSE FALSE
#ASSERT NOT `the owner may take the goods back from the agent` TRUE FALSE
#ASSERT NOT `the owner may take the goods back from the agent` FALSE TRUE

#ASSERT `the cost of redeeming the goods` 8000 500 TRUE EQUALS 8500
#ASSERT `the cost of redeeming the goods` 8000 500 FALSE EQUALS 8000

#ASSERT `the surplus the owner may recover from the pledgee` 12000 8000 EQUALS 4000
#ASSERT `the surplus the owner may recover from the pledgee` 6000 8000 EQUALS 0

#ASSERT `the price the owner may recover from the buyer` 10000 0 EQUALS 10000
#ASSERT `the price the owner may recover from the buyer` 10000 3000 EQUALS 7000

