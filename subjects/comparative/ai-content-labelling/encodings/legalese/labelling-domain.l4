-- AI-content labelling across three authorities: the shared nouns.
--
-- This module DECLAREs and does nothing else. Every field is a fact a witness of
-- ordinary competence could testify to -- what kind of content this is, how it came
-- to exist, which alterations an AI system made to it, what its C2PA manifest says,
-- how many users a system has. Whether an alteration is "standard editing", whether
-- content "would falsely appear ... to be authentic", whether a change is
-- "significant": those are judgements each statute hands to someone, and they are
-- declared in that statute's own module, in its own words.

IMPORT prelude
IMPORT daydate

-- NO `§` HEADINGS IN THIS MODULE, deliberately. JSONDECODE cannot produce an enum
-- constructor when its DECLARE sits under a `§` heading (smucclaw/l4-ide#947, open on
-- 2026-10-01), and these records are the inputs a caller sends as JSON over REST or
-- MCP. Section titles are written as comments instead. NOTES.md section 7.

-- == The content ==

-- EU Art. 50(2) reaches "synthetic audio, image, video or text content";
-- Washington s.2(1) and California 22757.3(a) reach "image, video, or audio content,
-- or content that is any combination thereof". Text is split because the Code of
-- Practice treats the two differently: free-form text "cannot transport metadata"
-- (Measure 1.1), containerised text can (Sub-measure 1.1.1).
DECLARE `kind of content` IS ONE OF
    `image`
    `video`
    `audio`
    `free-form text`
    `containerised text`

DECLARE `how the content came to exist` IS ONE OF
    `generated by an AI system`
    `captured by a capture device`
    `made by a person without an AI system`

-- Each alteration is named as a witness would describe it, not as any one statute
-- classifies it. The constructors cover every item on California's list of minor
-- modifications (22757.1(l)) and Washington's (s.2(4)), plus the examples the
-- Commission's Guidelines give on each side of "standard editing" (paras 90-92),
-- so that each module can classify them against its own text.
DECLARE `kind of alteration` IS ONE OF
    `a change to brightness, contrast, or color`              -- CA 22757.1(l)(1); WA s.2(4)
    `sharpening`                                              -- CA (l)(2); WA
    `saturating`                                              -- CA (l)(3); WA
    `resizing`                                                -- CA (l)(4) "File resizing"; WA "resizing" -- see NOTES fork F3
    `scaling`                                                 -- CA (l)(5); WA "scaling"
    `cropping`                                                -- CA (l)(6); WA
    `file format conversion`                                  -- CA (l)(7); WA "format conversions"
    `denoising`                                               -- CA (l)(8); WA
    `removal of background noise in audio`                    -- CA (l)(8); WA
    `applying a filter`                                       -- WA only: "applying filters"
    `resampling`                                              -- WA only
    `compression`                                             -- on neither list; Guidelines para 92 example
    `removal of red-eye or dust spots`                        -- on neither list; Guidelines para 92 example
    `removal, replacement or insertion of an object or person` -- Guidelines para 92, "require marking" side
    `face replacement`                                        -- Guidelines para 92, "require marking" side
    `synthesis of speech in a real person's voice`            -- Guidelines para 92, "require marking" side
    `grammar and spelling correction`                         -- text; Guidelines para 92
    `rewriting that changes style, structure or meaning`      -- text; Guidelines para 92
    `another alteration` HAS `described as` IS A STRING

-- == What its C2PA manifest states ==

-- IPTC digital source types, as a C2PA manifest records them in its c2pa.actions
-- assertion. Only the values the fixtures exercise are named; any other URI is
-- `another source type`.
DECLARE `digital source type` IS ONE OF
    `digital capture`                         -- .../digitalsourcetype/digitalCapture
    `trained algorithmic media`               -- .../trainedAlgorithmicMedia: made by a generative model
    `composite with trained algorithmic media` -- .../compositeWithTrainedAlgorithmicMedia: an edit with generative AI
    `algorithmically enhanced`                -- .../algorithmicallyEnhanced
    `no source type declared`
    `another source type` HAS `the URI` IS A STRING

-- Facts read off a manifest by c2patool, never inferred. fixtures/extract-facts.py
-- produces them mechanically from c2patool's JSON.
DECLARE `C2PA manifest` HAS
    `its signature validates`                IS A BOOLEAN  -- c2patool validation_state is Valid or Trusted
    `its signer is on the C2PA trust list`   IS A BOOLEAN  -- validation_state is Trusted
    `the signer it names`                    IS A STRING   -- signature_info.issuer
    `the generator it names`                 IS A STRING   -- claim_generator_info[0].name
    `the generator version it names`         IS A STRING   -- claim_generator_info[0].version; "" if absent
    `the time it records`                    IS A STRING   -- signature_info.time; "" if absent
    `the identifier it carries`              IS A STRING   -- instance_id; "" if absent
    `the source types it declares`           IS A LIST OF `digital source type`
    `the actions it records`                 IS A LIST OF STRING  -- c2pa.actions action labels
    `it declares a watermark`                IS A BOOLEAN  -- a c2pa.watermarked(.bound) action, or a soft-binding assertion
    `it carries an AI disclosure assertion`  IS A BOOLEAN  -- c2pa.ai-disclosure (spec 2.4)

DECLARE `piece of content` HAS
    `the kinds it contains`                   IS A LIST OF `kind of content`
    `how it came to exist`                    IS A `how the content came to exist`
    `the alterations an AI system made to it` IS A LIST OF `kind of alteration`
    `the C2PA manifest it carries`            IS A MAYBE `C2PA manifest`
    `it carries an imperceptible watermark`   IS A BOOLEAN
    `it is very short text`                   IS A BOOLEAN  -- Code Sub-measure 1.1.2, "with the exception of very short text"
    `it stays inside a closed physical product` IS A BOOLEAN -- Code Measure 1.1, the "technically controlled and closed environment" case

-- == Who made it, who publishes it, who distributes it ==

DECLARE `the provider of the AI system` HAS
    `its name`                                                                  IS A STRING
    `it is a state, local, or tribal government`                                IS A BOOLEAN  -- WA s.1(2)
    `the monthly users of its system`                                           IS A NUMBER   -- WA s.1(2)
    `its system is publicly accessible in Washington to consumers for personal use` IS A BOOLEAN -- WA s.1(2)
    `its system is publicly accessible within California`                       IS A BOOLEAN  -- CA 22757.1(e)
    `the use is business-to-business`                                           IS A BOOLEAN  -- WA s.3(2)
    `its system was placed on the EU market before 2 August 2026`               IS A BOOLEAN  -- EU Art. 111(4)
    `it adheres to Section 1 of the EU Code of Practice`                        IS A BOOLEAN  -- Code, voluntary
    `its system is used solely for upscaling, noise reduction, or compression`  IS A BOOLEAN  -- WA s.5(2)
    `its product exclusively provides video games or interactive experiences`   IS A BOOLEAN  -- WA s.5(1)
    `its product exclusively provides non-user-generated videogames`            IS A BOOLEAN  -- CA 22757.5(a)
    `its system is designed to primarily function as assistive technology`     IS A BOOLEAN  -- CA 22757.5(b)
    `the use is authorised by law to detect, prevent, investigate or prosecute criminal offences` IS A BOOLEAN -- EU 50(2), 50(4)

DECLARE `the publication` HAS
    `the deployer uses the AI system in the course of a personal non-professional activity` IS A BOOLEAN -- EU 3(4)
    `the content resembles existing persons, objects, places, entities or events`            IS A BOOLEAN -- EU 3(60)
    `the text is published with the purpose of informing the public on matters of public interest` IS A BOOLEAN -- EU 50(4) 2nd subpara
    `the text has undergone a process of human review or editorial control`                  IS A BOOLEAN -- EU 50(4) 2nd subpara
    `a natural or legal person holds editorial responsibility for the publication`           IS A BOOLEAN -- EU 50(4) 2nd subpara
    `the use is authorised by law to detect, prevent, investigate or prosecute criminal offences` IS A BOOLEAN -- EU 50(4)

DECLARE `the distributing platform` HAS
    `it is a public-facing social media platform, file-sharing platform, mass messaging platform, or stand-alone search engine` IS A BOOLEAN -- CA 22757.1(i)(1)
    `it distributes content to users who did not create or collaborate in creating the content` IS A BOOLEAN -- CA 22757.1(i)(1)
    `its unique monthly users during the preceding 12 months` IS A NUMBER  -- CA 22757.1(i)(1), "exceeded 2,000,000"
    `it is a broadband internet access service`               IS A BOOLEAN -- CA 22757.1(i)(2)(A)
    `it is a telecommunications service`                      IS A BOOLEAN -- CA 22757.1(i)(2)(B)
