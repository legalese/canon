§ `s 4`

#ASSERT `the Act reaches the contract` `a phone bought by a minor in 2024 on a guaranteed plan`
#ASSERT `the Act reaches the contract` `the same, but the court does not think restitution just`
#ASSERT `the Act reaches the contract` `a minor's loan already spent, guaranteed by a parent`
#ASSERT `the Act reaches the contract` `an unguaranteed motorbike sale the minor repudiates`
#ASSERT `the Act reaches the contract` `a guaranteed contract that binds the minor`
#ASSERT `the Act reaches the contract` `a guaranteed contract void for a reason other than minority`
#ASSERT NOT `the Act reaches the contract` `a guaranteed contract made on 9 April 1987`
#ASSERT NOT `the Act reaches the contract` `a guaranteed contract made on 10 April 1987`
#ASSERT `the Act reaches the contract` `a 10 April 1987 contract the Civil Law Act s 5 reached`
#ASSERT NOT `the Act reaches the contract` `a guaranteed contract made on 11 November 1993`
#ASSERT `the Act reaches the contract` `a guaranteed contract made on 12 November 1993`
#ASSERT NOT `the Act reaches the contract` `a guaranteed contract made in 1980 the Civil Law Act s 5 reached`

§ `s 1`

#ASSERT `section 1 disapplies the Infants Relief Act 1874` `a phone bought by a minor in 2024 on a guaranteed plan`
#ASSERT NOT `section 1 disapplies the Infants Relief Act 1874` `a guaranteed contract made on 9 April 1987`
#ASSERT NOT `section 1 disapplies the Infants Relief Act 1874` `a guaranteed contract made on 11 November 1993`
#ASSERT `section 1 disapplies the Infants Relief Act 1874` `a 10 April 1987 contract the Civil Law Act s 5 reached`

§ `s 2`

#ASSERT `the guarantor cannot rely on the minority` `a phone bought by a minor in 2024 on a guaranteed plan`
#ASSERT `the guarantor cannot rely on the minority` `the same, but the court does not think restitution just`
#ASSERT `the guarantor cannot rely on the minority` `a minor's loan already spent, guaranteed by a parent`
#ASSERT NOT `the guarantor cannot rely on the minority` `an unguaranteed motorbike sale the minor repudiates`
#ASSERT NOT `the guarantor cannot rely on the minority` `a guaranteed contract that binds the minor`
#ASSERT NOT `the guarantor cannot rely on the minority` `a guaranteed contract void for a reason other than minority`
#ASSERT NOT `the guarantor cannot rely on the minority` `a guaranteed contract made on 9 April 1987`
#ASSERT NOT `the guarantor cannot rely on the minority` `a guaranteed contract made on 10 April 1987`
#ASSERT `the guarantor cannot rely on the minority` `a 10 April 1987 contract the Civil Law Act s 5 reached`
#ASSERT NOT `the guarantor cannot rely on the minority` `a guaranteed contract made on 11 November 1993`
#ASSERT `the guarantor cannot rely on the minority` `a guaranteed contract made on 12 November 1993`
#ASSERT NOT `the guarantor cannot rely on the minority` `a guaranteed contract made in 1980 the Civil Law Act s 5 reached`

§ `s 3`

#ASSERT `the court may order the minor to transfer the property` `a phone bought by a minor in 2024 on a guaranteed plan`
#ASSERT NOT `the court may order the minor to transfer the property` `the same, but the court does not think restitution just`
#ASSERT NOT `the court may order the minor to transfer the property` `a minor's loan already spent, guaranteed by a parent`
#ASSERT `the court may order the minor to transfer the property` `an unguaranteed motorbike sale the minor repudiates`
#ASSERT NOT `the court may order the minor to transfer the property` `a guaranteed contract that binds the minor`
#ASSERT NOT `the court may order the minor to transfer the property` `a guaranteed contract void for a reason other than minority`
#ASSERT NOT `the court may order the minor to transfer the property` `a guaranteed contract made on 9 April 1987`
#ASSERT NOT `the court may order the minor to transfer the property` `a guaranteed contract made on 10 April 1987`
#ASSERT `the court may order the minor to transfer the property` `a 10 April 1987 contract the Civil Law Act s 5 reached`
#ASSERT NOT `the court may order the minor to transfer the property` `a guaranteed contract made on 11 November 1993`
#ASSERT `the court may order the minor to transfer the property` `a guaranteed contract made on 12 November 1993`
#ASSERT NOT `the court may order the minor to transfer the property` `a guaranteed contract made in 1980 the Civil Law Act s 5 reached`

#ASSERT `section 3 can make the order` `return of the goods the minor acquired`
#ASSERT `section 3 can make the order` `transfer of property representing the goods`
#ASSERT NOT `section 3 can make the order` `payment of the unpaid price`
#ASSERT NOT `section 3 can make the order` `damages for breach of the contract`

