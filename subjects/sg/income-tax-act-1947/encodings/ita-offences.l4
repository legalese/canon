IMPORT prelude
IMPORT daydate
IMPORT `ita-types`

-- Income Tax Act 1947 — PART 20 (AND THE OFFENCES ELSEWHERE): IS AN OFFENCE
-- COMMITTED, AND WHAT IS THE MOST IT CAN COST?
--
-- The ladder of tax-geared penalties for incorrect returns and evasion (ss 95,
-- 96, 96A; the same ladder for the EIS cash payout, s 37S), failure to file
-- (s 94A), the general penalty (s 94), and the offences with fixed maximum
-- fines (ss 6, 34F, 45(5), 65C, 65E, 65J, 97, 98, 105M).
--
-- Source: ../source/ITA1947.txt lines 32750-33077 and as cited.

§ `Part 20 — offences and penalties`

§§ `Incorrect returns and evasion (ss 95, 96, 96A, 37S)`

DECLARE `Culpability` IS ONE OF
    `none shown`                                                   -- s 95(1), s 37S(1)
    `without reasonable excuse or through negligence`              -- s 95(2), s 37S(2)
    `wilfully with intent to evade`                                -- s 96, s 37S(3)
    `wilfully, by false books or by fraud, art or contrivance`     -- s 96A, s 37S(4)

DECLARE `Tax penalty` HAS
    `penalty`                         IS A NUMBER    -- a multiple of the tax undercharged (or payout obtained)
    `maximum fine`                    IS A NUMBER
    `maximum imprisonment in months`  IS A NUMBER
    `minimum imprisonment in months`  IS A NUMBER

-- s 95(1): a penalty "equal to the amount of tax ... undercharged"; (2) without
-- reasonable excuse or through negligence: "double", and "a fine not exceeding
-- $5,000 or ... imprisonment ... not exceeding 3 years". s 96(1): wilfully with
-- intent to evade: "treble", and $10,000 or 3 years; (2) at least 6 months for
-- an individual with 3 or more such convictions, or one under s 96 and one under
-- s 96A. s 96A(1): false books, or fraud, art or contrivance: "4 times", and
-- $50,000 or 5 years; (2) at least 6 months for 2 or more such convictions, or
-- one under each. s 37S applies the same ladder to the EIS cash payout.
@ref ss 95(1)-(2), 96(1)-(2), 96A(1)-(2); s 37S
GIVEN c                         IS A `Culpability`
      undercharged              IS A NUMBER
      `earlier s 96 convictions`  IS A NUMBER
      `earlier s 96A convictions` IS A NUMBER
GIVETH A `Tax penalty`
`the penalty for` c `, tax undercharged` undercharged `, earlier s 96 convictions` `earlier s 96 convictions` `, earlier s 96A convictions` `earlier s 96A convictions` MEANS
    CONSIDER c
    WHEN `none shown` THEN
        `Tax penalty` OF undercharged, 0, 0, 0
    WHEN `without reasonable excuse or through negligence` THEN
        `Tax penalty` OF 2 TIMES undercharged, 5000, 36, 0
    WHEN `wilfully with intent to evade` THEN
        `Tax penalty` OF 3 TIMES undercharged, 10000, 36, (IF `earlier s 96 convictions` AT LEAST 2 OR `earlier s 96A convictions` AT LEAST 1 THEN 6 ELSE 0)
    WHEN `wilfully, by false books or by fraud, art or contrivance` THEN
        `Tax penalty` OF 4 TIMES undercharged, 50000, 60, (IF `earlier s 96A convictions` AT LEAST 1 OR `earlier s 96 convictions` AT LEAST 1 THEN 6 ELSE 0)

§§ `Failure to file (s 94A) and the general penalty (s 94)`

-- s 94A(1): failing without reasonable excuse to comply with s 62 or 71(1): a
-- fine up to $5,000, and in default imprisonment up to 6 months. (2): on a
-- second or subsequent conviction for the same YA, "a further penalty of $100
-- for every day during which the offence is continued". (3): failing "for 2 years
-- or more": "a penalty equal to double the amount of tax which the Comptroller
-- assesses" and a fine up to $5,000.
DECLARE `Filing penalty` HAS
    `penalty`              IS A NUMBER
    `maximum fine`         IS A NUMBER
    `per day after conviction` IS A NUMBER
    `default imprisonment in months` IS A NUMBER

@ref s 94A(1)-(3)
GIVEN `years in default`                IS A NUMBER
      `tax assessed for that YA`         IS A NUMBER
      `a repeat conviction for the same YA` IS A BOOLEAN
GIVETH A `Filing penalty`
`the penalty for failing to file, years in default` `years in default` `, tax assessed` `tax assessed for that YA` `, repeat:` `a repeat conviction for the same YA` MEANS
    `Filing penalty` WITH
        `penalty`                        IS IF `years in default` AT LEAST 2 THEN 2 TIMES `tax assessed for that YA` ELSE 0
        `maximum fine`                   IS 5000
        `per day after conviction`       IS IF `a repeat conviction for the same YA` THEN 100 ELSE 0
        `default imprisonment in months` IS 6

§§ `Offences with fixed maximum penalties`

DECLARE `ITA offence` IS ONE OF
    `s 94 — any contravention with no other penalty`
    `s 34F(8) — transfer-pricing documentation`
    `s 45(5) — failing to notify tax deducted`
    `s 65C(1) — failing to comply with a notice under ss 64-65B`
    `s 65C(8) or 65J — false or misleading information to the Comptroller or an officer`
    `s 65E(4) — breaching a confidentiality notice`
    `s 65J(4) — refusing to answer on examination`
    `s 97 — offences by authorised and unauthorised persons`
    `s 98 — obstructing the Comptroller or an officer`
    `s 105M — false information under Part 20B`

DECLARE `Fixed penalty` HAS
    `maximum fine`                    IS A NUMBER
    `maximum imprisonment in months`  IS A NUMBER
    `continuing, per day`             IS A NUMBER

@ref ss 34F(8), 45(5), 65C, 65E(4), 65J(4), 94(2), 97, 98(1), 105M
GIVEN o IS AN `ITA offence`
GIVETH A `Fixed penalty`
`the maximum penalty for` o MEANS
    CONSIDER o
    --                                                                                       fine    months  per day
    WHEN `s 94 — any contravention with no other penalty`                             THEN `Fixed penalty` OF 5000,  6,  0     -- in default of payment
    WHEN `s 34F(8) — transfer-pricing documentation`                                  THEN `Fixed penalty` OF 10000, 0,  0
    WHEN `s 45(5) — failing to notify tax deducted`                                   THEN `Fixed penalty` OF 10000, 36, 0     -- plus 3 x the tax deducted
    WHEN `s 65C(1) — failing to comply with a notice under ss 64-65B`                 THEN `Fixed penalty` OF 10000, 12, 100
    WHEN `s 65C(8) or 65J — false or misleading information to the Comptroller or an officer` THEN `Fixed penalty` OF 10000, 24, 0
    WHEN `s 65E(4) — breaching a confidentiality notice`                              THEN `Fixed penalty` OF 1000,  6,  0     -- in default of payment
    WHEN `s 65J(4) — refusing to answer on examination`                               THEN `Fixed penalty` OF 10000, 12, 0
    WHEN `s 97 — offences by authorised and unauthorised persons`                     THEN `Fixed penalty` OF 10000, 36, 0
    WHEN `s 98 — obstructing the Comptroller or an officer`                           THEN `Fixed penalty` OF 10000, 12, 0
    WHEN `s 105M — false information under Part 20B`                                  THEN `Fixed penalty` OF 10000, 24, 0

-- s 99: proceedings for a penalty do not relieve the person of the tax. s 100(1):
-- penalties and s 85(2) interest are not tax paid for any relief.
@ref s 99
GIVEN tax IS A NUMBER
      penalty IS A NUMBER
GIVETH A NUMBER
`the total owed, tax` tax `and penalty` penalty MEANS
    tax PLUS penalty
