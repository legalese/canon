<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_part_1_preliminary" name="Part 1 -- Preliminary" namespace="https://legalese.com/l4/dmn/part_1_preliminary" exporter="jl4">
  <inputData id="input_s" name="s">
    <variable id="input_s_var" name="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_c" name="c">
    <variable id="input_c_var" name="c" typeRef="Any"/>
  </inputData>
  <inputData id="input_r" name="r">
    <variable id="input_r_var" name="r" typeRef="Any"/>
  </inputData>
  <inputData id="input_p" name="p">
    <variable id="input_p_var" name="p" typeRef="Any"/>
  </inputData>
  <inputData id="input_v" name="v">
    <variable id="input_v_var" name="v" typeRef="Any"/>
  </inputData>
  <inputData id="input_g" name="g">
    <variable id="input_g_var" name="g" typeRef="Any"/>
  </inputData>
  <inputData id="input_t" name="t">
    <variable id="input_t_var" name="t" typeRef="Any"/>
  </inputData>
  <inputData id="input_s_2" name="s_2" label="s">
    <variable id="input_s_2_var" name="s_2" label="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_t_2" name="t_2" label="t">
    <variable id="input_t_2_var" name="t_2" label="t" typeRef="Any"/>
  </inputData>
  <inputData id="input_t_3" name="t_3" label="t">
    <variable id="input_t_3_var" name="t_3" label="t" typeRef="Any"/>
  </inputData>
  <inputData id="input_the_supplier_knows_or_ought_reasonably_to_know_that_the_information_would_affect_the_decision_of_a_consumer_to_enter_into_a_consumer_transaction" name="the_supplier_knows_or_ought_reasonably_to_know_that_the_information_would_affect_the_decision_of_a_consumer_to_enter_into_a_consumer_transaction" label="the supplier knows or ought reasonably to know that the information would affect the decision of a consumer to enter into a consumer transaction">
    <variable id="input_the_supplier_knows_or_ought_reasonably_to_know_that_the_information_would_affect_the_decision_of_a_consumer_to_enter_into_a_consumer_transaction_var" name="the_supplier_knows_or_ought_reasonably_to_know_that_the_information_would_affect_the_decision_of_a_consumer_to_enter_into_a_consumer_transaction" label="the supplier knows or ought reasonably to know that the information would affect the decision of a consumer to enter into a consumer transaction" typeRef="boolean"/>
  </inputData>
  <inputData id="input_the_contract_is_between_a_consumer_and_a_supplier_of_motor_vehicles" name="the_contract_is_between_a_consumer_and_a_supplier_of_motor_vehicles" label="the contract is between a consumer and a supplier of motor vehicles">
    <variable id="input_the_contract_is_between_a_consumer_and_a_supplier_of_motor_vehicles_var" name="the_contract_is_between_a_consumer_and_a_supplier_of_motor_vehicles" label="the contract is between a consumer and a supplier of motor vehicles" typeRef="boolean"/>
  </inputData>
  <inputData id="input_the_contract_is_for_the_sale_of_a_motor_vehicle_to_the_consumer" name="the_contract_is_for_the_sale_of_a_motor_vehicle_to_the_consumer" label="the contract is for the sale of a motor vehicle to the consumer">
    <variable id="input_the_contract_is_for_the_sale_of_a_motor_vehicle_to_the_consumer_var" name="the_contract_is_for_the_sale_of_a_motor_vehicle_to_the_consumer" label="the contract is for the sale of a motor vehicle to the consumer" typeRef="boolean"/>
  </inputData>
  <decision id="decision_the_person_is_a_supplier" name="the_person_is_a_supplier" label="the person is a supplier">
    <variable id="decision_the_person_is_a_supplier_var" name="the_person_is_a_supplier" label="the person is a supplier" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_a_supplier_ir1">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_a_supplier_literal">
      <text>s.the_person_acts_in_the_course_of_the_person_s_business and (s.the_person_provides_goods_or_services_to_consumers or (s.the_person_manufactures_assembles_or_produces_goods or (s.the_person_promotes_the_use_or_purchase_of_goods_or_services or s.the_person_receives_or_is_entitled_to_receive_money_or_other_consideration_as_a_result_of_the_provision_of_goods_or_services_to_consumers))) or s.the_person_is_an_employee_or_agent_of_a_person_who_acts_in_the_course_of_business_and_does_any_of_those_things</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_treated_as_acting_exclusively_in_the_course_of_business" name="the_person_is_treated_as_acting_exclusively_in_the_course_of_business" label="the person is treated as acting exclusively in the course of business">
    <variable id="decision_the_person_is_treated_as_acting_exclusively_in_the_course_of_business_var" name="the_person_is_treated_as_acting_exclusively_in_the_course_of_business" label="the person is treated as acting exclusively in the course of business" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_treated_as_acting_exclusively_in_the_course_of_business_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_treated_as_acting_exclusively_in_the_course_of_business_literal">
      <text>c.the_person_acts_exclusively_in_the_course_of_business or c.the_person_holds_himself_or_herself_out_as_acting_exclusively_in_the_course_of_business</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_a_consumer" name="the_person_is_a_consumer" label="the person is a consumer">
    <variable id="decision_the_person_is_a_consumer_var" name="the_person_is_a_consumer" label="the person is a consumer" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_a_consumer_ir1">
      <requiredDecision href="#decision_the_person_is_treated_as_acting_exclusively_in_the_course_of_business"/>
    </informationRequirement>
    <informationRequirement id="decision_the_person_is_a_consumer_ir2">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_a_consumer_literal">
      <text>c.the_person_is_an_individual and (not(the_person_is_treated_as_acting_exclusively_in_the_course_of_business) and (c.the_person_receives_or_has_the_right_to_receive_goods_or_services_from_a_supplier or c.the_person_has_a_legal_obligation_to_pay_a_supplier_for_goods_or_services_that_have_been_or_are_to_be_supplied_to_another_individual))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_thing_is_regulated_as_a_financial_matter" name="the_thing_is_regulated_as_a_financial_matter" label="the thing is regulated as a financial matter">
    <variable id="decision_the_thing_is_regulated_as_a_financial_matter_var" name="the_thing_is_regulated_as_a_financial_matter" label="the thing is regulated as a financial matter" typeRef="boolean"/>
    <informationRequirement id="decision_the_thing_is_regulated_as_a_financial_matter_ir1">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_thing_is_regulated_as_a_financial_matter_literal">
      <text>r.the_thing_is_regulated_or_supplied_by_a_person_regulated_under_a_written_law_administered_by_the_Monetary_Authority_of_Singapore or (r.the_thing_is_regulated_or_supplied_by_a_person_regulated_under_the_Commodity_Trading_Act_1992 or (r.the_thing_is_regulated_or_supplied_by_a_person_regulated_under_another_written_law_that_the_Minister_has_by_order_prescribed or r.the_person_supplying_the_thing_is_exempted_from_being_licensed_approved_or_regulated_under_such_a_written_law))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_thing_is_a_financial_product" name="the_thing_is_a_financial_product" label="the thing is a financial product">
    <variable id="decision_the_thing_is_a_financial_product_var" name="the_thing_is_a_financial_product" label="the thing is a financial product" typeRef="boolean"/>
    <informationRequirement id="decision_the_thing_is_a_financial_product_ir1">
      <requiredDecision href="#decision_the_thing_is_regulated_as_a_financial_matter"/>
    </informationRequirement>
    <informationRequirement id="decision_the_thing_is_a_financial_product_ir2">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_thing_is_a_financial_product_literal">
      <text>the_thing_is_regulated_as_a_financial_matter</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_service_is_financial_services" name="the_service_is_financial_services" label="the service is financial services">
    <variable id="decision_the_service_is_financial_services_var" name="the_service_is_financial_services" label="the service is financial services" typeRef="boolean"/>
    <informationRequirement id="decision_the_service_is_financial_services_ir1">
      <requiredDecision href="#decision_the_thing_is_regulated_as_a_financial_matter"/>
    </informationRequirement>
    <informationRequirement id="decision_the_service_is_financial_services_ir2">
      <requiredInput href="#input_r"/>
    </informationRequirement>
    <literalExpression id="decision_the_service_is_financial_services_literal">
      <text>the_thing_is_regulated_as_a_financial_matter</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_thing_is_residential_property" name="the_thing_is_residential_property" label="the thing is residential property">
    <variable id="decision_the_thing_is_residential_property_var" name="the_thing_is_residential_property" label="the thing is residential property" typeRef="boolean"/>
    <informationRequirement id="decision_the_thing_is_residential_property_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_the_thing_is_residential_property_literal">
      <text>p.the_thing_is_a_house_flat_or_other_premises and (p.the_thing_is_permitted_by_a_written_law_to_be_used_as_a_dwelling_house or p.the_thing_is_in_the_course_of_being_constructed)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_thing_is_a_voucher" name="the_thing_is_a_voucher" label="the thing is a voucher">
    <variable id="decision_the_thing_is_a_voucher_var" name="the_thing_is_a_voucher" label="the thing is a voucher" typeRef="boolean"/>
    <informationRequirement id="decision_the_thing_is_a_voucher_ir1">
      <requiredInput href="#input_v"/>
    </informationRequirement>
    <literalExpression id="decision_the_thing_is_a_voucher_literal">
      <text>v.the_thing_is_a_document and (v.the_document_purports_to_give_the_holder_the_right_to_obtain_goods_or_a_service or v.the_document_purports_to_give_the_holder_the_right_to_obtain_goods_or_a_service_at_a_discounted_or_reduced_price)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_thing_is_goods" name="the_thing_is_goods" label="the thing is goods">
    <variable id="decision_the_thing_is_goods_var" name="the_thing_is_goods" label="the thing is goods" typeRef="boolean"/>
    <informationRequirement id="decision_the_thing_is_goods_ir1">
      <requiredDecision href="#decision_the_thing_is_a_financial_product"/>
    </informationRequirement>
    <informationRequirement id="decision_the_thing_is_goods_ir2">
      <requiredDecision href="#decision_the_thing_is_a_voucher"/>
    </informationRequirement>
    <informationRequirement id="decision_the_thing_is_goods_ir3">
      <requiredDecision href="#decision_the_thing_is_residential_property"/>
    </informationRequirement>
    <informationRequirement id="decision_the_thing_is_goods_ir4">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_thing_is_goods_literal">
      <text>g.the_thing_is_personal_property_whether_tangible_or_intangible or (g.the_thing_is_a_chattel_attached_or_intended_to_be_attached_to_real_property_on_or_after_delivery or (the_thing_is_a_financial_product or (g.the_thing_is_credit_including_credit_extended_solely_on_the_security_of_land or (the_thing_is_residential_property or the_thing_is_a_voucher))))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_contract_is_a_time_share_contract" name="the_contract_is_a_time_share_contract" label="the contract is a time share contract">
    <variable id="decision_the_contract_is_a_time_share_contract_var" name="the_contract_is_a_time_share_contract" label="the contract is a time share contract" typeRef="boolean"/>
    <informationRequirement id="decision_the_contract_is_a_time_share_contract_ir1">
      <requiredInput href="#input_t"/>
    </informationRequirement>
    <literalExpression id="decision_the_contract_is_a_time_share_contract_literal">
      <text>t.the_contract_confers_or_purports_to_confer_on_an_individual_rights_to_use_living_accommodation_used_or_intended_to_be_used_for_leisure_by_a_class_of_persons_all_of_whom_have_such_rights and (t.the_rights_are_for_a_specified_or_ascertainable_period and (not(t.the_rights_arise_under_a_contract_of_employment) and (not(t.the_rights_arise_under_an_insurance_policy) and t.the_period_during_which_the_rights_are_exercisable_in_years &gt;= 3)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_thing_is_services" name="the_thing_is_services" label="the thing is services">
    <variable id="decision_the_thing_is_services_var" name="the_thing_is_services" label="the thing is services" typeRef="boolean"/>
    <informationRequirement id="decision_the_thing_is_services_ir1">
      <requiredDecision href="#decision_the_contract_is_a_time_share_contract"/>
    </informationRequirement>
    <informationRequirement id="decision_the_thing_is_services_ir2">
      <requiredDecision href="#decision_the_service_is_financial_services"/>
    </informationRequirement>
    <informationRequirement id="decision_the_thing_is_services_ir3">
      <requiredInput href="#input_s_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_thing_is_services_literal">
      <text>s_2.the_service_involves_the_addition_to_or_maintenance_repair_or_alteration_of_goods_or_residential_property or (s_2.the_service_is_a_membership_in_a_club_or_organisation and s_2.the_club_or_organisation_is_a_business_formed_to_make_a_profit_for_its_owners or (s_2.the_service_is_the_right_to_use_time_share_accommodation_under_a_time_share_contract and the_contract_is_a_time_share_contract or s_2.the_service_is_offered_or_provided_as_financial_services and the_service_is_financial_services))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transaction_is_an_excluded_transaction" name="the_transaction_is_an_excluded_transaction" label="the transaction is an excluded transaction">
    <variable id="decision_the_transaction_is_an_excluded_transaction_var" name="the_transaction_is_an_excluded_transaction" label="the transaction is an excluded transaction" typeRef="boolean"/>
    <informationRequirement id="decision_the_transaction_is_an_excluded_transaction_ir1">
      <requiredInput href="#input_t_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_transaction_is_an_excluded_transaction_literal">
      <text>t_2.the_transaction_is_the_acquisition_of_an_estate_or_interest_in_immovable_property and not(t_2.the_transaction_is_a_lease_of_residential_property_granted_in_consideration_of_rent or t_2.the_transaction_is_a_time_share_contract) or t_2.the_transaction_is_service_provided_under_a_contract_of_employment</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transaction_is_a_consumer_transaction" name="the_transaction_is_a_consumer_transaction" label="the transaction is a consumer transaction">
    <variable id="decision_the_transaction_is_a_consumer_transaction_var" name="the_transaction_is_a_consumer_transaction" label="the transaction is a consumer transaction" typeRef="boolean"/>
    <informationRequirement id="decision_the_transaction_is_a_consumer_transaction_ir1">
      <requiredDecision href="#decision_the_transaction_is_an_excluded_transaction"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transaction_is_a_consumer_transaction_ir2">
      <requiredInput href="#input_t_3"/>
    </informationRequirement>
    <literalExpression id="decision_the_transaction_is_a_consumer_transaction_literal">
      <text>(t_3.a_supplier_supplies_goods_or_services_to_a_consumer_as_a_result_of_a_purchase_lease_gift_contest_or_other_arrangement or t_3.a_supplier_and_a_consumer_have_an_agreement_made_as_a_result_of_a_purchase_lease_gift_contest_or_other_arrangement_under_which_the_supplier_is_to_supply_goods_or_services_to_the_consumer_or_to_another_consumer_specified_in_the_agreement) and not(the_transaction_is_an_excluded_transaction)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_information_is_a_material_fact" name="the_information_is_a_material_fact" label="the information is a material fact">
    <variable id="decision_the_information_is_a_material_fact_var" name="the_information_is_a_material_fact" label="the information is a material fact" typeRef="boolean"/>
    <informationRequirement id="decision_the_information_is_a_material_fact_ir1">
      <requiredInput href="#input_the_supplier_knows_or_ought_reasonably_to_know_that_the_information_would_affect_the_decision_of_a_consumer_to_enter_into_a_consumer_transaction"/>
    </informationRequirement>
    <literalExpression id="decision_the_information_is_a_material_fact_literal">
      <text>the_supplier_knows_or_ought_reasonably_to_know_that_the_information_would_affect_the_decision_of_a_consumer_to_enter_into_a_consumer_transaction</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_contract_is_a_motor_vehicle_sale_contract" name="the_contract_is_a_motor_vehicle_sale_contract" label="the contract is a motor vehicle sale contract">
    <variable id="decision_the_contract_is_a_motor_vehicle_sale_contract_var" name="the_contract_is_a_motor_vehicle_sale_contract" label="the contract is a motor vehicle sale contract" typeRef="boolean"/>
    <informationRequirement id="decision_the_contract_is_a_motor_vehicle_sale_contract_ir1">
      <requiredInput href="#input_the_contract_is_between_a_consumer_and_a_supplier_of_motor_vehicles"/>
    </informationRequirement>
    <informationRequirement id="decision_the_contract_is_a_motor_vehicle_sale_contract_ir2">
      <requiredInput href="#input_the_contract_is_for_the_sale_of_a_motor_vehicle_to_the_consumer"/>
    </informationRequirement>
    <literalExpression id="decision_the_contract_is_a_motor_vehicle_sale_contract_literal">
      <text>the_contract_is_between_a_consumer_and_a_supplier_of_motor_vehicles and the_contract_is_for_the_sale_of_a_motor_vehicle_to_the_consumer</text>
    </literalExpression>
  </decision>
  <decision id="decision_no_regulations_under_section_43_2_k_specifying_a_dispute_resolution_scheme_are_encoded_in_this_model" name="no_regulations_under_section_43_2_k_specifying_a_dispute_resolution_scheme_are_encoded_in_this_model" label="no regulations under section 43(2)(k) specifying a dispute resolution scheme are encoded in this model">
    <description>REFUSE: no regulations under section 43(2)(k) specifying a dispute resolution scheme are encoded in this model</description>
    <variable id="decision_no_regulations_under_section_43_2_k_specifying_a_dispute_resolution_scheme_are_encoded_in_this_model_var" name="no_regulations_under_section_43_2_k_specifying_a_dispute_resolution_scheme_are_encoded_in_this_model" label="no regulations under section 43(2)(k) specifying a dispute resolution scheme are encoded in this model" typeRef="boolean"/>
    <literalExpression id="decision_no_regulations_under_section_43_2_k_specifying_a_dispute_resolution_scheme_are_encoded_in_this_model_literal">
      <text>null</text>
    </literalExpression>
  </decision>
  <decisionService id="service__2_1_consumer_and_2_2" name="_2_1_consumer_and_2_2" label="2(1) &quot;consumer&quot; and 2(2)">
    <variable id="service__2_1_consumer_and_2_2_var" name="_2_1_consumer_and_2_2" label="2(1) &quot;consumer&quot; and 2(2)" typeRef="boolean"/>
    <outputDecision href="#decision_the_person_is_a_consumer"/>
    <encapsulatedDecision href="#decision_the_person_is_treated_as_acting_exclusively_in_the_course_of_business"/>
    <inputData href="#input_c"/>
  </decisionService>
  <decisionService id="service__2_1_financial_product_and_financial_services_2_3" name="_2_1_financial_product_and_financial_services_2_3" label="2(1) &quot;financial product&quot; and &quot;financial services&quot;; 2(3)">
    <variable id="service__2_1_financial_product_and_financial_services_2_3_var" name="_2_1_financial_product_and_financial_services_2_3" label="2(1) &quot;financial product&quot; and &quot;financial services&quot;; 2(3)" typeRef="Any"/>
    <outputDecision href="#decision_the_thing_is_a_financial_product"/>
    <outputDecision href="#decision_the_service_is_financial_services"/>
    <encapsulatedDecision href="#decision_the_thing_is_regulated_as_a_financial_matter"/>
    <inputData href="#input_r"/>
  </decisionService>
  <decisionService id="service__2_1_residential_property_voucher_goods" name="_2_1_residential_property_voucher_goods" label="2(1) &quot;residential property&quot;, &quot;voucher&quot;, &quot;goods&quot;">
    <variable id="service__2_1_residential_property_voucher_goods_var" name="_2_1_residential_property_voucher_goods" label="2(1) &quot;residential property&quot;, &quot;voucher&quot;, &quot;goods&quot;" typeRef="boolean"/>
    <outputDecision href="#decision_the_thing_is_goods"/>
    <encapsulatedDecision href="#decision_the_thing_is_residential_property"/>
    <encapsulatedDecision href="#decision_the_thing_is_a_voucher"/>
    <inputDecision href="#decision_the_thing_is_a_financial_product"/>
    <inputData href="#input_p"/>
    <inputData href="#input_v"/>
    <inputData href="#input_g"/>
  </decisionService>
  <decisionService id="service__2_1_time_share_contract_services" name="_2_1_time_share_contract_services" label="2(1) &quot;time share contract&quot;, &quot;services&quot;">
    <variable id="service__2_1_time_share_contract_services_var" name="_2_1_time_share_contract_services" label="2(1) &quot;time share contract&quot;, &quot;services&quot;" typeRef="boolean"/>
    <outputDecision href="#decision_the_thing_is_services"/>
    <encapsulatedDecision href="#decision_the_contract_is_a_time_share_contract"/>
    <inputDecision href="#decision_the_service_is_financial_services"/>
    <inputData href="#input_t"/>
    <inputData href="#input_s_2"/>
  </decisionService>
  <decisionService id="service__2_1_consumer_transaction_first_schedule" name="_2_1_consumer_transaction_First_Schedule" label="2(1) &quot;consumer transaction&quot;; First Schedule">
    <variable id="service__2_1_consumer_transaction_first_schedule_var" name="_2_1_consumer_transaction_First_Schedule" label="2(1) &quot;consumer transaction&quot;; First Schedule" typeRef="boolean"/>
    <outputDecision href="#decision_the_transaction_is_a_consumer_transaction"/>
    <encapsulatedDecision href="#decision_the_transaction_is_an_excluded_transaction"/>
    <inputData href="#input_t_2"/>
    <inputData href="#input_t_3"/>
  </decisionService>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="definitions_part_1_preliminary_diagram" name="Part 1 -- Preliminary">
      <dmndi:DMNShape id="input_s_shape" dmnElementRef="input_s">
        <dc:Bounds x="60" y="540" width="180" height="80"/>
      </dmndi:DMNShape>
