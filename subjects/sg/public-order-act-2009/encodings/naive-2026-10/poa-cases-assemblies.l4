IMPORT prelude
IMPORT `poa-assemblies`

-- Public Order Act 2009, ss 2, 3, 5, 6A, 7(2)(h), 9, 11, 14 to 19, 34 to 38, 41, 42 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_public-order-act-2009.py). Expected results were written by
-- hand from the text.

`a protest rally in a public park` MEANS Gathering WITH
    `purpose` IS `support for or opposition to a person, group or government`
    `is a march` IS FALSE
    `held in a public place` IS TRUE
    `the public in general are invited` IS FALSE
    `in an unrestricted area` IS FALSE
    `within an enhanced security special event area` IS FALSE
    `exempted by Ministerial order` IS FALSE

`one person with a placard outside a ministry` MEANS Gathering WITH
    `purpose` IS `publicising a cause or campaign`
    `is a march` IS FALSE
    `held in a public place` IS TRUE
    `the public in general are invited` IS FALSE
    `in an unrestricted area` IS FALSE
    `within an enhanced security special event area` IS FALSE
    `exempted by Ministerial order` IS FALSE

