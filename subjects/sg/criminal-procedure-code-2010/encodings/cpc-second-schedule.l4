      , (`Second Schedule Item` OF "3A", "Casino Control Act 2006", "Casino Control Act 2006", "")
      , (`Second Schedule Item` OF "4", "Computer Misuse Act 1993", "Computer Misuse Act 1993", "")
      , (`Second Schedule Item` OF "5", "Corrosive and Explosive Substances and Offensive Weapons Act 1958", "Corrosive and Explosive Substances and Offensive Weapons Act 1958", "")
      , (`Second Schedule Item` OF "6", "Corruption, Drug Trafficking and Other Serious Crimes (Confiscation of Benefits) Act 1992", "Corruption, Drug Trafficking and Other Serious Crimes (Confiscation of Benefits) Act 1992", "")
      , (`Second Schedule Item` OF "7", "Criminal Law (Temporary Provisions) Act 1955", "Criminal Law (Temporary Provisions) Act 1955", "")
      , (`Second Schedule Item` OF "7A", "Guns, Explosives and Weapons Control Act 2021", "Guns, Explosives and Weapons Control Act 2021", "")
      , (`Second Schedule Item` OF "8", "Hijacking of Aircraft and Protection of Aircraft and International Airports Act 1978", "Hijacking of Aircraft and Protection of Aircraft and International Airports Act 1978", "")
      , (`Second Schedule Item` OF "9", "Immigration Act 1959", "Immigration Act 1959 (other than sections 6 and 15)", "other than sections 6 and 15")
      , (`Second Schedule Item` OF "9A", "Infrastructure Protection Act 2017", "Infrastructure Protection Act 2017", "")
      , (`Second Schedule Item` OF "10", "Internal Security Act 1960", "Internal Security Act 1960", "")
      , (`Second Schedule Item` OF "10A", "Maintenance of Racial Harmony Act 2025", "Maintenance of Racial Harmony Act 2025", "")
      , (`Second Schedule Item` OF "11", "Maintenance of Religious Harmony Act 1990", "Maintenance of Religious Harmony Act 1990", "")
      , (`Second Schedule Item` OF "12", "Misuse of Drugs Act 1973", "Misuse of Drugs Act 1973", "")
      , (`Second Schedule Item` OF "12A", "Moneylenders Act 2008", "Moneylenders Act 2008", "")
      , (`Second Schedule Item` OF "13", "Oaths and Declarations Act 2000", "Oaths and Declarations Act 2000", "")
      , (`Second Schedule Item` OF "14", "Official Secrets Act 1935", "Official Secrets Act 1935", "")
      , (`Second Schedule Item` OF "15", "Passports Act 2007", "Passports Act 2007", "")
      , (`Second Schedule Item` OF "16", "Penal Code 1871", "Penal Code 1871", "")
      , (`Second Schedule Item` OF "16A", "Prevention of Corruption Act 1960", "Prevention of Corruption Act 1960", "")
      , (`Second Schedule Item` OF "16B", "Prevention of Human Trafficking Act 2014", "Prevention of Human Trafficking Act 2014", "")
      , (`Second Schedule Item` OF "17", "Prisons Act 1933", "Prisons Act 1933", "")
      , (`Second Schedule Item` OF "18", "Protected Areas and Protected Places Act", "Protected Areas and Protected Places Act (Cap. 256, 2013 Revised Edition)", "the Act in its Cap. 256, 2013 Revised Edition")
      , (`Second Schedule Item` OF "19", "Public Entertainments Act 1958", "Public Entertainments Act 1958", "")
      , (`Second Schedule Item` OF "20", "Public Order and Safety (Special Powers) Act 2018", "Public Order and Safety (Special Powers) Act 2018", "")
      , (`Second Schedule Item` OF "20A", "Remote Gambling Act 2014", "Remote Gambling Act 2014", "")
      , (`Second Schedule Item` OF "21", "Securities and Futures Act 2001", "Securities and Futures Act 2001", "")
      , (`Second Schedule Item` OF "22", "Sedition Act 1948", "Sedition Act 1948", "")
      , (`Second Schedule Item` OF "23", "Vandalism Act 1966", "Vandalism Act 1966", "")

@ref "Criminal Procedure Code 2010, Second Schedule"
GIVEN act IS A STRING
GIVETH A LIST OF `Second Schedule Item`
`the Second Schedule items for the Act` MEANS
    filter (GIVEN i YIELD i's `Act` EQUALS act) `the Second Schedule`

-- An offence is "set out in a written law specified in the Second Schedule" when the Act that creates it is a listed Act, subject to the
-- item's qualification: item 9 excludes sections 6 and 15 of the Immigration Act 1959 (the section is given without its subsections);
-- item 2A is the Banishment Act 1959 only "as in force immediately before the date of commencement of section 61 of the Immigration
-- (Amendment) Act 2023"; item 18's qualifier names the edition of the Act and is a fact about which Act is meant, not a condition.
@ref "Criminal Procedure Code 2010, Second Schedule, items 1 to 23; ss 159(1)(a), 211A(1)(b)(i)"
GIVEN w IS A `Written Law Offence Facts`
GIVETH A BOOLEAN
DECIDE `the offence is under a law specified in the Second Schedule` IF
        NOT null (`the Second Schedule items for the Act` (w's `the Act under which the offence is created`))
    AND NOT (   w's `the Act under which the offence is created` EQUALS "Immigration Act 1959"
            AND (   w's `the section of that Act, without subsections` EQUALS "6"
                 OR w's `the section of that Act, without subsections` EQUALS "15"))
    AND (   NOT w's `the Act under which the offence is created` EQUALS "Banishment Act 1959"
         OR w's `the offence is under the Act as in force immediately before the date the Second Schedule item names`)

§ `159. State Courts: Part 9 Division 2`

-- 159(1): the criminal case disclosure procedures apply to an offence which (a) is specified in the Second Schedule and (b) is to be
-- tried in a District Court.  159(3): for any other offence the procedures do not apply unless all parties consent.  (159(2) is deleted.)
@ref "Criminal Procedure Code 2010, s 159(1)"
GIVEN w IS A `Written Law Offence Facts`, d IS A `State Court Disclosure Facts`
GIVETH A BOOLEAN
DECIDE `the criminal case disclosure procedures of Part 9 apply by section 159(1)` IF
        `the offence is under a law specified in the Second Schedule` w
    AND d's `the offence is to be tried in a District Court`

@ref "Criminal Procedure Code 2010, s 159(1) and (3)"
GIVEN w IS A `Written Law Offence Facts`, d IS A `State Court Disclosure Facts`
GIVETH A BOOLEAN
DECIDE `the criminal case disclosure procedures of Part 9 apply` IF
        `the criminal case disclosure procedures of Part 9 apply by section 159(1)` w d
    OR  d's `all parties consent to have the criminal case disclosure procedures apply`

§ `211A. General Division of the High Court: Part 10 Division 5`

-- 211A(1): the procedures apply to any offence (a) that must be tried in the General Division of the High Court, or (b) that (i) is set out
-- in a written law specified in the Second Schedule and (ii) the Public Prosecutor designates the General Division of the High Court to
-- try.  211A(2): they also apply to any other offence to be tried in the General Division of the High Court if all parties consent.
-- Note that (a) does not ask for a Schedule law: an offence that must be tried in the High Court is within it whatever the Act.
@ref "Criminal Procedure Code 2010, s 211A(1)(a) and (b)"
GIVEN w IS A `Written Law Offence Facts`, h IS A `High Court Disclosure Facts`
GIVETH A BOOLEAN
DECIDE `the criminal case disclosure procedures of Part 10 Division 5 apply by section 211A(1)` IF
        h's `the offence must be tried in the General Division of the High Court`
    OR  (   `the offence is under a law specified in the Second Schedule` w
        AND h's `the Public Prosecutor designates the General Division of the High Court to try the offence`)

@ref "Criminal Procedure Code 2010, s 211A(1) and (2)"
GIVEN w IS A `Written Law Offence Facts`, h IS A `High Court Disclosure Facts`
GIVETH A BOOLEAN
DECIDE `the criminal case disclosure procedures of Part 10 Division 5 apply` IF
        `the criminal case disclosure procedures of Part 10 Division 5 apply by section 211A(1)` w h
    OR  (   h's `all parties consent to have the criminal case disclosure procedures apply`
        AND (   h's `the offence must be tried in the General Division of the High Court`
             OR h's `the Public Prosecutor designates the General Division of the High Court to try the offence`))
