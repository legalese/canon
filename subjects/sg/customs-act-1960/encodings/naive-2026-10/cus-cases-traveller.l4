IMPORT prelude
IMPORT `cus-traveller`

-- Customs Act 1960, ss 19, 20, 93, 115, 115A, 124, 127, 128E to 128L and 136 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_cus.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a traveller who declares and pays` MEANS Arrival WITH
    `carries dutiable goods beyond the allowance or with no allowance` IS TRUE
    `declared them at the Red Channel` IS TRUE
    `paid the duty before proceeding` IS TRUE
    `took the Green Channel` IS FALSE

`a traveller with excess liquor in the Green Channel` MEANS Arrival WITH
    `carries dutiable goods beyond the allowance or with no allowance` IS TRUE
    `declared them at the Red Channel` IS FALSE
    `paid the duty before proceeding` IS FALSE
    `took the Green Channel` IS TRUE

`a traveller within allowance in the Green Channel` MEANS Arrival WITH
    `carries dutiable goods beyond the allowance or with no allowance` IS FALSE
    `declared them at the Red Channel` IS FALSE
    `paid the duty before proceeding` IS FALSE
    `took the Green Channel` IS TRUE

`a traveller who declares but does not pay` MEANS Arrival WITH
    `carries dutiable goods beyond the allowance or with no allowance` IS TRUE
    `declared them at the Red Channel` IS TRUE
    `paid the duty before proceeding` IS FALSE
    `took the Green Channel` IS FALSE

`$40 of duty on excess wine` MEANS Evasion WITH
    `duty evaded` IS 40
    `involves tobacco` IS FALSE
    `tobacco weight in kg` IS 0

`$1,000 of duty on excess spirits` MEANS Evasion WITH
    `duty evaded` IS 1000
    `involves tobacco` IS FALSE
    `tobacco weight in kg` IS 0

`$10 of duty on a pack of cigarettes` MEANS Evasion WITH
    `duty evaded` IS 10
    `involves tobacco` IS TRUE
    `tobacco weight in kg` IS 0.02

`$300 of duty on 1.5 kg of tobacco` MEANS Evasion WITH
    `duty evaded` IS 300
    `involves tobacco` IS TRUE
    `tobacco weight in kg` IS 1.5

`$2,000 of duty on 5 kg of tobacco` MEANS Evasion WITH
    `duty evaded` IS 2000
    `involves tobacco` IS TRUE
    `tobacco weight in kg` IS 5

`$200 of duty on 3 kg of tobacco` MEANS Evasion WITH
    `duty evaded` IS 200
    `involves tobacco` IS TRUE
    `tobacco weight in kg` IS 3

`the owner of a car lent to a smuggler` MEANS VehicleFind WITH
    `goods found in the vehicle` IS TRUE
    `is the owner` IS TRUE
    `is the person in charge` IS FALSE
    `rebutted the presumption` IS FALSE

`the driver of the car` MEANS VehicleFind WITH
    `goods found in the vehicle` IS TRUE
    `is the owner` IS FALSE
    `is the person in charge` IS TRUE
    `rebutted the presumption` IS FALSE

`the owner who proved the loan and ignorance` MEANS VehicleFind WITH
    `goods found in the vehicle` IS TRUE
    `is the owner` IS TRUE
    `is the person in charge` IS FALSE
    `rebutted the presumption` IS TRUE

`a passenger who is neither` MEANS VehicleFind WITH
    `goods found in the vehicle` IS TRUE
    `is the owner` IS FALSE
    `is the person in charge` IS FALSE
    `rebutted the presumption` IS FALSE

`a half-tank car past the gantry` MEANS Departure WITH
    `fuel as a fraction of the tank` IS 0.5
    `prescribed minimum fraction` IS 0.75
    `drove past the Customs gantry` IS TRUE
    `has written permission` IS FALSE
    `permission came after the attempt` IS FALSE

`a full-tank car past the gantry` MEANS Departure WITH
    `fuel as a fraction of the tank` IS 1
    `prescribed minimum fraction` IS 0.75
    `drove past the Customs gantry` IS TRUE
    `has written permission` IS FALSE
    `permission came after the attempt` IS FALSE

`a half-tank car with prior permission` MEANS Departure WITH
    `fuel as a fraction of the tank` IS 0.5
    `prescribed minimum fraction` IS 0.75
    `drove past the Customs gantry` IS TRUE
    `has written permission` IS TRUE
    `permission came after the attempt` IS FALSE

`a half-tank car permitted only after being stopped` MEANS Departure WITH
    `fuel as a fraction of the tank` IS 0.5
    `prescribed minimum fraction` IS 0.75
    `drove past the Customs gantry` IS TRUE
    `has written permission` IS TRUE
    `permission came after the attempt` IS TRUE

`a half-tank car that turned back before the gantry` MEANS Departure WITH
    `fuel as a fraction of the tank` IS 0.5
    `prescribed minimum fraction` IS 0.75
    `drove past the Customs gantry` IS FALSE
    `has written permission` IS FALSE
    `permission came after the attempt` IS FALSE

§ `s 93`

#ASSERT NOT `the goods are uncustomed` `a traveller who declares and pays`
#ASSERT `the goods are uncustomed` `a traveller with excess liquor in the Green Channel`
#ASSERT NOT `the goods are uncustomed` `a traveller within allowance in the Green Channel`
#ASSERT `the goods are uncustomed` `a traveller who declares but does not pay`

#ASSERT NOT `possession of uncustomed goods is presumed` `a traveller who declares and pays`
#ASSERT `possession of uncustomed goods is presumed` `a traveller with excess liquor in the Green Channel`
#ASSERT NOT `possession of uncustomed goods is presumed` `a traveller within allowance in the Green Channel`
#ASSERT NOT `possession of uncustomed goods is presumed` `a traveller who declares but does not pay`

§ `ss 128E to 128J`

#ASSERT `the conduct is a specified offence` `denying having dutiable goods that are then found`
#ASSERT `the conduct is a specified offence` `possessing uncustomed goods`
