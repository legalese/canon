IMPORT prelude
IMPORT `upa-publications`

-- Undesirable Publications Act 1967, ss 2-4, 6, 7, 9, 10(2), 11, 12, 13(3), 15-17, 20 and 21 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_undesirable-publications-act-1967.py). Expected results were written by
-- hand from the text.

§ `s 2`

#ASSERT `the item is a publication` `a printed book`
#ASSERT `the item is a publication` `a music CD`
#ASSERT `the item is a publication` `a USB stick holding image files`
#ASSERT NOT `the item is a publication` `a cinema film`

#ASSERT `the mode is supply` `lending a copy`
#ASSERT `the mode is supply` `emailing the contents`
#ASSERT NOT `the mode is supply` `broadcasting the contents`

§ `ss 3, 4`

#ASSERT NOT `the publication is obscene` FALSE FALSE
#ASSERT `the publication is obscene` FALSE TRUE

#ASSERT NOT `the publication is objectionable` FALSE FALSE
#ASSERT `the publication is objectionable` FALSE TRUE

§ `s 6`

#ASSERT `the dealing is a section 6 offence` `selling` TRUE FALSE
#ASSERT NOT `the dealing is a section 6 offence` `selling` FALSE FALSE
#ASSERT `the dealing is a section 6 offence` `possessing` TRUE FALSE
#ASSERT NOT `the dealing is a section 6 offence` `possessing` TRUE TRUE
#ASSERT `the dealing is a section 6 offence` `reproducing` TRUE TRUE

#ASSERT `the section 6 maximum fine` `selling` FALSE EQUALS 10000
#ASSERT `the section 6 maximum fine` `selling` TRUE EQUALS 0
#ASSERT `the section 6 maximum fine` `possessing` FALSE EQUALS 2000

#ASSERT `the section 6 maximum imprisonment in months` `distributing` FALSE EQUALS 36
#ASSERT `the section 6 maximum imprisonment in months` `distributing` TRUE EQUALS 48
#ASSERT `the section 6 maximum imprisonment in months` `possessing` TRUE EQUALS 24

§ `s 7`

#ASSERT `must deliver it to a police station` `sent unsolicited`
#ASSERT `must deliver it to a police station` `already held when the prohibition took effect`
#ASSERT NOT `must deliver it to a police station` `ordered after the prohibition`

#ASSERT `failing to deliver is an offence` `sent unsolicited` FALSE
#ASSERT NOT `failing to deliver is an offence` `sent unsolicited` TRUE

§ `s 9`

#ASSERT `the court must order forfeiture` TRUE FALSE
#ASSERT NOT `the court must order forfeiture` FALSE TRUE

§ `ss 11, 12`

#ASSERT `the conduct is caught by sections 11 and 12` `making it for own use`
#ASSERT NOT `the conduct is caught by sections 11 and 12` `importing it for own use`
#ASSERT `the conduct is caught by sections 11 and 12` `giving it to a friend`

#ASSERT `the conduct is a section 11 offence` `making it for own use` TRUE FALSE TRUE
#ASSERT NOT `the conduct is a section 11 offence` `selling it` TRUE TRUE TRUE
#ASSERT NOT `the conduct is a section 11 offence` `selling it` TRUE FALSE FALSE

#ASSERT NOT `the conduct is a section 12 offence` `keeping it for own use` TRUE FALSE TRUE

#ASSERT `the section 11 or 12 maximum fine` `obscene` EQUALS 10000
#ASSERT `the section 11 or 12 maximum fine` `objectionable` EQUALS 5000

