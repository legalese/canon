#ASSERT NOT `entitled to purchase a flat from the Board` (`buyer` FALSE (JUST (YMD 2023 7 2)) (YMD 2026 1 1) NOTHING)
-- E06: sold 30 Jun 2023
#ASSERT `entitled to purchase a flat from the Board` (`buyer` FALSE (JUST (YMD 2023 6 30)) (YMD 2026 1 1) NOTHING)
