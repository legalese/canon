IMPORT prelude
IMPORT daydate
IMPORT `cpa-types`

-- Carbon Pricing Act 2018 — THE SCHEDULES AS DATA.
--
-- First Schedule (greenhouse gases, formulas, global warming potentials),
-- Second Schedule (thresholds; non-reckonable and excluded emissions) and
-- Third Schedule (carbon tax rate; carbon price), as amended by Act 37 of
-- 2022 wef 1 January 2024. The gas table is generated from
-- ../source/CPA2018.txt; names wrapped over lines in the PDF are joined.

§ `The Schedules`

§§ `First Schedule — greenhouse gases and global warming potential`

DECLARE `Gas family` IS ONE OF `a hydrofluorocarbon`, `a perfluorocarbon`, `another listed gas`

DECLARE `First Schedule row` HAS
    `item`                     IS A STRING
    `chemical formula`         IS A STRING
    `global warming potential` IS A NUMBER
    `family`                   IS A `Gas family`

@ref First Schedule
GIVEN gas IS A STRING
GIVETH A MAYBE `First Schedule row`
`the First Schedule row for` gas MEANS
    BRANCH
        IF gas EQUALS "Carbon dioxide"                                                THEN JUST (`First Schedule row` OF "1", "CO2", 1, `another listed gas`)
        IF gas EQUALS "Methane"                                                       THEN JUST (`First Schedule row` OF "2", "CH4", 28, `another listed gas`)
        IF gas EQUALS "Nitrous oxide"                                                 THEN JUST (`First Schedule row` OF "3", "N2O", 265, `another listed gas`)
        IF gas EQUALS "Nitrogen trifluoride"                                          THEN JUST (`First Schedule row` OF "4", "NF3", 16100, `another listed gas`)
        IF gas EQUALS "Sulphur hexafluoride"                                          THEN JUST (`First Schedule row` OF "5", "SF6", 23500, `another listed gas`)
        IF gas EQUALS "HFC-23"                                                        THEN JUST (`First Schedule row` OF "6(a)", "CHF3", 12400, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-32"                                                        THEN JUST (`First Schedule row` OF "6(b)", "CH2F2", 677, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-41"                                                        THEN JUST (`First Schedule row` OF "6(c)", "CH3F", 116, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-125"                                                       THEN JUST (`First Schedule row` OF "6(d)", "CHF2CF3", 3170, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-134"                                                       THEN JUST (`First Schedule row` OF "6(e)", "CHF2CHF2", 1120, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-134a"                                                      THEN JUST (`First Schedule row` OF "6(f)", "CH2FCF3", 1300, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-143"                                                       THEN JUST (`First Schedule row` OF "6(g)", "CH2FCHF2", 328, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-143a"                                                      THEN JUST (`First Schedule row` OF "6(h)", "CH3CF3", 4800, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-152"                                                       THEN JUST (`First Schedule row` OF "6(i)", "CH2FCH2F", 16, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-152a"                                                      THEN JUST (`First Schedule row` OF "6(j)", "CH3CHF2", 138, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-161"                                                       THEN JUST (`First Schedule row` OF "6(k)", "CH3CH2F", 4, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-227ca"                                                     THEN JUST (`First Schedule row` OF "6(l)", "CF3CF2CHF2", 2640, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-227ea"                                                     THEN JUST (`First Schedule row` OF "6(m)", "CF3CHFCF3", 3350, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-236cb"                                                     THEN JUST (`First Schedule row` OF "6(n)", "CH2FCF2CF3", 1210, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-236ea"                                                     THEN JUST (`First Schedule row` OF "6(o)", "CHF2CHFCF3", 1330, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-236fa"                                                     THEN JUST (`First Schedule row` OF "6(p)", "CF3CH2CF3", 8060, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-245ca"                                                     THEN JUST (`First Schedule row` OF "6(q)", "CH2FCF2CHF2", 716, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-245cb"                                                     THEN JUST (`First Schedule row` OF "6(r)", "CF3CF2CH3", 4620, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-245ea"                                                     THEN JUST (`First Schedule row` OF "6(s)", "CHF2CHFCHF2", 235, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-245eb"                                                     THEN JUST (`First Schedule row` OF "6(t)", "CH2FCHFCF3", 290, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-245fa"                                                     THEN JUST (`First Schedule row` OF "6(u)", "CHF2CH2CF3", 858, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-263fb"                                                     THEN JUST (`First Schedule row` OF "6(v)", "CH3CH2CF3", 76, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-272ca"                                                     THEN JUST (`First Schedule row` OF "6(w)", "CH3CF2CH3", 144, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-329p"                                                      THEN JUST (`First Schedule row` OF "6(x)", "CHF2CF2CF2CF3", 2360, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-365mfc"                                                    THEN JUST (`First Schedule row` OF "6(y)", "CH3CF2CH2CF3", 804, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-43-10mee"                                                  THEN JUST (`First Schedule row` OF "6(z)", "CF3CHFCHFCF2CF3", 1650, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-1132a"                                                     THEN JUST (`First Schedule row` OF "6(za)", "CH2=CF2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-1141"                                                      THEN JUST (`First Schedule row` OF "6(zb)", "CH2=CHF", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "(Z)-HFC-1225ye"                                                THEN JUST (`First Schedule row` OF "6(zc)", "CF3CF=CHF(Z)", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "(E)-HFC-1225ye"                                                THEN JUST (`First Schedule row` OF "6(zd)", "CF3CF=CHF(E)", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "(Z)-HFC-1234ze"                                                THEN JUST (`First Schedule row` OF "6(ze)", "CF3CH=CHF(Z)", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-1234yf"                                                    THEN JUST (`First Schedule row` OF "6(zf)", "CF3CF=CH2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "(E)-HFC-1234ze"                                                THEN JUST (`First Schedule row` OF "6(zg)", "trans-CF3CH=CHF", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "(Z)-HFC-1336"                                                  THEN JUST (`First Schedule row` OF "6(zh)", "CF3CH=CHCF3(Z)", 2, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-1243zf"                                                    THEN JUST (`First Schedule row` OF "6(zi)", "CF3CH=CH2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "HFC-1345zfc"                                                   THEN JUST (`First Schedule row` OF "6(zj)", "C2F5CH=CH2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "3,3,4,4,5,5,6,6,6-Nonafluorohex-1-ene"                         THEN JUST (`First Schedule row` OF "6(zk)", "C4F9CH=CH2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "3,3,4,4,5,5,6,6,7,7,8,8,8-Tridecafluorooct-1-ene"              THEN JUST (`First Schedule row` OF "6(zl)", "C6F13CH=CH2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "3,3,4,4,5,5,6,6,7,7,8,8,9,9,10,10,10-Heptadecafluorodec-1-ene" THEN JUST (`First Schedule row` OF "6(zm)", "C8F17CH=CH2", 1, `a hydrofluorocarbon`)
        IF gas EQUALS "PFC-14"                                                        THEN JUST (`First Schedule row` OF "7(a)", "CF4", 6630, `a perfluorocarbon`)
        IF gas EQUALS "PFC-116"                                                       THEN JUST (`First Schedule row` OF "7(b)", "C2F6", 11100, `a perfluorocarbon`)
        IF gas EQUALS "PFC-c216"                                                      THEN JUST (`First Schedule row` OF "7(c)", "c-C3F6", 9200, `a perfluorocarbon`)
        IF gas EQUALS "PFC-218"                                                       THEN JUST (`First Schedule row` OF "7(d)", "C3F8", 8900, `a perfluorocarbon`)
        IF gas EQUALS "PFC-318"                                                       THEN JUST (`First Schedule row` OF "7(e)", "c-C4F8", 9540, `a perfluorocarbon`)
        IF gas EQUALS "PFC-31-10"                                                     THEN JUST (`First Schedule row` OF "7(f)", "C4F10", 9200, `a perfluorocarbon`)
        IF gas EQUALS "Perfluorocyclopentene"                                         THEN JUST (`First Schedule row` OF "7(g)", "c-C5F8", 2, `a perfluorocarbon`)
        IF gas EQUALS "PFC-41-12"                                                     THEN JUST (`First Schedule row` OF "7(h)", "n-C5F12", 8550, `a perfluorocarbon`)
        IF gas EQUALS "PFC-51-14"                                                     THEN JUST (`First Schedule row` OF "7(i)", "n-C6F14", 7910, `a perfluorocarbon`)
        IF gas EQUALS "PFC-61-16"                                                     THEN JUST (`First Schedule row` OF "7(j)", "n-C7F16", 7820, `a perfluorocarbon`)
        IF gas EQUALS "PFC-71-18"                                                     THEN JUST (`First Schedule row` OF "7(k)", "C8F18", 7620, `a perfluorocarbon`)
        IF gas EQUALS "PFC-91-18"                                                     THEN JUST (`First Schedule row` OF "7(l)", "C10F18", 7190, `a perfluorocarbon`)
        IF gas EQUALS "Perfluorodecalin (cis)"                                        THEN JUST (`First Schedule row` OF "7(m)", "Z-C10F18", 7240, `a perfluorocarbon`)
        IF gas EQUALS "Perfluorodecalin (trans)"                                      THEN JUST (`First Schedule row` OF "7(n)", "E-C10F18", 6290, `a perfluorocarbon`)
        IF gas EQUALS "PFC-1114"                                                      THEN JUST (`First Schedule row` OF "7(o)", "CF2=CF2", 1, `a perfluorocarbon`)
        IF gas EQUALS "PFC-1216"                                                      THEN JUST (`First Schedule row` OF "7(p)", "CF3CF=CF2", 1, `a perfluorocarbon`)
        IF gas EQUALS "Perfluorobuta-1,3-diene"                                       THEN JUST (`First Schedule row` OF "7(q)", "CF2=CFCF=CF2", 1, `a perfluorocarbon`)
        IF gas EQUALS "Perfluorobut-1-ene"                                            THEN JUST (`First Schedule row` OF "7(r)", "CF3CF2CF=CF2", 1, `a perfluorocarbon`)
        IF gas EQUALS "Perfluorobut-2-ene"                                            THEN JUST (`First Schedule row` OF "7(s)", "CF3CF=CFCF3", 2, `a perfluorocarbon`)
        OTHERWISE NOTHING

-- s 2 "greenhouse gas": a gas in the First Schedule's first column.
@ref s 2 "greenhouse gas"
GIVEN gas IS A STRING
GIVETH A BOOLEAN
DECIDE `a greenhouse gas under the Act:` gas IF
    CONSIDER `the First Schedule row for` gas
    WHEN JUST r  THEN TRUE
    WHEN NOTHING THEN FALSE

-- s 2 "carbon dioxide equivalence": "the mass of the greenhouse gas
-- multiplied by its global warming potential set out opposite the greenhouse
-- gas in the third column of the First Schedule".
@ref s 2 "carbon dioxide equivalence"
GIVEN e IS A `GHG emission`
GIVETH A NUMBER
`the tCO2e of` e MEANS
    CONSIDER `the First Schedule row for` (e's `gas`)
    WHEN JUST r  THEN e's `mass in tonnes` TIMES r's `global warming potential`
    WHEN NOTHING THEN REFUSE "s 2: the gas is not a greenhouse gas in the First Schedule"

§§ `Second Schedule Part 1 — emissions thresholds`

@ref Second Schedule Part 1 para 1
`the first emissions threshold` MEANS 2000     -- tCO2e

@ref Second Schedule Part 1 para 2
`the second emissions threshold` MEANS 25000   -- tCO2e

§§ `Second Schedule Parts 2 and 3 — non-reckonable and excluded emissions`

-- Part 2 items 4A and 5A: gases non-reckonable "in any circumstances".
@ref Second Schedule Part 2 item 4A
GIVETH A LIST OF STRING
`the item 4A hydrofluorocarbons` MEANS
    LIST "HFC-227ca",
         "HFC-245cb",
         "HFC-245ea",
         "HFC-245eb",
         "HFC-263fb",
         "HFC-272ca",
         "HFC-329p",
         "HFC-1132a",
         "HFC-1141",
         "(Z)-HFC-1225ye",
         "(E)-HFC-1225ye",
         "(Z)-HFC-1234ze",
         "HFC-1234yf",
         "(E)-HFC-1234ze",
         "(Z)-HFC-1336",
         "HFC-1243zf",
         "HFC-1345zfc",
         "3,3,4,4,5,5,6,6,6-Nonafluorohex-1-ene",
         "3,3,4,4,5,5,6,6,7,7,8,8,8-Tridecafluorooct-1-ene",
         "3,3,4,4,5,5,6,6,7,7,8,8,9,9,10,10,10-Heptadecafluorodec-1-ene"

@ref Second Schedule Part 2 item 5A
GIVETH A LIST OF STRING
`the item 5A perfluorocarbons` MEANS
    LIST "PFC-c216",
         "Perfluorocyclopentene",
         "PFC-61-16",
         "PFC-71-18",
         "PFC-91-18",
         "Perfluorodecalin (cis)",
         "Perfluorodecalin (trans)",
         "PFC-1114",
         "PFC-1216",
         "Perfluorobuta-1,3-diene",
         "Perfluorobut-1-ene",
         "Perfluorobut-2-ene"

-- s 2 "excluded GHG emission": a gas in Part 3's first column emitted in the
-- circumstances in its second column — any gas, (a) in using a vehicle to
-- transport persons or goods, or (b) in AFOLU activities.
@ref s 2 "excluded GHG emission"; Second Schedule Part 3
GIVEN e IS A `GHG emission`
GIVETH A BOOLEAN
DECIDE `an excluded GHG emission:` e IF
        "(a)" ... e's `circumstance` EQUALS `in using a vehicle to transport persons or goods`
    OR  "(b)" ... e's `circumstance` EQUALS `in carrying out AFOLU activities`

-- s 2 "non-reckonable GHG emission": a gas in Part 2's first column emitted in
-- the circumstances opposite it. Item 1 was deleted by Act 37 of 2022.
@ref s 2 "non-reckonable GHG emission"; Second Schedule Part 2
GIVEN e IS A `GHG emission`
GIVETH A BOOLEAN
DECIDE `a non-reckonable GHG emission:` e IF
        "item 2"  ... (`gas` EQUALS "Sulphur hexafluoride" AND `how` EQUALS `in manufacturing, installing, using or disposing of electrical equipment`)
    OR  "item 3"  ... (`gas` EQUALS "Carbon dioxide" AND elem `how` (LIST `used and emitted in purging`, `used and emitted in blasting`, `in using any lubricant or paraffin wax`, `in the combustion of a biomass fuel listed in item 3(d)`))
    OR  "item 4"  ... (`family` EQUALS JUST `a hydrofluorocarbon` AND `how` EQUALS `in using refrigeration or air-conditioning equipment for non-manufacturing purposes`)
    OR  "item 4A" ... elem `gas` `the item 4A hydrofluorocarbons`
    OR  "item 5"  ... (`family` EQUALS JUST `a perfluorocarbon` AND `how` EQUALS `in using refrigeration or air-conditioning equipment for non-manufacturing purposes`)
    OR  "item 5A" ... elem `gas` `the item 5A perfluorocarbons`
    OR  "item 6"  ... elem `how` (LIST `in using any fire protection equipment`, `as a fugitive emission, not flaring or venting`, `in using a vehicle to transport persons or goods`, `in using a fuel on which excise duty is payable or exempt under the Customs Act 1960`, `in carrying out AFOLU activities`)
    WHERE
        `gas` MEANS e's `gas`
        `how` MEANS e's `circumstance`
        `family` MEANS
            CONSIDER `the First Schedule row for` `gas`
            WHEN JUST r  THEN JUST (r's `family`)
            WHEN NOTHING THEN NOTHING

-- s 2 "reckonable GHG emission": "any GHG emission other than a
-- non-reckonable GHG emission".
@ref s 2 "reckonable GHG emission"
GIVEN e IS A `GHG emission`
GIVETH A BOOLEAN
DECIDE `a reckonable GHG emission:` e IF
    NOT `a non-reckonable GHG emission:` e

-- The total amount of reckonable GHG emissions, as carbon dioxide
-- equivalence (ss 7, 9, 16).
@ref ss 2, 7(1), 16(1)
GIVEN emissions IS A LIST OF `GHG emission`
GIVETH A NUMBER
`the reckonable tCO2e of` emissions MEANS
    sum (map (GIVEN e YIELD `the tCO2e of` e) (filter (GIVEN e YIELD `a reckonable GHG emission:` e) emissions))

-- s 11(2): an emissions report sets out the GHG emissions "other than excluded
-- GHG emissions".
@ref s 11(2)
GIVEN emissions IS A LIST OF `GHG emission`
GIVETH A LIST OF `GHG emission`
`the emissions to report among` emissions MEANS
    filter (GIVEN e YIELD NOT `an excluded GHG emission:` e) emissions

§§ `Third Schedule — carbon tax rate and carbon price`

-- Part 1 para 1: "(a) ... 2023 or any earlier emissions year — $5/tCO2e; (b)
-- ... 2024 or 2025 — $25/tCO2e; (c) ... 2026 or any later emissions year —
-- $45/tCO2e."
@ref Third Schedule Part 1 para 1
GIVEN `emissions year` IS A NUMBER
GIVETH A NUMBER
`the carbon tax rate for` `emissions year` MEANS
    BRANCH IF `emissions year` AT MOST 2023 THEN 5    -- (a)
           IF `emissions year` AT MOST 2025 THEN 25   -- (b)
           OTHERWISE                             45   -- (c)

-- Part 2 para 1: "(a) ... purchased in 2024 or any earlier year — $5; (b)
-- ... 2025 or 2026 — $25; (c) ... 2027 or any later year — $45." Subject to
-- s 31A (conversion).
@ref Third Schedule Part 2 para 1
GIVEN `year of purchase` IS A NUMBER
GIVETH A NUMBER
`the carbon price for credits purchased in` `year of purchase` MEANS
    BRANCH IF `year of purchase` AT MOST 2024 THEN 5    -- (a)
           IF `year of purchase` AT MOST 2026 THEN 25   -- (b)
           OTHERWISE                               45   -- (c)
