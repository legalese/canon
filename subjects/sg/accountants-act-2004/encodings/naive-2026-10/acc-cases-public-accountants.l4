IMPORT prelude
IMPORT `acc-public-accountants`

-- Accountants Act 2004, ss 2, 10, 24, 25, 52, 56, 57 and 59 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_acc.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a qualified 30-year-old of good character` MEANS Applicant WITH
    `age` IS 30
    `meets the prescribed qualifications, experience and membership` IS TRUE
    `of good reputation and character and otherwise fit` IS TRUE

`a qualified 20-year-old` MEANS Applicant WITH
    `age` IS 20
    `meets the prescribed qualifications, experience and membership` IS TRUE
    `of good reputation and character and otherwise fit` IS TRUE

`a qualified applicant of poor character` MEANS Applicant WITH
    `age` IS 40
    `meets the prescribed qualifications, experience and membership` IS TRUE
    `of good reputation and character and otherwise fit` IS FALSE

`an unqualified applicant` MEANS Applicant WITH
    `age` IS 40
    `meets the prescribed qualifications, experience and membership` IS FALSE
    `of good reputation and character and otherwise fit` IS TRUE

`hiring a known bankrupt` MEANS Hire WITH
    `known undischarged bankrupt` IS TRUE
    `known suspended or cancelled accountant` IS FALSE
    `known conviction with 12 months' jail or a $5,000 fine` IS FALSE
    `the Oversight Committee consented` IS FALSE

`hiring a known bankrupt with consent` MEANS Hire WITH
    `known undischarged bankrupt` IS TRUE
    `known suspended or cancelled accountant` IS FALSE
    `known conviction with 12 months' jail or a $5,000 fine` IS FALSE
    `the Oversight Committee consented` IS TRUE

`hiring someone fined $5,000 twenty years ago` MEANS Hire WITH
    `known undischarged bankrupt` IS FALSE
    `known suspended or cancelled accountant` IS FALSE
    `known conviction with 12 months' jail or a $5,000 fine` IS TRUE
    `the Oversight Committee consented` IS FALSE

`hiring someone with a clean record` MEANS Hire WITH
    `known undischarged bankrupt` IS FALSE
    `known suspended or cancelled accountant` IS FALSE
    `known conviction with 12 months' jail or a $5,000 fine` IS FALSE
    `the Oversight Committee consented` IS FALSE

`hiring a struck-off accountant` MEANS Hire WITH
    `known undischarged bankrupt` IS FALSE
    `known suspended or cancelled accountant` IS TRUE
    `known conviction with 12 months' jail or a $5,000 fine` IS FALSE
    `the Oversight Committee consented` IS FALSE

`a 2-year suspension and $10,000` MEANS Sanction WITH
    `months of suspension` IS 24
    `penalty` IS 10000

`a $20,000 penalty` MEANS Sanction WITH
    `months of suspension` IS 0
    `penalty` IS 20000

§ `s 2`

#ASSERT `the service is a public accountancy service` `a statutory audit of financial statements`
#ASSERT `the service is a public accountancy service` `an act a written law reserves to a public accountant`
#ASSERT NOT `the service is a public accountancy service` `bookkeeping`
#ASSERT NOT `the service is a public accountancy service` `preparing tax returns`
#ASSERT NOT `the service is a public accountancy service` `management accounts`
#ASSERT NOT `the service is a public accountancy service` `business valuation advice`

§ `ss 10, 11`

#ASSERT `the applicant meets section 10` `a qualified 30-year-old of good character`
#ASSERT NOT `the applicant meets section 10` `a qualified 20-year-old`
#ASSERT `the applicant meets section 10` `a qualified applicant of poor character`
#ASSERT NOT `the applicant meets section 10` `an unqualified applicant`

#ASSERT NOT `the Oversight Committee may refuse` `a qualified 30-year-old of good character`
#ASSERT `the Oversight Committee may refuse` `a qualified 20-year-old`
#ASSERT `the Oversight Committee may refuse` `a qualified applicant of poor character`
#ASSERT `the Oversight Committee may refuse` `an unqualified applicant`

