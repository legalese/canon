@ref Dieu 79-83 (src:1497-1664)
`a joint stock company with a supervisory board of three` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS TRUE
    `number of controllers on the supervisory board` IS 3
    `number of board members` IS 0
    `number of independent board members` IS 0
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with a supervisory board of five` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS TRUE
    `number of controllers on the supervisory board` IS 5
    `number of board members` IS 0
    `number of independent board members` IS 0
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with a supervisory board of two` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS TRUE
    `number of controllers on the supervisory board` IS 2
    `number of board members` IS 0
    `number of independent board members` IS 0
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with a supervisory board of six` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS TRUE
    `number of controllers on the supervisory board` IS 6
    `number of board members` IS 0
    `number of independent board members` IS 0
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with an audit committee and one independent of five` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS FALSE
    `number of controllers on the supervisory board` IS 0
    `number of board members` IS 5
    `number of independent board members` IS 1
    `has an audit committee under the board` IS TRUE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with an audit committee and one independent of four` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS FALSE
    `number of controllers on the supervisory board` IS 0
    `number of board members` IS 4
    `number of independent board members` IS 1
    `has an audit committee under the board` IS TRUE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with an audit committee and one independent of six` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS FALSE
    `number of controllers on the supervisory board` IS 0
    `number of board members` IS 6
    `number of independent board members` IS 1
    `has an audit committee under the board` IS TRUE
    `has a members' council and a chief executive` IS FALSE
`a joint stock company with an independent board member but no committee` MEANS `A governance structure` WITH
    `is a joint stock company` IS TRUE
    `has a general meeting of shareholders, a board and a chief executive` IS TRUE
    `has a supervisory board` IS FALSE
    `number of controllers on the supervisory board` IS 0
    `number of board members` IS 5
    `number of independent board members` IS 2
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS FALSE
`a limited liability company with a council and a chief executive` MEANS `A governance structure` WITH
    `is a joint stock company` IS FALSE
    `has a general meeting of shareholders, a board and a chief executive` IS FALSE
    `has a supervisory board` IS FALSE
    `number of controllers on the supervisory board` IS 0
    `number of board members` IS 0
    `number of independent board members` IS 0
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS TRUE
`a limited liability company without a council` MEANS `A governance structure` WITH
    `is a joint stock company` IS FALSE
    `has a general meeting of shareholders, a board and a chief executive` IS FALSE
    `has a supervisory board` IS FALSE
    `number of controllers on the supervisory board` IS 0
    `number of board members` IS 0
    `number of independent board members` IS 0
    `has an audit committee under the board` IS FALSE
    `has a members' council and a chief executive` IS FALSE
#ASSERT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with a supervisory board of three`
#ASSERT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with a supervisory board of five`
#ASSERT NOT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with a supervisory board of two`
#ASSERT NOT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with a supervisory board of six`
#ASSERT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with an audit committee and one independent of five`
#ASSERT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with an audit committee and one independent of four`
#ASSERT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with an audit committee and one independent of six` EQUALS FALSE
#ASSERT NOT `Dieu 79: the governance structure is one the Law allows` `a joint stock company with an independent board member but no committee`
#ASSERT `Dieu 79: the governance structure is one the Law allows` `a limited liability company with a council and a chief executive`
#ASSERT NOT `Dieu 79: the governance structure is one the Law allows` `a limited liability company without a council`
`a chief executive who left on 1 March` MEANS `A vacancy` WITH
    `date the chief executive or actuary left office` IS YMD 2025 3 1
    `date the Ministry of Finance suspended the officer` IS YMD 2025 3 1
    `date the insurer filed a valid dossier for a replacement` IS YMD 2025 5 15
`a chief executive who left on 1 March, replacement late` MEANS `A vacancy` WITH
    `date the chief executive or actuary left office` IS YMD 2025 3 1
    `date the Ministry of Finance suspended the officer` IS YMD 2000 1 1
    `date the insurer filed a valid dossier for a replacement` IS YMD 2025 5 16
#ASSERT `Dieu 80(4): the last day to file a valid dossier for a new chief executive or actuary` `a chief executive who left on 1 March` EQUALS YMD 2025 5 15
#ASSERT `Dieu 80(4): the dossier was filed in time` `a chief executive who left on 1 March`
#ASSERT NOT `Dieu 80(4): the dossier was filed in time` `a chief executive who left on 1 March, replacement late`
#ASSERT `Dieu 83(2): the last day to file a valid dossier for a replacement after a suspension` `a chief executive who left on 1 March` EQUALS YMD 2025 5 15
#ASSERT REFUSED `Dieu 83(4): the Government's rules on suspending officers`

