@lang en
IMPORT `tasco-p0-definitions`

-- The shared fixtures of the tests: full literals, generated by gen.py from the record
-- declarations in tasco-nouns.l4. No assertions here. Each test module builds its variants
-- of these, also generated, beside its own assertions.

§ `Shared fixtures`

`May 2021` MEANS `A calendar month` WITH
    `year`  IS 2_021
    `month` IS 5

`June 2021` MEANS `A calendar month` WITH
    `year`  IS 2_021
    `month` IS 6

`a private car registered in May 2021` MEANS `A vehicle` WITH
    `kind of vehicle`                        IS `a car`
    `propulsion`                             IS `an internal combustion engine only`
    `what it carries`                        IS `people only`
    `used for business`                      IS FALSE
    `number of seats`                        IS 5
    `month of first registration in Vietnam` IS `May 2021`
    `imported having been used abroad`       IS FALSE
    `year of manufacture`                    IS 2_021

`a contract for a year from 1 June 2024, paid on signing` MEANS `The contract` WITH
    `date the contract was concluded`                    IS YMD 2024 6 1
    `start of the insurance period`                      IS YMD 2024 6 1
    `end of the insurance period`                        IS YMD 2025 5 31
    `premium`                                            IS 10_000_000
    `agreed date for paying the premium`                 IS NOTHING
    `date the premium was paid in full`                  IS JUST (YMD 2024 6 1)
    `a written agreement lets the buyer owe the premium` IS FALSE
    `vehicle`                                            IS `a private car registered in May 2021`

`cover of 500 million at full value` MEANS `The physical damage cover` WITH
    `sum insured`                                  IS 500_000_000
    `market value when the contract was concluded` IS 500_000_000
    `deductible stated on the certificate`         IS NOTHING
    `additional clauses held`                      IS EMPTY
    `insurance period in months`                   IS 12

`a sober licensed driver` MEANS `The driver at the time of the loss` WITH
    `of an age the road traffic law permits`              IS TRUE
    `driving licence`                                     IS `a valid licence in force, appropriate to the vehicle`
    `alcohol above the Ministry of Health's normal level` IS FALSE
    `using prohibited drugs or stimulants`                IS FALSE

`lawful driving` MEANS `The way the vehicle was driven` WITH
    `entered a prohibited road or area`                                   IS FALSE
    `drove against the direction of traffic`                              IS FALSE
    `reversed on an expressway`                                           IS FALSE
    `turned or made a U-turn where prohibited`                            IS FALSE
    `stopped or parked where a sign prohibits it`                         IS FALSE
    `ran a red light or disobeyed a traffic controller`                   IS FALSE
    `drove at night without the required lights`                          IS FALSE
    `entered a bus or tram lane, or a road barred to its class by a sign` IS FALSE

`a load within the limits` MEANS `The load at the time of the loss` WITH
    `permitted load`                                          IS 1_000
    `load carried, towed or lifted`                           IS 800
    `permitted number of people`                              IS 5
    `number of people carried, not counting children under 7` IS 4

`no speed finding` MEANS `The speed at the time of the loss` WITH
    `speed limit`                            IS 60
    `speed found by the competent authority` IS NOTHING
    `the finding is in writing`              IS FALSE

`ordinary circumstances on the road` MEANS `The circumstances of the loss` WITH
    `intentional damage by an excluded person`               IS FALSE
    `in road traffic`                                        IS TRUE
    `inspection certificate`                                 IS `valid and in force`
    `driver`                                                 IS `a sober licensed driver`
    `special equipment operated without the required permit` IS FALSE
    `way the vehicle was driven`                             IS `lawful driving`
    `racing, lawful or not`                                  IS FALSE
    `towing another vehicle unlawfully`                      IS FALSE
    `carrying goods unlawfully`                              IS FALSE
    `carrying explosives or flammable substances`            IS FALSE
    `outside Vietnam`                                        IS FALSE
    `war or terrorism`                                       IS FALSE
    `vandalism in a protest, riot or public disorder`        IS FALSE
    `bombs, mines or explosive devices`                      IS FALSE
    `load`                                                   IS `a load within the limits`
    `speed`                                                  IS `no speed finding`

`prompt and honest conduct` MEANS `The conduct after the loss` WITH
    `Tasco notified immediately`                                                     IS TRUE
    `day written notice was sent, counted from the day of the loss`                  IS JUST 1
    `police or local authority notified immediately`                                 IS TRUE
    `prevented by force majeure`                                                     IS FALSE
    `Tasco assessed the damage within that period`                                   IS FALSE
    `full rescue, mitigation and scene-preservation measures taken`                  IS TRUE
    `moved only for safety or on an authority's order`                               IS FALSE
    `moved, dismantled or repaired without Tasco's consent`                          IS FALSE
    `that was necessary for safety or ordered by an authority`                       IS FALSE
    `Tasco's opinion on dismantling was overdue`                                     IS FALSE
    `a third party is liable for the loss`                                           IS FALSE
    `right of claim preserved and transferred to Tasco with the file`                IS TRUE
    `cooperated with Tasco in recovering from the third party`                       IS TRUE
    `settled with the third party without Tasco's consent`                           IS FALSE
    `claim documents truthful`                                                       IS TRUE
    `cooperated in verifying the claim documents`                                    IS TRUE
    `proposal misstated the use of the vehicle, so too little premium was collected` IS FALSE
    `an increase in risk was not notified, so too little premium was collected`      IS FALSE
    `premium actually paid`                                                          IS 10_000_000
    `premium that should have been paid`                                             IS 10_000_000
    `the rate Tasco chose under 13.1.2`                                              IS NOTHING
    `the rate Tasco chose under 13.1.3`                                              IS NOTHING

`no specific exclusion facts` MEANS `The facts for the physical damage exclusions` WITH
    `wear and tear, inherent vice, loss of commercial value, defect, or damage from repair`       IS FALSE
    `water hammer in the combustion engine from operating in flood water`                         IS FALSE
    `electric motor of an electric car damaged by operating in flood water`                       IS FALSE
    `only tyres, tarpaulins or badges damaged, nothing else by the same cause in the accident`    IS FALSE
    `whole vehicle lost by fraud or abuse of trust`                                               IS FALSE
    `electrical damage by overload, overpressure, short circuit, self-heating, arcing or leakage` IS FALSE
    `loss of equipment fitted beyond the manufacturer's, not protective and not permitted`        IS FALSE
    `loss caused by such added equipment`                                                         IS FALSE
    `loss caused by the operation of the vehicle's own special equipment`                         IS FALSE
    `damage by the goods carried, not from a collision or overturning`                            IS FALSE

`a new bumper costing 20 million` MEANS `A damaged part` WITH
    `kind of part`                                   IS `a material or spare part`
    `replaced with a new part`                       IS TRUE
    `cost`                                           IS 20_000_000
    `months since last replaced new, with documents` IS NOTHING

`a door repaired for 5 million` MEANS `A damaged part` WITH
    `kind of part`                                   IS `a material or spare part`
    `replaced with a new part`                       IS FALSE
    `cost`                                           IS 5_000_000
    `months since last replaced new, with documents` IS NOTHING

`bumper and door damage` MEANS `The damage to the vehicle` WITH
    `damaged parts`                                                   IS LIST `a new bumper costing 20 million`, `a door repaired for 5 million`
    `share of the painted surface damaged`                            IS 10%
    `cost of repainting the whole vehicle`                            IS 30_000_000
    `market value at the time and place of the loss`                  IS 480_000_000
    `costs of preventing further loss`                                IS 1_000_000
    `costs of rescue and transport to the nearest repairer`           IS 3_000_000
    `owner asks to keep the wrecked vehicle`                          IS FALSE
    `Tasco's valuation of the wreck`                                  IS 0
    `police concluded by suspending the investigation or prosecution` IS FALSE

`a collision on 1 September 2024` MEANS `A loss to the vehicle` WITH
    `date of the loss`                                                        IS YMD 2024 9 1
    `cause of the damage`                                                     IS `collision, overturning, sinking, falling, or impact by an external object`
    `sudden and unforeseen`                                                   IS TRUE
    `done by the owner, the driver, the assistant or a person on the vehicle` IS FALSE
    `circumstances`                                                           IS `ordinary circumstances on the road`
    `exclusion facts`                                                         IS `no specific exclusion facts`
    `damage`                                                                  IS `bumper and door damage`
    `conduct after the loss`                                                  IS `prompt and honest conduct`

`no additional-clause facts` MEANS `The facts for the additional clauses` WITH
    `the vehicle was in operation in the flood water`                                         IS FALSE
    `the stolen parts are keys or a remote control`                                           IS FALSE
    `parts thefts already paid under this contract`                                           IS 0
    `the loss occurred in a country named on the certificate`                                 IS FALSE
    `the vehicle holds a valid circulation permit in that country`                            IS FALSE
    `temporarily imported for re-export, duty-free, or of a foreign mission`                  IS FALSE
    `insured value before taxes`                                                              IS 0
    `the vehicle is repaired in Vietnam`                                                      IS TRUE
    `in transit from factory or customs to delivery, or awaiting registration`                IS FALSE
    `holds the factory quality slip, or the import quality certificate and customs clearance` IS FALSE
    `days of temporary cover`                                                                 IS 0
    `a longer temporary cover agreed in writing`                                              IS FALSE
    `loss from the maker's or assembler's technical fault`                                    IS FALSE
    `operates only off public roads`                                                          IS FALSE
    `the site where the loss occurred`                                                        IS `a public road`
    `a lawful training vehicle with a certified instructor`                                   IS FALSE
    `an instructor was present at the accident`                                               IS TRUE
    `the auxiliary brake was fitted`                                                          IS TRUE
    `the added equipment was declared item by item with its sum insured`                      IS FALSE
    `the added equipment is lawful and changes no technical or safety feature`                IS FALSE
    `the sum insured for the lost item of added equipment`                                    IS 0
    `the cost of replacing the lost item of added equipment`                                  IS 0
    `the special vehicle is technically safe as the law requires`                             IS TRUE
    `the operator intentionally broke the operating rules`                                    IS FALSE
    `the battery is genuine`                                                                  IS TRUE
    `battery damage from a technical fault, wear or charging capacity`                        IS FALSE
