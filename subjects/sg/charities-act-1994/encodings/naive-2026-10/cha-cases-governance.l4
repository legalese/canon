IMPORT prelude
IMPORT `cha-governance`

-- Charities Act 1994, ss 7, 13, 19, 20, 28 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_cha.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a treasurer convicted of cheating` MEANS Person WITH
    `convicted of a dishonesty or terrorism offence` IS TRUE
    `conviction spent` IS FALSE
    `undischarged bankrupt` IS FALSE
    `undischarged composition with creditors` IS FALSE
    `disqualified under the Companies Act` IS FALSE
    `charity is a company and Companies Act permission held` IS FALSE

`a treasurer whose cheating conviction is spent` MEANS Person WITH
    `convicted of a dishonesty or terrorism offence` IS TRUE
    `conviction spent` IS TRUE
    `undischarged bankrupt` IS FALSE
    `undischarged composition with creditors` IS FALSE
    `disqualified under the Companies Act` IS FALSE
    `charity is a company and Companies Act permission held` IS FALSE

`an undischarged bankrupt` MEANS Person WITH
    `convicted of a dishonesty or terrorism offence` IS FALSE
    `conviction spent` IS FALSE
    `undischarged bankrupt` IS TRUE
    `undischarged composition with creditors` IS FALSE
    `disqualified under the Companies Act` IS FALSE
    `charity is a company and Companies Act permission held` IS FALSE

`a bankrupt with Companies Act permission for a company charity` MEANS Person WITH
    `convicted of a dishonesty or terrorism offence` IS FALSE
    `conviction spent` IS FALSE
    `undischarged bankrupt` IS TRUE
    `undischarged composition with creditors` IS FALSE
    `disqualified under the Companies Act` IS FALSE
    `charity is a company and Companies Act permission held` IS TRUE

`a person in an undischarged composition` MEANS Person WITH
    `convicted of a dishonesty or terrorism offence` IS FALSE
    `conviction spent` IS FALSE
    `undischarged bankrupt` IS FALSE
    `undischarged composition with creditors` IS TRUE
    `disqualified under the Companies Act` IS FALSE
    `charity is a company and Companies Act permission held` IS FALSE

`a person with a clean record` MEANS Person WITH
    `convicted of a dishonesty or terrorism offence` IS FALSE
    `conviction spent` IS FALSE
    `undischarged bankrupt` IS FALSE
    `undischarged composition with creditors` IS FALSE
    `disqualified under the Companies Act` IS FALSE
    `charity is a company and Companies Act permission held` IS FALSE

§ `s 7`

#ASSERT `the board is in default of registration` FALSE FALSE 4
#ASSERT NOT `the board is in default of registration` FALSE FALSE 2
#ASSERT NOT `the board is in default of registration` TRUE FALSE 12
#ASSERT NOT `the board is in default of registration` FALSE TRUE 12

#ASSERT `the board is in default of notification` 8 FALSE
#ASSERT NOT `the board is in default of notification` 7 FALSE
#ASSERT NOT `the board is in default of notification` 30 TRUE

§ `s 13`

#ASSERT `the Commissioner may appoint an auditor for non-compliance` 11 FALSE
#ASSERT NOT `the Commissioner may appoint an auditor for non-compliance` 10 FALSE
#ASSERT NOT `the Commissioner may appoint an auditor for non-compliance` 11 TRUE

#ASSERT `who pays for the Commissioner's auditor` TRUE EQUALS "the board members personally, jointly and severally"
#ASSERT `who pays for the Commissioner's auditor` FALSE EQUALS "the charity's funds"

§ `ss 19, 20`

#ASSERT `the gift may be applied cy-pres` `the purpose has been fulfilled`
#ASSERT `the gift may be applied cy-pres` `the purpose is impossible`
#ASSERT `the gift may be applied cy-pres` `the purpose uses only part of the gift`
#ASSERT `the gift may be applied cy-pres` `the area named has ceased to be suitable`
#ASSERT `the gift may be applied cy-pres` `the purpose is now provided by the government`
#ASSERT NOT `the gift may be applied cy-pres` `the board prefers a different cause`

#ASSERT `the donors are conclusively presumed unidentifiable` `a collecting box`
#ASSERT `the donors are conclusively presumed unidentifiable` `a charity lottery`
#ASSERT NOT `the donors are conclusively presumed unidentifiable` `a named donor's cheque`

§ `s 28`

#ASSERT `the person is disqualified` `a treasurer convicted of cheating`
#ASSERT NOT `the person is disqualified` `a treasurer whose cheating conviction is spent`
#ASSERT `the person is disqualified` `an undischarged bankrupt`
#ASSERT NOT `the person is disqualified` `a bankrupt with Companies Act permission for a company charity`
#ASSERT `the person is disqualified` `a person in an undischarged composition`
#ASSERT NOT `the person is disqualified` `a person with a clean record`

