  <decision id="decision_the_voluntary_compliance_agreement_satisfies_section_8_2" name="the_voluntary_compliance_agreement_satisfies_section_8_2" label="the voluntary compliance agreement satisfies section 8(2)">
    <variable id="decision_the_voluntary_compliance_agreement_satisfies_section_8_2_var" name="the_voluntary_compliance_agreement_satisfies_section_8_2" label="the voluntary compliance agreement satisfies section 8(2)" typeRef="boolean"/>
