§ `s 2 -- donate and food donor`

#ASSERT `the giving is a donation` `a bakery giving chilled cakes to a food bank, with both warnings`
#ASSERT `the giving is a donation` `a food bank passing the cakes on to a family, with both warnings`
#ASSERT NOT `the giving is a donation` `a supermarket selling near-expiry food at a discount`
#ASSERT NOT `the giving is a donation` `a company giving food hampers to a client as a gift`

#ASSERT `the giver is a food donor` `a bakery giving chilled cakes to a food bank, with both warnings`
#ASSERT `the giver is a food donor` `a food bank passing the cakes on to a family, with both warnings`
#ASSERT `the giver is a food donor` `a home cook giving meals to a soup kitchen, with both warnings`
#ASSERT `the giver is a food donor` `a registered charity's cafe donating surplus food`
#ASSERT NOT `the giver is a food donor` `a supermarket selling near-expiry food at a discount`
#ASSERT NOT `the giver is a food donor` `a company giving food hampers to a client as a gift`
#ASSERT NOT `the giver is a food donor` `a charity giving away second-hand clothes`

#ASSERT `the giver is within limb (a)` `a bakery giving chilled cakes to a food bank, with both warnings`
#ASSERT NOT `the giver is within limb (a)` `a food bank passing the cakes on to a family, with both warnings`
#ASSERT NOT `the giver is within limb (a)` `a home cook giving meals to a soup kitchen, with both warnings`

§ `s 5(2) -- gifts the Act does not reach`

#ASSERT `the Act applies to the gift` `a home cook giving meals to a soup kitchen, with both warnings`
#ASSERT NOT `the Act applies to the gift` `a neighbour sharing food with a friend`
#ASSERT NOT `the Act applies to the gift` `a household giving meals with lodging to a live-in worker for work`

§ `s 4(1)(b), (c) -- warnings to the recipient`

#ASSERT `the handling condition is met` `a bakery giving chilled cakes to a food bank, with both warnings`
#ASSERT NOT `the handling condition is met` `a caterer who told no one the food must be refrigerated`
#ASSERT NOT `the handling condition is met` `a caterer who warned only the eventual eaters, not the charity`
#ASSERT `the handling condition is met` `a donor of dry biscuits needing no warnings`

#ASSERT `the time limit condition is met` `a bakery giving chilled cakes to a food bank, with both warnings`
#ASSERT NOT `the time limit condition is met` `a hotel that did not say the buffet food lasts only four hours`
#ASSERT `the time limit condition is met` `a donor of dry biscuits needing no warnings`

