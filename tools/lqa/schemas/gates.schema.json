{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/gates.schema.json",
  "title": "Human gates (3H, 6H, 12H)",
  "description": "Approvals of the human steps. Each is given in the conversation (the human types their full name), recorded by `node tools/lqa/check.js <subject> --sign <step> --by \"<name>\"`, and binds to a digest of what it covers; edit any of it and the step re-opens.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "entries"
  ],
  "properties": {
    "kind": {
      "const": "gates"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "decision",
          "by",
          "date",
          "digest"
        ],
        "properties": {
          "step": {
            "enum": [
              "3H",
              "6H",
              "12H"
            ]
          },
          "decision": {
            "enum": [
              "confirmed",
              "certified",
              "waived",
              "released"
            ]
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "statement": {
            "description": "3H: what the reference set is",
            "type": "string"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "what",
                "why"
              ],
              "properties": {
                "what": {
                  "type": "string",
                  "minLength": 1
                },
                "why": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reason": {
            "description": "required for a waiver",
            "type": "string"
          },
          "recipient": {
            "description": "required for a release",
            "type": "string"
          },
          "how": {
            "type": "string",
            "description": "how the approval was given, e.g. \"full name typed in the conversation\""
          }
        }
      }
    }
  }
}
