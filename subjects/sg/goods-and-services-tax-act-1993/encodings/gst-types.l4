IMPORT prelude
IMPORT daydate

-- Goods and Services Tax Act 1993 (Singapore) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../source/GSTA1993.txt (SSO informal consolidation, version in
-- force from 11 September 2026, deposited in this repository).

§ `Goods and Services Tax Act 1993 — the nouns`

§§ `A supply (Part 3)`

DECLARE `Supply kind` IS ONE OF
    `goods`
    `services`

-- s 13(2)-(3): where goods go.
DECLARE `Goods movement` IS ONE OF
    `not removed from or to Singapore, and in Singapore`
    `not removed from or to Singapore, and outside Singapore`
    `removed from Singapore`
    `removed to Singapore`

-- s 15(3): the supplier's establishments.
DECLARE Establishment IS ONE OF
    `a business or fixed establishment only in Singapore`
    `a business or fixed establishment only abroad`
    `no establishment; usual residence in Singapore`
    `no establishment; usual residence abroad`
    `establishments in Singapore and abroad; the one most concerned is in Singapore`
    `establishments in Singapore and abroad; the one most concerned is abroad`

-- The Fourth Schedule, Part 1: exempt supplies.
DECLARE `Exempt category` IS ONE OF
    `a financial service in para 1`
    `investment precious metal (para 1A)`
    `digital payment tokens exchanged or lent (para 1B)`
    `residential land or property (para 2)`
    `none`

-- s 21(3), (6), (6A), 21A-21C: zero-rating.
DECLARE `Zero-rating ground` IS ONE OF
    `goods exported`
    `international services under s 21(3)`
    `ship or aircraft stores, installation or merchandise (s 21(6), (6A))`
    `prescribed tools or machinery for an overseas person (s 21A)`
    `an approved marine supply (s 21B)`
    `a lease of land in an approved warehouse (s 21C)`
    `none`

-- s 11(2)-(4), 11A(6), 11B(3).
DECLARE `Time-of-supply rule` IS ONE OF
    `general (s 11(2))`
    `land, or by election, or agent's supply (s 11(3)-(4))`
    `sale or return goods (s 11A(6))`
    `between connected persons (s 11B(3))`

DECLARE Supply HAS
    `kind`                                              IS A `Supply kind`
    `goods movement`                                    IS A `Goods movement`
    `supplier`                                          IS AN Establishment
    `by a taxable person`                               IS A BOOLEAN   -- s 8(2)
    `in the course or furtherance of business`          IS A BOOLEAN   -- s 8(1)
    `for a consideration, or deemed a supply by the Second Schedule` IS A BOOLEAN -- s 10(2)(a); Second Schedule paras 5-7
    `consideration in money`                            IS A NUMBER    -- tax-inclusive, s 17(2)
    `exempt category`                                   IS AN `Exempt category`
    `zero-rating ground`                                IS A `Zero-rating ground`
    `time rule`                                         IS A `Time-of-supply rule`
    `invoice issued on`                                 IS A MAYBE DATE
    `consideration received on`                         IS A MAYBE DATE
    `goods removed, made available, or services performed on` IS A MAYBE DATE
    `a Seventh Schedule supply`                         IS A BOOLEAN   -- s 8(1A)
    `customer accounts for the tax (s 38, 38A)`         IS A BOOLEAN

-- Third Schedule special values, and Second Schedule business-asset rules.
DECLARE `Special value` IS ONE OF
    `none`
    `a used motor vehicle (Third Schedule para 14)`
    `employee catering or hotel accommodation, no money paid (para 10)`
    `a business gift costing not more than $200 (Second Schedule para 5(2)(a))`
    `an industrial or commercial sample given to a customer (para 5(2)(b))`

DECLARE `Tax treatment` IS ONE OF
    `standard-rated`
    `zero-rated`
    `exempt`
    `outside the scope of the tax`

§§ `Registration (First Schedule)`

DECLARE `Registration facts` HAS
    `belongs in Singapore`                              IS A BOOLEAN
    `taxable supplies in the last calendar year`        IS A NUMBER
    `taxable supplies expected in the next 12 months`   IS A NUMBER
    `Comptroller satisfied next year will not exceed $1 million` IS A BOOLEAN -- para 1(3)
    `global supplies in the last calendar year`         IS A NUMBER    -- para 1A
    `Seventh Schedule supplies in the last calendar year` IS A NUMBER
    `global supplies expected in the next 12 months`    IS A NUMBER
    `Seventh Schedule supplies expected in the next 12 months` IS A NUMBER
    `reverse charge services received last calendar year` IS A NUMBER -- para 1B
    `reverse charge services expected in the next 12 months` IS A NUMBER
    `entitled to full input tax credit`                 IS A BOOLEAN

§§ `Input tax (Part 4)`

DECLARE `Input tax facts` HAS
    `for the purpose of the business`                   IS A BOOLEAN   -- s 19(3)
    `share used for business purposes, per cent`        IS A NUMBER    -- s 19(4)
    `attributable to supplies within s 20(2)`           IS A BOOLEAN
    `part of an arrangement causing loss of revenue`    IS A BOOLEAN   -- s 20(2A)
    `knew it`                                           IS A BOOLEAN
    `circumstances carried a reasonable risk`           IS A BOOLEAN   -- s 20(2D)(a)
    `took reasonable steps and reasonably concluded it was not` IS A BOOLEAN -- s 20(2F)

-- s 14(1): the recipient of a supply from abroad.
DECLARE `Reverse charge facts` HAS
    `the supply is of services by an overseas supplier, or between branches` IS A BOOLEAN
    `the supply is of distantly taxable goods`          IS A BOOLEAN
    `recipient belongs in Singapore`                    IS A BOOLEAN
    `recipient registered or liable to be registered`   IS A BOOLEAN
    `received as an individual privately`               IS A BOOLEAN
    `recipient entitled to full input tax credit`       IS A BOOLEAN
    `excluded by the Eighth Schedule`                   IS A BOOLEAN
    `recipient elected under s 14(5) or (6)`            IS A BOOLEAN

-- s 2(1) "distantly taxable goods", s 2(1A).
DECLARE `Low-value goods facts` HAS
    `dutiable, duty not waived`                         IS A BOOLEAN
    `an exempt supply`                                  IS A BOOLEAN
    `outside the customs territory at the point of sale` IS A BOOLEAN
    `entry value of the item`                           IS A NUMBER
    `delivered by post or after import by air`          IS A BOOLEAN

§§ `A change in the tax rate (Part 6A)`

DECLARE `Spanning supply` HAS
    `value of the supply`                               IS A NUMBER
    `value performed before the change`                 IS A NUMBER
    `consideration received before the change`          IS A NUMBER
    `invoice issued before the change`                  IS A BOOLEAN
    `old rate`                                          IS A NUMBER
    `new rate`                                          IS A NUMBER

§§ `Penalties (Parts 7, 9, 11)`

DECLARE `GST offence` IS ONE OF
    `s 44(4) receipts`
    `s 46(6) records, first conviction`
    `s 46(6) records, second or later conviction`
    `s 58 an offence with no penalty provided`
    `s 59(1) an incorrect return`
    `s 59(2) an incorrect return without reasonable excuse or through negligence`
    `s 61 failing to register or notify`
    `s 62 wilful evasion`
    `s 62A misrepresenting status to an overseas supplier`
    `s 62B wilfully misrepresenting status`
    `s 62C(1) participating in a fraudulent arrangement`
    `s 62C(4) a business used for a fraudulent arrangement`
    `s 63 improperly obtaining a refund`
    `s 64 dealing in goods or services where tax is evaded`
    `s 64A(1) collecting tax without authority`
    `s 64A(2) collecting tax without authority, negligently`
    `s 64A(4) a registered person over-collecting, negligently`
    `s 65 an officer's or impersonator's misconduct`
    `s 66 obstructing the Comptroller`
    `s 81(4) failing to give security`
    `s 83I(4) refusing to answer on examination`
    `s 83I(9) false information on examination`
    `s 84(2D) not complying with a notice`
    `s 84(2E) false information to the Comptroller`
    `s 86(1) contravening orders or regulations`

DECLARE `GST penalty` HAS
    `penalty as a multiple of the tax`                  IS A NUMBER
    `fine`                                              IS A NUMBER
    `imprisonment in months`                            IS A NUMBER
    `fine and imprisonment both`                        IS A BOOLEAN
    `fine per day continuing`                           IS A NUMBER

DECLARE `Service mode` IS ONE OF
    `personal delivery or leaving at the address`
    `ordinary or registered post`
    `the electronic service`

§§ `The supply case`

DECLARE `Supply case` HAS
    `supply`                                            IS A Supply
    `special value`                                     IS A `Special value`
    `reverse charge`                                    IS A MAYBE `Reverse charge facts`
