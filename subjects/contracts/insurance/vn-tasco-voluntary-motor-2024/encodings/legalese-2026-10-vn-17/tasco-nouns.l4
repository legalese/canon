-- "Bên mua bảo hiểm/ Chủ xe" (the policyholder or the owner) is the usual subject of a duty in
-- the text; the two roles are kept apart here because the definitions keep them apart.
DECLARE `A party` IS ONE OF
    `Tasco Insurance`          -- Article 1.1
    `the policyholder`         -- Article 1.2
    `the insured person`       -- Article 1.3
    `the beneficiary`          -- Article 1.4
    `the vehicle owner`        -- Article 1.5
    `the driver`               -- Article 1.6
    `the competent authority`  -- "cơ quan chức năng có thẩm quyền" (Article 4.2.5)

-- The acts the regulative rules (tasco-ch1-general.l4) are about.
DECLARE `An act under the rules` IS ONE OF
    `pay the claim`                                  -- Article 4.2.4
    `explain the refusal in writing`                 -- Article 4.2.6
    `send a written notice of the loss`              -- Article 5.2.7(c)
    `notify Tasco of the change in risk`             -- Article 5.2.5
    `refund or call the premium difference`          -- Article 3.1
    `file a claim`                                   -- Article 9.1
    `complain about the settlement decision`         -- Article 9.2
    `bring a suit on the contract`                   -- Article 9.3
    `verify the claim file itself`                   -- Article 4.2.5

§§ `The vehicle (Article 1.7 to 1.11)`

