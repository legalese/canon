-- Banishment Act in its later version: not item 2A
#ASSERT NOT `the offence is under a law specified in the Second Schedule` (`wlo` "Banishment Act 1959" "3" FALSE)
-- Road Traffic Act 1961 not listed
#ASSERT NOT `the offence is under a law specified in the Second Schedule` (`wlo` "Road Traffic Act 1961" "3" TRUE)
-- Evidence Act not listed
#ASSERT NOT `the offence is under a law specified in the Second Schedule` (`wlo` "Evidence Act 1893" "3" TRUE)
-- Companies Act not listed
