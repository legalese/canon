IMPORT prelude
IMPORT `psa-licensing`

-- Payment Services Act 2019, ss 5, 6, 13 and First Schedule Part 2 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_psa.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a small money-changer` MEANS Business WITH
    `money-changing` IS TRUE
    `other payment services` IS 0
    `highest monthly average for one service` IS 0
    `monthly average across all services` IS 0
    `daily average e-money float` IS 0

`a small remittance shop` MEANS Business WITH
    `money-changing` IS FALSE
    `other payment services` IS 1
    `highest monthly average for one service` IS 800000
    `monthly average across all services` IS 800000
    `daily average e-money float` IS 0

`a remittance shop that also changes money` MEANS Business WITH
    `money-changing` IS TRUE
    `other payment services` IS 1
    `highest monthly average for one service` IS 800000
    `monthly average across all services` IS 900000
    `daily average e-money float` IS 0

`a remitter averaging 3.5 million a month` MEANS Business WITH
    `money-changing` IS FALSE
    `other payment services` IS 1
    `highest monthly average for one service` IS 3500000
    `monthly average across all services` IS 3500000
    `daily average e-money float` IS 0

`a two-service firm at 2.5 and 2.5 million` MEANS Business WITH
    `money-changing` IS FALSE
    `other payment services` IS 2
    `highest monthly average for one service` IS 2500000
    `monthly average across all services` IS 5000000
    `daily average e-money float` IS 0

`a two-service firm at 2.9 and 3.2 million` MEANS Business WITH
    `money-changing` IS FALSE
    `other payment services` IS 2
    `highest monthly average for one service` IS 3200000
    `monthly average across all services` IS 6100000
    `daily average e-money float` IS 0

`a wallet with a 6 million float` MEANS Business WITH
    `money-changing` IS FALSE
    `other payment services` IS 1
    `highest monthly average for one service` IS 100000
    `monthly average across all services` IS 100000
    `daily average e-money float` IS 6000000

`a firm doing nothing regulated` MEANS Business WITH
    `money-changing` IS FALSE
    `other payment services` IS 0
    `highest monthly average for one service` IS 0
    `monthly average across all services` IS 0
    `daily average e-money float` IS 0

§ `s 5`

#ASSERT `the person carries on a payment service business` FALSE TRUE
#ASSERT `the person carries on a payment service business` TRUE FALSE
#ASSERT NOT `the person carries on a payment service business` FALSE FALSE

#ASSERT `the maximum fine for unlicensed business` TRUE EQUALS 125000
#ASSERT `the maximum fine for unlicensed business` FALSE EQUALS 250000

§ `First Schedule Part 2, s 13`

#ASSERT `the activity needs a licence` `remitting money abroad for customers for a fee`
#ASSERT `the activity needs a licence` `running a money-changing counter`
#ASSERT `the activity needs a licence` `operating a crypto exchange`
#ASSERT NOT `the activity needs a licence` `issuing a mall gift card usable only at the mall`
#ASSERT NOT `the activity needs a licence` `a payment gateway that never holds the money`
#ASSERT NOT `the activity needs a licence` `a sales agent collecting payment for the seller`
#ASSERT NOT `the activity needs a licence` `intra-group payments within a corporate group`
#ASSERT NOT `the activity needs a licence` `a charity carrying cash donations free of charge`
#ASSERT NOT `the activity needs a licence` `a bank offering remittances`
#ASSERT NOT `the activity needs a licence` `a secure cash-in-transit company`

§ `s 6`

#ASSERT `the licence needed` `a small money-changer` EQUALS "money-changing licence"
#ASSERT `the licence needed` `a small remittance shop` EQUALS "standard payment institution licence"
#ASSERT `the licence needed` `a remittance shop that also changes money` EQUALS "standard payment institution licence"
#ASSERT `the licence needed` `a remitter averaging 3.5 million a month` EQUALS "major payment institution licence"
#ASSERT `the licence needed` `a two-service firm at 2.5 and 2.5 million` EQUALS "standard payment institution licence"
#ASSERT `the licence needed` `a two-service firm at 2.9 and 3.2 million` EQUALS "major payment institution licence"
#ASSERT `the licence needed` `a wallet with a 6 million float` EQUALS "major payment institution licence"
#ASSERT `the licence needed` `a firm doing nothing regulated` EQUALS "none"

