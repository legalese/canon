IMPORT prelude
IMPORT daydate
IMPORT `ia-types`
IMPORT `ia-penalties`
IMPORT `ia-permission`
IMPORT `ia-supervision`
IMPORT `ia-policies`
IMPORT `ia-goal`

-- Insurance Act 1966 — INDEPENDENT TESTS.
--
-- Expected values were fixed in `independent-expectations.md` from the source
-- text alone, before the encoding modules were read. Each assertion carries
-- its expectation number (E###). A failing assertion is a finding: the
-- expected values are never changed to match the encoding.

§ `Independent tests`

§§ `Helpers`

GIVEN life IS A BOOLEAN
      general IS A BOOLEAN
      reins IS A BOOLEAN
      scheme IS A BOOLEAN
      broker IS A BOOLEAN
      exempt IS A BOOLEAN
      individual IS A BOOLEAN
GIVETH A Standing
`who` life general reins scheme broker exempt individual MEANS Standing WITH
    `licensed for life business` IS life
    `licensed for general business` IS general
    `an authorised reinsurer` IS reins
    `a foreign insurer under a foreign insurer scheme` IS scheme
    `a registered insurance broker of the type` IS broker
    `an exempt insurance broker under s 92(1)(a)-(f), notified` IS exempt
    `exempted by the Authority from the provision` IS FALSE
    `an individual` IS individual

`an unlicensed company` MEANS `who` FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`an unlicensed individual` MEANS `who` FALSE FALSE FALSE FALSE FALSE FALSE TRUE
`a life-only insurer` MEANS `who` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
`a general-only insurer` MEANS `who` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
`an authorised reinsurer co` MEANS `who` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
`a registered broker co` MEANS `who` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
`a notified exempt broker` MEANS `who` FALSE FALSE FALSE FALSE FALSE TRUE FALSE

GIVEN s IS A Standing
      a IS AN Activity
GIVETH A `Regulatory position`
`position in Singapore` s a MEANS `the regulatory position for` (`Regulatory case` OF s, a, `wholly in Singapore`, TRUE)

GIVEN s IS A Standing
      a IS AN Activity
      p IS A `Place of the act`
GIVETH A `Regulatory position`
`position at` s a p MEANS `the regulatory position for` (`Regulatory case` OF s, a, p, FALSE)

GIVEN sh IS A NUMBER
      vo IS A NUMBER
      directs IS A BOOLEAN
      policy IS A BOOLEAN
      excepted IS A BOOLEAN
GIVETH A `Shareholding facts`
`holding` sh vo directs policy excepted MEANS `Shareholding facts` OF sh, vo, directs, policy, excepted

GIVEN h IS A `Shareholding facts`
      substantial IS A BOOLEAN
      arrangement IS A NUMBER
      approved IS A BOOLEAN
GIVETH AN Activity
`control` h substantial arrangement approved MEANS
    `obtaining control of a licensed insurer incorporated in Singapore` h substantial arrangement approved

GIVEN m IS A MAYBE DATE
      d IS A DATE
GIVETH A BOOLEAN
DECIDE `in effect on` m d IF
    CONSIDER m
    WHEN JUST x THEN x AT MOST d
    WHEN NOTHING THEN FALSE

GIVEN bonus IS A NUMBER
      proposed IS A NUMBER
GIVETH A `Fund facts`
`fund` bonus proposed MEANS `Fund facts` OF bonus, proposed, TRUE, FALSE

GIVEN st IS A `Residence status`
      out IS A NUMBER
      now IS A BOOLEAN
      days IS A NUMBER
      cont IS A NUMBER
GIVETH A `Residence facts`
`res` st out now days cont MEANS `Residence facts` OF st, out, now, days, cont

`a resident citizen` MEANS `res` `a citizen` 0 TRUE 365 365
`a non-resident` MEANS `res` `none of these` 10 FALSE 0 0

GIVEN k IS A `Kind of policy`
      indiv IS A BOOLEAN
      r IS A `Residence facts`
      nonind IS A BOOLEAN
      risk IS A BOOLEAN
      cargo IS A BOOLEAN
      longterm IS A BOOLEAN
GIVETH A `Policy case`
`kind policy` k indiv r nonind risk cargo longterm MEANS `Policy case` WITH
    `kind` IS k
    `issued on` IS YMD 2020 1 1
    `issued in the course of business in Singapore` IS TRUE
    `the owner (or insured) is an individual` IS indiv
    `residence of the owner or insured` IS r
    `a non-individual: Singapore address, residence or permanent establishment` IS nonind
    `the risk arises in Singapore` IS risk
    `cargo carried between places outside Singapore` IS cargo
    `insurance on ships or goods, or a contract of indemnity` IS FALSE
    `may be in force more than 5 years, insurer cannot end it but for fraud or non-disclosure` IS longterm
    `life insured` IS `the person's own life`
    `insurable interest of the person effecting it` IS 0
    `a trust policy meeting s 146(3) or (4)` IS FALSE
    `sum insured` IS 100000
    `age of the person entering the contract` IS 30
    `written consent of a parent or guardian` IS FALSE
    `years in force` IS 1
    `an annuity, or no policy moneys necessarily payable` IS FALSE

GIVEN k IS A `Kind of policy`
      li IS A `Life insured`
      interest IS A NUMBER
      trust IS A BOOLEAN
      sum IS A NUMBER
      indemnity IS A BOOLEAN
GIVETH A `Policy case`
`life policy` k li interest trust sum indemnity MEANS `Policy case` WITH
    `kind` IS k
    `issued on` IS YMD 2020 1 1
    `issued in the course of business in Singapore` IS TRUE
    `the owner (or insured) is an individual` IS TRUE
    `residence of the owner or insured` IS `a resident citizen`
    `a non-individual: Singapore address, residence or permanent establishment` IS FALSE
    `the risk arises in Singapore` IS TRUE
    `cargo carried between places outside Singapore` IS FALSE
    `insurance on ships or goods, or a contract of indemnity` IS indemnity
    `may be in force more than 5 years, insurer cannot end it but for fraud or non-disclosure` IS FALSE
    `life insured` IS li
    `insurable interest of the person effecting it` IS interest
    `a trust policy meeting s 146(3) or (4)` IS trust
    `sum insured` IS sum
    `age of the person entering the contract` IS 30
    `written consent of a parent or guardian` IS FALSE
    `years in force` IS 1
    `an annuity, or no policy moneys necessarily payable` IS FALSE

GIVEN years IS A NUMBER
      annuity IS A BOOLEAN
GIVETH A `Policy case`
`policy in force` years annuity MEANS `Policy case` WITH
    `kind` IS `a life policy`
    `issued on` IS YMD 2020 1 1
    `issued in the course of business in Singapore` IS TRUE
    `the owner (or insured) is an individual` IS TRUE
    `residence of the owner or insured` IS `a resident citizen`
    `a non-individual: Singapore address, residence or permanent establishment` IS FALSE
    `the risk arises in Singapore` IS TRUE
    `cargo carried between places outside Singapore` IS FALSE
    `insurance on ships or goods, or a contract of indemnity` IS FALSE
    `may be in force more than 5 years, insurer cannot end it but for fraud or non-disclosure` IS FALSE
    `life insured` IS `the person's own life`
    `insurable interest of the person effecting it` IS 0
    `a trust policy meeting s 146(3) or (4)` IS FALSE
    `sum insured` IS 100000
    `age of the person entering the contract` IS 30
    `written consent of a parent or guardian` IS FALSE
    `years in force` IS years
    `an annuity, or no policy moneys necessarily payable` IS annuity

GIVEN name IS A STRING
      family IS A BOOLEAN
      portion IS A NUMBER
      alive IS A BOOLEAN
GIVETH A Nominee
`nominee` name family portion alive MEANS Nominee OF name, family, portion, alive

GIVEN k IS A `Nomination kind`
      ns IS A LIST OF Nominee
      age IS A NUMBER
      trust IS A BOOLEAN
      revoked IS A BOOLEAN
      dealt IS A BOOLEAN
      will IS A BOOLEAN
GIVETH AN `Estate facts`
`estate` k ns age trust revoked dealt will MEANS `Estate facts` OF k, ns, age, trust, revoked, dealt, will, TRUE

`spouse and child` MEANS LIST (`nominee` "spouse" TRUE 0.5 TRUE), (`nominee` "child" TRUE 0.5 TRUE)

GIVEN ns IS A LIST OF Nominee
      who IS A STRING
GIVETH A NUMBER
`portion of` ns who MEANS
    sum (map (GIVEN n YIELD n's `portion`) (filter (GIVEN n YIELD n's `name` EQUALS who) ns))

`ABC` MEANS LIST (`nominee` "a" FALSE 0.5 TRUE), (`nominee` "b" FALSE 0.3 TRUE), (`nominee` "c" FALSE 0.2 FALSE)

§§ `A. Licensing and authorisation (ss 3, 4)`

-- E001 s 4(1)
#ASSERT NOT `the activity is permitted` `an unlicensed company` (`carrying on a class of insurance business in Singapore as an insurer` `general business` FALSE FALSE)
-- E002 s 4(1)
#ASSERT NOT `the activity is permitted` `a general-only insurer` (`carrying on a class of insurance business in Singapore as an insurer` `life business` FALSE FALSE)
-- E003 s 4(3)
#ASSERT `the activity is permitted` `a life-only insurer` (`carrying on a class of insurance business in Singapore as an insurer` `general business` TRUE FALSE)
-- E004 s 4(1), (3)
#ASSERT NOT `the activity is permitted` `a life-only insurer` (`carrying on a class of insurance business in Singapore as an insurer` `general business` FALSE FALSE)
-- E005 s 3(6)
#ASSERT `the activity is permitted` `an unlicensed company` (`carrying on a class of insurance business in Singapore as an insurer` `general business` FALSE TRUE)
-- E006 s 4(2)
#ASSERT NOT `the activity is permitted` `an unlicensed company` (`providing reinsurance from outside Singapore to persons in Singapore` FALSE)
-- E007 s 4(2)(a)
#ASSERT `the activity is permitted` `an authorised reinsurer co` (`providing reinsurance from outside Singapore to persons in Singapore` FALSE)
-- E008-E010 s 4(2)(b)
#ASSERT `the activity is permitted` `an unlicensed company` (`providing reinsurance from outside Singapore to persons in Singapore` TRUE)
-- E011, E012 s 4(2)(b)(iii): not initiated by a listed person, so not "unsolicited" within (b)
#ASSERT NOT `the activity is permitted` `an unlicensed company` (`providing reinsurance from outside Singapore to persons in Singapore` FALSE)
-- E013 s 4(2) opening words
#ASSERT `the activity is permitted` `a general-only insurer` (`providing reinsurance from outside Singapore to persons in Singapore` FALSE)
-- E014 s 3(1)(a)
#ASSERT `the class of business of` (`kind policy` `an accident and health policy` TRUE `a resident citizen` FALSE TRUE FALSE TRUE) EQUALS `life business`

