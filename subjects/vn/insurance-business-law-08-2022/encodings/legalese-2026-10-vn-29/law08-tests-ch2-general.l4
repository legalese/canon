#ASSERT count `Dieu 20(1): the rights of the insurer` EQUALS 7
#ASSERT count `Dieu 20(2): the duties of the insurer` EQUALS 10
#ASSERT count `Dieu 21(1): the rights of the policyholder` EQUALS 8
#ASSERT count `Dieu 21(2): the duties of the policyholder` EQUALS 7

`a covered event, not excluded, paid` MEANS `An insurer's handling of a claim` WITH
    `the event is within the insurer's liability under the contract` IS TRUE
    `an exclusion of liability in the contract applies` IS FALSE
    `the insurer paid` IS TRUE
    `the insurer refused to pay` IS FALSE
    `the insurer explained the refusal in writing` IS FALSE
    `a third person claimed compensation from the policyholder for a loss within the insurance liability` IS FALSE
    `the insurer cooperated with the policyholder in settling the third person's claim` IS FALSE
    `the insurer disclosed the policyholder's or insured person's information` IS FALSE
    `a competent State body required the disclosure` IS FALSE
    `the policyholder or insured person agreed to the disclosure` IS FALSE
`a covered event, refused without ground` MEANS `An insurer's handling of a claim` WITH
    `the event is within the insurer's liability under the contract` IS TRUE
    `an exclusion of liability in the contract applies` IS FALSE
    `the insurer paid` IS FALSE
    `the insurer refused to pay` IS TRUE
    `the insurer explained the refusal in writing` IS FALSE
    `a third person claimed compensation from the policyholder for a loss within the insurance liability` IS FALSE
    `the insurer cooperated with the policyholder in settling the third person's claim` IS FALSE
    `the insurer disclosed the policyholder's or insured person's information` IS FALSE
    `a competent State body required the disclosure` IS FALSE
    `the policyholder or insured person agreed to the disclosure` IS FALSE
`a covered event, refused on an exclusion, explained` MEANS `An insurer's handling of a claim` WITH
    `the event is within the insurer's liability under the contract` IS TRUE
    `an exclusion of liability in the contract applies` IS TRUE
    `the insurer paid` IS FALSE
    `the insurer refused to pay` IS TRUE
    `the insurer explained the refusal in writing` IS TRUE
    `a third person claimed compensation from the policyholder for a loss within the insurance liability` IS FALSE
    `the insurer cooperated with the policyholder in settling the third person's claim` IS FALSE
    `the insurer disclosed the policyholder's or insured person's information` IS FALSE
    `a competent State body required the disclosure` IS FALSE
    `the policyholder or insured person agreed to the disclosure` IS FALSE
`an uncovered event, refused, not explained` MEANS `An insurer's handling of a claim` WITH
    `the event is within the insurer's liability under the contract` IS FALSE
    `an exclusion of liability in the contract applies` IS FALSE
    `the insurer paid` IS FALSE
    `the insurer refused to pay` IS TRUE
    `the insurer explained the refusal in writing` IS FALSE
    `a third person claimed compensation from the policyholder for a loss within the insurance liability` IS FALSE
    `the insurer cooperated with the policyholder in settling the third person's claim` IS FALSE
    `the insurer disclosed the policyholder's or insured person's information` IS FALSE
    `a competent State body required the disclosure` IS FALSE
    `the policyholder or insured person agreed to the disclosure` IS FALSE
`a third person's claim not cooperated on` MEANS `An insurer's handling of a claim` WITH
    `the event is within the insurer's liability under the contract` IS FALSE
    `an exclusion of liability in the contract applies` IS FALSE
    `the insurer paid` IS FALSE
    `the insurer refused to pay` IS FALSE
    `the insurer explained the refusal in writing` IS FALSE
    `a third person claimed compensation from the policyholder for a loss within the insurance liability` IS TRUE
    `the insurer cooperated with the policyholder in settling the third person's claim` IS FALSE
    `the insurer disclosed the policyholder's or insured person's information` IS FALSE
    `a competent State body required the disclosure` IS FALSE
    `the policyholder or insured person agreed to the disclosure` IS FALSE
