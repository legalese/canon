IMPORT prelude
IMPORT `apa-licensing`

-- Appraisers Act 1906, ss 2, 4, 6(4)-(5), 7, 10, 11 and 12 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_appraisers-act-1906.py). Expected results were written by
-- hand from the text.

-- Fixtures

`a paid land valuer, licensed` MEANS Valuer WITH
    `what is valued` IS `land`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS TRUE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a paid land valuer, never licensed` MEANS Valuer WITH
    `what is valued` IS `land`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a paid building valuer whose licence lapsed` MEANS Valuer WITH
    `what is valued` IS `a building`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS TRUE
    `carries on the valuing` IS TRUE

`a paid lease valuer whose licence lapsed but who stopped` MEANS Valuer WITH
    `what is valued` IS `a leasehold interest in land`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS TRUE
    `carries on the valuing` IS FALSE

`an unpaid friend valuing a flat` MEANS Valuer WITH
    `what is valued` IS `a building`
    `for hire, gain, fee or reward` IS FALSE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a paid reversion valuer, never licensed` MEANS Valuer WITH
    `what is valued` IS `a reversionary interest in land`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a paid contingent-interest valuer, renewed` MEANS Valuer WITH
    `what is valued` IS `a contingent interest in land`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS TRUE
    `previously held a licence that has expired` IS TRUE
    `carries on the valuing` IS TRUE

`a paid art and goods valuer, unlicensed` MEANS Valuer WITH
    `what is valued` IS `movable goods`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a paid share valuer, unlicensed` MEANS Valuer WITH
    `what is valued` IS `shares in a company`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a paid car valuer, unlicensed` MEANS Valuer WITH
    `what is valued` IS `a motor vehicle`
    `for hire, gain, fee or reward` IS TRUE
    `holds a licence in force` IS FALSE
    `previously held a licence that has expired` IS FALSE
    `carries on the valuing` IS TRUE

`a complete licence` MEANS Licence WITH
    `states the true name` IS TRUE
    `states the place of abode` IS TRUE
    `states the date or time of grant` IS TRUE
    `states the principal place of business` IS TRUE

`a licence with no place of business` MEANS Licence WITH
    `states the true name` IS TRUE
    `states the place of abode` IS TRUE
    `states the date or time of grant` IS TRUE
    `states the principal place of business` IS FALSE

`a licence with no date` MEANS Licence WITH
    `states the true name` IS TRUE
    `states the place of abode` IS TRUE
    `states the date or time of grant` IS FALSE
    `states the principal place of business` IS TRUE

`a licensee with a clean record` MEANS Licensee WITH
    `convicted of an offence under this Act` IS FALSE
    `failed to account for money or property held as licensee` IS FALSE
    `judgment of breach of trust or duty over money or property` IS FALSE
    `judgment of return commission paid to employer` IS FALSE
    `employer accountable to another for the sale proceeds` IS FALSE

`a licensee convicted under section 7(3)` MEANS Licensee WITH
    `convicted of an offence under this Act` IS TRUE
    `failed to account for money or property held as licensee` IS FALSE
    `judgment of breach of trust or duty over money or property` IS FALSE
    `judgment of return commission paid to employer` IS FALSE
    `employer accountable to another for the sale proceeds` IS FALSE

`a licensee who kept a client's deposit` MEANS Licensee WITH
    `convicted of an offence under this Act` IS FALSE
    `failed to account for money or property held as licensee` IS TRUE
    `judgment of breach of trust or duty over money or property` IS FALSE
    `judgment of return commission paid to employer` IS FALSE
    `employer accountable to another for the sale proceeds` IS FALSE

`a licensee found in breach of trust by a civil court` MEANS Licensee WITH
    `convicted of an offence under this Act` IS FALSE
    `failed to account for money or property held as licensee` IS FALSE
    `judgment of breach of trust or duty over money or property` IS TRUE
    `judgment of return commission paid to employer` IS FALSE
    `employer accountable to another for the sale proceeds` IS FALSE

`a licensee paying return commission to an accountable employer` MEANS Licensee WITH
    `convicted of an offence under this Act` IS FALSE
    `failed to account for money or property held as licensee` IS FALSE
    `judgment of breach of trust or duty over money or property` IS FALSE
    `judgment of return commission paid to employer` IS TRUE
    `employer accountable to another for the sale proceeds` IS TRUE

`a licensee paying return commission to an employer selling for himself` MEANS Licensee WITH
    `convicted of an offence under this Act` IS FALSE
    `failed to account for money or property held as licensee` IS FALSE
    `judgment of breach of trust or duty over money or property` IS FALSE
    `judgment of return commission paid to employer` IS TRUE
    `employer accountable to another for the sale proceeds` IS FALSE

§ `ss 2 and 4`

#ASSERT `is an appraiser` `a paid land valuer, licensed`
#ASSERT `is an appraiser` `a paid land valuer, never licensed`
#ASSERT `is an appraiser` `a paid building valuer whose licence lapsed`
#ASSERT `is an appraiser` `a paid lease valuer whose licence lapsed but who stopped`
#ASSERT NOT `is an appraiser` `an unpaid friend valuing a flat`
#ASSERT `is an appraiser` `a paid reversion valuer, never licensed`
#ASSERT `is an appraiser` `a paid contingent-interest valuer, renewed`
#ASSERT NOT `is an appraiser` `a paid art and goods valuer, unlicensed`
#ASSERT NOT `is an appraiser` `a paid share valuer, unlicensed`
#ASSERT NOT `is an appraiser` `a paid car valuer, unlicensed`

#ASSERT `must take out a licence` `a paid land valuer, licensed`
#ASSERT NOT `must take out a licence` `an unpaid friend valuing a flat`
#ASSERT NOT `must take out a licence` `a paid share valuer, unlicensed`

§ `s 7(3) and s 12`

#ASSERT NOT `commits the lapsed-licence offence` `a paid land valuer, licensed`
#ASSERT NOT `commits the lapsed-licence offence` `a paid land valuer, never licensed`
#ASSERT `commits the lapsed-licence offence` `a paid building valuer whose licence lapsed`
#ASSERT NOT `commits the lapsed-licence offence` `a paid lease valuer whose licence lapsed but who stopped`
#ASSERT NOT `commits the lapsed-licence offence` `a paid reversion valuer, never licensed`
#ASSERT NOT `commits the lapsed-licence offence` `a paid contingent-interest valuer, renewed`

#ASSERT NOT `commits the unlicensed-business offence` `a paid land valuer, licensed`
#ASSERT `commits the unlicensed-business offence` `a paid land valuer, never licensed`
#ASSERT NOT `commits the unlicensed-business offence` `a paid building valuer whose licence lapsed`
#ASSERT NOT `commits the unlicensed-business offence` `a paid lease valuer whose licence lapsed but who stopped`
#ASSERT `commits the unlicensed-business offence` `a paid reversion valuer, never licensed`
#ASSERT NOT `commits the unlicensed-business offence` `a paid contingent-interest valuer, renewed`

#ASSERT `commits an offence under section 7(3)` `a paid land valuer, never licensed`
#ASSERT `commits an offence under section 7(3)` `a paid building valuer whose licence lapsed`
#ASSERT NOT `commits an offence under section 7(3)` `a paid land valuer, licensed`
#ASSERT NOT `commits an offence under section 7(3)` `a paid art and goods valuer, unlicensed`
#ASSERT NOT `commits an offence under section 7(3)` `an unpaid friend valuing a flat`

#ASSERT `the maximum fine in dollars`  EQUALS 2000

#ASSERT `may be tried by a District Court` `a paid land valuer, never licensed`

§ `s 6(4), (5)`

#ASSERT `the Comptroller is barred from granting or renewing` FALSE
#ASSERT NOT `the Comptroller is barred from granting or renewing` TRUE

§ `s 7(1)`

#ASSERT `the licence states what section 7(1) requires` `a complete licence`
#ASSERT NOT `the licence states what section 7(1) requires` `a licence with no place of business`
#ASSERT NOT `the licence states what section 7(1) requires` `a licence with no date`

§ `s 7(2)`

#ASSERT `the year of expiry` 2026 EQUALS 2026

#ASSERT `the last renewal day in December`  EQUALS 21

#ASSERT `renewed in time` 30
#ASSERT `renewed in time` 10
#ASSERT NOT `renewed in time` 9
#ASSERT NOT `renewed in time` 0

§ `ss 10 and 11`

#ASSERT NOT `a ground for cancellation exists` `a licensee with a clean record`
#ASSERT `a ground for cancellation exists` `a licensee convicted under section 7(3)`
#ASSERT `a ground for cancellation exists` `a licensee who kept a client's deposit`
#ASSERT `a ground for cancellation exists` `a licensee found in breach of trust by a civil court`
#ASSERT `a ground for cancellation exists` `a licensee paying return commission to an accountable employer`
#ASSERT NOT `a ground for cancellation exists` `a licensee paying return commission to an employer selling for himself`

#ASSERT NOT `the Comptroller needs a ground to refuse an application` 

