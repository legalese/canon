      , (`First Schedule Row` OF "500", "500", "Defamation", `May not arrest without warrant`, `A summons ordinarily issues`, `Bailable`, "Imprisonment for 2 years, or fine, or both", `Magistrate's Court or District Court`, "CHAPTER 21 -- DEFAMATION", "", 452)
      , (`First Schedule Row` OF "501", "501", "Printing or engraving matter knowing it to be defamatory", `May not arrest without warrant`, `A summons ordinarily issues`, `Bailable`, "Imprisonment for 2 years, or fine, or both", `Magistrate's Court or District Court`, "CHAPTER 21 -- DEFAMATION", "", 452)
