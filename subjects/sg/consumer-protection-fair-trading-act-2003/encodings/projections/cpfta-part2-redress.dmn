      <text>d.the_applicant_is_the_Commission and (the_court_is_the_District_Court_or_the_General_Division_of_the_High_Court(k: d.the_court) and (d.the_supplier_has_engaged_is_engaging_or_is_likely_to_engage_in_an_unfair_practice and (d.the_court_is_satisfied_that_the_supplier_has_engaged_in_the_unfair_practice or d.the_court_is_satisfied_that_if_a_declaration_or_an_injunction_is_not_granted_it_is_likely_that_the_supplier_will_engage_in_the_unfair_practice)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_make_accompanying_orders_under_section_9_4" name="the_court_may_make_accompanying_orders_under_section_9_4" label="the court may make accompanying orders under section 9(4)">
