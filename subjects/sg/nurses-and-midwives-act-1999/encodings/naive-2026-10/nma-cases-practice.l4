IMPORT prelude
IMPORT `nma-practice`

-- Nurses and Midwives Act 1999, ss 13, 16 to 21, 23, 26 to 29, 35 and 43A -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_nurses-and-midwives-act-1999.py). Expected results were written by
-- hand from the text.

`an active registered nurse` MEANS Person WITH
    `is a registered or enrolled nurse` IS TRUE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS TRUE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`a registered nurse with a lapsed practising certificate` MEANS Person WITH
    `is a registered or enrolled nurse` IS TRUE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS FALSE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`a suspended nurse still holding a practising certificate` MEANS Person WITH
    `is a registered or enrolled nurse` IS TRUE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS TRUE
    `registration or enrolment is suspended` IS TRUE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`an active registered midwife` MEANS Person WITH
    `is a registered or enrolled nurse` IS FALSE
    `is a registered midwife` IS TRUE
    `holds a valid practising certificate` IS TRUE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`an untrained caregiver` MEANS Person WITH
    `is a registered or enrolled nurse` IS FALSE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS FALSE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`a doctor` MEANS Person WITH
    `is a registered or enrolled nurse` IS FALSE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS FALSE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS TRUE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`a supervised student nurse` MEANS Person WITH
    `is a registered or enrolled nurse` IS FALSE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS FALSE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS TRUE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

`a supervised student midwife` MEANS Person WITH
    `is a registered or enrolled nurse` IS FALSE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS FALSE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS TRUE
    `is rendering assistance in an emergency` IS FALSE

`a passer-by giving first aid` MEANS Person WITH
    `is a registered or enrolled nurse` IS FALSE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS FALSE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS FALSE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS TRUE

`an Advanced Practice Nurse` MEANS Person WITH
    `is a registered or enrolled nurse` IS TRUE
    `is a registered midwife` IS FALSE
    `holds a valid practising certificate` IS TRUE
    `registration or enrolment is suspended` IS FALSE
    `is an Advanced Practice Nurse` IS TRUE
    `is a medical practitioner` IS FALSE
    `is a supervised student nurse in an approved organisation` IS FALSE
    `is a supervised student midwife in an approved organisation` IS FALSE
    `is rendering assistance in an emergency` IS FALSE

§ `ss 26(2), 19(10) -- qualified`

#ASSERT `is a qualified nurse` `an active registered nurse`
#ASSERT NOT `is a qualified nurse` `a registered nurse with a lapsed practising certificate`
#ASSERT NOT `is a qualified nurse` `a suspended nurse still holding a practising certificate`
#ASSERT NOT `is a qualified nurse` `an untrained caregiver`

#ASSERT NOT `is a qualified midwife` `an active registered nurse`

§ `ss 26, 35 -- titles`

#ASSERT `using the title nurse is an offence` `a registered nurse with a lapsed practising certificate`
#ASSERT `using the title nurse is an offence` `a doctor`
#ASSERT NOT `using the title nurse is an offence` `an active registered nurse`

#ASSERT NOT `using the title Advanced Practice Nurse is an offence` `an Advanced Practice Nurse`
#ASSERT `using the title Advanced Practice Nurse is an offence` `an active registered nurse`

§ `s 27 -- practice for reward`

#ASSERT `carrying out nursing is an offence` `an untrained caregiver` TRUE
#ASSERT NOT `carrying out nursing is an offence` `an untrained caregiver` FALSE
#ASSERT `carrying out nursing is an offence` `a registered nurse with a lapsed practising certificate` TRUE
#ASSERT NOT `carrying out nursing is an offence` `a supervised student nurse` TRUE
#ASSERT NOT `carrying out nursing is an offence` `a passer-by giving first aid` TRUE
#ASSERT `carrying out nursing is an offence` `a supervised student midwife` TRUE

#ASSERT `attending a childbirth is an offence` `an active registered nurse` TRUE
#ASSERT NOT `attending a childbirth is an offence` `an active registered midwife` TRUE
#ASSERT NOT `attending a childbirth is an offence` `a supervised student midwife` TRUE

#ASSERT `the maximum fine under sections 27 to 30` FALSE EQUALS 10000
#ASSERT `the maximum fine under sections 27 to 30` TRUE EQUALS 20000

#ASSERT `the maximum imprisonment in months under sections 27 to 30` TRUE EQUALS 6

§ `ss 28, 29 -- employers and agents`

#ASSERT `employing the worker for nursing is an offence` `an untrained caregiver` FALSE FALSE FALSE
#ASSERT NOT `employing the worker for nursing is an offence` `an untrained caregiver` TRUE FALSE FALSE
#ASSERT NOT `employing the worker for nursing is an offence` `an untrained caregiver` FALSE TRUE TRUE
#ASSERT `employing the worker for nursing is an offence` `an untrained caregiver` FALSE TRUE FALSE
#ASSERT NOT `employing the worker for nursing is an offence` `a doctor` FALSE FALSE FALSE

#ASSERT `the agent's placement for nursing is an offence` `an untrained caregiver` FALSE FALSE
#ASSERT NOT `the agent's placement for nursing is an offence` `an untrained caregiver` TRUE TRUE

§ `ss 13, 16, 17, 18 -- registration and certificates`

#ASSERT NOT `the change was notified in time` 29 FALSE
#ASSERT `the change was notified in time` 60 TRUE

#ASSERT `the temporary registration period is permitted` 24 FALSE
#ASSERT NOT `the temporary registration period is permitted` 25 FALSE
#ASSERT NOT `the temporary registration period is permitted` 13 TRUE

#ASSERT NOT `the refusal appeal is in time` 2

#ASSERT `a late application fee is payable` 0.5
#ASSERT NOT `a late application fee is payable` 1

§ `ss 19, 20, 21, 23 -- discipline`

#ASSERT NOT `the suspension period is permitted` 25

#ASSERT `the maximum financial penalty` EQUALS 2000

#ASSERT `failing to surrender is an offence` `misconduct or negligence rendering unfit` 15 FALSE
#ASSERT NOT `failing to surrender is an offence` `misconduct or negligence rendering unfit` 10 FALSE
#ASSERT NOT `failing to surrender is an offence` `misconduct or negligence rendering unfit` 30 TRUE
#ASSERT NOT `failing to surrender is an offence` `practising certificate not renewed for the prescribed period` 30 FALSE

#ASSERT `costs may be ordered` `obtained registration fraudulently`
#ASSERT NOT `costs may be ordered` `cancelled or suspended abroad`
#ASSERT `costs may be ordered` `mental or physical disability`

#ASSERT NOT `the disciplinary appeal is in time` 4 FALSE
#ASSERT `the disciplinary appeal is in time` 4 TRUE

#ASSERT NOT `a re-registration application may be made` `misconduct or negligence rendering unfit` 2 FALSE
#ASSERT `a re-registration application may be made` `misconduct or negligence rendering unfit` 3 FALSE
#ASSERT NOT `a re-registration application may be made` `misconduct or negligence rendering unfit` 4 TRUE
#ASSERT `a re-registration application may be made` `obtained registration fraudulently` 1 FALSE
#ASSERT `a re-registration application may be made` `mental or physical disability` 0 TRUE

