§ `ss 8, 17 and 19`

#ASSERT `the registration deadline in months` 0 EQUALS 1
#ASSERT `the registration deadline in months` 8 EQUALS 6

#ASSERT `the application is in time` 1 0
#ASSERT `the application is in time` 4 3
#ASSERT NOT `the application is in time` 7 8

#ASSERT `the deemed day of establishment` 40 25 EQUALS 25

#ASSERT NOT `the union is deemed an unlawful association` TRUE FALSE FALSE
#ASSERT `the union is deemed an unlawful association` FALSE FALSE FALSE

#ASSERT `the appeal to the Minister is in time` 30
#ASSERT NOT `the appeal to the Minister is in time` 31

§ `s 22`

#ASSERT `the union is immune from the suit` TRUE FALSE TRUE TRUE
#ASSERT NOT `the union is immune from the suit` TRUE TRUE TRUE TRUE
#ASSERT NOT `the union is immune from the suit` TRUE FALSE TRUE FALSE

§ `s 27`

#ASSERT `the strike ballot carries` `an ordinary strike with a bare majority`
#ASSERT NOT `the strike ballot carries` `a strike with exactly half in favour`
#ASSERT NOT `the strike ballot carries` `a strike won among voters on a low turnout`

#ASSERT `the members whose consent counts` `a strike counting non-executives only` EQUALS 80
#ASSERT `the members whose consent counts` `the same vote in a mostly executive union` EQUALS 100

#ASSERT `the requisite consent is obtained` 40 45

#ASSERT NOT `the union may lawfully call the strike` `a strike won among voters on a low turnout`
#ASSERT NOT `the union may lawfully call the strike` `an executive dispute in a non-executive union`
#ASSERT `the union may lawfully call the strike` `an executive dispute where the union is recognised`
#ASSERT NOT `the union may lawfully call the strike` `a combined federation strike`
#ASSERT `the union may lawfully call the strike` `a balloted strike against the union's rules`

#ASSERT `a member taking part commits an offence` `an executive dispute in a non-executive union` FALSE
#ASSERT NOT `a member taking part commits an offence` `a combined federation strike` FALSE
#ASSERT `a member taking part commits an offence` `a balloted strike against the union's rules` FALSE
#ASSERT `a member taking part commits an offence` `an executive dispute where the union is recognised` TRUE

#ASSERT `the maximum fine for the strike offence` `a member taking part` EQUALS 2000
#ASSERT `the maximum fine for the strike offence` `an instigator or inciter` EQUALS 3000

§ `s 28`

#ASSERT `the person may be a member` 17 FALSE FALSE FALSE
#ASSERT NOT `the person may be a member` 16 FALSE FALSE FALSE
#ASSERT NOT `the person may be a member` 30 FALSE TRUE FALSE

#ASSERT `the Minister's approval is needed to join the executive` 19
#ASSERT NOT `the Minister's approval is needed to join the executive` 17

§ `ss 30 and 43`

#ASSERT NOT `the candidate may act as an officer` `an undischarged bankrupt citizen`
#ASSERT `the candidate may act as an officer` `a reformed breach-of-trust convict`
#ASSERT NOT `the candidate may act as an officer` `an unreformed extortion convict`
#ASSERT NOT `the candidate may act as an officer` `a non-citizen without approval`
#ASSERT `the candidate may act as an officer` `the union's treasurer`

#ASSERT NOT `the candidate may be a trustee` `an undischarged bankrupt citizen`
#ASSERT NOT `the candidate may be a trustee` `a reformed breach-of-trust convict`
#ASSERT `the candidate may be a trustee` `a non-citizen with the Minister's approval`
#ASSERT NOT `the candidate may be a trustee` `the union's treasurer`
#ASSERT `the candidate may be a trustee` `a fraud convict approved by the Minister`

#ASSERT `the officers meet the two-thirds rule` 6 9
#ASSERT NOT `the officers meet the two-thirds rule` 5 9

§ `ss 47, 48 and 49`

#ASSERT `the funds may be spent on` `strike pay during a trade dispute`
#ASSERT NOT `the funds may be spent on` `a member's court fine`
#ASSERT NOT `the funds may be spent on` `a donation to a political party`
#ASSERT NOT `the funds may be spent on` `a gift to a charity not Gazetted`

#ASSERT `the funds may be invested in` `shares in a union-established co-operative`
#ASSERT NOT `the funds may be invested in` `listed company shares`

§ `ss 37, 51(4) and 59`

#ASSERT NOT `the Minister's approval is needed to keep the auditor` 5
#ASSERT `the Minister's approval is needed to keep the auditor` 6

#ASSERT `the maximum fine for operating without a notified office` 10 EQUALS 500

#ASSERT NOT `the Registrar may compound for that sum` TRUE 250

