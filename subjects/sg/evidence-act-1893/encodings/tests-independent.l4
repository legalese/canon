-- ======== s 2 and s 3
`fx1` MEANS `Application Facts` OF TRUE, FALSE, FALSE
#ASSERT `Parts 1, 2 and 3 apply` `fx1` EQUALS TRUE -- S2a 
`fx2` MEANS `Application Facts` OF TRUE, TRUE, FALSE
#ASSERT `Parts 1, 2 and 3 apply` `fx2` EQUALS FALSE -- S2b affidavit
`fx3` MEANS `Application Facts` OF TRUE, FALSE, TRUE
#ASSERT `Parts 1, 2 and 3 apply` `fx3` EQUALS FALSE -- S2c arbitrator
`fx4` MEANS `Application Facts` OF FALSE, FALSE, FALSE
#ASSERT `Parts 1, 2 and 3 apply` `fx4` EQUALS FALSE -- S2d not a judicial proceeding
`fx5` MEANS `Finding Facts` OF TRUE, FALSE, FALSE, FALSE
#ASSERT `the fact is proved` `fx5` EQUALS TRUE -- S3a 
`fx6` MEANS `Finding Facts` OF FALSE, TRUE, FALSE, FALSE
#ASSERT `the fact is proved` `fx6` EQUALS TRUE -- S3b 
`fx7` MEANS `Finding Facts` OF FALSE, FALSE, FALSE, FALSE
#ASSERT `the fact is proved` `fx7` EQUALS FALSE -- S3c 
`fx8` MEANS `Finding Facts` OF FALSE, FALSE, TRUE, FALSE
#ASSERT `the fact is disproved` `fx8` EQUALS TRUE -- S3d 
`fx9` MEANS `Finding Facts` OF FALSE, FALSE, FALSE, TRUE
#ASSERT `the fact is disproved` `fx9` EQUALS TRUE -- S3e 
`fx10` MEANS `Finding Facts` OF TRUE, FALSE, FALSE, FALSE
#ASSERT `the fact is disproved` `fx10` EQUALS FALSE -- S3f 
`fx11` MEANS `Finding Facts` OF TRUE, FALSE, FALSE, FALSE
#ASSERT `the finding on the fact` `fx11` EQUALS `proved` -- S3g 
`fx12` MEANS `Finding Facts` OF FALSE, FALSE, TRUE, FALSE
#ASSERT `the finding on the fact` `fx12` EQUALS `disproved` -- S3h 
`fx13` MEANS `Finding Facts` OF FALSE, FALSE, FALSE, FALSE
#ASSERT `the finding on the fact` `fx13` EQUALS `not proved` -- S3i 

