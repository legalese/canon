IMPORT prelude
IMPORT `rda-designs`

-- Registered Designs Act 2000, ss 2(1), 4, 5-7, 8A, 12, 21, 23(4), 30, 31, 36(3), 39, 44, 65, 66, 68 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_registered-designs-act-2000.py). Expected results were written by
-- hand from the text.

§ `s 2(1)`

#ASSERT `the feature counts as design` `a distinctive shape`
#ASSERT NOT `the feature counts as design` `a method of construction`
#ASSERT NOT `the feature counts as design` `a shape dictated solely by function`
#ASSERT NOT `the feature counts as design` `a shape that must match the larger product`
#ASSERT NOT `the feature counts as design` `colour alone with no shape or pattern`

§ `s 4`

#ASSERT `the first owner` FALSE FALSE FALSE EQUALS `the designer`
#ASSERT `the first owner` FALSE TRUE FALSE EQUALS `the employer`
#ASSERT `the first owner` FALSE TRUE TRUE EQUALS `the designer`
#ASSERT `the first owner` TRUE FALSE FALSE EQUALS `the person who made the arrangements`

§ `s 8A`

#ASSERT `the disclosure is disregarded` `confidential disclosure` 30 TRUE
#ASSERT `the disclosure is disregarded` `disclosure by the designer` 12 TRUE
#ASSERT NOT `the disclosure is disregarded` `disclosure by the designer` 13 TRUE
#ASSERT `the disclosure is disregarded` `disclosure resulting from an abuse of the designer` 3 TRUE
#ASSERT NOT `the disclosure is disregarded` `independent disclosure by a stranger` 1 TRUE
#ASSERT NOT `the disclosure is disregarded` `disclosure by the designer` 6 FALSE

§ `ss 5, 6, 7`

#ASSERT `the design is new` FALSE FALSE
#ASSERT NOT `the design is new` TRUE FALSE
#ASSERT `the design is new` TRUE TRUE

#ASSERT `the design is registrable` TRUE FALSE FALSE
#ASSERT NOT `the design is registrable` FALSE FALSE FALSE
#ASSERT NOT `the design is registrable` TRUE TRUE FALSE

§ `s 12`

#ASSERT `priority may be claimed` TRUE 6
#ASSERT NOT `priority may be claimed` TRUE 7

§ `s 21`

#ASSERT `the years of protection` 0 EQUALS 5
#ASSERT `the years of protection` 2 EQUALS 15
#ASSERT `the years of protection` 5 EQUALS 15

#ASSERT `the registration is in force` 14 2
#ASSERT NOT `the registration is in force` 5 0
#ASSERT NOT `the registration is in force` 15 2

§ `ss 30, 31`

#ASSERT `the act infringes` `making copies for sale` FALSE TRUE FALSE
#ASSERT `the act infringes` `selling copies` FALSE TRUE FALSE
#ASSERT NOT `the act infringes` `making a copy for private non-commercial use` FALSE TRUE FALSE
#ASSERT NOT `the act infringes` `importing genuine goods first sold abroad by the owner` FALSE TRUE FALSE
#ASSERT NOT `the act infringes` `copying only the functional or must-fit features` FALSE TRUE FALSE
#ASSERT NOT `the act infringes` `selling copies` TRUE TRUE FALSE
#ASSERT NOT `the act infringes` `making copies for sale` FALSE TRUE TRUE

#ASSERT NOT `the prior user may do what it wants` TRUE TRUE

§ `ss 36(3), 39`

#ASSERT NOT `proceedings may be taken` TRUE

#ASSERT NOT `damages or profits may be awarded` FALSE `no marking` FALSE
#ASSERT NOT `damages or profits may be awarded` FALSE `marked registered without the number` FALSE
#ASSERT `damages or profits may be awarded` FALSE `marked registered with the number` FALSE

§ `s 23(4)`

#ASSERT NOT `a transfer order for non-entitlement is possible` 3 FALSE
#ASSERT `a transfer order for non-entitlement is possible` 3 TRUE

§ `s 44`

#ASSERT `threats relief is available` `threat about selling` FALSE FALSE FALSE
#ASSERT NOT `threats relief is available` `threat about selling` FALSE TRUE FALSE
#ASSERT `threats relief is available` `threat about selling` FALSE TRUE TRUE
#ASSERT NOT `threats relief is available` `threat about making or importing` FALSE FALSE FALSE
#ASSERT NOT `threats relief is available` `threat about selling` TRUE FALSE FALSE

§ `ss 65, 66, 68`

#ASSERT `the maximum fine` `falsifying the Register` EQUALS 50000

#ASSERT `the maximum imprisonment in months` `falsifying the Register` EQUALS 60

#ASSERT `the composition cap` 50000 EQUALS 5000
#ASSERT `the composition cap` 6000 EQUALS 3000

#ASSERT `the false-registration offence is committed` TRUE TRUE FALSE
#ASSERT NOT `the false-registration offence is committed` TRUE TRUE TRUE

