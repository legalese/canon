-- TEST CASES
-- ===========================================================================

§§ `Part 5 — Illustrations`

-- s 145: director requirements
#ASSERT `meets director requirements` TRUE 25 TRUE
#ASSERT NOT (`meets director requirements` TRUE 17 TRUE)
#ASSERT NOT (`meets director requirements` FALSE 30 TRUE)
#ASSERT NOT (`meets director requirements` TRUE 25 FALSE)

-- s 154: automatic disqualification
-- Convicted of fraud offence punishable >= 3 months
#ASSERT `automatically disqualified as director` TRUE 3 FALSE
#ASSERT `automatically disqualified as director` TRUE 6 FALSE
-- Not disqualified: offence punishable < 3 months
#ASSERT NOT (`automatically disqualified as director` TRUE 2 FALSE)
-- Disqualified by SFA civil penalty alone
#ASSERT `automatically disqualified as director` FALSE 0 TRUE

-- s 155: persistent default
#ASSERT `persistently in default` 3 TRUE
#ASSERT `persistently in default` 5 TRUE
#ASSERT NOT (`persistently in default` 2 TRUE)
#ASSERT NOT (`persistently in default` 3 FALSE)

-- s 155A: struck-off disqualification
#ASSERT `disqualified for struck off companies` 3 TRUE
#ASSERT NOT (`disqualified for struck off companies` 2 TRUE)

-- s 155A: disqualification period
#ASSERT (`struck off disqualification period years` TRUE) EQUALS 5
#ASSERT (`struck off disqualification period years` FALSE) EQUALS 3

-- s 155B: debarment order conditions
#ASSERT `debarment order conditions met` 3 TRUE 14
#ASSERT `debarment order conditions met` 6 TRUE 30
#ASSERT NOT (`debarment order conditions met` 2 TRUE 14)
#ASSERT NOT (`debarment order conditions met` 3 FALSE 14)
#ASSERT NOT (`debarment order conditions met` 3 TRUE 10)

-- s 163: connected-company loan
#ASSERT `connected company loan requires approval` 20 FALSE
#ASSERT `connected company loan requires approval` 30 FALSE
#ASSERT NOT (`connected company loan requires approval` 19 FALSE)
-- Exempt private company — no approval needed even at 20%
#ASSERT NOT (`connected company loan requires approval` 25 TRUE)

-- s 164A: director emolument disclosure demand
#ASSERT `may demand director emolument disclosure` 10 0
#ASSERT `may demand director emolument disclosure` 5 5
#ASSERT NOT (`may demand director emolument disclosure` 8 3)

-- s 175: AGM deadline
#ASSERT (`AGM deadline months after financial year end` TRUE) EQUALS 4
#ASSERT (`AGM deadline months after financial year end` FALSE) EQUALS 6

-- s 176: EGM requisition
#ASSERT `may requisition EGM` 10
#ASSERT NOT (`may requisition EGM` 9)
#ASSERT `requisitionists may convene EGM` 51
#ASSERT NOT (`requisitionists may convene EGM` 50)

-- s 183: resolution circulation requisition
#ASSERT `may requisition resolution circulation` 5 10 100
#ASSERT `may requisition resolution circulation` 1 100 500
#ASSERT NOT (`may requisition resolution circulation` 3 50 300)

-- s 184: special resolution notice
`Test Private Co` MEANS Company WITH
    `name`                     IS "Test Pte Ltd"
    `company type`             IS `company limited by shares`
    `classification`           IS `private company`
    `date of incorporation`    IS YMD 2024 1 1
    `has constitution`         IS TRUE
    `has share capital`        IS TRUE
    `number of members`        IS 5
    `member limit in constitution` IS 50
    `restricts share transfer` IS TRUE

`Test Public Co` MEANS Company WITH
    `name`                     IS "Test Ltd"
    `company type`             IS `company limited by shares`
    `classification`           IS `public company`
    `date of incorporation`    IS YMD 2024 1 1
    `has constitution`         IS TRUE
    `has share capital`        IS TRUE
    `number of members`        IS 200
    `member limit in constitution` IS 1000
    `restricts share transfer` IS FALSE

#ASSERT (`special resolution notice days` `Test Private Co`) EQUALS 14
#ASSERT (`special resolution notice days` `Test Public Co`) EQUALS 21
