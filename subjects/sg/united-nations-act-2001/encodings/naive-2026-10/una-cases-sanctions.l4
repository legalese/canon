IMPORT prelude
IMPORT `una-sanctions`

-- United Nations Act 2001, ss 2 to 7 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_united-nations-act-2001.py). Expected results were written by
-- hand from the text.

§ `s 2(1)`

#ASSERT `the Minister may make regulations` TRUE TRUE TRUE
#ASSERT NOT `the Minister may make regulations` FALSE TRUE TRUE
#ASSERT NOT `the Minister may make regulations` TRUE FALSE TRUE
#ASSERT NOT `the Minister may make regulations` TRUE TRUE FALSE

§ `s 2(2) to (4)`

#ASSERT `the UN Act measures apply to the person` `an individual` TRUE
#ASSERT `the UN Act measures apply to the person` `a company` TRUE
#ASSERT NOT `the UN Act measures apply to the person` `a financial institution` TRUE
#ASSERT NOT `the UN Act measures apply to the person` `a VCC` TRUE
#ASSERT `the UN Act measures apply to the person` `an individual` FALSE
#ASSERT `the UN Act measures apply to the person` `a company` FALSE
#ASSERT `the UN Act measures apply to the person` `a financial institution` FALSE
#ASSERT `the UN Act measures apply to the person` `a VCC` FALSE

§ `s 2(5)`

#ASSERT NOT `inconsistency with it can invalidate a UN Act regulation` `another Act of Parliament`
#ASSERT NOT `inconsistency with it can invalidate a UN Act regulation` `other subsidiary legislation`
#ASSERT `inconsistency with it can invalidate a UN Act regulation` `the Constitution`

§ `s 3`

#ASSERT `proceedings for the failure are barred` `an act required by a contract` TRUE
