#ASSERT NOT `the publication contravenes section 38(1)` `a post with a 16-year-old's parent's consent`

#ASSERT `the maximum fine for identifying a resident` 0 EQUALS 5000
#ASSERT `the maximum fine for identifying a resident` 1 EQUALS 10000

§ `s 39`

#ASSERT `a court may order takedown` TRUE FALSE TRUE FALSE
#ASSERT NOT `a court may order takedown` TRUE FALSE FALSE FALSE

