IMPORT prelude
IMPORT `memta-minimum-tax`

-- Multinational Enterprise (Minimum Tax) Act 2024, ss 2, 7, 8, 12, 13, 15 to 19, 28, 31, 36, 40 to 45, 64, 68, 69 and the Second Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_multinational-enterprise-minimum-tax-act-2024.py). Expected results were written by
-- hand from the text.

`a 12-month year of 800` MEANS `Prior year` WITH
    `consolidated revenue in EUR million` IS 800
    `months` IS 12

`a 12-month year of 700` MEANS `Prior year` WITH
    `consolidated revenue in EUR million` IS 700
    `months` IS 12

`a 12-month year of exactly 750` MEANS `Prior year` WITH
    `consolidated revenue in EUR million` IS 750
    `months` IS 12

`a 6-month year of 400` MEANS `Prior year` WITH
    `consolidated revenue in EUR million` IS 400
    `months` IS 6

`a 6-month year of 300` MEANS `Prior year` WITH
    `consolidated revenue in EUR million` IS 300
    `months` IS 6

§ `ss 7, 8`

#ASSERT `the revenue threshold in EUR million` 6 EQUALS 375

#ASSERT `the year meets the threshold` `a 12-month year of exactly 750`
#ASSERT `the year meets the threshold` `a 6-month year of 400`
#ASSERT NOT `the year meets the threshold` `a 6-month year of 300`

#ASSERT `the Act applies to the group` 2025 TRUE `a 12-month year of 800` `a 12-month year of 700` `a 12-month year of 800` `a 12-month year of 700`
#ASSERT NOT `the Act applies to the group` 2025 TRUE `a 12-month year of 700` `a 12-month year of 700` `a 12-month year of 700` `a 12-month year of 800`
