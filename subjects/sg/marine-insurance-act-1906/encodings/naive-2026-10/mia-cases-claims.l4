    `the insurer asked about it` IS FALSE
    `it diminishes the risk` IS FALSE
    `known or presumed known to the insurer` IS TRUE
    `information waived by the insurer` IS FALSE
    `superfluous because of a warranty` IS FALSE

`a reported war the insurer asked about` MEANS Circumstance WITH
    `material` IS TRUE
    `known or ought to be known to the assured` IS TRUE
    `disclosed` IS FALSE
    `the insurer asked about it` IS TRUE
    `it diminishes the risk` IS FALSE
    `known or presumed known to the insurer` IS TRUE
    `information waived by the insurer` IS FALSE
    `superfluous because of a warranty` IS FALSE

`a broken warranty to sail by 1 June` MEANS WarrantyFacts WITH
    `broken` IS TRUE
    `material to the risk` IS TRUE
    `remedied before the loss` IS FALSE
    `excused by changed circumstances or a later law` IS FALSE
    `waived by the insurer` IS FALSE
    `the loss came before the breach` IS FALSE

`the same breach put right before the loss` MEANS WarrantyFacts WITH
    `broken` IS TRUE
    `material to the risk` IS TRUE
    `remedied before the loss` IS TRUE
    `excused by changed circumstances or a later law` IS FALSE
    `waived by the insurer` IS FALSE
    `the loss came before the breach` IS FALSE

`a breach immaterial to the risk` MEANS WarrantyFacts WITH
    `broken` IS TRUE
    `material to the risk` IS FALSE
    `remedied before the loss` IS FALSE
    `excused by changed circumstances or a later law` IS FALSE
    `waived by the insurer` IS FALSE
    `the loss came before the breach` IS FALSE

`a breach the insurer waived` MEANS WarrantyFacts WITH
    `broken` IS TRUE
    `material to the risk` IS FALSE
    `remedied before the loss` IS FALSE
    `excused by changed circumstances or a later law` IS FALSE
    `waived by the insurer` IS TRUE
    `the loss came before the breach` IS FALSE

`a loss before a later breach` MEANS WarrantyFacts WITH
    `broken` IS TRUE
    `material to the risk` IS FALSE
    `remedied before the loss` IS FALSE
    `excused by changed circumstances or a later law` IS FALSE
    `waived by the insurer` IS FALSE
    `the loss came before the breach` IS TRUE

§ `ss 4 and 6`

#ASSERT `the policy is void as gaming` FALSE FALSE FALSE
#ASSERT NOT `the policy is void as gaming` FALSE TRUE FALSE
#ASSERT `the policy is void as gaming` TRUE FALSE TRUE

#ASSERT `the interest requirement is met` FALSE TRUE FALSE FALSE
#ASSERT NOT `the interest requirement is met` FALSE TRUE TRUE FALSE
#ASSERT `the interest requirement is met` FALSE TRUE TRUE TRUE

§ `ss 17 and 18`

#ASSERT `the insurer may avoid for non-disclosure` `a prior grounding the owner did not mention`
#ASSERT NOT `the insurer may avoid for non-disclosure` `a prior grounding the owner disclosed`
#ASSERT NOT `the insurer may avoid for non-disclosure` `a newly fitted fire-suppression system`
#ASSERT NOT `the insurer may avoid for non-disclosure` `a widely reported war in the region`
#ASSERT `the insurer may avoid for non-disclosure` `a reported war the insurer asked about`

§ `ss 33, 34 and 39`

#ASSERT NOT `the insurer is still liable despite the warranty` `a broken warranty to sail by 1 June`
#ASSERT NOT `the insurer is still liable despite the warranty` `the same breach put right before the loss`
#ASSERT NOT `the insurer is still liable despite the warranty` `a breach immaterial to the risk`
#ASSERT `the insurer is still liable despite the warranty` `a breach the insurer waived`
#ASSERT `the insurer is still liable despite the warranty` `a loss before a later breach`

#ASSERT `unseaworthiness defeats the claim` `voyage policy` TRUE FALSE FALSE
#ASSERT NOT `unseaworthiness defeats the claim` `time policy` TRUE FALSE TRUE
#ASSERT `unseaworthiness defeats the claim` `time policy` TRUE TRUE TRUE

§ `ss 46, 48 and 49`

#ASSERT `the insurer is discharged by the deviation` TRUE `to load extra cargo`
#ASSERT NOT `the insurer is discharged by the deviation` FALSE `to load extra cargo`
#ASSERT NOT `the insurer is discharged by the deviation` TRUE `to save human life`
#ASSERT `the insurer is discharged by the deviation` TRUE `to aid a ship in distress to earn salvage`
#ASSERT `the insurer is discharged by the deviation` TRUE `barratry, which the policy does not cover`

§ `s 55`

#ASSERT `the insurer is liable for the loss` `a storm, crew negligence aside` FALSE
#ASSERT `the insurer is liable for the loss` `a storm made worse by crew negligence` FALSE
#ASSERT NOT `the insurer is liable for the loss` `the assured's wilful misconduct` TRUE
#ASSERT NOT `the insurer is liable for the loss` `delay caused by a storm` FALSE
#ASSERT `the insurer is liable for the loss` `delay caused by a storm` TRUE

§ `ss 57, 60, 61 and 62`

#ASSERT `the loss is paid as a total loss` `actual total loss` FALSE FALSE
#ASSERT NOT `the loss is paid as a total loss` `constructive total loss` FALSE FALSE
#ASSERT `the loss is paid as a total loss` `constructive total loss` TRUE FALSE
#ASSERT `the loss is paid as a total loss` `constructive total loss` FALSE TRUE

#ASSERT `the damaged ship is a constructive total loss` 950000 100000 1000000
#ASSERT NOT `the damaged ship is a constructive total loss` 900000 0 1000000

§ `ss 67, 68, 69, 71 and 81`

#ASSERT `the measure of indemnity for a total loss` TRUE 1000000 800000 EQUALS 1000000
#ASSERT `the measure of indemnity for a total loss` FALSE 1000000 800000 EQUALS 800000

#ASSERT `the measure for goods delivered damaged` 1200000 400000 300000 EQUALS 300000
#ASSERT `the measure for goods delivered damaged` 800000 200000 150000 EQUALS 200000

#ASSERT `the insurer's share` 200000 600000 800000 EQUALS 150000

#ASSERT `the measure for a repaired ship` 500000 50000 2000000 EQUALS 450000
#ASSERT `the measure for a repaired ship` 3000000 0 2000000 EQUALS 2000000

#ASSERT `the measure for a partially repaired ship` 150000 100000 220000 EQUALS 220000

#ASSERT `the measure for an unrepaired ship` 300000 200000 EQUALS 200000

§ `s 84`

#ASSERT `the premium is returnable` `the cargo never sailed`
#ASSERT NOT `the premium is returnable` `insured lost or not lost, already arrived, insurer unaware`
#ASSERT `the premium is returnable` `no insurable interest at any time during the risk`
#ASSERT NOT `the premium is returnable` `avoided for the assured's fraud`
#ASSERT `the premium is returnable` `avoided for innocent non-disclosure before the risk attached`
#ASSERT NOT `the premium is returnable` `avoided for innocent non-disclosure after an indivisible risk attached`

