IMPORT prelude
IMPORT `psa-offences`

-- Postal Services Act 1999, ss 2(2), 4, 5, 19, 23A, 29(7), 31, 33, 34(2), 36, 39E, 39G, 39H(2), 39I, 39J, 51, 52 and 57 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_postal-services-act-1999.py). Expected results were written by
-- hand from the text.

`an ordinary addressed letter` MEANS Item WITH
    `is a written communication` IS TRUE
    `is on a physical medium` IS TRUE
    `weight in grams` IS 20
    `is conveyed electronically` IS FALSE
    `is addressed to a particular addressee or address` IS TRUE
    `is a book, catalogue, newspaper or periodical` IS FALSE

`a 500-gram addressed document` MEANS Item WITH
    `is a written communication` IS TRUE
    `is on a physical medium` IS TRUE
    `weight in grams` IS 500
    `is conveyed electronically` IS FALSE
    `is addressed to a particular addressee or address` IS TRUE
    `is a book, catalogue, newspaper or periodical` IS FALSE

`a 600-gram addressed document` MEANS Item WITH
    `is a written communication` IS TRUE
    `is on a physical medium` IS TRUE
    `weight in grams` IS 600
    `is conveyed electronically` IS FALSE
    `is addressed to a particular addressee or address` IS TRUE
    `is a book, catalogue, newspaper or periodical` IS FALSE

`an addressed catalogue` MEANS Item WITH
    `is a written communication` IS TRUE
    `is on a physical medium` IS TRUE
    `weight in grams` IS 300
    `is conveyed electronically` IS FALSE
    `is addressed to a particular addressee or address` IS TRUE
    `is a book, catalogue, newspaper or periodical` IS TRUE

`an email` MEANS Item WITH
    `is a written communication` IS TRUE
    `is on a physical medium` IS FALSE
    `weight in grams` IS 0
    `is conveyed electronically` IS TRUE
    `is addressed to a particular addressee or address` IS TRUE
    `is a book, catalogue, newspaper or periodical` IS FALSE

`a neighbour carrying 3 letters for free` MEANS Conveyance WITH
