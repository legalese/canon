IMPORT prelude
IMPORT `hpa-supply`

-- Health Products Act 2007, ss 2, 15, 16, 20, 22, 47 and First Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_hpa.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a newspaper running a supplier's ad unawares` MEANS Publisher WITH
    `publishes ads as a business` IS TRUE
    `received it in the ordinary course` IS TRUE
    `has a financial interest in the product` IS FALSE
    `knew or suspected` IS FALSE

`a newspaper that suspected the claims` MEANS Publisher WITH
    `publishes ads as a business` IS TRUE
    `received it in the ordinary course` IS TRUE
    `has a financial interest in the product` IS FALSE
    `knew or suspected` IS TRUE

`a media agency paid commission on sales` MEANS Publisher WITH
    `publishes ads as a business` IS TRUE
    `received it in the ordinary course` IS TRUE
    `has a financial interest in the product` IS TRUE
    `knew or suspected` IS FALSE

`the brand owner posting its own ad` MEANS Publisher WITH
    `publishes ads as a business` IS FALSE
    `received it in the ordinary course` IS FALSE
    `has a financial interest in the product` IS TRUE
    `knew or suspected` IS FALSE

§ `s 2`

#ASSERT `the transfer is a supply` `selling online`
#ASSERT `the transfer is a supply` `giving away free samples`
#ASSERT `the transfer is a supply` `displaying on a shop shelf`
#ASSERT NOT `the transfer is a supply` `keeping for personal use`

§ `s 15, First Schedule`

#ASSERT `supplying it is a section 15 offence` `a therapeutic product` FALSE
#ASSERT `supplying it is a section 15 offence` `a medical device` FALSE
#ASSERT NOT `supplying it is a section 15 offence` `a cosmetic product` FALSE
#ASSERT NOT `supplying it is a section 15 offence` `a therapeutic product` TRUE

§ `s 16`

#ASSERT `the maximum imprisonment in years` `adulterated` EQUALS 3
#ASSERT `the maximum imprisonment in years` `counterfeit` EQUALS 3
#ASSERT `the maximum imprisonment in years` `tampered with` EQUALS 3
#ASSERT `the maximum imprisonment in years` `unwholesome` EQUALS 2

#ASSERT `the seller has the section 16 defence` TRUE TRUE TRUE
#ASSERT NOT `the seller has the section 16 defence` TRUE FALSE TRUE
#ASSERT NOT `the seller has the section 16 defence` TRUE TRUE FALSE
#ASSERT NOT `the seller has the section 16 defence` FALSE TRUE TRUE

§ `ss 20, 22`

#ASSERT `the publisher has the section 22 defence` `a newspaper running a supplier's ad unawares`
#ASSERT NOT `the publisher has the section 22 defence` `a newspaper that suspected the claims`
#ASSERT NOT `the publisher has the section 22 defence` `a media agency paid commission on sales`
#ASSERT NOT `the publisher has the section 22 defence` `the brand owner posting its own ad`

§ `s 47`

#ASSERT `knowing possession is established` TRUE FALSE
#ASSERT NOT `knowing possession is established` TRUE TRUE
#ASSERT NOT `knowing possession is established` FALSE FALSE

