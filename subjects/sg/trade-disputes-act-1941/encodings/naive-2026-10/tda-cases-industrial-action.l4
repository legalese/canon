IMPORT prelude
IMPORT `tda-industrial-action`

-- Trade Disputes Act 1941, ss 2 to 15 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_trade-disputes-act-1941.py). Expected results were written by
-- hand from the text.

§ `s 2`

#ASSERT `the conduct is industrial action` TRUE TRUE TRUE FALSE
#ASSERT `the conduct is industrial action` TRUE TRUE FALSE TRUE
#ASSERT NOT `the conduct is industrial action` TRUE FALSE TRUE FALSE

#ASSERT `it is a trade dispute or work dispute` `employees and employees` TRUE
#ASSERT `it is a trade dispute or work dispute` `employers and employers` TRUE
#ASSERT `it is a trade dispute or work dispute` `platform workers and platform workers` TRUE
#ASSERT NOT `it is a trade dispute or work dispute` `a union and the Government` TRUE

