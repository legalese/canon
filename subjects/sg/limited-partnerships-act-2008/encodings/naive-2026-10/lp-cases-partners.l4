IMPORT prelude
IMPORT `lp-partners`

-- Limited Partnerships Act 2008, ss 3, 5 to 8, 10, 16, 28, 29 and First Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_lp.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a registered passive investor` MEANS Partner WITH
    `agreed to be a limited partner` IS TRUE
    `registered as a limited partner` IS TRUE
    `took part in management` IS FALSE
    `the debt arose while taking part` IS FALSE
    `the creditor dealt with the firm before registration without notice` IS FALSE

`an investor never registered as limited` MEANS Partner WITH
    `agreed to be a limited partner` IS TRUE
    `registered as a limited partner` IS FALSE
    `took part in management` IS FALSE
    `the debt arose while taking part` IS FALSE
    `the creditor dealt with the firm before registration without notice` IS FALSE

`a general partner` MEANS Partner WITH
    `agreed to be a limited partner` IS FALSE
    `registered as a limited partner` IS FALSE
    `took part in management` IS FALSE
    `the debt arose while taking part` IS FALSE
    `the creditor dealt with the firm before registration without notice` IS FALSE

`a registered investor who ran the firm when the debt arose` MEANS Partner WITH
    `agreed to be a limited partner` IS TRUE
    `registered as a limited partner` IS TRUE
    `took part in management` IS TRUE
    `the debt arose while taking part` IS TRUE
    `the creditor dealt with the firm before registration without notice` IS FALSE

`a registered investor sued for a debt from before they meddled` MEANS Partner WITH
    `agreed to be a limited partner` IS TRUE
    `registered as a limited partner` IS TRUE
    `took part in management` IS TRUE
    `the debt arose while taking part` IS FALSE
    `the creditor dealt with the firm before registration without notice` IS FALSE

`a registered investor sued by an old supplier without notice` MEANS Partner WITH
    `agreed to be a limited partner` IS TRUE
    `registered as a limited partner` IS TRUE
    `took part in management` IS FALSE
    `the debt arose while taking part` IS FALSE
    `the creditor dealt with the firm before registration without notice` IS TRUE

`a distribution by an insolvent firm to a knowing investor, bankrupt in 6 months` MEANS Distribution WITH
    `every general partner was or became insolvent` IS TRUE
    `the limited partner knew or ought to have known` IS TRUE
    `every general partner was made bankrupt or wound up` IS TRUE
    `months until the last bankruptcy or winding up` IS 6

`the same but bankruptcy after 14 months` MEANS Distribution WITH
    `every general partner was or became insolvent` IS TRUE
    `the limited partner knew or ought to have known` IS TRUE
    `every general partner was made bankrupt or wound up` IS TRUE
    `months until the last bankruptcy or winding up` IS 14

`the same but the investor could not have known` MEANS Distribution WITH
    `every general partner was or became insolvent` IS TRUE
    `the limited partner knew or ought to have known` IS FALSE
    `every general partner was made bankrupt or wound up` IS TRUE
    `months until the last bankruptcy or winding up` IS 6

`the same but one general partner stays solvent` MEANS Distribution WITH
    `every general partner was or became insolvent` IS TRUE
    `the limited partner knew or ought to have known` IS TRUE
    `every general partner was made bankrupt or wound up` IS FALSE
    `months until the last bankruptcy or winding up` IS 6

§ `ss 3, 10`

#ASSERT NOT `the partner is liable without limit for the debt` `a registered passive investor`
#ASSERT `the partner is liable without limit for the debt` `an investor never registered as limited`
#ASSERT `the partner is liable without limit for the debt` `a general partner`
#ASSERT `the partner is liable without limit for the debt` `a registered investor who ran the firm when the debt arose`
#ASSERT NOT `the partner is liable without limit for the debt` `a registered investor sued for a debt from before they meddled`
#ASSERT `the partner is liable without limit for the debt` `a registered investor sued by an old supplier without notice`

#ASSERT `the firm can be a limited partnership` 1 1
#ASSERT NOT `the firm can be a limited partnership` 2 0
#ASSERT NOT `the firm can be a limited partnership` 0 3

§ `s 6 and First Schedule`

#ASSERT NOT `the activity is a safe harbour` `negotiating contracts with suppliers for the firm`
#ASSERT NOT `the activity is a safe harbour` `signing cheques for the firm`
#ASSERT `the activity is a safe harbour` `voting to remove a general partner`
#ASSERT `the activity is a safe harbour` `guaranteeing the firm's bank loan`
#ASSERT `the activity is a safe harbour` `advising the general partner on strategy`
#ASSERT `the activity is a safe harbour` `being a director of the corporate general partner`
#ASSERT `the activity is a safe harbour` `having their name in the firm's name`
#ASSERT `the activity is a safe harbour` `suing after the general partners refused without good cause`

§ `s 7`

#ASSERT `the limited partner must refund the distribution` `a distribution by an insolvent firm to a knowing investor, bankrupt in 6 months`
#ASSERT NOT `the limited partner must refund the distribution` `the same but bankruptcy after 14 months`
#ASSERT NOT `the limited partner must refund the distribution` `the same but the investor could not have known`
#ASSERT NOT `the limited partner must refund the distribution` `the same but one general partner stays solvent`

§ `s 8`

#ASSERT NOT `the event dissolves the partnership` `a limited partner gives notice to dissolve` FALSE
#ASSERT NOT `the event dissolves the partnership` `a limited partner dies` FALSE
#ASSERT NOT `the event dissolves the partnership` `a limited partner becomes bankrupt` FALSE
#ASSERT `the event dissolves the partnership` `a general partner dies` FALSE
#ASSERT `the event dissolves the partnership` `a general partner gives notice to dissolve` FALSE
#ASSERT `the event dissolves the partnership` `a limited partner dies` TRUE

§ `ss 16, 28, 29`

#ASSERT `the name complies` TRUE
#ASSERT NOT `the name complies` FALSE

#ASSERT `the Registrar may require a local manager` 2 2
#ASSERT NOT `the Registrar may require a local manager` 1 2

#ASSERT `managing the firm is an offence` TRUE FALSE
#ASSERT NOT `managing the firm is an offence` TRUE TRUE
#ASSERT NOT `managing the firm is an offence` FALSE FALSE

