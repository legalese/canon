#ASSERT `Dieu 26: the party has the right to terminate on the ground` `premium not paid, or not paid in full, by the agreed time or after the grace period` `the insurer`
#ASSERT NOT `Dieu 26: the party has the right to terminate on the ground` `premium not paid, or not paid in full, by the agreed time or after the grace period` `the policyholder`
#ASSERT `Dieu 26: the party has the right to terminate on the ground` `a request to change the insured risk under Dieu 23 was not accepted` `the insurer`
#ASSERT `Dieu 26: the party has the right to terminate on the ground` `a request to change the insured risk under Dieu 23 was not accepted` `the policyholder`
#ASSERT `Dieu 26: the party has the right to terminate on the ground` `the insured person did not take the safety measures of Dieu 55(3)` `the insurer`
#ASSERT NOT `Dieu 26: the party has the right to terminate on the ground` `the insured person did not take the safety measures of Dieu 55(3)` `the policyholder`
#ASSERT `Dieu 26: the party has the right to terminate on the ground` `the policyholder did not agree to the transfer of the portfolio under Dieu 92(4)` `the policyholder`
#ASSERT NOT `Dieu 26: the party has the right to terminate on the ground` `the policyholder did not agree to the transfer of the portfolio under Dieu 92(4)` `the insurer`

`termination for non-payment, event before` MEANS `A unilateral termination` WITH
    `ground` IS `premium not paid, or not paid in full, by the agreed time or after the grace period`
    `terminating party` IS `the insurer`
    `date of termination` IS YMD 2000 1 1
    `insured event occurred before termination` IS TRUE
    `premium paid for the whole period up to termination` IS 0
    `premium paid for the period after termination` IS 0
    `premium due up to termination` IS 2_000_000
    `surrender value` IS 3_000_000
    `the parties agreed otherwise on the surrender value` IS FALSE
    `the contract has a surrender value` IS TRUE
    `value of the transferred assets` IS 0
    `technical reserve of the transferred portfolio` IS 0
`termination for non-payment, no event` MEANS `A unilateral termination` WITH
    `ground` IS `premium not paid, or not paid in full, by the agreed time or after the grace period`
    `terminating party` IS `the insurer`
    `date of termination` IS YMD 2000 1 1
    `insured event occurred before termination` IS FALSE
    `premium paid for the whole period up to termination` IS 0
    `premium paid for the period after termination` IS 0
    `premium due up to termination` IS 0
    `surrender value` IS 3_000_000
    `the parties agreed otherwise on the surrender value` IS FALSE
    `the contract has a surrender value` IS TRUE
    `value of the transferred assets` IS 0
    `technical reserve of the transferred portfolio` IS 0
`termination after a refused request` MEANS `A unilateral termination` WITH
    `ground` IS `a request to change the insured risk under Dieu 23 was not accepted`
    `terminating party` IS `the policyholder`
    `date of termination` IS YMD 2000 1 1
    `insured event occurred before termination` IS TRUE
    `premium paid for the whole period up to termination` IS 0
    `premium paid for the period after termination` IS 700_000
    `premium due up to termination` IS 0
    `surrender value` IS 3_000_000
    `the parties agreed otherwise on the surrender value` IS FALSE
    `the contract has a surrender value` IS TRUE
    `value of the transferred assets` IS 0
    `technical reserve of the transferred portfolio` IS 0
`termination after a refused request, other value agreed` MEANS `A unilateral termination` WITH
    `ground` IS `a request to change the insured risk under Dieu 23 was not accepted`
    `terminating party` IS `the policyholder`
    `date of termination` IS YMD 2000 1 1
    `insured event occurred before termination` IS FALSE
    `premium paid for the whole period up to termination` IS 0
    `premium paid for the period after termination` IS 0
    `premium due up to termination` IS 0
    `surrender value` IS 3_000_000
    `the parties agreed otherwise on the surrender value` IS TRUE
    `the contract has a surrender value` IS TRUE
    `value of the transferred assets` IS 0
    `technical reserve of the transferred portfolio` IS 0
`termination for unsafe property` MEANS `A unilateral termination` WITH
