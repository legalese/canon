#ASSERT `an offence under section 6(a) is made out` f6a gOffice agServing FALSE
-- accused not an agent
#ASSERT NOT (`an offence under section 6(a) is made out` f6a gMoney agNone FALSE)
-- subcontractor not an agent for s 6
#ASSERT NOT (`an offence under section 6(a) is made out` f6a gMoney agSub FALSE)
#ASSERT NOT (`an offence under section 6(a) is made out` f6aNotCorrupt gMoney agEmployee FALSE)
#ASSERT `an offence under section 6(a) is made out` f6aNotCorrupt gMoney agEmployee (`the presumption of section 8 operates` pDirect agNone)
#ASSERT NOT (`an offence under section 6(a) is made out` f6aNoPurpose gMoney agEmployee FALSE)
#ASSERT NOT (`an offence under section 6(a) is made out` f6a gNone agEmployee FALSE)
#ASSERT `an offence under section 6(b) is made out` f6b gMoney agEmployee FALSE
-- recipient not an agent
#ASSERT NOT (`an offence under section 6(b) is made out` f6b gMoney agNone FALSE)
#ASSERT NOT (`an offence under section 6(b) is made out` f6aNotCorrupt gMoney agEmployee FALSE)
#ASSERT `an offence under section 6(c) is made out` f6cGive agNone agEmployee
#ASSERT `an offence under section 6(c) is made out` f6cUse agEmployee agNone
-- user not an agent
#ASSERT NOT (`an offence under section 6(c) is made out` f6cUse agNone agNone)
-- recipient not an agent
#ASSERT NOT (`an offence under section 6(c) is made out` f6cGive agNone agNone)
#ASSERT NOT (`an offence under section 6(c) is made out` f6cNoMislead agNone agEmployee)
#ASSERT NOT (`an offence under section 6(c) is made out` f6cNoFalse agNone agEmployee)
#ASSERT NOT (`an offence under section 6(c) is made out` f6cNoInterest agNone agEmployee)
#ASSERT NOT (`an offence under section 6(c) is made out` f6cNotKnowing agNone agEmployee)
GIVETH A `Government Contract Facts`
cNone MEANS
    `Government Contract Facts` WITH
        `the matter or transaction was a contract or a proposal for a contract with the Government or any department of the Government` IS FALSE
        `the matter or transaction was a contract or a proposal for a contract with a public body` IS FALSE
        `the matter or transaction was a subcontract to execute work comprised in such a contract` IS FALSE

GIVETH A `Government Contract Facts`
cGov MEANS
    `Government Contract Facts` WITH
        `the matter or transaction was a contract or a proposal for a contract with the Government or any department of the Government` IS TRUE
        `the matter or transaction was a contract or a proposal for a contract with a public body` IS FALSE
        `the matter or transaction was a subcontract to execute work comprised in such a contract` IS FALSE

GIVETH A `Government Contract Facts`
cPub MEANS
    `Government Contract Facts` WITH
        `the matter or transaction was a contract or a proposal for a contract with the Government or any department of the Government` IS FALSE
        `the matter or transaction was a contract or a proposal for a contract with a public body` IS TRUE
        `the matter or transaction was a subcontract to execute work comprised in such a contract` IS FALSE

GIVETH A `Government Contract Facts`
cSub MEANS
    `Government Contract Facts` WITH
        `the matter or transaction was a contract or a proposal for a contract with the Government or any department of the Government` IS FALSE
        `the matter or transaction was a contract or a proposal for a contract with a public body` IS FALSE
        `the matter or transaction was a subcontract to execute work comprised in such a contract` IS TRUE


