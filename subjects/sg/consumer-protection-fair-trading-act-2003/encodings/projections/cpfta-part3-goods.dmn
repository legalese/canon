<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_part_3_additional_consumer_rights_in_respect_of_non_conforming_goods" name="Part 3 -- Additional consumer rights in respect of non-conforming goods" namespace="https://legalese.com/l4/dmn/part_3_additional_consumer_rights_in_respect_of_non_conforming_goods" exporter="jl4">
  <inputData id="input_g" name="g">
    <variable id="input_g_var" name="g" typeRef="Any"/>
  </inputData>
  <inputData id="input_the_provision_is_the_definition_of_consumer_or_goods_in_section_2_1" name="the_provision_is_the_definition_of_consumer_or_goods_in_section_2_1" label="the provision is the definition of consumer or goods in section 2(1)">
    <variable id="input_the_provision_is_the_definition_of_consumer_or_goods_in_section_2_1_var" name="the_provision_is_the_definition_of_consumer_or_goods_in_section_2_1" label="the provision is the definition of consumer or goods in section 2(1)" typeRef="boolean"/>
  </inputData>
  <inputData id="input_the_provision_is_section_2_2" name="the_provision_is_section_2_2" label="the provision is section 2(2)">
    <variable id="input_the_provision_is_section_2_2_var" name="the_provision_is_section_2_2" label="the provision is section 2(2)" typeRef="boolean"/>
  </inputData>
  <inputData id="input_the_provision_is_in_part_4" name="the_provision_is_in_Part_4" label="the provision is in Part 4">
    <variable id="input_the_provision_is_in_part_4_var" name="the_provision_is_in_Part_4" label="the provision is in Part 4" typeRef="boolean"/>
  </inputData>
  <inputData id="input_c" name="c">
    <variable id="input_c_var" name="c" typeRef="Any"/>
  </inputData>
  <inputData id="input_the_transferee_rescinds_the_contract" name="the_transferee_rescinds_the_contract" label="the transferee rescinds the contract">
    <variable id="input_the_transferee_rescinds_the_contract_var" name="the_transferee_rescinds_the_contract" label="the transferee rescinds the contract" typeRef="boolean"/>
  </inputData>
  <inputData id="input_the_transferee_has_had_use_of_the_goods_since_they_were_delivered" name="the_transferee_has_had_use_of_the_goods_since_they_were_delivered" label="the transferee has had use of the goods since they were delivered">
    <variable id="input_the_transferee_has_had_use_of_the_goods_since_they_were_delivered_var" name="the_transferee_has_had_use_of_the_goods_since_they_were_delivered" label="the transferee has had use of the goods since they were delivered" typeRef="boolean"/>
  </inputData>
  <inputData id="input_p" name="p">
    <variable id="input_p_var" name="p" typeRef="Any"/>
  </inputData>
  <decision id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part" name="the_transferee_deals_as_consumer_for_the_purposes_of_this_Part" label="the transferee deals as consumer for the purposes of this Part">
    <variable id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_var" name="the_transferee_deals_as_consumer_for_the_purposes_of_this_Part" label="the transferee deals as consumer for the purposes of this Part" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_ir1">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <decisionTable id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_table" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row" outputLabel="the transferee deals as consumer for the purposes of this Part">
      <input id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_i1" label="g&apos;s `the transferor claims that the transferee does not deal as consumer`">
        <inputExpression id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_i1_expr" typeRef="boolean">
          <text>g.the_transferor_claims_that_the_transferee_does_not_deal_as_consumer</text>
        </inputExpression>
      </input>
      <output id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_o1">
        <defaultOutputEntry id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_o1_default">
          <text>g.the_transferee_deals_as_consumer_under_Part_1_of_the_Unfair_Contract_Terms_Act_1977</text>
        </defaultOutputEntry>
      </output>
      <rule id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_r1">
        <description>g's `the transferor claims that the transferee does not deal as consumer`</description>
        <inputEntry id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_r1_i1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part_r1_o1">
          <text>not(g.the_transferor_has_shown_that_the_transferee_does_not_deal_as_consumer)</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_the_goods_do_not_conform_to_the_applicable_contract" name="the_goods_do_not_conform_to_the_applicable_contract" label="the goods do not conform to the applicable contract">
    <variable id="decision_the_goods_do_not_conform_to_the_applicable_contract_var" name="the_goods_do_not_conform_to_the_applicable_contract" label="the goods do not conform to the applicable contract" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_do_not_conform_to_the_applicable_contract_ir1">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_do_not_conform_to_the_applicable_contract_literal">
      <text>g's `there is a breach of an express term of the contract in relation to the goods` OR (CONSIDER g's `kind of contract` WHEN `a contract of sale of goods` THEN g's `there is a breach of a term implied by section 13, 14 or 15 of the Sale of Goods Act 1979` WHEN `a contract for the transfer of goods` THEN g's `there is a breach of a term implied by section 3, 4 or 5 of the Supply of Goods Act 1982` WHEN `a hire-purchase agreement` THEN g's `there is a breach of a term implied by section 6A, 6B or 6C of the Hire-Purchase Act 1969`)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_provision_applies_to_this_part" name="the_provision_applies_to_this_Part" label="the provision applies to this Part">
    <variable id="decision_the_provision_applies_to_this_part_var" name="the_provision_applies_to_this_Part" label="the provision applies to this Part" typeRef="boolean"/>
    <informationRequirement id="decision_the_provision_applies_to_this_part_ir1">
      <requiredInput href="#input_the_provision_is_in_part_4"/>
    </informationRequirement>
    <informationRequirement id="decision_the_provision_applies_to_this_part_ir2">
      <requiredInput href="#input_the_provision_is_section_2_2"/>
    </informationRequirement>
    <informationRequirement id="decision_the_provision_applies_to_this_part_ir3">
      <requiredInput href="#input_the_provision_is_the_definition_of_consumer_or_goods_in_section_2_1"/>
    </informationRequirement>
    <literalExpression id="decision_the_provision_applies_to_this_part_literal">
      <text>not(the_provision_is_the_definition_of_consumer_or_goods_in_section_2_1) and (not(the_provision_is_section_2_2) and not(the_provision_is_in_Part_4))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_lack_of_conformity_appeared_within_6_months_after_delivery" name="the_lack_of_conformity_appeared_within_6_months_after_delivery" label="the lack of conformity appeared within 6 months after delivery">
    <variable id="decision_the_lack_of_conformity_appeared_within_6_months_after_delivery_var" name="the_lack_of_conformity_appeared_within_6_months_after_delivery" label="the lack of conformity appeared within 6 months after delivery" typeRef="boolean"/>
    <informationRequirement id="decision_the_lack_of_conformity_appeared_within_6_months_after_delivery_ir1">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_lack_of_conformity_appeared_within_6_months_after_delivery_literal">
      <text>if g.the_date_on_which_the_lack_of_conformity_appeared != null then g.the_date_on_which_the_lack_of_conformity_appeared &gt; g.the_goods_were_delivered_on and g.the_date_on_which_the_lack_of_conformity_appeared &lt;= g.the_goods_were_delivered_on + duration("P6M") else false</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery" name="the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery" label="the goods are taken not to have conformed at the date of delivery">
    <variable id="decision_the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery_var" name="the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery" label="the goods are taken not to have conformed at the date of delivery" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery_ir1">
      <requiredDecision href="#decision_the_lack_of_conformity_appeared_within_6_months_after_delivery"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery_ir2">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery_literal">
      <text>the_lack_of_conformity_appeared_within_6_months_after_delivery and (not(g.it_is_established_that_the_goods_did_conform_at_the_date_of_delivery) and not(g.applying_the_presumption_is_incompatible_with_the_nature_of_the_goods_or_the_nature_of_the_lack_of_conformity))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery" name="the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery" label="the goods do not conform to the applicable contract at the time of delivery">
    <variable id="decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery_var" name="the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery" label="the goods do not conform to the applicable contract at the time of delivery" typeRef="boolean"/>
    <informationRequirement id="decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery_ir1">
      <requiredDecision href="#decision_the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery_ir2">
      <requiredDecision href="#decision_the_goods_do_not_conform_to_the_applicable_contract"/>
    </informationRequirement>
    <informationRequirement id="decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery_ir3">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery_literal">
      <text>the_goods_do_not_conform_to_the_applicable_contract and (g.the_lack_of_conformity_is_shown_to_have_existed_at_the_time_of_delivery or the_goods_are_taken_not_to_have_conformed_at_the_date_of_delivery)</text>
    </literalExpression>
  </decision>
  <decision id="decision_this_part_applies" name="this_Part_applies" label="this Part applies">
    <variable id="decision_this_part_applies_var" name="this_Part_applies" label="this Part applies" typeRef="boolean"/>
    <informationRequirement id="decision_this_part_applies_ir1">
      <requiredDecision href="#decision_the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery"/>
    </informationRequirement>
    <informationRequirement id="decision_this_part_applies_ir2">
      <requiredDecision href="#decision_the_transferee_deals_as_consumer_for_the_purposes_of_this_part"/>
    </informationRequirement>
    <informationRequirement id="decision_this_part_applies_ir3">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_this_part_applies_literal">
      <text>the_transferee_deals_as_consumer_for_the_purposes_of_this_Part and (the_goods_do_not_conform_to_the_applicable_contract_at_the_time_of_delivery and g.the_contract_was_made_on &gt;= date("2012-09-01"))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods" name="the_transferee_may_require_the_transferor_to_repair_the_goods" label="the transferee may require the transferor to repair the goods">
    <variable id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods_var" name="the_transferee_may_require_the_transferor_to_repair_the_goods" label="the transferee may require the transferor to repair the goods" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods_ir1">
      <requiredDecision href="#decision_this_part_applies"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods_ir2">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods_ir3">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods_kr1">
      <requiredKnowledge href="#bkm_the_transferee_may_require_the_remedy"/>
    </knowledgeRequirement>
    <literalExpression id="decision_the_transferee_may_require_the_transferor_to_repair_the_goods_literal">
      <text>this_Part_applies and the_transferee_may_require_the_remedy(r: c.facts_of_repair)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods" name="the_transferee_may_require_the_transferor_to_replace_the_goods" label="the transferee may require the transferor to replace the goods">
    <variable id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods_var" name="the_transferee_may_require_the_transferor_to_replace_the_goods" label="the transferee may require the transferor to replace the goods" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods_ir1">
      <requiredDecision href="#decision_this_part_applies"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods_ir2">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods_ir3">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods_kr1">
      <requiredKnowledge href="#bkm_the_transferee_may_require_the_remedy"/>
    </knowledgeRequirement>
    <literalExpression id="decision_the_transferee_may_require_the_transferor_to_replace_the_goods_literal">
      <text>this_Part_applies and the_transferee_may_require_the_remedy(r: c.facts_of_replacement)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferor_has_met_the_requirement_of_section_15_2_a" name="the_transferor_has_met_the_requirement_of_section_15_2_a" label="the transferor has met the requirement of section 15(2)(a)">
    <variable id="decision_the_transferor_has_met_the_requirement_of_section_15_2_a_var" name="the_transferor_has_met_the_requirement_of_section_15_2_a" label="the transferor has met the requirement of section 15(2)(a)" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferor_has_met_the_requirement_of_section_15_2_a_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_transferor_has_met_the_requirement_of_section_15_2_a_literal">
      <text>not(c.the_transferee_requires_the_transferor_to_repair_or_replace) or c.the_transferor_repaired_or_replaced_the_goods_within_a_reasonable_time_and_without_causing_significant_inconvenience_to_the_transferee</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferor_must_bear_the_necessary_costs_of_the_repair_or_replacement" name="the_transferor_must_bear_the_necessary_costs_of_the_repair_or_replacement" label="the transferor must bear the necessary costs of the repair or replacement">
    <variable id="decision_the_transferor_must_bear_the_necessary_costs_of_the_repair_or_replacement_var" name="the_transferor_must_bear_the_necessary_costs_of_the_repair_or_replacement" label="the transferor must bear the necessary costs of the repair or replacement" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferor_must_bear_the_necessary_costs_of_the_repair_or_replacement_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_transferor_must_bear_the_necessary_costs_of_the_repair_or_replacement_literal">
      <text>c.the_transferee_requires_the_transferor_to_repair_or_replace</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferee_may_require_neither_repair_nor_replacement" name="the_transferee_may_require_neither_repair_nor_replacement" label="the transferee may require neither repair nor replacement">
    <variable id="decision_the_transferee_may_require_neither_repair_nor_replacement_var" name="the_transferee_may_require_neither_repair_nor_replacement" label="the transferee may require neither repair nor replacement" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferee_may_require_neither_repair_nor_replacement_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <knowledgeRequirement id="decision_the_transferee_may_require_neither_repair_nor_replacement_kr1">
      <requiredKnowledge href="#bkm_the_transferee_may_require_the_remedy"/>
    </knowledgeRequirement>
    <literalExpression id="decision_the_transferee_may_require_neither_repair_nor_replacement_literal">
      <text>not(the_transferee_may_require_the_remedy(r: c.facts_of_repair)) and not(the_transferee_may_require_the_remedy(r: c.facts_of_replacement))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_condition_in_section_16_2_is_satisfied" name="the_condition_in_section_16_2_is_satisfied" label="the condition in section 16(2) is satisfied">
    <variable id="decision_the_condition_in_section_16_2_is_satisfied_var" name="the_condition_in_section_16_2_is_satisfied" label="the condition in section 16(2) is satisfied" typeRef="boolean"/>
    <informationRequirement id="decision_the_condition_in_section_16_2_is_satisfied_ir1">
      <requiredDecision href="#decision_the_transferee_may_require_neither_repair_nor_replacement"/>
    </informationRequirement>
    <informationRequirement id="decision_the_condition_in_section_16_2_is_satisfied_ir2">
      <requiredDecision href="#decision_the_transferor_has_met_the_requirement_of_section_15_2_a"/>
    </informationRequirement>
    <informationRequirement id="decision_the_condition_in_section_16_2_is_satisfied_ir3">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <informationRequirement id="decision_the_condition_in_section_16_2_is_satisfied_ir4">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_condition_in_section_16_2_is_satisfied_literal">
      <text>the_transferee_may_require_neither_repair_nor_replacement or c.the_transferee_requires_the_transferor_to_repair_or_replace and not(the_transferor_has_met_the_requirement_of_section_15_2_a)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract" name="the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract" label="the transferee may require a reduction in the amount to be paid or rescind the contract">
    <variable id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract_var" name="the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract" label="the transferee may require a reduction in the amount to be paid or rescind the contract" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract_ir1">
      <requiredDecision href="#decision_the_condition_in_section_16_2_is_satisfied"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract_ir2">
      <requiredDecision href="#decision_this_part_applies"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract_ir3">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <informationRequirement id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract_ir4">
      <requiredInput href="#input_g"/>
    </informationRequirement>
    <literalExpression id="decision_the_transferee_may_require_a_reduction_in_the_amount_to_be_paid_or_rescind_the_contract_literal">
      <text>this_Part_applies and the_condition_in_section_16_2_is_satisfied</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods" name="the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods" label="the reimbursement may be reduced to take account of the use the transferee has had of the goods">
    <variable id="decision_the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods_var" name="the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods" label="the reimbursement may be reduced to take account of the use the transferee has had of the goods" typeRef="boolean"/>
    <informationRequirement id="decision_the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods_ir1">
      <requiredInput href="#input_the_transferee_has_had_use_of_the_goods_since_they_were_delivered"/>
    </informationRequirement>
    <informationRequirement id="decision_the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods_ir2">
      <requiredInput href="#input_the_transferee_rescinds_the_contract"/>
    </informationRequirement>
    <literalExpression id="decision_the_reimbursement_may_be_reduced_to_take_account_of_the_use_the_transferee_has_had_of_the_goods_literal">
      <text>the_transferee_rescinds_the_contract and the_transferee_has_had_use_of_the_goods_since_they_were_delivered</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_transferee_has_acted_before_giving_the_transferor_a_reasonable_time" name="the_transferee_has_acted_before_giving_the_transferor_a_reasonable_time" label="the transferee has acted before giving the transferor a reasonable time">
    <variable id="decision_the_transferee_has_acted_before_giving_the_transferor_a_reasonable_time_var" name="the_transferee_has_acted_before_giving_the_transferor_a_reasonable_time" label="the transferee has acted before giving the transferor a reasonable time" typeRef="boolean"/>
    <informationRequirement id="decision_the_transferee_has_acted_before_giving_the_transferor_a_reasonable_time_ir1">
      <requiredInput href="#input_c"/>
    </informationRequirement>
    <literalExpression id="decision_the_transferee_has_acted_before_giving_the_transferor_a_reasonable_time_literal">
      <text>c.the_transferee_requires_the_transferor_to_repair_or_replace and ((c.the_transferee_rejects_the_goods_and_terminates_the_contract_for_breach_of_condition or c.the_transferee_having_required_repair_or_replacement_further_requires_the_goods_to_be_repaired_or_replaced_by_the_other_remedy) and not(c.the_transferee_has_given_the_transferor_a_reasonable_time_in_which_to_repair_or_replace))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_order_specific_performance_of_an_obligation_under_section_15" name="the_court_may_order_specific_performance_of_an_obligation_under_section_15" label="the court may order specific performance of an obligation under section 15">
    <variable id="decision_the_court_may_order_specific_performance_of_an_obligation_under_section_15_var" name="the_court_may_order_specific_performance_of_an_obligation_under_section_15" label="the court may order specific performance of an obligation under section 15" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_order_specific_performance_of_an_obligation_under_section_15_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_order_specific_performance_of_an_obligation_under_section_15_literal">
      <text>p.proceedings_in_which_a_remedy_is_sought_under_Part_3 and p.the_transferee_applies_for_specific_performance_of_an_obligation_imposed_on_the_transferor_by_section_15</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_proceed_as_if_the_transferee_had_required_the_other_remedy" name="the_court_may_proceed_as_if_the_transferee_had_required_the_other_remedy" label="the court may proceed as if the transferee had required the other remedy">
    <variable id="decision_the_court_may_proceed_as_if_the_transferee_had_required_the_other_remedy_var" name="the_court_may_proceed_as_if_the_transferee_had_required_the_other_remedy" label="the court may proceed as if the transferee had required the other remedy" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_proceed_as_if_the_transferee_had_required_the_other_remedy_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_proceed_as_if_the_transferee_had_required_the_other_remedy_literal">
      <text>p.proceedings_in_which_a_remedy_is_sought_under_Part_3 and (p.the_transferee_requires_the_transferor_to_give_effect_to_a_remedy_under_section_15_or_16_or_claims_to_rescind_under_section_16 and p.the_court_decides_that_another_remedy_under_section_15_or_16_is_appropriate)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_order_that_the_reimbursement_be_reduced_to_take_account_of_the_use" name="the_court_may_order_that_the_reimbursement_be_reduced_to_take_account_of_the_use" label="the court may order that the reimbursement be reduced to take account of the use">
    <variable id="decision_the_court_may_order_that_the_reimbursement_be_reduced_to_take_account_of_the_use_var" name="the_court_may_order_that_the_reimbursement_be_reduced_to_take_account_of_the_use" label="the court may order that the reimbursement be reduced to take account of the use" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_order_that_the_reimbursement_be_reduced_to_take_account_of_the_use_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_order_that_the_reimbursement_be_reduced_to_take_account_of_the_use_literal">
      <text>p.proceedings_in_which_a_remedy_is_sought_under_Part_3 and p.the_transferee_has_claimed_to_rescind_the_contract</text>
    </literalExpression>
  </decision>
  <decision id="decision_a_small_claims_tribunal_may_act_under_section_18" name="a_Small_Claims_Tribunal_may_act_under_section_18" label="a Small Claims Tribunal may act under section 18">
    <variable id="decision_a_small_claims_tribunal_may_act_under_section_18_var" name="a_Small_Claims_Tribunal_may_act_under_section_18" label="a Small Claims Tribunal may act under section 18" typeRef="boolean"/>
    <informationRequirement id="decision_a_small_claims_tribunal_may_act_under_section_18_ir1">
      <requiredInput href="#input_p"/>
    </informationRequirement>
    <literalExpression id="decision_a_small_claims_tribunal_may_act_under_section_18_literal">
      <text>p.the_tribunal_is_a_Small_Claims_Tribunal_acting_within_its_jurisdiction_under_section_5_of_the_Small_Claims_Tribunals_Act_1984</text>
    </literalExpression>
  </decision>
  <businessKnowledgeModel id="bkm_the_transferee_may_require_the_remedy" name="the_transferee_may_require_the_remedy" label="the transferee may require the remedy">
    <variable id="bkm_the_transferee_may_require_the_remedy_var" name="the_transferee_may_require_the_remedy" label="the transferee may require the remedy" typeRef="boolean"/>
    <encapsulatedLogic id="bkm_the_transferee_may_require_the_remedy_logic">
      <formalParameter id="bkm_the_transferee_may_require_the_remedy_p1" name="r" typeRef="Any"/>
      <literalExpression id="bkm_the_transferee_may_require_the_remedy_literal">
        <text>not(r.the_remedy_is_impossible) and (not(r.the_remedy_imposes_on_the_transferor_costs_that_are_unreasonable_in_comparison_with_those_imposed_by_the_other_remedy_taking_into_account_the_value_the_goods_would_have_if_they_conformed_the_significance_of_the_lack_of_conformity_and_whether_the_other_remedy_could_be_effected_without_significant_inconvenience) and not(r.the_remedy_imposes_on_the_transferor_costs_that_are_unreasonable_in_comparison_with_those_imposed_by_an_appropriate_reduction_in_the_amount_to_be_paid_or_by_rescission_taking_into_account_the_same_three_matters))</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
