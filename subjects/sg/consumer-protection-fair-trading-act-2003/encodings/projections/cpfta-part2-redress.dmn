    </informationRequirement>
    <literalExpression id="decision_the_court_must_have_regard_to_the_consumer_s_efforts_to_minimise_loss_and_to_resolve_the_dispute_literal">
      <text>g.the_court_finds_that_an_unfair_practice_has_occurred and g.the_court_is_making_an_order_in_an_action_under_section_6_1</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_must_consider_whether_the_consumer_sought_to_resolve_the_dispute_through_the_specified_scheme" name="the_court_must_consider_whether_the_consumer_sought_to_resolve_the_dispute_through_the_specified_scheme" label="the court must consider whether the consumer sought to resolve the dispute through the specified scheme">
