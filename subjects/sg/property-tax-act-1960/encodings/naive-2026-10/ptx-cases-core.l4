IMPORT prelude
IMPORT `ptx-core`

-- Property Tax Act 1960, ss 6, 9, 19, 20A, 29, 35A, 36 and 47 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_ptx.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a temple used only for worship` MEANS Use WITH
    `used exclusively for worship, a grant-aided school, charity or social development` IS TRUE
    `also used partly for commercial letting` IS FALSE

`a temple letting a hall commercially` MEANS Use WITH
    `used exclusively for worship, a grant-aided school, charity or social development` IS TRUE
    `also used partly for commercial letting` IS TRUE

`an ordinary office` MEANS Use WITH
    `used exclusively for worship, a grant-aided school, charity or social development` IS FALSE
    `also used partly for commercial letting` IS FALSE

`an objection to the annual value in March` MEANS Objection WITH
    `against an amendment under section 20` IS FALSE
    `days since the amendment notice` IS 0
    `made in the year the value applies` IS TRUE

`an objection to last year's value` MEANS Objection WITH
    `against an amendment under section 20` IS FALSE
    `days since the amendment notice` IS 0
    `made in the year the value applies` IS FALSE

`an objection 20 days after an amendment` MEANS Objection WITH
    `against an amendment under section 20` IS TRUE
    `days since the amendment notice` IS 20
    `made in the year the value applies` IS FALSE

`an objection 40 days after an amendment` MEANS Objection WITH
    `against an amendment under section 20` IS TRUE
    `days since the amendment notice` IS 40
    `made in the year the value applies` IS FALSE

§ `ss 6, 9 -- the charge`

#ASSERT `the statutory rate` EQUALS 0.36
#ASSERT `the tax for the year` 100000 0.36 FALSE EQUALS 36000
#ASSERT `the tax for the year` 100000 0.36 TRUE EQUALS 0
#ASSERT `the tax for the year` 18 0.36 FALSE EQUALS 0
#ASSERT `the tax for the year` 19 0.36 FALSE EQUALS 6.84
#ASSERT `the tax for the year` 30000 0.04 FALSE EQUALS 1200

#ASSERT `the building or part is exempt under section 6(6)` `a temple used only for worship`
#ASSERT NOT `the building or part is exempt under section 6(6)` `a temple letting a hall commercially`
#ASSERT NOT `the building or part is exempt under section 6(6)` `an ordinary office`

§ `s 6(10), (11) -- deduction from rent`

#ASSERT `the deduction the owner may make` 3600 2000 10000 FALSE EQUALS 720
#ASSERT `the deduction the owner may make` 3600 2000 10000 TRUE EQUALS 0
#ASSERT `the deduction the owner may make` 3600 0 10000 FALSE EQUALS 0

§ `ss 19, 47 -- the seller`

#ASSERT `the seller remains liable for the tax` TRUE
#ASSERT NOT `the seller remains liable for the tax` FALSE

#ASSERT `the seller is late with the notice` 31 FALSE
#ASSERT NOT `the seller is late with the notice` 30 FALSE
#ASSERT NOT `the seller is late with the notice` 90 TRUE

#ASSERT `the Comptroller may tax the demolished building as standing` TRUE FALSE TRUE
#ASSERT `the Comptroller may tax the demolished building as standing` TRUE FALSE FALSE
#ASSERT NOT `the Comptroller may tax the demolished building as standing` TRUE TRUE TRUE
#ASSERT NOT `the Comptroller may tax the demolished building as standing` FALSE FALSE FALSE

§ `ss 20A, 29 -- objections and appeals`

#ASSERT `the objection is in time` `an objection to the annual value in March`
#ASSERT NOT `the objection is in time` `an objection to last year's value`
#ASSERT `the objection is in time` `an objection 20 days after an amendment`
#ASSERT NOT `the objection is in time` `an objection 40 days after an amendment`

#ASSERT `an appeal to the Valuation Review Board lies` `disallowed` 10 FALSE
#ASSERT NOT `an appeal to the Valuation Review Board lies` `allowed in whole` 10 FALSE
#ASSERT `an appeal to the Valuation Review Board lies` `allowed in part` 10 FALSE
#ASSERT NOT `an appeal to the Valuation Review Board lies` `allowed as agreed` 10 FALSE
#ASSERT NOT `an appeal to the Valuation Review Board lies` `disallowed` 45 FALSE
#ASSERT `an appeal to the Valuation Review Board lies` `disallowed` 45 TRUE

§ `ss 35A, 36, 6(15)`

#ASSERT `the tax must still be paid on time` TRUE
#ASSERT `the tax must still be paid on time` FALSE

#ASSERT `the maximum late-payment penalty` 10000 EQUALS 500
#ASSERT `the maximum late-payment penalty` 1234 EQUALS 61.7

#ASSERT `the refund claim is in time` 5
#ASSERT NOT `the refund claim is in time` 6

