{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/reference-set.schema.json",
  "title": "Jurisdiction reference set (0H)",
  "description": "The jurisdiction's drafting manuals, style guides, interpretation legislation and other meta-legislation, and its library of encoded provisions. Lives at <jurisdiction>/_jurisdiction/reference-set.json. The confirmation is a human's.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "jurisdiction",
    "items",
    "library"
  ],
  "properties": {
    "kind": {
      "const": "reference-set"
    },
    "version": {
      "const": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "library": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "confirmed": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "version",
        "retrieved",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "drafting-manual",
            "style-guide",
            "plain-language",
            "interpretation",
            "meta-legislation",
            "constitution",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "local_path": {
          "description": "relative to the _jurisdiction folder",
          "type": "string"
        },
        "no_copy_reason": {
          "description": "required when there is no sha256: why no copy is held",
          "type": "string"
        },
        "licence": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "file",
        "provisions",
        "reason"
      ],
      "properties": {
        "file": {
          "description": "relative to the _jurisdiction folder",
          "type": "string",
          "minLength": 1
        },
        "provisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "description": "the finding or reference that brought it in",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "by",
        "date",
        "digest",
        "statement"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what",
              "why"
            ],
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "how": {
          "type": "string",
          "description": "how the approval was given, e.g. \"full name typed in the conversation\""
        }
      }
    }
  }
}
