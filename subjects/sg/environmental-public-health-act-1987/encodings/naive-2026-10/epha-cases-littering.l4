IMPORT prelude
IMPORT `epha-littering`

-- Environmental Public Health Act 1987, ss 17 to 21C -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_epha.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a tenant of a wholly leased flat` MEANS Flat WITH
    `the whole flat was leased` IS TRUE
    `the person is a tenant` IS TRUE
    `the person is an owner` IS FALSE
    `proved someone else did it` IS FALSE
    `was not present at the time` IS FALSE
    `named the likely offender within 14 days` IS FALSE

`the landlord of a wholly leased flat` MEANS Flat WITH
    `the whole flat was leased` IS TRUE
    `the person is a tenant` IS FALSE
    `the person is an owner` IS TRUE
    `proved someone else did it` IS FALSE
    `was not present at the time` IS FALSE
    `named the likely offender within 14 days` IS FALSE

`an owner-occupier` MEANS Flat WITH
    `the whole flat was leased` IS FALSE
    `the person is a tenant` IS FALSE
    `the person is an owner` IS TRUE
    `proved someone else did it` IS FALSE
    `was not present at the time` IS FALSE
    `named the likely offender within 14 days` IS FALSE

`an owner who was overseas` MEANS Flat WITH
    `the whole flat was leased` IS FALSE
    `the person is a tenant` IS FALSE
    `the person is an owner` IS TRUE
    `proved someone else did it` IS FALSE
    `was not present at the time` IS TRUE
    `named the likely offender within 14 days` IS FALSE

`a tenant who named a flatmate within 14 days` MEANS Flat WITH
    `the whole flat was leased` IS TRUE
    `the person is a tenant` IS TRUE
    `the person is an owner` IS FALSE
    `proved someone else did it` IS FALSE
    `was not present at the time` IS FALSE
    `named the likely offender within 14 days` IS TRUE

`an owner who proved the cleaner did it` MEANS Flat WITH
    `the whole flat was leased` IS FALSE
    `the person is a tenant` IS FALSE
    `the person is an owner` IS TRUE
    `proved someone else did it` IS TRUE
    `was not present at the time` IS FALSE
    `named the likely offender within 14 days` IS FALSE

§ `s 17`

#ASSERT `the act is a section 17 offence` `dropping a cigarette butt on the pavement`
#ASSERT `the act is a section 17 offence` `spitting on the street`
#ASSERT `the act is a section 17 offence` `drying laundry over a public walkway`
#ASSERT `the act is a section 17 offence` `leaving an old sofa at the void deck`
#ASSERT `the act is a section 17 offence` `throwing a bottle into a canal`
#ASSERT NOT `the act is a section 17 offence` `putting rubbish in a litter bin`

§ `s 17A`

#ASSERT `the person is presumed to be the litterer` `a tenant of a wholly leased flat`
#ASSERT NOT `the person is presumed to be the litterer` `the landlord of a wholly leased flat`
