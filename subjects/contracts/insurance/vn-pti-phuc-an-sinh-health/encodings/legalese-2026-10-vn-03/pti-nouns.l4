-- src:476 | chức năng;
DECLARE `A treatment named in the Rules` IS ONE OF
    -- exclusion 9
    `treatment or medicine without a doctor's order and prescription`
    `treatment not recognised by science, or experimental`
    `a vaccination`
    `a vaccination needed after an accident or an insect or animal bite`
    `a medicine taken to prevent illness`
    `a functional food`
    -- exclusion 10
    `treatment at home that is not a home nursing service`
    -- exclusion 11
    `treatment for the premenopause`
    -- exclusion 13
    `treatment or surgery for impotence or sexual dysfunction`
    `treatment for infertility`
    `assisted reproduction, such as in-vitro fertilisation`
    `a sex change`
    `a family planning measure`
    `an abortion for psycho-social reasons`
    `a consequence or complication of a treatment named in exclusion 13`
    -- exclusion 15
    `a health check, or a stay or consultation only to check health, unrelated to treatment`
    `a gynaecological or andrological check unrelated to treatment`
    `a gynaecological or andrological examination or test to treat a disease`
    `a routine eyesight test`
    `a routine hearing test`
    -- exclusion 16
    `treatment or surgery the insured person asked for, unrelated to treatment a doctor ordered`
    `routine treatment as regulated by the Ministry of Health of Vietnam`
    `a caesarean section at the request of the insured person or their representative`
    -- exclusion 17
    `orthopaedic correction or rehabilitation that does not follow on from treatment of an illness`
    -- exclusion 18
    `buying, maintaining, repairing or replacing a prosthesis or an aid`
    `surgery to maintain, repair or replace a prosthesis or an aid`
    -- exclusion 19
    `a dietary supplement or substitute, natural and sold without prescription`
    -- exclusion 20
    `surgery to correct a degenerative defect of hearing or sight, or accommodative eye strain`
    `surgery to restore sight`
    `cataract surgery`
    -- exclusion 21
    `cosmetic treatment or surgery`
    `reconstruction, ordered by a doctor, of an organ injured in an accident in the period of insurance`
    -- exclusion 22
    `treatment to control body weight`
    -- exclusion 25
    `extraction of a milk tooth`
    `dental treatment`
    `oral surgery`
    `emergency dental treatment because of an accident`
    -- exclusion 30
    `the scalpel used in Longo haemorrhoid surgery`

-- Every cause or circumstance that exclusions 1-7 and 29 name. Each member means "the injury
-- or illness was caused by this", because the chapeau of Part 3 excludes cases "xảy ra bởi
-- các nguyên nhân sau đây". Two members are the provisos that exclusions 4 and 7 attach.
-- src:461 | PTI không chi trả cho các trường hợp liên quan đến thương tật, bệnh tật xảy ra bởi các nguyên nhân sau đây:
DECLARE `A circumstance named in Part 3` IS ONE OF
    `an intentional act of the insured person`
    `an intentional act of a legal heir of the insured person`
    `an intentional act of a beneficiary of the insurance`
    `a breach of the law, or of rules of the local authority, by the insured person`
    `a breach of traffic law by the insured person`
    `the insured person being under the influence of alcohol, beer or another stimulant`
    `the insured person fighting`
    `proof that the fighting was solely in self-defence`
    `an earthquake`
    `a volcanic eruption`
    `radioactive contamination`
    `war`
    `civil war`
    `a strike`
    `terrorism`
    `taking part in aviation`
    `taking part in aviation as a passenger holding a ticket`
    `taking part in military training exercises`
    `taking part in combat with the armed forces`
    `an epidemic risk announced by a competent authority`

§§ `Sport`

-- Definitions 47 and 48, and exclusion 24.
-- src:241 | 47. Các hoạt động thể thao chuyên nghiệp
-- src:242 | Là các hoạt động thể thao mang lại nguồn thu nhập sống chính và thường xuyên cho người được bảo hiểm.
-- src:243 | 48. Các hoạt động thể thao nguy hiểm
-- src:244 | Là các hoạt động trên không (trừ khi đi lại bằng đường hàng không), các môn thể thao mùa đông, môn thể thao bay lượn,
-- src:245 | săn bắn, hockey trên băng, nhảy dù, đấu vật, môn bóng ngựa, môn lướt ván, bơi thuyền buồm cách xa bờ 5 km, các cuộc đua
-- src:246 | (không bao gồm các cuộc đua mang tính chất từ thiện, các cuộc đua mang tính chất nội bộ do công ty tổ chức).
DECLARE `A kind of sport or activity` IS ONE OF
    `an aerial activity other than travelling by air`
    `travelling by air`
    `a winter sport`
    `a gliding or flying sport`
    `hunting`
    `ice hockey`
    `parachuting`
    `wrestling`
    `polo`
    `surfing`
    `sailing`
    `a race`
    `another sport`

DECLARE `A sporting activity` HAS
    `the kind`                                              IS A `A kind of sport or activity`
    `distance from the shore, in km`                        IS A NUMBER
    `a charity race`                                        IS A BOOLEAN
    `a race organised internally by a company`              IS A BOOLEAN
    `the insured person's main and regular source of income` IS A BOOLEAN
    `training or competing`                                 IS A BOOLEAN

§§ `The accident, the illness, the disablement and the hospital stay`

-- Definitions 14, 15 and 50: what an accident and a bodily injury are. Part 5 clause 2
-- sorts accidents into three kinds for the documents it asks for.
-- src:73 | 14. Tai nạn
-- src:74 | Là các sự kiện bất ngờ gây ra bởi một lực từ bên ngoài và hữu hình lên thân thể Người được bảo hiểm xảy ra trong thời hạn bảo
-- src:75 | hiểm. Sự kiện này gây ra tổn hại trên thân thể người được bảo hiểm và xảy ra ngoài ý muốn, ngoài tầm kiểm soát của Người
-- src:76 | được bảo hiểm, và là nguyên nhân trực tiếp làm cho Người được bảo hiểm bị chết hoặc thương tật thân thể.
-- src:77 | 15. Thương tật thân thể
-- src:78 | Thương tật thân thể là tổn thương thực thể gây ra bởi tai nạn. Một thương tật sẽ chỉ được coi là thương tật thân thể nếu nó là
-- src:79 | hậu quả đầu tiên của tai nạn và không phải là một chuỗi sự tích tụ của tai nạn hoặc chấn thương và nó không trực tiếp hoặc
-- src:80 | gián tiếp gây ra bởi sự trầm trọng thêm do sự suy yếu thể lực, khuyết tật, quá trình thoái hóa hoặc bệnh tật tồn tại trước khi
-- src:81 | bắt đầu bảo hiểm theo Quy tắc bảo hiểm này.
-- src:250 | 50. Tổn thương thân thể
