§ `s 26`

#ASSERT `the sum to be restored to the register` TRUE EQUALS 0
#ASSERT `the sum to be restored to the register` FALSE EQUALS 50

#ASSERT `a name may be restored now` FALSE FALSE FALSE FALSE
#ASSERT NOT `a name may be restored now` TRUE TRUE TRUE FALSE

§ `ss 50 and 61`

#ASSERT `the expenses cap` 1000000 EQUALS 600000
#ASSERT `the expenses cap` 2700000 EQUALS 810000

#ASSERT `the counted expenses` 700000 50000 500 EQUALS 649500
#ASSERT `the counted expenses` 700000 50000 1000 EQUALS 650000

#ASSERT NOT `overspending is an illegal practice` 2000000 600400 0 500 TRUE
#ASSERT `overspending is an illegal practice` 2000000 610000 5000 500 TRUE
#ASSERT NOT `overspending is an illegal practice` 2000000 610000 5000 500 FALSE

§ `s 58`

#ASSERT NOT `the employer is in breach` TRUE FALSE
#ASSERT `the employer is in breach` TRUE TRUE

§ `ss 42C, 59, 60B, 60C, 60D, 62`

#ASSERT NOT `survey results may not be published` `before the writ`
#ASSERT `survey results may not be published` `the eve of polling day`

#ASSERT NOT `exit polls may not be published` `the eve of polling day`
#ASSERT `exit polls may not be published` `polling day before the polls close`

#ASSERT NOT `it is the cooling-off period` `after the writ, before the eve of polling day`

#ASSERT `canvassing is banned` `polling day after the polls close`

#ASSERT `displaying a party badge is an offence` `the eve of polling day` FALSE
#ASSERT NOT `displaying a party badge is an offence` `the eve of polling day` TRUE

#ASSERT NOT `the section 60D defence succeeds` TRUE FALSE

#ASSERT `the maximum fine` `employer refusing time to vote` EQUALS 1000
#ASSERT `the maximum fine` `an illegal practice` EQUALS 2000

#ASSERT `the maximum imprisonment in months` `employer refusing time to vote` EQUALS 6
#ASSERT `the maximum imprisonment in months` `an illegal practice` EQUALS 0

