#ASSERT `the most the court may award as compensation` TRUE FALSE 2000 EQUALS 500
#ASSERT `the most the court may award as compensation` FALSE TRUE 300 EQUALS 300
#ASSERT `the most the court may award as compensation` FALSE FALSE 2000 EQUALS 0

