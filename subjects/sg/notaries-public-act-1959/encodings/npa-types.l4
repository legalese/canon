IMPORT prelude
IMPORT daydate

-- Notaries Public Act 1959 (Singapore) — THE NOUNS.
--
-- Source: ../source/NPA1959.txt (SSO PDF, current version as at 05 Oct 2026).

§ `Notaries Public Act 1959 — the nouns`

-- s 3(1)-(2), (5): a candidate for appointment.
DECLARE Lawyer HAS
    `name`                                                    IS A STRING
    `a practising advocate and solicitor in Singapore`        IS A BOOLEAN   -- s 3(2), (5)
    `years practised as an advocate and solicitor in Singapore` IS A NUMBER  -- s 3(2)
    `found by the Senate to be fit and proper`                IS A BOOLEAN   -- s 3(1); the Senate's finding

-- s 3(1) or s 3(5).
DECLARE `Kind of appointment` IS ONE OF
    `an appointment under s 3(1)`
    `a temporary appointment under s 3(5)` HAS `the absent notary` IS A STRING

DECLARE Appointment HAS
    `appointee`                         IS A STRING
    `kind`                              IS A `Kind of appointment`
    `takes effect on`                   IS A DATE
    `period in months`                  IS A NUMBER       -- s 3(1), (6): "not exceeding 12 months"
    `Council of the Law Society consulted` IS A BOOLEAN   -- s 3(3)
    `published in the Gazette`          IS A BOOLEAN      -- s 3(7)
    `revoked under s 5 on`              IS A MAYBE DATE
    `revoked under s 6 on`              IS A MAYBE DATE
    `the absent notary returned on`     IS A MAYBE DATE   -- s 3(6), temporary appointments only
    `the absent notary died on`         IS A MAYBE DATE   -- s 3(6), temporary appointments only

-- s 4(2)-(3): an affidavit or statutory declaration a notary is asked to
-- administer an oath for, take or attest.
DECLARE `Purpose of the affidavit` IS ONE OF
    `confirming or proving the due execution of a document`                       -- s 4(3)(a)(i)
    `executed by the master or a crew member of a vessel about the vessel`        -- s 4(3)(a)(ii)
    `another purpose`

DECLARE Affidavit HAS
    `purpose`                                        IS A `Purpose of the affidavit`
    `to be used in a court or place within Singapore`  IS A BOOLEAN   -- s 4(2)
    `to be used in a court or place outside Singapore` IS A BOOLEAN   -- s 4(3)(a)(iii)

-- s 5(a)-(c): what appears to the Senate.
DECLARE `Section 5 findings` HAS
    `has become a bankrupt or made an arrangement with creditors` IS A BOOLEAN   -- (a)
    `has been struck off the roll of advocates and solicitors`    IS A BOOLEAN   -- (b)
    `guilty of misconduct the Senate thinks renders the person unfit to practise as a notary` IS A BOOLEAN   -- (c)

-- s 8: rules made by the Chief Justice.
DECLARE Rules HAS
    `made by the Chief Justice`         IS A BOOLEAN
    `after consulting the Senate`       IS A BOOLEAN
    `published in the Gazette on`       IS A MAYBE DATE
    `later commencement date specified` IS A MAYBE DATE

-- The answers the Act gives.
DECLARE `Appointment decision` IS ONE OF
    `the Senate may appoint, in its absolute discretion, and there is no appeal`   -- s 3(4)
    `the Senate may not appoint` HAS `the reasons` IS A LIST OF STRING

DECLARE `Oath power` IS ONE OF
    `the notary may administer the oath, and take or attest the document` HAS `under` IS A STRING   -- s 4(3)(a), (b)
    `the notary may not, under s 4(2)`
