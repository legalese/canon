           IF ^       EQUALS  31 ^    ^                        ^   9_458.97, 10_168.39, 10_931.02, 11_750.85, 12_632.16, 13_579.57, 14_598.04, 15_692.90, 16_869.86
           IF ^       EQUALS  32 ^    ^                        ^   9_553.56, 10_270.08, 11_040.33, 11_868.36, 12_758.48, 13_715.37, 14_744.02, 15_849.83, 17_038.56
           IF ^       EQUALS  33 ^    ^                        ^   9_649.10, 10_372.78, 11_150.74, 11_987.04, 12_886.07, 13_852.52, 14_891.46, 16_008.32, 17_208.95
           IF ^       EQUALS  34 ^    ^                        ^   9_745.59, 10_476.51, 11_262.24, 12_106.91, 13_014.93, 13_991.05, 15_040.38, 16_168.41, 17_381.04
           IF ^       EQUALS  35 ^    ^                        ^   9_843.04, 10_581.27, 11_374.87, 12_227.98, 13_145.08, 14_130.96, 15_190.78, 16_330.09, 17_554.85
           OTHERWISE                  ^                        ^   9_941.47, 10_687.08, 11_488.61, 12_350.26, 13_276.53, 14_272.27, 15_342.69, 16_493.39, 17_730.40
§§ `קריאת תא`

-- ותק שמעבר ל-36 קורא את השורה האחרונה: הטבלה נעצרת ב-36 ואינה מדפיסה מדרגה
-- נוספת. NOTES.md § 5 רושם שאין מסמך האומר זאת במפורש, ושזוהי קריאתו של
-- הקידוד לטבלה שנגמרת.
GIVEN `הטבלה` IS A `טבלת שכר`
      `הוותק` IS A NUMBER
      `הדרגה` IS A NUMBER
GIVETH A NUMBER
`השכר המשולב למשרה מלאה` `הטבלה` `הוותק` `הדרגה`
    @nlg השכר המשולב למשרה מלאה בוותק ובדרגה הנתונים
    MEANS
    CONSIDER `הטבלה`
    WHEN `טבלת תואר ראשון — קוד דירוג 101` THEN
        `הסכום בשורה לפי דרגה` (`שורת טבלת תואר ראשון לפי ותק` `הוותק`) `הדרגה`
    WHEN `טבלת תואר שני — קוד דירוג 102` THEN
        `הסכום בשורה לפי דרגה` (`שורת טבלת תואר שני לפי ותק` `הוותק`) `הדרגה`

§§ `הגבול שהטבלה מפרידה בפועל`

-- הטבלה מפרידה רק מספר מסוים של דרגות בוותק נתון; יתר השורה הוא החזרה
-- שתוארה בכותרת. זוהי אותה מדרגה, כפי שהיא נקראת מן הטבלאות המודפסות. היא
-- זהה בהדפסות מיום 1.1.2015, 1.9.2016, 1.9.2022 ובהדפסת האגורות המתוקנת,
-- וזו ראיה לכך שמדובר בתכונה מתוכננת ולא בתוצר לוואי של סידור דפוס אחד.
GIVEN `הוותק` IS A NUMBER
GIVETH A NUMBER
`הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` `הוותק`
    @nlg הדרגה הגבוהה ביותר שהטבלה מפרידה בוותק הנתון
    MEANS
    BRANCH IF `הוותק` AT MOST 1  THEN 1
           IF `הוותק` EQUALS 2    THEN 1
           IF `הוותק` EQUALS 3    THEN 2
           IF `הוותק` EQUALS 4    THEN 2
           IF `הוותק` EQUALS 5    THEN 2
           IF `הוותק` EQUALS 6    THEN 3
           IF `הוותק` EQUALS 7    THEN 3
           IF `הוותק` EQUALS 8    THEN 4
           IF `הוותק` EQUALS 9    THEN 4
           IF `הוותק` EQUALS 10   THEN 4
           IF `הוותק` EQUALS 11   THEN 5
           IF `הוותק` EQUALS 12   THEN 5
           IF `הוותק` EQUALS 13   THEN 5
           IF `הוותק` EQUALS 14   THEN 6
           IF `הוותק` EQUALS 15   THEN 6
           IF `הוותק` EQUALS 16   THEN 6
           IF `הוותק` EQUALS 17   THEN 6
           IF `הוותק` EQUALS 18   THEN 7
           IF `הוותק` EQUALS 19   THEN 7
           IF `הוותק` EQUALS 20   THEN 7
           IF `הוותק` EQUALS 21   THEN 7
           IF `הוותק` EQUALS 22   THEN 8
           IF `הוותק` EQUALS 23   THEN 8
           IF `הוותק` EQUALS 24   THEN 8
           IF `הוותק` EQUALS 25   THEN 8
           IF `הוותק` EQUALS 26   THEN 9
           IF `הוותק` EQUALS 27   THEN 9
           IF `הוותק` EQUALS 28   THEN 9
           IF `הוותק` EQUALS 29   THEN 9
           IF `הוותק` EQUALS 30   THEN 9
           IF `הוותק` EQUALS 31   THEN 9
           IF `הוותק` EQUALS 32   THEN 9
           IF `הוותק` EQUALS 33   THEN 9
           IF `הוותק` EQUALS 34   THEN 9
           IF `הוותק` EQUALS 35   THEN 9
           OTHERWISE                  9

-- באופן שקול, וזוהי הצורה שבה החלטת 14 בינואר 2025 עצמה מתארת את הרשתות:
-- דרגה d מופרדת לראשונה בוותק 1 / 3 / 6 / 8 / 11 / 14 / 18 / 22 / 26.
GIVEN `הדרגה` IS A NUMBER
GIVETH A NUMBER
`הוותק שבו מופרדת לראשונה הדרגה` `הדרגה`
    @nlg הוותק שבו מופרדת לראשונה הדרגה הנתונה
    MEANS
    BRANCH IF `הדרגה` AT MOST 1 THEN 1
           IF `הדרגה` EQUALS 2  THEN 3
           IF `הדרגה` EQUALS 3  THEN 6
           IF `הדרגה` EQUALS 4  THEN 8
           IF `הדרגה` EQUALS 5  THEN 11
           IF `הדרגה` EQUALS 6  THEN 14
           IF `הדרגה` EQUALS 7  THEN 18
           IF `הדרגה` EQUALS 8  THEN 22
           OTHERWISE                26

§§ `שיעורי העלייה המודפסים בשולי הטבלה`

-- ההדפסה השקלית של הטבלה אינה נותנת סכומים בלבד. בשוליה הימניים מודפס אחוז
-- כנגד כל שורת ותק, ובשוליה העליונים מודפס אחוז כנגד כל עמודת דרגה. אחוזים
-- אלה הם דין וחשבון של הטבלה על עצמה — כיצד נבנתה — ו-§ 35(b)(2) צופה את
-- עדכון הטבלה "בשיעורים ובמועדים" הקבועים בו, ומכאן שהשיעורים הם נוסח מחייב
-- ולא קישוט. (הדפסת האגורות המתוקנת נושאת את הרשתות בלבד ואינה מדפיסה
-- שוליים, ומשום כך השיעורים מצוטטים להדפסה השקלית.)
--
-- הקידוד נושא אפוא את שניהם: את הסכומים שלמעלה ואת שיעורי העלייה שלהלן, וקובע
-- כי השניים מחוללים את הראשונים.

GIVEN `הוותק` IS A NUMBER
GIVETH A NUMBER
`שיעור העלייה בוותק של` `הוותק`
    @nlg שיעור העלייה בוותק המודפס כנגד השורה הנתונה
    MEANS
    -- נקרא משולי הטבלה: 2% לשורות 2 עד 7, 1% מן השורה השמינית ואילך.
    -- שורה 1 אינה מדפיסה שיעור, בהיותה הבסיס.
    BRANCH IF `הוותק` AT MOST 1 THEN 0%
           IF `הוותק` AT MOST 7 THEN 2%
           OTHERWISE                 1%

`שיעור העלייה בדרגה` MEANS 7.5%
    -- מודפס פעם אחת בראש שתי טבלאות 2022. הטבלאות שבתוקף מיום 1.1.2015
    -- מדפיסות 8.5% מעל שלוש העמודות הגבוהות במקום זאת; מהדורה מוקדמת זו
    -- אינה מקודדת כאן (NOTES.md § 4).

§§ `הטבלה מתיישבת עם השיעורים שהיא מדפיסה`

-- שני עוזרים, כדי שכל קביעה שלהלן תיכנס לשורה האחת שהוראה חייבת לתפוס. הם
-- אינם מוסיפים דבר: כל אחד מהם הוא החיפוש שלמעלה כשטבלתו כבר נבחרה.
GIVEN `הוותק` IS A NUMBER, `הדרגה` IS A NUMBER
GIVETH A NUMBER
`תא תואר ראשון` `הוותק` `הדרגה`
    MEANS `השכר המשולב למשרה מלאה` `טבלת תואר ראשון — קוד דירוג 101` `הוותק` `הדרגה`

GIVEN `הוותק` IS A NUMBER, `הדרגה` IS A NUMBER
GIVETH A NUMBER
`תא תואר שני` `הוותק` `הדרגה`
    MEANS `השכר המשולב למשרה מלאה` `טבלת תואר שני — קוד דירוג 102` `הוותק` `הדרגה`

-- הסבולת היא חצי אגורה, והיא צרה. החלת שיעור עלייה מודפס על תא מודפס נוחתת
-- בתחום 0.005 מן התא המודפס הבא — וזו בדיוק העיגול של סכום הנקוב בשני
-- מקומות עשרוניים, ולא יותר. נמדד על פני הטבלאות המתוקנות: 188 מדרגות דרגה
-- ו-215 מדרגות ותק בכל אחת מהן, הסטייה הגרועה ביותר 0.0102 למדרגה בודדת
-- ו-0.0050 לרשת כולה המחוללת מבסיסה. ההדפסה השקלית נזקקת לסבולת גדולה פי
-- מאתיים (1.00) לאותה טענה עצמה, וזו כשלעצמה הראיה לכך שהסכומים השקליים הם
-- עיגול של אלה ולא טבלה שחושבה בנפרד.
GIVEN `הסכום המחושב` IS A NUMBER, `הסכום המודפס` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `תואם עד כדי אגורה` `הסכום המחושב` `הסכום המודפס` IF
        `הסכום המחושב` MINUS `הסכום המודפס` AT MOST 0.011
    AND `הסכום המודפס` MINUS `הסכום המחושב` AT MOST 0.011

-- שיעור העלייה בוותק, במורד עמודת הדרגה הראשונה: 2% עד שורה 7, 1% מן השורה
-- השמינית. כל קביעה לוקחת תא מודפס, מחילה עליו את השיעור המודפס בשולי השורה
-- שמתחתיו, ופוגשת את התא המודפס שם.
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 1 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 2)) (`תא תואר ראשון` 2 1)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 6 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 7)) (`תא תואר ראשון` 7 1)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 7 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 8)) (`תא תואר ראשון` 8 1)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 20 3 TIMES (1 PLUS `שיעור העלייה בוותק של` 21)) (`תא תואר ראשון` 21 3)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 35 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 36)) (`תא תואר ראשון` 36 1)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 1 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 2)) (`תא תואר שני` 2 1)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 7 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 8)) (`תא תואר שני` 8 1)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 26 6 TIMES (1 PLUS `שיעור העלייה בוותק של` 27)) (`תא תואר שני` 27 6)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 35 1 TIMES (1 PLUS `שיעור העלייה בוותק של` 36)) (`תא תואר שני` 36 1)

-- שיעור העלייה בדרגה, לרוחב שורה, בתוך הגבול. בוותק 26 הטבלה מפרידה את כל
-- תשע הדרגות, ולכן כל מדרגה לרוחב אותה שורה היא מדרגה מודפסת.
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 26 1 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר ראשון` 26 2)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 26 2 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר ראשון` 26 3)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 26 5 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר ראשון` 26 6)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 26 8 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר ראשון` 26 9)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 26 1 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר שני` 26 2)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 26 8 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר שני` 26 9)

-- ולמטה יותר בטבלה, היכן שמופרדות פחות דרגות אך שיעור העלייה הוא אותו שיעור
-- עצמו.
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 11 1 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר ראשון` 11 2)
#ASSERT `תואם עד כדי אגורה` (`תא תואר ראשון` 11 4 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר ראשון` 11 5)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 14 5 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר שני` 14 6)
#ASSERT `תואם עד כדי אגורה` (`תא תואר שני` 3 1 TIMES (1 PLUS `שיעור העלייה בדרגה`)) (`תא תואר שני` 3 2)

§§ `התאים הממוזגים הם חזרות, ולא מדרגות`

-- מעבר לגבול הערך חוזר על עצמו. זהו ההבדל הנצפה בין שתי הקריאות ש-NOTES.md
-- § 5 מציג, מנוסח כבדיקה ולא כפרוזה: אילו היו אלה מדרגות דרגה אמיתיות היו
-- נבדלות ב-7.5%, והן אינן נבדלות כלל.
#ASSERT `תא תואר ראשון` 3 2 EQUALS `תא תואר ראשון` 3 9
#ASSERT `תא תואר ראשון` 1 1 EQUALS `תא תואר ראשון` 1 9
#ASSERT `תא תואר שני` 6 3 EQUALS `תא תואר שני` 6 9

-- והגבול הוא המקום שבו מתחילות החזרות.
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 1  EQUALS 1
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 3  EQUALS 2
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 6  EQUALS 3
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 11 EQUALS 5
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 18 EQUALS 7
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 26 EQUALS 9
#ASSERT `הדרגה הגבוהה ביותר שהטבלה מפרידה לפי ותק` 36 EQUALS 9

-- שתי ההצהרות על הגבול הן אותה מדרגה עצמה הנקראת משני קצותיה, ולכן עליהן
-- להסכים בכל דרגה.
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 1 EQUALS 1
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 2 EQUALS 3
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 3 EQUALS 6
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 4 EQUALS 8
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 5 EQUALS 11
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 6 EQUALS 14
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 7 EQUALS 18
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 8 EQUALS 22
#ASSERT `הוותק שבו מופרדת לראשונה הדרגה` 9 EQUALS 26

§§ `בדיקות מדגם מול הדף המודפס`

-- ארבע הפינות והתאים של הדוגמאות הרצות עצמן, כדי שקורא יוכל לפתוח את הסריקה
-- ולבדוק את הקידוד הזה בלי לקרוא L4 כלל.
#ASSERT `תא תואר ראשון` 1  1 EQUALS 6_300
#ASSERT `תא תואר ראשון` 36 9 EQUALS 16_886.09
#ASSERT `תא תואר שני` 1  1 EQUALS 6_615
#ASSERT `תא תואר שני` 36 9 EQUALS 17_730.40
#ASSERT ROUND (`תא תואר ראשון` 11 4) EQUALS 9_172
#ASSERT ROUND (`תא תואר שני` 30 8) EQUALS 15_538
#ASSERT ROUND (`תא תואר שני` 6  3) EQUALS 8_440

-- ותק שמעבר לסוף הטבלה קורא את השורה האחרונה, וותק שלפני תחילתה קורא את
-- השורה הראשונה.
#ASSERT `תא תואר ראשון` 40 9 EQUALS `תא תואר ראשון` 36 9
#ASSERT `תא תואר ראשון` 0  1 EQUALS `תא תואר ראשון` 1  1
