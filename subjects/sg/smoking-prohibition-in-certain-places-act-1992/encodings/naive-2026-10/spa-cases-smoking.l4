IMPORT prelude
IMPORT `spa-smoking`

-- Smoking (Prohibition in Certain Places) Act 1992, ss 2, 3, 3A-3D, 4, 4A, 4B, 5, 6, 7 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_smoking-prohibition-in-certain-places-act-1992.py). Expected results were written by
-- hand from the text.

`a prescribed hawker centre` MEANS Place WITH
    `is publicly accessible` IS TRUE
    `is Government or statutory body premises` IS FALSE
    `is residential common property` IS FALSE
    `is commercial or industrial premises` IS FALSE
    `is a recreational facility` IS FALSE
    `is a passenger vessel` IS FALSE
    `has been prescribed as a specified place` IS TRUE
    `lies in a prescribed no-smoking zone` IS FALSE

`a prescribed condominium void deck` MEANS Place WITH
    `is publicly accessible` IS FALSE
    `is Government or statutory body premises` IS FALSE
    `is residential common property` IS TRUE
    `is commercial or industrial premises` IS FALSE
    `is a recreational facility` IS FALSE
    `is a passenger vessel` IS FALSE
    `has been prescribed as a specified place` IS TRUE
    `lies in a prescribed no-smoking zone` IS FALSE

`a private flat purportedly prescribed` MEANS Place WITH
    `is publicly accessible` IS FALSE
    `is Government or statutory body premises` IS FALSE
    `is residential common property` IS FALSE
    `is commercial or industrial premises` IS FALSE
    `is a recreational facility` IS FALSE
    `is a passenger vessel` IS FALSE
    `has been prescribed as a specified place` IS TRUE
    `lies in a prescribed no-smoking zone` IS FALSE

`a pavement in a no-smoking zone` MEANS Place WITH
    `is publicly accessible` IS TRUE
    `is Government or statutory body premises` IS FALSE
    `is residential common property` IS FALSE
    `is commercial or industrial premises` IS FALSE
    `is a recreational facility` IS FALSE
    `is a passenger vessel` IS FALSE
    `has been prescribed as a specified place` IS FALSE
    `lies in a prescribed no-smoking zone` IS TRUE

`a staff-only office in a no-smoking zone` MEANS Place WITH
    `is publicly accessible` IS FALSE
    `is Government or statutory body premises` IS FALSE
    `is residential common property` IS FALSE
    `is commercial or industrial premises` IS TRUE
    `is a recreational facility` IS FALSE
    `is a passenger vessel` IS FALSE
    `has been prescribed as a specified place` IS FALSE
    `lies in a prescribed no-smoking zone` IS TRUE

`lighting up at a bus-stop` MEANS Situation WITH
    `what the person is doing` IS `puffing a lit cigarette`
    `is in a specified place` IS TRUE
    `is in a specified vehicle` IS FALSE
    `is within a smoking facility` IS FALSE
    `prescribed circumstances apply` IS FALSE
    `an exemption order covers it` IS FALSE

`holding a lit cigarette at a bus-stop` MEANS Situation WITH
    `what the person is doing` IS `holding a lit cigarette without puffing`
    `is in a specified place` IS TRUE
    `is in a specified vehicle` IS FALSE
    `is within a smoking facility` IS FALSE
    `prescribed circumstances apply` IS FALSE
    `an exemption order covers it` IS FALSE

`vaping at a bus-stop` MEANS Situation WITH
    `what the person is doing` IS `using a vaporiser`
    `is in a specified place` IS TRUE
    `is in a specified vehicle` IS FALSE
    `is within a smoking facility` IS FALSE
    `prescribed circumstances apply` IS FALSE
    `an exemption order covers it` IS FALSE

`smoking in the designated smoking room` MEANS Situation WITH
    `what the person is doing` IS `puffing a lit cigarette`
    `is in a specified place` IS TRUE
    `is in a specified vehicle` IS FALSE
    `is within a smoking facility` IS TRUE
    `prescribed circumstances apply` IS FALSE
    `an exemption order covers it` IS FALSE

`smoking on a bus with a smoking corner` MEANS Situation WITH
    `what the person is doing` IS `puffing a lit cigarette`
    `is in a specified place` IS FALSE
    `is in a specified vehicle` IS TRUE
    `is within a smoking facility` IS TRUE
    `prescribed circumstances apply` IS FALSE
    `an exemption order covers it` IS FALSE

`smoking at an exempted event` MEANS Situation WITH
    `what the person is doing` IS `puffing a lit cigarette`
    `is in a specified place` IS TRUE
    `is in a specified vehicle` IS FALSE
    `is within a smoking facility` IS FALSE
    `prescribed circumstances apply` IS FALSE
    `an exemption order covers it` IS TRUE

`a manager who ignored a smoker` MEANS Encounter WITH
    `the manager knew or ought to have known` IS TRUE
    `a supervised employee knew` IS FALSE
    `the manager proved lack of knowledge` IS FALSE
    `told the smoker to stop and of the penalty` IS FALSE
    `the smoker stopped` IS FALSE
    `asked the smoker to leave` IS FALSE
    `the smoker left` IS FALSE
    `sought police or officer help` IS FALSE

`a manager whose cashier saw a smoker` MEANS Encounter WITH
    `the manager knew or ought to have known` IS FALSE
    `a supervised employee knew` IS TRUE
    `the manager proved lack of knowledge` IS FALSE
    `told the smoker to stop and of the penalty` IS FALSE
    `the smoker stopped` IS FALSE
    `asked the smoker to leave` IS FALSE
    `the smoker left` IS FALSE
    `sought police or officer help` IS FALSE

`a manager who rebutted the cashier presumption` MEANS Encounter WITH
    `the manager knew or ought to have known` IS FALSE
    `a supervised employee knew` IS TRUE
    `the manager proved lack of knowledge` IS TRUE
    `told the smoker to stop and of the penalty` IS FALSE
    `the smoker stopped` IS FALSE
    `asked the smoker to leave` IS FALSE
    `the smoker left` IS FALSE
    `sought police or officer help` IS FALSE

`a manager whose warning worked` MEANS Encounter WITH
    `the manager knew or ought to have known` IS TRUE
    `a supervised employee knew` IS FALSE
    `the manager proved lack of knowledge` IS FALSE
    `told the smoker to stop and of the penalty` IS TRUE
    `the smoker stopped` IS TRUE
    `asked the smoker to leave` IS FALSE
    `the smoker left` IS FALSE
    `sought police or officer help` IS FALSE

`a manager who asked a refuser to leave and stopped there` MEANS Encounter WITH
    `the manager knew or ought to have known` IS TRUE
    `a supervised employee knew` IS FALSE
    `the manager proved lack of knowledge` IS FALSE
    `told the smoker to stop and of the penalty` IS TRUE
    `the smoker stopped` IS FALSE
    `asked the smoker to leave` IS TRUE
    `the smoker left` IS FALSE
    `sought police or officer help` IS FALSE

`a manager who called the police` MEANS Encounter WITH
    `the manager knew or ought to have known` IS TRUE
    `a supervised employee knew` IS FALSE
    `the manager proved lack of knowledge` IS FALSE
    `told the smoker to stop and of the penalty` IS TRUE
    `the smoker stopped` IS FALSE
    `asked the smoker to leave` IS TRUE
    `the smoker left` IS FALSE
    `sought police or officer help` IS TRUE

§ `s 2`

#ASSERT `the activity is smoking` `puffing a lit cigarette`
#ASSERT `the activity is smoking` `holding a lit cigarette without puffing`
#ASSERT `the activity is smoking` `smoking shisha`
#ASSERT NOT `the activity is smoking` `using a vaporiser`
#ASSERT NOT `the activity is smoking` `holding a vaporiser emitting smoke`

§ `s 3A`

#ASSERT NOT `the place is capable of being prescribed` `a private flat purportedly prescribed`
#ASSERT `the place is capable of being prescribed` `a staff-only office in a no-smoking zone`

#ASSERT `the place is a specified place` `a prescribed hawker centre`
#ASSERT `the place is a specified place` `a prescribed condominium void deck`
#ASSERT NOT `the place is a specified place` `a private flat purportedly prescribed`
#ASSERT `the place is a specified place` `a pavement in a no-smoking zone`
#ASSERT NOT `the place is a specified place` `a staff-only office in a no-smoking zone`

§ `ss 3, 3B, 10`

#ASSERT `the person commits the section 3 offence` `lighting up at a bus-stop`
#ASSERT `the person commits the section 3 offence` `holding a lit cigarette at a bus-stop`
#ASSERT NOT `the person commits the section 3 offence` `vaping at a bus-stop`
#ASSERT NOT `the person commits the section 3 offence` `smoking in the designated smoking room`
#ASSERT `the person commits the section 3 offence` `smoking on a bus with a smoking corner`
#ASSERT NOT `the person commits the section 3 offence` `smoking at an exempted event`

#ASSERT `the maximum fine for smoking in a specified place`  EQUALS 1000

§ `s 3C`

#ASSERT `the manager is guilty over the smoking facility` FALSE FALSE FALSE
#ASSERT NOT `the manager is guilty over the smoking facility` TRUE FALSE FALSE
#ASSERT NOT `the manager is guilty over the smoking facility` FALSE FALSE TRUE

#ASSERT `the maximum fine for a non-compliant smoking facility` FALSE 10 EQUALS 10000
#ASSERT `the maximum fine for a non-compliant smoking facility` TRUE 4 EQUALS 12000

#ASSERT `the maximum months of imprisonment for a non-compliant smoking facility` TRUE EQUALS 3

§ `ss 3C(4), 3D`

#ASSERT NOT `the Minister may reject the appeal as non-compliant` TRUE TRUE TRUE
#ASSERT `the Minister may reject the appeal as non-compliant` TRUE TRUE FALSE
#ASSERT `the Minister may reject the appeal as non-compliant` FALSE TRUE TRUE

#ASSERT `the Director-General's designation has taken effect` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `the Director-General's designation has taken effect` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT `the Director-General's designation has taken effect` TRUE TRUE TRUE FALSE TRUE FALSE
#ASSERT NOT `the Director-General's designation has taken effect` TRUE TRUE TRUE FALSE TRUE TRUE

§ `s 4`

#ASSERT `the officer may serve a notice to attend court instead` TRUE TRUE TRUE TRUE

§ `s 4A`

#ASSERT NOT `the officer may enter without a warrant` TRUE TRUE FALSE
#ASSERT `the officer may enter without a warrant` TRUE FALSE TRUE
#ASSERT `the officer may enter without a warrant` FALSE TRUE FALSE

§ `s 4B`

#ASSERT `the conduct is an obstruction offence` `obstructing an officer` FALSE FALSE
#ASSERT NOT `the conduct is an obstruction offence` `refusing to produce a document or information` FALSE TRUE
#ASSERT `the conduct is an obstruction offence` `giving false or misleading information` FALSE TRUE
#ASSERT NOT `the conduct is an obstruction offence` `refusing to attend` TRUE FALSE

#ASSERT `the maximum fine for obstruction` TRUE EQUALS 5000

§ `s 5`

#ASSERT NOT `the manager commits the notices offence` TRUE FALSE FALSE
#ASSERT `the manager commits the notices offence` FALSE FALSE FALSE
#ASSERT `the manager commits the notices offence` TRUE TRUE FALSE

§ `s 6`

#ASSERT `the manager commits the section 6 offence` `a manager who ignored a smoker`
#ASSERT `the manager commits the section 6 offence` `a manager whose cashier saw a smoker`
#ASSERT NOT `the manager commits the section 6 offence` `a manager who rebutted the cashier presumption`
#ASSERT NOT `the manager commits the section 6 offence` `a manager whose warning worked`
#ASSERT `the manager commits the section 6 offence` `a manager who asked a refuser to leave and stopped there`
#ASSERT NOT `the manager commits the section 6 offence` `a manager who called the police`

#ASSERT `the manager fails the complaint duty` TRUE FALSE FALSE FALSE
#ASSERT NOT `the manager fails the complaint duty` TRUE TRUE FALSE FALSE
#ASSERT `the manager fails the complaint duty` TRUE TRUE TRUE FALSE

#ASSERT `the maximum fine for a manager's section 6 failure` TRUE EQUALS 2000

