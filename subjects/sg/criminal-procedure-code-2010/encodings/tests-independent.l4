#ASSERT `the criminal case disclosure procedures of Part 10 Division 5 apply by section 211A(1)` (`wlo` "Moneylenders Act 2008" "3" FALSE) (`hcd` FALSE TRUE FALSE)
#ASSERT NOT `the criminal case disclosure procedures of Part 10 Division 5 apply by section 211A(1)` (`wlo` "Moneylenders Act 2008" "3" FALSE) (`hcd` FALSE FALSE TRUE)

