IMPORT prelude
IMPORT `rsa-retail`

-- Resource Sustainability Act 2019, ss 14, 15, 23A to 23H, 23Q, 23U, 23X and 49 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_resource-sustainability-act-2019.py). Expected results were written by
-- hand from the text.

`a thin plastic bag with handles` MEANS Bag WITH
    `has handles` IS TRUE
    `is made primarily of washable woven fabric` IS FALSE
    `is plastic of the prescribed minimum thickness or density` IS FALSE
    `can hold the prescribed minimum weight` IS FALSE
    `is prescribed as reusable` IS FALSE

`a paper bag with handles` MEANS Bag WITH
    `has handles` IS TRUE
    `is made primarily of washable woven fabric` IS FALSE
    `is plastic of the prescribed minimum thickness or density` IS FALSE
    `can hold the prescribed minimum weight` IS FALSE
    `is prescribed as reusable` IS FALSE

`a washable cloth tote` MEANS Bag WITH
    `has handles` IS TRUE
    `is made primarily of washable woven fabric` IS TRUE
    `is plastic of the prescribed minimum thickness or density` IS FALSE
    `can hold the prescribed minimum weight` IS FALSE
    `is prescribed as reusable` IS FALSE

`a thick plastic bag of the prescribed thickness` MEANS Bag WITH
    `has handles` IS TRUE
    `is made primarily of washable woven fabric` IS FALSE
    `is plastic of the prescribed minimum thickness or density` IS TRUE
    `can hold the prescribed minimum weight` IS FALSE
    `is prescribed as reusable` IS FALSE

`a plastic bag without handles` MEANS Bag WITH
    `has handles` IS FALSE
    `is made primarily of washable woven fabric` IS FALSE
    `is plastic of the prescribed minimum thickness or density` IS FALSE
    `can hold the prescribed minimum weight` IS FALSE
    `is prescribed as reusable` IS FALSE

§ `s 14 -- take-back on delivery`

#ASSERT `the retailer must collect the unwanted product free` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `the retailer must collect the unwanted product free` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `the retailer must collect the unwanted product free` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `the retailer must collect the unwanted product free` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `the retailer must collect the unwanted product free` TRUE TRUE TRUE TRUE FALSE

#ASSERT `the retailer commits the s 14(3) offence` TRUE TRUE TRUE FALSE
#ASSERT `the retailer commits the s 14(3) offence` TRUE FALSE FALSE FALSE
#ASSERT NOT `the retailer commits the s 14(3) offence` TRUE FALSE FALSE TRUE

§ `s 15 -- in-store take-back`

#ASSERT `the retailer must accept the product in store` TRUE 300 TRUE
#ASSERT NOT `the retailer must accept the product in store` TRUE 299 TRUE
#ASSERT `the retailer must accept the product in store` TRUE 1000 TRUE
#ASSERT NOT `the retailer must accept the product in store` FALSE 1000 TRUE

§ `s 23A -- reusable and disposable bags`

#ASSERT NOT `the bag is reusable` `a thin plastic bag with handles`
#ASSERT `the bag is reusable` `a washable cloth tote`
#ASSERT `the bag is reusable` `a thick plastic bag of the prescribed thickness`

#ASSERT `the bag is a disposable carrier bag` `a paper bag with handles`
#ASSERT NOT `the bag is a disposable carrier bag` `a washable cloth tote`
#ASSERT NOT `the bag is a disposable carrier bag` `a plastic bag without handles`

§ `ss 23F to 23H -- the charge`

#ASSERT `a bag charge must be imposed` TRUE `a thin plastic bag with handles` TRUE FALSE
#ASSERT NOT `a bag charge must be imposed` FALSE `a thin plastic bag with handles` TRUE FALSE
#ASSERT NOT `a bag charge must be imposed` TRUE `a washable cloth tote` TRUE FALSE
#ASSERT NOT `a bag charge must be imposed` TRUE `a paper bag with handles` TRUE TRUE

#ASSERT `the charge is enough` 0.05
#ASSERT NOT `the charge is enough` 0.04

§ `ss 23B to 23D -- registration`

#ASSERT `the retailer must apply to register` TRUE 100000001 100000000 FALSE
#ASSERT NOT `the retailer must apply to register` TRUE 100000000 100000000 FALSE

#ASSERT `the year by whose 30 June the application must be made` 2025 EQUALS 2026

#ASSERT `the year on whose 1 January registration begins` 2025 EQUALS 2027

#ASSERT `the retailer may apply to deregister` FALSE 90 100 90 100
#ASSERT NOT `the retailer may apply to deregister` FALSE 90 110 90 100
#ASSERT `the retailer may apply to deregister` TRUE 200 200 200 100

§ `s 23Q -- the deposit`

#ASSERT NOT `the seller may waive the deposit` TRUE
#ASSERT `the seller may waive the deposit` FALSE

#ASSERT `the buyer must still pay the deposit to the seller` TRUE TRUE
#ASSERT NOT `the buyer must still pay the deposit to the seller` TRUE FALSE

§ `s 23U -- the refund`

#ASSERT `the operator must refund the deposit` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `the operator must refund the deposit` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `the operator must refund the deposit` TRUE TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `the operator must refund the deposit` TRUE TRUE FALSE FALSE TRUE FALSE

§ `penalties and s 49`

#ASSERT `the maximum fine on first conviction` `s 14(3) not collecting, or charging for, take-back on delivery` EQUALS 5000
#ASSERT `the maximum fine on first conviction` `s 23F(3) not charging for a disposable carrier bag` EQUALS 10000
#ASSERT `the maximum fine on first conviction` `s 23Q(7) waiving the deposit on a sale for money` EQUALS 5000

#ASSERT `the maximum imprisonment in months on first conviction` `s 15(3) refusing in-store take-back` EQUALS 0
#ASSERT `the maximum imprisonment in months on first conviction` `s 23U(3) refusing a deposit refund` EQUALS 3

#ASSERT `the offence is worded without reasonable excuse` `s 23U(3) refusing a deposit refund`
#ASSERT NOT `the offence is worded without reasonable excuse` `s 23F(3) not charging for a disposable carrier bag`

#ASSERT `the offence is declared strict liability` `s 23G(2) reimbursing the bag charge`
#ASSERT NOT `the offence is declared strict liability` `s 14(4) disposing of taken-back e-waste outside a licensed scheme`

#ASSERT `the most a composition may collect` `s 23F(3) not charging for a disposable carrier bag` EQUALS 5000
#ASSERT `the most a composition may collect` `s 15(3) refusing in-store take-back` EQUALS 2500

