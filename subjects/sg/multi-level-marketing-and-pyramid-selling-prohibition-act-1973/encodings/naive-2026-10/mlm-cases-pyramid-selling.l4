IMPORT prelude
IMPORT `mlm-pyramid-selling`

-- Multi-Level Marketing and Pyramid Selling (Prohibition) Act 1973, ss 2 to 7 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_multi-level-marketing-and-pyramid-selling-prohibition-act-1973.py). Expected results were written by
-- hand from the text.

`a recruitment-commission network` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS TRUE
    `that person benefits from recruiting or the performance of additional participants` IS TRUE
    `that person benefits from distribution by additional participants` IS FALSE
    `some other promoter or participant may benefit` IS TRUE
    `excluded by order of the Minister` IS FALSE

`a downline-sales override plan` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS TRUE
    `that person benefits from recruiting or the performance of additional participants` IS FALSE
    `that person benefits from distribution by additional participants` IS TRUE
    `some other promoter or participant may benefit` IS TRUE
    `excluded by order of the Minister` IS FALSE

`a network paying on both recruits and downline sales` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS TRUE
    `that person benefits from recruiting or the performance of additional participants` IS TRUE
    `that person benefits from distribution by additional participants` IS TRUE
    `some other promoter or participant may benefit` IS TRUE
    `excluded by order of the Minister` IS FALSE

`a network excluded by Ministerial order` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS TRUE
    `that person benefits from recruiting or the performance of additional participants` IS TRUE
    `that person benefits from distribution by additional participants` IS TRUE
    `some other promoter or participant may benefit` IS TRUE
    `excluded by order of the Minister` IS TRUE

`a referral bonus with no upline benefit` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS TRUE
    `that person benefits from recruiting or the performance of additional participants` IS TRUE
    `that person benefits from distribution by additional participants` IS FALSE
    `some other promoter or participant may benefit` IS FALSE
    `excluded by order of the Minister` IS FALSE

`a single-level reseller` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS TRUE
    `that person benefits from recruiting or the performance of additional participants` IS FALSE
    `that person benefits from distribution by additional participants` IS FALSE
    `some other promoter or participant may benefit` IS TRUE
    `excluded by order of the Minister` IS FALSE

`a recruitment chain with no commodity to distribute` MEANS Scheme WITH
    `a person may acquire a commodity or a right to it for distribution` IS FALSE
    `that person benefits from recruiting or the performance of additional participants` IS TRUE
    `that person benefits from distribution by additional participants` IS FALSE
    `some other promoter or participant may benefit` IS TRUE
    `excluded by order of the Minister` IS FALSE

§ `s 2 -- pyramid selling scheme`

#ASSERT `the scheme is a pyramid selling scheme` `a recruitment-commission network`
#ASSERT `the scheme is a pyramid selling scheme` `a downline-sales override plan`
#ASSERT `the scheme is a pyramid selling scheme` `a network paying on both recruits and downline sales`
#ASSERT NOT `the scheme is a pyramid selling scheme` `a network excluded by Ministerial order`
#ASSERT NOT `the scheme is a pyramid selling scheme` `a referral bonus with no upline benefit`
#ASSERT NOT `the scheme is a pyramid selling scheme` `a single-level reseller`
#ASSERT NOT `the scheme is a pyramid selling scheme` `a recruitment chain with no commodity to distribute`

§ `s 2 -- benefit`

#ASSERT `the advantage is a benefit` `a commission`
#ASSERT `the advantage is a benefit` `a cross commission`
#ASSERT `the advantage is a benefit` `a free service`
#ASSERT NOT `the advantage is a benefit` `a sample bought at or below cost and not for resale`
#ASSERT NOT `the advantage is a benefit` `time and effort spent recruiting`

#ASSERT `the sample purchase is excluded from benefit` 50 50 FALSE
#ASSERT `the sample purchase is excluded from benefit` 40 50 FALSE
#ASSERT NOT `the sample purchase is excluded from benefit` 60 50 FALSE
#ASSERT NOT `the sample purchase is excluded from benefit` 40 50 TRUE

§ `s 3`

#ASSERT `the person contravenes section 3` `a recruitment-commission network` FALSE TRUE FALSE
#ASSERT `the person contravenes section 3` `a recruitment-commission network` TRUE FALSE FALSE
#ASSERT NOT `the person contravenes section 3` `a single-level reseller` FALSE TRUE FALSE
#ASSERT NOT `the person contravenes section 3` `a network excluded by Ministerial order` TRUE TRUE FALSE
#ASSERT `the person contravenes section 3` `a single-level reseller` FALSE FALSE TRUE
#ASSERT NOT `the person contravenes section 3` `a recruitment-commission network` FALSE FALSE FALSE

§ `ss 3(2), 4(2), 5(2) -- maximum punishments`

#ASSERT `the maximum fine` `promoting or participating, s 3` EQUALS 200000
#ASSERT `the maximum fine` `a company obtaining incorporation, s 5` EQUALS 200000

#ASSERT `the maximum imprisonment in years` `holding out, s 3` EQUALS 5
#ASSERT `the maximum imprisonment in years` `applying for a business name, s 4` EQUALS 5

#ASSERT `the applicant contravenes section 4` TRUE TRUE
#ASSERT NOT `the applicant contravenes section 4` FALSE TRUE

#ASSERT `guilty under section 5` TRUE TRUE TRUE
#ASSERT NOT `guilty under section 5` TRUE FALSE TRUE
#ASSERT NOT `guilty under section 5` TRUE TRUE FALSE

§ `s 6`

#ASSERT `the office is caught by section 6` `director`
#ASSERT `the office is caught by section 6` `secretary`
#ASSERT NOT `the office is caught by section 6` `officer not concerned in management`
#ASSERT NOT `the office is caught by section 6` `ordinary employee`

#ASSERT `the individual is guilty under section 6` TRUE `director` FALSE FALSE FALSE
#ASSERT `the individual is guilty under section 6` TRUE `director` FALSE TRUE FALSE
#ASSERT NOT `the individual is guilty under section 6` TRUE `director` FALSE TRUE TRUE
#ASSERT `the individual is guilty under section 6` TRUE `ordinary employee` TRUE FALSE FALSE
#ASSERT NOT `the individual is guilty under section 6` TRUE `ordinary employee` FALSE FALSE FALSE
#ASSERT NOT `the individual is guilty under section 6` FALSE `director` FALSE FALSE FALSE

§ `s 7`

#ASSERT `the court must order a section 7 penalty` `promoting or participating, s 3` TRUE TRUE
#ASSERT NOT `the court must order a section 7 penalty` `holding out, s 3` TRUE TRUE
#ASSERT NOT `the court must order a section 7 penalty` `applying for a business name, s 4` TRUE TRUE
#ASSERT NOT `the court must order a section 7 penalty` `promoting or participating, s 3` TRUE FALSE
#ASSERT NOT `the court must order a section 7 penalty` `promoting or participating, s 3` FALSE TRUE

#ASSERT `the ceiling of the section 7 penalty` `promoting or participating, s 3` TRUE TRUE 12000 EQUALS 12000
#ASSERT `the ceiling of the section 7 penalty` `holding out, s 3` TRUE TRUE 12000 EQUALS 0
#ASSERT `the ceiling of the section 7 penalty` `promoting or participating, s 3` TRUE FALSE 12000 EQUALS 0

