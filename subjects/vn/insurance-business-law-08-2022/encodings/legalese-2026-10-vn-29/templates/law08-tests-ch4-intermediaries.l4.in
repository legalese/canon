-- Tests for Dieu 124-143. V1 pinned at 1 June 2025, V2 at 1 March 2026, V3 at 1 August 2026.

§ `Tests: Chuong IV`

§§ `Dieu 125 and 126`

@@q 2696 2733
@ref Dieu 125-126 (src:2696-2733)
@@fx `a qualified individual` : `An individual agent` ; `is a Vietnamese citizen resident in Vietnam` = TRUE ; `has full civil act capacity` = TRUE ; `holds an agent certificate suited to the types of insurance` = TRUE
@@fx `an individual without a certificate` : `An individual agent` ; `is a Vietnamese citizen resident in Vietnam` = TRUE ; `has full civil act capacity` = TRUE
@@fx `a foreign individual` : `An individual agent` ; `has full civil act capacity` = TRUE ; `holds an agent certificate suited to the types of insurance` = TRUE
@@fx `an individual being prosecuted` : `An individual agent` ; `is being prosecuted for a crime` = TRUE
@@fx `an individual in prison` : `An individual agent` ; `is serving a prison sentence` = TRUE
@@fx `an individual banned from practice` : `An individual agent` ; `is serving a ban on practising in a field related to insurance` = TRUE
@@fx `a clean individual` : `An individual agent`
#ASSERT `Dieu 125(1): the individual meets the conditions to act as an agent` `a qualified individual`
#ASSERT NOT `Dieu 125(1): the individual meets the conditions to act as an agent` `an individual without a certificate`
#ASSERT NOT `Dieu 125(1): the individual meets the conditions to act as an agent` `a foreign individual`
#ASSERT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `an individual being prosecuted`
#ASSERT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `an individual in prison`
#ASSERT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `an individual banned from practice`
#ASSERT NOT `Dieu 125(3)(b): the individual may not make or perform an agency contract` `a clean individual`
@@fx `an ordinary agent company` : `An organisation agent` ; `is lawfully established and operating in Vietnam` = TRUE ; `has registered the business line of insurance agency under the Law on Enterprises` = TRUE ; `its staff who act as agents meet the individual conditions` = TRUE ; `meets the staffing and other conditions the Government sets` = TRUE
@@fx `a bank agent in a conditional line with cover` : `An organisation agent` ; `is lawfully established and operating in Vietnam` = TRUE ; `has registered the business line of insurance agency under the Law on Enterprises` = TRUE ; `its staff who act as agents meet the individual conditions` = TRUE ; `meets the staffing and other conditions the Government sets` = TRUE ; `is in a conditional line` = TRUE ; `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` = TRUE
@@fx `a bank agent in a conditional line without cover` : `An organisation agent` ; `is lawfully established and operating in Vietnam` = TRUE ; `has registered the business line of insurance agency under the Law on Enterprises` = TRUE ; `its staff who act as agents meet the individual conditions` = TRUE ; `meets the staffing and other conditions the Government sets` = TRUE ; `is in a conditional line` = TRUE
@@fx `an agent company with unqualified staff` : `An organisation agent` ; `is lawfully established and operating in Vietnam` = TRUE ; `has registered the business line of insurance agency under the Law on Enterprises` = TRUE ; `meets the staffing and other conditions the Government sets` = TRUE
@@fx `a suspended agent company` : `An organisation agent` ; `is suspended for a time or for good, or banned from business related to insurance` = TRUE
@@fx `a prosecuted agent company` : `An organisation agent` ; `is a commercial legal person being prosecuted for a crime` = TRUE
#ASSERT `Dieu 125(2): the organisation meets the conditions to act as an agent` `an ordinary agent company`
#ASSERT `Dieu 125(2): the organisation meets the conditions to act as an agent` `a bank agent in a conditional line with cover`
#ASSERT NOT `Dieu 125(2): the organisation meets the conditions to act as an agent` `a bank agent in a conditional line without cover`
#ASSERT NOT `Dieu 125(2): the organisation meets the conditions to act as an agent` `an agent company with unqualified staff`
#ASSERT `Dieu 125(3)(a): the organisation may not make or perform an agency contract` `a suspended agent company`
#ASSERT `Dieu 125(3)(a): the organisation may not make or perform an agency contract` `a prosecuted agent company`
@@fx `a complete agency contract` : `The contract of an agent` ; `states the name and address of the agent` = TRUE ; `states the name and head office address of the insurer, branch or mutual organisation` = TRUE ; `states the rights and obligations of both sides` = TRUE ; `states the content and scope of the agency` = TRUE ; `states commission, bonus and support, if any` = TRUE ; `states the term of the contract` = TRUE ; `states the way of resolving disputes` = TRUE
@@fx `an agency contract without a term` : `The contract of an agent` ; `states the name and address of the agent` = TRUE ; `states the name and head office address of the insurer, branch or mutual organisation` = TRUE ; `states the rights and obligations of both sides` = TRUE ; `states the content and scope of the agency` = TRUE ; `states commission, bonus and support, if any` = TRUE ; `states the way of resolving disputes` = TRUE
#ASSERT `Dieu 126: the agency contract states the essential contents` `a complete agency contract`
#ASSERT NOT `Dieu 126: the agency contract states the essential contents` `an agency contract without a term`

