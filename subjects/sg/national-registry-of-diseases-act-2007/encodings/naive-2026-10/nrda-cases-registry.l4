IMPORT prelude
IMPORT `nrda-registry`

-- National Registry of Diseases Act 2007, ss 2, 5-12, 17(2), 20 and the Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_national-registry-of-diseases-act-2007.py). Expected results were written by
-- hand from the text.

`a consented cancer outcomes study` MEANS `Research application` WITH
    `concerns a reportable disease` IS TRUE
    `cannot be done with anonymised information` IS TRUE
    `requisite consent given` IS TRUE
    `may improve health services` IS TRUE
    `may support a national public health policy` IS TRUE
    `meets the prescribed conditions` IS TRUE

`the same study without consent` MEANS `Research application` WITH
    `concerns a reportable disease` IS TRUE
    `cannot be done with anonymised information` IS TRUE
    `requisite consent given` IS FALSE
    `may improve health services` IS TRUE
    `may support a national public health policy` IS TRUE
    `meets the prescribed conditions` IS TRUE

`a study that anonymised data would serve` MEANS `Research application` WITH
    `concerns a reportable disease` IS TRUE
    `cannot be done with anonymised information` IS FALSE
    `requisite consent given` IS TRUE
    `may improve health services` IS TRUE
    `may support a national public health policy` IS TRUE
    `meets the prescribed conditions` IS TRUE

`a consented study supporting policy only` MEANS `Research application` WITH
    `concerns a reportable disease` IS TRUE
    `cannot be done with anonymised information` IS TRUE
    `requisite consent given` IS TRUE
    `may improve health services` IS FALSE
    `may support a national public health policy` IS TRUE
    `meets the prescribed conditions` IS TRUE

