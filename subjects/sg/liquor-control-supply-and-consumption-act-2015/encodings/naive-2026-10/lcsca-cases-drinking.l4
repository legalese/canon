IMPORT prelude
IMPORT `lcsca-drinking`

-- Liquor Control (Supply and Consumption) Act 2015, ss 2, 4, 12, 14, 16, 18 to 22, 28 and 33 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_liquor-control-supply-and-consumption-act-2015.py). Expected results were written by
-- hand from the text.

§ `s 2(1)`

#ASSERT NOT `the substance is liquor` 0.5 FALSE
#ASSERT `the substance is liquor` 0.6 FALSE
#ASSERT `the substance is liquor` 0 TRUE

#ASSERT `the dealing is supply` `selling a bottle`
#ASSERT `the dealing is supply` `serving drinks included in a paid package`
#ASSERT NOT `the dealing is supply` `giving a bottle away for nothing`

§ `s 2(2)`

#ASSERT `the person is a repeat offender` TRUE 5
#ASSERT NOT `the person is a repeat offender` TRUE 6
#ASSERT NOT `the person is a repeat offender` FALSE 1

§ `s 4`

#ASSERT `the supply is an offence under section 4` `selling a bottle` FALSE `an ordinary sale`
#ASSERT NOT `the supply is an offence under section 4` `selling a bottle` TRUE `an ordinary sale`
#ASSERT NOT `the supply is an offence under section 4` `giving a bottle away for nothing` FALSE `an ordinary sale`
#ASSERT NOT `the supply is an offence under section 4` `delivering a bottle that was sold` FALSE `delivering liquor the recipient owns or ordered`
#ASSERT NOT `the supply is an offence under section 4` `selling a bottle` FALSE `an emergency to preserve life or prevent injury`

§ `s 12`

#ASSERT `the drinking is an offence under section 12` TRUE TRUE `drinking with no special circumstance`
#ASSERT NOT `the drinking is an offence under section 12` TRUE FALSE `drinking with no special circumstance`
#ASSERT NOT `the drinking is an offence under section 12` TRUE TRUE `at licensed premises allowing it, within trading hours`
#ASSERT `the drinking is an offence under section 12` TRUE TRUE `at licensed premises after trading hours`
#ASSERT `the drinking is an offence under section 12` TRUE TRUE `at licensed premises whose licence does not allow drinking there`
#ASSERT NOT `the drinking is an offence under section 12` TRUE TRUE `under a consumption permit for the place`

§ `s 14`

#ASSERT `the individual is drunk` TRUE TRUE
#ASSERT NOT `the individual is drunk` TRUE FALSE

#ASSERT `drunk and incapable is an offence under section 14(1)` TRUE TRUE TRUE TRUE
#ASSERT NOT `drunk and incapable is an offence under section 14(1)` TRUE TRUE TRUE FALSE

#ASSERT `drunken annoyance is an offence under section 14(2)` TRUE TRUE FALSE TRUE TRUE
#ASSERT `drunken annoyance is an offence under section 14(2)` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `drunken annoyance is an offence under section 14(2)` TRUE TRUE FALSE FALSE TRUE

§ `ss 4, 12, 14, 16, 19 to 22, 28 -- penalties`

#ASSERT `the maximum fine in dollars` `unlicensed supply` FALSE FALSE EQUALS 20000
#ASSERT `the maximum fine in dollars` `unlicensed supply` FALSE TRUE EQUALS 30000
#ASSERT `the maximum fine in dollars` `drinking in public in the no-public drinking period` TRUE FALSE EQUALS 2000
#ASSERT `the maximum fine in dollars` `breaching a banning notice` FALSE TRUE EQUALS 2500
#ASSERT `the maximum fine in dollars` `giving false information` TRUE FALSE EQUALS 10000

#ASSERT `the maximum months of imprisonment` `unlicensed supply` TRUE FALSE EQUALS 3
#ASSERT `the maximum months of imprisonment` `being drunk and incapable in public` FALSE FALSE EQUALS 1
#ASSERT `the maximum months of imprisonment` `being drunk and incapable in public` TRUE TRUE EQUALS 4.5
#ASSERT `the maximum months of imprisonment` `drunken annoyance` FALSE FALSE EQUALS 6
#ASSERT `the maximum months of imprisonment` `drunken annoyance` TRUE FALSE EQUALS 6
#ASSERT `the maximum months of imprisonment` `ignoring a direction to leave` FALSE TRUE EQUALS 9

§ `ss 18, 19`

#ASSERT `the banning notice is within power` TRUE 30
#ASSERT NOT `the banning notice is within power` TRUE 31
#ASSERT NOT `the banning notice is within power` FALSE 7

#ASSERT `the entry breaches the banning notice` TRUE `going for a drink` FALSE
#ASSERT NOT `the entry breaches the banning notice` TRUE `going home` FALSE
#ASSERT `the entry breaches the banning notice` TRUE `visiting a friend` FALSE
#ASSERT NOT `the entry breaches the banning notice` TRUE `visiting a friend` TRUE

§ `s 20`

#ASSERT `the zone direction is within power` FALSE 24
#ASSERT NOT `the zone direction is within power` FALSE 25

§ `s 33`

#ASSERT `the most that can be collected to compound` 20000 EQUALS 5000
#ASSERT `the most that can be collected to compound` 1000 EQUALS 500
#ASSERT `the most that can be collected to compound` 30000 EQUALS 5000

