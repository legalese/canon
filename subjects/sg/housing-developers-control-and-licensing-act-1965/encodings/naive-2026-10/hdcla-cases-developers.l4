§ `ss 2 and 4`

#ASSERT NOT `the activity is housing development by a housing developer` `building homes for sale` 4
#ASSERT `the activity is housing development by a housing developer` `building homes for sale` 5
#ASSERT `the activity is housing development by a housing developer` `financing the building or purchase of homes` 10
#ASSERT `the activity is housing development by a housing developer` `building homes and financing their purchase` 5
#ASSERT NOT `the activity is housing development by a housing developer` `a licensed bank only lending for the development` 100
#ASSERT NOT `the activity is housing development by a housing developer` `a licensed insurer only lending for the development` 100

#ASSERT `carrying it out is an offence under section 4(8)` `building homes for sale` 20 FALSE
#ASSERT NOT `carrying it out is an offence under section 4(8)` `building homes for sale` 20 TRUE

§ `ss 4(10), 7 and 12(3)`

#ASSERT `the suspension is within section 7` 12 TRUE
#ASSERT NOT `the suspension is within section 7` 13 TRUE
#ASSERT NOT `the suspension is within section 7` 6 FALSE

#ASSERT `days to appeal to the Minister` `a licence refusal or condition` EQUALS 10
#ASSERT `days to appeal to the Minister` `a revocation or suspension` EQUALS 30
#ASSERT `days to appeal to the Minister` `a decision on selling the business` EQUALS 14

#ASSERT NOT `the Act expressly says the Minister's decision shall not be questioned in court` `a licence refusal or condition`
#ASSERT `the Act expressly says the Minister's decision shall not be questioned in court` `a revocation or suspension`

