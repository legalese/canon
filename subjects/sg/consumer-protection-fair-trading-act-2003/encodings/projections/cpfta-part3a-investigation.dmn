<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="definitions_part_3a_investigation_powers" name="Part 3A -- Investigation powers" namespace="https://legalese.com/l4/dmn/part_3a_investigation_powers" exporter="jl4">
  <inputData id="input_s" name="s">
    <variable id="input_s_var" name="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_o" name="o">
    <variable id="input_o_var" name="o" typeRef="Any"/>
  </inputData>
  <inputData id="input_n" name="n">
    <variable id="input_n_var" name="n" typeRef="Any"/>
  </inputData>
  <inputData id="input_e" name="e">
    <variable id="input_e_var" name="e" typeRef="Any"/>
  </inputData>
  <inputData id="input_w" name="w">
    <variable id="input_w_var" name="w" typeRef="Any"/>
  </inputData>
  <inputData id="input_s_2" name="s_2" label="s">
    <variable id="input_s_2_var" name="s_2" label="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_s_3" name="s_3" label="s">
    <variable id="input_s_3_var" name="s_3" label="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_s_4" name="s_4" label="s">
    <variable id="input_s_4_var" name="s_4" label="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_s_5" name="s_5" label="s">
    <variable id="input_s_5_var" name="s_5" label="s" typeRef="Any"/>
  </inputData>
  <inputData id="input_x" name="x">
    <variable id="input_x_var" name="x" typeRef="Any"/>
  </inputData>
  <inputData id="input_d" name="d">
    <variable id="input_d_var" name="d" typeRef="Any"/>
  </inputData>
  <decision id="decision_the_commission_may_conduct_an_investigation" name="the_Commission_may_conduct_an_investigation" label="the Commission may conduct an investigation">
    <variable id="decision_the_commission_may_conduct_an_investigation_var" name="the_Commission_may_conduct_an_investigation" label="the Commission may conduct an investigation" typeRef="boolean"/>
    <informationRequirement id="decision_the_commission_may_conduct_an_investigation_ir1">
      <requiredInput href="#input_s"/>
    </informationRequirement>
    <literalExpression id="decision_the_commission_may_conduct_an_investigation_literal">
      <text>s.there_are_reasonable_grounds_for_suspecting_that_a_supplier_has_engaged_is_engaging_or_is_likely_to_engage_in_an_unfair_practice or (s.there_are_reasonable_grounds_for_suspecting_that_a_person_has_knowingly_abetted_aided_permitted_or_procured_a_supplier_to_engage_in_an_unfair_practice or s.there_are_reasonable_grounds_for_suspecting_that_a_person_is_knowingly_abetting_aiding_permitting_or_procuring_a_supplier_to_engage_in_an_unfair_practice)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_validly_appointed_an_investigation_officer" name="the_person_is_validly_appointed_an_investigation_officer" label="the person is validly appointed an investigation officer">
    <variable id="decision_the_person_is_validly_appointed_an_investigation_officer_var" name="the_person_is_validly_appointed_an_investigation_officer" label="the person is validly appointed an investigation officer" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_validly_appointed_an_investigation_officer_ir1">
      <requiredInput href="#input_o"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_validly_appointed_an_investigation_officer_literal">
      <text>o's `the chief executive made the appointment` AND (CONSIDER o's `kind of appointee` WHEN `an officer or employee of the Commission` THEN TRUE WHEN `an auxiliary police officer appointed under Part 9 of the Police Force Act 2004` THEN TRUE WHEN `any other person` THEN FALSE)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_officer_has_complied_with_section_19_3" name="the_officer_has_complied_with_section_19_3" label="the officer has complied with section 19(3)">
    <variable id="decision_the_officer_has_complied_with_section_19_3_var" name="the_officer_has_complied_with_section_19_3" label="the officer has complied with section 19(3)" typeRef="boolean"/>
    <informationRequirement id="decision_the_officer_has_complied_with_section_19_3_ir1">
      <requiredInput href="#input_o"/>
    </informationRequirement>
    <literalExpression id="decision_the_officer_has_complied_with_section_19_3_literal">
      <text>(CONSIDER o's `kind of appointee` WHEN `an officer or employee of the Commission` THEN o's `the officer declared the officer's office` OTHERWISE TRUE) AND o's `the officer, on demand, produced to the person affected the identification card the chief executive issued`</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3" name="the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3" label="the refusal to comply is not an offence because the officer did not comply with section 19(3)">
    <variable id="decision_the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3_var" name="the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3" label="the refusal to comply is not an offence because the officer did not comply with section 19(3)" typeRef="boolean"/>
    <informationRequirement id="decision_the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3_ir1">
      <requiredDecision href="#decision_the_officer_has_complied_with_section_19_3"/>
    </informationRequirement>
    <informationRequirement id="decision_the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3_ir2">
      <requiredInput href="#input_o"/>
    </informationRequirement>
    <literalExpression id="decision_the_refusal_to_comply_is_not_an_offence_because_the_officer_did_not_comply_with_section_19_3_literal">
      <text>o.the_person_refuses_to_comply_with_a_request_demand_or_order_of_the_officer and not(the_officer_has_complied_with_section_19_3)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_notice_complies_with_section_20_2" name="the_notice_complies_with_section_20_2" label="the notice complies with section 20(2)">
    <variable id="decision_the_notice_complies_with_section_20_2_var" name="the_notice_complies_with_section_20_2" label="the notice complies with section 20(2)" typeRef="boolean"/>
    <informationRequirement id="decision_the_notice_complies_with_section_20_2_ir1">
      <requiredInput href="#input_n"/>
    </informationRequirement>
    <literalExpression id="decision_the_notice_complies_with_section_20_2_literal">
      <text>n.the_notice_indicates_the_purpose_for_which_the_document_article_or_information_is_required and n.the_notice_is_accompanied_by_a_copy_of_the_offences_under_sections_27_28_29_and_30</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information" name="the_Commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information" label="the Commission may require the production of a document or article or the provision of information">
    <variable id="decision_the_commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information_var" name="the_Commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information" label="the Commission may require the production of a document or article or the provision of information" typeRef="boolean"/>
    <informationRequirement id="decision_the_commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information_ir1">
      <requiredDecision href="#decision_the_notice_complies_with_section_20_2"/>
    </informationRequirement>
    <informationRequirement id="decision_the_commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information_ir2">
      <requiredInput href="#input_n"/>
    </informationRequirement>
    <literalExpression id="decision_the_commission_may_require_the_production_of_a_document_or_article_or_the_provision_of_information_literal">
      <text>n.the_notice_is_in_writing and (n.the_notice_is_given_to_a_supplier_or_person_mentioned_in_section_19_1 and (n.the_Commission_considers_the_specified_document_article_or_information_relevant_to_the_investigation and the_notice_complies_with_section_20_2))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_notice_requirements_of_section_21_2_are_met" name="the_notice_requirements_of_section_21_2_are_met" label="the notice requirements of section 21(2) are met">
    <variable id="decision_the_notice_requirements_of_section_21_2_are_met_var" name="the_notice_requirements_of_section_21_2_are_met" label="the notice requirements of section 21(2) are met" typeRef="boolean"/>
    <informationRequirement id="decision_the_notice_requirements_of_section_21_2_are_met_ir1">
      <requiredInput href="#input_e"/>
    </informationRequirement>
    <literalExpression id="decision_the_notice_requirements_of_section_21_2_are_met_literal">
      <text>e.the_occupier_was_given_a_written_notice and (e.the_number_of_working_days_notice_of_the_intended_entry_given_in_the_notice &gt;= 2 and (e.the_notice_indicates_the_subject_matter_and_purpose_of_the_investigation and e.the_notice_is_accompanied_by_a_copy_of_the_offences_under_sections_27_28_29_and_30))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_alternative_requirements_of_section_21_3_and_4_are_met" name="the_alternative_requirements_of_section_21_3_and_4_are_met" label="the alternative requirements of section 21(3) and (4) are met">
    <variable id="decision_the_alternative_requirements_of_section_21_3_and_4_are_met_var" name="the_alternative_requirements_of_section_21_3_and_4_are_met" label="the alternative requirements of section 21(3) and (4) are met" typeRef="boolean"/>
    <informationRequirement id="decision_the_alternative_requirements_of_section_21_3_and_4_are_met_ir1">
      <requiredInput href="#input_e"/>
    </informationRequirement>
    <literalExpression id="decision_the_alternative_requirements_of_section_21_3_and_4_are_met_literal">
      <text>e.the_investigation_officer_has_taken_all_the_steps_that_are_reasonably_practicable_to_give_notice_but_has_not_been_able_to_do_so and (e.evidence_of_the_authorisation_of_the_investigation_officer_and_of_every_authorised_assistant_is_produced and e.a_document_containing_the_information_about_subject_matter_purpose_and_the_offences_is_produced)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5" name="the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5" label="the entry without warrant is permitted, with the powers of section 21(5)">
    <variable id="decision_the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5_var" name="the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5" label="the entry without warrant is permitted, with the powers of section 21(5)" typeRef="boolean"/>
    <informationRequirement id="decision_the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5_ir1">
      <requiredDecision href="#decision_the_alternative_requirements_of_section_21_3_and_4_are_met"/>
    </informationRequirement>
    <informationRequirement id="decision_the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5_ir2">
      <requiredDecision href="#decision_the_notice_requirements_of_section_21_2_are_met"/>
    </informationRequirement>
    <informationRequirement id="decision_the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5_ir3">
      <requiredInput href="#input_e"/>
    </informationRequirement>
    <literalExpression id="decision_the_entry_without_warrant_is_permitted_with_the_powers_of_section_21_5_literal">
      <text>e.the_entry_is_in_connection_with_an_investigation_under_section_19_1 and (e.the_premises_are_reasonably_suspected_of_being_used_by_the_person_under_investigation_in_connection_with_an_unfair_practice and (e.the_entrant_is_an_investigation_officer_or_a_person_the_Commission_has_authorised_in_writing_to_accompany_and_assist and (the_notice_requirements_of_section_21_2_are_met or the_alternative_requirements_of_section_21_3_and_4_are_met)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_issue_a_warrant" name="the_court_may_issue_a_warrant" label="the court may issue a warrant">
    <variable id="decision_the_court_may_issue_a_warrant_var" name="the_court_may_issue_a_warrant" label="the court may issue a warrant" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_issue_a_warrant_ir1">
      <requiredInput href="#input_w"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_issue_a_warrant_literal">
      <text>w's `the applicant is the Commission` AND w's `the warrant names an investigation officer and one or more authorised assistants` AND (NOT (null OF (w's `the conditions established for the premises`)))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_authorise_the_power_in_respect_of_any_other_document" name="the_court_may_authorise_the_power_in_respect_of_any_other_document" label="the court may authorise the power in respect of any other document">
    <variable id="decision_the_court_may_authorise_the_power_in_respect_of_any_other_document_var" name="the_court_may_authorise_the_power_in_respect_of_any_other_document" label="the court may authorise the power in respect of any other document" typeRef="boolean"/>
    <informationRequirement id="decision_the_court_may_authorise_the_power_in_respect_of_any_other_document_ir1">
      <requiredDecision href="#decision_the_court_may_issue_a_warrant"/>
    </informationRequirement>
    <informationRequirement id="decision_the_court_may_authorise_the_power_in_respect_of_any_other_document_ir2">
      <requiredInput href="#input_w"/>
    </informationRequirement>
    <literalExpression id="decision_the_court_may_authorise_the_power_in_respect_of_any_other_document_literal">
      <text>(`the court may issue a warrant` OF w) AND (any OF (GIVEN c YIELD CONSIDER c WHEN `there are reasonable grounds for suspecting that there are on any premises documents which the Commission may require under section 20, and that if required they would be concealed, removed, tampered with or destroyed` THEN TRUE WHEN `there are reasonable grounds for suspecting that there are on any premises documents or goods within section 21, and that if notice is given under section 21(2) they would be concealed, removed, tampered with or destroyed` THEN TRUE OTHERWISE FALSE), (w's `the conditions established for the premises`))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_warrant_is_valid_in_form_and_in_force_when_exercised" name="the_warrant_is_valid_in_form_and_in_force_when_exercised" label="the warrant is valid in form and in force when exercised">
    <variable id="decision_the_warrant_is_valid_in_form_and_in_force_when_exercised_var" name="the_warrant_is_valid_in_form_and_in_force_when_exercised" label="the warrant is valid in form and in force when exercised" typeRef="boolean"/>
    <informationRequirement id="decision_the_warrant_is_valid_in_form_and_in_force_when_exercised_ir1">
      <requiredInput href="#input_w"/>
    </informationRequirement>
    <literalExpression id="decision_the_warrant_is_valid_in_form_and_in_force_when_exercised_literal">
      <text>w.the_warrant_indicates_the_subject_matter_and_purpose_of_the_investigation and (w.the_warrant_is_accompanied_by_a_copy_of_the_offences_under_sections_27_28_29_and_30 and (w.the_date_on_which_the_warrant_is_exercised &gt;= w.the_date_the_warrant_was_issued and w.the_date_on_which_the_warrant_is_exercised &lt; w.the_date_the_warrant_was_issued + duration("P1M")))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_warrant_is_properly_executed" name="the_warrant_is_properly_executed" label="the warrant is properly executed">
    <variable id="decision_the_warrant_is_properly_executed_var" name="the_warrant_is_properly_executed" label="the warrant is properly executed" typeRef="boolean"/>
    <informationRequirement id="decision_the_warrant_is_properly_executed_ir1">
      <requiredDecision href="#decision_the_warrant_is_valid_in_form_and_in_force_when_exercised"/>
    </informationRequirement>
    <informationRequirement id="decision_the_warrant_is_properly_executed_ir2">
      <requiredInput href="#input_w"/>
    </informationRequirement>
    <literalExpression id="decision_the_warrant_is_properly_executed_literal">
      <text>the_warrant_is_valid_in_form_and_in_force_when_exercised and (w.the_warrant_was_produced_to_the_person_against_whom_power_is_exercised and (if w.the_premises_are_unoccupied then w.the_officer_took_reasonable_steps_to_inform_the_occupier_of_the_intended_entry and ((if w.the_occupier_was_informed then w.the_occupier_or_the_occupier_s_representative_was_given_a_reasonable_opportunity_to_be_present else w.a_copy_of_the_warrant_was_left_in_a_prominent_place_on_the_premises) and w.the_premises_were_left_as_effectively_secured_as_they_were_found) else true))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_duty_to_provide_a_copy_of_a_seized_document_has_been_met" name="the_duty_to_provide_a_copy_of_a_seized_document_has_been_met" label="the duty to provide a copy of a seized document has been met">
    <variable id="decision_the_duty_to_provide_a_copy_of_a_seized_document_has_been_met_var" name="the_duty_to_provide_a_copy_of_a_seized_document_has_been_met" label="the duty to provide a copy of a seized document has been met" typeRef="boolean"/>
    <informationRequirement id="decision_the_duty_to_provide_a_copy_of_a_seized_document_has_been_met_ir1">
      <requiredInput href="#input_s_2"/>
    </informationRequirement>
    <literalExpression id="decision_the_duty_to_provide_a_copy_of_a_seized_document_has_been_met_literal">
      <text>not(s_2.the_seized_item_is_a_document and s_2.the_person_from_whose_possession_the_document_was_taken_requested_a_copy) or s_2.a_copy_was_provided</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_duty_to_inform_has_been_met" name="the_duty_to_inform_has_been_met" label="the duty to inform has been met">
    <variable id="decision_the_duty_to_inform_has_been_met_var" name="the_duty_to_inform_has_been_met" label="the duty to inform has been met" typeRef="boolean"/>
    <informationRequirement id="decision_the_duty_to_inform_has_been_met_ir1">
      <requiredInput href="#input_s_3"/>
    </informationRequirement>
    <literalExpression id="decision_the_duty_to_inform_has_been_met_literal">
      <text>s_3.the_owner_of_the_goods_document_or_information_was_informed_of_the_possession_seizure_or_detention and (if s_3.the_goods_were_seized_from_a_vending_machine then s_3.the_proprietor_named_on_the_machine_or_if_none_the_occupier_of_the_premises_was_informed else true)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_post_seizure_duties_have_been_met" name="the_post_seizure_duties_have_been_met" label="the post-seizure duties have been met">
    <variable id="decision_the_post_seizure_duties_have_been_met_var" name="the_post_seizure_duties_have_been_met" label="the post-seizure duties have been met" typeRef="boolean"/>
    <informationRequirement id="decision_the_post_seizure_duties_have_been_met_ir1">
      <requiredDecision href="#decision_the_duty_to_inform_has_been_met"/>
    </informationRequirement>
    <informationRequirement id="decision_the_post_seizure_duties_have_been_met_ir2">
      <requiredDecision href="#decision_the_duty_to_provide_a_copy_of_a_seized_document_has_been_met"/>
    </informationRequirement>
    <informationRequirement id="decision_the_post_seizure_duties_have_been_met_ir3">
      <requiredInput href="#input_s_4"/>
    </informationRequirement>
    <literalExpression id="decision_the_post_seizure_duties_have_been_met_literal">
      <text>the_duty_to_provide_a_copy_of_a_seized_document_has_been_met and (the_duty_to_inform_has_been_met and s_4.the_goods_document_or_information_were_placed_in_safe_custody)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_specified_person_may_retain_the_goods_document_or_information" name="the_specified_person_may_retain_the_goods_document_or_information" label="the specified person may retain the goods, document or information">
    <variable id="decision_the_specified_person_may_retain_the_goods_document_or_information_var" name="the_specified_person_may_retain_the_goods_document_or_information" label="the specified person may retain the goods, document or information" typeRef="boolean"/>
    <informationRequirement id="decision_the_specified_person_may_retain_the_goods_document_or_information_ir1">
      <requiredInput href="#input_s_5"/>
    </informationRequirement>
    <literalExpression id="decision_the_specified_person_may_retain_the_goods_document_or_information_literal">
      <text>not(s_5.a_court_has_ordered_otherwise) and (s_5.the_goods_document_or_information_retained_may_be_evidence_in_those_proceedings and not(s_5.proceedings_under_section_9_or_10_including_on_appeal_are_completed))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_investigation_officer_may_require_evidence_of_identity" name="the_investigation_officer_may_require_evidence_of_identity" label="the investigation officer may require evidence of identity">
    <variable id="decision_the_investigation_officer_may_require_evidence_of_identity_var" name="the_investigation_officer_may_require_evidence_of_identity" label="the investigation officer may require evidence of identity" typeRef="boolean"/>
    <informationRequirement id="decision_the_investigation_officer_may_require_evidence_of_identity_ir1">
      <requiredInput href="#input_x"/>
    </informationRequirement>
    <literalExpression id="decision_the_investigation_officer_may_require_evidence_of_identity_literal">
      <text>x.the_person_is_reasonably_believed_by_an_investigation_officer_to_have_engaged_in_an_unfair_practice_or_knowingly_abetted_aided_permitted_or_procured_a_supplier_to_do_so</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_investigation_officer_may_examine_the_person" name="the_investigation_officer_may_examine_the_person" label="the investigation officer may examine the person">
    <variable id="decision_the_investigation_officer_may_examine_the_person_var" name="the_investigation_officer_may_examine_the_person" label="the investigation officer may examine the person" typeRef="boolean"/>
    <informationRequirement id="decision_the_investigation_officer_may_examine_the_person_ir1">
      <requiredInput href="#input_x"/>
    </informationRequirement>
    <literalExpression id="decision_the_investigation_officer_may_examine_the_person_literal">
      <text>x.the_person_appears_to_be_acquainted_with_facts_or_circumstances_relevant_to_the_investigation</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_must_comply_with_the_written_notice_to_attend" name="the_person_must_comply_with_the_written_notice_to_attend" label="the person must comply with the written notice to attend">
    <variable id="decision_the_person_must_comply_with_the_written_notice_to_attend_var" name="the_person_must_comply_with_the_written_notice_to_attend" label="the person must comply with the written notice to attend" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_must_comply_with_the_written_notice_to_attend_ir1">
      <requiredInput href="#input_x"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_must_comply_with_the_written_notice_to_attend_literal">
      <text>x.the_person_appears_to_be_acquainted_with_facts_or_circumstances_relevant_to_the_investigation and x.the_person_is_within_the_limits_of_Singapore</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_statement_complies_with_section_25_3" name="the_statement_complies_with_section_25_3" label="the statement complies with section 25(3)">
    <variable id="decision_the_statement_complies_with_section_25_3_var" name="the_statement_complies_with_section_25_3" label="the statement complies with section 25(3)" typeRef="boolean"/>
    <informationRequirement id="decision_the_statement_complies_with_section_25_3_ir1">
      <requiredInput href="#input_x"/>
    </informationRequirement>
    <literalExpression id="decision_the_statement_complies_with_section_25_3_literal">
      <text>x.the_statement_is_in_writing and (x.the_statement_was_read_over_to_the_person and ((if x.the_person_does_not_understand_English then x.the_statement_was_interpreted_in_a_language_the_person_understands else true) and x.the_statement_was_signed_by_the_person))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_person_is_not_excused_from_disclosing_on_the_ground_that_disclosure_might_tend_to_incriminate" name="the_person_is_not_excused_from_disclosing_on_the_ground_that_disclosure_might_tend_to_incriminate" label="the person is not excused from disclosing on the ground that disclosure might tend to incriminate">
    <variable id="decision_the_person_is_not_excused_from_disclosing_on_the_ground_that_disclosure_might_tend_to_incriminate_var" name="the_person_is_not_excused_from_disclosing_on_the_ground_that_disclosure_might_tend_to_incriminate" label="the person is not excused from disclosing on the ground that disclosure might tend to incriminate" typeRef="boolean"/>
    <informationRequirement id="decision_the_person_is_not_excused_from_disclosing_on_the_ground_that_disclosure_might_tend_to_incriminate_ir1">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_the_person_is_not_excused_from_disclosing_on_the_ground_that_disclosure_might_tend_to_incriminate_literal">
      <text>d.the_person_is_required_under_a_provision_of_the_Act_to_disclose_information_or_a_document</text>
    </literalExpression>
  </decision>
  <decision id="decision_section_26_2_bars_admission_of_the_material_in_the_proceedings" name="section_26_2_bars_admission_of_the_material_in_the_proceedings" label="section 26(2) bars admission of the material in the proceedings">
    <variable id="decision_section_26_2_bars_admission_of_the_material_in_the_proceedings_var" name="section_26_2_bars_admission_of_the_material_in_the_proceedings" label="section 26(2) bars admission of the material in the proceedings" typeRef="boolean"/>
    <informationRequirement id="decision_section_26_2_bars_admission_of_the_material_in_the_proceedings_ir1">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_section_26_2_bars_admission_of_the_material_in_the_proceedings_literal">
      <text>d.the_person_claims_before_disclosing_that_disclosure_might_tend_to_incriminate_the_person and (d.the_proceedings_are_criminal_proceedings and not(d.the_proceedings_are_proceedings_under_Part_3B))</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_material_is_admissible_in_civil_proceedings_including_proceedings_under_the_act" name="the_material_is_admissible_in_civil_proceedings_including_proceedings_under_the_Act" label="the material is admissible in civil proceedings, including proceedings under the Act">
    <variable id="decision_the_material_is_admissible_in_civil_proceedings_including_proceedings_under_the_act_var" name="the_material_is_admissible_in_civil_proceedings_including_proceedings_under_the_Act" label="the material is admissible in civil proceedings, including proceedings under the Act" typeRef="boolean"/>
    <informationRequirement id="decision_the_material_is_admissible_in_civil_proceedings_including_proceedings_under_the_act_ir1">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_the_material_is_admissible_in_civil_proceedings_including_proceedings_under_the_act_literal">
      <text>not(d.the_proceedings_are_criminal_proceedings)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication" name="the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication" label="the professional legal adviser is not compelled to disclose the privileged communication">
    <variable id="decision_the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication_var" name="the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication" label="the professional legal adviser is not compelled to disclose the privileged communication" typeRef="boolean"/>
    <informationRequirement id="decision_the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication_ir1">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication_literal">
      <text>d.the_person_is_a_professional_legal_adviser_or_a_legal_counsel_in_an_entity_acting_in_that_capacity and d.the_information_or_document_is_or_contains_a_privileged_communication</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made" name="the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made" label="the adviser must still give the name and address, if known, of the person to whom or by whom the communication was made">
    <variable id="decision_the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made_var" name="the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made" label="the adviser must still give the name and address, if known, of the person to whom or by whom the communication was made" typeRef="boolean"/>
    <informationRequirement id="decision_the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made_ir1">
      <requiredDecision href="#decision_the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication"/>
    </informationRequirement>
    <informationRequirement id="decision_the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made_ir2">
      <requiredInput href="#input_d"/>
    </informationRequirement>
    <literalExpression id="decision_the_adviser_must_still_give_the_name_and_address_if_known_of_the_person_to_whom_or_by_whom_the_communication_was_made_literal">
      <text>the_professional_legal_adviser_is_not_compelled_to_disclose_the_privileged_communication</text>
    </literalExpression>
  </decision>
