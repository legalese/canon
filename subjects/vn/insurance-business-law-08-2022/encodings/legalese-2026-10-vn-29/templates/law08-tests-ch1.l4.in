@lang en
IMPORT prelude
IMPORT daydate
IMPORT `law08-vintage`
IMPORT `law08-nouns`
IMPORT `law08-ch1-general`

-- Tests for Chuong I (Dieu 1-14). Every expected value is read from the source lines cited,
-- never from what the code printed. V1 is pinned at 1 June 2025, V2 at 1 March 2026, V3 at
-- 1 August 2026 (law08-vintage.l4). A fixture names only the facts that are TRUE (the rest
-- default to FALSE, 0, YMD 2000 1 1, NOTHING or EMPTY, as tools/expand.py documents).

§ `Tests: Chuong I`

§§ `Dieu 1(2)`

@@q 30 31
@ref Dieu 1 (src:30-31)
@@fx `a social insurance scheme` : `An insurance scheme` ; `is social insurance` = TRUE
@@fx `a State health insurance scheme` : `An insurance scheme` ; `is health insurance` = TRUE
@@fx `a deposit insurance scheme` : `An insurance scheme` ; `is deposit insurance` = TRUE
@@fx `another State non-business scheme` : `An insurance scheme` ; `is another kind of insurance the State provides without a business character` = TRUE
@@fx `a commercial scheme` : `An insurance scheme`

#ASSERT NOT `Dieu 1(2): the Law applies to the scheme` `a social insurance scheme`
#ASSERT NOT `Dieu 1(2): the Law applies to the scheme` `a State health insurance scheme`
#ASSERT NOT `Dieu 1(2): the Law applies to the scheme` `a deposit insurance scheme`
#ASSERT NOT `Dieu 1(2): the Law applies to the scheme` `another State non-business scheme`
#ASSERT `Dieu 1(2): the Law applies to the scheme` `a commercial scheme`

§§ `Dieu 3`

@@q 50 56
@ref Dieu 3 (src:50-56)
@@fx `a later law that differs and says so` : `A later law` ; `was issued after the Law took effect` = TRUE ; `differs on a matter Dieu 3(1) lists` = TRUE ; `states specifically which content is applied or not applied under this Law` = TRUE
@@fx `a later law that differs and is silent` : `A later law` ; `was issued after the Law took effect` = TRUE ; `differs on a matter Dieu 3(1) lists` = TRUE
@@fx `a later law that does not differ` : `A later law` ; `was issued after the Law took effect` = TRUE
@@fx `an earlier law that differs` : `A later law` ; `differs on a matter Dieu 3(1) lists` = TRUE

#ASSERT `Dieu 3(1): the later law meets the condition of Dieu 3(1)` `a later law that differs and says so`
#ASSERT NOT `Dieu 3(1): the later law meets the condition of Dieu 3(1)` `a later law that differs and is silent`
#ASSERT `Dieu 3(1): the later law meets the condition of Dieu 3(1)` `a later law that does not differ`
#ASSERT `Dieu 3(1): the later law meets the condition of Dieu 3(1)` `an earlier law that differs`

@@q 57 62
@ref Dieu 3 (src:57-62)
@@fx `a custom agreed with a foreign party` : `An agreement to apply international custom` ; `the contract is one of insurance, reinsurance or brokerage` = TRUE ; `the parties agreed to apply the custom` = TRUE ; `at least one party is a foreign organisation or individual` = TRUE
@@fx `a custom agreed by Vietnamese parties for a risk abroad` : `An agreement to apply international custom` ; `the contract is one of insurance, reinsurance or brokerage` = TRUE ; `the parties agreed to apply the custom` = TRUE ; `all parties are Vietnamese organisations or citizens` = TRUE ; `the object of insurance or the performance of the contract is abroad` = TRUE
@@fx `a custom agreed by Vietnamese parties for a risk at home` : `An agreement to apply international custom` ; `the contract is one of insurance, reinsurance or brokerage` = TRUE ; `the parties agreed to apply the custom` = TRUE ; `all parties are Vietnamese organisations or citizens` = TRUE
@@fx `a custom with a foreign party but not agreed` : `An agreement to apply international custom` ; `the contract is one of insurance, reinsurance or brokerage` = TRUE ; `at least one party is a foreign organisation or individual` = TRUE
@@fx `a custom whose consequence offends Vietnamese principles` : `An agreement to apply international custom` ; `the contract is one of insurance, reinsurance or brokerage` = TRUE ; `the parties agreed to apply the custom` = TRUE ; `at least one party is a foreign organisation or individual` = TRUE ; `applying the custom would be contrary to the basic principles of Vietnamese law` = TRUE

#ASSERT `Dieu 3(2): international custom applies` `a custom agreed with a foreign party`
#ASSERT `Dieu 3(2): international custom applies` `a custom agreed by Vietnamese parties for a risk abroad`
#ASSERT NOT `Dieu 3(2): international custom applies` `a custom agreed by Vietnamese parties for a risk at home`
#ASSERT NOT `Dieu 3(2): international custom applies` `a custom with a foreign party but not agreed`
#ASSERT NOT `Dieu 3(2): international custom applies` `a custom whose consequence offends Vietnamese principles`

-- Dieu 3(3) is added by Law 139/2025/QH15 Dieu 1(1): V1 has no such provision.
@@qa 24 30
@ref Law 139/2025/QH15 Dieu 1 (src:law139-2025-qh15:24-30)
@@fx `a foreign investor with the right to found an enterprise` : `A would-be investor` ; `the target is an insurer, reinsurer, broker, mutual organisation or foreign branch` = TRUE
@@fx `a person with no right to found an enterprise` : `A would-be investor` ; `the target is an insurer, reinsurer, broker, mutual organisation or foreign branch` = TRUE ; `has no right to found and manage an enterprise in Vietnam under the Law on Enterprises` = TRUE
@@fx `an investor in a target the Law does not list` : `A would-be investor`

#ASSERT REFUSED `EVAL UNDER RULES EFFECTIVE AT` (YMD 2025 6 1) (`Dieu 3(3): the person has the right to contribute capital to found, manage and control` `a foreign investor with the right to found an enterprise`)
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 3(3): the person has the right to contribute capital to found, manage and control` `a foreign investor with the right to found an enterprise`)
#ASSERT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 8 1) (`Dieu 3(3): the person has the right to contribute capital to found, manage and control` `a foreign investor with the right to found an enterprise`)
#ASSERT NOT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 3 1) (`Dieu 3(3): the person has the right to contribute capital to found, manage and control` `a person with no right to found an enterprise`)
#ASSERT NOT `EVAL UNDER RULES EFFECTIVE AT` (YMD 2026 8 1) (`Dieu 3(3): the person has the right to contribute capital to found, manage and control` `an investor in a target the Law does not list`)

§§ `Dieu 4: the activities (4(1)-(12))`

@@q 69 75
@ref Dieu 4 (src:69-75)
@@fx `an insurer taking a risk for premium` : `An activity` ; `carried on by` = `a non-life insurer` ; `accepts the risk of the insured person` = TRUE ; `the policyholder pays premium for it` = TRUE ; `pays on the insured event as the contract agrees` = TRUE
@@fx `a reinsurer doing the same` : `An activity` ; `carried on by` = `a reinsurer` ; `accepts the risk of the insured person` = TRUE ; `the policyholder pays premium for it` = TRUE ; `pays on the insured event as the contract agrees` = TRUE
@@fx `a mutual organisation doing the same` : `An activity` ; `carried on by` = `a microinsurance mutual organisation` ; `accepts the risk of the insured person` = TRUE ; `the policyholder pays premium for it` = TRUE ; `pays on the insured event as the contract agrees` = TRUE
@@fx `an insurer taking a risk without premium` : `An activity` ; `carried on by` = `a life insurer` ; `accepts the risk of the insured person` = TRUE ; `pays on the insured event as the contract agrees` = TRUE

#ASSERT `Dieu 4(2): the activity is insurance business` `an insurer taking a risk for premium`
#ASSERT NOT `Dieu 4(2): the activity is insurance business` `a reinsurer doing the same`
#ASSERT `Dieu 4(2): the activity is insurance business` `a mutual organisation doing the same`
#ASSERT NOT `Dieu 4(2): the activity is insurance business` `an insurer taking a risk without premium`

@@q 78 89
@ref Dieu 4 (src:78-89)
@@fx `a reinsurer taking reinsurance premium` : `An activity` ; `carried on by` = `a reinsurer` ; `receives a reinsurance premium from another insurer, reinsurer, branch, foreign insurer, foreign reinsurer or foreign insurance organisation` = TRUE ; `undertakes to compensate for the liabilities taken` = TRUE
@@fx `a foreign branch taking reinsurance premium` : `An activity` ; `carried on by` = `a branch of a foreign reinsurer` ; `receives a reinsurance premium from another insurer, reinsurer, branch, foreign insurer, foreign reinsurer or foreign insurance organisation` = TRUE ; `undertakes to compensate for the liabilities taken` = TRUE
@@fx `a mutual organisation taking reinsurance premium` : `An activity` ; `carried on by` = `a microinsurance mutual organisation` ; `receives a reinsurance premium from another insurer, reinsurer, branch, foreign insurer, foreign reinsurer or foreign insurance organisation` = TRUE ; `undertakes to compensate for the liabilities taken` = TRUE
@@fx `an insurer ceding part of its liability` : `An activity` ; `carried on by` = `a life insurer` ; `transfers part of the liability taken in reinsurance to another insurer, reinsurer, branch or foreign body` = TRUE ; `pays a ceding premium for the transfer` = TRUE
@@fx `an insurer ceding without paying` : `An activity` ; `carried on by` = `a life insurer` ; `transfers part of the liability taken in reinsurance to another insurer, reinsurer, branch or foreign body` = TRUE

#ASSERT `Dieu 4(3): the activity is reinsurance business` `a reinsurer taking reinsurance premium`
#ASSERT `Dieu 4(3): the activity is reinsurance business` `a foreign branch taking reinsurance premium`
#ASSERT NOT `Dieu 4(3): the activity is reinsurance business` `a mutual organisation taking reinsurance premium`
#ASSERT `Dieu 4(4): the activity is ceding of reinsurance` `an insurer ceding part of its liability`
#ASSERT NOT `Dieu 4(4): the activity is ceding of reinsurance` `an insurer ceding without paying`

@@q 90 100
@ref Dieu 4 (src:90-100)
@@fx `an authorised agent that only collects premium` : `An activity` ; `carried on by` = `a life insurer` ; `acts under the authorisation of an insurer, a branch or a mutual organisation` = TRUE ; `collects premium` = TRUE
@@fx `an unauthorised person that collects premium` : `An activity` ; `carried on by` = `a life insurer` ; `collects premium` = TRUE
@@fx `an authorised person doing none of the six acts` : `An activity` ; `carried on by` = `a life insurer` ; `acts under the authorisation of an insurer, a branch or a mutual organisation` = TRUE
@@fx `a person advising a policyholder on insurers` : `An activity` ; `carried on by` = `a life insurer` ; `provides information and advice to the policyholder on types, products, programmes, terms, premium or insurers` = TRUE
@@fx `a person negotiating a contract` : `An activity` ; `carried on by` = `a life insurer` ; `negotiates, arranges the making of or performs insurance or reinsurance contracts` = TRUE
@@fx `a person doing neither` : `An activity` ; `carried on by` = `a life insurer`

#ASSERT `Dieu 4(5): the activity is insurance agency activity` `an authorised agent that only collects premium`
#ASSERT NOT `Dieu 4(5): the activity is insurance agency activity` `an unauthorised person that collects premium`
#ASSERT NOT `Dieu 4(5): the activity is insurance agency activity` `an authorised person doing none of the six acts`
#ASSERT `Dieu 4(6): the activity is insurance brokerage activity` `a person advising a policyholder on insurers`
#ASSERT `Dieu 4(6): the activity is insurance brokerage activity` `a person negotiating a contract`
#ASSERT NOT `Dieu 4(6): the activity is insurance brokerage activity` `a person doing neither`

@@q 101 125
@ref Dieu 4 (src:101-125)
@@fx `an independent loss adjuster` : `An ancillary activity` ; `determines the condition, cause and extent of a loss and apportions liability` = TRUE
@@fx `an insurer adjusting its own losses` : `An ancillary activity` ; `determines the condition, cause and extent of a loss and apportions liability` = TRUE ; `is done by the insurer, reinsurer, branch or mutual organisation itself for its own business` = TRUE
@@fx `an actuary computing premium` : `An ancillary activity` ; `collects and analyses statistics, computes premium, reserves, capital or solvency` = TRUE
@@fx `an adviser` : `An ancillary activity` ; `is advice on insurance programmes, products, risk management or loss prevention` = TRUE
@@fx `a risk assessor` : `An ancillary activity` ; `identifies, classifies and assesses the nature and degree of insurable risk` = TRUE
@@fx `a claims helper` : `An ancillary activity` ; `helps a policyholder, insured person, beneficiary or insurer with claims procedures` = TRUE
@@fx `a bystander` : `An ancillary activity`

#ASSERT `Dieu 4(7): the activity is an ancillary insurance service` `an independent loss adjuster`
#ASSERT NOT `Dieu 4(7): the activity is an ancillary insurance service` `an insurer adjusting its own losses`
#ASSERT NOT `Dieu 4(7): the activity is an ancillary insurance service` `a bystander`
#ASSERT `Dieu 4(8): the activity is advice (tu van)` `an adviser`
#ASSERT `Dieu 4(9): the activity is insurance risk assessment` `a risk assessor`
#ASSERT `Dieu 4(10): the activity is actuarial work (tinh toan bao hiem)` `an actuary computing premium`
#ASSERT `Dieu 4(11): the activity is insurance loss adjustment (giam dinh ton that)` `an independent loss adjuster`
#ASSERT `Dieu 4(12): the activity is claims support` `a claims helper`
#ASSERT NOT `Dieu 4(12): the activity is claims support` `a bystander`
#ASSERT `Dieu 4(1): the activity is insurance business activity (hoat dong kinh doanh bao hiem)` `an authorised agent that only collects premium` `a bystander`
#ASSERT `Dieu 4(1): the activity is insurance business activity (hoat dong kinh doanh bao hiem)` `a person doing neither` `an actuary computing premium`
#ASSERT NOT `Dieu 4(1): the activity is insurance business activity (hoat dong kinh doanh bao hiem)` `a person doing neither` `a bystander`

§§ `Dieu 4: the covers (4(13)-(15), (22))`

@@q 126 131
@ref Dieu 4 (src:126-131)
@@fx `a cover on survival` : `A cover` ; `covers the insured person living or dying` = TRUE
@@fx `a cover on property` : `A cover` ; `covers damage to property and other losses` = TRUE
@@fx `a cover on civil liability` : `A cover` ; `covers civil liability to a third person` = TRUE
@@fx `a cover on illness` : `A cover` ; `covers injury, accident, illness, disease or health care` = TRUE
@@fx `a combined life and health cover` : `A cover` ; `covers the insured person living or dying` = TRUE ; `covers injury, accident, illness, disease or health care` = TRUE
@@fx `a micro cover for a poor household` : `A cover` ; `is directed at low-income individuals or households` = TRUE ; `protects against risks to life, health and property` = TRUE ; `covers damage to property and other losses` = TRUE
@@fx `a cover for the well-off` : `A cover` ; `protects against risks to life, health and property` = TRUE

