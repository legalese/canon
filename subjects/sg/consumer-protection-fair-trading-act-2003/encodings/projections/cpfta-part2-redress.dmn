  <decision id="decision_no_regulations_under_section_11_prescribing_a_class_of_cancellable_contracts_and_a_cancellation_period_are_encoded_in_this_model" name="no_regulations_under_section_11_prescribing_a_class_of_cancellable_contracts_and_a_cancellation_period_are_encoded_in_this_model" label="no regulations under section 11 prescribing a class of cancellable contracts and a cancellation period are encoded in this model">
