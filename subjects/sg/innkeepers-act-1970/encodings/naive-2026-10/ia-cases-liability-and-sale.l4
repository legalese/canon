IMPORT prelude
IMPORT `ia-liability-and-sale`

-- Innkeepers Act 1970, ss 2 to 7 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_innkeepers-act-1970.py). Expected results were written by
-- hand from the text.

§ `ss 2 and 6 -- what is an inn`

#ASSERT `the place is an inn for Part 1` `a hotel` TRUE
#ASSERT `the place is an inn for Part 1` `a restaurant` TRUE
#ASSERT `the place is an inn for Part 1` `another place of refreshment` TRUE
#ASSERT NOT `the place is an inn for Part 1` `a shop` TRUE

#ASSERT `the place is an inn for Part 2` `a hotel`
#ASSERT `the place is an inn for Part 2` `a public house`
#ASSERT NOT `the place is an inn for Part 2` `a restaurant`
#ASSERT NOT `the place is an inn for Part 2` `a shop`

§ `ss 3 to 5 -- the limit on liability`

#ASSERT NOT `the innkeeper may refuse safe custody` 5000
#ASSERT `the innkeeper may refuse safe custody` 5001

`laptop stolen from room` MEANS Claim WITH
    `the premises` IS `a hotel`
    `the keeper is responsible by law` IS TRUE
    `the property` IS `ordinary goods`
    `the loss` IS 2000
    `wilful act, default or neglect of the innkeeper or a servant` IS FALSE
    `deposited expressly for safe custody` IS FALSE
    `a value was declared` IS FALSE
    `the declared value` IS 0
    `a condition the innkeeper required was not met` IS FALSE
    `safe custody was refused` IS FALSE
    `the guest could not deposit through the innkeeper's default` IS FALSE
    `section 3 was exhibited when the goods were brought` IS TRUE

