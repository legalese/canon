#ASSERT `the appointment of the Public Trustee has effect` TRUE FALSE TRUE TRUE TRUE FALSE TRUE
#ASSERT `the appointment of the Public Trustee has effect` TRUE FALSE FALSE TRUE FALSE FALSE TRUE
#ASSERT NOT `the appointment of the Public Trustee has effect` TRUE FALSE TRUE FALSE FALSE TRUE TRUE
#ASSERT `the appointment of the Public Trustee has effect` TRUE FALSE TRUE FALSE FALSE FALSE FALSE

#ASSERT `the beneficiary is in time to apply to prohibit` 21
#ASSERT NOT `the beneficiary is in time to apply to prohibit` 22

§ `s 8(2), (4)`

#ASSERT `the next of kin is preferred to the Public Trustee` FALSE
#ASSERT NOT `the next of kin is preferred to the Public Trustee` TRUE

#ASSERT `the executor may apply to transfer the estate` TRUE TRUE
#ASSERT NOT `the executor may apply to transfer the estate` TRUE FALSE

§ `ss 12A(4), 13(7)`

#ASSERT `the income is distributed in time` 45
#ASSERT NOT `the income is distributed in time` 46

#ASSERT `the Investment Board is quorate` TRUE 2
#ASSERT NOT `the Investment Board is quorate` TRUE 1
#ASSERT NOT `the Investment Board is quorate` FALSE 4

§ `s 17`

#ASSERT `the Consolidated Fund must make good the liability` TRUE TRUE FALSE
#ASSERT `the Consolidated Fund must make good the liability` TRUE FALSE TRUE
#ASSERT NOT `the Consolidated Fund must make good the liability` TRUE FALSE FALSE
#ASSERT NOT `the Consolidated Fund must make good the liability` FALSE TRUE TRUE

