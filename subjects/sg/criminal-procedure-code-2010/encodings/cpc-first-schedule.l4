      , (`First Schedule Row` OF "489D", "489D", "Making or possessing instruments or materials for forging or counterfeiting currency or bank notes", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 20 years, and fine", `District Court`, "CHAPTER 18 -- OFFENCES RELATING TO DOCUMENTS OR ELECTRONIC RECORDS, FALSE INSTRUMENTS, AND TO CURRENCY NOTES AND BANK NOTES / Currency and bank notes", "", 451)
      , (`First Schedule Row` OF "489E", "489E", "Abetting in Singapore counterfeiting of currency out of Singapore", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "The punishment provided for abetting the counterfeiting of such currency within Singapore", `District Court`, "CHAPTER 18 -- OFFENCES RELATING TO DOCUMENTS OR ELECTRONIC RECORDS, FALSE INSTRUMENTS, AND TO CURRENCY NOTES AND BANK NOTES / Currency and bank notes", "", 451)
      , (`First Schedule Row` OF "489F", "489F", "Fraudulently or dishonestly diminishing weight or altering composition of coin", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 7 years, and fine", `District Court`, "CHAPTER 18 -- OFFENCES RELATING TO DOCUMENTS OR ELECTRONIC RECORDS, FALSE INSTRUMENTS, AND TO CURRENCY NOTES AND BANK NOTES / Currency and bank notes", "", 451)
      , (`First Schedule Row` OF "489G", "489G", "Altering appearance of currency with intent that it passes as currency of different description", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 7 years, and fine", `District Court`, "CHAPTER 18 -- OFFENCES RELATING TO DOCUMENTS OR ELECTRONIC RECORDS, FALSE INSTRUMENTS, AND TO CURRENCY NOTES AND BANK NOTES / Currency and bank notes", "", 451)
