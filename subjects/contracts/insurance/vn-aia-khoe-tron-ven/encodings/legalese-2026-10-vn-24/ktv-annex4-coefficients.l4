-- src:1929 | Tuổi phát hành Hệ số bảo hiểm tối thiểu Hệ số bảo hiểm tối đa
-- src:1931 | 0-4 65 90
-- src:1938 | 5-9 65 90
-- src:1940 | 10 - 14 65 90
-- src:1942 | 15 - 19 55 80
-- src:1944 | 20 - 24 50 75
