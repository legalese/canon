#ASSERT NOT `the name contravenes section 5` `a licensed bank`
#ASSERT `the name contravenes section 5` `a fintech calling itself a digital bank`
#ASSERT NOT `the name contravenes section 5` `a food bank charity`
#ASSERT `the name contravenes section 5` `a lender calling itself Bank Pinjaman`
#ASSERT NOT `the name contravenes section 5` `a shop with no bank in its name`

§ `s 47`

#ASSERT NOT `the bank may disclose customer information` `the customer's spouse, without written consent`
#ASSERT `the bank may disclose customer information` `anyone, with the customer's written consent`
#ASSERT NOT `the bank may disclose customer information` `anyone, with the customer's oral consent`
#ASSERT `the bank may disclose customer information` `a person the bank believes entitled to probate`
#ASSERT `the bank may disclose customer information` `the police under a specified written law`
#ASSERT `the bank may disclose customer information` `a creditor under an attachment order served on the bank`
#ASSERT `the bank may disclose customer information` `a court ordering disclosure under the Evidence Act`
#ASSERT `the bank may disclose customer information` `the Monetary Authority of Singapore`
#ASSERT NOT `the bank may disclose customer information` `a journalist`

#ASSERT `the maximum imprisonment for a secrecy breach` EQUALS 36

§ `s 57`

#ASSERT `the card business contravenes section 57` FALSE TRUE
#ASSERT NOT `the card business contravenes section 57` TRUE TRUE
#ASSERT NOT `the card business contravenes section 57` FALSE FALSE

§ `ss 61, 62`

#ASSERT `the rank` `deposit insurance premiums owed by the bank` EQUALS 1
#ASSERT `the rank` `insured deposits up to the compensation` EQUALS 2
#ASSERT `the rank` `uninsured Singapore-dollar deposits` EQUALS 3
#ASSERT `the rank` `foreign-currency deposits` EQUALS 4
#ASSERT `the rank` `a resolution fund's claim` EQUALS 5
#ASSERT `the rank` `an ordinary unsecured creditor` EQUALS 6

#ASSERT `the first is paid before the second` `deposit insurance premiums owed by the bank` `insured deposits up to the compensation`
#ASSERT `the first is paid before the second` `uninsured Singapore-dollar deposits` `foreign-currency deposits`
#ASSERT NOT `the first is paid before the second` `foreign-currency deposits` `uninsured Singapore-dollar deposits`
#ASSERT `the first is paid before the second` `foreign-currency deposits` `an ordinary unsecured creditor`

#ASSERT `my payout` 1000 100000 100000 EQUALS 1000
