IMPORT prelude
IMPORT `sta-requisitions`

-- Statistics Act 1973, ss 5 to 11 and First and Third Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_statistics-act-1973.py). Expected results were written by
-- hand from the text.

`a CPI survey from the Chief Statistician` MEANS Requisition WITH
    `issued by` IS `the Chief Statistician`
    `about` IS `prices and charges`
    `in writing` IS TRUE
    `served under section 11` IS TRUE
    `specifies the particulars required` IS TRUE

`a visitor survey from a unit director` MEANS Requisition WITH
    `issued by` IS `the director of a research and statistics unit`
    `about` IS `tourism`
    `in writing` IS TRUE
    `served under section 11` IS TRUE
    `specifies the particulars required` IS TRUE

`a questionnaire from a market research firm` MEANS Requisition WITH
    `issued by` IS `a private market research firm`
    `about` IS `prices and charges`
    `in writing` IS TRUE
    `served under section 11` IS TRUE
    `specifies the particulars required` IS TRUE

`a survey from an unlisted ministry division` MEANS Requisition WITH
    `issued by` IS `a ministry division not listed in the Second Schedule`
    `about` IS `housing`
    `in writing` IS TRUE
    `served under section 11` IS TRUE
    `specifies the particulars required` IS TRUE

`a Chief Statistician survey on an unlisted subject` MEANS Requisition WITH
    `issued by` IS `the Chief Statistician`
    `about` IS `a subject not listed in the First Schedule`
    `in writing` IS TRUE
    `served under section 11` IS TRUE
    `specifies the particulars required` IS TRUE

`an oral request from the Chief Statistician` MEANS Requisition WITH
    `issued by` IS `the Chief Statistician`
    `about` IS `housing`
    `in writing` IS FALSE
    `served under section 11` IS TRUE
    `specifies the particulars required` IS TRUE

`aggregate statistics published by the Chief Statistician` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a newspaper`
    `may identify a person` IS FALSE
    `as anonymised microdata` IS FALSE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`a named respondent's answers given to a newspaper` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a newspaper`
    `may identify a person` IS TRUE
    `as anonymised microdata` IS FALSE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`a named respondent's answers released with written consent` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a newspaper`
    `may identify a person` IS TRUE
    `as anonymised microdata` IS FALSE
    `prior written consent of the person identified` IS TRUE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`microdata released to a public agency` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a public agency`
    `may identify a person` IS FALSE
    `as anonymised microdata` IS TRUE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`microdata released to a supported university researcher` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a university researcher whose research the university supports`
    `may identify a person` IS FALSE
    `as anonymised microdata` IS TRUE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`microdata released to a private company` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a private company`
    `may identify a person` IS FALSE
    `as anonymised microdata` IS TRUE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`microdata passed on by a consultant to a private company` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS FALSE
    `to` IS `a private company`
    `may identify a person` IS FALSE
    `as anonymised microdata` IS TRUE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`an establishment's address released by the Chief Statistician` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS TRUE
    `to` IS `a private company`
    `may identify a person` IS TRUE
    `as anonymised microdata` IS FALSE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS TRUE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`an establishment's address leaked by a junior officer` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS FALSE
    `to` IS `a private company`
    `may identify a person` IS TRUE
    `as anonymised microdata` IS FALSE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS TRUE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS FALSE

`a researcher breaching a use condition` MEANS Disclosure WITH
    `obtained under section 5 or 6` IS TRUE
    `made by the Chief Statistician or a director` IS FALSE
    `to` IS `a private company`
    `may identify a person` IS FALSE
    `as anonymised microdata` IS FALSE
    `prior written consent of the person identified` IS FALSE
    `for proceedings for an offence under this Act` IS FALSE
    `general information about an establishment` IS FALSE
    `already in the public domain` IS FALSE
    `breaches a condition imposed under section 7(3)` IS TRUE

§ `s 5 and First Schedule`

#ASSERT `the requisition is valid` `a CPI survey from the Chief Statistician`
#ASSERT `the requisition is valid` `a visitor survey from a unit director`
#ASSERT NOT `the requisition is valid` `a questionnaire from a market research firm`
#ASSERT NOT `the requisition is valid` `a survey from an unlisted ministry division`
#ASSERT NOT `the requisition is valid` `a Chief Statistician survey on an unlisted subject`
#ASSERT NOT `the requisition is valid` `an oral request from the Chief Statistician`

#ASSERT `the person is bound to furnish the item` `a CPI survey from the Chief Statistician` TRUE FALSE
#ASSERT `the person is bound to furnish the item` `a CPI survey from the Chief Statistician` FALSE TRUE
#ASSERT NOT `the person is bound to furnish the item` `a CPI survey from the Chief Statistician` FALSE FALSE
#ASSERT NOT `the person is bound to furnish the item` `a questionnaire from a market research firm` TRUE TRUE

§ `s 6`

#ASSERT `the recipient must comply with the direction` TRUE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `the recipient must comply with the direction` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT `the recipient must comply with the direction` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT `the recipient must comply with the direction` TRUE TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `the recipient must comply with the direction` TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `the recipient must comply with the direction` FALSE FALSE FALSE FALSE FALSE FALSE

§ `s 7 and Third Schedule`

#ASSERT NOT `the disclosure is an offence` `aggregate statistics published by the Chief Statistician`
#ASSERT `the disclosure is an offence` `a named respondent's answers given to a newspaper`
#ASSERT NOT `the disclosure is an offence` `a named respondent's answers released with written consent`
#ASSERT NOT `the disclosure is an offence` `microdata released to a public agency`
#ASSERT NOT `the disclosure is an offence` `microdata released to a supported university researcher`
#ASSERT `the disclosure is an offence` `microdata released to a private company`
#ASSERT `the disclosure is an offence` `microdata passed on by a consultant to a private company`
#ASSERT NOT `the disclosure is an offence` `an establishment's address released by the Chief Statistician`
#ASSERT `the disclosure is an offence` `an establishment's address leaked by a junior officer`
#ASSERT `the disclosure is an offence` `a researcher breaching a use condition`

§ `s 9(1)`

#ASSERT `a section 9(1) offence is committed` TRUE TRUE FALSE FALSE FALSE
#ASSERT `a section 9(1) offence is committed` TRUE TRUE FALSE TRUE FALSE
#ASSERT `a section 9(1) offence is committed` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `a section 9(1) offence is committed` TRUE FALSE TRUE TRUE FALSE
#ASSERT `a section 9(1) offence is committed` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT `a section 9(1) offence is committed` FALSE TRUE FALSE FALSE FALSE

§ `ss 7(4), 8, 9 and 10`

#ASSERT `the maximum fine in dollars` `failing to answer a requisition` 0 EQUALS 1000
#ASSERT `the maximum fine in dollars` `failing to answer a requisition` 10 EQUALS 2000
#ASSERT `the maximum fine in dollars` `unlawful disclosure` 0 EQUALS 10000
#ASSERT `the maximum fine in dollars` `impersonating a statistical officer` 0 EQUALS 0

#ASSERT `the maximum imprisonment in months` `failing to answer a requisition` EQUALS 0
#ASSERT `the maximum imprisonment in months` `unlawful disclosure` EQUALS 12
#ASSERT `the maximum imprisonment in months` `impersonating a statistical officer` EQUALS 6

#ASSERT `the offence may be compounded for the sum` `failing to answer a requisition` 200
#ASSERT `the offence may be compounded for the sum` `giving false particulars` 150
#ASSERT NOT `the offence may be compounded for the sum` `failing to answer a requisition` 250
#ASSERT NOT `the offence may be compounded for the sum` `unlawful disclosure` 100

§ `s 11`

#ASSERT NOT `the method is good service` `an individual` `fax` FALSE
#ASSERT `the method is good service` `an individual` `affixing it at the address` FALSE
#ASSERT `the method is good service` `a company` `fax` FALSE
#ASSERT NOT `the method is good service` `a company` `affixing it at the address` FALSE
