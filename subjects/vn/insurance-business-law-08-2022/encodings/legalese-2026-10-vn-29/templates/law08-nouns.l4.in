DECLARE `A founding shareholder or member` HAS
    `has the right to found and manage an enterprise in Vietnam under the Law on Enterprises` IS A BOOLEAN
    `is an organisation with legal personality that operates lawfully` IS A BOOLEAN
    `contribution as a share of charter capital`             IS A NUMBER
    `was profitable in each of the latest 3 consecutive financial years to the date of the application` IS A BOOLEAN
    `meets the financial conditions the Government sets`     IS A BOOLEAN
    `is an insurer or reinsurer already licensed in Vietnam` IS A BOOLEAN
    `meets the capital adequacy ratio under this Law`        IS A BOOLEAN

@@q 1180 1190
@ref Dieu 64 (src:1180-1190)
DECLARE `A licence application` HAS
    `charter capital is contributed in Vietnamese dong`      IS A BOOLEAN
    `charter capital`                                        IS A NUMBER
    `minimum charter capital the Government sets`            IS A MAYBE NUMBER
    `founders use borrowed capital or funds entrusted by others` IS A BOOLEAN
    `has a chair, a chief executive, a legal representative and an actuary expected to meet the conditions of Dieu 81` IS A BOOLEAN
    `has an organisational form this Law provides`           IS A BOOLEAN
    `has a draft charter consistent with the Law on Enterprises` IS A BOOLEAN

@@q 1191 1228
@ref Dieu 65 (src:1191-1228)
DECLARE `A member of a limited liability insurer` HAS
    `is an organisation`                                     IS A BOOLEAN
    `meets the general conditions of Dieu 64`                IS A BOOLEAN
    `is established under foreign law`                       IS A BOOLEAN
    `is a foreign insurer, reinsurer or financial or insurance group` IS A BOOLEAN
    `a foreign authority confirmed no serious breach of insurance law in the latest 3 consecutive years` IS A BOOLEAN
    `has itself or through a subsidiary run the intended field for the latest 7 consecutive years` IS A BOOLEAN
    `total assets in the year before the application, in US dollars` IS A NUMBER
    `committed to financial, technological, governance, risk, management and operational support and to the Law's financial safety rules` IS A BOOLEAN
    `total assets in the year before the application, in Vietnamese dong` IS A NUMBER
    `minimum total assets the Government specifies for the period` IS A MAYBE NUMBER

@@q 1229 1242
@ref Dieu 66 (src:1229-1242)
DECLARE `The shareholders of a joint stock insurer` HAS
    `number of organisation shareholders each holding 10% or more of charter capital and meeting Dieu 65` IS A NUMBER
    `largest holding of one individual as a share of charter capital` IS A NUMBER

-- Dieu 67: a foreign branch.
@@q 1243 1279
@ref Dieu 67 (src:1243-1279)
DECLARE `A foreign branch applicant` HAS
    `the head office is in a country with a treaty with Vietnam allowing branches, and its regulator signed an agreement with the Ministry of Finance` IS A BOOLEAN
    `the home regulator allowed the branch within the lines the parent may carry on` IS A BOOLEAN
    `years of experience in the field intended`              IS A NUMBER
    `total assets in the year before the application, in US dollars` IS A NUMBER
    `profitable in each of the latest 3 consecutive financial years and meets the financial conditions the Government sets` IS A BOOLEAN
    `undertook to guarantee and answer for all obligations of the branch` IS A BOOLEAN
    `capital allocated in Vietnamese dong`                   IS A BOOLEAN
    `allocated capital`                                      IS A NUMBER
    `minimum allocated capital the Government sets`          IS A MAYBE NUMBER
    `capital is lawful and not borrowed or entrusted`        IS A BOOLEAN
    `has a branch director and an actuary expected to meet the conditions of Dieu 81` IS A BOOLEAN
    `is a non-life insurer or a reinsurer`                   IS A BOOLEAN

-- Dieu 69-72: dossier, time limits, publication.
@@q 1283 1305
@ref Dieu 69 (src:1283-1305)
DECLARE `A licence dossier` HAS
    `has the written application`                            IS A BOOLEAN
    `has the draft charter or draft rules of organisation`   IS A BOOLEAN
    `has the 5-year operating plan with the lines, risk governance, reserves, reinsurance, investment and solvency` IS A BOOLEAN
    `has the CVs, criminal records and qualifications of the proposed chair, chief executive, legal representative and actuary` IS A BOOLEAN
    `has the capital contribution, the list of holders of 10% or more and proof they meet Dieu 64-67` IS A BOOLEAN
    `has the list of beneficial owners`                      IS A BOOLEAN

@@q 1306 1342
@ref Dieu 70-72 (src:1306-1342)
DECLARE `A licence decision` HAS
    `date the Ministry of Finance received the complete and valid dossier` IS A DATE
    `date the Ministry of Finance granted or refused`        IS A DATE
    `the refusal was notified in writing with reasons`       IS A BOOLEAN
    `date the licence was granted`                           IS A DATE
    `date the Ministry of Finance published the licence`     IS A DATE
    `date of official operation`                             IS A DATE
    `date the insurer published the licence and the planned date of official operation` IS A DATE
    `published in 3 consecutive issues of a printed newspaper or in an online newspaper` IS A BOOLEAN

-- Dieu 73: before official operation (replaced by Law 139/2025/QH15 Dieu 1(3)).
@@q 1343 1379
@@qa 40 68
@ref Dieu 73 (src:1343-1379; src:law139-2025-qh15:40-68)
DECLARE `Preparation for official operation` HAS
    `date the licence was granted`                           IS A DATE
    `months of extension the Ministry of Finance approved in writing for force majeure or an objective obstacle` IS A MAYBE NUMBER
    `date of official operation`                             IS A DATE
    `the blocked capital was turned into charter or allocated capital` IS A BOOLEAN
    `the capital was paid in full`                           IS A BOOLEAN
    `the organisation, management, internal control, internal audit and risk systems were built and officers elected or appointed` IS A BOOLEAN
    `the legal representative and the officers approved in principle were elected or appointed` IS A BOOLEAN
    `internal rules and basic business procedures were issued` IS A BOOLEAN
    `the deposit was made in full at a commercial bank`      IS A BOOLEAN
    `premises, facilities and technology fit the business procedures` IS A BOOLEAN
    `the licence was published as Dieu 72(2) requires`       IS A BOOLEAN
    `date the insurer notified the Ministry of Finance that these were done` IS A DATE
    `carried on insurance business before the date of official operation` IS A BOOLEAN

-- Dieu 74: changes to an insurer.
@@q 1380 1411
@@qa 70 72
@ref Dieu 74 (src:1380-1411; src:law139-2025-qh15:70-72)
DECLARE `A change to an insurer` IS ONE OF
    `a change of name or of head office address`
    `a change of charter capital or allocated capital`
    `a change of content, scope or term of activity`
    `a transfer of shares taking a holder to or above 10%, or below 10%`
    `a change of the chair, the chief executive or the actuary`
    `a division, split, merger, consolidation, dissolution or change of form`
    `an investment abroad, including a branch or representative office`
    `a change of the charter or of the rules of a foreign branch`
    `opening, ending or moving a branch or representative office`
    `a change of the name of a branch or representative office`
    `opening, ending or moving a business location`
    `a change of the beneficial owners`

DECLARE `A step the Law requires for a change` IS ONE OF
    `prior written approval of the Ministry of Finance`
    `written notice to the Ministry of Finance within 15 days of the change`
    `no step stated`

-- Dieu 75: revocation of the licence.
@@q 1412 1426
@ref Dieu 75 (src:1412-1426)
DECLARE `A ground for revoking a licence` IS ONE OF
    `the dossier contained fraudulent information`
    `official operation did not begin within the time Dieu 73(1) allows`
    `the enterprise was divided, merged, consolidated, dissolved or ceased`
    `the enterprise acted outside the content of its licence`
    `a court declared the insurer or reinsurer bankrupt`
    `the foreign parent of a foreign branch was declared bankrupt or lost its licence`

-- Dieu 76-77: a representative office of a foreign body.
@@q 1439 1478
@ref Dieu 76-77 (src:1439-1478)
DECLARE `A foreign representative office` HAS
    `the activity is business of insurance in Vietnam`       IS A BOOLEAN
    `is a liaison office`                                    IS A BOOLEAN
    `is market research`                                     IS A BOOLEAN
    `promotes or monitors the investment projects of the parent` IS A BOOLEAN
    `is another activity consistent with Vietnamese law`     IS A BOOLEAN
    `term of operation in years`                             IS A NUMBER
    `years the parent has operated, latest`                  IS A NUMBER
    `the home regulator allowed the office`                  IS A BOOLEAN

-- Dieu 79: governance structure.
@@q 1497 1512
@ref Dieu 79 (src:1497-1512)
DECLARE `A governance structure` HAS
    `is a joint stock company`                               IS A BOOLEAN
    `has a general meeting of shareholders, a board and a chief executive` IS A BOOLEAN
    `has a supervisory board`                                IS A BOOLEAN
    `number of controllers on the supervisory board`         IS A NUMBER
    `number of board members`                                IS A NUMBER
    `number of independent board members`                    IS A NUMBER
    `has an audit committee under the board`                 IS A BOOLEAN
    `has a members' council and a chief executive`           IS A BOOLEAN

-- Dieu 80(4), 83(2): the 75 days to file a replacement.
@@q 1539 1545
@ref Dieu 80 (src:1539-1545)
DECLARE `A vacancy` HAS
    `date the chief executive or actuary left office`        IS A DATE
    `date the Ministry of Finance suspended the officer`     IS A DATE
    `date the insurer filed a valid dossier for a replacement` IS A DATE

-- Dieu 81: an officer.
@@q 1546 1603
@@qa 74 139
@ref Dieu 81 (src:1546-1603; src:law139-2025-qh15:74-139)
DECLARE `An office in an insurer` IS ONE OF
    `chair of the board or of the members' council`
    `member of the board or of the members' council`
    `chief executive or legal representative`
    `another manager`
    `head of a business department`
    `a controller`

DECLARE `A candidate officer` HAS
    `holds the right to manage enterprises under the Law on Enterprises` IS A BOOLEAN
    `has no administrative penalty in insurance`             IS A BOOLEAN
    `was not dismissed for breaching internal procedures in the 3 continuous years before the appointment` IS A BOOLEAN
    `is not prosecuted at the time of election or appointment` IS A BOOLEAN
    `has a university degree or higher`                      IS A BOOLEAN
    `has a degree in insurance`                              IS A BOOLEAN
    `has a degree in economics, finance, banking, law, business administration, accounting or auditing that includes an insurance subject` IS A BOOLEAN
    `has a degree in another field that includes an insurance subject` IS A BOOLEAN
    `has a degree in another field and an insurance certificate from a lawful training body in Vietnam or abroad` IS A BOOLEAN
    `has a degree in another field and an insurance certificate suited to the types of insurance the insurer may carry on` IS A BOOLEAN
    `years working directly in insurance, finance or banking` IS A NUMBER
    `years as a manager, executive or controller of an enterprise or organisation operating directly in insurance, finance or banking` IS A NUMBER
    `years as a manager or controller of an insurer, reinsurer or foreign branch` IS A NUMBER
    `years of experience in insurance, finance, banking or the intended specialty` IS A NUMBER
    `years of experience in insurance or the intended specialty` IS A NUMBER
    `resides in Vietnam while in office`                     IS A BOOLEAN

-- Dieu 82: holding two offices (amended by Law 139/2025/QH15 Dieu 1(6)).
@@q 1604 1640
@@qa 142 163
@ref Dieu 82 (src:1604-1640; src:law139-2025-qh15:142-163)
DECLARE `A post` IS ONE OF
    `actuary`
    `head of risk management`
    `head of compliance control`
    `head of the pricing department`
    `chief accountant`
    `head of internal audit`
    `head of finance and accounting`
    `another management post`

DECLARE `A person's posts` HAS
    `main post`                                              IS A `A post`
    `other posts held in the same organisation`              IS A LIST OF `A post`
    `works at another insurer, reinsurer or foreign branch in Vietnam at the same time` IS A BOOLEAN

§§ `Chuong IV: agents, brokers, ancillary service providers`

-- Dieu 125: conditions to act as an agent.
@@q 2695 2720
@ref Dieu 125 (src:2695-2720)
DECLARE `An individual agent` HAS
    `is a Vietnamese citizen resident in Vietnam`            IS A BOOLEAN
    `has full civil act capacity`                            IS A BOOLEAN
    `holds an agent certificate suited to the types of insurance` IS A BOOLEAN
    `is being prosecuted for a crime`                        IS A BOOLEAN
    `is serving a prison sentence`                           IS A BOOLEAN
    `is serving a ban on practising in a field related to insurance` IS A BOOLEAN

DECLARE `An organisation agent` HAS
    `is lawfully established and operating in Vietnam`       IS A BOOLEAN
    `has registered the business line of insurance agency under the Law on Enterprises` IS A BOOLEAN
    `is in a conditional line and holds the licence, certificate or approval that covers insurance agency` IS A BOOLEAN
    `is in a conditional line`                               IS A BOOLEAN
    `its staff who act as agents meet the individual conditions` IS A BOOLEAN
    `meets the staffing and other conditions the Government sets` IS A BOOLEAN
    `is a commercial legal person being prosecuted for a crime` IS A BOOLEAN
    `is suspended for a time or for good, or banned from business related to insurance` IS A BOOLEAN

-- Dieu 126: the contract with an agent.
@@q 2721 2733
@ref Dieu 126 (src:2721-2733)
DECLARE `The contract of an agent` HAS
    `states the name and address of the agent`               IS A BOOLEAN
    `states the name and head office address of the insurer, branch or mutual organisation` IS A BOOLEAN
    `states the rights and obligations of both sides`        IS A BOOLEAN
    `states the content and scope of the agency`             IS A BOOLEAN
    `states commission, bonus and support, if any`           IS A BOOLEAN
    `states the term of the contract`                        IS A BOOLEAN
    `states the way of resolving disputes`                   IS A BOOLEAN

-- Dieu 127(1) (replaced for the first paragraph by Law 139/2025/QH15 Dieu 1(9)): two principals.
@@q 2734 2749
@@qa 222 233
@ref Dieu 127 (src:2734-2749; src:law139-2025-qh15:222-233)
