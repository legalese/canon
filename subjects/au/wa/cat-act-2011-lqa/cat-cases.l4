#ASSERT `r 12(2)(a)(i) -- the next 31 October after` (`the date` 2026 10 30) EQUALS `the date` 2026 10 31
#ASSERT `r 12(2)(a)(i) -- the next 31 October after` (`the date` 2026 11 1) EQUALS `the date` 2027 10 31

-- FORK-06: three years from 1 March 2026. Reading A (taken): 31 October 2028.
#ASSERT `r 12(2)(a)(ii) -- 31 October in the final year of the 3-year period beginning on` (`the date` 2026 3 1) EQUALS `the date` 2028 10 31
-- Reading B: 31 October 2029.
#ASSERT `r 12(2)(a)(ii) -- 31 October of the calendar year the period ends, reading B` (`the date` 2026 3 1) EQUALS `the date` 2029 10 31
-- From 1 November the readings agree.
#ASSERT `r 12(2)(a)(ii) -- 31 October in the final year of the 3-year period beginning on` (`the date` 2026 11 1) EQUALS `the date` 2029 10 31
#ASSERT `r 12(2)(a)(ii) -- 31 October of the calendar year the period ends, reading B` (`the date` 2026 11 1) EQUALS `the date` 2029 10 31

-- Taking effect on 31 October 2026, reading A gives 31 October 2028 (two years and a day: 31
-- October 2029 falls outside the 3-year period, which ends on 30 October 2029). Reading C (the
-- one-year rule three times) gives 31 October 2029.
#ASSERT `r 12(2)(a)(ii) -- 31 October in the final year of the 3-year period beginning on` (`the date` 2026 10 31) EQUALS `the date` 2028 10 31
#ASSERT `r 12(2)(a)(ii) -- the third 31 October after, reading C` (`the date` 2026 10 31) EQUALS `the date` 2029 10 31
#ASSERT `r 12(2)(a)(ii) -- the third 31 October after, reading C` (`the date` 2026 3 1) EQUALS `the date` 2028 10 31

