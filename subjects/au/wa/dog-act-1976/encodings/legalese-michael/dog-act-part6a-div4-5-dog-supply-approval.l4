IMPORT prelude
IMPORT `dog-act-domain`

-- =============================================================================
-- Dog Act 1976 (Western Australia) -- Dog supply approval
--
-- Isomorphic encoding of Part VIA Division 4 ("Dog supply approval", ss
-- 38N-38U) and Division 5 ("Obligations of holder of dog supply approval",
-- ss 38V-38Y), as at the compilation dated 28 Nov 2024 [version 08-b0-00],
-- re-verified current 2026-09-09. Source: lines 1379-1490 of
-- mrdoc_47983.txt (WA Dog Act 1976 verbatim compilation).
--
-- This module reuses only the shared `Penalty` record from
-- dog-act-domain.l4 -- Division 4/5 is about dog SUPPLIERS and holders of a
-- dog supply approval, not about "persons liable for the control of the
-- dog" or "dangerous dogs" in the s. 3 sense that dog-act-domain.l4's other
-- shared definitions serve, so LiableParty/DogProfile/AttackFacts are not
-- read here.
--
-- SCOPED OUT (cited at their site with @ref, never expanded): s. 43AA
-- (an offence outside this chunk's assigned range, reached only by
-- s. 38Y(2)(b)'s cross-reference).
--
-- Local regulative-rule actors: this file declares its OWN small
-- Div45Party/Div45Action sum types (below), scoped to just the actors this
-- chunk needs (CEO; a person subject to a Division 4/5 duty). These are NOT
-- the DogActParty/DogActAction types from dog-act-1976.l4 -- that file
-- declares them LOCAL and non-importable, and this chunk's actors differ
-- anyway (no "Dog Owner" or "Local Government" ever stands under a MUST
-- duty in this chunk -- the Local Government is only ever a requester, not
-- an obligor, in ss 38N-38Y).
-- =============================================================================

§ `Shared penalty presets for this module`

-- The recurring $5,000-fine-only shape: ss 38N(2), 38T, 38V(4), 38W(4), 38X(5).
`$5,000 fine only penalty` MEANS
    Penalty WITH fine IS JUST 5_000, `minimum fine` IS NOTHING, `imprisonment months` IS NOTHING, `further offence fine` IS NOTHING

-- The one $10,000 shape: s 38N(1).
`$10,000 fine only penalty` MEANS
    Penalty WITH fine IS JUST 10_000, `minimum fine` IS NOTHING, `imprisonment months` IS NOTHING, `further offence fine` IS NOTHING

§ `Shared regulative-rule actors for this module`

DECLARE Div45Party IS ONE OF
    CEO
    `A Person Subject To This Division`

DECLARE Div45Action IS ONE OF
    `give written notice of a s 38R(1) decision and its reasons`
    `give notice in writing of a change to information under s 38T`
    `comply with a s 38W(1) request`
    `comply with a s 38X(2) request`

§ `Part VIA, Division 4 -- Dog supply approval`
§§ `38N. Only holder of dog supply approval may supply dogs to relevant pet shop businesses`

DECLARE `S38N Supply Facts` HAS
    `supplied a dog to a relevant pet shop business`                                              IS A BOOLEAN
    `dog is a stray, abandoned, seized or surrendered dog`                                         IS A BOOLEAN
    `dog is being kept as part of refuge operations conducted by the supplier`                     IS A BOOLEAN
    `dog is being kept in a dog management facility operated by the supplier`                      IS A BOOLEAN
    `supplier holds a dog supply approval`                                                         IS A BOOLEAN
    `supplier obtained, in respect of the dog, a veterinarian's health certificate under s 38N(2)(a)` IS A BOOLEAN
    `supplier provided the pet shop business (or the person acting on its behalf) with a copy of the health certificate` IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38N(1)
GIVEN f IS A `S38N Supply Facts`
GIVETH A BOOLEAN
`s 38N(1) offence -- supplying a dog without a qualifying source and an approval` f MEANS
        f's `supplied a dog to a relevant pet shop business`
    AND NOT (
                f's `dog is a stray, abandoned, seized or surrendered dog`
            AND (f's `dog is being kept as part of refuge operations conducted by the supplier` OR f's `dog is being kept in a dog management facility operated by the supplier`)
            AND f's `supplier holds a dog supply approval`
        )

`s 38N(1) penalty` MEANS `$10,000 fine only penalty`

@ref Dog Act 1976 (WA) s. 38N(2)
GIVEN f IS A `S38N Supply Facts`
GIVETH A BOOLEAN
`s 38N(2) offence -- supplying a dog without a health certificate having been obtained and given to the pet shop business` f MEANS
        f's `supplied a dog to a relevant pet shop business`
    AND NOT (   f's `supplier obtained, in respect of the dog, a veterinarian's health certificate under s 38N(2)(a)`
             AND f's `supplier provided the pet shop business (or the person acting on its behalf) with a copy of the health certificate`)

`s 38N(2) penalty` MEANS `$5,000 fine only penalty`

§§ `38O. Person conducting refuge operations or operating dog management facility may apply for dog supply approval`

DECLARE `S38O Applicant Facts` HAS
    `applicant conducts refuge operations`                          IS A BOOLEAN
    `applicant is the operator of a dog management facility`        IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38O(1)
GIVEN f IS A `S38O Applicant Facts`
GIVETH A BOOLEAN
`eligible to apply for a dog supply approval` f MEANS
    f's `applicant conducts refuge operations` OR f's `applicant is the operator of a dog management facility`

DECLARE `S38O Application Facts` HAS
    `made in a manner and form approved by the CEO`                          IS A BOOLEAN
    `contains the information prescribed`                                    IS A BOOLEAN
    `contains information regarding the intended sources of dogs to be supplied` IS A BOOLEAN
    `accompanied by the fee, if any, prescribed`                             IS A BOOLEAN
    `complies with any other requirements that are prescribed`               IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38O(2)
GIVEN app IS A `S38O Application Facts`
GIVETH A BOOLEAN
`the application satisfies the s 38O(2) requirements` app MEANS
        app's `made in a manner and form approved by the CEO`
    AND app's `contains the information prescribed`
    AND app's `contains information regarding the intended sources of dogs to be supplied`
    AND app's `accompanied by the fee, if any, prescribed`
    AND app's `complies with any other requirements that are prescribed`

@ref Dog Act 1976 (WA) s. 38O(3)-(4)
GIVEN `the CEO required the applicant to give a document, information or a statutory declaration under s 38O(3)` IS A BOOLEAN,
      `the applicant complied with that requirement within the specified time` IS A BOOLEAN
GIVETH A BOOLEAN
`the CEO may refuse to consider the application under s 38O(4)` `the CEO required the applicant to give a document, information or a statutory declaration under s 38O(3)` `the applicant complied with that requirement within the specified time` MEANS
        `the CEO required the applicant to give a document, information or a statutory declaration under s 38O(3)`
    AND NOT `the applicant complied with that requirement within the specified time`

§§ `38P. Dog supply approval`

-- s 38P(1): on receiving an application, the CEO is to grant or refuse to
-- grant the approval. Purely procedural machinery (the decision itself);
-- what governs it operatively is the s 38P(2) refusal-grounds test below,
-- so s 38P(1) carries no separate fact for a downstream rule to test.

DECLARE `S38P Refusal Grounds` HAS
    `applicant is a convicted person`                                                                                     IS A BOOLEAN
    `applicant purports to conduct refuge operations, and there are reasonable grounds to suspect the operations are not genuine` IS A BOOLEAN
        -- AMBIGUITY (F-GENUINE-REFUGE-OPERATIONS): "genuine" is undefined.
        -- Delegated wholesale to fact-supply, on the same footing as
        -- "repeatedly" at s 33E(1)(b) (F-REPEATEDLY-TENDENCY in
        -- dog-act-1976.l4) -- an evaluative term with no statutory test of
        -- its own. See ambiguities array.
    `the dog management facility, or the facilities the applicant uses to keep dogs for the refuge operations, do not meet the requirements of a relevant written law` IS A BOOLEAN
    `a local government objects to the grant of the approval`                                                              IS A BOOLEAN
    `a circumstance prescribed for the purposes of s 38P(2) applies`                                                       IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38P(2)
GIVEN g IS A `S38P Refusal Grounds`
GIVETH A BOOLEAN
`grounds exist for the CEO to refuse to grant a dog supply approval` g MEANS
        g's `applicant is a convicted person`
    OR  g's `applicant purports to conduct refuge operations, and there are reasonable grounds to suspect the operations are not genuine`
    OR  g's `the dog management facility, or the facilities the applicant uses to keep dogs for the refuge operations, do not meet the requirements of a relevant written law`
    OR  g's `a local government objects to the grant of the approval`
    OR  g's `a circumstance prescribed for the purposes of s 38P(2) applies`

DECLARE `S38P Conditions Facts` HAS
    `CEO considers the conditions necessary or desirable to impose` IS A BOOLEAN
    `conditions are specified in the approval`                       IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38P(3)
GIVEN c IS A `S38P Conditions Facts`
GIVETH A BOOLEAN
`the s 38P(3) conditions requirement is satisfied` c MEANS
    c's `CEO considers the conditions necessary or desirable to impose` AND c's `conditions are specified in the approval`

-- s 38P(4): the CEO may, at any time by written notice, amend or revoke
-- conditions, or impose new ones. A standing, undated power with no fact a
-- downstream rule in this chunk needs to test -- recorded here as inert
-- prose rather than a force-fit boolean.

@ref Dog Act 1976 (WA) s. 38P(5)
GIVEN `the approval has been cancelled under s 38Q` IS A BOOLEAN
GIVETH A BOOLEAN
`the dog supply approval remains in force` `the approval has been cancelled under s 38Q` MEANS
    NOT `the approval has been cancelled under s 38Q`

§§ `38Q. Cancellation of dog supply approval`

DECLARE `S38Q Cancellation Grounds` HAS
    `the person requests that the CEO cancel the approval`                                                        IS A BOOLEAN
    `s 38P(2) refusal-ground facts in relation to the person`                                                     IS A `S38P Refusal Grounds`
    `the person does not need the approval`                                                                       IS A BOOLEAN
    `the person has not complied with a condition imposed on the approval`                                        IS A BOOLEAN
    `the person has supplied to a relevant pet shop business a dog which the CEO suspects, on reasonable grounds, is not a stray, abandoned, seized or surrendered dog` IS A BOOLEAN
    `the person has not complied with a requirement under this Act or the Animal Welfare Act 2002`                IS A BOOLEAN
    `there has been a contravention of this Act or the Animal Welfare Act 2002 in relation to the refuge operations or dog management facility to which the approval relates` IS A BOOLEAN
    `a circumstance prescribed for the purposes of s 38Q applies`                                                 IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38Q
GIVEN c IS A `S38Q Cancellation Grounds`
GIVETH A BOOLEAN
`grounds exist for the CEO to cancel a dog supply approval` c MEANS
        c's `the person requests that the CEO cancel the approval`
    OR  `grounds exist for the CEO to refuse to grant a dog supply approval` (c's `s 38P(2) refusal-ground facts in relation to the person`)
    OR  c's `the person does not need the approval`
    OR  c's `the person has not complied with a condition imposed on the approval`
    OR  c's `the person has supplied to a relevant pet shop business a dog which the CEO suspects, on reasonable grounds, is not a stray, abandoned, seized or surrendered dog`
    OR  c's `the person has not complied with a requirement under this Act or the Animal Welfare Act 2002`
    OR  c's `there has been a contravention of this Act or the Animal Welfare Act 2002 in relation to the refuge operations or dog management facility to which the approval relates`
    OR  c's `a circumstance prescribed for the purposes of s 38Q applies`

§§ `38R. Notice of certain decisions made under this Division`

-- s 38R(1)'s list IS the enum: only these three decision-kinds trigger the
-- s 38R(2) notice duty (a cancellation at the holder's own request is
-- deliberately excluded from this type, mirroring the statute's own
-- parenthetical carve-out, rather than encoded as a separate boolean gate).
DECLARE `S38R Decision` IS ONE OF
    `refusal to grant a dog supply approval`
    `cancellation of a dog supply approval, other than at the holder's own request`
    `imposition or amendment of conditions on a dog supply approval`

@ref Dog Act 1976 (WA) s. 38R(2)
GIVEN decision IS A `S38R Decision`
GIVETH A DEONTIC Div45Party Div45Action
`s 38R(2) notice duty` decision MEANS
    PARTY CEO
    MUST  `give written notice of a s 38R(1) decision and its reasons`
    WITHIN 7
    HENCE FULFILLED
    LEST  BREACH BY CEO
          BECAUSE "written notice of the decision and the reasons for it was not given, to the applicant for or holder of the approval, within 7 days after the CEO made the decision, as s 38R(2) requires"

-- s 38R(3): the regulations MAY provide for SAT review and for suspending
-- the decision's effect while a review right exists or is underway. An
-- enabling power for subordinate legislation, not itself an operative test
-- -- recorded here as inert prose.

§§ `38S. Record of dog supply approval`

-- s 38S(1)-(2): the CEO's internal record-keeping duties (entering the
-- decision and prescribed information in the centralised registration
-- system "as soon as practicable", and keeping that record updated to
-- reflect later changes/conditions/cancellation/review outcomes). Purely
-- administrative machinery -- no fact here is read by, or feeds, any other
-- rule in this chunk (or, so far as this chunk can see, any rule outside
-- it) -- so it is recorded as inert prose rather than a force-fit boolean.

§§ `38T. Notice of change to information`

@ref Dog Act 1976 (WA) s. 38T
`s 38T notice duty` MEANS
    PARTY `A Person Subject To This Division`
    MUST  `give notice in writing of a change to information under s 38T`
    WITHIN 7
    HENCE FULFILLED
    LEST  BREACH BY `A Person Subject To This Division`
          BECAUSE "notice in writing of the change was not given to the CEO within 7 days after the holder became aware of it, as s 38T requires"

@ref Dog Act 1976 (WA) s. 38T Penalty
GIVEN `days since the holder became aware of a change to the s 38S(1) information, without written notice given to the CEO` IS A NUMBER
GIVETH A BOOLEAN
`s 38T offence -- holder fails to give notice of a change of information within 7 days` `days since the holder became aware of a change to the s 38S(1) information, without written notice given to the CEO` MEANS
    `days since the holder became aware of a change to the s 38S(1) information, without written notice given to the CEO` GREATER THAN 7

`s 38T penalty` MEANS `$5,000 fine only penalty`

§§ `38U. Certificate and unique number to be given to holder of dog supply approval`

DECLARE `S38U Facts` HAS
    `CEO granted the dog supply approval`                                       IS A BOOLEAN
    `CEO gave the person a certificate containing the prescribed information`   IS A BOOLEAN
    `CEO issued the person with a unique number for the dog supply approval`    IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38U(1)
GIVEN f IS A `S38U Facts`
GIVETH A BOOLEAN
`the s 38U(1) certificate and number requirements are satisfied` f MEANS
        (NOT f's `CEO granted the dog supply approval`)
    OR  (f's `CEO gave the person a certificate containing the prescribed information` AND f's `CEO issued the person with a unique number for the dog supply approval`)

DECLARE `S38U Replacement Grounds` HAS
    `certificate has been stolen`   IS A BOOLEAN
    `certificate has been lost`     IS A BOOLEAN
    `certificate has been damaged`  IS A BOOLEAN
    `certificate has been destroyed` IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38U(2)
GIVEN g IS A `S38U Replacement Grounds`
GIVETH A BOOLEAN
`the CEO may issue a replacement certificate under s 38U(2)` g MEANS
    g's `certificate has been stolen` OR g's `certificate has been lost` OR g's `certificate has been damaged` OR g's `certificate has been destroyed`

§ `Part VIA, Division 5 -- Obligations of holder of dog supply approval`
§§ `38V. Holder of dog supply approval to keep records`

DECLARE `S38V Record Facts` HAS
    `record contains the prescribed information in relation to the source and history of the dog`                    IS A BOOLEAN
    `record includes any evidence necessary to enable that information to be verified`                                IS A BOOLEAN
    `record is kept in the prescribed way, if any way is prescribed`                                                  IS A BOOLEAN
    `record was made within the time prescribed for making it, if any time is prescribed`                             IS A BOOLEAN
    `record has been retained for at least 5 years after the day the dog was supplied, even if the person has since ceased to hold the dog supply approval` IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38V(1)-(3)
GIVEN f IS A `S38V Record Facts`
GIVETH A BOOLEAN
`the s 38V record-keeping requirements are satisfied` f MEANS
        f's `record contains the prescribed information in relation to the source and history of the dog`
    AND f's `record includes any evidence necessary to enable that information to be verified`
    AND f's `record is kept in the prescribed way, if any way is prescribed`
    AND f's `record was made within the time prescribed for making it, if any time is prescribed`
    AND f's `record has been retained for at least 5 years after the day the dog was supplied, even if the person has since ceased to hold the dog supply approval`

@ref Dog Act 1976 (WA) s. 38V(4)
GIVEN f IS A `S38V Record Facts`
GIVETH A BOOLEAN
`s 38V(4) offence -- failing to comply with the s 38V record-keeping requirements` f MEANS
    NOT `the s 38V record-keeping requirements are satisfied` f

`s 38V penalty` MEANS `$5,000 fine only penalty`

§§ `38W. Holder of dog supply approval to provide information to CEO`

DECLARE `S38W Request Facts` HAS
    `person holds or has held a dog supply approval`                                                                                  IS A BOOLEAN
    `CEO requested a record, information or evidence the person is required to keep under s 38V`                                     IS A BOOLEAN
    `CEO requested other information, evidence or a document the CEO requires to determine if the approval should remain in force`   IS A BOOLEAN
    `request specifies the time within which the material must be provided`                                                          IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38W(1)
GIVEN r IS A `S38W Request Facts`
GIVETH A BOOLEAN
`the CEO may make a s 38W(1) request` r MEANS
    r's `person holds or has held a dog supply approval`

@ref Dog Act 1976 (WA) s. 38W(1)
GIVEN r IS A `S38W Request Facts`
GIVETH A BOOLEAN
`a s 38W(1) request has been made` r MEANS
    r's `CEO requested a record, information or evidence the person is required to keep under s 38V` OR r's `CEO requested other information, evidence or a document the CEO requires to determine if the approval should remain in force`

-- s 38W(2): the CEO may take extracts from, or make copies of, any record,
-- information, evidence or document provided. A standing administrative
-- power with no fact any downstream rule in this chunk tests -- recorded
-- as inert prose, on the same footing as s 38P(4)/s 38S.

@ref Dog Act 1976 (WA) s. 38W(3)
GIVEN r IS A `S38W Request Facts`
GIVETH A BOOLEAN
`the s 38W(3) request-content requirement is satisfied` r MEANS
    r's `request specifies the time within which the material must be provided`

@ref Dog Act 1976 (WA) s. 38W(4)
GIVEN `the deadline specified in the request, or any later time the CEO and the person agree` IS A NUMBER
GIVETH A DEONTIC Div45Party Div45Action
`s 38W(4) compliance duty` `the deadline specified in the request, or any later time the CEO and the person agree` MEANS
    PARTY `A Person Subject To This Division`
    MUST  `comply with a s 38W(1) request`
    WITHIN `the deadline specified in the request, or any later time the CEO and the person agree`
    HENCE FULFILLED
    LEST  BREACH BY `A Person Subject To This Division`
          BECAUSE "the s 38W(1) request was not complied with within the time specified in the request (or any later time agreed with the CEO), as s 38W(4) requires"

@ref Dog Act 1976 (WA) s. 38W(4) Penalty
GIVEN `request complied with within the time specified (or any later agreed time)` IS A BOOLEAN
GIVETH A BOOLEAN
`s 38W(4) offence -- failing to comply with a s 38W(1) request in time` `request complied with within the time specified (or any later agreed time)` MEANS
    NOT `request complied with within the time specified (or any later agreed time)`

`s 38W penalty` MEANS `$5,000 fine only penalty`

§§ `38X. Holder of dog supply approval to provide information to local government`

@ref Dog Act 1976 (WA) s. 38X(1)
GIVEN `pet shop is located in the local government's district` IS A BOOLEAN
GIVETH A BOOLEAN
`the pet shop business is an applicable pet shop business in relation to the local government` `pet shop is located in the local government's district` MEANS
    `pet shop is located in the local government's district`

DECLARE `S38X Request Facts` HAS
    `person holds, has held, or purports to hold or have held, a dog supply approval` IS A BOOLEAN
    `person supplies, or has supplied, dogs to an applicable pet shop business`       IS A BOOLEAN
    `local government requested evidence that the person holds or has held the dog supply approval` IS A BOOLEAN
    `local government requested a copy of the health certificate of a dog supplied by the person to an applicable pet shop business in the previous 5 years or, if a shorter period, the period since the person was granted the dog supply approval` IS A BOOLEAN

@ref Dog Act 1976 (WA) s. 38X(2)
GIVEN f IS A `S38X Request Facts`
GIVETH A BOOLEAN
`the local government may make a s 38X(2) request` f MEANS
    f's `person holds, has held, or purports to hold or have held, a dog supply approval` AND f's `person supplies, or has supplied, dogs to an applicable pet shop business`

@ref Dog Act 1976 (WA) s. 38X(2)
GIVEN f IS A `S38X Request Facts`
GIVETH A BOOLEAN
`a s 38X(2) request has been made` f MEANS
    f's `local government requested evidence that the person holds or has held the dog supply approval` OR f's `local government requested a copy of the health certificate of a dog supplied by the person to an applicable pet shop business in the previous 5 years or, if a shorter period, the period since the person was granted the dog supply approval`

-- s 38X(3): the local government may take extracts from, or make copies of,
-- any evidence or copy provided. A standing administrative power with no
-- fact any downstream rule in this chunk tests -- recorded as inert prose,
-- on the same footing as s 38P(4)/s 38S/s 38W(2).

@ref Dog Act 1976 (WA) s. 38X(4)
GIVEN `request specifies the time within which the evidence or copy must be provided` IS A BOOLEAN
GIVETH A BOOLEAN
`the s 38X(4) request-content requirement is satisfied` `request specifies the time within which the evidence or copy must be provided` MEANS
    `request specifies the time within which the evidence or copy must be provided`

@ref Dog Act 1976 (WA) s. 38X(5)
GIVEN `the deadline specified in the request, or any later time the local government and the person agree` IS A NUMBER
GIVETH A DEONTIC Div45Party Div45Action
`s 38X(5) compliance duty` `the deadline specified in the request, or any later time the local government and the person agree` MEANS
    PARTY `A Person Subject To This Division`
    MUST  `comply with a s 38X(2) request`
    WITHIN `the deadline specified in the request, or any later time the local government and the person agree`
    HENCE FULFILLED
    LEST  BREACH BY `A Person Subject To This Division`
          BECAUSE "the s 38X(2) request was not complied with within the time specified in the request (or any later time agreed with the local government), as s 38X(5) requires"

@ref Dog Act 1976 (WA) s. 38X(5) Penalty
GIVEN `request complied with within the time specified (or any later agreed time)` IS A BOOLEAN
GIVETH A BOOLEAN
`s 38X(5) offence -- failing to comply with a s 38X(2) request in time` `request complied with within the time specified (or any later agreed time)` MEANS
    NOT `request complied with within the time specified (or any later agreed time)`

`s 38X penalty` MEANS `$5,000 fine only penalty`

§§ `38Y. Self-incrimination`

-- s 38Y(1): a person is not excused from complying with a Division 4/5
-- request on the ground of self-incrimination. There is no carve-out for
-- self-incrimination anywhere in the s 38W(4)/s 38X(5) MUST rules above,
-- so this subsection is already given effect by their absence of such an
-- exception; it adds no separate fact for a downstream rule to test.

DECLARE `S38Y Proceedings Facts` HAS
    `material was provided in compliance with a request under s 38W(1)(a)` IS A BOOLEAN
    `proceedings are for an offence against this Act`                      IS A BOOLEAN
    `proceedings are for perjury`                                          IS A BOOLEAN
    `proceedings are for an offence against s 43AA`                        IS A BOOLEAN
        -- @ref Dog Act 1976 (WA) s. 43AA -- scoped out, fact-supplied (outside this chunk's assigned line range)

@ref Dog Act 1976 (WA) s. 38Y(2)
GIVEN f IS A `S38Y Proceedings Facts`
GIVETH A BOOLEAN
`the material is admissible against the individual under s 38Y(2)` f MEANS
    IF f's `material was provided in compliance with a request under s 38W(1)(a)`
    THEN f's `proceedings are for an offence against this Act` OR f's `proceedings are for perjury`
    ELSE f's `proceedings are for perjury` OR f's `proceedings are for an offence against s 43AA`

-- =============================================================================
-- Illustrations
-- =============================================================================

§ `Illustrations`

`a compliant refuge supply` MEANS `S38N Supply Facts` WITH
    `supplied a dog to a relevant pet shop business` IS TRUE
    , `dog is a stray, abandoned, seized or surrendered dog` IS TRUE
    , `dog is being kept as part of refuge operations conducted by the supplier` IS TRUE
    , `dog is being kept in a dog management facility operated by the supplier` IS FALSE
    , `supplier holds a dog supply approval` IS TRUE
    , `supplier obtained, in respect of the dog, a veterinarian's health certificate under s 38N(2)(a)` IS TRUE
    , `supplier provided the pet shop business (or the person acting on its behalf) with a copy of the health certificate` IS TRUE

`an unapproved supply of an owned dog` MEANS `S38N Supply Facts` WITH
    `supplied a dog to a relevant pet shop business` IS TRUE
    , `dog is a stray, abandoned, seized or surrendered dog` IS FALSE
    , `dog is being kept as part of refuge operations conducted by the supplier` IS FALSE
    , `dog is being kept in a dog management facility operated by the supplier` IS FALSE
    , `supplier holds a dog supply approval` IS FALSE
    , `supplier obtained, in respect of the dog, a veterinarian's health certificate under s 38N(2)(a)` IS TRUE
    , `supplier provided the pet shop business (or the person acting on its behalf) with a copy of the health certificate` IS TRUE

#ASSERT NOT (`s 38N(1) offence -- supplying a dog without a qualifying source and an approval` `a compliant refuge supply`)
#ASSERT `s 38N(1) offence -- supplying a dog without a qualifying source and an approval` `an unapproved supply of an owned dog`

`a supply missing the health certificate copy` MEANS `S38N Supply Facts` WITH
    `supplied a dog to a relevant pet shop business` IS TRUE
    , `dog is a stray, abandoned, seized or surrendered dog` IS TRUE
    , `dog is being kept as part of refuge operations conducted by the supplier` IS TRUE
    , `dog is being kept in a dog management facility operated by the supplier` IS FALSE
    , `supplier holds a dog supply approval` IS TRUE
    , `supplier obtained, in respect of the dog, a veterinarian's health certificate under s 38N(2)(a)` IS TRUE
    , `supplier provided the pet shop business (or the person acting on its behalf) with a copy of the health certificate` IS FALSE

#ASSERT NOT (`s 38N(2) offence -- supplying a dog without a health certificate having been obtained and given to the pet shop business` `a compliant refuge supply`)
#ASSERT `s 38N(2) offence -- supplying a dog without a health certificate having been obtained and given to the pet shop business` `a supply missing the health certificate copy`

`a refuge operator applicant` MEANS `S38O Applicant Facts` WITH
    `applicant conducts refuge operations` IS TRUE
    , `applicant is the operator of a dog management facility` IS FALSE

`neither a refuge operator nor a facility operator` MEANS `S38O Applicant Facts` WITH
    `applicant conducts refuge operations` IS FALSE
    , `applicant is the operator of a dog management facility` IS FALSE

#ASSERT `eligible to apply for a dog supply approval` `a refuge operator applicant`
#ASSERT NOT (`eligible to apply for a dog supply approval` `neither a refuge operator nor a facility operator`)

`a complete s 38O(2) application` MEANS `S38O Application Facts` WITH
    `made in a manner and form approved by the CEO` IS TRUE
    , `contains the information prescribed` IS TRUE
    , `contains information regarding the intended sources of dogs to be supplied` IS TRUE
    , `accompanied by the fee, if any, prescribed` IS TRUE
    , `complies with any other requirements that are prescribed` IS TRUE

`an application silent on the source of dogs` MEANS `S38O Application Facts` WITH
    `made in a manner and form approved by the CEO` IS TRUE
    , `contains the information prescribed` IS TRUE
    , `contains information regarding the intended sources of dogs to be supplied` IS FALSE
    , `accompanied by the fee, if any, prescribed` IS TRUE
    , `complies with any other requirements that are prescribed` IS TRUE

#ASSERT `the application satisfies the s 38O(2) requirements` `a complete s 38O(2) application`
#ASSERT NOT (`the application satisfies the s 38O(2) requirements` `an application silent on the source of dogs`)

#ASSERT `the CEO may refuse to consider the application under s 38O(4)` TRUE FALSE
#ASSERT NOT (`the CEO may refuse to consider the application under s 38O(4)` TRUE TRUE)
#ASSERT NOT (`the CEO may refuse to consider the application under s 38O(4)` FALSE FALSE)

`no refusal grounds` MEANS `S38P Refusal Grounds` WITH
    `applicant is a convicted person` IS FALSE
    , `applicant purports to conduct refuge operations, and there are reasonable grounds to suspect the operations are not genuine` IS FALSE
    , `the dog management facility, or the facilities the applicant uses to keep dogs for the refuge operations, do not meet the requirements of a relevant written law` IS FALSE
    , `a local government objects to the grant of the approval` IS FALSE
    , `a circumstance prescribed for the purposes of s 38P(2) applies` IS FALSE

`a local government objection` MEANS `S38P Refusal Grounds` WITH
    `applicant is a convicted person` IS FALSE
    , `applicant purports to conduct refuge operations, and there are reasonable grounds to suspect the operations are not genuine` IS FALSE
    , `the dog management facility, or the facilities the applicant uses to keep dogs for the refuge operations, do not meet the requirements of a relevant written law` IS FALSE
    , `a local government objects to the grant of the approval` IS TRUE
    , `a circumstance prescribed for the purposes of s 38P(2) applies` IS FALSE

#ASSERT NOT (`grounds exist for the CEO to refuse to grant a dog supply approval` `no refusal grounds`)
#ASSERT `grounds exist for the CEO to refuse to grant a dog supply approval` `a local government objection`

`properly imposed conditions` MEANS `S38P Conditions Facts` WITH
    `CEO considers the conditions necessary or desirable to impose` IS TRUE
    , `conditions are specified in the approval` IS TRUE

`conditions not written into the approval` MEANS `S38P Conditions Facts` WITH
    `CEO considers the conditions necessary or desirable to impose` IS TRUE
    , `conditions are specified in the approval` IS FALSE

#ASSERT `the s 38P(3) conditions requirement is satisfied` `properly imposed conditions`
#ASSERT NOT (`the s 38P(3) conditions requirement is satisfied` `conditions not written into the approval`)

#ASSERT `the dog supply approval remains in force` FALSE
#ASSERT NOT (`the dog supply approval remains in force` TRUE)

`cancellation at the holder's own request` MEANS `S38Q Cancellation Grounds` WITH
    `the person requests that the CEO cancel the approval` IS TRUE
    , `s 38P(2) refusal-ground facts in relation to the person` IS `no refusal grounds`
    , `the person does not need the approval` IS FALSE
    , `the person has not complied with a condition imposed on the approval` IS FALSE
    , `the person has supplied to a relevant pet shop business a dog which the CEO suspects, on reasonable grounds, is not a stray, abandoned, seized or surrendered dog` IS FALSE
    , `the person has not complied with a requirement under this Act or the Animal Welfare Act 2002` IS FALSE
    , `there has been a contravention of this Act or the Animal Welfare Act 2002 in relation to the refuge operations or dog management facility to which the approval relates` IS FALSE
    , `a circumstance prescribed for the purposes of s 38Q applies` IS FALSE

`no cancellation grounds at all` MEANS `S38Q Cancellation Grounds` WITH
    `the person requests that the CEO cancel the approval` IS FALSE
    , `s 38P(2) refusal-ground facts in relation to the person` IS `no refusal grounds`
    , `the person does not need the approval` IS FALSE
    , `the person has not complied with a condition imposed on the approval` IS FALSE
    , `the person has supplied to a relevant pet shop business a dog which the CEO suspects, on reasonable grounds, is not a stray, abandoned, seized or surrendered dog` IS FALSE
    , `the person has not complied with a requirement under this Act or the Animal Welfare Act 2002` IS FALSE
    , `there has been a contravention of this Act or the Animal Welfare Act 2002 in relation to the refuge operations or dog management facility to which the approval relates` IS FALSE
    , `a circumstance prescribed for the purposes of s 38Q applies` IS FALSE

#ASSERT `grounds exist for the CEO to cancel a dog supply approval` `cancellation at the holder's own request`
#ASSERT NOT (`grounds exist for the CEO to cancel a dog supply approval` `no cancellation grounds at all`)

#TRACE `s 38R(2) notice duty` `refusal to grant a dog supply approval` AT 0 WITH
    PARTY CEO DOES `give written notice of a s 38R(1) decision and its reasons` AT 5
-- Result: FULFILLED (notified within the 7-day window)

#TRACE `s 38R(2) notice duty` `cancellation of a dog supply approval, other than at the holder's own request` AT 0 WITH
    (`WAIT UNTIL` 8)
-- Result: DEONTIC BREACHED -- no notice given within 7 days

#TRACE `s 38T notice duty` AT 0 WITH
    PARTY `A Person Subject To This Division` DOES `give notice in writing of a change to information under s 38T` AT 7
-- Result: FULFILLED (the 7-day deadline is inclusive)

#TRACE `s 38T notice duty` AT 0 WITH
    (`WAIT UNTIL` 8)
-- Result: DEONTIC BREACHED -- no notice given within 7 days

#ASSERT NOT (`s 38T offence -- holder fails to give notice of a change of information within 7 days` 7)
#ASSERT `s 38T offence -- holder fails to give notice of a change of information within 7 days` 8

`granted with certificate and number` MEANS `S38U Facts` WITH
    `CEO granted the dog supply approval` IS TRUE
    , `CEO gave the person a certificate containing the prescribed information` IS TRUE
    , `CEO issued the person with a unique number for the dog supply approval` IS TRUE

`granted without a number` MEANS `S38U Facts` WITH
    `CEO granted the dog supply approval` IS TRUE
    , `CEO gave the person a certificate containing the prescribed information` IS TRUE
    , `CEO issued the person with a unique number for the dog supply approval` IS FALSE

#ASSERT `the s 38U(1) certificate and number requirements are satisfied` `granted with certificate and number`
#ASSERT NOT (`the s 38U(1) certificate and number requirements are satisfied` `granted without a number`)

`a lost certificate` MEANS `S38U Replacement Grounds` WITH
    `certificate has been stolen` IS FALSE
    , `certificate has been lost` IS TRUE
    , `certificate has been damaged` IS FALSE
    , `certificate has been destroyed` IS FALSE

`an undamaged, unlost certificate` MEANS `S38U Replacement Grounds` WITH
    `certificate has been stolen` IS FALSE
    , `certificate has been lost` IS FALSE
    , `certificate has been damaged` IS FALSE
    , `certificate has been destroyed` IS FALSE

#ASSERT `the CEO may issue a replacement certificate under s 38U(2)` `a lost certificate`
#ASSERT NOT (`the CEO may issue a replacement certificate under s 38U(2)` `an undamaged, unlost certificate`)

`a fully compliant record` MEANS `S38V Record Facts` WITH
    `record contains the prescribed information in relation to the source and history of the dog` IS TRUE
    , `record includes any evidence necessary to enable that information to be verified` IS TRUE
    , `record is kept in the prescribed way, if any way is prescribed` IS TRUE
    , `record was made within the time prescribed for making it, if any time is prescribed` IS TRUE
    , `record has been retained for at least 5 years after the day the dog was supplied, even if the person has since ceased to hold the dog supply approval` IS TRUE

`a record destroyed early` MEANS `S38V Record Facts` WITH
    `record contains the prescribed information in relation to the source and history of the dog` IS TRUE
    , `record includes any evidence necessary to enable that information to be verified` IS TRUE
    , `record is kept in the prescribed way, if any way is prescribed` IS TRUE
    , `record was made within the time prescribed for making it, if any time is prescribed` IS TRUE
    , `record has been retained for at least 5 years after the day the dog was supplied, even if the person has since ceased to hold the dog supply approval` IS FALSE

#ASSERT `the s 38V record-keeping requirements are satisfied` `a fully compliant record`
#ASSERT NOT (`the s 38V record-keeping requirements are satisfied` `a record destroyed early`)
#ASSERT NOT (`s 38V(4) offence -- failing to comply with the s 38V record-keeping requirements` `a fully compliant record`)
#ASSERT `s 38V(4) offence -- failing to comply with the s 38V record-keeping requirements` `a record destroyed early`

#TRACE `s 38W(4) compliance duty` 14 AT 0 WITH
    PARTY `A Person Subject To This Division` DOES `comply with a s 38W(1) request` AT 10
-- Result: FULFILLED (complied within the specified 14-day deadline)

#TRACE `s 38W(4) compliance duty` 14 AT 0 WITH
    (`WAIT UNTIL` 15)
-- Result: DEONTIC BREACHED -- not complied with within the specified deadline

#ASSERT NOT (`s 38W(4) offence -- failing to comply with a s 38W(1) request in time` TRUE)
#ASSERT `s 38W(4) offence -- failing to comply with a s 38W(1) request in time` FALSE

`an eligible, fully specified s 38W(1) request` MEANS `S38W Request Facts` WITH
    `person holds or has held a dog supply approval` IS TRUE
    , `CEO requested a record, information or evidence the person is required to keep under s 38V` IS TRUE
    , `CEO requested other information, evidence or a document the CEO requires to determine if the approval should remain in force` IS FALSE
    , `request specifies the time within which the material must be provided` IS TRUE

`a request of a person who never held a dog supply approval` MEANS `S38W Request Facts` WITH
    `person holds or has held a dog supply approval` IS FALSE
    , `CEO requested a record, information or evidence the person is required to keep under s 38V` IS TRUE
    , `CEO requested other information, evidence or a document the CEO requires to determine if the approval should remain in force` IS FALSE
    , `request specifies the time within which the material must be provided` IS TRUE

`a s 38W(1) request naming no content at all` MEANS `S38W Request Facts` WITH
    `person holds or has held a dog supply approval` IS TRUE
    , `CEO requested a record, information or evidence the person is required to keep under s 38V` IS FALSE
    , `CEO requested other information, evidence or a document the CEO requires to determine if the approval should remain in force` IS FALSE
    , `request specifies the time within which the material must be provided` IS TRUE

`a s 38W(1) request silent on the time to provide the material` MEANS `S38W Request Facts` WITH
    `person holds or has held a dog supply approval` IS TRUE
    , `CEO requested a record, information or evidence the person is required to keep under s 38V` IS TRUE
    , `CEO requested other information, evidence or a document the CEO requires to determine if the approval should remain in force` IS FALSE
    , `request specifies the time within which the material must be provided` IS FALSE

#ASSERT `the CEO may make a s 38W(1) request` `an eligible, fully specified s 38W(1) request`
#ASSERT NOT (`the CEO may make a s 38W(1) request` `a request of a person who never held a dog supply approval`)
#ASSERT `a s 38W(1) request has been made` `an eligible, fully specified s 38W(1) request`
#ASSERT NOT (`a s 38W(1) request has been made` `a s 38W(1) request naming no content at all`)
#ASSERT `the s 38W(3) request-content requirement is satisfied` `an eligible, fully specified s 38W(1) request`
#ASSERT NOT (`the s 38W(3) request-content requirement is satisfied` `a s 38W(1) request silent on the time to provide the material`)

#ASSERT `the pet shop business is an applicable pet shop business in relation to the local government` TRUE
#ASSERT NOT (`the pet shop business is an applicable pet shop business in relation to the local government` FALSE)

`eligible for a s 38X(2) request` MEANS `S38X Request Facts` WITH
    `person holds, has held, or purports to hold or have held, a dog supply approval` IS TRUE
    , `person supplies, or has supplied, dogs to an applicable pet shop business` IS TRUE
    , `local government requested evidence that the person holds or has held the dog supply approval` IS TRUE
    , `local government requested a copy of the health certificate of a dog supplied by the person to an applicable pet shop business in the previous 5 years or, if a shorter period, the period since the person was granted the dog supply approval` IS FALSE

`never supplied to an applicable pet shop business` MEANS `S38X Request Facts` WITH
    `person holds, has held, or purports to hold or have held, a dog supply approval` IS TRUE
    , `person supplies, or has supplied, dogs to an applicable pet shop business` IS FALSE
    , `local government requested evidence that the person holds or has held the dog supply approval` IS TRUE
    , `local government requested a copy of the health certificate of a dog supplied by the person to an applicable pet shop business in the previous 5 years or, if a shorter period, the period since the person was granted the dog supply approval` IS FALSE

`a s 38X(2) request naming no content at all` MEANS `S38X Request Facts` WITH
    `person holds, has held, or purports to hold or have held, a dog supply approval` IS TRUE
    , `person supplies, or has supplied, dogs to an applicable pet shop business` IS TRUE
    , `local government requested evidence that the person holds or has held the dog supply approval` IS FALSE
    , `local government requested a copy of the health certificate of a dog supplied by the person to an applicable pet shop business in the previous 5 years or, if a shorter period, the period since the person was granted the dog supply approval` IS FALSE

#ASSERT `the local government may make a s 38X(2) request` `eligible for a s 38X(2) request`
#ASSERT NOT (`the local government may make a s 38X(2) request` `never supplied to an applicable pet shop business`)
#ASSERT `a s 38X(2) request has been made` `eligible for a s 38X(2) request`
#ASSERT NOT (`a s 38X(2) request has been made` `a s 38X(2) request naming no content at all`)
#ASSERT `the s 38X(4) request-content requirement is satisfied` TRUE
#ASSERT NOT (`the s 38X(4) request-content requirement is satisfied` FALSE)

#TRACE `s 38X(5) compliance duty` 10 AT 0 WITH
    PARTY `A Person Subject To This Division` DOES `comply with a s 38X(2) request` AT 3
-- Result: FULFILLED (complied within the specified 10-day deadline)

#TRACE `s 38X(5) compliance duty` 10 AT 0 WITH
    (`WAIT UNTIL` 11)
-- Result: DEONTIC BREACHED -- not complied with within the specified deadline

#ASSERT NOT (`s 38X(5) offence -- failing to comply with a s 38X(2) request in time` TRUE)
#ASSERT `s 38X(5) offence -- failing to comply with a s 38X(2) request in time` FALSE

`material from a s 38W(1)(a) request, in Act proceedings` MEANS `S38Y Proceedings Facts` WITH
    `material was provided in compliance with a request under s 38W(1)(a)` IS TRUE
    , `proceedings are for an offence against this Act` IS TRUE
    , `proceedings are for perjury` IS FALSE
    , `proceedings are for an offence against s 43AA` IS FALSE

`material from a s 38W(1)(a) request, in unrelated proceedings` MEANS `S38Y Proceedings Facts` WITH
    `material was provided in compliance with a request under s 38W(1)(a)` IS TRUE
    , `proceedings are for an offence against this Act` IS FALSE
    , `proceedings are for perjury` IS FALSE
    , `proceedings are for an offence against s 43AA` IS TRUE

`material from any other request, in a s 43AA prosecution` MEANS `S38Y Proceedings Facts` WITH
    `material was provided in compliance with a request under s 38W(1)(a)` IS FALSE
    , `proceedings are for an offence against this Act` IS FALSE
    , `proceedings are for perjury` IS FALSE
    , `proceedings are for an offence against s 43AA` IS TRUE

#ASSERT `the material is admissible against the individual under s 38Y(2)` `material from a s 38W(1)(a) request, in Act proceedings`
#ASSERT NOT (`the material is admissible against the individual under s 38Y(2)` `material from a s 38W(1)(a) request, in unrelated proceedings`)
#ASSERT `the material is admissible against the individual under s 38Y(2)` `material from any other request, in a s 43AA prosecution`
