IMPORT prelude
IMPORT `tpi-rights`

-- Third Parties (Rights Against Insurers) Act 1930, ss 1, 2, 3, 3A -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_third-parties-rights-against-insurers-act-1930.py). Expected results were written by
-- hand from the text.

`a bankrupt driver's motor policy` MEANS Claim WITH
    `the insured` IS `an individual`
    `the event` IS `bankruptcy`
    `insured against liabilities to third parties` IS TRUE
    `liability incurred to the third party` IS TRUE
    `liability incurred only after the event` IS FALSE
    `liability is as insurer under another contract` IS FALSE
    `voluntary winding up merely for reconstruction or amalgamation` IS FALSE
    `Work Injury Compensation Act section 28 applies` IS FALSE

`a bankrupt driver, accident after the bankruptcy` MEANS Claim WITH
    `the insured` IS `an individual`
    `the event` IS `bankruptcy`
    `insured against liabilities to third parties` IS TRUE
    `liability incurred to the third party` IS TRUE
    `liability incurred only after the event` IS TRUE
    `liability is as insurer under another contract` IS FALSE
    `voluntary winding up merely for reconstruction or amalgamation` IS FALSE
    `Work Injury Compensation Act section 28 applies` IS FALSE

