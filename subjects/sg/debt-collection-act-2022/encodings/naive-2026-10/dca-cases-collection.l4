IMPORT prelude
IMPORT `dca-collection`

-- Debt Collection Act 2022, ss 2, 6, 17, 25, 33-35, 37, 46 and First and Second Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_debt-collection-act-2022.py). Expected results were written by
-- hand from the text.

§ `s 2, s 6 and First Schedule`

#ASSERT `needs a licence` `a debt collection agency collecting for a client`
#ASSERT `needs a licence` `a company that bought the debt from the creditor`
#ASSERT NOT `needs a licence` `a bank collecting its own loan`
#ASSERT NOT `needs a licence` `a landlord collecting its own rent`
#ASSERT NOT `needs a licence` `a law practice collecting for a client`
#ASSERT NOT `needs a licence` `a chartered accountant acting as such`
#ASSERT NOT `needs a licence` `a company that took over receivables in a merger`

#ASSERT `needs a class licence` `a bank collecting its own loan`
#ASSERT `needs a class licence` `a credit card issuer collecting its own card debt`

#ASSERT `is outside section 6` `a landlord collecting its own rent`
#ASSERT NOT `is outside section 6` `a law practice collecting for a client`

