IMPORT prelude
IMPORT `cfa-chitfunds`

-- Chit Funds Act 1971, ss 2, 4, 5, 9, 14, 18-20, 24, 28, 30, 31, 33, 34, 39-41, 43, 44, 56, 59-61 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_chit-funds-act-1971.py). Expected results were written by
-- hand from the text.

§ `ss 4 and 9`

#ASSERT `may transact chit fund business` TRUE TRUE
#ASSERT NOT `may transact chit fund business` FALSE TRUE

#ASSERT `meets the minimum capital` 200000
#ASSERT NOT `meets the minimum capital` 199999

§ `s 5`

#ASSERT `using the word in a business name is an offence` `tontine` FALSE FALSE FALSE
#ASSERT NOT `using the word in a business name is an offence` `chit fund` TRUE FALSE FALSE
#ASSERT NOT `using the word in a business name is an offence` `chit` FALSE TRUE FALSE
#ASSERT NOT `using the word in a business name is an offence` `savings` FALSE FALSE FALSE

§ `ss 18 to 20`

#ASSERT `the scheme is a chit fund` TRUE FALSE
#ASSERT NOT `the scheme is a chit fund` TRUE TRUE

#ASSERT NOT `claims under the scheme are enforceable in court` FALSE FALSE

#ASSERT NOT `taking part in running the scheme is an offence` TRUE FALSE TRUE TRUE
#ASSERT `taking part in running the scheme is an offence` TRUE FALSE FALSE TRUE

§ `ss 2, 24 and 39`

#ASSERT `the prize` 20000 3000 EQUALS 17000

#ASSERT `the rebate` 3000 20 EQUALS 150

#ASSERT `may bid at the sale` FALSE FALSE
#ASSERT NOT `may bid at the sale` FALSE TRUE

§ `ss 28, 33 and 41`

#ASSERT `the alteration is carried` 15 20 15000 20000
#ASSERT NOT `the alteration is carried` 14 20 14000 20000

#ASSERT `the reduction of membership is carried` 14 20 14000 20000
#ASSERT NOT `the reduction of membership is carried` 13 20 13000 20000

#ASSERT NOT `sealed tenders are adopted` 15 20 15000 20000 FALSE

§ `ss 30, 31 and 34`

#ASSERT NOT `the prize may be paid` 1

#ASSERT `the purchaser is out of time for guarantors` 15 1
#ASSERT NOT `the purchaser is out of time for guarantors` 14 1

#ASSERT `days after the auction by which the company must act` TRUE EQUALS 21
#ASSERT `days after the auction by which the company must act` FALSE EQUALS 28

#ASSERT `the guarantor refund is overdue` 22 FALSE
#ASSERT NOT `the guarantor refund is overdue` 21 FALSE

#ASSERT `the sum immediately payable by a defaulting purchaser` 1000 12 EQUALS 12000

§ `s 40(2)`

#ASSERT `the subscriber may recover contributions from the company` `revocation of the licence` FALSE
#ASSERT NOT `the subscriber may recover contributions from the company` `voluntary reduction of membership` FALSE
#ASSERT NOT `the subscriber may recover contributions from the company` `revocation of the licence` TRUE

§ `s 43`

#ASSERT `the loan is permitted` TRUE FALSE 7500 10000
#ASSERT NOT `the loan is permitted` TRUE FALSE 7501 10000

§ `s 44`

#ASSERT `the minimum transfer to reserve` 400000 200000 100000 EQUALS 5000
#ASSERT `the minimum transfer to reserve` 200000 200000 100000 EQUALS 15000
#ASSERT `the minimum transfer to reserve` 199999 200000 100000 EQUALS 30000

§ `s 14`

#ASSERT `the revocation notice is long enough` 21
#ASSERT NOT `the revocation notice is long enough` 20

#ASSERT NOT `the appeal is in time` 15 FALSE
#ASSERT `the appeal is in time` 30 TRUE

§ `ss 59 and 60`

#ASSERT `the director is guilty` TRUE FALSE
#ASSERT NOT `the director is guilty` TRUE TRUE

#ASSERT NOT `the director may be imprisoned` TRUE FALSE FALSE

#ASSERT `the officer is guilty of holding out` TRUE FALSE FALSE
#ASSERT NOT `the officer is guilty of holding out` TRUE FALSE TRUE

§ `Maximum penalties`

#ASSERT `the maximum fine` `unlicensed chit fund business, s 4` EQUALS 5000
#ASSERT `the maximum fine` `misuse of the word chit, s 5` EQUALS 1000

#ASSERT `the maximum years of imprisonment` `holding out as licensed, s 60` EQUALS 2

