{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqa/coverage.schema.json",
  "title": "Coverage record (4A)",
  "description": "Which provisions are encoded, in which modules, and which are not and why; and the console scheme drafted from the encoding.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "subject",
    "parts",
    "not_encoded",
    "scheme"
  ],
  "properties": {
    "kind": {
      "const": "coverage"
    },
    "version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "part",
          "modules",
          "provisions"
        ],
        "properties": {
          "part": {
            "description": "a Part or Division label; probe-record.json refers to these",
            "type": "string",
            "minLength": 1
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "not_encoded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provisions",
          "reason"
        ],
        "properties": {
          "provisions": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scheme": {
      "type": "object",
      "required": [
        "file",
        "id"
      ],
      "properties": {
        "file": {
          "description": "the schemes file, relative to the subject",
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
