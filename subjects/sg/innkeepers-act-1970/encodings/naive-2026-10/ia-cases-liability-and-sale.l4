§ `s 7 -- power of sale`

`unpaid guest's car auctioned after 7 weeks` MEANS Sale WITH
    `the inn` IS `a hotel`
    `the debt is for board or lodging` IS TRUE
    `left in the inn or its garage, car park or other appurtenant premises` IS TRUE
    `weeks held with the debt unpaid` IS 7
    `a newspaper notice appeared at least one month before` IS TRUE
    `by public auction` IS TRUE

`auction after exactly 6 weeks` MEANS Sale WITH
    `the inn` IS `a hotel`
    `the debt is for board or lodging` IS TRUE
    `left in the inn or its garage, car park or other appurtenant premises` IS TRUE
    `weeks held with the debt unpaid` IS 6
    `a newspaper notice appeared at least one month before` IS TRUE
    `by public auction` IS TRUE

`auction after 5 weeks` MEANS Sale WITH
    `the inn` IS `a hotel`
    `the debt is for board or lodging` IS TRUE
    `left in the inn or its garage, car park or other appurtenant premises` IS TRUE
    `weeks held with the debt unpaid` IS 5
    `a newspaper notice appeared at least one month before` IS TRUE
    `by public auction` IS TRUE

`auction with no newspaper notice` MEANS Sale WITH
    `the inn` IS `a hotel`
    `the debt is for board or lodging` IS TRUE
    `left in the inn or its garage, car park or other appurtenant premises` IS TRUE
    `weeks held with the debt unpaid` IS 7
    `a newspaper notice appeared at least one month before` IS FALSE
    `by public auction` IS TRUE

`private sale instead of auction` MEANS Sale WITH
    `the inn` IS `a hotel`
    `the debt is for board or lodging` IS TRUE
    `left in the inn or its garage, car park or other appurtenant premises` IS TRUE
    `weeks held with the debt unpaid` IS 7
    `a newspaper notice appeared at least one month before` IS TRUE
