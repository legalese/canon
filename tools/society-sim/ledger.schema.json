{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legalese/commons/tools/society-sim/ledger.schema.json",
  "title": "Requirement ledger entry",
  "description": "One line of subjects/<jurisdiction>/requirements.jsonl: a question the simulation asked that the encoding library could not answer, written as a brief for an encoder. See LEDGER.md.",
  "type": "object",
  "required": ["id", "raised", "status", "kind", "instrument", "question", "trigger", "expected", "attach_to", "count", "first_seen", "last_seen", "closes_when"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^REQ-[0-9]{4,}$" },
    "raised": {
      "type": "object",
      "required": ["on", "by"],
      "additionalProperties": false,
      "properties": {
        "on": { "type": "string", "format": "date" },
        "by": { "type": "string", "enum": ["hand", "replay", "simulation", "lqa"] },
        "run": {
          "type": "object",
          "description": "The run that raised it, when by is replay or simulation.",
          "additionalProperties": false,
          "properties": {
            "seed": { "type": ["integer", "string"] },
            "mode": { "type": "string", "enum": ["scenario", "simulation", "real-time", "sandpit"] },
            "scenario": { "type": "string" },
            "snapshot": { "type": "string", "description": "For a sandpit fork: the snapshot it was forked from." }
          }
        }
      }
    },
    "status": { "type": "string", "enum": ["open", "claimed", "satisfied", "declined", "superseded"] },
    "kind": {
      "type": "string",
      "enum": ["no-subject", "no-row", "out-of-scope", "named-refusal", "supplied-fact", "policy", "case-law", "cross-row", "rule-version", "unclassified"]
    },
    "instrument": {
      "type": "object",
      "required": ["type", "title"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["act", "constitution", "regulation", "rules", "order", "notification", "notice", "case", "common-law", "policy", "row"] },
        "title": { "type": "string", "minLength": 3 },
        "citation": { "type": "string" },
        "subject": { "type": ["string", "null"], "description": "Slug under subjects/<jurisdiction>/ if one exists, else null.", "pattern": "^[a-z0-9][a-z0-9-/]*$" },
        "row": { "type": "string", "description": "The encoding row concerned, if any." },
        "provision": { "type": "string" },
        "parent_subject": { "type": "string", "description": "For subsidiary legislation: the Act's subject slug." },
        "second": {
          "type": "object",
          "description": "For kind cross-row: the other row.",
          "additionalProperties": false,
          "properties": { "subject": { "type": "string" }, "row": { "type": "string" }, "provision": { "type": "string" } }
        }
      }
    },
    "question": { "type": "string", "minLength": 20, "description": "Must make sense read on its own." },
    "trigger": {
      "type": "object",
      "required": ["date", "act"],
      "additionalProperties": false,
      "properties": {
        "event": { "type": "string", "description": "Scenario event id, e.g. e041." },
        "date": { "type": "string", "format": "date" },
        "actor": { "type": "string" },
        "act": { "type": "string", "description": "What the actor did or was about to do." },
        "subjects_engaged": { "type": "array", "items": { "type": "string" } }
      }
    },
    "facts": { "type": "object", "description": "The record the adjudicator built and could not evaluate." },
    "expected": {
      "type": "object",
      "required": ["shape"],
      "additionalProperties": false,
      "properties": {
        "shape": { "type": "string", "enum": ["boolean", "money", "date", "duration", "status", "enum", "number", "text", "unknown"] },
        "assertion": { "type": "string", "description": "The test the scenario would make, in words or as an L4 #ASSERT." },
        "value": { "description": "The value the raiser believes correct, if known; a supplied fact until the row computes it." }
      }
    },
    "assumption": {
      "type": "object",
      "description": "What the simulation assumed to proceed, and what it tainted.",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "source": { "type": "string", "description": "Where the assumed value came from, e.g. CPF Board website, 2026." },
        "tainted_traces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "attach_to": {
      "type": "object",
      "required": ["how"],
      "additionalProperties": false,
      "properties": {
        "how": { "type": "string", "enum": ["scope", "fork", "new-row", "new-subject", "policy-row", "dated-arm"] },
        "subject": { "type": "string" },
        "row": { "type": "string" },
        "fork": { "type": "string", "description": "Fork id in the row's register, for how = fork." },
        "note": { "type": "string" }
      }
    },
    "count": { "type": "integer", "minimum": 1 },
    "first_seen": { "type": "string", "format": "date" },
    "last_seen": { "type": "string", "format": "date" },
    "priority": { "type": "number" },
    "closes_when": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "seed": { "type": ["integer", "string"] },
        "scenario": { "type": "string" },
        "event": { "type": "string" }
      }
    },
    "claimed_by": { "type": "string" },
    "claimed_on": { "type": "string", "format": "date" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": { "type": "string", "format": "date" },
        "subject": { "type": "string" },
        "row": { "type": "string" },
        "commit": { "type": "string" },
        "reason": { "type": "string", "description": "For declined." },
        "merged_into": { "type": "string", "pattern": "^REQ-[0-9]{4,}$" },
        "reading": { "type": "string", "description": "For cross-row: which row's reading was adopted, and why." }
      }
    },
    "notes": { "type": "string" }
  }
}
