`an individual who skipped the course` MEANS IndividualApplicant WITH
    `meets the prescribed qualified individual criteria` IS TRUE
    `completed the prescribed course` IS FALSE
    `is not fit and proper` IS FALSE
    `had a registration cancelled under section 21` IS FALSE
    `months since the cancellation` IS 0

`an individual cancelled under section 21 23 months ago` MEANS IndividualApplicant WITH
    `meets the prescribed qualified individual criteria` IS TRUE
    `completed the prescribed course` IS TRUE
    `is not fit and proper` IS FALSE
    `had a registration cancelled under section 21` IS TRUE
    `months since the cancellation` IS 23

`an individual cancelled under section 21 25 months ago` MEANS IndividualApplicant WITH
    `meets the prescribed qualified individual criteria` IS TRUE
    `completed the prescribed course` IS TRUE
    `is not fit and proper` IS FALSE
    `had a registration cancelled under section 21` IS TRUE
    `months since the cancellation` IS 25

`a registered provider breaching a condition` MEANS Contravention WITH
    `is deemed registered` IS FALSE
    `breached a condition of registration` IS TRUE
    `breached a requirement that is not an offence` IS FALSE
    `breached only a requirement that is an offence` IS FALSE

`a deemed provider breaching a condition` MEANS Contravention WITH
    `is deemed registered` IS TRUE
    `breached a condition of registration` IS TRUE
    `breached a requirement that is not an offence` IS FALSE
    `breached only a requirement that is an offence` IS FALSE

`a deemed provider breaching a non-offence requirement` MEANS Contravention WITH
    `is deemed registered` IS TRUE
    `breached a condition of registration` IS FALSE
    `breached a requirement that is not an offence` IS TRUE
    `breached only a requirement that is an offence` IS FALSE

`a provider committing only an offence` MEANS Contravention WITH
    `is deemed registered` IS FALSE
    `breached a condition of registration` IS FALSE
    `breached a requirement that is not an offence` IS FALSE
    `breached only a requirement that is an offence` IS TRUE

§ `s 2`

#ASSERT `the service is a corporate service` `forming a foreign company for a client`
#ASSERT `the service is a corporate service` `acting as nominee shareholder of an unlisted company`
#ASSERT NOT `the service is a corporate service` `acting as nominee shareholder of a listed company`
#ASSERT `the service is a corporate service` `managing client money in the course of an accounting service`
#ASSERT NOT `the service is a corporate service` `preparing a client's tax return`
#ASSERT `the service is a corporate service` `filing with ACRA electronically for a client`

§ `ss 7 and 42`

#ASSERT `carrying on the business is an offence` `an unregistered incorporation agent`
#ASSERT NOT `carrying on the business is an offence` `a registered incorporation agent`
#ASSERT `carrying on the business is an offence` `a suspended incorporation agent`
#ASSERT NOT `carrying on the business is an offence` `an accounting firm managing client money`
#ASSERT `carrying on the business is an offence` `a suspended accounting firm managing client money`
#ASSERT `carrying on the business is an offence` `an accounting firm offering registered office addresses`
#ASSERT NOT `carrying on the business is an offence` `an existing agent in the transitional period`

#ASSERT `an existing business may continue under section 42` 5 FALSE FALSE
#ASSERT NOT `an existing business may continue under section 42` 7 FALSE FALSE
#ASSERT `an existing business may continue under section 42` 7 TRUE TRUE

#ASSERT `the maximum fine for an unregistered business` 10 EQUALS 75000

§ `ss 8 and 10`

#ASSERT `the renewal application is not too early` 60
#ASSERT NOT `the renewal application is not too early` 61

§ `s 9`

#ASSERT NOT `the Registrar must refuse the provider` `a company employing a registered qualified individual`
#ASSERT `the Registrar must refuse the provider` `a company with no registered qualified individual`
#ASSERT `the Registrar must refuse the provider` `a society employing a registered qualified individual`
#ASSERT `the Registrar must refuse the provider` `an unregistered individual who is a qualified individual`
#ASSERT `the Registrar must refuse the provider` `a sole proprietor who is a qualified individual but skipped the course`
#ASSERT `the Registrar must refuse the provider` `a company with an unfit director`
#ASSERT `the Registrar must refuse the provider` `a company cancelled under section 19 a year ago`
#ASSERT NOT `the Registrar must refuse the provider` `a company cancelled under section 19 three years ago`

§ `s 11`

#ASSERT `the Registrar must refuse the individual` `an individual who skipped the course`
#ASSERT `the Registrar must refuse the individual` `an individual cancelled under section 21 23 months ago`
#ASSERT NOT `the Registrar must refuse the individual` `an individual cancelled under section 21 25 months ago`

§ `s 12`

#ASSERT `the late notice is an offence` FALSE 15
#ASSERT NOT `the late notice is an offence` TRUE 30

§ `s 14`

#ASSERT `the service is provided as section 14 requires` FALSE TRUE TRUE
#ASSERT NOT `the service is provided as section 14 requires` FALSE TRUE FALSE

§ `s 16`

#ASSERT NOT `arranging the nominee director is an offence` TRUE TRUE TRUE TRUE
#ASSERT `arranging the nominee director is an offence` TRUE TRUE FALSE TRUE

§ `s 17`

#ASSERT `the provider may skip customer due diligence` TRUE TRUE FALSE
#ASSERT NOT `the provider may skip customer due diligence` TRUE TRUE TRUE
#ASSERT NOT `the provider may skip customer due diligence` TRUE FALSE FALSE

#ASSERT `the provider must decline and consider a disclosure` FALSE

§ `ss 19 and 21`

#ASSERT `section 19 applies` `a registered provider breaching a condition`
#ASSERT NOT `section 19 applies` `a deemed provider breaching a condition`
#ASSERT `section 19 applies` `a deemed provider breaching a non-offence requirement`
#ASSERT NOT `section 19 applies` `a provider committing only an offence`

#ASSERT `the maximum financial penalty` `a corporate service provider` 3 EQUALS 75000
#ASSERT `the maximum financial penalty` `a qualified individual` 3 EQUALS 30000

#ASSERT `the suspension is within power` 12
#ASSERT NOT `the suspension is within power` 13

§ `s 23`

#ASSERT NOT `the appeal is in time` 31

#ASSERT `the decision must be obeyed pending the appeal` FALSE

§ `ss 7, 12, 17, 25 and 27`

#ASSERT `the maximum composition sum` `carrying on business unregistered` EQUALS 20000
#ASSERT `the maximum composition sum` `failing to notify a change` EQUALS 5000

#ASSERT `the maximum fine` `failing in customer due diligence` EQUALS 100000

#ASSERT `the maximum months of imprisonment` `giving false information to the Registrar` EQUALS 24

