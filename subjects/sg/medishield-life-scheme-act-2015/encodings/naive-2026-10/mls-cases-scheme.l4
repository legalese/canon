IMPORT prelude
IMPORT `mls-scheme`

-- MediShield Life Scheme Act 2015, ss 3(3), 3B(3)-(4), 4, 12(4), 13, 16(6), 17, 19, 21(4), 22, 24, 27(4), 28(6), 29 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_medishield-life-scheme-act-2015.py). Expected results were written by
-- hand from the text.

§ `s 3(3)`

#ASSERT `the Scheme applies` `a citizen`
#ASSERT `the Scheme applies` `a permanent resident`
#ASSERT NOT `the Scheme applies` `a visitor`

§ `s 4`

#ASSERT `the last day for paying the premium` 0 EQUALS 30
#ASSERT `the last day for paying the premium` 60 EQUALS 60

#ASSERT NOT `the premium is paid in time` 31 0
