    `driven solely by human physical effort` IS TRUE
    `designed to carry patrons on a course for amusement` IS TRUE
    `available to members of the public` IS TRUE
    `fixed to a non-moving base` IS FALSE
    `operates as a children's ride on inserting a coin or token` IS FALSE
    `playground equipment` IS TRUE
    `prescribed to be an amusement ride` IS FALSE
    `prescribed as not being an amusement ride` IS FALSE

`a private ride in a condominium closed to the public` MEANS Device WITH
    `mechanised or power-driven` IS TRUE
    `driven solely by human physical effort` IS FALSE
    `designed to carry patrons on a course for amusement` IS TRUE
    `available to members of the public` IS FALSE
    `fixed to a non-moving base` IS FALSE
    `operates as a children's ride on inserting a coin or token` IS FALSE
    `playground equipment` IS FALSE
    `prescribed to be an amusement ride` IS FALSE
    `prescribed as not being an amusement ride` IS FALSE

`a prescribed motion simulator` MEANS Device WITH
    `mechanised or power-driven` IS TRUE
    `driven solely by human physical effort` IS FALSE
    `designed to carry patrons on a course for amusement` IS FALSE
    `available to members of the public` IS FALSE
    `fixed to a non-moving base` IS FALSE
    `operates as a children's ride on inserting a coin or token` IS FALSE
    `playground equipment` IS FALSE
    `prescribed to be an amusement ride` IS TRUE
    `prescribed as not being an amusement ride` IS FALSE

`a fully compliant operation` MEANS Operation WITH
    `holds a valid operating permit` IS TRUE
    `within the permit conditions` IS TRUE
    `in good repair and safe working condition` IS TRUE
    `fire and rescue certificate of compliance in force` IS TRUE
    `liability insurance at the prescribed minimum in force` IS TRUE
    `ride managers appointed` IS 1

`an operation with no ride manager` MEANS Operation WITH
    `holds a valid operating permit` IS TRUE
    `within the permit conditions` IS TRUE
    `in good repair and safe working condition` IS TRUE
    `fire and rescue certificate of compliance in force` IS TRUE
    `liability insurance at the prescribed minimum in force` IS TRUE
    `ride managers appointed` IS 0

`an operation whose insurance has lapsed` MEANS Operation WITH
    `holds a valid operating permit` IS TRUE
    `within the permit conditions` IS TRUE
    `in good repair and safe working condition` IS TRUE
    `fire and rescue certificate of compliance in force` IS TRUE
    `liability insurance at the prescribed minimum in force` IS FALSE
    `ride managers appointed` IS 2

`an operation without a fire certificate` MEANS Operation WITH
    `holds a valid operating permit` IS TRUE
    `within the permit conditions` IS TRUE
    `in good repair and safe working condition` IS TRUE
    `fire and rescue certificate of compliance in force` IS FALSE
    `liability insurance at the prescribed minimum in force` IS TRUE
    `ride managers appointed` IS 1

§ `s 2 -- amusement ride`

#ASSERT `is an amusement ride` `a theme park roller coaster`
#ASSERT NOT `is an amusement ride` `a mall coin-operated kiddie ride`
#ASSERT `is an amusement ride` `a token ride on a moving base`
#ASSERT NOT `is an amusement ride` `a rider-propelled playground merry-go-round`
#ASSERT NOT `is an amusement ride` `a private ride in a condominium closed to the public`
#ASSERT `is an amusement ride` `a prescribed motion simulator`

§ `s 2 -- person responsible`

#ASSERT `is a person responsible` `the operating permit holder` TRUE
#ASSERT NOT `is a person responsible` `the owner of the premises` TRUE
#ASSERT `is a person responsible` `the owner of the premises` FALSE
#ASSERT `is a person responsible` `the public entertainment licensee for the approved place` FALSE
#ASSERT NOT `is a person responsible` `a patron` FALSE

§ `s 13`

#ASSERT `the operation is lawful` `a fully compliant operation`
#ASSERT NOT `the operation is lawful` `an operation with no ride manager`
#ASSERT NOT `the operation is lawful` `an operation whose insurance has lapsed`
#ASSERT NOT `the operation is lawful` `an operation without a fire certificate`

§ `s 15`

#ASSERT `the permit is still within its term` 11 12
#ASSERT NOT `the permit is still within its term` 12 12
#ASSERT NOT `the permit is still within its term` 13 24

§ `s 16`

#ASSERT `the vacancy notice is in time` 14
#ASSERT NOT `the vacancy notice is in time` 15

#ASSERT `the ride may keep running after a ride manager leaves` 1 FALSE FALSE
#ASSERT NOT `the ride may keep running after a ride manager leaves` 0 TRUE FALSE
#ASSERT `the ride may keep running after a ride manager leaves` 0 TRUE TRUE

§ `s 18`

#ASSERT `resuming is an offence` TRUE TRUE FALSE
#ASSERT NOT `resuming is an offence` TRUE TRUE TRUE

§ `s 22`

#ASSERT `the permit lapses automatically` `the holder company is wound up`
#ASSERT `the permit lapses automatically` `the liability insurance lapses`
#ASSERT NOT `the permit lapses automatically` `the ride is idle for four months`

#ASSERT `idleness permits revocation` 4 FALSE
#ASSERT NOT `idleness permits revocation` 6 TRUE

#ASSERT `may revoke without a hearing` FALSE FALSE TRUE FALSE

§ `ss 35, 54`

#ASSERT `is an adverse incident` `riders stranded at the top`
#ASSERT `is an adverse incident` `a near miss likely to have injured a bystander`
#ASSERT `is an adverse incident` `a car detaching from the track`
#ASSERT NOT `is an adverse incident` `a long queue`

#ASSERT `must report an adverse incident` `a ride manager` TRUE
#ASSERT NOT `must report an adverse incident` `the owner of the premises` TRUE
#ASSERT `must report an adverse incident` `the owner of the premises` FALSE

#ASSERT NOT `the ride must be closed or cordoned off` `a long queue` FALSE
#ASSERT `the ride must be closed or cordoned off` `riders stranded at the top` FALSE

§ `ss 19(3), 59(2)`

#ASSERT `failing to notify a contravention is an offence` TRUE FALSE FALSE
#ASSERT NOT `failing to notify a contravention is an offence` TRUE FALSE TRUE

#ASSERT `the shared-duty defence succeeds` TRUE TRUE FALSE
#ASSERT NOT `the shared-duty defence succeeds` FALSE TRUE FALSE

§ `Penalties`

#ASSERT `the maximum fine for` `operating outside section 13` 0 EQUALS 200000
#ASSERT `the maximum fine for` `operating outside section 13` 10 EQUALS 210000
#ASSERT `the maximum fine for` `breaching the duty to operate safely` 30 EQUALS 115000
#ASSERT `the maximum fine for` `ignoring a cessation notice` 30 EQUALS 50000

#ASSERT (`the penalty for` `installing without an installation permit`)'s `maximum imprisonment in months` EQUALS 24

§ `s 62`

#ASSERT `the most a composition can be` `operating outside section 13` EQUALS 5000
#ASSERT `the most a composition can be` `not notifying a closure` EQUALS 5000

