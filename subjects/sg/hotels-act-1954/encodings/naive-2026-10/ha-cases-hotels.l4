IMPORT prelude
IMPORT `ha-hotels`

-- Hotels Act 1954, ss 2, 5 to 9, 11 to 16 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_hotels-act-1954.py). Expected results were written by
-- hand from the text.

`a ten-room inn with housekeeping` MEANS Premises WITH
    `is a boarding house, lodging house or guesthouse` IS FALSE
    `is a public institution` IS FALSE
    `rooms or cubicles` IS 10
    `persons lodged for hire or reward` IS TRUE
    `domestic service provided to them` IS TRUE
    `shortest letting period in days` IS 1
    `exempted by regulations` IS FALSE

`a four-room homestay with breakfast` MEANS Premises WITH
    `is a boarding house, lodging house or guesthouse` IS FALSE
    `is a public institution` IS FALSE
    `rooms or cubicles` IS 4
    `persons lodged for hire or reward` IS TRUE
    `domestic service provided to them` IS TRUE
    `shortest letting period in days` IS 3
    `exempted by regulations` IS FALSE

