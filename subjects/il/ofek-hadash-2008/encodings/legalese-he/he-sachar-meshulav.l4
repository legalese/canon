IMPORT prelude
IMPORT `he-domain`

IMPORT `he-tavlaot`
IMPORT `he-mishra`

§ `אופק חדש — שיבוץ בטבלאות, התקדמות בדרגה, והסכומים התלויים בדרגה`

-- ===========================================================================
-- מה יש במודול הזה. באיזו שורה ובאיזו עמודה של איזו טבלה עומד המורה, כיצד
-- הוא נע ביניהן, ושלושת הסכומים הנגזרים מן השלישייה (טבלה, דרגה, ותק):
-- שכר משולב, תוספת אופק 2022 ותוספת שקלית 2016.
--
-- מה אין במודול הזה. אין כאן אף מספר מתוך טבלה: הסכומים יושבים
-- ב-`he-tavlaot`, וכאן יש רק המפתח שבו ניגשים אליהם. אין כאן חישוב היקף
-- משרה — `he-mishra` עושה זאת, וחלקיותה מתקבלת כאן כפרמטר. אין כאן גמול
-- תפקיד, ערך שעה או רכיב המשולם לפי מה שהמורה עושה: כל אלה ב-`he-gmulim`.
-- אין כאן חודש לוח: `he-brutto` הוא היחיד שיודע איזה חודש היום.
--
-- קו החיתוך. הסעיפים שכאן חולקים זוג קלט אחד — דרגה וותק — ותבנית פלט
-- אחת: חיפוש בטבלה. סעיף 39 ואילך אינו חולק אף אחד מן השניים, שכן גמול
-- תפקיד תלוי במה שהמורה עושה ולא במקום שבו הוא עומד. זהו השבר שהמכשיר
-- עצמו עושה, בסופו של פרק ז'.
--
-- מקורות. הסכם הבסיס מיום 25.12.2008 סעיפים 35 עד 38; החלטת ועדת המעקב
-- העליונה מיום 19.2.2015, המחליפה את סעיפים 38(ב), 38(ו) ו־38(ט); ההסכם
-- הקיבוצי מיום 19.3.2017 סעיף 2; ההסכם הקיבוצי מיום 19.10.2022 סעיפים 4
-- ו־5; חוזר לבעלויות תשעז/3 וחוזר לבעלויות תשפו/6; תקנון שירות עובדי
-- הוראה סעיף 1.1(א); כותרות נספחי א'1 עד א'7.
--
-- כתיב. כמו ב-`he-domain`: טיפוס בצורת הציטוט, שדה בצורה המיודעת,
-- פרמטר בצורת הסמיכות. כל שם בגרשיים אחוריים. פונקציות הן צירופי פועל.
--
-- הערה נמדדת על @nlg, 19.9.2026, בהמשך לזו שב-`he-domain`. שורת `@nlg`
-- נצמדת לצומת שלפניה: מדדתי כאן שהיא מתלוננת `More than one NLG
-- annotation attached to: NUMBER` כשהיא באה מיד אחרי `DECLARE` שהשדה
-- האחרון בו נושא @nlg משלו, ואינה מתלוננת כשלפניה כותרת `§§` או כלל
-- שאינו נושא @nlg. לכן כל @nlg על כלל במודול הזה בא מיד אחרי כותרת `§§`.
--
-- הערה נמדדת שנייה: גרשיים ASCII בתוך שם בגרשיים אחוריים לא נוסו כאן,
-- ולכן שמות כמו "שירות חובה בצהל" נכתבים ללא גרשיים והציטוט המלא נשאר
-- בהערה. זו זהירות, לא ממצא.
-- ===========================================================================


§§ `הטיפוסים שהשיבוץ עשוי מהם`

-- נספחי א'1 ו־א'2 מודפסים בדרגות שלמות בלבד; נספחי א'3 עד א'7 מודפסים
-- בשבעה־עשר שלבים, ובהם חצאי הדרגות. זהו ההבדל המבני בין שתי המשפחות,
-- והוא שקובע איזו מהן פותרת מורה נתון. ראה פיצול F3.

@ref כותרות נספחי א'1 ו־א'2 מזה ונספחי א'3 עד א'7 מזה; הסכם 19.10.2022 סעיף 4
DECLARE `משפחת נספחים` IS ONE OF
    `נספחי הדרגות השלמות`   @nlg:he נספחי א'1 ו־א'2, המודפסים בדרגות שלמות
    `נספחי חצאי הדרגות`     @nlg:he נספחי א'3 עד א'7, המודפסים גם בחצאי דרגות

-- סעיף 5.1 להסכם 19.10.2022 שולח לנספחי ב' מיום 1.9.2022, וסעיף 5.2
-- לנספחי ג' מיום 1.9.2023. לשנת הלימודים תשפו חלים נספחי ג'.

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2
DECLARE `סדרת נספחי תוספת אופק` IS ONE OF
    `נספחי ב`   @nlg:he נספחי ב'1 עד ב'7, מיום 1.9.2022
    `נספחי ג`   @nlg:he נספחי ג'1 עד ג'7, מיום 1.9.2023

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2 — התקופות שהם יוצרים
DECLARE `תקופת תוספת אופק` IS ONE OF
    `לפני 1.9.2022`             @nlg:he התקופה שלפני 1.9.2022
    `מ־1.9.2022 עד 31.8.2023`   @nlg:he התקופה שמיום 1.9.2022 עד יום 31.8.2023
    `מ־1.9.2023 ואילך`          @nlg:he התקופה שמיום 1.9.2023 ואילך

-- תשע מדרגות, כמניין הסכומים שסעיף 6(ב)(5) להסכם ספטמבר 2016 מונה בנוסחו
-- שבסעיף 2(ה) לתיקון מיום 19.3.2017, וכמניין הסכומים שחוזר תשפו/6 מונה
-- מיום 1.1.2026. שמונה מדרגות נקובות בדרגתן, והתשיעית היא שיורית ונוסחה
-- "לכל יתר עובדי ההוראה עליהם חל חוזר זה ושאינם מצוינים לעיל".

@ref תיקון 19.3.2017 סעיף 2(ה), בהחליפו את סעיף 6(ב) להסכם ספטמבר 2016; חוזר תשפו/6
DECLARE `מדרגת תוספת שקלית 2016` IS ONE OF
    `מדרגת דרגה 1`             @nlg:he המדרגה של דרגה 1
    `מדרגת דרגה 1.5`           @nlg:he המדרגה של דרגה 1.5
    `מדרגת דרגה 2`             @nlg:he המדרגה של דרגה 2
    `מדרגת דרגה 2.5`           @nlg:he המדרגה של דרגה 2.5
    `מדרגת דרגה 3`             @nlg:he המדרגה של דרגה 3
    `מדרגת דרגה 3.5`           @nlg:he המדרגה של דרגה 3.5
    `מדרגת דרגה 4`             @nlg:he המדרגה של דרגה 4
    `מדרגת דרגה 4.5`           @nlg:he המדרגה של דרגה 4.5
    `מדרגת יתר עובדי ההוראה`   @nlg:he המדרגה של יתר עובדי ההוראה

-- השיבוץ הוא התשובה המלאה לשאלה "היכן עומד המורה": איזו טבלה, איזו
-- משפחת נספחים, איזו עמודה ואיזו שורה. שלוש הפונקציות שמוסרות סכום
-- מקבלות אותו, ולא את המורה, משום שזהו בדיוק המפתח שהטבלה מוכרת.

@ref הסכם הבסיס 25.12.2008 סעיפים 36 ו־37; כותרות נספחי א'1 עד א'7
DECLARE `שיבוץ` HAS
    `קוד הדירוג`      IS A `קוד דירוג`      @nlg:he קוד הדירוג שלפיו נבחרת הטבלה
    `משפחת הנספחים`   IS A `משפחת נספחים`   @nlg:he משפחת הנספחים
    `דרגת השיבוץ`     IS A `דרגה`           @nlg:he הדרגה, שהיא עמודת הטבלה
    `ותק השיבוץ`      IS A NUMBER           @nlg:he הוותק בשנים, שהוא שורת הטבלה


§§ `הממשק אל מודול הטבלאות`

-- שלושת הסכומים שהמודול הזה מוסר הם חיפוש בטבלה, והטבלאות שייכות
-- ל-`he-tavlaot`. שלוש ההגדרות שלהלן הן התפר: הן מתרגמות את השיבוץ —
-- קוד דירוג ומשפחת נספחים — לשם הנספח שמודול הטבלאות מכיר, ומוסרות לו
-- את הדרגה והוותק.
--
-- התפר אינו טריוויאלי, ולכן הוא כאן ולא שם. מודול הטבלאות מונה שבעה
-- נספחי שכר בשמם ואינו מכיר "משפחה"; מודול זה מכיר משפחה ואינו צריך
-- לדעת שבנספח א'6 יושב קוד 105. המיפוי בין שתי הלשונות הוא בדיוק כלל
-- השיבוץ של סעיף 36 בלבוש של שם נספח, ולכן מקומו בצד הזה של התפר.
--
-- הערת חיווט, 19.9.2026. המודול נכתב תחילה כשמודול הטבלאות טרם היה
-- קיים, ושלוש ההגדרות האלה היו אז `REFUSE` שכל אחת מהן נקראה על שם
-- המודול החסר. הן הוחלפו בהאצלה כשהמודול נחת. מה שלא השתנה: כל יתר
-- הקובץ, שלא ידע מעולם מהיכן באים המספרים.

@ref הסכם הבסיס 25.12.2008 סעיפים 36(ב) ו־36(ג); כותרות נספחי א'1 עד א'7
GIVEN `השיבוץ` IS A `שיבוץ`
GIVETH A `נספח שכר`
`נספח השכר של` `השיבוץ` MEANS
    CONSIDER `השיבוץ`'s `קוד הדירוג`
    WHEN `קוד דירוג 101` THEN IF   `בנספחי הדרגות השלמות`
                              THEN `נספח א'1`
                              ELSE `נספח א'3`
    WHEN `קוד דירוג 102` THEN IF   `בנספחי הדרגות השלמות`
                              THEN `נספח א'2`
                              ELSE `נספח א'4`
    WHEN `קוד דירוג 104` THEN `נספח א'5`
    WHEN `קוד דירוג 105` THEN `נספח א'6`
    WHEN `קוד דירוג 106` THEN `נספח א'7`
    WHERE
        `בנספחי הדרגות השלמות` MEANS
            `השיבוץ`'s `משפחת הנספחים` EQUALS `נספחי הדרגות השלמות`

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2; כותרות נספחי ב'1 עד ב'7 וג'1 עד ג'7
GIVEN `השיבוץ` IS A `שיבוץ`, `הסדרה` IS A `סדרת נספחי תוספת אופק`
GIVETH A `נספח תוספת אופק`
`נספח תוספת אופק של` `השיבוץ` `בסדרה` `הסדרה` MEANS
    CONSIDER `הסדרה`
    WHEN `נספחי ב` THEN CONSIDER `השיבוץ`'s `קוד הדירוג`
                        WHEN `קוד דירוג 101` THEN IF   `בנספחי הדרגות השלמות`
                                                  THEN `נספח ב'1`
                                                  ELSE `נספח ב'3`
                        WHEN `קוד דירוג 102` THEN IF   `בנספחי הדרגות השלמות`
                                                  THEN `נספח ב'2`
                                                  ELSE `נספח ב'4`
                        WHEN `קוד דירוג 104` THEN `נספח ב'5`
                        WHEN `קוד דירוג 105` THEN `נספח ב'6`
                        WHEN `קוד דירוג 106` THEN `נספח ב'7`
    WHEN `נספחי ג` THEN CONSIDER `השיבוץ`'s `קוד הדירוג`
                        WHEN `קוד דירוג 101` THEN IF   `בנספחי הדרגות השלמות`
                                                  THEN `נספח ג'1`
                                                  ELSE `נספח ג'3`
                        WHEN `קוד דירוג 102` THEN IF   `בנספחי הדרגות השלמות`
                                                  THEN `נספח ג'2`
                                                  ELSE `נספח ג'4`
                        WHEN `קוד דירוג 104` THEN `נספח ג'5`
                        WHEN `קוד דירוג 105` THEN `נספח ג'6`
                        WHEN `קוד דירוג 106` THEN `נספח ג'7`
    WHERE
        `בנספחי הדרגות השלמות` MEANS
            `השיבוץ`'s `משפחת הנספחים` EQUALS `נספחי הדרגות השלמות`

@ref הסכם 19.10.2022 סעיף 4; נספחים א'1 עד א'9 — הערכים ב-`he-tavlaot`
GIVEN `השיבוץ` IS A `שיבוץ`
GIVETH A NUMBER
`שכר מן הטבלה לפי` `השיבוץ` MEANS
    `שכר משולב לפי נספח` (`נספח השכר של` `השיבוץ`)
                         (`השיבוץ`'s `דרגת השיבוץ`)
                         (`השיבוץ`'s `ותק השיבוץ`)

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2; נספחים ב'1 עד ב'7 וג'1 עד ג'7
GIVEN `השיבוץ` IS A `שיבוץ`, `הסדרה` IS A `סדרת נספחי תוספת אופק`
GIVETH A NUMBER
`תוספת אופק 2022 מן הנספח לפי` `השיבוץ` `ולפי` `הסדרה` MEANS
    `תוספת אופק 2022 לפי נספח` (`נספח תוספת אופק של` `השיבוץ` `בסדרה` `הסדרה`)
                               (`השיבוץ`'s `דרגת השיבוץ`)

@ref חוזר לבעלויות תשפו/6 — הסכומים מיום 1.1.2026
GIVEN `המדרגה` IS A `מדרגת תוספת שקלית 2016`
GIVETH A NUMBER
`תוספת שקלית 2016 מן החוזר לפי` `המדרגה` MEANS
    CONSIDER `המדרגה`
    WHEN `מדרגת דרגה 1`           THEN `תוספת שקלית 2016 לדרגה` `דרגה 1`
    WHEN `מדרגת דרגה 1.5`         THEN `תוספת שקלית 2016 לדרגה` `דרגה 1.5`
    WHEN `מדרגת דרגה 2`           THEN `תוספת שקלית 2016 לדרגה` `דרגה 2`
    WHEN `מדרגת דרגה 2.5`         THEN `תוספת שקלית 2016 לדרגה` `דרגה 2.5`
    WHEN `מדרגת דרגה 3`           THEN `תוספת שקלית 2016 לדרגה` `דרגה 3`
    WHEN `מדרגת דרגה 3.5`         THEN `תוספת שקלית 2016 לדרגה` `דרגה 3.5`
    WHEN `מדרגת דרגה 4`           THEN `תוספת שקלית 2016 לדרגה` `דרגה 4`
    WHEN `מדרגת דרגה 4.5`         THEN `תוספת שקלית 2016 לדרגה` `דרגה 4.5`
    WHEN `מדרגת יתר עובדי ההוראה` THEN `תוספת שקלית 2016 לדרגה` `דרגה 5`


§§ `סירובים בשם החוק — מקומות שבהם המכשירים שותקים`

-- אלה אינם חורים במודול אלא חורים במכשירים, ושמו של כל אחד הוא ההודעה
-- שלו. הם מופרדים לפי הטיפוס שהם מוסרים, משום שסירוב הוא ערך ולא חריגה.

@ref הסכם הבסיס 25.12.2008 סעיף 38 — הסולם נעצר בדרגה 9
GIVETH A NUMBER
`דרגה 9 היא ראש הסולם ואין פרק שהייה מעליה` MEANS
    REFUSE "דרגה 9 היא ראש הסולם ואין פרק שהייה מעליה"

@ref הסכם הבסיס 25.12.2008 סעיף 38 — הסולם נעצר בדרגה 9
GIVETH A `דרגה`
`דרגה 9 היא ראש הסולם ואין דרגה שאחריה` MEANS
    REFUSE "דרגה 9 היא ראש הסולם ואין דרגה שאחריה"

-- סעיף 38 מונה פרקי שהייה מדרגה 1 עד דרגה 8 בלבד. חצאי הדרגות נוצרו
-- בהמרה, סעיף 46(א), ומשולמים כשלבי שכר; אך אין בקורפוס סעיף האומר כמה
-- זמן שוהים בדרגה 4.5 לפני קידום לדרגה 5. המסלול היחיד היוצא מחצי דרגה
-- הוא הקידום המשלים של סעיף 4(ג1) ו־4(ג2), ואף הוא רק מ־6.5, 7.5 ו־8.5.
-- ראה פיצול F-E.

@ref הסכם הבסיס 25.12.2008 סעיפים 38(ב) ו־38(ו); החלטת ועדת המעקב 19.2.2015
GIVETH A NUMBER
`סעיף 38 אינו קובע פרק שהייה מחצי דרגה` MEANS
    REFUSE "סעיף 38 אינו קובע פרק שהייה מחצי דרגה"

@ref הסכם הבסיס 25.12.2008 סעיפים 38(ב) ו־38(ו)
GIVETH A `דרגה`
`סעיף 38 אינו קובע מהי הדרגה שאחרי חצי דרגה` MEANS
    REFUSE "סעיף 38 אינו קובע מהי הדרגה שאחרי חצי דרגה"

@ref הסכם הבסיס 25.12.2008 סעיף 38(ז) — מכסה נקבעה לדרגות 7 עד 9 בלבד
GIVETH A NUMBER
`סעיף 38(ז) אינו קובע מכסה לדרגה שמתחת ל־7` MEANS
    REFUSE "סעיף 38(ז) אינו קובע מכסה לדרגה שמתחת ל־7"

@ref תיקון 19.3.2017 סעיף 2(ב) — סעיף 4(ג1) החדש
GIVETH A `דרגה`
`הקידום המשלים חל על דרגות 6 עד 8.5 בלבד` MEANS
    REFUSE "הקידום המשלים חל על דרגות 6 עד 8.5 בלבד"

-- סעיף 4(ג) להסכם ספטמבר 2016 הוא תנאי שלילי בסעיף 4(ג2) שהתיקון מוסיף:
-- "ואשר אינם זכאים לקידום בדרגה לפי סעיפים קטנים (ג) או (ג1)". ההסכם
-- ההוא לא תומלל בקורפוס, פער G2: הקובץ קיים ואין בו טקסט. לכן אי אפשר
-- לדעת אם מורה זכאי לפיו, ואי אפשר להכריע את (ג2) לגופו.

@ref הסכם ספטמבר 2016 סעיף 4(ג) — אינו מתומלל בקורפוס, פער G2
GIVETH A BOOLEAN
`סעיף 4(ג) להסכם ספטמבר 2016 אינו בקורפוס` MEANS
    REFUSE "סעיף 4(ג) להסכם ספטמבר 2016 אינו בקורפוס ואין לדעת אם המורה זכאי לפיו"

-- תוספת שמירת השכר Z נקבעה בסעיף 5(ב) להסכם ספטמבר 2016. התיקון מיום
-- 19.3.2017 מחליף בו את הגדרות X ו־Y ואת פסקה (5), אך אינו מצטט את
-- הנוסחה עצמה, וההסכם המקורי אינו מתומלל. ביטולה עם הקידום מקודד להלן;
-- הסכום אינו.

@ref הסכם ספטמבר 2016 סעיף 5(ב)(2) — אינו מתומלל בקורפוס, פער G2
GIVETH A NUMBER
`נוסחת תוספת שמירת השכר אינה בקורפוס` MEANS
    REFUSE "נוסחת תוספת שמירת השכר אינה בקורפוס"


§§ `הדרגה כמספר, וחצאי הדרגות — סעיף 38 ונספחים א'3 עד א'7`

-- סולם הדרגות מוכרז ב-`he-domain` כמנייה בת שבעה־עשר שלבים, ובצדק: הוא
-- אינו רצף מספרי אלא רשימת עמודות מודפסות. אבל שלושה כללים כאן שואלים
-- "האם זו חצי דרגה" ו"מה הדרגה שאחריה", ולשאלות האלה צריך את המספר.
-- הפונקציה הזאת היא הגשר, והיא מקומית ואינה דין.

@ref כותרות העמודות בנספחים א'3 עד א'7
GIVEN `הדרגה` IS A `דרגה`
GIVETH A NUMBER
`מספר הדרגה של` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 1`   THEN 1
    WHEN `דרגה 1.5` THEN 1.5
    WHEN `דרגה 2`   THEN 2
    WHEN `דרגה 2.5` THEN 2.5
    WHEN `דרגה 3`   THEN 3
    WHEN `דרגה 3.5` THEN 3.5
    WHEN `דרגה 4`   THEN 4
    WHEN `דרגה 4.5` THEN 4.5
    WHEN `דרגה 5`   THEN 5
    WHEN `דרגה 5.5` THEN 5.5
    WHEN `דרגה 6`   THEN 6
    WHEN `דרגה 6.5` THEN 6.5
    WHEN `דרגה 7`   THEN 7
    WHEN `דרגה 7.5` THEN 7.5
    WHEN `דרגה 8`   THEN 8
    WHEN `דרגה 8.5` THEN 8.5
    WHEN `דרגה 9`   THEN 9

@ref הסכם הבסיס 25.12.2008 סעיף 46(א); נספחים א'3 עד א'7
GIVEN `הדרגה` IS A `דרגה`
GIVETH A BOOLEAN
`חצי דרגה היא` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 1.5` THEN TRUE
    WHEN `דרגה 2.5` THEN TRUE
    WHEN `דרגה 3.5` THEN TRUE
    WHEN `דרגה 4.5` THEN TRUE
    WHEN `דרגה 5.5` THEN TRUE
    WHEN `דרגה 6.5` THEN TRUE
    WHEN `דרגה 7.5` THEN TRUE
    WHEN `דרגה 8.5` THEN TRUE
    OTHERWISE            FALSE


§§ `שיבוץ בטבלאות השכר — הסכם הבסיס סעיף 36`

-- סעיף 36(ב) ו־36(ג): בעל תואר ראשון בטבלת בעלי תואר ראשון, בעל תואר שני
-- בטבלת בעלי תואר שני, ובעל תואר שלישי — גם הוא בטבלת בעלי תואר שני,
-- ובנוסף תוספת של 5%.
--
-- על שלושת המעמדים הלא־אקדמיים סעיף 36 שותק לחלוטין. המקור היחיד לשיוכם
-- לקוד דירוג הוא כותרות הטבלאות עצמן: נספח א'5 נושא 104, א'6 נושא 105,
-- א'7 נושא 106. זו קביעה מכותרת ולא מסעיף, ולכן היא מסומנת כאן ככזאת.

@ref הסכם הבסיס 25.12.2008 סעיפים 36(ב) ו־36(ג); כותרות נספחי א'5, א'6 וא'7
GIVEN `המורה` IS A `מורה`
GIVETH A `קוד דירוג`
`קוד הדירוג של` `המורה` MEANS
    CONSIDER `המורה`'s `מעמד ההשכלה`
    WHEN `בעל תואר ראשון`    THEN `קוד דירוג 101`
    WHEN `בעל תואר שני`      THEN `קוד דירוג 102`
    WHEN `מורה בכיר`         THEN `קוד דירוג 104`
    WHEN `מורה מוסמך`        THEN `קוד דירוג 105`
    WHEN `מורה בלתי מוסמך`   THEN `קוד דירוג 106`

-- פיצול F3, והכרעתו. סעיף 5.1 להסכם 19.10.2022 שולח את הקורא לנספחים
-- "בהתאם לדרגתם" ואינו אומר איזה נספח למי. נספח ב'1 כותרתו "מורים בעלי
-- תואר ראשון (101)" ומונה דרגות שלמות בשקלים שלמים; נספח ב'3 נושא את
-- אותה כותרת עצמה ומונה גם חצאי דרגות, באגורות.
--
-- שתי קריאות: לפי מעמד המורה ברפורמה — קיים מול חדש — או לפי הדרגה שעליה
-- הוא יושב. ההכרעה כאן היא לפי הדרגה, משלוש סיבות שהן מבניות ולא
-- פרשניות: נספחי א'1 ו־א'2 אינם מדפיסים שורה לדרגה 4.5 כלל, ולכן מורה
-- היושב עליה אינו פתיר בהם; נספחי א'5 עד א'7 הם ההדפסה היחידה של קודי
-- 104, 105 ו־106 בכל דרגה שהיא; ומעמד "מורה קיים" אינו גורר חצי דרגה,
-- שכן מורה קיים היושב על דרגה שלמה נפתר היטב בנספח א'1.
--
-- מה שההכרעה אינה מיישבת, ויש לומר זאת: בדרגה 4 נספח ב'1 נוקב 836 ונספח
-- ב'3 נוקב 835.54. ההפרש אמיתי ואף מכשיר בקורפוס אינו מיישב אותו. המודול
-- הזה בוחר נספח ואינו ממחיק את הפער.

@ref הסכם 19.10.2022 סעיף 5.1; כותרות נספחי א'1 עד א'7 — פיצול F3
GIVEN `המורה` IS A `מורה`
GIVETH A `משפחת נספחים`
`משפחת הנספחים של` `המורה` MEANS
    IF   `חצי דרגה היא` (`המורה`'s `הדרגה`)
    THEN `נספחי חצאי הדרגות`
    ELSE CONSIDER `המורה`'s `מעמד ההשכלה`
         WHEN `בעל תואר ראשון`    THEN `נספחי הדרגות השלמות`
         WHEN `בעל תואר שני`      THEN `נספחי הדרגות השלמות`
         WHEN `מורה בכיר`         THEN `נספחי חצאי הדרגות`
         WHEN `מורה מוסמך`        THEN `נספחי חצאי הדרגות`
         WHEN `מורה בלתי מוסמך`   THEN `נספחי חצאי הדרגות`

-- השיבוץ עצמו: ארבעת הרכיבים יחד. הדרגה והוותק מגיעים מרשומת המורה ולא
-- מחושבים כאן — ראה פיצול F11: מנגנון ההמרה, סעיפים 43 עד 61, שהוא שהפיק
-- את חצאי הדרגות, אינו מקודד. המשמעות שיש לומר למשתמש: המודול יודע לחשב
-- את שכרו של מורה היושב על דרגה 4.5 ואינו יודע לומר לו מדוע הוא יושב שם.

@ref הסכם הבסיס 25.12.2008 סעיפים 36 ו־37
GIVEN `המורה` IS A `מורה`
GIVETH A `שיבוץ`
`השיבוץ של` `המורה` MEANS
    `שיבוץ` WITH
        `קוד הדירוג`     IS `קוד הדירוג של` `המורה`
        `משפחת הנספחים`  IS `משפחת הנספחים של` `המורה`
        `דרגת השיבוץ`    IS `המורה`'s `הדרגה`
        `ותק השיבוץ`     IS `המורה`'s `הוותק המוכר`

-- סעיף 36(א). מורה חדש אקדמאי, לאחר סיום שנת ההתמחות, משובץ בדרגה 1
-- ובוותק 0; ואם יש לו ותק מוכר משירות בצהל בהוראה או משירות לאומי
-- בהוראה כאמור בסעיף 37 — הוא משובץ לפי אותו ותק. שתי הפסקאות מקודדות
-- כאן ככלל אחד, משום שהשנייה היא החריג של הראשונה ולא כלל עצמאי.

@ref הסכם הבסיס 25.12.2008 סעיף 36(א)
GIVEN `הוותק המוכר מראש` IS A NUMBER
GIVETH A `דרגה`
`דרגת השיבוץ הראשוני של מורה חדש אקדמאי בעל ותק` `הוותק המוכר מראש` MEANS
    `דרגה 1`

@ref הסכם הבסיס 25.12.2008 סעיף 36(א)
GIVEN `הוותק המוכר מראש` IS A NUMBER
GIVETH A NUMBER
`ותק השיבוץ הראשוני של מורה חדש אקדמאי בעל ותק` `הוותק המוכר מראש` MEANS
    `הוותק המוכר מראש`

-- סעיף 36(ד)(2): בעל תואר שלישי זכאי בנוסף לתוספת שכר בשיעור של 5%
-- "משכרו המשולב בטבלה". שלוש מילים אלה הן ההכרעה: הבסיס הוא השכר הטבלאי
-- ולא בסיס הגמולים, ולכן תוספת אופק 2022 אינה נכנסת בו.

@ref הסכם הבסיס 25.12.2008 סעיף 36(ד)(2)
`שיעור תוספת תואר שלישי` MEANS 5%

-- סעיף 36(ה). מורה בעל תואר שני או שלישי שאינו בעל תעודת הוראה או הסמכה
-- להוראה, ושוותקו בהוראה נמוך מ־25 שנים, לא יוכל להתקדם בדרגות עד שיהיה
-- זכאי לתעודה או להסמכה. שלושה תנאים מצטברים, באותו סדר שבו הם כתובים.

@ref הסכם הבסיס 25.12.2008 סעיף 36(ה)
GIVEN `המורה` IS A `מורה`, `בעל תעודת הוראה או הסמכה` IS A BOOLEAN
GIVETH A BOOLEAN
`חסום מהתקדמות בדרגות לפי סעיף 36(ה)` `המורה` `כאשר הסמכתו היא` `בעל תעודת הוראה או הסמכה` MEANS
        `בעל תואר שני או שלישי הוא`
    AND NOT `בעל תעודת הוראה או הסמכה`
    AND `המורה`'s `הוותק המוכר` LESS THAN 25
    WHERE
        `בעל תואר שני או שלישי הוא` MEANS
                `המורה`'s `בעל תואר שלישי`
            OR  `המורה`'s `מעמד ההשכלה` EQUALS `בעל תואר שני`

-- סיפת סעיף 36(ה): "לעניין קידום כאמור תובא בחשבון התקופה שתחילתה במועד
-- תחילת לימודיו של המורה לתעודת הוראה או להסמכה להוראה, אך לא יותר מפרק
-- הזמן הנדרש לצורך קידום בדרגה אחת". התקרה נקובה בסעיף עצמו ולכן היא
-- מחושבת, ולא נלקחת כנתון.

@ref הסכם הבסיס 25.12.2008 סעיף 36(ה) סיפה
GIVEN `חודשי הלימודים` IS A NUMBER, `פרק הזמן לדרגה אחת` IS A NUMBER
GIVETH A NUMBER
`חודשי לימודי ההסמכה הנספרים` `חודשי הלימודים` `עד לתקרת` `פרק הזמן לדרגה אחת` MEANS
    IF   `חודשי הלימודים` AT MOST `פרק הזמן לדרגה אחת`
    THEN `חודשי הלימודים`
    ELSE `פרק הזמן לדרגה אחת`


§§ `ותק מוכר — הסכם הבסיס סעיף 37`

-- סעיף 37(א) בנוי כנוסחה ולא כהגדרה: ותק בהוראה כהגדרתו בתקנון שירות
-- עובדי הוראה, לא כולל תקופת ההתמחות, למעט תקופת שירות חובה בצבא, אך
-- לרבות שירות בצבא בהוראה או שירות לאומי בהוראה. שלוש פעולות — החסרה,
-- החסרה, הוספה — ובאותו סדר שבו הן כתובות.
--
-- הרשומה הזאת היא פירוק הנוסחה לרכיביה. היא אינה מחליפה את שדה
-- `הוותק המוכר` שברשומת המורה: השדה הוא התוצאה, וזהו החישוב שמאחוריו,
-- למי שיש בידיו את הפירוט.

@ref הסכם הבסיס 25.12.2008 סעיף 37; תקנון שירות עובדי הוראה סעיף 1.29
DECLARE `רכיבי הוותק` HAS
    `שנות ותק בהוראה לפי התקנון`    IS A NUMBER   @nlg:he שנות ותק בהוראה כהגדרתו בתקנון
    `שנות ההתמחות`                  IS A NUMBER   @nlg:he שנות ההתמחות, שאינן נספרות
    `שנות שירות חובה בצבא`          IS A NUMBER   @nlg:he שנות שירות חובה, שאינן נספרות
    `שנות שירות בצבא בהוראה`        IS A NUMBER   @nlg:he שנות שירות בצבא בהוראה, הנספרות
    `שנות שירות לאומי בהוראה`       IS A NUMBER   @nlg:he שנות שירות לאומי בהוראה, הנספרות
    `שנות ותק שהוכרו ערב הרפורמה`   IS A NUMBER   @nlg:he שנות הוותק שהוכרו לשכרו ערב המעבר

@ref הסכם הבסיס 25.12.2008 סעיף 37(א)
GIVEN `הרכיבים` IS A `רכיבי הוותק`
GIVETH A NUMBER
`הוותק לפי סעיף 37(א) של` `הרכיבים` MEANS
         `הרכיבים`'s `שנות ותק בהוראה לפי התקנון`
    MINUS `הרכיבים`'s `שנות ההתמחות`
    MINUS `הרכיבים`'s `שנות שירות חובה בצבא`
    PLUS  `הרכיבים`'s `שנות שירות בצבא בהוראה`
    PLUS  `הרכיבים`'s `שנות שירות לאומי בהוראה`

-- פיצול F-F. סעיף 37(ב) אומר, לגבי עובד הוראה קיים, ש"ייכללו בותק המוכר
-- כל שנות הותק בהוראה אשר הוכרו לצורך שכרו ערב המעבר". "ייכללו" סובל שתי
-- קריאות: שהמספר שהוכר ערב המעבר מוסע קדימה כמות שהוא ומחליף את חישוב
-- 37(א), או שהוא נוסף על החישוב כרצפה. ההכרעה כאן היא הגבוה מבין השניים:
-- הלשון היא לשון הכללה ולא לשון החלפה, ורצפה היא הדרך היחידה להכליל
-- מספר בלי לגרוע ממנו. הקריאה השנייה נרשמת ואינה נלקחת.

@ref הסכם הבסיס 25.12.2008 סעיף 37(ב) — פיצול F-F
GIVEN `המורה` IS A `מורה`, `הרכיבים` IS A `רכיבי הוותק`
GIVETH A NUMBER
`הוותק המוכר של` `המורה` `לפי רכיבי` `הרכיבים` MEANS
    CONSIDER `המורה`'s `המעמד ברפורמה`
    WHEN `מורה חדש`  THEN `לפי 37(א)`
    WHEN `מורה קיים` THEN IF   `לפי 37(א)` AT LEAST `לפי 37(ב)`
                          THEN `לפי 37(א)`
                          ELSE `לפי 37(ב)`
    WHERE
        `לפי 37(א)` MEANS `הוותק לפי סעיף 37(א) של` `הרכיבים`
        `לפי 37(ב)` MEANS `הרכיבים`'s `שנות ותק שהוכרו ערב הרפורמה`


§§ `פרקי זמן השהייה בדרגה — סעיפים 38(ב) ו־38(ו), כנוסחם מיום 1.3.2015`

-- פיצול F-A, והוא הממצא המרכזי של המודול הזה. תוכנית הקידוד סיווגה את
-- החלטת ועדת המעקב העליונה מיום 19.2.2015 כ"נדחתה" — היא אכן אינה משנה
-- אף סכום ברוטו בחודש תשפו. אלא שהיא מחליפה, מיום 1.3.2015, את שלושת
-- הסעיפים שהמודול הזה מקודד: 38(ב), 38(ו) ו־38(ט). בכל אחד משלושתם היא
-- מוסיפה חודש אחד לכל פרק זמן.
--
-- שתי קריאות: נוסח 2008 כלשונו, או הנוסח כפי שהוחלף ב־2015. ההכרעה היא
-- הנוסח של 2015, ולא מכוח כלל פרשנות אלא מכוח ראיה בתוך המכשירים עצמם:
-- סעיף 2(ב) לתיקון מיום 19.3.2017, שהמודול הזה מצווה לקודד, מפנה במפורש
-- אל "הוראות סעיף 38(ו) להסכם רפורמת אופק חדש (כנוסחו על פי החלטת ועדת
-- המעקב 2015)". מכשיר מאוחר יותר מכיר בנוסח 2015 כנוסח החי.
--
-- שני הנוסחים מקודדים כאן זה לצד זה, והבדיקה שבסוף הקובץ מאשרת שההפרש
-- ביניהם הוא חודש אחד בכל דרגה. הנוסח החי הוא של 2015.
--
-- פרקי הזמן נמדדים בחודשים ולא בשנים. זו החלטה שהנוסח של 2015 כופה:
-- "שתי שנות שהייה וחודש אחד" אינו מתבטא בשנים בלי לאבד את החודש.

@ref הסכם הבסיס 25.12.2008 סעיפים 38(ב) ו־38(ו) — הנוסח המקורי, שהוחלף
GIVEN `הדרגה` IS A `דרגה`
GIVETH A NUMBER
`פרק השהייה לפי נוסח 2008 לקידום מ` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 1` THEN 24
    WHEN `דרגה 2` THEN 24
    WHEN `דרגה 3` THEN 36
    WHEN `דרגה 4` THEN 36
    WHEN `דרגה 5` THEN 36
    WHEN `דרגה 6` THEN 36
    WHEN `דרגה 7` THEN 36
    WHEN `דרגה 8` THEN 36
    WHEN `דרגה 9` THEN `דרגה 9 היא ראש הסולם ואין פרק שהייה מעליה`
    OTHERWISE          `סעיף 38 אינו קובע פרק שהייה מחצי דרגה`

@ref החלטת ועדת המעקב העליונה 19.2.2015, סעיפים א' ו־ב' — הנוסח החי מיום 1.3.2015
GIVEN `הדרגה` IS A `דרגה`
GIVETH A NUMBER
`פרק השהייה הנדרש לקידום מ` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 1` THEN 25
    WHEN `דרגה 2` THEN 25
    WHEN `דרגה 3` THEN 37
    WHEN `דרגה 4` THEN 37
    WHEN `דרגה 5` THEN 37
    WHEN `דרגה 6` THEN 37
    WHEN `דרגה 7` THEN 37
    WHEN `דרגה 8` THEN 37
    WHEN `דרגה 9` THEN `דרגה 9 היא ראש הסולם ואין פרק שהייה מעליה`
    OTHERWISE          `סעיף 38 אינו קובע פרק שהייה מחצי דרגה`

@ref הסכם הבסיס 25.12.2008 סעיפים 38(ב) ו־38(ו) — סדר הדרגות
GIVEN `הדרגה` IS A `דרגה`
GIVETH A `דרגה`
`הדרגה שאחרי` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 1` THEN `דרגה 2`
    WHEN `דרגה 2` THEN `דרגה 3`
    WHEN `דרגה 3` THEN `דרגה 4`
    WHEN `דרגה 4` THEN `דרגה 5`
    WHEN `דרגה 5` THEN `דרגה 6`
    WHEN `דרגה 6` THEN `דרגה 7`
    WHEN `דרגה 7` THEN `דרגה 8`
    WHEN `דרגה 8` THEN `דרגה 9`
    WHEN `דרגה 9` THEN `דרגה 9 היא ראש הסולם ואין דרגה שאחריה`
    OTHERWISE          `סעיף 38 אינו קובע מהי הדרגה שאחרי חצי דרגה`


§§ `אילו תקופות נספרות בשהייה בדרגה — סעיפים 38(ג) ו־38(ד)`

-- סעיף 38(ג) מונה חמש תקופות שיובאו בחשבון, וסעיף 38(ד) מונה שתיים שלא.
-- הרשומה מחזיקה את שבעתן כשדות נפרדים, כדי שהחישוב יראה את השתיים שאינן
-- נספרות ולא רק את החמש שכן: תקופה שאינה מופיעה בקלט אינה ניתנת לבדיקה.
--
-- פיצול F-B. תת־סעיף 38(ג)(5) מתנה את שנת השבתון בשניים — שהמורה המשיך
-- להיות מועסק בשליש משרה לפחות, או שהאגף להשתלמויות קבע שלמד לימודים
-- חינוכיים־דידקטיים — ואז אומר "במקרה כזה תיחשב שנת השבתון כחצי שנה".
-- "במקרה כזה" יכול להפנות אל תת־תנאי (ב) בלבד, שאחריו הוא כתוב, או אל
-- פסקה (5) כולה. ההכרעה כאן היא פסקה (5) כולה: הפסקה פותחת ב"אך ורק אם
-- התקיים אחד התנאים הבאים", כלומר שני התנאים הם שתי דרכים להכשיר את אותה
-- שנת שבתון עצמה, ומשפט הסיום מדבר על אותה שנה. הקריאה האחרת נרשמת.

@ref הסכם הבסיס 25.12.2008 סעיפים 38(ג) ו־38(ד)
DECLARE `תקופות בדרגה` HAS
    `חודשי עבודה בהוראה`                IS A NUMBER   @nlg:he חודשי עבודה בהוראה בדרגה
    `חודשי חופשת לידה לפי חוק`          IS A NUMBER   @nlg:he חודשי חופשת לידה לפי חוק
    `חודשי שירות מילואים`               IS A NUMBER   @nlg:he חודשי שירות מילואים
    `חודשי ניהול שלא הקנה קידום`        IS A NUMBER   @nlg:he חודשי ניהול או סגנות שלא הקנו קידום בדרגה
    `חודשי מנוחה ומחלה בשכר`            IS A NUMBER   @nlg:he חודשי חופשת מנוחה וחופשת מחלה בשכר
    `חודשי שבתון מוכר`                  IS A NUMBER   @nlg:he חודשי שבתון שהתקיים בו תנאי 38(ג)(5)
    `חודשי שבתון שאינו מוכר`            IS A NUMBER   @nlg:he חודשי שבתון שלא התקיים בו תנאי 38(ג)(5)
    `חודשי חופשה ללא תשלום`             IS A NUMBER   @nlg:he חודשי חופשה ללא תשלום, לסוגיה

@ref הסכם הבסיס 25.12.2008 סעיף 38(ג) — פיצול F-B על מקדם החצי
GIVEN `התקופות` IS A `תקופות בדרגה`
GIVETH A NUMBER
`חודשי השהייה הנספרים ב` `התקופות` MEANS
         `התקופות`'s `חודשי עבודה בהוראה`
    PLUS `התקופות`'s `חודשי חופשת לידה לפי חוק`
    PLUS `התקופות`'s `חודשי שירות מילואים`
    PLUS `התקופות`'s `חודשי ניהול שלא הקנה קידום`
    PLUS `התקופות`'s `חודשי מנוחה ומחלה בשכר`
    PLUS (`התקופות`'s `חודשי שבתון מוכר` TIMES 0.5)

@ref הסכם הבסיס 25.12.2008 סעיף 38(ד)
GIVEN `התקופות` IS A `תקופות בדרגה`
GIVETH A NUMBER
`חודשי השהייה שאינם נספרים ב` `התקופות` MEANS
         `התקופות`'s `חודשי חופשה ללא תשלום`
    PLUS `התקופות`'s `חודשי שבתון שאינו מוכר`


§§ `התנאים לקידום בדרגה — סעיפים 38(א) ו־38(ה)`

-- פער G5. שני הסעיפים מתנים את הקידום ב"עמידה בקריטריונים שנקבעו על־ידי
-- משרד החינוך, כמפורט במכתב משרד החינוך להסתדרות המורים מיום 25.12.08".
-- המכתב אינו בקורפוס. לכן העמידה בקריטריונים היא כאן עובדה נתונה ולא
-- כלל: זהו התנאי היחיד בסעיף 38 שאין לו תוכן שאפשר לבדוק. כך גם תוצאות
-- ההערכה שסעיף 38(ה)(3) דורש, שנקבעות "בהתאם להנחיות מקצועיות" שאינן
-- בקורפוס אף הן.

@ref הסכם הבסיס 25.12.2008 סעיפים 38(א) ו־38(ה); פער G5
DECLARE `בקשת קידום` HAS
    `המורה`                       IS A `מורה`              @nlg:he המורה המבקש
    `התקופות בדרגה הנוכחית`       IS A `תקופות בדרגה`      @nlg:he תקופות שהייתו בדרגה הנוכחית
    `עמד בקריטריוני משרד החינוך`  IS A BOOLEAN             @nlg:he האם עמד בקריטריונים שבמכתב מיום 25.12.2008
    `ההערכה ממליצה על קידומו`     IS A BOOLEAN             @nlg:he האם תוצאות ההערכה ממליצות על קידומו
    `בעל תעודת הוראה או הסמכה`    IS A BOOLEAN             @nlg:he האם הוא בעל תעודת הוראה או הסמכה להוראה

@ref החלטת ועדת המעקב העליונה 19.2.2015 סעיפים א' ו־ב'
GIVEN `הבקשה` IS A `בקשת קידום`
GIVETH A BOOLEAN
`מילא את פרק זמן השהייה` `הבקשה` MEANS
        `חודשי השהייה הנספרים ב` (`הבקשה`'s `התקופות בדרגה הנוכחית`)
    AT LEAST `פרק השהייה הנדרש לקידום מ` (`הבקשה`'s `המורה`'s `הדרגה`)

-- סעיף 38(א): שני תנאים מצטברים, בסדר שבו הם כתובים.

@ref הסכם הבסיס 25.12.2008 סעיף 38(א)(1) ו־(2)
GIVEN `הבקשה` IS A `בקשת קידום`
GIVETH A BOOLEAN
`מתקיימים תנאי סעיף 38(א) ב` `הבקשה` MEANS
        `מילא את פרק זמן השהייה` `הבקשה`
    AND `הבקשה`'s `עמד בקריטריוני משרד החינוך`

-- סעיף 38(ה): שלושה תנאים מצטברים, בסדר שבו הם כתובים. השלישי — תוצאות
-- הערכה שיש בהן כדי להמליץ על הקידום — הוא מה שמבדיל בין קידום לדרגות
-- 7 עד 9 לבין קידום לדרגות 2 עד 6.

@ref הסכם הבסיס 25.12.2008 סעיף 38(ה)(1) עד (3)
GIVEN `הבקשה` IS A `בקשת קידום`
GIVETH A BOOLEAN
`מתקיימים תנאי סעיף 38(ה) ב` `הבקשה` MEANS
        `מילא את פרק זמן השהייה` `הבקשה`
    AND `הבקשה`'s `עמד בקריטריוני משרד החינוך`
    AND `הבקשה`'s `ההערכה ממליצה על קידומו`

-- איזה משני הסעיפים חל נקבע לפי דרגת היעד: 38(א) לדרגות 2 עד 6, ו־38(ה)
-- לדרגות 7 עד 9. וסעיף 36(ה) חוסם את שניהם, ולכן הוא נבדק כאן ולא בתוך
-- אף אחד מהם — כדי ששני הסעיפים יישארו בדיוק כלשונם.

@ref הסכם הבסיס 25.12.2008 סעיפים 38(א), 38(ה) ו־36(ה)
GIVEN `הבקשה` IS A `בקשת קידום`
GIVETH A BOOLEAN
`זכאי לקידום בדרגה` `הבקשה` MEANS
        NOT `חסום מהתקדמות בדרגות לפי סעיף 36(ה)` (`הבקשה`'s `המורה`)
                `כאשר הסמכתו היא` (`הבקשה`'s `בעל תעודת הוראה או הסמכה`)
    AND (   (    `דרגת היעד היא בין 2 ל־6`
             AND `מתקיימים תנאי סעיף 38(א) ב` `הבקשה`)
         OR (    `דרגת היעד היא בין 7 ל־9`
             AND `מתקיימים תנאי סעיף 38(ה) ב` `הבקשה`))
    WHERE
        `מספר דרגת היעד` MEANS
            `מספר הדרגה של` (`הדרגה שאחרי` (`הבקשה`'s `המורה`'s `הדרגה`))
        `דרגת היעד היא בין 2 ל־6` MEANS
            `מספר דרגת היעד` AT MOST 6
        `דרגת היעד היא בין 7 ל־9` MEANS
            `מספר דרגת היעד` AT LEAST 7


§§ `מכסות הדרגות 7 עד 9 — סעיפים 38(ז) עד 38(יא)`

-- סעיף 38(ז) קובע תקרה על מספר המשרות המשובצות בכל אחת משלוש הדרגות
-- העליונות: 10%, 5% ו־3% מכלל המשרות של עובדי הוראה. לדרגות שמתחת ל־7
-- הסעיף אינו קובע מכסה כלל, ולכן השאלה "מהי המכסה לדרגה 3" אינה שאלה
-- שיש לה תשובה — ולא שאלה שתשובתה אפס.

@ref הסכם הבסיס 25.12.2008 סעיף 38(ז)
GIVEN `הדרגה` IS A `דרגה`
GIVETH A NUMBER
`שיעור המכסה לדרגה` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 7` THEN 10%
    WHEN `דרגה 8` THEN 5%
    WHEN `דרגה 9` THEN 3%
    OTHERWISE          `סעיף 38(ז) אינו קובע מכסה לדרגה שמתחת ל־7`

-- סיפת סעיף 38(ז): "מובהר כי לצורך האמור בסעיף זה כלל המשרות לא יפחת
-- ממספר המשרות הקיים ערב חתימת הסכם זה". זו רצפה למכנה, והמספר שהיא
-- מפנה אליו — מספר המשרות ערב 25.12.2008 — אינו בקורפוס. לכן הוא נלקח
-- כנתון ואינו מומצא.

@ref הסכם הבסיס 25.12.2008 סעיף 38(ז) סיפה
GIVEN `המשרות שנספרו` IS A NUMBER, `המשרות ערב החתימה` IS A NUMBER
GIVETH A NUMBER
`כלל המשרות לעניין סעיף 38(ז) מבין` `המשרות שנספרו` `לבין` `המשרות ערב החתימה` MEANS
    IF   `המשרות שנספרו` AT LEAST `המשרות ערב החתימה`
    THEN `המשרות שנספרו`
    ELSE `המשרות ערב החתימה`

@ref הסכם הבסיס 25.12.2008 סעיף 38(ז)
GIVEN `הדרגה` IS A `דרגה`, `המשובצים בדרגה` IS A NUMBER, `כלל המשרות` IS A NUMBER
GIVETH A BOOLEAN
`יש מכסה פנויה בדרגה` `הדרגה` `כאשר משובצים בה` `המשובצים בדרגה` `מתוך` `כלל המשרות` MEANS
    `המשובצים בדרגה` LESS THAN (`כלל המשרות` TIMES `שיעור המכסה לדרגה` `הדרגה`)

-- סעיף 38(ח) קובע בדיקה שנתית "על־פי נוהל שיסוכם בין הצדדים", ואת סדר
-- העדיפויות בתוכה: יקודמו מי שעמדו בתנאים (1) ו־(2) ושקיבלו את הציונים
-- הגבוהים ביותר בהערכה. הנוהל אינו בקורפוס, וגם הציונים אינם. סדר
-- העדיפויות ניתן לומר; ההכרעה מי בפועל מקודם בשנה נתונה — לא.

@ref הסכם הבסיס 25.12.2008 סעיף 38(ח) — הנוהל אינו בקורפוס
GIVETH A BOOLEAN
`הנוהל השנתי לפי סעיף 38(ח) אינו בקורפוס` MEANS
    REFUSE "הנוהל השנתי לפי סעיף 38(ח) אינו בקורפוס"

-- פיצול F-D. סעיף 38(ט), בנוסחו מיום 1.3.2015, אומר שקידומו של מי שמילא
-- את תנאי 38(ה) "לא יימנע ליותר" מ־3 שנים וחודש לדרגה 7, 4 שנים וחודש
-- לדרגה 8, ו־5 שנים וחודש לדרגה 9 — ומיד מוסיף "ובכפוף לקיומה של מכסה
-- פנויה".
--
-- שתי קריאות: שחלוף התקופה גובר על המכסה של 38(ז) ומחייב קידום, או
-- שהתקרה פועלת רק בתוך המכסה. ההכרעה היא השנייה, מכוח לשון הסעיף עצמו:
-- "בכפוף" אינו לשון גבירה. המשמעות המעשית, שראוי לומר אותה: 38(ט) אינו
-- ערובה לקידום אלא ערובה לכך שהתור לא ייפתח מחדש — מורה שמילא את התנאים
-- וממתין שש שנים בלי מכסה פנויה לא מקבל מכוח הסעיף הזה דבר.

@ref החלטת ועדת המעקב העליונה 19.2.2015 סעיף ג', בהחליפו את סעיף 38(ט)
GIVEN `דרגת היעד` IS A `דרגה`
GIVETH A NUMBER
`מספר החודשים המרבי לעיכוב קידום לדרגה` `דרגת היעד` MEANS
    CONSIDER `דרגת היעד`
    WHEN `דרגה 7` THEN 37
    WHEN `דרגה 8` THEN 49
    WHEN `דרגה 9` THEN 61
    OTHERWISE          `סעיף 38(ז) אינו קובע מכסה לדרגה שמתחת ל־7`

@ref החלטת ועדת המעקב העליונה 19.2.2015 סעיף ג' — פיצול F-D
GIVEN `דרגת היעד` IS A `דרגה`, `חודשי ההמתנה` IS A NUMBER, `יש מכסה פנויה` IS A BOOLEAN
GIVETH A BOOLEAN
`עבר את תקרת ההמתנה לדרגה` `דרגת היעד` `לאחר` `חודשי ההמתנה` `כאשר המכסה` `יש מכסה פנויה` MEANS
        `חודשי ההמתנה` GREATER THAN `מספר החודשים המרבי לעיכוב קידום לדרגה` `דרגת היעד`
    AND `יש מכסה פנויה`

-- סעיפים 38(י) ו־38(יא) הם זוג: המורים הקיימים ששובצו בדרגות 7 עד 9
-- בהמרה, וכן אלה שקודמו לשם בקידום הראשון שלאחריה לפי סעיף 48, נספרים
-- לתוך המכסה — ובכל זאת שיבוצם שלהם עצמו אינו נמנע בשל המכסה. שני
-- הכללים אינם סותרים: הראשון מדבר על המכנה של מי שיבוא אחריהם, השני על
-- זכותם שלהם. הם מקודדים כאן כשני כללים ולא כאחד, כלשונם.

@ref הסכם הבסיס 25.12.2008 סעיף 38(י)
GIVETH A BOOLEAN
`המשובצים בהמרה נספרים לתוך המכסה` MEANS TRUE

@ref הסכם הבסיס 25.12.2008 סעיף 38(יא)
GIVETH A BOOLEAN
`שיבוץ בהמרה אינו נמנע בשל המכסה` MEANS TRUE


§§ `קידום משלים לדרגות 7 עד 9 — תיקון 19.3.2017 סעיף 2(ב)`

-- סעיף 2(ב) לתיקון מוסיף להסכם ספטמבר 2016 שני סעיפים קטנים חדשים,
-- 4(ג1) ו־4(ג2), שהם שני מסלולי השלמה לדרגות 7 עד 9 למי שנתקע. שניהם
-- יוצאים מאותה קבוצת דרגות — 6, 6.5, 7, 7.5, 8 ו־8.5 — וזו העדות הישירה
-- ביותר בקורפוס לכך שחצאי הדרגות הם שלבי שכר חיים ולא שריד חשבונאי:
-- מכשיר משנת 2017 מקדם מהם.

@ref תיקון 19.3.2017 סעיף 2(ב) — סעיפים 4(ג1) ו־4(ג2) החדשים
GIVEN `הדרגה` IS A `דרגה`
GIVETH A BOOLEAN
`דרגה שממנה יש קידום משלים היא` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 6`   THEN TRUE
    WHEN `דרגה 6.5` THEN TRUE
    WHEN `דרגה 7`   THEN TRUE
    WHEN `דרגה 7.5` THEN TRUE
    WHEN `דרגה 8`   THEN TRUE
    WHEN `דרגה 8.5` THEN TRUE
    OTHERWISE            FALSE

-- "יקודמו לדרגה 7, דרגה 8 או דרגה 9, לפי העניין". "לפי העניין" אינו
-- מפורש בטבלה, והמיפוי הנקרא כאן הוא הדרגה השלמה הבאה: מ־6 ומ־6.5 אל 7,
-- מ־7 ומ־7.5 אל 8, מ־8 ומ־8.5 אל 9. זו הקריאה היחידה שמסבירה מדוע
-- הסעיף מונה דווקא שש דרגות אלה ולא אחרות.

@ref תיקון 19.3.2017 סעיף 2(ב)
GIVEN `הדרגה` IS A `דרגה`
GIVETH A `דרגה`
`דרגת היעד בקידום המשלים מ` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 6`   THEN `דרגה 7`
    WHEN `דרגה 6.5` THEN `דרגה 7`
    WHEN `דרגה 7`   THEN `דרגה 8`
    WHEN `דרגה 7.5` THEN `דרגה 8`
    WHEN `דרגה 8`   THEN `דרגה 9`
    WHEN `דרגה 8.5` THEN `דרגה 9`
    OTHERWISE            `הקידום המשלים חל על דרגות 6 עד 8.5 בלבד`

@ref תיקון 19.3.2017 סעיף 2(ב)
DECLARE `נתוני קידום משלים` HAS
    `הדרגה הנוכחית`
        IS A `דרגה`   @nlg:he הדרגה שבה הוא משובץ כיום
    `שובץ בדרגה זו לאחר ההמרה ולא קודם מאז`
        IS A BOOLEAN   @nlg:he האם שובץ בדרגה זו לאחר ההמרה ולא קודם מאז
    `רכש את שעות הפיתוח המקצועי לדרגת היעד`
        IS A BOOLEAN   @nlg:he האם רכש את שעות הפיתוח המקצועי שבמכתב מיום 25.12.2008
    `מילא את פרק השהייה עד 30.9.2016`
        IS A BOOLEAN   @nlg:he האם מילא את פרק השהייה לפי סעיף 38(ו) עד 30.9.2016
    `רכש את שעות הפיתוח המקצועי עד 31.12.2016`
        IS A BOOLEAN   @nlg:he האם רכש את שעות הפיתוח המקצועי עד 31.12.2016
    `מילא את פרק השהייה עד 31.12.2016`
        IS A BOOLEAN   @nlg:he האם מילא את פרק השהייה לפי סעיף 38(ו) עד 31.12.2016
    `קודם בדרגה מיום 1.9.2013 ואילך`
        IS A BOOLEAN   @nlg:he האם קודם בדרגה מיום 1.9.2013 ואילך

-- סעיף 4(ג1): ארבעה תנאים, בסדר שבו הם כתובים. יום הזכאות הוא היום שבו
-- התקיימו כולם; המודול הזה עונה על השאלה אם הם מתקיימים ולא מתי.

@ref תיקון 19.3.2017 סעיף 2(ב) — סעיף 4(ג1) החדש
GIVEN `הנתונים` IS A `נתוני קידום משלים`
GIVETH A BOOLEAN
`זכאי לקידום משלים לפי סעיף 4(ג1)` `הנתונים` MEANS
        `דרגה שממנה יש קידום משלים היא` (`הנתונים`'s `הדרגה הנוכחית`)
    AND `הנתונים`'s `שובץ בדרגה זו לאחר ההמרה ולא קודם מאז`
    AND `הנתונים`'s `רכש את שעות הפיתוח המקצועי לדרגת היעד`
    AND `הנתונים`'s `מילא את פרק השהייה עד 30.9.2016`

-- סעיף 4(ג2): חמישה תנאים, וסדרם כאן הוא סדר המכשיר ולא סדר הנוחות.
-- התנאי השלישי — "ואשר אינם זכאים לקידום בדרגה לפי סעיפים קטנים (ג) או
-- (ג1)" — מפנה אל סעיף 4(ג) להסכם ספטמבר 2016, שאינו מתומלל בקורפוס.
-- מכיוון ש-AND עוצר על FALSE, התוצאה היא זו: מורה שנופל באחד משני
-- התנאים הראשונים מקבל FALSE, ומורה שעובר אותם מקבל סירוב. וזו בדיוק
-- מידת הידיעה: על מי שאינו בקבוצה אפשר לומר, ועל מי שכן — לא.

@ref תיקון 19.3.2017 סעיף 2(ב) — סעיף 4(ג2) החדש; פער G2
GIVEN `הנתונים` IS A `נתוני קידום משלים`
GIVETH A BOOLEAN
`זכאי לקידום משלים לפי סעיף 4(ג2)` `הנתונים` MEANS
        `דרגה שממנה יש קידום משלים היא` (`הנתונים`'s `הדרגה הנוכחית`)
    AND NOT `הנתונים`'s `קודם בדרגה מיום 1.9.2013 ואילך`
    AND NOT `זכאי לקידום משלים לפי סעיף 4(ג1)` `הנתונים`
    AND NOT `סעיף 4(ג) להסכם ספטמבר 2016 אינו בקורפוס`
    AND `הנתונים`'s `רכש את שעות הפיתוח המקצועי עד 31.12.2016`
    AND `הנתונים`'s `מילא את פרק השהייה עד 31.12.2016`


§§ `ביטול תוספת שמירת השכר עם הקידום — תיקון 19.3.2017 סעיף 2(ד)(2)`

-- הנוסח המוחלף של סעיף 5(ב)(5) להסכם ספטמבר 2016: "עלה עובד הוראה אשר
-- היה זכאי לתוספת שמירת שכר לפי סעיף זה, בדרגה או בחצי דרגה, לאחר יום
-- 1.9.2016, תבוטל תוספת שמירת השכר לה היה זכאי... והוא לא יהא זכאי יותר
-- לתוספת שמירת שכר". שלוש המילים "או בחצי דרגה" הן ראיה שנייה, עצמאית,
-- לכך שחצי דרגה היא שלב שעולים ממנו ואליו.
--
-- הסכום עצמו אינו כאן: הנוסחה שלו נקבעה בהסכם ספטמבר 2016 שאינו מתומלל.

@ref תיקון 19.3.2017 סעיף 2(ד)(2), בהחליפו את סעיף 5(ב)(5) להסכם ספטמבר 2016
GIVEN `היה זכאי לתוספת שמירת שכר` IS A BOOLEAN
      `עלה בדרגה או בחצי דרגה`    IS A BOOLEAN
      `העלייה לאחר 1.9.2016`      IS A BOOLEAN
GIVETH A BOOLEAN
`תוספת שמירת השכר בטלה כאשר` `היה זכאי לתוספת שמירת שכר`
    `וגם` `עלה בדרגה או בחצי דרגה` `וגם` `העלייה לאחר 1.9.2016` MEANS
        `היה זכאי לתוספת שמירת שכר`
    AND `עלה בדרגה או בחצי דרגה`
    AND `העלייה לאחר 1.9.2016`


§§ `שכר משולב — הסכם הבסיס סעיף 35; הסכם 19.10.2022 סעיף 4`

-- סעיף 35 להסכם הבסיס צירף את הטבלאות כנספחים ד' ו־ה' וקבע כיצד יעודכנו.
-- סעיף 4.1 להסכם מיום 19.10.2022 החליף אותן כולן: מיום 1.9.2022 באות
-- טבלאות נספחים א1 עד א8 במקום הטבלאות שחלו ערב חתימתו, והתשלום בוצע
-- ממשכורת ינואר 2023 למפרע. סעיף 4.2 מחליף מיום 1.9.2023 את נספח א8
-- בנספח א9. סיפת הסעיף מבהירה שמלבד החלפת הטבלאות "לא יחול שינוי ביתר
-- הכללים החלים לעניין השכר המשולב" — ולכן כללי השיבוץ שלמעלה, שמקורם
-- ב־2008, חיים כלשונם.

@ref הסכם 19.10.2022 סעיף 4.1 — מיום 1.9.2022
@nlg:he השכר המשולב לפי הטבלה, למשרה מלאה
GIVEN `המורה` IS A `מורה`
GIVETH A NUMBER
`השכר המשולב במשרה מלאה של` `המורה` MEANS
    `שכר מן הטבלה לפי` (`השיבוץ של` `המורה`)

-- תקנון שירות עובדי הוראה סעיף 1.1(א): "שכר משולב כפי שנקבע בטבלת השכר,
-- לפי וותק ודרגה... וחלקיות משרה". זהו המקור לשערוך היחסי; ההסכמים
-- קובעים את הסכום ולא את אופן שערוכו.

@ref תקנון שירות עובדי הוראה סעיף 1.1(א); הסכם הבסיס 25.12.2008 סעיף 27
@nlg:he השכר המשולב, יחסית לחלקיות המשרה
GIVEN `המורה` IS A `מורה`, `חלקיות המשרה` IS A NUMBER
GIVETH A NUMBER
`השכר המשולב של` `המורה` `בחלקיות משרה` `חלקיות המשרה` MEANS
    `השכר המשולב במשרה מלאה של` `המורה` TIMES `חלקיות המשרה`

-- סעיף 36(ד)(2): "יהיה זכאי בנוסף לתוספת שכר בשיעור של 5% משכרו המשולב
-- בטבלה". הבסיס הוא השכר הטבלאי בלבד — לא בסיס הגמולים ולא השכר לאחר
-- תוספת אופק 2022. השערוך היחסי נגרר מן השכר המשולב, שכן התוספת מחושבת
-- ממנו ולא מסכום נפרד.

@ref הסכם הבסיס 25.12.2008 סעיף 36(ד)(2)
@nlg:he תוספת בעד תואר שלישי
GIVEN `המורה` IS A `מורה`, `חלקיות המשרה` IS A NUMBER
GIVETH A NUMBER
`תוספת תואר שלישי של` `המורה` `בחלקיות משרה` `חלקיות המשרה` MEANS
    IF   `המורה`'s `בעל תואר שלישי`
    THEN `השכר המשולב של` `המורה` `בחלקיות משרה` `חלקיות המשרה`
             TIMES `שיעור תוספת תואר שלישי`
    ELSE 0


§§ `תוספת אופק 2022 — הסכם 19.10.2022 סעיף 5`

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2 — הזכאות נולדת ב־1.9.2022
GIVETH A `סדרת נספחי תוספת אופק`
`תוספת אופק 2022 לא היתה קיימת לפני 1.9.2022` MEANS
    REFUSE "תוספת אופק 2022 לא היתה קיימת לפני 1.9.2022"

-- סעיף 5.1 קובע את נספחי ב' מיום 1.9.2022, וסעיף 5.2 את נספחי ג' מיום
-- 1.9.2023. שנת הלימודים תשפו כולה נמצאת בתקופה השנייה.
--
-- פיצול F4 שבתוכנית נוגע לכותרת נספח ג'3, הנושאת 1.1.2023 בעוד הסעיף
-- המפעיל אומר 1.9.2023. ההכרעה כאן היא לפי הסעיף המפעיל, ולכן היא כבר
-- בנויה לתוך הפונקציה הזאת: התקופה נקבעת מן הסעיף, לא מכותרת הנספח.

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2 — פיצול F4
GIVEN `התקופה` IS A `תקופת תוספת אופק`
GIVETH A `סדרת נספחי תוספת אופק`
`סדרת הנספחים בתקופה` `התקופה` MEANS
    CONSIDER `התקופה`
    WHEN `לפני 1.9.2022`           THEN `תוספת אופק 2022 לא היתה קיימת לפני 1.9.2022`
    WHEN `מ־1.9.2022 עד 31.8.2023` THEN `נספחי ב`
    WHEN `מ־1.9.2023 ואילך`        THEN `נספחי ג`

@ref הסכם 19.10.2022 סעיפים 5.1 ו־5.2 — שנת הלימודים תשפו
`התקופה בשנת הלימודים תשפו` MEANS `מ־1.9.2023 ואילך`

-- סעיף 5.1: הסכום נקוב לעובד הוראה המועסק במשרה מלאה, לפי דרגתו.

@ref הסכם 19.10.2022 סעיף 5.1
@nlg:he תוספת אופק 2022, למשרה מלאה
GIVEN `המורה` IS A `מורה`, `התקופה` IS A `תקופת תוספת אופק`
GIVETH A NUMBER
`תוספת אופק 2022 במשרה מלאה של` `המורה` `בתקופה` `התקופה` MEANS
    `תוספת אופק 2022 מן הנספח לפי` (`השיבוץ של` `המורה`)
        `ולפי` (`סדרת הנספחים בתקופה` `התקופה`)

-- סעיף 5.3: "עובד הוראה יהיה זכאי לתוספת אופק 2022 בסכום שיחושב באופן
-- יחסי לחלקיות משרתו בהשוואה לעובד הוראה במשרה מלאה". שערוך יחסי מפורש,
-- ולא נגזר מן התקנון.

@ref הסכם 19.10.2022 סעיף 5.3
@nlg:he תוספת אופק 2022, יחסית לחלקיות המשרה
GIVEN `המורה` IS A `מורה`, `התקופה` IS A `תקופת תוספת אופק`, `חלקיות המשרה` IS A NUMBER
GIVETH A NUMBER
`תוספת אופק 2022 של` `המורה` `בתקופה` `התקופה` `בחלקיות משרה` `חלקיות המשרה` MEANS
    `תוספת אופק 2022 במשרה מלאה של` `המורה` `בתקופה` `התקופה`
        TIMES `חלקיות המשרה`


§§ `תוספת שקלית 2016 — הסכם 30.9.2016 סעיף 6, כנוסחו בתיקון 19.3.2017 סעיף 2(ה)`

-- הסכומים מתחלקים לתשע מדרגות: שמונה דרגות נקובות בשמן, מדרגה 1 עד
-- דרגה 4.5, וכל השאר יחד. המבנה הזה נקבע בסעיף 6(ב)(5) כנוסחו מיום
-- 1.9.2020 והוא שריר בחוזר תשפו/6 מיום 1.1.2026, בלי שינוי במבנה.
--
-- שים לב לשתי עובדות שהמבנה מלמד. ראשית, חצאי הדרגות 1.5, 2.5, 3.5 ו־4.5
-- נקובים בו בשמם — ראיה שלישית, בלתי תלויה, לכך שהם שלבי שכר חיים.
-- שנית, המדרגות יורדות ככל שהדרגה עולה: התוספת מתקנת שכר נמוך ואינה
-- מתגמלת ותק. הכיוון הזה הפוך מכיוונן של כל יתר הטבלאות במודול הזה.

@ref תיקון 19.3.2017 סעיף 2(ה) — סעיף 6(ב)(5) החדש; חוזר תשפו/6
GIVEN `הדרגה` IS A `דרגה`
GIVETH A `מדרגת תוספת שקלית 2016`
`מדרגת התוספת השקלית לדרגה` `הדרגה` MEANS
    CONSIDER `הדרגה`
    WHEN `דרגה 1`   THEN `מדרגת דרגה 1`
    WHEN `דרגה 1.5` THEN `מדרגת דרגה 1.5`
    WHEN `דרגה 2`   THEN `מדרגת דרגה 2`
    WHEN `דרגה 2.5` THEN `מדרגת דרגה 2.5`
    WHEN `דרגה 3`   THEN `מדרגת דרגה 3`
    WHEN `דרגה 3.5` THEN `מדרגת דרגה 3.5`
    WHEN `דרגה 4`   THEN `מדרגת דרגה 4`
    WHEN `דרגה 4.5` THEN `מדרגת דרגה 4.5`
    OTHERWISE            `מדרגת יתר עובדי ההוראה`

@ref חוזר תשפו/6 — "סכום תוספת שקלית 2016 לעובד הוראה במשרה מלאה"
@nlg:he תוספת שקלית 2016, למשרה מלאה
GIVEN `המורה` IS A `מורה`
GIVETH A NUMBER
`תוספת שקלית 2016 במשרה מלאה של` `המורה` MEANS
    `תוספת שקלית 2016 מן החוזר לפי` (`מדרגת התוספת השקלית לדרגה` (`המורה`'s `הדרגה`))

-- פיצול F-C. תוכנית הקידוד רשמה את התוספת השקלית כמשולמת "לפי דרגה, משרה
-- מלאה", ו-`he-domain` נתן לה את אופן השערוך `לפי דרגה ללא תלות בהיקף
-- המשרה`. שני אלה אינם עומדים במבחן המכשיר: חוזר תשפו/6 מפנה במפורש
-- ל"יתר הכללים וההנחיות לתשלום תוספת זו... כפי שפורסם בחוזרנו לבעלויות
-- תשעז/3", וסעיף 1(ג) לאותו חוזר אומר במילים אלה: "עובד הוראה יהיה זכאי
-- לתוספת שקלית בסכום שיחושב באופן יחסי לחלקיות משרתו בהשוואה לעובד הוראה
-- במשרה מלאה". זהו אותו נוסח בדיוק שסעיף 5.3 להסכם 2022 נוקט לגבי תוספת
-- אופק 2022.
--
-- שתי הקריאות: שהסכום הנקוב הוא הסכום המשולם לכל מי שדרגתו כך, או שהוא
-- סכום המשרה המלאה המשוערך יחסית. ההכרעה היא השנייה, לפי סעיף 1(ג).
-- המילים "במשרה מלאה" בכותרת החוזר אינן תנאי זכאות אלא ציון הבסיס.
--
-- ההכרעה הזאת שווה כסף למורה במשרה חלקית, והיא סותרת שדה שכבר קיים
-- ב-`he-domain`. הרישום כאן הוא הראיה; היישוב שייך לעורך הבא.

@ref חוזר לבעלויות תשעז/3 סעיף 1(ג); חוזר תשפו/6 בהפנותו אליו — פיצול F-C
@nlg:he תוספת שקלית 2016, יחסית לחלקיות המשרה
GIVEN `המורה` IS A `מורה`, `חלקיות המשרה` IS A NUMBER
GIVETH A NUMBER
`תוספת שקלית 2016 של` `המורה` `בחלקיות משרה` `חלקיות המשרה` MEANS
    `תוספת שקלית 2016 במשרה מלאה של` `המורה` TIMES `חלקיות המשרה`


§§ `הממשק אל מודול היקף המשרה`

-- שלוש הפונקציות המשערכות שלמעלה מקבלות את חלקיות המשרה כפרמטר ולא
-- מחשבות אותה, וזו החלטה: היקף המשרה נגזר משבוע העבודה לפי סולמות נספחי
-- א' ו־ב', וזו מלאכתו של `he-mishra`. הפונקציה כאן היא הגשר היחיד בין
-- שני המודולים, וכל תפקידה המרת יחידות.
--
-- `he-mishra` מוסר את היקף המשרה באחוזים — 100 למשרה מלאה — ואילו סעיף
-- 5.3 להסכם 19.10.2022 וסעיף 1(ג) לחוזר תשעז/3 מדברים על "סכום שיחושב
-- באופן יחסי לחלקיות משרתו", כלומר על מנה. ההמרה נעשית כאן, פעם אחת,
-- ולא בכל אתר קריאה.
--
-- שים לב שהגשר הזה מעביר גם סירובים, וטוב שכך: סולם נספח א' לרצועת הגיל
-- 50 עד 54 אינו מדפיס שורה ל־26 שעות פרונטאליות, משום שסעיף 26(א) גורע
-- שתיים. מורה שנמסר עליו שבוע עבודה שאינו בסולמו מקבל מ-`he-mishra`
-- סירוב, והוא מגיע עד לכאן במקום להיבלע במכפלה.

@ref הסכם 19.10.2022 סעיף 5.3; חוזר לבעלויות תשעז/3 סעיף 1(ג)
@nlg:he חלקיות המשרה כמנה
GIVEN `המורה` IS A `מורה`
GIVETH A NUMBER
`חלקיות משרתו של` `המורה` MEANS
    `היקף משרתו של` `המורה` TIMES 0.01

@ref הסכם 19.10.2022 סעיף 5.3
@nlg:he תוספת אופק 2022 לפי היקף המשרה שחושב
GIVEN `המורה` IS A `מורה`, `התקופה` IS A `תקופת תוספת אופק`
GIVETH A NUMBER
`תוספת אופק 2022 של` `המורה` `בתקופה` `התקופה` `לפי היקף משרתו` MEANS
    `תוספת אופק 2022 של` `המורה` `בתקופה` `התקופה`
        `בחלקיות משרה` (`חלקיות משרתו של` `המורה`)

§§ `בסיס התוספות האחוזיות — פיצול F2`

-- סעיף 39 להסכם הבסיס מחשב את גמולי התפקיד כאחוז מן "השכר המשולב".
-- סעיף 5.4 להסכם מיום 19.10.2022 מוסיף שתוספת אופק 2022 "תובא בחשבון
-- לעניין חישוב תוספות אחוזיות המחושבות על בסיס השכר המשולב".
--
-- ועל התוספת השקלית 2016 אין שתיקה אלא היפוכה: סעיף 1(ז) לחוזר תשעז/3
-- אומר "התוספת השקלית לעובד הוראה לא תיכלל בבסיס לחישוב כל תוספת שכר
-- וכל תוספת לשכר (אחוזית ושקלית)". תוכנית הקידוד הכריעה את F2 על יסוד
-- שתיקה; המכשיר אינו שותק, ואומר את אותו הדבר במפורש. ההכרעה עומדת
-- והראיה שמתחתיה מוחלפת בראיה חזקה ממנה.
--
-- הבסיס עצמו נצרך ב-`he-gmulim`, שמחשב את הגמולים. הוא מוגדר כאן משום
-- ששני מרכיביו מוגדרים כאן ואין מקום אחר שבו הם נפגשים.

@ref הסכם הבסיס 25.12.2008 סעיף 39; הסכם 19.10.2022 סעיף 5.4; חוזר תשעז/3 סעיף 1(ז)
@nlg:he הבסיס לחישוב תוספות אחוזיות
GIVEN `המורה` IS A `מורה`, `התקופה` IS A `תקופת תוספת אופק`, `חלקיות המשרה` IS A NUMBER
GIVETH A NUMBER
`בסיס התוספות האחוזיות של` `המורה` `בתקופה` `התקופה` `בחלקיות משרה` `חלקיות המשרה` MEANS
         `השכר המשולב של` `המורה` `בחלקיות משרה` `חלקיות המשרה`
    PLUS `תוספת אופק 2022 של` `המורה` `בתקופה` `התקופה` `בחלקיות משרה` `חלקיות המשרה`


§§ `דוגמאות`

-- חמישה מורים, אחד לכל מסלול שהמודול מבדיל בו. הם אינם דין; הם הקלט
-- שהבדיקות שבסעיף הבא רצות עליו.

`שבוע יסודי מלא לבדיקות השיבוץ` MEANS `שבוע עבודה` WITH
    `השעות הפרונטאליות` IS 26
    `השעות הפרטניות`    IS 5
    `שעות השהייה`       IS 5

`העסקה יסודית רגילה` MEANS `העסקה` WITH
    `שלב החינוך`  IS `בית ספר יסודי`
    `סוג המוסד`   IS `בית ספר רגיל`
    `סוג ההוראה`  IS `הוראה רגילה`
    `בסיס המשרה`  IS `בסיס משרה של בית ספר יסודי`
    `שבוע העבודה` IS `שבוע יסודי מלא לבדיקות השיבוץ`
    `התפקידים`    IS EMPTY

-- מקרה C1 שבתוכנית: מורה חדש, תואר ראשון, דרגה 1, ותק 1.
`דנה` MEANS `מורה` WITH
    `המעמד ברפורמה`  IS `מורה חדש`
    `מעמד ההשכלה`    IS `בעל תואר ראשון`
    `בעל תואר שלישי` IS FALSE
    `רצועת הגיל`     IS `מתחת לגיל 50`
    `הדרגה`          IS `דרגה 1`
    `הוותק המוכר`    IS 1
    `היא מורה אם`    IS FALSE
    `ההעסקה`         IS `העסקה יסודית רגילה`

-- מקרה C2: אותה מורה עם תואר שני.
`נועם` MEANS `מורה` WITH
    `המעמד ברפורמה`  IS `מורה חדש`
    `מעמד ההשכלה`    IS `בעל תואר שני`
    `בעל תואר שלישי` IS FALSE
    `רצועת הגיל`     IS `מתחת לגיל 50`
    `הדרגה`          IS `דרגה 1`
    `הוותק המוכר`    IS 1
    `היא מורה אם`    IS FALSE
    `ההעסקה`         IS `העסקה יסודית רגילה`

-- מקרה C12: מורה קיים שהומר ויושב על דרגה 4.5, תואר ראשון, ותק 20.
`אורית` MEANS `מורה` WITH
    `המעמד ברפורמה`  IS `מורה קיים`
    `מעמד ההשכלה`    IS `בעל תואר ראשון`
    `בעל תואר שלישי` IS FALSE
    `רצועת הגיל`     IS `גיל 50 עד 54`
    `הדרגה`          IS `דרגה 4.5`
    `הוותק המוכר`    IS 20
    `היא מורה אם`    IS FALSE
    `ההעסקה`         IS `העסקה יסודית רגילה`

-- מקרה C11: בעל תואר שלישי, המשובץ בטבלת בעלי תואר שני, דרגה 6 ותק 14.
`יונתן` MEANS `מורה` WITH
    `המעמד ברפורמה`  IS `מורה קיים`
    `מעמד ההשכלה`    IS `בעל תואר שני`
    `בעל תואר שלישי` IS TRUE
    `רצועת הגיל`     IS `מתחת לגיל 50`
    `הדרגה`          IS `דרגה 6`
    `הוותק המוכר`    IS 14
    `היא מורה אם`    IS FALSE
    `ההעסקה`         IS `העסקה יסודית רגילה`

-- מורה בלתי מוסמך, דרגה 3 שלמה: הבדיקה שקוד 106 מוליך לנספחי חצאי
-- הדרגות גם בדרגה שלמה, משום שאין לו הדפסה אחרת.
`רפאל` MEANS `מורה` WITH
    `המעמד ברפורמה`  IS `מורה קיים`
    `מעמד ההשכלה`    IS `מורה בלתי מוסמך`
    `בעל תואר שלישי` IS FALSE
    `רצועת הגיל`     IS `גיל 55 ומעלה`
    `הדרגה`          IS `דרגה 3`
    `הוותק המוכר`    IS 30
    `היא מורה אם`    IS FALSE
    `ההעסקה`         IS `העסקה יסודית רגילה`

-- שתי מערכות תקופות הנבדלות אך ורק בשדות של סעיף 38(ד). הן הקלט לבדיקה
-- שהתקופות שאינן נספרות אכן אינן נספרות.
`תקופות בלי חלת` MEANS `תקופות בדרגה` WITH
    `חודשי עבודה בהוראה`           IS 24
    `חודשי חופשת לידה לפי חוק`     IS 3
    `חודשי שירות מילואים`          IS 1
    `חודשי ניהול שלא הקנה קידום`   IS 0
    `חודשי מנוחה ומחלה בשכר`       IS 0
    `חודשי שבתון מוכר`             IS 12
    `חודשי שבתון שאינו מוכר`       IS 0
    `חודשי חופשה ללא תשלום`        IS 0

`תקופות עם חלת` MEANS `תקופות בדרגה` WITH
    `חודשי עבודה בהוראה`           IS 24
    `חודשי חופשת לידה לפי חוק`     IS 3
    `חודשי שירות מילואים`          IS 1
    `חודשי ניהול שלא הקנה קידום`   IS 0
    `חודשי מנוחה ומחלה בשכר`       IS 0
    `חודשי שבתון מוכר`             IS 12
    `חודשי שבתון שאינו מוכר`       IS 10
    `חודשי חופשה ללא תשלום`        IS 18

`בקשת דנה` MEANS `בקשת קידום` WITH
    `המורה`                      IS `דנה`
    `התקופות בדרגה הנוכחית`      IS `תקופות בלי חלת`
    `עמד בקריטריוני משרד החינוך` IS TRUE
    `ההערכה ממליצה על קידומו`    IS FALSE
    `בעל תעודת הוראה או הסמכה`   IS TRUE

`בקשת יונתן` MEANS `בקשת קידום` WITH
    `המורה`                      IS `יונתן`
    `התקופות בדרגה הנוכחית`      IS `תקופות בלי חלת`
    `עמד בקריטריוני משרד החינוך` IS TRUE
    `ההערכה ממליצה על קידומו`    IS FALSE
    `בעל תעודת הוראה או הסמכה`   IS TRUE

`רכיבי ותק של אורית` MEANS `רכיבי הוותק` WITH
    `שנות ותק בהוראה לפי התקנון`  IS 22
    `שנות ההתמחות`                IS 1
    `שנות שירות חובה בצבא`        IS 2
    `שנות שירות בצבא בהוראה`      IS 0
    `שנות שירות לאומי בהוראה`     IS 1
    `שנות ותק שהוכרו ערב הרפורמה` IS 20

`קידום משלים של אורית` MEANS `נתוני קידום משלים` WITH
    `הדרגה הנוכחית`                             IS `דרגה 6.5`
    `שובץ בדרגה זו לאחר ההמרה ולא קודם מאז`     IS TRUE
    `רכש את שעות הפיתוח המקצועי לדרגת היעד`     IS TRUE
    `מילא את פרק השהייה עד 30.9.2016`           IS TRUE
    `רכש את שעות הפיתוח המקצועי עד 31.12.2016`  IS TRUE
    `מילא את פרק השהייה עד 31.12.2016`          IS TRUE
    `קודם בדרגה מיום 1.9.2013 ואילך`            IS FALSE

`קידום משלים של מי שכבר קודם` MEANS `נתוני קידום משלים` WITH
    `הדרגה הנוכחית`                             IS `דרגה 7.5`
    `שובץ בדרגה זו לאחר ההמרה ולא קודם מאז`     IS FALSE
    `רכש את שעות הפיתוח המקצועי לדרגת היעד`     IS TRUE
    `מילא את פרק השהייה עד 30.9.2016`           IS TRUE
    `רכש את שעות הפיתוח המקצועי עד 31.12.2016`  IS TRUE
    `מילא את פרק השהייה עד 31.12.2016`          IS TRUE
    `קודם בדרגה מיום 1.9.2013 ואילך`            IS TRUE

`קידום משלים שאינו מוכרע` MEANS `נתוני קידום משלים` WITH
    `הדרגה הנוכחית`                             IS `דרגה 8`
    `שובץ בדרגה זו לאחר ההמרה ולא קודם מאז`     IS FALSE
    `רכש את שעות הפיתוח המקצועי לדרגת היעד`     IS TRUE
    `מילא את פרק השהייה עד 30.9.2016`           IS TRUE
    `רכש את שעות הפיתוח המקצועי עד 31.12.2016`  IS TRUE
    `מילא את פרק השהייה עד 31.12.2016`          IS TRUE
    `קודם בדרגה מיום 1.9.2013 ואילך`            IS FALSE


§§ `בדיקות`

-- הבדיקות מסודרות לפי הסעיף שהן בודקות ולא לפי הפונקציה. ארבע מהן אינן
-- בודקות ערך אלא סירוב: `#ASSERT REFUSED` הוא הכלי שמבדיל בין "המכשיר
-- אומר אפס" לבין "המכשיר אינו אומר", וזו ההבחנה שכל המודול הזה עומד
-- עליה.

-- סעיף 36(ב) ו־36(ג), וכותרות נספחי א'5 עד א'7.
#ASSERT `קוד הדירוג של` `דנה`   EQUALS `קוד דירוג 101`
#ASSERT `קוד הדירוג של` `נועם`  EQUALS `קוד דירוג 102`
#ASSERT `קוד הדירוג של` `יונתן` EQUALS `קוד דירוג 102`
#ASSERT `קוד הדירוג של` `רפאל`  EQUALS `קוד דירוג 106`

-- בעל תואר שלישי משובץ בטבלת בעלי תואר שני ואינו יוצר קוד שישי.
#ASSERT `קוד הדירוג של` `יונתן` EQUALS `קוד הדירוג של` `נועם`

-- פיצול F3: הדרגה היא הקובעת, ולצדה הקודים שאין להם הדפסה אחרת.
#ASSERT `משפחת הנספחים של` `דנה`   EQUALS `נספחי הדרגות השלמות`
#ASSERT `משפחת הנספחים של` `יונתן` EQUALS `נספחי הדרגות השלמות`
#ASSERT `משפחת הנספחים של` `אורית` EQUALS `נספחי חצאי הדרגות`
#ASSERT `משפחת הנספחים של` `רפאל`  EQUALS `נספחי חצאי הדרגות`

-- השיבוץ מרכיב את ארבעת הרכיבים בלי לחשב מחדש את הדרגה והוותק.
#ASSERT (`השיבוץ של` `אורית`)'s `ותק השיבוץ`   EQUALS 20
#ASSERT (`השיבוץ של` `אורית`)'s `דרגת השיבוץ`  EQUALS `דרגה 4.5`
#ASSERT (`השיבוץ של` `יונתן`)'s `קוד הדירוג`   EQUALS `קוד דירוג 102`

-- סעיף 36(א): דרגה 1 בכל מקרה, והוותק כמות שהוא.
#ASSERT `דרגת השיבוץ הראשוני של מורה חדש אקדמאי בעל ותק` 0 EQUALS `דרגה 1`
#ASSERT `דרגת השיבוץ הראשוני של מורה חדש אקדמאי בעל ותק` 3 EQUALS `דרגה 1`
#ASSERT `ותק השיבוץ הראשוני של מורה חדש אקדמאי בעל ותק` 0 EQUALS 0
#ASSERT `ותק השיבוץ הראשוני של מורה חדש אקדמאי בעל ותק` 3 EQUALS 3

-- סעיף 36(ד)(2).
#ASSERT `שיעור תוספת תואר שלישי` EQUALS 0.05

-- סעיף 36(ה): שלושה תנאים מצטברים. יונתן הוא בעל תואר שלישי בוותק 14.
#ASSERT `חסום מהתקדמות בדרגות לפי סעיף 36(ה)` `יונתן` `כאשר הסמכתו היא` FALSE
#ASSERT NOT (`חסום מהתקדמות בדרגות לפי סעיף 36(ה)` `יונתן` `כאשר הסמכתו היא` TRUE)
#ASSERT NOT (`חסום מהתקדמות בדרגות לפי סעיף 36(ה)` `דנה` `כאשר הסמכתו היא` FALSE)

-- סיפת סעיף 36(ה): התקופה נספרת עד תקרת פרק זמן לדרגה אחת.
#ASSERT `חודשי לימודי ההסמכה הנספרים` 40 `עד לתקרת` 25 EQUALS 25
#ASSERT `חודשי לימודי ההסמכה הנספרים` 12 `עד לתקרת` 25 EQUALS 12

-- סעיף 37(א): הנוסחה, על שתי ההחסרות ושתי ההוספות שבה.
#ASSERT `הוותק לפי סעיף 37(א) של` `רכיבי ותק של אורית` EQUALS 20

-- סעיף 37(ב) בקריאת פיצול F-F: רצפה למורה קיים.
#ASSERT `הוותק המוכר של` `אורית` `לפי רכיבי` `רכיבי ותק של אורית` EQUALS 20

-- סולם הדרגות כמספר, וחצאי הדרגות.
#ASSERT `מספר הדרגה של` `דרגה 8.5` EQUALS 8.5
#ASSERT `מספר הדרגה של` `דרגה 9`   EQUALS 9
#ASSERT `חצי דרגה היא` `דרגה 4.5`
#ASSERT NOT (`חצי דרגה היא` `דרגה 4`)

-- פיצול F-A: הנוסח החי הוא של 2015, וההפרש מנוסח 2008 הוא חודש אחד
-- בכל אחת משמונה הדרגות שיש מהן קידום. שתי בדיקות ההפרש הן הראיה
-- שהפיצול אינו סברה אלא מדידה.
#ASSERT `פרק השהייה הנדרש לקידום מ` `דרגה 1` EQUALS 25
#ASSERT `פרק השהייה הנדרש לקידום מ` `דרגה 2` EQUALS 25
#ASSERT `פרק השהייה הנדרש לקידום מ` `דרגה 3` EQUALS 37
#ASSERT `פרק השהייה הנדרש לקידום מ` `דרגה 6` EQUALS 37
#ASSERT `פרק השהייה הנדרש לקידום מ` `דרגה 8` EQUALS 37
#ASSERT `פרק השהייה לפי נוסח 2008 לקידום מ` `דרגה 1` EQUALS 24
#ASSERT `פרק השהייה לפי נוסח 2008 לקידום מ` `דרגה 8` EQUALS 36
#ASSERT (`פרק השהייה הנדרש לקידום מ` `דרגה 1`) MINUS (`פרק השהייה לפי נוסח 2008 לקידום מ` `דרגה 1`) EQUALS 1
#ASSERT (`פרק השהייה הנדרש לקידום מ` `דרגה 5`) MINUS (`פרק השהייה לפי נוסח 2008 לקידום מ` `דרגה 5`) EQUALS 1

-- פיצול F-E: אין פרק שהייה מחצי דרגה, ואין דרגה מעל 9. שני סירובים ולא
-- שני אפסים.
#ASSERT REFUSED (`פרק השהייה הנדרש לקידום מ` `דרגה 4.5`)
#ASSERT REFUSED (`פרק השהייה הנדרש לקידום מ` `דרגה 9`)
#ASSERT REFUSED (`הדרגה שאחרי` `דרגה 4.5`)
#ASSERT REFUSED (`הדרגה שאחרי` `דרגה 9`)
#ASSERT `הדרגה שאחרי` `דרגה 8` EQUALS `דרגה 9`
#ASSERT `הדרגה שאחרי` `דרגה 1` EQUALS `דרגה 2`

-- סעיף 38(ג): חמש התקופות, והשבתון המוכר בחצי משקלו.
#ASSERT `חודשי השהייה הנספרים ב` `תקופות בלי חלת` EQUALS 34

-- סעיף 38(ד): שתי התקופות שאינן נספרות אכן אינן משנות את התוצאה. שתי
-- מערכות התקופות נבדלות זו מזו אך ורק בהן.
#ASSERT `חודשי השהייה הנספרים ב` `תקופות עם חלת` EQUALS 34
#ASSERT `חודשי השהייה הנספרים ב` `תקופות עם חלת` EQUALS `חודשי השהייה הנספרים ב` `תקופות בלי חלת`
#ASSERT `חודשי השהייה שאינם נספרים ב` `תקופות עם חלת` EQUALS 28
#ASSERT `חודשי השהייה שאינם נספרים ב` `תקופות בלי חלת` EQUALS 0

-- סעיפים 38(א) ו־38(ה): ההפרש ביניהם הוא תנאי ההערכה, ודנה ויונתן נבדלים
-- בדיוק בו — שניהם עמדו בקריטריונים ולשניהם אין המלצת הערכה.
#ASSERT `מילא את פרק זמן השהייה` `בקשת דנה`
#ASSERT NOT (`מילא את פרק זמן השהייה` `בקשת יונתן`)
#ASSERT `מתקיימים תנאי סעיף 38(א) ב` `בקשת דנה`
#ASSERT NOT (`מתקיימים תנאי סעיף 38(ה) ב` `בקשת דנה`)
#ASSERT `זכאי לקידום בדרגה` `בקשת דנה`
#ASSERT NOT (`זכאי לקידום בדרגה` `בקשת יונתן`)

-- סעיף 38(ז): שלוש מכסות, ולדרגות שמתחת ל־7 אין מכסה — לא אפס.
#ASSERT `שיעור המכסה לדרגה` `דרגה 7` EQUALS 0.10
#ASSERT `שיעור המכסה לדרגה` `דרגה 8` EQUALS 0.05
#ASSERT `שיעור המכסה לדרגה` `דרגה 9` EQUALS 0.03
#ASSERT REFUSED (`שיעור המכסה לדרגה` `דרגה 6`)
