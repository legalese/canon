`a complete registration application` MEANS RegistrationApplication WITH
    `made in the prescribed form` IS TRUE
    `prescribed fee paid` IS TRUE
    `will not be a disorderly house` IS TRUE
    `structurally adapted` IS TRUE
    `proper sanitation` IS TRUE
    `situation suitable` IS TRUE
    `accommodation adequate for the class sought` IS TRUE

`an application with poor sanitation` MEANS RegistrationApplication WITH
    `made in the prescribed form` IS TRUE
    `prescribed fee paid` IS TRUE
    `will not be a disorderly house` IS TRUE
    `structurally adapted` IS TRUE
    `proper sanitation` IS FALSE
    `situation suitable` IS TRUE
    `accommodation adequate for the class sought` IS TRUE

`an application without the fee` MEANS RegistrationApplication WITH
    `made in the prescribed form` IS TRUE
    `prescribed fee paid` IS FALSE
    `will not be a disorderly house` IS TRUE
    `structurally adapted` IS TRUE
    `proper sanitation` IS TRUE
    `situation suitable` IS TRUE
    `accommodation adequate for the class sought` IS TRUE

`a fit applicant who paid` MEANS LicenceApplication WITH
    `prescribed fees paid` IS TRUE
    `premises will not be a disorderly house` IS TRUE
    `of good character and fit and proper` IS TRUE

`an applicant not fit and proper` MEANS LicenceApplication WITH
    `prescribed fees paid` IS TRUE
    `premises will not be a disorderly house` IS TRUE
    `of good character and fit and proper` IS FALSE

