IMPORT prelude
IMPORT `pta-payroll-tax`

-- Payroll Tax Act 1965, ss 4 to 8, 10, 11(2) and 12 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_payroll-tax-act-1965.py). Expected results were written by
-- hand from the text.

`an office clerk working in Singapore` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS TRUE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS FALSE
    `is employed wholly and exclusively by an individual` IS FALSE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

`an employee on leave earned in Singapore` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS FALSE
    `is on leave attributable to earlier Singapore services` IS TRUE
    `is a domestic servant, gardener or driver` IS FALSE
    `is employed wholly and exclusively by an individual` IS FALSE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

`an employee working only abroad this month` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS FALSE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS FALSE
    `is employed wholly and exclusively by an individual` IS FALSE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

`a company director attending board meetings in Singapore` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS TRUE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS FALSE
    `is employed wholly and exclusively by an individual` IS FALSE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

`a household domestic helper` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS TRUE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS TRUE
    `is employed wholly and exclusively by an individual` IS TRUE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

`a driver for the individual's business` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS TRUE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS TRUE
    `is employed wholly and exclusively by an individual` IS TRUE
    `is employed in connection with the individual's trade, business, profession or vocation` IS TRUE

`a driver employed by a company` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS TRUE
    `renders services wholly or partly in Singapore this month` IS TRUE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS TRUE
    `is employed wholly and exclusively by an individual` IS FALSE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

`an independent contractor in Singapore` MEANS Worker WITH
    `is employed or holds a directorship or other office` IS FALSE
    `renders services wholly or partly in Singapore this month` IS TRUE
    `is on leave attributable to earlier Singapore services` IS FALSE
    `is a domestic servant, gardener or driver` IS FALSE
    `is employed wholly and exclusively by an individual` IS FALSE
    `is employed in connection with the individual's trade, business, profession or vocation` IS FALSE

§ `s 4 -- employee`

#ASSERT `is an employee for the month` `an office clerk working in Singapore`
#ASSERT `is an employee for the month` `an employee on leave earned in Singapore`
#ASSERT NOT `is an employee for the month` `an employee working only abroad this month`
#ASSERT `is an employee for the month` `a company director attending board meetings in Singapore`
#ASSERT NOT `is an employee for the month` `a household domestic helper`
#ASSERT `is an employee for the month` `a driver for the individual's business`
#ASSERT `is an employee for the month` `a driver employed by a company`
#ASSERT NOT `is an employee for the month` `an independent contractor in Singapore`

#ASSERT `falls within the household-staff exclusion` `a household domestic helper`
#ASSERT NOT `falls within the household-staff exclusion` `a driver for the individual's business`

§ `s 4 -- remuneration and payroll`

#ASSERT `counts as remuneration` `a salary` TRUE
#ASSERT `counts as remuneration` `a bonus` TRUE
#ASSERT NOT `counts as remuneration` `a housing allowance` FALSE
#ASSERT `counts as remuneration` `another emolument` TRUE
#ASSERT `counts as remuneration` `leave pay` FALSE

#ASSERT `the payroll` 100000 2000 EQUALS 102000

§ `s 5 -- the charge`

#ASSERT `the month is a chargeable month` 1965 1
#ASSERT NOT `the month is a chargeable month` 1964 12
#ASSERT `the month is a chargeable month` 2026 10

§ `ss 6, 7 -- rate and exemption`

#ASSERT `the payroll tax payable` `a private company` 102000 2 0 EQUALS 2040
#ASSERT `the payroll tax payable` `a private company` 12345 2 0 EQUALS 246
#ASSERT `the payroll tax payable` `a sole proprietor` 999 1 0 EQUALS 9
#ASSERT `the payroll tax payable` `the Government` 1000000 2 0 EQUALS 0
#ASSERT `the payroll tax payable` `a local authority` 1000000 2 0 EQUALS 0
#ASSERT `the payroll tax payable` `a body or class exempted by Gazette notification` 100000 2 50 EQUALS 1000
#ASSERT `the payroll tax payable` `a body or class exempted by Gazette notification` 100000 2 100 EQUALS 0
#ASSERT `the payroll tax payable` `a charity not named in any notification` 50000 2 50 EQUALS 1000
#ASSERT `the payroll tax payable` `a private company` 100000 2 50 EQUALS 2000

#ASSERT `is wholly exempt by the Act itself` `an accredited foreign government`
#ASSERT NOT `is wholly exempt by the Act itself` `a charity not named in any notification`

§ `s 8 -- time for payment`

#ASSERT `paid in time` 14 0
#ASSERT NOT `paid in time` 15 0
#ASSERT `paid in time` 20 21
#ASSERT NOT `paid in time` 22 21

#ASSERT `late payment is an offence` TRUE 15 0
#ASSERT NOT `late payment is an offence` TRUE 14 0
#ASSERT NOT `late payment is an offence` FALSE 30 0
#ASSERT NOT `late payment is an offence` TRUE 20 21

#ASSERT `the maximum fine for late payment`  EQUALS 1000

§ `s 10 -- joint employers, officers, agents`

#ASSERT `the contribution recoverable` 3000 40000 100000 EQUALS 1200
#ASSERT `the contribution recoverable` 2040 51000 102000 EQUALS 1020

#ASSERT `is answerable for the company's payroll tax acts` `a company secretary in Singapore`
#ASSERT `is answerable for the company's payroll tax acts` `a director in Singapore`
#ASSERT NOT `is answerable for the company's payroll tax acts` `a director outside Singapore`
#ASSERT NOT `is answerable for the company's payroll tax acts` `a shareholder`

#ASSERT `the most a declared agent may be required to pay` TRUE 5000 3000 EQUALS 3000
#ASSERT `the most a declared agent may be required to pay` TRUE 2000 3000 EQUALS 2000
#ASSERT `the most a declared agent may be required to pay` FALSE 2000 3000 EQUALS 0

§ `s 11(2) -- penalties under regulations`

#ASSERT `the double-tax fine regulations may impose` 2040 EQUALS 4080

#ASSERT `the most a fine under regulations can come to` 2040 EQUALS 9080

§ `s 12 -- secrecy`

#ASSERT `disclosure is a secrecy offence` TRUE FALSE FALSE
#ASSERT NOT `disclosure is a secrecy offence` TRUE TRUE FALSE
#ASSERT NOT `disclosure is a secrecy offence` TRUE FALSE TRUE

#ASSERT `the maximum fine for unlawful disclosure`  EQUALS 1000

