#ASSERT `the option complies with s 4` TRUE TRUE FALSE
#ASSERT NOT `the option complies with s 4` TRUE TRUE TRUE
#ASSERT NOT `the option complies with s 4` FALSE FALSE FALSE

§ `s 5A(1)`

#ASSERT `the developer may receive the moneys` FALSE FALSE
#ASSERT NOT `the developer may receive the moneys` TRUE FALSE
