IMPORT prelude
IMPORT `cca-patrons`

-- Casino Control Act 2006, ss 108, 116, 132 to 134, 162 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_cca.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a parent gambling away the rent for six months` MEANS Respondent WITH
    `gambled irresponsibly ignoring the family's needs` IS TRUE
    `months of repeated irresponsible gambling` IS 6
    `particularly irresponsible over a shorter period` IS FALSE
    `likely to continue` IS TRUE
    `given the chance to object` IS TRUE
    `in the best interests of all` IS TRUE

`a parent who lost the family savings in one week` MEANS Respondent WITH
    `gambled irresponsibly ignoring the family's needs` IS TRUE
    `months of repeated irresponsible gambling` IS 0
    `particularly irresponsible over a shorter period` IS TRUE
    `likely to continue` IS TRUE
    `given the chance to object` IS TRUE
    `in the best interests of all` IS TRUE

`a parent with two months of irresponsible gambling` MEANS Respondent WITH
    `gambled irresponsibly ignoring the family's needs` IS TRUE
    `months of repeated irresponsible gambling` IS 2
    `particularly irresponsible over a shorter period` IS FALSE
    `likely to continue` IS TRUE
    `given the chance to object` IS TRUE
    `in the best interests of all` IS TRUE

`a parent who has stopped gambling` MEANS Respondent WITH
    `gambled irresponsibly ignoring the family's needs` IS TRUE
    `months of repeated irresponsible gambling` IS 12
    `particularly irresponsible over a shorter period` IS FALSE
    `likely to continue` IS FALSE
    `given the chance to object` IS TRUE
    `in the best interests of all` IS TRUE

`a parent not given the chance to object` MEANS Respondent WITH
    `gambled irresponsibly ignoring the family's needs` IS TRUE
    `months of repeated irresponsible gambling` IS 6
    `particularly irresponsible over a shorter period` IS FALSE
    `likely to continue` IS TRUE
    `given the chance to object` IS FALSE
    `in the best interests of all` IS TRUE

§ `s 116`

#ASSERT `the entry levy payable` TRUE 1 EQUALS 150
#ASSERT `the entry levy payable` TRUE 3 EQUALS 450
#ASSERT `the entry levy payable` FALSE 3 EQUALS 0

#ASSERT `the annual membership is cheaper` TRUE 21
#ASSERT NOT `the annual membership is cheaper` TRUE 20
#ASSERT NOT `the annual membership is cheaper` FALSE 100

§ `s 108`

#ASSERT `the casino may give the patron credit` FALSE 0
#ASSERT NOT `the casino may give the patron credit` TRUE 0
#ASSERT `the casino may give the patron credit` TRUE 100000
#ASSERT NOT `the casino may give the patron credit` TRUE 99999

§ `ss 132 to 134`

#ASSERT `the person is a minor for the Act` 20
#ASSERT NOT `the person is a minor for the Act` 21

#ASSERT `the operator has a defence for admitting the minor` 19 TRUE
#ASSERT NOT `the operator has a defence for admitting the minor` 15 TRUE
#ASSERT NOT `the operator has a defence for admitting the minor` 19 FALSE

§ `s 162`

#ASSERT `serious harm has been caused` `a parent gambling away the rent for six months`
#ASSERT `serious harm has been caused` `a parent who lost the family savings in one week`
#ASSERT NOT `serious harm has been caused` `a parent with two months of irresponsible gambling`
#ASSERT `serious harm has been caused` `a parent who has stopped gambling`
#ASSERT `serious harm has been caused` `a parent not given the chance to object`

#ASSERT `a family exclusion order may be made` `a parent gambling away the rent for six months`
#ASSERT `a family exclusion order may be made` `a parent who lost the family savings in one week`
#ASSERT NOT `a family exclusion order may be made` `a parent with two months of irresponsible gambling`
#ASSERT NOT `a family exclusion order may be made` `a parent who has stopped gambling`
#ASSERT NOT `a family exclusion order may be made` `a parent not given the chance to object`

