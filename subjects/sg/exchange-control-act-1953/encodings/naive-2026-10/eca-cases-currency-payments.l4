IMPORT prelude
IMPORT `eca-currency-payments`

-- Exchange Control Act 1953, ss 2, 3, 4, 7, 23, 24, 25, 35, 42, First, Fourth and Fifth Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_exchange-control-act-1953.py). Expected results were written by
-- hand from the text.

`swapping US dollars with a friend in Singapore` MEANS Deal WITH
    `the asset dealt in` IS `US dollars`
    `takes place in Singapore` IS TRUE
    `the person is an authorised dealer` IS FALSE
    `the other party is an authorised dealer` IS FALSE
    `the Authority permitted it` IS FALSE
    `an exemption order covers it` IS FALSE

`buying US dollars in Singapore from an authorised dealer` MEANS Deal WITH
    `the asset dealt in` IS `US dollars`
    `takes place in Singapore` IS TRUE
    `the person is an authorised dealer` IS FALSE
    `the other party is an authorised dealer` IS TRUE
    `the Authority permitted it` IS FALSE
    `an exemption order covers it` IS FALSE

`selling ringgit to a friend in Singapore` MEANS Deal WITH
    `the asset dealt in` IS `Malaysian ringgit`
    `takes place in Singapore` IS TRUE
    `the person is an authorised dealer` IS FALSE
    `the other party is an authorised dealer` IS FALSE
    `the Authority permitted it` IS FALSE
    `an exemption order covers it` IS FALSE

`selling gold coins to a friend in Singapore` MEANS Deal WITH
    `the asset dealt in` IS `gold coins`
    `takes place in Singapore` IS TRUE
    `the person is an authorised dealer` IS FALSE
    `the other party is an authorised dealer` IS FALSE
    `the Authority permitted it` IS FALSE
    `an exemption order covers it` IS FALSE

`selling US dollars to a friend while both are in Tokyo` MEANS Deal WITH
    `the asset dealt in` IS `US dollars`
    `takes place in Singapore` IS FALSE
    `the person is an authorised dealer` IS FALSE
    `the other party is an authorised dealer` IS FALSE
    `the Authority permitted it` IS FALSE
    `an exemption order covers it` IS FALSE

`gold bullion kept at home` MEANS Holding WITH
    `the asset held` IS `gold bullion`
    `the holder is in Singapore` IS TRUE
    `the holder is entitled to sell it` IS TRUE
    `the holder is an authorised dealer` IS FALSE
    `the currency is specified by order` IS FALSE
    `the Authority consented to retention` IS FALSE
    `it was acquired from an authorised dealer` IS FALSE
    `the stated purpose has ended` IS FALSE
    `disposed of with permission` IS FALSE
    `an exemption order covers the holding` IS FALSE

`US dollars not specified by order` MEANS Holding WITH
    `the asset held` IS `US dollars`
    `the holder is in Singapore` IS TRUE
    `the holder is entitled to sell it` IS TRUE
    `the holder is an authorised dealer` IS FALSE
    `the currency is specified by order` IS FALSE
    `the Authority consented to retention` IS FALSE
    `it was acquired from an authorised dealer` IS FALSE
    `the stated purpose has ended` IS FALSE
    `disposed of with permission` IS FALSE
    `an exemption order covers the holding` IS FALSE

`US dollars specified by order` MEANS Holding WITH
    `the asset held` IS `US dollars`
    `the holder is in Singapore` IS TRUE
    `the holder is entitled to sell it` IS TRUE
    `the holder is an authorised dealer` IS FALSE
    `the currency is specified by order` IS TRUE
    `the Authority consented to retention` IS FALSE
    `it was acquired from an authorised dealer` IS FALSE
    `the stated purpose has ended` IS FALSE
    `disposed of with permission` IS FALSE
    `an exemption order covers the holding` IS FALSE

`specified US dollars bought from an authorised dealer for a trip` MEANS Holding WITH
    `the asset held` IS `US dollars`
    `the holder is in Singapore` IS TRUE
    `the holder is entitled to sell it` IS TRUE
    `the holder is an authorised dealer` IS FALSE
    `the currency is specified by order` IS TRUE
    `the Authority consented to retention` IS FALSE
    `it was acquired from an authorised dealer` IS TRUE
    `the stated purpose has ended` IS FALSE
    `disposed of with permission` IS FALSE
    `an exemption order covers the holding` IS FALSE

`specified US dollars left over after the trip` MEANS Holding WITH
    `the asset held` IS `US dollars`
    `the holder is in Singapore` IS TRUE
    `the holder is entitled to sell it` IS TRUE
    `the holder is an authorised dealer` IS FALSE
    `the currency is specified by order` IS TRUE
    `the Authority consented to retention` IS FALSE
    `it was acquired from an authorised dealer` IS TRUE
    `the stated purpose has ended` IS TRUE
    `disposed of with permission` IS FALSE
    `an exemption order covers the holding` IS FALSE

`paying a supplier resident in the United States` MEANS Payment WITH
    `made in Singapore` IS TRUE
    `the payee resides in` IS `the United States`
    `made on the order of a person resident in` IS Singapore
    `the Authority permitted the payment` IS FALSE
    `an exemption order covers the payment` IS FALSE

`paying a supplier resident in Malaysia` MEANS Payment WITH
    `made in Singapore` IS TRUE
    `the payee resides in` IS Malaysia
    `made on the order of a person resident in` IS Singapore
    `the Authority permitted the payment` IS FALSE
    `an exemption order covers the payment` IS FALSE

`paying a Singapore landlord on the order of a Japanese company` MEANS Payment WITH
    `made in Singapore` IS TRUE
    `the payee resides in` IS Singapore
    `made on the order of a person resident in` IS Japan
    `the Authority permitted the payment` IS FALSE
    `an exemption order covers the payment` IS FALSE

`paying a US supplier from a bank in London` MEANS Payment WITH
    `made in Singapore` IS FALSE
    `the payee resides in` IS `the United States`
    `made on the order of a person resident in` IS Singapore
    `the Authority permitted the payment` IS FALSE
    `an exemption order covers the payment` IS FALSE

`an export to a territory not prescribed` MEANS `Export Sale` WITH
    `the destination is in a prescribed territory` IS FALSE
    `the Authority permitted the export` IS FALSE
    `already paid to a Singapore resident` IS FALSE
    `months after exportation payment is due` IS 9
    `a direction substitutes a period` IS FALSE
    `the substituted period in months` IS 0
    `the return accords with the objects of the Act` IS TRUE

`an export paid 3 months after shipment` MEANS `Export Sale` WITH
    `the destination is in a prescribed territory` IS TRUE
    `the Authority permitted the export` IS FALSE
    `already paid to a Singapore resident` IS FALSE
    `months after exportation payment is due` IS 3
    `a direction substitutes a period` IS FALSE
    `the substituted period in months` IS 0
    `the return accords with the objects of the Act` IS TRUE

`an export paid 9 months after shipment` MEANS `Export Sale` WITH
    `the destination is in a prescribed territory` IS TRUE
    `the Authority permitted the export` IS FALSE
    `already paid to a Singapore resident` IS FALSE
    `months after exportation payment is due` IS 9
    `a direction substitutes a period` IS FALSE
    `the substituted period in months` IS 0
    `the return accords with the objects of the Act` IS TRUE

`an export paid 9 months after shipment under a 12-month direction` MEANS `Export Sale` WITH
    `the destination is in a prescribed territory` IS TRUE
    `the Authority permitted the export` IS FALSE
    `already paid to a Singapore resident` IS FALSE
    `months after exportation payment is due` IS 9
    `a direction substitutes a period` IS TRUE
    `the substituted period in months` IS 12
    `the return accords with the objects of the Act` IS TRUE

`an export paid in advance at an undervalue` MEANS `Export Sale` WITH
    `the destination is in a prescribed territory` IS TRUE
    `the Authority permitted the export` IS FALSE
    `already paid to a Singapore resident` IS TRUE
    `months after exportation payment is due` IS 0
    `a direction substitutes a period` IS FALSE
    `the substituted period in months` IS 0
    `the return accords with the objects of the Act` IS FALSE

§ `s 2 and First Schedule`

#ASSERT `is a scheduled territory` Malaysia
#ASSERT `is a scheduled territory` `the United Kingdom`
#ASSERT NOT `is a scheduled territory` `the United States`
#ASSERT NOT `is a scheduled territory` Japan

#ASSERT NOT `is foreign currency` `Singapore dollars`
#ASSERT NOT `is foreign currency` `pounds sterling`
#ASSERT `is foreign currency` `US dollars`
#ASSERT `is foreign currency` `Japanese yen`

#ASSERT `is gold or foreign currency` `gold coins`
#ASSERT NOT `is gold or foreign currency` `a gold necklace worth much more than its gold for the craftsmanship`

§ `s 3(1)`

#ASSERT `the deal breaches section 3(1)` `swapping US dollars with a friend in Singapore`
#ASSERT NOT `the deal breaches section 3(1)` `buying US dollars in Singapore from an authorised dealer`
#ASSERT NOT `the deal breaches section 3(1)` `selling ringgit to a friend in Singapore`
#ASSERT `the deal breaches section 3(1)` `selling gold coins to a friend in Singapore`
#ASSERT NOT `the deal breaches section 3(1)` `selling US dollars to a friend while both are in Tokyo`

§ `s 4`

#ASSERT `the holder must offer it to an authorised dealer` `gold bullion kept at home`
#ASSERT NOT `the holder must offer it to an authorised dealer` `US dollars not specified by order`
#ASSERT `the holder must offer it to an authorised dealer` `US dollars specified by order`
#ASSERT NOT `the holder must offer it to an authorised dealer` `specified US dollars bought from an authorised dealer for a trip`
#ASSERT `the holder must offer it to an authorised dealer` `specified US dollars left over after the trip`

§ `s 7 and s 42(1)`

#ASSERT `the payment breaches section 7(1)` `paying a supplier resident in the United States`
#ASSERT NOT `the payment breaches section 7(1)` `paying a supplier resident in Malaysia`
#ASSERT `the payment breaches section 7(1)` `paying a Singapore landlord on the order of a Japanese company`
#ASSERT NOT `the payment breaches section 7(1)` `paying a US supplier from a bank in London`

#ASSERT `the personal representative's residence for the Act` Singapore `the United States` TRUE FALSE EQUALS `the United States`
#ASSERT `the personal representative's residence for the Act` Singapore `the United States` TRUE TRUE EQUALS Singapore

§ `ss 23 and 24`

#ASSERT `importing it needs permission under section 23` `a Treasury bill`
#ASSERT NOT `importing it needs permission under section 23` `gold bars`

#ASSERT `exporting it needs permission under section 24` `gold bars`
#ASSERT NOT `exporting it needs permission under section 24` `a gold necklace of fine craftsmanship`
#ASSERT `exporting it needs permission under section 24` `a postal order`
#ASSERT `exporting it needs permission under section 24` `a promissory note in US dollars payable in New York`
#ASSERT NOT `exporting it needs permission under section 24` `a promissory note in ringgit payable in Kuala Lumpur`

§ `s 25`

#ASSERT `the export may proceed under section 25` `an export to a territory not prescribed`
#ASSERT `the export may proceed under section 25` `an export paid 3 months after shipment`
#ASSERT NOT `the export may proceed under section 25` `an export paid 9 months after shipment`
#ASSERT `the export may proceed under section 25` `an export paid 9 months after shipment under a 12-month direction`
#ASSERT NOT `the export may proceed under section 25` `an export paid in advance at an undervalue`

§ `s 35 and Fourth Schedule para 5`

#ASSERT `the implied condition holds back performance` TRUE FALSE FALSE
#ASSERT NOT `the implied condition holds back performance` TRUE TRUE FALSE
#ASSERT NOT `the implied condition holds back performance` TRUE FALSE TRUE

#ASSERT `the claim is admitted to proof` TRUE FALSE

#ASSERT NOT `the trustee may pay the claim without more` TRUE FALSE

§ `Fifth Schedule Part 2`

#ASSERT `can commit a Part 2 offence` FALSE TRUE
#ASSERT NOT `can commit a Part 2 offence` FALSE FALSE

#ASSERT `the maximum fine` TRUE FALSE 100000 EQUALS 300000
#ASSERT `the maximum fine` TRUE TRUE 100000 EQUALS 10000

#ASSERT NOT `the sum may be accepted in composition` 1500

#ASSERT NOT `proceedings may be instituted` TRUE FALSE TRUE
