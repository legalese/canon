§ `s 2`

#ASSERT `is wildlife` `any other kind of animal` TRUE
#ASSERT NOT `is wildlife` `a domestic dog` TRUE
#ASSERT NOT `is wildlife` `a domestic pig` TRUE
#ASSERT NOT `is wildlife` `any other kind of animal` FALSE

§ `ss 5A to 5C, 6 to 9`

#ASSERT `the conduct is an offence` `feeding monkeys without approval`
#ASSERT NOT `the conduct is an offence` `feeding under an approval within conditions`
#ASSERT `the conduct is an offence` `feeding in breach of an approval condition`
#ASSERT `the conduct is an offence` `a repeat feeder`
#ASSERT NOT `the conduct is an offence` `a pet bird escaping by accident`
#ASSERT `the conduct is an offence` `releasing terrapins into a pond`
#ASSERT NOT `the conduct is an offence` `a farmer killing a boar damaging his crops`
#ASSERT `the conduct is an offence` `a farmer keeping a boar that damaged crops`
#ASSERT `the conduct is an offence` `a neighbour killing a boar on another's farm`
#ASSERT `the conduct is an offence` `a farmer setting a snare against crop raiders`
#ASSERT `the conduct is an offence` `a trader unknowingly selling a wildlife part`
#ASSERT `the conduct is an offence` `importing a live protected bird`
#ASSERT NOT `the conduct is an offence` `importing a dead specimen`
#ASSERT `the conduct is an offence` `exporting a protected wildlife part`
#ASSERT NOT `the conduct is an offence` `keeping a stray dog`
#ASSERT `the conduct is an offence` `a pet shop keeping wildlife`
#ASSERT `the conduct is an offence` `a repeat business trapper of protected wildlife`

