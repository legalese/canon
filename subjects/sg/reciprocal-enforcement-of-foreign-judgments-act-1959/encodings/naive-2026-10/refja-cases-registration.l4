§ `s 2`

#ASSERT `the kind of judgment` `a sum of money for damages, a debt or compensation` EQUALS `a money judgment`
#ASSERT `the kind of judgment` `no sum of money` EQUALS `a non-money judgment`
#ASSERT `the kind of judgment` `a sum of money for taxes or similar charges` EQUALS `neither a money nor a non-money judgment`

#ASSERT `the action is an action in personam` `a claim in contract or tort`
#ASSERT NOT `the action is an action in personam` `a matrimonial cause`
#ASSERT NOT `the action is an action in personam` `winding up of a company`

§ `ss 2A, 3`

#ASSERT `Part 1 applies to the judgment` `a final judgment of a recognised court`
#ASSERT `Part 1 applies to the judgment` `a final judgment still under appeal`
#ASSERT `Part 1 applies to the judgment` `an interlocutory order of a recognised court`
#ASSERT NOT `Part 1 applies to the judgment` `a final judgment given before the order`
#ASSERT NOT `Part 1 applies to the judgment` `a final judgment of a court not in the order`
#ASSERT NOT `Part 1 applies to the judgment` `an appeal judgment from an unrecognised lower court`
#ASSERT NOT `Part 1 applies to the judgment` `a judgment enforcing a third country's judgment`
#ASSERT NOT `Part 1 applies to the judgment` `a judgment within the Choice of Court Agreements Act 2016`

§ `s 4(1)-(4)`

#ASSERT `the outcome of the application` `a final judgment of a recognised court` `a sum of money for damages, a debt or compensation` `an application after 2 years` EQUALS `registered`
#ASSERT `the outcome of the application` `a final judgment of a recognised court` `a sum of money for damages, a debt or compensation` `an application after 7 years` EQUALS `not registered`
#ASSERT `the outcome of the application` `a final judgment of a recognised court` `a sum of money for damages, a debt or compensation` `an application on a wholly satisfied judgment` EQUALS `not registered`
#ASSERT `the outcome of the application` `a final judgment of a recognised court` `a sum of money for damages, a debt or compensation` `an application on a judgment unenforceable at origin` EQUALS `not registered`
#ASSERT `the outcome of the application` `a final judgment of a recognised court` `no sum of money` `an application after 2 years` EQUALS `the monetary equivalent of the relief may be registered instead`
#ASSERT `the outcome of the application` `a final judgment of a recognised court` `no sum of money` `an application after 2 years, enforcement just and convenient` EQUALS `registered`
#ASSERT `the outcome of the application` `a final judgment given before the order` `a sum of money for damages, a debt or compensation` `an application after 2 years` EQUALS `not registered`

§ `s 4(5), (9), (11)`

#ASSERT `the sum registered` `a plain debt` EQUALS 107000
#ASSERT `the sum registered` `a punitive award` EQUALS 123000
#ASSERT `the sum registered` `a part-paid debt` EQUALS 61500
#ASSERT `the sum registered` `a part-paid punitive award` EQUALS 108500

§ `s 4(8)`

#ASSERT `an enforcement order may issue` TRUE FALSE FALSE
#ASSERT NOT `an enforcement order may issue` TRUE TRUE FALSE
#ASSERT NOT `an enforcement order may issue` TRUE FALSE TRUE

§ `ss 5, 6`

#ASSERT `the effect of the ground` `obtained by fraud` EQUALS `must be set aside`
#ASSERT `the effect of the ground` `contrary to Singapore public policy` EQUALS `must be set aside`
#ASSERT `the effect of the ground` `an earlier final judgment on the same matter` EQUALS `may be set aside`
#ASSERT `the effect of the ground` `the notice of registration was not served or was defective` EQUALS `may be set aside`
#ASSERT `the effect of the ground` `an appeal is pending or intended` EQUALS `may be set aside`
#ASSERT `the effect of the ground` `the foreign court decided the merits wrongly` EQUALS `no ground to set aside`

#ASSERT `the Act expressly preserves registering again` `the notice of registration was not served or was defective`
#ASSERT `the Act expressly preserves registering again` `an appeal is pending or intended`
#ASSERT `the Act expressly preserves registering again` `registered for the whole sum despite part payment`
#ASSERT NOT `the Act expressly preserves registering again` `obtained by fraud`

§ `s 5(3), (4)`

#ASSERT `the original court is deemed to have had jurisdiction` `a defendant who defended on the merits`
#ASSERT NOT `the original court is deemed to have had jurisdiction` `a defendant who appeared only to contest jurisdiction`
#ASSERT `the original court is deemed to have had jurisdiction` `a resident defendant who stayed away`
#ASSERT NOT `the original court is deemed to have had jurisdiction` `a resident defendant sued despite an arbitration clause`
#ASSERT `the original court is deemed to have had jurisdiction` `a defendant who agreed to the forum, sued despite an arbitration clause`
#ASSERT NOT `the original court is deemed to have had jurisdiction` `a foreign state that stayed away`
#ASSERT `the original court is deemed to have had jurisdiction` `a land action about land in that country`

§ `ss 7, 12`

#ASSERT NOT `a Singapore court may hear an ordinary action on the judgment` TRUE FALSE FALSE FALSE FALSE
#ASSERT `a Singapore court may hear an ordinary action on the judgment` FALSE FALSE FALSE FALSE FALSE
#ASSERT `a Singapore court may hear an ordinary action on the judgment` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT `a Singapore court may hear an ordinary action on the judgment` FALSE FALSE FALSE TRUE FALSE

§ `s 11`

#ASSERT NOT `the judgment is conclusive between the parties` TRUE TRUE `obtained by fraud`
#ASSERT `the judgment is conclusive between the parties` TRUE TRUE `already wholly satisfied when registration was applied for`
#ASSERT NOT `the judgment is conclusive between the parties` TRUE TRUE `an appeal is pending or intended`

§ `s 13`

#ASSERT `the registrar is to issue the certificate` TRUE TRUE TRUE FALSE
#ASSERT NOT `the registrar is to issue the certificate` TRUE TRUE TRUE TRUE

