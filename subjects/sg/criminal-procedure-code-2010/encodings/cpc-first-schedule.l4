      , (`First Schedule Row` OF "505", "505", "False statement, rumour, etc., circulated with intent to cause mutiny or offence against the public peace", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 3 years, or fine, or both", `Magistrate's Court or District Court`, "CHAPTER 22 -- CRIMINAL INTIMIDATION, INSULT AND ANNOYANCE", "", 452)
      , (`First Schedule Row` OF "506", "506", "Criminal intimidation", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 2 years, or fine, or both", `Magistrate's Court or District Court`, "CHAPTER 22 -- CRIMINAL INTIMIDATION, INSULT AND ANNOYANCE", "", 453)
      , (`First Schedule Row` OF "506", "506", "If threat is to cause death or grievous hurt, etc.", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 10 years, or fine, or both", `Magistrate's Court or District Court`, "CHAPTER 22 -- CRIMINAL INTIMIDATION, INSULT AND ANNOYANCE", "", 453)
      , (`First Schedule Row` OF "507", "507", "Criminal intimidation by anonymous communication or having taken precaution to conceal from where the threat comes", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 2 years, in addition to the punishment under section 506", `Magistrate's Court or District Court`, "CHAPTER 22 -- CRIMINAL INTIMIDATION, INSULT AND ANNOYANCE", "", 453)
      , (`First Schedule Row` OF "512(1)", "512", "Attempting (where no express provision is made by the Penal Code 1871 or by other written law) to commit offences punishable with death or imprisonment for life", `May arrest without warrant`, `A warrant ordinarily issues`, `Not bailable`, "Imprisonment for 20 years, and fine, or caning", `General Division of the High Court only`, "CHAPTER 23 -- ATTEMPTS TO COMMIT OFFENCES", "", 453)
      , (`First Schedule Row` OF "512(2)", "512", "If the attempted offence is punishable with any punishment or combination of punishments other than death or imprisonment for life", `As for the underlying offence`, `As for the underlying offence`, `As for the underlying offence`, "The punishment provided for the offence, except that the court is not bound to impose any specified minimum sentence or mandatory minimum sentence of imprisonment, or fine or caning", `As for the underlying offence`, "CHAPTER 23 -- ATTEMPTS TO COMMIT OFFENCES", "arrest: According as to whether the offence is one in respect of which the police may arrest without warrant or not | process: According as to whether the offence is one in respect of which a summons or warrant shall ordinarily issue | bail: According as to whether the offence attempted is bailable or not | court: The court by which the offence attempted is triable", 453)
