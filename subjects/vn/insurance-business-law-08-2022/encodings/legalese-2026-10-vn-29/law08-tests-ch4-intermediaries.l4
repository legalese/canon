#ASSERT REFUSED `Dieu 128(1)(c) and (2)(dd): the maximum commission, bonus and support the Minister of Finance allows`
`an honest agent` MEANS `The conduct of an agent` WITH
    `filled in information for the policyholder without the policyholder's consent` IS FALSE
    `gave false information or advertising on the insurer's content or scope or the terms, harming the policyholder` IS FALSE
    `prevented the policyholder from giving information or urged the policyholder not to declare it` IS FALSE
    `took customers by obstructing, luring, bribing or threatening staff or customers of an insurer, agent or broker` IS FALSE
    `urged a customer to cancel a contract in force` IS FALSE
`an agent who lied in advertising` MEANS `The conduct of an agent` WITH
    `filled in information for the policyholder without the policyholder's consent` IS FALSE
    `gave false information or advertising on the insurer's content or scope or the terms, harming the policyholder` IS TRUE
    `prevented the policyholder from giving information or urged the policyholder not to declare it` IS FALSE
    `took customers by obstructing, luring, bribing or threatening staff or customers of an insurer, agent or broker` IS FALSE
    `urged a customer to cancel a contract in force` IS FALSE
`an agent who stopped a declaration` MEANS `The conduct of an agent` WITH
    `filled in information for the policyholder without the policyholder's consent` IS FALSE
    `gave false information or advertising on the insurer's content or scope or the terms, harming the policyholder` IS FALSE
    `prevented the policyholder from giving information or urged the policyholder not to declare it` IS TRUE
    `took customers by obstructing, luring, bribing or threatening staff or customers of an insurer, agent or broker` IS FALSE
    `urged a customer to cancel a contract in force` IS FALSE
`an agent who poached customers` MEANS `The conduct of an agent` WITH
    `filled in information for the policyholder without the policyholder's consent` IS FALSE
    `gave false information or advertising on the insurer's content or scope or the terms, harming the policyholder` IS FALSE
    `prevented the policyholder from giving information or urged the policyholder not to declare it` IS FALSE
    `took customers by obstructing, luring, bribing or threatening staff or customers of an insurer, agent or broker` IS TRUE
    `urged a customer to cancel a contract in force` IS FALSE
`an agent who urged cancellation` MEANS `The conduct of an agent` WITH
    `filled in information for the policyholder without the policyholder's consent` IS FALSE
    `gave false information or advertising on the insurer's content or scope or the terms, harming the policyholder` IS FALSE
    `prevented the policyholder from giving information or urged the policyholder not to declare it` IS FALSE
    `took customers by obstructing, luring, bribing or threatening staff or customers of an insurer, agent or broker` IS FALSE
    `urged a customer to cancel a contract in force` IS TRUE
`an agent who completed the form without consent` MEANS `The conduct of an agent` WITH
    `filled in information for the policyholder without the policyholder's consent` IS TRUE
    `gave false information or advertising on the insurer's content or scope or the terms, harming the policyholder` IS FALSE
    `prevented the policyholder from giving information or urged the policyholder not to declare it` IS FALSE
    `took customers by obstructing, luring, bribing or threatening staff or customers of an insurer, agent or broker` IS FALSE
    `urged a customer to cancel a contract in force` IS FALSE
#ASSERT NOT `Dieu 129(3): the agent's conduct is prohibited` `an honest agent`
#ASSERT `Dieu 129(3): the agent's conduct is prohibited` `an agent who lied in advertising`
#ASSERT `Dieu 129(3): the agent's conduct is prohibited` `an agent who stopped a declaration`
#ASSERT `Dieu 129(3): the agent's conduct is prohibited` `an agent who poached customers`
#ASSERT `Dieu 129(3): the agent's conduct is prohibited` `an agent who urged cancellation`
#ASSERT `Dieu 129(2)(d): the agent filled in information for the policyholder without consent` `an agent who completed the form without consent`
#ASSERT NOT `Dieu 129(2)(d): the agent filled in information for the policyholder without consent` `an honest agent`
#ASSERT REFUSED `Dieu 129(4): the Minister of Finance's rules on advising, introducing and offering products`
#ASSERT count `Dieu 130(1): the kinds of agent certificate` EQUALS 3
#ASSERT REFUSED `Dieu 130(3): the Minister of Finance's rules on agent certificates`

§§ `Dieu 131 to 134: brokers, by vintage`

