IMPORT prelude
IMPORT `sca-jurisdiction`

-- State Courts Act 1970, ss 2, 19, 22, 23, 35, 39, 50 to 52 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_sca.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a $40,000 debt claim` MEANS Action WITH
    `amount claimed` IS 40000
    `claims a sum of money` IS TRUE
    `is passing off` IS FALSE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS FALSE
    `claimant abandons the excess` IS FALSE

`a $200,000 debt claim` MEANS Action WITH
    `amount claimed` IS 200000
    `claims a sum of money` IS TRUE
    `is passing off` IS FALSE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS FALSE
    `claimant abandons the excess` IS FALSE

`a $400,000 debt claim` MEANS Action WITH
    `amount claimed` IS 400000
    `claims a sum of money` IS TRUE
    `is passing off` IS FALSE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS FALSE
    `claimant abandons the excess` IS FALSE

`a $400,000 claim with the excess abandoned` MEANS Action WITH
    `amount claimed` IS 400000
    `claims a sum of money` IS TRUE
    `is passing off` IS FALSE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS FALSE
    `claimant abandons the excess` IS TRUE

`a $400,000 claim by signed agreement` MEANS Action WITH
    `amount claimed` IS 400000
    `claims a sum of money` IS TRUE
    `is passing off` IS FALSE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS TRUE
    `claimant abandons the excess` IS FALSE

`a $20,000 passing off claim` MEANS Action WITH
    `amount claimed` IS 20000
    `claims a sum of money` IS TRUE
    `is passing off` IS TRUE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS FALSE
    `claimant abandons the excess` IS FALSE

`an injunction-only claim worth $10,000` MEANS Action WITH
    `amount claimed` IS 10000
    `claims a sum of money` IS FALSE
    `is passing off` IS FALSE
    `is judicial review or supervisory` IS FALSE
    `parties signed a memorandum agreeing to District Court jurisdiction` IS FALSE
    `claimant abandons the excess` IS FALSE

§ `ss 2, 19, 52`

#ASSERT `the District Court limit` EQUALS 250000
#ASSERT `the Magistrate's Court limit` EQUALS 60000

#ASSERT `a District Court can hear the action` `a $40,000 debt claim`
#ASSERT `a District Court can hear the action` `a $200,000 debt claim`
#ASSERT NOT `a District Court can hear the action` `a $400,000 debt claim`
#ASSERT `a District Court can hear the action` `a $400,000 claim with the excess abandoned`
#ASSERT `a District Court can hear the action` `a $400,000 claim by signed agreement`
#ASSERT NOT `a District Court can hear the action` `a $20,000 passing off claim`
#ASSERT `a District Court can hear the action` `an injunction-only claim worth $10,000`

#ASSERT `a Magistrate's Court can hear the action` `a $40,000 debt claim`
#ASSERT NOT `a Magistrate's Court can hear the action` `a $200,000 debt claim`
#ASSERT NOT `a Magistrate's Court can hear the action` `a $400,000 debt claim`
#ASSERT NOT `a Magistrate's Court can hear the action` `a $400,000 claim with the excess abandoned`
#ASSERT NOT `a Magistrate's Court can hear the action` `a $400,000 claim by signed agreement`
#ASSERT NOT `a Magistrate's Court can hear the action` `a $20,000 passing off claim`
#ASSERT NOT `a Magistrate's Court can hear the action` `an injunction-only claim worth $10,000`

§ `ss 22, 23`

#ASSERT `the most the claimant can recover in the District Court` `a $40,000 debt claim` EQUALS 40000
#ASSERT `the most the claimant can recover in the District Court` `a $200,000 debt claim` EQUALS 200000
#ASSERT `the most the claimant can recover in the District Court` `a $400,000 debt claim` EQUALS 250000
#ASSERT `the most the claimant can recover in the District Court` `a $400,000 claim with the excess abandoned` EQUALS 250000
#ASSERT `the most the claimant can recover in the District Court` `a $400,000 claim by signed agreement` EQUALS 400000
#ASSERT `the most the claimant can recover in the District Court` `a $20,000 passing off claim` EQUALS 20000
#ASSERT `the most the claimant can recover in the District Court` `an injunction-only claim worth $10,000` EQUALS 10000

#ASSERT NOT `the excess can be sued for later` TRUE
#ASSERT `the excess can be sued for later` FALSE

§ `s 35`

#ASSERT `the claim has been impermissibly split` 2
#ASSERT NOT `the claim has been impermissibly split` 1

§ `s 39`

#ASSERT `the costs scale` 50000 TRUE EQUALS "Magistrate's Court"
#ASSERT `the costs scale` 200000 TRUE EQUALS "District Court"
#ASSERT `the costs scale` 300000 TRUE EQUALS "High Court"
#ASSERT `the costs scale` 50000 FALSE EQUALS "High Court"

§ `ss 50, 51`

#ASSERT `a State Court has criminal jurisdiction` `in Singapore`
#ASSERT `a State Court has criminal jurisdiction` `on a Singapore ship`
#ASSERT `a State Court has criminal jurisdiction` `by a citizen on the high seas`
#ASSERT NOT `a State Court has criminal jurisdiction` `by a non-citizen on the high seas, foreign ship`
#ASSERT `a State Court has criminal jurisdiction` `abroad, made triable by a written law`
#ASSERT NOT `a State Court has criminal jurisdiction` `abroad, with no such law`

