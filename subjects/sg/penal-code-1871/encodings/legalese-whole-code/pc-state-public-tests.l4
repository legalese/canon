-- Tests for the state-public group of the Penal Code 1871 encoding: Chapters 6,
-- 6A, 6B, 7, 8, 9 and 10 (ss 121-190).
--
-- Expected values come FROM THE SOURCE: each Illustration the Code prints is
-- cited on the line above its assertion as `-- s N illus (x)`; boundary cases
-- are cited to the words they test. A failing assertion here is a finding, not
-- a typo - never edit an expected value to match what the code computed.
--
-- GENERATED by notes/state-public-gen/build.py from the part files' tests();
-- edit there and rebuild.
--
-- Fixtures list every field; a leaf not named TRUE in a fixture is FALSE, which
-- is also what the charge generator's schema completion does with an unknown.

IMPORT prelude
IMPORT `pc-domain`
IMPORT `pc-general`
IMPORT `pc-state-public-common`
IMPORT `pc-state-public-contempts`
IMPORT `pc-state-public-assembly`
IMPORT `pc-state-public-servants`
IMPORT `pc-state-public-state`

§ `Shared fixtures`

`sample particulars` MEANS Particulars WITH
    accused            IS "Tan Ah Kow"
    date               IS "the 3rd day of March 2026"
    time               IS "10.15 am"
    place              IS "Block 123 Ang Mo Kio Avenue 3"
    `co-accused`       IS ""
    `common intention` IS FALSE

`nobody` MEANS Person WITH
    name           IS ""
    `described as` IS ""
    pronoun        IS they
    kind           IS `a human being`

`Sergeant Lim` MEANS Person WITH
    name           IS "Lim Ah Seng"
    `described as` IS "a police officer attached to Ang Mo Kio Police Division"
    pronoun        IS he
    kind           IS `a human being`

`Lieutenant Siti` MEANS Person WITH
    name           IS "Siti binte Rahman"
    `described as` IS "a paramedic of the Singapore Civil Defence Force"
    pronoun        IS she
    kind           IS `a human being`

`Z` MEANS Person WITH
    name           IS "Zainal bin Osman"
    `described as` IS ""
    pronoun        IS he
    kind           IS `a human being`

§ `Chapter 10 - tests`

§§ `s 172`
`172: absconding from a court summons` MEANS `Absconding Facts` WITH
    particulars IS `sample particulars`
    absconds IS TRUE
    `in order to avoid being arrested on a warrant` IS FALSE
    `in order to avoid being served with a summons, a notice or an order` IS TRUE
    `public servant` IS TRUE
    `the public servant` IS `Sergeant Lim`
    `legally competent, as such public servant, to issue such warrant, summons, notice or order` IS TRUE
    `the summons, notice or order is to attend in person or by agent, or to produce a document or an electronic record, before a court of justice` IS TRUE
    `the process` IS "a summons to attend the State Courts"
    `to wit` IS ""
#ASSERT `offence under s 172` `172: absconding from a court summons`
-- the court limb chooses the higher punishment, 6 months / $5,000
#ASSERT (`charge under s 172` `172: absconding from a court summons`)'s punishment EQUALS "imprisonment for a term which may extend to 6 months, or with fine which may extend to $5,000, or with both"
-- the process must proceed from a public servant legally competent to issue it
`172: no competence` MEANS `Absconding Facts` WITH
    particulars IS `sample particulars`
    absconds IS TRUE
    `in order to avoid being arrested on a warrant` IS TRUE
    `in order to avoid being served with a summons, a notice or an order` IS FALSE
    `public servant` IS TRUE
    `the public servant` IS `nobody`
    `legally competent, as such public servant, to issue such warrant, summons, notice or order` IS FALSE
    `the summons, notice or order is to attend in person or by agent, or to produce a document or an electronic record, before a court of justice` IS FALSE
    `the process` IS ""
    `to wit` IS ""
#ASSERT NOT `offence under s 172` `172: no competence`

