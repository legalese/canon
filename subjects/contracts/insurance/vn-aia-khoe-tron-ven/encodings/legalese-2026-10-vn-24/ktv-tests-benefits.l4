#ASSERT NOT `Article 5(a) — the cancer-screening support is due at the end of contract year` 5 `on` (`a record, lapsed:` TRUE `, lowest sum insured` `one billion` `, withdrew from basic:` FALSE)
#ASSERT `Article 5(a) — the cancer-screening support` EQUALS 5 TIMES `one million`
-- 5% of a basic account of 300 million is 15 million; due in years 5, 10, 15, 20 only.
#ASSERT `Article 8 — the loyalty bonus on a basic account value of` (300 TIMES `one million`) EQUALS 15 TIMES `one million`
#ASSERT `Article 8 — the loyalty bonus is due for contract year` 20 `on` (`a record, lapsed:` FALSE `, lowest sum insured` 0 `, withdrew from basic:` FALSE)
#ASSERT NOT `Article 8 — the loyalty bonus is due for contract year` 25 `on` (`a record, lapsed:` FALSE `, lowest sum insured` 0 `, withdrew from basic:` FALSE)
#ASSERT NOT `Article 8 — the loyalty bonus is due for contract year` 10 `on` (`a record, lapsed:` TRUE `, lowest sum insured` 0 `, withdrew from basic:` FALSE)
#ASSERT `Article 9 — the no-lapse guarantee applies in contract year` 4 `on` (`a record, lapsed:` FALSE `, lowest sum insured` 0 `, withdrew from basic:` FALSE)
#ASSERT NOT `Article 9 — the no-lapse guarantee applies in contract year` 5 `on` (`a record, lapsed:` FALSE `, lowest sum insured` 0 `, withdrew from basic:` FALSE)
#ASSERT NOT `Article 9 — the no-lapse guarantee applies in contract year` 3 `on` (`a record, lapsed:` FALSE `, lowest sum insured` 0 `, withdrew from basic:` TRUE)
