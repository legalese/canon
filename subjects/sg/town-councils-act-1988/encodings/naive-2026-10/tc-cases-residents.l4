IMPORT prelude
IMPORT `tc-residents`

-- Town Councils Act 1988, ss 31 to 35, 66 and 70 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_tc.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`conservancy arrears 60 days after demand` MEANS Arrears WITH
    `kind` IS "conservancy"
    `days since the written demand` IS 60
    `days since the notice of sale` IS 0
    `HDB approved the sale` IS TRUE
    `legal action to restrain the sale is pending` IS FALSE
    `movable property in the flat would cover the debt` IS FALSE

`conservancy arrears 100 days after demand, no notice yet` MEANS Arrears WITH
    `kind` IS "conservancy"
    `days since the written demand` IS 100
    `days since the notice of sale` IS 0
    `HDB approved the sale` IS TRUE
    `legal action to restrain the sale is pending` IS FALSE
    `movable property in the flat would cover the debt` IS FALSE

`conservancy arrears with a 91-day-old notice of sale` MEANS Arrears WITH
    `kind` IS "conservancy"
    `days since the written demand` IS 200
    `days since the notice of sale` IS 91
    `HDB approved the sale` IS TRUE
    `legal action to restrain the sale is pending` IS FALSE
    `movable property in the flat would cover the debt` IS FALSE

`the same without HDB approval` MEANS Arrears WITH
    `kind` IS "conservancy"
    `days since the written demand` IS 200
    `days since the notice of sale` IS 91
    `HDB approved the sale` IS FALSE
    `legal action to restrain the sale is pending` IS FALSE
    `movable property in the flat would cover the debt` IS FALSE

`the same with a court challenge pending` MEANS Arrears WITH
    `kind` IS "conservancy"
    `days since the written demand` IS 200
    `days since the notice of sale` IS 91
    `HDB approved the sale` IS TRUE
    `legal action to restrain the sale is pending` IS TRUE
    `movable property in the flat would cover the debt` IS FALSE

`the same where the furniture would cover it` MEANS Arrears WITH
    `kind` IS "conservancy"
    `days since the written demand` IS 200
    `days since the notice of sale` IS 91
    `HDB approved the sale` IS TRUE
    `legal action to restrain the sale is pending` IS FALSE
    `movable property in the flat would cover the debt` IS TRUE

`an owner who ignores the ticket` MEANS Ticket WITH
    `the vehicle was stolen or illegally taken` IS FALSE
    `declared the driver within 7 days` IS FALSE
    `the declaration covers more than one offence` IS FALSE
    `could not with reasonable diligence identify the driver` IS FALSE

`an owner who names the driver on day 5` MEANS Ticket WITH
    `the vehicle was stolen or illegally taken` IS FALSE
    `declared the driver within 7 days` IS TRUE
    `the declaration covers more than one offence` IS FALSE
    `could not with reasonable diligence identify the driver` IS FALSE

`an owner who names the driver for three tickets in one declaration` MEANS Ticket WITH
    `the vehicle was stolen or illegally taken` IS FALSE
    `declared the driver within 7 days` IS TRUE
    `the declaration covers more than one offence` IS TRUE
    `could not with reasonable diligence identify the driver` IS FALSE

`an owner whose car was stolen` MEANS Ticket WITH
    `the vehicle was stolen or illegally taken` IS TRUE
    `declared the driver within 7 days` IS FALSE
    `the declaration covers more than one offence` IS FALSE
    `could not with reasonable diligence identify the driver` IS FALSE

`an owner who could not trace the borrower` MEANS Ticket WITH
    `the vehicle was stolen or illegally taken` IS FALSE
    `declared the driver within 7 days` IS FALSE
    `the declaration covers more than one offence` IS FALSE
    `could not with reasonable diligence identify the driver` IS TRUE

`a contribution above the HDB figure` MEANS Contribution WITH
    `the amount determined` IS 3000
    `what HDB would have determined` IS 2500

`a contribution below the HDB figure` MEANS Contribution WITH
    `the amount determined` IS 2000
    `what HDB would have determined` IS 2500

§ `s 31`

#ASSERT `the lift upgrading may proceed` 75 100 TRUE
#ASSERT NOT `the lift upgrading may proceed` 74 100 TRUE
#ASSERT NOT `the lift upgrading may proceed` 80 100 FALSE
#ASSERT `the lift upgrading may proceed` 60 80 TRUE

§ `ss 32, 33`

#ASSERT `the amount is within section 32(4)` `a contribution above the HDB figure`
#ASSERT NOT `the amount is within section 32(4)` `a contribution below the HDB figure`

#ASSERT `the person must pay the contribution` TRUE TRUE
#ASSERT `the person must pay the contribution` TRUE FALSE
#ASSERT NOT `the person must pay the contribution` FALSE FALSE

#ASSERT `the Town Council may require the person to pay as their own debt` `the surviving spouse` TRUE
#ASSERT `the Town Council may require the person to pay as their own debt` `an adult beneficiary` TRUE
#ASSERT NOT `the Town Council may require the person to pay as their own debt` `a beneficiary under 21` TRUE
#ASSERT NOT `the Town Council may require the person to pay as their own debt` `a neighbour` TRUE
#ASSERT NOT `the Town Council may require the person to pay as their own debt` `the surviving spouse` FALSE

