IMPORT prelude
IMPORT `bsma-surveys`

-- Boundaries and Survey Maps Act 1998, ss 4, 8-12, 15-18 and 20 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_boundaries-and-survey-maps-act-1998.py). Expected results were written by
-- hand from the text.

`survey all done with marks` MEANS CadastralSurvey WITH
    `boundaries determined by straight lines` IS TRUE
    `demarcated by boundary marks or coordinates` IS TRUE
    `marks or coordinates impossible or impracticable` IS FALSE
    `demarcated by floors and walls` IS FALSE
    `area determined` IS TRUE
    `lot number assigned by the Chief Surveyor` IS TRUE
    `plan approved and filed by the Chief Surveyor` IS TRUE

`strata survey by floors and walls` MEANS CadastralSurvey WITH
    `boundaries determined by straight lines` IS TRUE
    `demarcated by boundary marks or coordinates` IS FALSE
    `marks or coordinates impossible or impracticable` IS TRUE
    `demarcated by floors and walls` IS TRUE
    `area determined` IS TRUE
    `lot number assigned by the Chief Surveyor` IS TRUE
    `plan approved and filed by the Chief Surveyor` IS TRUE

`floors and walls though marks were practicable` MEANS CadastralSurvey WITH
    `boundaries determined by straight lines` IS TRUE
    `demarcated by boundary marks or coordinates` IS FALSE
    `marks or coordinates impossible or impracticable` IS FALSE
    `demarcated by floors and walls` IS TRUE
    `area determined` IS TRUE
    `lot number assigned by the Chief Surveyor` IS TRUE
    `plan approved and filed by the Chief Surveyor` IS TRUE

`survey with plan not yet filed` MEANS CadastralSurvey WITH
    `boundaries determined by straight lines` IS TRUE
    `demarcated by boundary marks or coordinates` IS TRUE
    `marks or coordinates impossible or impracticable` IS FALSE
    `demarcated by floors and walls` IS FALSE
    `area determined` IS TRUE
    `lot number assigned by the Chief Surveyor` IS TRUE
    `plan approved and filed by the Chief Surveyor` IS FALSE

`survey with curved boundaries` MEANS CadastralSurvey WITH
    `boundaries determined by straight lines` IS FALSE
    `demarcated by boundary marks or coordinates` IS TRUE
    `marks or coordinates impossible or impracticable` IS FALSE
    `demarcated by floors and walls` IS FALSE
    `area determined` IS TRUE
    `lot number assigned by the Chief Surveyor` IS TRUE
    `plan approved and filed by the Chief Surveyor` IS TRUE

`developer bulldozes a survey stone` MEANS MarkInterference WITH
    `acted wilfully` IS TRUE
    `obliterated, removed or injured a mark` IS TRUE
    `mark made under the Chief Surveyor` IS TRUE
    `had a reasonable excuse` IS FALSE

`driver accidentally knocks a stone` MEANS MarkInterference WITH
    `acted wilfully` IS FALSE
    `obliterated, removed or injured a mark` IS TRUE
    `mark made under the Chief Surveyor` IS TRUE
    `had a reasonable excuse` IS FALSE

`owner removes stone with an excuse` MEANS MarkInterference WITH
    `acted wilfully` IS TRUE
    `obliterated, removed or injured a mark` IS TRUE
    `mark made under the Chief Surveyor` IS TRUE
    `had a reasonable excuse` IS TRUE

`owner pulls up a private marker` MEANS MarkInterference WITH
    `acted wilfully` IS TRUE
    `obliterated, removed or injured a mark` IS TRUE
    `mark made under the Chief Surveyor` IS FALSE
    `had a reasonable excuse` IS FALSE

`proper entry on a house lot` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS TRUE
    `during daylight at a reasonable time` IS TRUE
    `the land is a road` IS FALSE
    `notice was practicable` IS TRUE
    `reasonable notice given to the occupier` IS TRUE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS TRUE

`entry on a road without notice` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS TRUE
    `during daylight at a reasonable time` IS TRUE
    `the land is a road` IS TRUE
    `notice was practicable` IS TRUE
    `reasonable notice given to the occupier` IS FALSE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS TRUE

`night entry` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS TRUE
    `during daylight at a reasonable time` IS FALSE
    `the land is a road` IS FALSE
    `notice was practicable` IS TRUE
    `reasonable notice given to the occupier` IS TRUE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS TRUE

`entry without notice on private land` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS TRUE
    `during daylight at a reasonable time` IS TRUE
    `the land is a road` IS FALSE
    `notice was practicable` IS TRUE
    `reasonable notice given to the occupier` IS FALSE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS TRUE

`entry with notice impracticable` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS TRUE
    `during daylight at a reasonable time` IS TRUE
    `the land is a road` IS FALSE
    `notice was practicable` IS FALSE
    `reasonable notice given to the occupier` IS FALSE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS TRUE

`surveyor with lapsed certificate` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS FALSE
    `during daylight at a reasonable time` IS TRUE
    `the land is a road` IS FALSE
    `notice was practicable` IS TRUE
    `reasonable notice given to the occupier` IS TRUE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS TRUE

`entry without showing identity` MEANS Entry WITH
    `authorised by the Chief Surveyor` IS TRUE
    `surveyor holds a practising certificate` IS TRUE
    `during daylight at a reasonable time` IS TRUE
    `the land is a road` IS FALSE
    `notice was practicable` IS TRUE
    `reasonable notice given to the occupier` IS TRUE
    `producing identity was practicable` IS TRUE
    `identity and authority produced` IS FALSE

`clean application` MEANS PlanApplication WITH
    `subdivision permission needed and missing` IS FALSE
    `survey fees paid` IS TRUE
    `owner's encroachment affects adjoining land` IS FALSE
    `survey for a relevant purpose` IS FALSE
    `surveyor certified encroachment resolved` IS FALSE

`fees unpaid` MEANS PlanApplication WITH
    `subdivision permission needed and missing` IS FALSE
    `survey fees paid` IS FALSE
    `owner's encroachment affects adjoining land` IS FALSE
    `survey for a relevant purpose` IS FALSE
    `surveyor certified encroachment resolved` IS FALSE

`no subdivision permission` MEANS PlanApplication WITH
    `subdivision permission needed and missing` IS TRUE
    `survey fees paid` IS TRUE
    `owner's encroachment affects adjoining land` IS FALSE
    `survey for a relevant purpose` IS FALSE
    `surveyor certified encroachment resolved` IS FALSE

`unresolved encroachment on subdivision` MEANS PlanApplication WITH
    `subdivision permission needed and missing` IS FALSE
    `survey fees paid` IS TRUE
    `owner's encroachment affects adjoining land` IS TRUE
    `survey for a relevant purpose` IS TRUE
    `surveyor certified encroachment resolved` IS FALSE

`encroachment certified resolved` MEANS PlanApplication WITH
    `subdivision permission needed and missing` IS FALSE
    `survey fees paid` IS TRUE
    `owner's encroachment affects adjoining land` IS TRUE
    `survey for a relevant purpose` IS TRUE
    `surveyor certified encroachment resolved` IS TRUE

`encroachment on a resurvey for another purpose` MEANS PlanApplication WITH
    `subdivision permission needed and missing` IS FALSE
    `survey fees paid` IS TRUE
    `owner's encroachment affects adjoining land` IS TRUE
    `survey for a relevant purpose` IS FALSE
    `surveyor certified encroachment resolved` IS FALSE

§ `s 4`

#ASSERT `the cadastral survey is complete` `survey all done with marks`
#ASSERT `the cadastral survey is complete` `strata survey by floors and walls`
#ASSERT NOT `the cadastral survey is complete` `floors and walls though marks were practicable`
#ASSERT NOT `the cadastral survey is complete` `survey with plan not yet filed`
#ASSERT NOT `the cadastral survey is complete` `survey with curved boundaries`

#ASSERT `a certified plan is prima facie evidence of` `the boundaries`
#ASSERT `a certified plan is prima facie evidence of` `the lot number`
#ASSERT NOT `a certified plan is prima facie evidence of` `who owns the land`

§ `s 9`

#ASSERT `the clearing cost is recoverable from the person` TRUE FALSE
#ASSERT NOT `the clearing cost is recoverable from the person` TRUE TRUE

§ `s 11`

#ASSERT `obliterating the mark is an offence` `developer bulldozes a survey stone`
#ASSERT NOT `obliterating the mark is an offence` `driver accidentally knocks a stone`
#ASSERT NOT `obliterating the mark is an offence` `owner removes stone with an excuse`
#ASSERT NOT `obliterating the mark is an offence` `owner pulls up a private marker`

#ASSERT `the maximum fine for obliterating a mark` EQUALS 1000

#ASSERT `the further sum the court may require` 400 200 EQUALS 1800
#ASSERT `the further sum the court may require` 1000 0 EQUALS 3000

#ASSERT `who pays for replacing the mark` TRUE EQUALS `the offender`
#ASSERT `who pays for replacing the mark` FALSE EQUALS `the owners of the adjacent lands`

§ `s 12`

#ASSERT `the entry complies with s 12` `proper entry on a house lot`
#ASSERT `the entry complies with s 12` `entry on a road without notice`
#ASSERT NOT `the entry complies with s 12` `night entry`
#ASSERT NOT `the entry complies with s 12` `entry without notice on private land`
#ASSERT `the entry complies with s 12` `entry with notice impracticable`
#ASSERT NOT `the entry complies with s 12` `surveyor with lapsed certificate`
#ASSERT NOT `the entry complies with s 12` `entry without showing identity`

§ `s 15`

#ASSERT `the assurance plan may be lodged` TRUE TRUE TRUE
#ASSERT NOT `the assurance plan may be lodged` TRUE TRUE FALSE

#ASSERT NOT `the Chief Surveyor may refuse approval` `clean application`
#ASSERT `the Chief Surveyor may refuse approval` `fees unpaid`
#ASSERT `the Chief Surveyor may refuse approval` `no subdivision permission`
#ASSERT `the Chief Surveyor may refuse approval` `unresolved encroachment on subdivision`
#ASSERT NOT `the Chief Surveyor may refuse approval` `encroachment certified resolved`
#ASSERT NOT `the Chief Surveyor may refuse approval` `encroachment on a resurvey for another purpose`

§ `s 16`

#ASSERT `the Chief Surveyor may direct a correction at the surveyor's expense` TRUE FALSE
#ASSERT NOT `the Chief Surveyor may direct a correction at the surveyor's expense` TRUE TRUE

§ `s 17`

#ASSERT `the map may be altered on this ground` `a survey error in measuring, plotting or conversion`
#ASSERT `the map may be altered on this ground` `neighbours agree and present a deed at the Registry`
#ASSERT NOT `the map may be altered on this ground` `neighbours agree but present no deed`
#ASSERT `the map may be altered on this ground` `a High Court order served on the Chief Surveyor`
#ASSERT NOT `the map may be altered on this ground` `an owner simply asks for a different boundary`
#ASSERT `the map may be altered on this ground` `the boundary has moved since the survey`

#ASSERT `what follows a notice of survey error` TRUE EQUALS `an inquiry`
#ASSERT `what follows a notice of survey error` FALSE EQUALS `an order for correction`

§ `ss 8 and 18`

#ASSERT `the record is conclusive evidence` `a map published under the repealed Act` FALSE
#ASSERT NOT `the record is conclusive evidence` `a map published under the repealed Act` TRUE
#ASSERT NOT `the record is conclusive evidence` `a map generated from the coordinated cadastre` FALSE
#ASSERT `the record is conclusive evidence` `a map generated from the coordinated cadastre` TRUE
#ASSERT NOT `the record is conclusive evidence` `a certified plan` FALSE
#ASSERT `the record is conclusive evidence` `a bench mark` FALSE

§ `s 20`

#ASSERT `non-compliance is an offence` TRUE TRUE FALSE TRUE
#ASSERT `non-compliance is an offence` TRUE FALSE TRUE FALSE
#ASSERT NOT `non-compliance is an offence` TRUE FALSE TRUE TRUE

#ASSERT `the maximum fine for non-compliance` 0 EQUALS 0
#ASSERT `the maximum fine for non-compliance` 30 EQUALS 3000

