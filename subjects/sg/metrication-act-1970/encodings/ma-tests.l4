IMPORT prelude
IMPORT daydate
IMPORT `ma-types`
IMPORT `ma-act`

-- TESTS — Metrication Act 1970. Expected values are copied or worked from
-- the Act; the working is beside each.

§ `Tests — Metrication Act 1970`

§§ `The Schedules`

#ASSERT `the Schedule row for` metre    EQUALS JUST (`Unit row` OF `the First Schedule`,  "m",  "length")
#ASSERT `the Schedule row for` candela  EQUALS JUST (`Unit row` OF `the First Schedule`,  "cd", "luminous intensity")
#ASSERT `the Schedule row for` ohm      EQUALS JUST (`Unit row` OF `the Second Schedule`, "Ω",  "electric resistance")
#ASSERT `the Schedule row for` steradian EQUALS JUST (`Unit row` OF `the Second Schedule`, "sr", "solid angle")
#ASSERT `the Schedule row for` litre    EQUALS JUST (`Unit row` OF `the Fourth Schedule`, "L",  "volume")
#ASSERT `the Schedule row for` yard     EQUALS NOTHING

`every listed unit` MEANS LIST
    metre, kilogram, second, ampere, kelvin, candela
    , hertz, newton, joule, watt, coulomb, volt, farad, ohm, weber, tesla, henry, lumen, lux, radian, steradian
    , hectare, `metric tonne`, litre, `centigrade or Celsius`

GIVEN s IS A Schedule
GIVETH A NUMBER
`the number of units listed in` s MEANS
    count (filter `in the Schedule` `every listed unit`)
    WHERE
        `in the Schedule` u MEANS
            CONSIDER `the Schedule row for` u
            WHEN JUST r  THEN r's `schedule` EQUALS s
            WHEN NOTHING THEN FALSE

-- The First Schedule: "based on the following 6 basic units".
#ASSERT `the number of units listed in` `the First Schedule` EQUALS 6
-- The Second Schedule prints 15 rows (hertz to steradian); the Fourth, 4.
#ASSERT `the number of units listed in` `the Second Schedule` EQUALS 15
#ASSERT `the number of units listed in` `the Fourth Schedule` EQUALS 4

§§ `ss 2-3 — the International System of Units`

#ASSERT     `a unit of the International System of Units:` metre `, the context excluding the Fourth Schedule:` FALSE
#ASSERT     `a unit of the International System of Units:` radian `, the context excluding the Fourth Schedule:` TRUE
-- s 2(1)(b): the Fourth Schedule units are included "unless" the context says otherwise.
#ASSERT     `a unit of the International System of Units:` hectare `, the context excluding the Fourth Schedule:` FALSE
#ASSERT NOT `a unit of the International System of Units:` hectare `, the context excluding the Fourth Schedule:` TRUE
#ASSERT NOT `a unit of the International System of Units:` yard `, the context excluding the Fourth Schedule:` FALSE
#ASSERT NOT `a unit of the International System of Units:` `another unit` `, the context excluding the Fourth Schedule:` FALSE
#ASSERT     `a recognised legal reference to the International System of Units:` "SI"
#ASSERT NOT `a recognised legal reference to the International System of Units:` "MKS"
-- s 3(1): "On and after 15 February 1971".
#ASSERT NOT `the use of SI has legal force and validity in Singapore under s 3(1) on` (YMD 1971 2 14)
#ASSERT     `the use of SI has legal force and validity in Singapore under s 3(1) on` (YMD 1971 2 15)

§§ `s 4`

#ASSERT     `an order within s 4` (`Section 4 order` OF TRUE, TRUE, TRUE)
#ASSERT NOT `an order within s 4` (`Section 4 order` OF TRUE, TRUE, FALSE)     -- (2) not gazetted
#ASSERT NOT `an order within s 4` (`Section 4 order` OF TRUE, FALSE, TRUE)     -- neither equivalent nor a desirable approximation

§§ `s 5 and the Third Schedule`

-- "1 yard = 0.9144 metre exactly": 100 yards = 91.44 metres.
#ASSERT `the SI value of` 100 yard EQUALS 91.44
-- "1 pound = 0.45359237 kilogram exactly": 2 pounds = 0.90718474 kg.
#ASSERT `the SI value of` 2 pound EQUALS 0.90718474
-- "1 gallon = 4.54609 litres approximately": 10 gallons = 45.4609 litres.
#ASSERT `the SI value of` 10 gallon EQUALS 45.4609
-- "1 tahil = 37.799364 grams approximately": 16 tahil = 604.789824 grams,
-- which agrees, to the printed precision, with "1 kati = 0.604790 kilogram".
#ASSERT `the SI value of` 16 tahil EQUALS 604.789824
#ASSERT `the SI value of` 1 kati EQUALS 0.604790
-- "1 chhun = 37.465 millimetres exactly", "1 chhek = 0.37465 metre exactly":
-- 10 chhun = 374.65 mm = 0.37465 m = 1 chhek.
#ASSERT `the SI value of` 10 chhun EQUALS 374.65
#ASSERT `the SI value of` 1 chhek EQUALS 0.37465
-- exactly / approximately, as printed.
#ASSERT     (`the Third Schedule conversion for` yard)   EQUALS JUST (Conversion OF 0.9144, "metre", TRUE)
#ASSERT     (`the Third Schedule conversion for` gallon) EQUALS JUST (Conversion OF 4.54609, "litres (= cubic decimetres)", FALSE)
-- A metre needs no conversion and the Schedule gives none.
#ASSERT REFUSED `the SI value of` 5 metre
#ASSERT `the system of` yard EQUALS `an imperial standard of extension, weight or capacity`
#ASSERT `the system of` kati EQUALS `the local customary system of weights and measures`
#ASSERT `the system of` metre EQUALS `neither`

§§ `s 7 — saving`

-- (1): done before the order, challenged only on the units ground — barred.
#ASSERT     `s 7(1) bars a challenge to an act done on` (YMD 1990 1 1) `, the order made on` (JUST (YMD 1991 1 1)) `, on the units ground only:` TRUE
-- Done after the order: s 7(1) does not reach it.
#ASSERT NOT `s 7(1) bars a challenge to an act done on` (YMD 1992 1 1) `, the order made on` (JUST (YMD 1991 1 1)) `, on the units ground only:` TRUE
-- Challenged on other grounds too: "only on the ground" is not met.
#ASSERT NOT `s 7(1) bars a challenge to an act done on` (YMD 1990 1 1) `, the order made on` (JUST (YMD 1991 1 1)) `, on the units ground only:` FALSE
-- No order made yet: every act is "before the making of any order".
#ASSERT     `s 7(1) bars a challenge to an act done on` (YMD 2026 1 1) `, the order made on` NOTHING `, on the units ground only:` TRUE
#ASSERT     `the Act leaves another system's legal force untouched, it being lawfully used:` TRUE
