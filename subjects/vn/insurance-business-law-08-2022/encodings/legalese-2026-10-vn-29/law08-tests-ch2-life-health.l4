`instalments with the next one unpayable` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS TRUE
    `some instalments have been paid` IS TRUE
    `the policyholder cannot pay the next instalments` IS TRUE
    `date the grace period began` IS YMD 2025 5 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2000 1 1
    `date the parties agreed to restore the contract` IS YMD 2000 1 1
    `the missing premium has been paid` IS FALSE
    `the insurer deducted unpaid premium from the surrender value` IS FALSE
    `the policyholder agreed to the deduction` IS FALSE
    `the insurer sued for the premium` IS FALSE
`a single premium` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS FALSE
    `some instalments have been paid` IS FALSE
    `the policyholder cannot pay the next instalments` IS FALSE
    `date the grace period began` IS YMD 2000 1 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2000 1 1
    `date the parties agreed to restore the contract` IS YMD 2000 1 1
    `the missing premium has been paid` IS FALSE
    `the insurer deducted unpaid premium from the surrender value` IS FALSE
    `the policyholder agreed to the deduction` IS FALSE
    `the insurer sued for the premium` IS FALSE
`a restoration on the last day of the second year` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS FALSE
    `some instalments have been paid` IS FALSE
    `the policyholder cannot pay the next instalments` IS FALSE
    `date the grace period began` IS YMD 2000 1 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2025 5 1
    `date the parties agreed to restore the contract` IS YMD 2027 5 1
    `the missing premium has been paid` IS TRUE
    `the insurer deducted unpaid premium from the surrender value` IS FALSE
    `the policyholder agreed to the deduction` IS FALSE
    `the insurer sued for the premium` IS FALSE
`a restoration a day too late` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS FALSE
    `some instalments have been paid` IS FALSE
    `the policyholder cannot pay the next instalments` IS FALSE
    `date the grace period began` IS YMD 2000 1 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2025 5 1
    `date the parties agreed to restore the contract` IS YMD 2027 5 2
    `the missing premium has been paid` IS TRUE
    `the insurer deducted unpaid premium from the surrender value` IS FALSE
    `the policyholder agreed to the deduction` IS FALSE
    `the insurer sued for the premium` IS FALSE
`a restoration without the missing premium` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS FALSE
    `some instalments have been paid` IS FALSE
    `the policyholder cannot pay the next instalments` IS FALSE
    `date the grace period began` IS YMD 2000 1 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2025 5 1
    `date the parties agreed to restore the contract` IS YMD 2026 1 1
    `the missing premium has been paid` IS FALSE
    `the insurer deducted unpaid premium from the surrender value` IS FALSE
    `the policyholder agreed to the deduction` IS FALSE
    `the insurer sued for the premium` IS FALSE
`an unauthorised deduction` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS FALSE
    `some instalments have been paid` IS FALSE
    `the policyholder cannot pay the next instalments` IS FALSE
    `date the grace period began` IS YMD 2000 1 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2000 1 1
    `date the parties agreed to restore the contract` IS YMD 2000 1 1
    `the missing premium has been paid` IS FALSE
    `the insurer deducted unpaid premium from the surrender value` IS TRUE
    `the policyholder agreed to the deduction` IS FALSE
    `the insurer sued for the premium` IS FALSE
`an agreed deduction` MEANS `The payment of life insurance premium` WITH
    `premium is paid by instalments` IS FALSE
    `some instalments have been paid` IS FALSE
    `the policyholder cannot pay the next instalments` IS FALSE
    `date the grace period began` IS YMD 2000 1 1
    `date the contract was terminated under Dieu 26(1)` IS YMD 2000 1 1
    `date the parties agreed to restore the contract` IS YMD 2000 1 1
    `the missing premium has been paid` IS FALSE
    `the insurer deducted unpaid premium from the surrender value` IS TRUE
    `the policyholder agreed to the deduction` IS TRUE
    `the insurer sued for the premium` IS FALSE
`a suit for premium` MEANS `The payment of life insurance premium` WITH
