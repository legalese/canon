§ `s 5`

#ASSERT `the Act applies` `a crash at Changi`
#ASSERT `the Act applies` `a Singapore-licensed aircraft lost over open ocean, wreckage in Singapore`
#ASSERT NOT `the Act applies` `a foreign airliner crash abroad`
#ASSERT `the Act applies` `a Singapore ship collision abroad`
#ASSERT `the Act applies` `a foreign ship casualty abroad with a witness in Singapore`
#ASSERT NOT `the Act applies` `a derailment in Singapore before the rail relevant date`
#ASSERT `the Act applies` `an MRT derailment`
#ASSERT `the Act applies` `a bus crash in Singapore`
#ASSERT NOT `the Act applies` `a Singapore bus crash in Johor`

§ `s 16`

#ASSERT `the occurrence may be investigated` `a crash at Changi`
#ASSERT `the occurrence may be investigated` `a Singapore-licensed aircraft lost over open ocean, wreckage in Singapore`
#ASSERT NOT `the occurrence may be investigated` `a foreign airliner crash abroad`
#ASSERT NOT `the occurrence may be investigated` `a foreign ship casualty abroad with a witness in Singapore`
#ASSERT `the occurrence may be investigated` `a bus crash in Singapore`
#ASSERT NOT `the occurrence may be investigated` `a Singapore bus crash in Johor`
#ASSERT NOT `the occurrence may be investigated` `a military jet crash on an air base`
#ASSERT `the occurrence may be investigated` `a military jet crash on an air base the Armed Forces refer`
#ASSERT `the occurrence may be investigated` `a military jet crash at a civilian air show`
#ASSERT NOT `the occurrence may be investigated` `a foreign airliner crash abroad the Minister orders investigated`

§ `s 15`

#ASSERT `an investigation must be carried out` `a crash at Changi` TRUE TRUE TRUE
#ASSERT NOT `an investigation must be carried out` `a military jet crash on an air base` TRUE TRUE TRUE
#ASSERT NOT `an investigation must be carried out` `a foreign airliner crash abroad the Minister orders investigated` FALSE FALSE FALSE
#ASSERT `an investigation must be carried out` `a bus crash in Singapore the Minister orders investigated` FALSE FALSE FALSE

#ASSERT `the Director may discontinue the investigation` `a crash at Changi`
#ASSERT NOT `the Director may discontinue the investigation` `a bus crash in Singapore the Minister orders investigated`

§ `s 12`

#ASSERT `failing to report is an offence` `an immediately reportable matter` FALSE FALSE FALSE FALSE
#ASSERT NOT `failing to report is an offence` `an ordinary reportable matter` FALSE FALSE FALSE FALSE
#ASSERT `failing to report is an offence` `an ordinary reportable matter` TRUE FALSE FALSE FALSE
#ASSERT NOT `failing to report is an offence` `an immediately reportable matter` FALSE FALSE TRUE FALSE
#ASSERT NOT `failing to report is an offence` `an immediately reportable matter` FALSE FALSE FALSE TRUE

§ `ss 19, 21`

#ASSERT `handling the draft report is an offence` TRUE FALSE FALSE
#ASSERT NOT `handling the draft report is an offence` TRUE TRUE FALSE
#ASSERT NOT `handling the draft report is an offence` TRUE FALSE TRUE

#ASSERT `s 21 bars the report as evidence` `a published report` `a civil suit`
#ASSERT NOT `s 21 bars the report as evidence` `a published report` `a coroner's inquiry`
#ASSERT `s 21 bars the report as evidence` `a draft report` `a coroner's inquiry`

§ `s 29(4)`

#ASSERT `an investigator may require the procedure` `a breath-analyser test`
#ASSERT NOT `an investigator may require the procedure` `a procedure involving surgery`

§ `ss 33, 36-38`

#ASSERT `the conduct is an offence under s 33` TRUE TRUE FALSE
#ASSERT NOT `the conduct is an offence under s 33` TRUE TRUE TRUE

#ASSERT `refusing to answer is an offence` TRUE TRUE FALSE TRUE
#ASSERT NOT `refusing to answer is an offence` TRUE FALSE TRUE TRUE

#ASSERT NOT `the answer is admissible against the person` TRUE TRUE FALSE
#ASSERT `the answer is admissible against the person` FALSE TRUE FALSE

§ `Penalties and s 42`

#ASSERT `the maximum fine` `s 12 failing to report` EQUALS 100000
#ASSERT `the maximum fine` `s 19 copying or disclosing a draft report` EQUALS 20000
#ASSERT `the maximum fine` `s 22 failing to respond to a safety recommendation` EQUALS 10000

#ASSERT `the maximum imprisonment in months` `s 36 refusing to answer or give documents` EQUALS 60
#ASSERT `the maximum imprisonment in months` `s 34 hindering an investigation` EQUALS 12

#ASSERT `the composition cap` `s 12 failing to report` EQUALS 5000

#ASSERT `the composition cap for a maximum fine of` 6000 EQUALS 3000

