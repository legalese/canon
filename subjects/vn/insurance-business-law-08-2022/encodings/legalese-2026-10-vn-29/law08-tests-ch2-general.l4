#ASSERT NOT `Dieu 20(1)(d): the insurer may refuse to pay` `a covered event, not excluded, paid`
#ASSERT `Dieu 20(1)(d): the insurer may refuse to pay` `a covered event, refused on an exclusion, explained`
#ASSERT `Dieu 20(1)(d): the insurer may refuse to pay` `an uncovered event, refused, not explained`
#ASSERT `Dieu 20(2)(dd): the insurer is bound to pay` `a covered event, not excluded, paid`
#ASSERT NOT `Dieu 20(2)(dd): the insurer is bound to pay` `a covered event, refused on an exclusion, explained`
#ASSERT `Dieu 20(2)(dd): the insurer's refusal is a breach` `a covered event, refused without ground`
#ASSERT NOT `Dieu 20(2)(dd): the insurer's refusal is a breach` `a covered event, refused on an exclusion, explained`
#ASSERT `Dieu 20(2)(e): the refusal was not explained in writing` `an uncovered event, refused, not explained`
#ASSERT NOT `Dieu 20(2)(e): the refusal was not explained in writing` `a covered event, refused on an exclusion, explained`
#ASSERT `Dieu 20(2)(g): the insurer failed to cooperate on the third person's claim` `a third person's claim not cooperated on`
#ASSERT NOT `Dieu 20(2)(g): the insurer failed to cooperate on the third person's claim` `a third person's claim cooperated on`
#ASSERT NOT `Dieu 20(2)(i): the insurer disclosed information in breach of confidentiality` `a disclosure to a regulator`
#ASSERT NOT `Dieu 20(2)(i): the insurer disclosed information in breach of confidentiality` `a disclosure with consent`
#ASSERT `Dieu 20(2)(i): the insurer disclosed information in breach of confidentiality` `a disclosure to a journalist`

`a premium paid late` MEANS `The policyholder's conduct` WITH
    `premium was due` IS TRUE
    `premium was paid in full by the agreed time` IS FALSE
    `a circumstance increasing or reducing the risk arose` IS FALSE
    `the contract agrees the policyholder is to notify such a circumstance` IS FALSE
    `the policyholder notified the circumstance` IS FALSE
    `an insured event occurred` IS FALSE
    `the policyholder notified the insured event as the contract agrees` IS FALSE
    `the policyholder cooperated in the loss adjustment` IS FALSE
`a premium paid on time` MEANS `The policyholder's conduct` WITH
    `premium was due` IS TRUE
    `premium was paid in full by the agreed time` IS TRUE
    `a circumstance increasing or reducing the risk arose` IS FALSE
    `the contract agrees the policyholder is to notify such a circumstance` IS FALSE
    `the policyholder notified the circumstance` IS FALSE
    `an insured event occurred` IS FALSE
    `the policyholder notified the insured event as the contract agrees` IS FALSE
    `the policyholder cooperated in the loss adjustment` IS FALSE
`an unnotified change of risk the contract requires to be notified` MEANS `The policyholder's conduct` WITH
    `premium was due` IS FALSE
    `premium was paid in full by the agreed time` IS FALSE
    `a circumstance increasing or reducing the risk arose` IS TRUE
    `the contract agrees the policyholder is to notify such a circumstance` IS TRUE
    `the policyholder notified the circumstance` IS FALSE
    `an insured event occurred` IS FALSE
    `the policyholder notified the insured event as the contract agrees` IS FALSE
    `the policyholder cooperated in the loss adjustment` IS FALSE
`an unnotified change of risk the contract is silent on` MEANS `The policyholder's conduct` WITH
    `premium was due` IS FALSE
    `premium was paid in full by the agreed time` IS FALSE
    `a circumstance increasing or reducing the risk arose` IS TRUE
    `the contract agrees the policyholder is to notify such a circumstance` IS FALSE
    `the policyholder notified the circumstance` IS FALSE
    `an insured event occurred` IS FALSE
    `the policyholder notified the insured event as the contract agrees` IS FALSE
    `the policyholder cooperated in the loss adjustment` IS FALSE
`an insured event not notified` MEANS `The policyholder's conduct` WITH
    `premium was due` IS FALSE
    `premium was paid in full by the agreed time` IS FALSE
    `a circumstance increasing or reducing the risk arose` IS FALSE
    `the contract agrees the policyholder is to notify such a circumstance` IS FALSE
    `the policyholder notified the circumstance` IS FALSE
    `an insured event occurred` IS TRUE
    `the policyholder notified the insured event as the contract agrees` IS FALSE
    `the policyholder cooperated in the loss adjustment` IS TRUE
`an insured event notified and cooperated on` MEANS `The policyholder's conduct` WITH
    `premium was due` IS FALSE
    `premium was paid in full by the agreed time` IS FALSE
    `a circumstance increasing or reducing the risk arose` IS FALSE
    `the contract agrees the policyholder is to notify such a circumstance` IS FALSE
    `the policyholder notified the circumstance` IS FALSE
    `an insured event occurred` IS TRUE
    `the policyholder notified the insured event as the contract agrees` IS TRUE
    `the policyholder cooperated in the loss adjustment` IS TRUE
#ASSERT `Dieu 21(2)(c): the policyholder failed to pay premium in full and on time` `a premium paid late`
#ASSERT NOT `Dieu 21(2)(c): the policyholder failed to pay premium in full and on time` `a premium paid on time`
#ASSERT `Dieu 21(2)(d): the policyholder failed to notify a change of risk` `an unnotified change of risk the contract requires to be notified`
#ASSERT NOT `Dieu 21(2)(d): the policyholder failed to notify a change of risk` `an unnotified change of risk the contract is silent on`
#ASSERT `Dieu 21(2)(dd): the policyholder failed to notify the insured event or cooperate` `an insured event not notified`
#ASSERT NOT `Dieu 21(2)(dd): the policyholder failed to notify the insured event or cooperate` `an insured event notified and cooperated on`

