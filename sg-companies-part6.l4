-- TEST CASES
-- ===========================================================================

§§ `Part 6 — Illustrations`

-- s 201(9): audit timing
#ASSERT `audit timing requirement met` 14 FALSE
#ASSERT `audit timing requirement met` 20 FALSE
#ASSERT NOT (`audit timing requirement met` 10 FALSE)
-- Unanimous consent overrides
#ASSERT `audit timing requirement met` 5 TRUE

-- s 201A: dormant company exemption
#ASSERT `exempt from preparing financial statements` TRUE FALSE FALSE
#ASSERT NOT (`exempt from preparing financial statements` FALSE FALSE FALSE)
#ASSERT NOT (`exempt from preparing financial statements` TRUE TRUE FALSE)
#ASSERT NOT (`exempt from preparing financial statements` TRUE FALSE TRUE)

-- s 201A: who may send override notice
#ASSERT `may send dormant company override notice` TRUE 0 0
#ASSERT `may send dormant company override notice` FALSE 5 0
#ASSERT `may send dormant company override notice` FALSE 0 5
#ASSERT NOT (`may send dormant company override notice` FALSE 3 3)

-- s 201B: audit committee constitution
-- 3 members, 2 non-executive -> majority is non-executive
#ASSERT `audit committee properly constituted` 3 2
#ASSERT `audit committee properly constituted` 5 3
-- 3 members, 1 non-executive -> not majority
#ASSERT NOT (`audit committee properly constituted` 3 1)
-- 2 members -> below minimum
#ASSERT NOT (`audit committee properly constituted` 2 2)

-- s 205B: dormant audit exemption
#ASSERT `exempt from audit as dormant company` TRUE FALSE
#ASSERT NOT (`exempt from audit as dormant company` TRUE TRUE)
#ASSERT NOT (`exempt from audit as dormant company` FALSE FALSE)

-- s 205C: small company criteria count
#ASSERT (`small company criteria met` 5000000 5000000 30) EQUALS 3
#ASSERT (`small company criteria met` 15000000 5000000 30) EQUALS 2
#ASSERT (`small company criteria met` 15000000 15000000 30) EQUALS 1
#ASSERT (`small company criteria met` 15000000 15000000 60) EQUALS 0

-- s 205C: qualifies as small in a single year
#ASSERT `qualifies as small company in year` 5000000 5000000 30
#ASSERT `qualifies as small company in year` 15000000 5000000 30
#ASSERT NOT (`qualifies as small company in year` 15000000 15000000 60)

-- s 205C: full qualification (both years)
#ASSERT `qualifies as small company` TRUE TRUE
#ASSERT NOT (`qualifies as small company` TRUE FALSE)
#ASSERT NOT (`qualifies as small company` FALSE TRUE)

-- s 205C: small company audit exemption with group test
#ASSERT `small company audit exemption applies` TRUE TRUE TRUE
#ASSERT NOT (`small company audit exemption applies` TRUE TRUE FALSE)
#ASSERT NOT (`small company audit exemption applies` FALSE TRUE TRUE)

-- s 207: mandatory fraud reporting
-- Offence >= 2 years AND property >= $100,000
#ASSERT `mandatory fraud reporting triggered` 2 100000
#ASSERT `mandatory fraud reporting triggered` 5 500000
-- Below imprisonment threshold
#ASSERT NOT (`mandatory fraud reporting triggered` 1 200000)
-- Below property threshold
#ASSERT NOT (`mandatory fraud reporting triggered` 3 50000)
