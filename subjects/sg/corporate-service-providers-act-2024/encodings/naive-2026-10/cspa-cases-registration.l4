    `employs a registered qualified individual` IS FALSE
    `a key appointment holder is not fit and proper` IS FALSE
    `the applicant completed the prescribed course` IS FALSE
    `every key appointment holder completed the prescribed course` IS FALSE
    `had a registration cancelled under section 19` IS FALSE
    `months since that cancellation` IS 0

`a company with an unfit director` MEANS ProviderApplicant WITH
    `form` IS `a company`
    `is itself a registered qualified individual` IS FALSE
    `a partner is a registered qualified individual` IS FALSE
    `employs a registered qualified individual` IS TRUE
    `a key appointment holder is not fit and proper` IS TRUE
    `the applicant completed the prescribed course` IS FALSE
    `every key appointment holder completed the prescribed course` IS TRUE
    `had a registration cancelled under section 19` IS FALSE
