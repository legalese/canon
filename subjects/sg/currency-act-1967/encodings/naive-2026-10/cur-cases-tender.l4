§ `ss 11, 12`

#ASSERT `cents in a Singapore dollar` EQUALS 100

#ASSERT `the obligation must be settled in Singapore dollars` FALSE FALSE
#ASSERT NOT `the obligation must be settled in Singapore dollars` FALSE TRUE

§ `s 13`

#ASSERT `the largest payment coins of this face value can make` 10 EQUALS 200
#ASSERT `the largest payment coins of this face value can make` 100 EQUALS 2000

#ASSERT `it is legal tender for the payment` `a 50-dollar note for a 500-dollar bill`
#ASSERT `it is legal tender for the payment` `1-dollar coins for a 20-dollar bill`
#ASSERT NOT `it is legal tender for the payment` `1-dollar coins for a 21-dollar bill`
#ASSERT `it is legal tender for the payment` `10-cent coins for a 2-dollar bill`
#ASSERT NOT `it is legal tender for the payment` `10-cent coins for a 2-dollar-10 bill`
#ASSERT `it is legal tender for the payment` `a worn but intact note`
#ASSERT NOT `it is legal tender for the payment` `a note with writing on it`
#ASSERT NOT `it is legal tender for the payment` `a note stained by an IBNS`
#ASSERT `it is legal tender for the payment` `a coin from a cash box whose IBNS fired`
#ASSERT NOT `it is legal tender for the payment` `a coin with a name engraved on it`
#ASSERT NOT `it is legal tender for the payment` `a bent coin`
#ASSERT NOT `it is legal tender for the payment` `a withdrawn note`
#ASSERT NOT `it is legal tender for the payment` `a note of a denomination the payee refused in writing`
#ASSERT NOT `it is legal tender for the payment` `a foreign banknote`

#ASSERT NOT `it has been illegally dealt with` `a worn but intact note`
#ASSERT `it has been illegally dealt with` `a note with writing on it`
#ASSERT `it has been illegally dealt with` `a note stained by an IBNS`
#ASSERT NOT `it has been illegally dealt with` `a coin from a cash box whose IBNS fired`
#ASSERT `it has been illegally dealt with` `a coin with a name engraved on it`
#ASSERT `it has been illegally dealt with` `a bent coin`

§ `s 14`

#ASSERT `issuing it contravenes section 14` TRUE FALSE FALSE
#ASSERT NOT `issuing it contravenes section 14` TRUE TRUE FALSE
#ASSERT NOT `issuing it contravenes section 14` TRUE FALSE TRUE

#ASSERT `the section 14 fine` 250000 EQUALS 250000

§ `s 18`

#ASSERT NOT `the exchange period meets the 6-month floor` 5
#ASSERT `the exchange period meets the 6-month floor` 6

§ `s 19`

#ASSERT `section 19 bars recovery of its value` TRUE FALSE
#ASSERT `section 19 bars recovery of its value` FALSE TRUE
#ASSERT NOT `section 19 bars recovery of its value` FALSE FALSE

#ASSERT `the Authority must repossess it when tendered` FALSE TRUE

§ `s 20`

#ASSERT `the use is an offence under section 20` `a photograph of a note in an advertisement` FALSE
#ASSERT `the use is an offence under section 20` `merchandise printed with a picture of a note` FALSE
#ASSERT `the use is an offence under section 20` `merchandise using a design element from a note` FALSE
#ASSERT `the use is an offence under section 20` `a token resembling a coin` FALSE
#ASSERT NOT `the use is an offence under section 20` `a photograph of a note in a news article` FALSE
#ASSERT NOT `the use is an offence under section 20` `a photograph of a note in an advertisement` TRUE
#ASSERT `the use is an offence under section 20` `a token resembling a coin` TRUE

#ASSERT `the section 20 maximum fine` EQUALS 2000

