§ `s 20`

#ASSERT `carrying out the works is an offence under section 20(1)` `an extension built without approval`
#ASSERT NOT `carrying out the works is an offence under section 20(1)` `an approved extension built to plan`
#ASSERT NOT `carrying out the works is an offence under section 20(1)` `an approved extension built a storey higher`
#ASSERT NOT `carrying out the works is an offence under section 20(1)` `an approved extension that deviated without the contractor's knowledge`
#ASSERT NOT `carrying out the works is an offence under section 20(1)` `insignificant works without approval`

#ASSERT NOT `the deviation is an offence under section 20(3)` `an extension built without approval`
#ASSERT NOT `the deviation is an offence under section 20(3)` `an approved extension built to plan`
#ASSERT `the deviation is an offence under section 20(3)` `an approved extension built a storey higher`
#ASSERT NOT `the deviation is an offence under section 20(3)` `an approved extension that deviated without the contractor's knowledge`
#ASSERT NOT `the deviation is an offence under section 20(3)` `insignificant works without approval`

#ASSERT `the maximum fine` `an extension built without approval` EQUALS 200000
#ASSERT `the maximum fine` `an approved extension built to plan` EQUALS 0
#ASSERT `the maximum fine` `an approved extension built a storey higher` EQUALS 100000
#ASSERT `the maximum fine` `an approved extension that deviated without the contractor's knowledge` EQUALS 0
#ASSERT `the maximum fine` `insignificant works without approval` EQUALS 0

§ `s 12`

#ASSERT `the occupation is lawful` `moving into a new house with a CSC`
#ASSERT `the occupation is lawful` `moving into a new condo on a TOP`
#ASSERT NOT `the occupation is lawful` `moving into a new house with neither`
#ASSERT `the occupation is lawful` `a watchman guarding an unfinished house`
#ASSERT `the occupation is lawful` `living in an old house with no works`

#ASSERT NOT `the TOP is evidence that the building complies with the Act` TRUE

§ `s 25H`

#ASSERT `failure to maintain is presumed` `a rusted window that fell, owner did nothing`
#ASSERT NOT `failure to maintain is presumed` `a window that fell in a storm`
#ASSERT `failure to maintain is presumed` `a fallen window with faulty installer rivets`
#ASSERT `failure to maintain is presumed` `a fallen window, contractor declared on day 5 and relied on`
#ASSERT `failure to maintain is presumed` `a fallen window, contractor declared on day 10`
#ASSERT `failure to maintain is presumed` `a fallen window the owner proves was serviced`

#ASSERT NOT `the contractor route is available` `a rusted window that fell, owner did nothing`
#ASSERT NOT `the contractor route is available` `a window that fell in a storm`
#ASSERT NOT `the contractor route is available` `a fallen window with faulty installer rivets`
#ASSERT `the contractor route is available` `a fallen window, contractor declared on day 5 and relied on`
#ASSERT NOT `the contractor route is available` `a fallen window, contractor declared on day 10`
#ASSERT NOT `the contractor route is available` `a fallen window the owner proves was serviced`

#ASSERT `the person responsible is guilty under section 25H` `a rusted window that fell, owner did nothing`
#ASSERT NOT `the person responsible is guilty under section 25H` `a window that fell in a storm`
#ASSERT NOT `the person responsible is guilty under section 25H` `a fallen window with faulty installer rivets`
#ASSERT NOT `the person responsible is guilty under section 25H` `a fallen window, contractor declared on day 5 and relied on`
#ASSERT `the person responsible is guilty under section 25H` `a fallen window, contractor declared on day 10`
#ASSERT NOT `the person responsible is guilty under section 25H` `a fallen window the owner proves was serviced`

#ASSERT `the person responsible` `a window of a private flat` EQUALS "the owner of the flat"
#ASSERT `the person responsible` `a feature on HDB common property` EQUALS "the Town Council or its contractor"
#ASSERT `the person responsible` `a feature on condominium common property` EQUALS "the owner of the common property or its managing agent"

