IMPORT prelude
IMPORT `psga-directions`
IMPORT `psga-personnel-governance`

-- Public Sector (Governance) Act 2018, Parts 3 and 4 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law.

§ `Fixtures -- bodies`

GIVEN `is established by a public Act` IS A BOOLEAN,
      `is a Town Council` IS A BOOLEAN,
      `schedule listing` IS A ScheduleListing,
      `main function is regulating a profession` IS A BOOLEAN,
      `main function is representing the community` IS A BOOLEAN
GIVETH A BodyFacts
DECIDE `a body of the kind` `is established by a public Act` `is a Town Council` `schedule listing` `main function is regulating a profession` `main function is representing the community` IS
    BodyFacts WITH
        `a body corporate established by a public Act for the purposes of a public function` IS `is established by a public Act`
        `a Town Council established under section 4 of the Town Councils Act 1988` IS `is a Town Council`
        `listed in` IS `schedule listing`
        `its main function is to regulate the practice and standards of a profession` IS `main function is regulating a profession`
        `its main function is to represent particular community interests or the volunteer movement` IS `main function is representing the community`

`a Group 1A board` MEANS `a body of the kind` TRUE FALSE `Part 1 of the First Schedule` FALSE FALSE
`DSTA, the only Group 1B body` MEANS `a body of the kind` TRUE FALSE `Part 2 of the First Schedule` FALSE FALSE
`the People's Association, the only Group 1C body` MEANS `a body of the kind` TRUE FALSE `Part 3 of the First Schedule` FALSE FALSE
`a Group 2A regulator` MEANS `a body of the kind` TRUE FALSE `Part 1 of the Second Schedule` TRUE FALSE
`a Group 2B regulator` MEANS `a body of the kind` TRUE FALSE `Part 2 of the Second Schedule` TRUE FALSE
`a Part 1 Second Schedule body that does not regulate a profession` MEANS `a body of the kind` TRUE FALSE `Part 1 of the Second Schedule` FALSE FALSE
`a Group 3A community body` MEANS `a body of the kind` TRUE FALSE `Part 1 of the Third Schedule` FALSE TRUE
`a Group 3B community body` MEANS `a body of the kind` TRUE FALSE `Part 2 of the Third Schedule` FALSE TRUE
`a public body in no Schedule` MEANS `a body of the kind` TRUE FALSE `no Schedule` FALSE FALSE

§ `Sections 12 and 22 -- who Parts 3 and 4 apply to`

#ASSERT `Parts 3 and 4 apply to the body` `a Group 1A board`
#ASSERT `Parts 3 and 4 apply to the body` `a Group 2A regulator`
#ASSERT `Parts 3 and 4 apply to the body` `a Group 2B regulator`
#ASSERT `Parts 3 and 4 apply to the body` `a Group 3A community body`
#ASSERT `Parts 3 and 4 apply to the body` `a Group 3B community body`

-- A body listed in Part 1 of the Second Schedule that does not regulate a profession is a
-- Group 2A public body and not a Group 2 public body, so Parts 3 and 4 miss it.
#ASSERT NOT `Parts 3 and 4 apply to the body` `a Part 1 Second Schedule body that does not regulate a profession`
#ASSERT NOT `Parts 3 and 4 apply to the body` `a public body in no Schedule`

§ `Fixtures -- chief executives`

GIVEN `the body` IS A BodyFacts,
      `appointed by the public body` IS A BOOLEAN,
      `Minister approved` IS A BOOLEAN,
      `Commission concurred` IS A BOOLEAN,
      `held office before 1 April 2018` IS A BOOLEAN,
      `a seconded public officer` IS A BOOLEAN
GIVETH A ChiefExecutiveFacts
DECIDE `a chief executive` `the body` `appointed by the public body` `Minister approved` `Commission concurred` `held office before 1 April 2018` `a seconded public officer` IS
    ChiefExecutiveFacts WITH
        `the body` IS `the body`
        `the appointment was made by the public body` IS `appointed by the public body`
        `the responsible Minister gave prior approval` IS `Minister approved`
        `the Public Service Commission gave prior concurrence` IS `Commission concurred`
        `the chief executive was appointed before 1 April 2018 and held office immediately before that date` IS `held office before 1 April 2018`
        `the chief executive is a public officer under a secondment arrangement` IS `a seconded public officer`

`a Group 1 chief executive with every approval` MEANS `a chief executive` `a Group 1A board` TRUE TRUE TRUE FALSE FALSE
`a Group 1 chief executive with the Minister's approval but no concurrence` MEANS `a chief executive` `a Group 1A board` TRUE TRUE FALSE FALSE FALSE
`a Group 1 chief executive with concurrence but no Minister's approval` MEANS `a chief executive` `a Group 1A board` TRUE FALSE TRUE FALSE FALSE
`a Group 1 chief executive appointed by someone other than the body` MEANS `a chief executive` `a Group 1A board` FALSE TRUE TRUE FALSE FALSE
`a Group 1 chief executive from before 1 April 2018 with no approval at all` MEANS `a chief executive` `a Group 1A board` FALSE FALSE FALSE TRUE FALSE
`a seconded Group 1 chief executive with no concurrence` MEANS `a chief executive` `a Group 1A board` TRUE TRUE FALSE FALSE TRUE
`a Group 2A chief executive with the Minister's approval` MEANS `a chief executive` `a Group 2A regulator` TRUE TRUE FALSE FALSE FALSE
`a Group 2A chief executive with no approval` MEANS `a chief executive` `a Group 2A regulator` TRUE FALSE FALSE FALSE FALSE
`a Group 2B chief executive with nothing` MEANS `a chief executive` `a Group 2B regulator` FALSE FALSE FALSE FALSE FALSE
`a Group 3 chief executive with the Minister's approval` MEANS `a chief executive` `a Group 3B community body` TRUE TRUE FALSE FALSE FALSE
`a Group 3 chief executive with nothing` MEANS `a chief executive` `a Group 3B community body` FALSE FALSE FALSE FALSE FALSE
`a chief executive of a Part 1 Second Schedule body that does not regulate a profession, with nothing` MEANS `a chief executive` `a Part 1 Second Schedule body that does not regulate a profession` FALSE FALSE FALSE FALSE FALSE

§ `Section 15 -- appointment`

#ASSERT `the appointment complies with section 15` `a Group 1 chief executive with every approval`

-- Group 1 needs the Minister's prior approval AND the Commission's prior concurrence AND
-- appointment by the body itself.
#ASSERT NOT `the appointment complies with section 15` `a Group 1 chief executive with the Minister's approval but no concurrence`
#ASSERT NOT `the appointment complies with section 15` `a Group 1 chief executive with concurrence but no Minister's approval`
#ASSERT NOT `the appointment complies with section 15` `a Group 1 chief executive appointed by someone other than the body`

-- s 15(3): a contravening appointment can be unwound by the Minister.
#ASSERT `the responsible Minister may direct the public body to remove the chief executive` `a Group 1 chief executive with the Minister's approval but no concurrence`
#ASSERT NOT `the responsible Minister may direct the public body to remove the chief executive` `a Group 1 chief executive with every approval`

-- Groups 2A and 3 need the Minister's approval only: the Commission's concurrence is a Group 1 rule.
#ASSERT `the appointment complies with section 15` `a Group 2A chief executive with the Minister's approval`
#ASSERT NOT `the appointment complies with section 15` `a Group 2A chief executive with no approval`
#ASSERT `the appointment complies with section 15` `a Group 3 chief executive with the Minister's approval`
#ASSERT NOT `the appointment complies with section 15` `a Group 3 chief executive with nothing`

-- GROUP 2B IS NOT NAMED. A Group 2B chief executive is subject to no rule in this Division.
#ASSERT NOT `sections 15 and 16 apply to the body` `a Group 2B regulator`
#ASSERT `the appointment complies with section 15` `a Group 2B chief executive with nothing`

-- A body that is in Part 1 of the Second Schedule but fails the main-function test is outside Part 3.
#ASSERT `the appointment complies with section 15` `a chief executive of a Part 1 Second Schedule body that does not regulate a profession, with nothing`

-- s 45(2): s 15 does not apply to a chief executive already in office on 1 April 2018.
#ASSERT NOT `section 15 governs this appointment` `a Group 1 chief executive from before 1 April 2018 with no approval at all`
#ASSERT `the appointment complies with section 15` `a Group 1 chief executive from before 1 April 2018 with no approval at all`

-- There is no secondment exception for appointment.
#ASSERT NOT `the appointment complies with section 15` `a seconded Group 1 chief executive with no concurrence`

§ `Section 16 -- removal`

GIVEN `the chief executive` IS A ChiefExecutiveFacts,
      `a resignation` IS A BOOLEAN,
      `follows a direction under section 15(3)` IS A BOOLEAN,
      `a dismissal the Commission concurred in under section 17` IS A BOOLEAN,
      `Minister approved` IS A BOOLEAN,
      `Commission concurred` IS A BOOLEAN
GIVETH A RemovalFacts
DECIDE `a removal` `the chief executive` `a resignation` `follows a direction under section 15(3)` `a dismissal the Commission concurred in under section 17` `Minister approved` `Commission concurred` IS
    RemovalFacts WITH
        `the chief executive` IS `the chief executive`
        `it is a resignation or the acceptance of one` IS `a resignation`
        `it follows a direction by the responsible Minister under section 15(3)` IS `follows a direction under section 15(3)`
        `it is a dismissal to which the Public Service Commission concurred under section 17` IS `a dismissal the Commission concurred in under section 17`
        `the responsible Minister gave prior approval` IS `Minister approved`
        `the Public Service Commission gave prior concurrence` IS `Commission concurred`

`removing a Group 1 chief executive with both` MEANS `a removal` `a Group 1 chief executive with every approval` FALSE FALSE FALSE TRUE TRUE
`removing a Group 1 chief executive with approval only` MEANS `a removal` `a Group 1 chief executive with every approval` FALSE FALSE FALSE TRUE FALSE
`removing a Group 1 chief executive with concurrence only` MEANS `a removal` `a Group 1 chief executive with every approval` FALSE FALSE FALSE FALSE TRUE
`dismissing a Group 1 chief executive for misconduct with the Commission's concurrence only` MEANS `a removal` `a Group 1 chief executive with every approval` FALSE FALSE TRUE FALSE TRUE
`a Group 1 chief executive resigning` MEANS `a removal` `a Group 1 chief executive with every approval` TRUE FALSE FALSE FALSE FALSE
`removing a Group 1 chief executive by the Minister's direction under section 15(3)` MEANS `a removal` `a Group 1 chief executive with every approval` FALSE TRUE FALSE FALSE FALSE
`removing a Group 1 chief executive who was in office on 1 April 2018, with nothing` MEANS `a removal` `a Group 1 chief executive from before 1 April 2018 with no approval at all` FALSE FALSE FALSE FALSE FALSE
`dismissing a Group 2A chief executive for misconduct with the Minister's approval` MEANS `a removal` `a Group 2A chief executive with the Minister's approval` FALSE FALSE FALSE TRUE FALSE
`dismissing a Group 2A chief executive for misconduct with no approval` MEANS `a removal` `a Group 2A chief executive with the Minister's approval` FALSE FALSE FALSE FALSE FALSE
`removing a Group 2A chief executive with a Commission concurrence under section 17` MEANS `a removal` `a Group 2A chief executive with the Minister's approval` FALSE FALSE TRUE FALSE TRUE
`removing a Group 2B chief executive with nothing` MEANS `a removal` `a Group 2B chief executive with nothing` FALSE FALSE FALSE FALSE FALSE

#ASSERT `the removal complies with section 16` `removing a Group 1 chief executive with both`
#ASSERT NOT `the removal complies with section 16` `removing a Group 1 chief executive with approval only`
#ASSERT NOT `the removal complies with section 16` `removing a Group 1 chief executive with concurrence only`

-- s 16(2)(b): a Group 1 dismissal the Commission concurred in under s 17 needs no separate Minister's approval.
#ASSERT `the removal complies with section 16` `dismissing a Group 1 chief executive for misconduct with the Commission's concurrence only`
#ASSERT `the removal complies with section 16` `a Group 1 chief executive resigning`
#ASSERT `the removal complies with section 16` `removing a Group 1 chief executive by the Minister's direction under section 15(3)`

-- s 45(3): s 16 applies to a chief executive in office on 1 April 2018, although s 15 does not.
#ASSERT NOT `the removal complies with section 16` `removing a Group 1 chief executive who was in office on 1 April 2018, with nothing`

-- A Group 2A dismissal for misconduct needs the Minister's approval: s 17 does not reach Group 2A, so the s 16(2)(b)
-- escape is a Group 1 escape.
#ASSERT `the removal complies with section 16` `dismissing a Group 2A chief executive for misconduct with the Minister's approval`
#ASSERT NOT `the removal complies with section 16` `dismissing a Group 2A chief executive for misconduct with no approval`
#ASSERT NOT `the removal complies with section 16` `removing a Group 2A chief executive with a Commission concurrence under section 17`

-- Group 2B is unconstrained.
#ASSERT `the removal complies with section 16` `removing a Group 2B chief executive with nothing`

§ `Section 17 -- disciplinary penalties`

GIVEN `the chief executive` IS A ChiefExecutiveFacts,
      `a penalty of the listed kind` IS A BOOLEAN,
      `because of misconduct` IS A BOOLEAN,
      `proceedings or misconduct before 1 April 2018` IS A BOOLEAN,
      `Commission concurred` IS A BOOLEAN
GIVETH A PenaltyFacts
DECIDE `a penalty` `the chief executive` `a penalty of the listed kind` `because of misconduct` `proceedings or misconduct before 1 April 2018` `Commission concurred` IS
    PenaltyFacts WITH
        `the chief executive` IS `the chief executive`
        `it is a dismissal, reduction in grade, financial penalty, stoppage of increment or withdrawal of an employment benefit` IS `a penalty of the listed kind`
        `it is because of misconduct` IS `because of misconduct`
        `the disciplinary proceedings started before 1 April 2018, or concern misconduct before that date` IS `proceedings or misconduct before 1 April 2018`
        `the Public Service Commission gave prior concurrence` IS `Commission concurred`

`a Group 1 dismissal for misconduct without concurrence` MEANS `a penalty` `a Group 1 chief executive with every approval` TRUE TRUE FALSE FALSE
`a Group 1 dismissal for misconduct with concurrence` MEANS `a penalty` `a Group 1 chief executive with every approval` TRUE TRUE FALSE TRUE
`a Group 1 reduction in grade, not because of misconduct` MEANS `a penalty` `a Group 1 chief executive with every approval` TRUE FALSE FALSE FALSE
`a Group 1 financial penalty for misconduct without concurrence` MEANS `a penalty` `a Group 1 chief executive with every approval` TRUE TRUE FALSE FALSE
`a Group 1 reprimand for misconduct` MEANS `a penalty` `a Group 1 chief executive with every approval` FALSE TRUE FALSE FALSE
`a Group 2A dismissal for misconduct` MEANS `a penalty` `a Group 2A chief executive with the Minister's approval` TRUE TRUE FALSE FALSE
`a Group 1 dismissal of a seconded chief executive for misconduct` MEANS `a penalty` `a seconded Group 1 chief executive with no concurrence` TRUE TRUE FALSE FALSE
`a Group 1 dismissal for misconduct begun before 1 April 2018` MEANS `a penalty` `a Group 1 chief executive with every approval` TRUE TRUE TRUE FALSE

#ASSERT `this is a disciplinary penalty within section 13` `a Group 1 dismissal for misconduct without concurrence`
#ASSERT `section 17 requires the Public Service Commission's concurrence` `a Group 1 dismissal for misconduct without concurrence`
#ASSERT NOT `the penalty complies with section 17` `a Group 1 dismissal for misconduct without concurrence`
#ASSERT `the penalty complies with section 17` `a Group 1 dismissal for misconduct with concurrence`
#ASSERT `section 17 requires the Public Service Commission's concurrence` `a Group 1 financial penalty for misconduct without concurrence`
#ASSERT NOT `the penalty complies with section 17` `a Group 1 financial penalty for misconduct without concurrence`

-- "Because of misconduct" is part of the definition: a reduction in grade for another reason is not a
-- disciplinary penalty, and a reprimand is not on the list.
#ASSERT NOT `this is a disciplinary penalty within section 13` `a Group 1 reduction in grade, not because of misconduct`
#ASSERT `the penalty complies with section 17` `a Group 1 reduction in grade, not because of misconduct`
#ASSERT NOT `this is a disciplinary penalty within section 13` `a Group 1 reprimand for misconduct`

-- Only Group 1. s 17(2): not a seconded public officer. s 45(4): not proceedings begun before 1 April 2018.
#ASSERT NOT `section 17 requires the Public Service Commission's concurrence` `a Group 2A dismissal for misconduct`
#ASSERT NOT `section 17 requires the Public Service Commission's concurrence` `a Group 1 dismissal of a seconded chief executive for misconduct`
#ASSERT NOT `section 17 requires the Public Service Commission's concurrence` `a Group 1 dismissal for misconduct begun before 1 April 2018`
#ASSERT `the penalty complies with section 17` `a Group 1 dismissal for misconduct begun before 1 April 2018`

§ `Section 18 -- promotion`

GIVEN `the chief executive` IS A ChiefExecutiveFacts, `Commission concurred` IS A BOOLEAN
GIVETH A PromotionFacts
DECIDE `a promotion` `the chief executive` `Commission concurred` IS
    PromotionFacts WITH
        `the chief executive` IS `the chief executive`
        `the Public Service Commission gave prior concurrence` IS `Commission concurred`

`promoting a Group 1 chief executive without concurrence` MEANS `a promotion` `a Group 1 chief executive with every approval` FALSE
`promoting a Group 1 chief executive with concurrence` MEANS `a promotion` `a Group 1 chief executive with every approval` TRUE
`promoting a seconded Group 1 chief executive without concurrence` MEANS `a promotion` `a seconded Group 1 chief executive with no concurrence` FALSE
`promoting a Group 2A chief executive without concurrence` MEANS `a promotion` `a Group 2A chief executive with the Minister's approval` FALSE

#ASSERT NOT `the promotion complies with section 18` `promoting a Group 1 chief executive without concurrence`
#ASSERT `the responsible Minister may direct the body to rectify the promotion` `promoting a Group 1 chief executive without concurrence`
#ASSERT `the promotion complies with section 18` `promoting a Group 1 chief executive with concurrence`
#ASSERT `the promotion complies with section 18` `promoting a seconded Group 1 chief executive without concurrence`
#ASSERT `the promotion complies with section 18` `promoting a Group 2A chief executive without concurrence`
#ASSERT NOT `the responsible Minister may direct the body to rectify the promotion` `promoting a Group 1 chief executive with concurrence`

-- The seconded public officer: outside ss 17 and 18, inside ss 15 and 16.
#ASSERT NOT `the appointment complies with section 15` `a seconded Group 1 chief executive with no concurrence`
#ASSERT `the promotion complies with section 18` `promoting a seconded Group 1 chief executive without concurrence`

-- s 19: the Constitution's requirements are saved, not relieved.
#ASSERT NOT `this Division relieves a requirement for the President's concurrence under the Constitution`

§ `Sections 20 and 21 -- deemed public servants and public officers`

GIVEN `the body` IS A BodyFacts, `formed the committee` IS A BOOLEAN
GIVETH A CommitteeBodyFacts
DECIDE `a committee setting` `the body` `formed the committee` IS
    CommitteeBodyFacts WITH
        `the body` IS `the body`
        `the committee was formed by the body` IS `formed the committee`

#ASSERT `the individual is deemed a public servant under section 20` `the chairperson` (`a committee setting` `a Group 1A board` FALSE)
#ASSERT `the individual is deemed a public servant under section 20` `a member` (`a committee setting` `a Group 2A regulator` FALSE)
#ASSERT `the individual is deemed a public servant under section 20` `the chief executive` (`a committee setting` `a Group 3B community body` FALSE)
#ASSERT `the individual is deemed a public servant under section 20` `an officer` (`a committee setting` `DSTA, the only Group 1B body` FALSE)
#ASSERT `the individual is deemed a public servant under section 20` `an officer` (`a committee setting` `the People's Association, the only Group 1C body` FALSE)
#ASSERT NOT `the individual is deemed a public servant under section 20` `a contractor to the public body` (`a committee setting` `a Group 1A board` FALSE)
#ASSERT NOT `the individual is deemed a public servant under section 20` `an officer` (`a committee setting` `a public body in no Schedule` FALSE)

-- s 20(2): a committee member is deemed a public servant where the committee was formed by a
-- Group 1A, 1B, 2 or 3 body and delegated a function.
#ASSERT `the individual is deemed a public servant under section 20` `a member of a committee delegated a function of the public body` (`a committee setting` `a Group 1A board` TRUE)
#ASSERT `the individual is deemed a public servant under section 20` `a member of a committee delegated a function of the public body` (`a committee setting` `DSTA, the only Group 1B body` TRUE)
#ASSERT `the individual is deemed a public servant under section 20` `a member of a committee delegated a function of the public body` (`a committee setting` `a Group 2A regulator` TRUE)
#ASSERT `the individual is deemed a public servant under section 20` `a member of a committee delegated a function of the public body` (`a committee setting` `a Group 3B community body` TRUE)

-- THE GROUP 1C GAP. A committee of the People's Association is not named in s 20(2), so its members are not deemed
-- public servants for the Penal Code, although s 21(1) makes them public officers for the Financial Procedure Act.
#ASSERT NOT `the individual is deemed a public servant under section 20` `a member of a committee delegated a function of the public body` (`a committee setting` `the People's Association, the only Group 1C body` TRUE)
#ASSERT `the individual is taken to be a public officer under section 21(1)` `a member of a committee delegated a function of the public body` (`a committee setting` `the People's Association, the only Group 1C body` TRUE)

-- An advisory committee is outside both; a committee not formed by the body is outside both.
#ASSERT NOT `the individual is deemed a public servant under section 20` `a member of a committee that only advises the public body` (`a committee setting` `a Group 1A board` TRUE)
#ASSERT NOT `the individual is taken to be a public officer under section 21(1)` `a member of a committee that only advises the public body` (`a committee setting` `the People's Association, the only Group 1C body` TRUE)
#ASSERT NOT `the individual is deemed a public servant under section 20` `a member of a committee delegated a function of the public body` (`a committee setting` `a Group 1A board` FALSE)

-- s 21(1) takes in everyone in s 20.
#ASSERT `the individual is taken to be a public officer under section 21(1)` `the chairperson` (`a committee setting` `a Group 1A board` FALSE)
#ASSERT NOT `the individual is taken to be a public officer under section 21(1)` `a contractor to the public body` (`a committee setting` `a Group 1A board` FALSE)

#ASSERT `the deeming in section 21(1) reaches this function` `administering, assessing, collecting or enforcing payment of a sum collected as agent of the Government or payable into a Government Fund`
#ASSERT `the deeming in section 21(1) reaches this function` `disbursing financial assistance or other benefits on behalf of the Government from a Government Fund`
#ASSERT `the deeming in section 21(1) reaches this function` `administering and managing a contract entered into or managed on behalf of the Government`
#ASSERT NOT `the deeming in section 21(1) reaches this function` `any other function`

§ `Section 23(1) to (3) -- when a member is interested`

GIVEN `a relevant matter` IS A BOOLEAN, `remote or insignificant` IS A BOOLEAN, `the grounds` IS A LIST OF InterestGround
GIVETH A MemberInterest
DECIDE `an interest of the member` `a relevant matter` `remote or insignificant` `the grounds` IS
    MemberInterest WITH
        `the matter is a relevant matter of the public body` IS `a relevant matter`
        `the grounds of interest, whether the member's or an associate's` IS `the grounds`
        `the interest is so remote or insignificant that it cannot reasonably be regarded as likely to influence the member` IS `remote or insignificant`

`a financial benefit` MEANS `an interest of the member` TRUE FALSE (LIST `a direct or indirect financial benefit from the relevant matter`)
`a financial interest in a counterparty` MEANS `an interest of the member` TRUE FALSE (LIST `a direct or indirect financial interest in a person to whom the relevant matter relates`)
`some other interest` MEANS `an interest of the member` TRUE FALSE (LIST `some other direct or indirect interest in the matter`)
`only an interest in members' remuneration` MEANS `an interest of the member` TRUE FALSE (LIST `an interest in the level of remuneration, allowances or expenses for members`)
`only an interest shared with the public` MEANS `an interest of the member` TRUE FALSE (LIST `an interest shared in common with the general public or a substantial section of it`)
`only charitable-body fees` MEANS `an interest of the member` TRUE FALSE (LIST `payment or reimbursement of fees or expenses of a body with predominantly charitable objects`)
`only past or current involvement in the sector` MEANS `an interest of the member` TRUE FALSE (LIST `past or current involvement in the relevant sector, industry or practice`)
`only being a customer` MEANS `an interest of the member` TRUE FALSE (LIST `being a customer of the public body's services or goods supplied to the public`)
`only directing a wholly-owned subsidiary the matter is for` MEANS `an interest of the member` TRUE FALSE (LIST `being a director or chief executive officer of a wholly-owned subsidiary of the body, where the matter is for that subsidiary`)
`only representing the Government on the matter` MEANS `an interest of the member` TRUE FALSE (LIST `being appointed to represent the Government, a public office or a community group, where the matter is for that body`)
`an excepted ground and a financial benefit` MEANS `an interest of the member` TRUE FALSE (LIST `being a customer of the public body's services or goods supplied to the public`, `a direct or indirect financial benefit from the relevant matter`)
`a financial benefit that is remote and insignificant` MEANS `an interest of the member` TRUE TRUE (LIST `a direct or indirect financial benefit from the relevant matter`)
`a financial benefit from something that is not a relevant matter` MEANS `an interest of the member` FALSE FALSE (LIST `a direct or indirect financial benefit from the relevant matter`)
`no grounds at all` MEANS `an interest of the member` TRUE FALSE EMPTY

#ASSERT `the member is interested in the relevant matter` `a financial benefit`
#ASSERT `the member is interested in the relevant matter` `a financial interest in a counterparty`
#ASSERT `the member is interested in the relevant matter` `some other interest`

-- Each of the seven "only because" exceptions takes away its own ground.
#ASSERT NOT `the member is interested in the relevant matter` `only an interest in members' remuneration`
#ASSERT NOT `the member is interested in the relevant matter` `only an interest shared with the public`
#ASSERT NOT `the member is interested in the relevant matter` `only charitable-body fees`
#ASSERT NOT `the member is interested in the relevant matter` `only past or current involvement in the sector`
#ASSERT NOT `the member is interested in the relevant matter` `only being a customer`
#ASSERT NOT `the member is interested in the relevant matter` `only directing a wholly-owned subsidiary the matter is for`
#ASSERT NOT `the member is interested in the relevant matter` `only representing the Government on the matter`

-- But an excepted ground beside a surviving one saves nothing.
#ASSERT `the member is interested in the relevant matter` `an excepted ground and a financial benefit`

-- (h) takes the interest away altogether.
#ASSERT NOT `the member is interested in the relevant matter` `a financial benefit that is remote and insignificant`
#ASSERT NOT `the member is interested in the relevant matter` `a financial benefit from something that is not a relevant matter`
#ASSERT NOT `the member is interested in the relevant matter` `no grounds at all`

§ `Section 23(4) -- associates`

#ASSERT `the two are associates` (LIST `spouses, siblings, parent and child, or a similar close family relationship`)
#ASSERT `the two are associates` (LIST `in partnership`)
#ASSERT `the two are associates` (LIST `a company and a director or manager of it`)
#ASSERT `the two are associates` (LIST `a private company and a shareholder in it`)

-- (d) is confined to a PRIVATE company. A shareholder of a public company is not caught.
#ASSERT NOT `the two are associates` (LIST `a public company and a shareholder in it`)
#ASSERT NOT `the two are associates` (LIST `no relationship`)
#ASSERT NOT `the two are associates` EMPTY

-- (e): a chain of any length through any of the four, so long as every link is recognised.
#ASSERT `the two are associates` (LIST `spouses, siblings, parent and child, or a similar close family relationship`, `in partnership`, `a company and a director or manager of it`)
#ASSERT `the two are associates` (LIST `spouses, siblings, parent and child, or a similar close family relationship`, `in partnership`, `a company and a director or manager of it`, `spouses, siblings, parent and child, or a similar close family relationship`, `a private company and a shareholder in it`)
#ASSERT NOT `the two are associates` (LIST `spouses, siblings, parent and child, or a similar close family relationship`, `in partnership`, `a public company and a shareholder in it`, `spouses, siblings, parent and child, or a similar close family relationship`)

-- A member with one share in a private company: the company is an associate, the company's
-- benefit is the associate's benefit, and the member is interested unless (h) removes it.
#ASSERT `every link in the chain is recognised` (LIST `a private company and a shareholder in it`)

§ `Section 23(5) -- a wholly-owned subsidiary corporation of a public body`

GIVEN `who` IS AN Occupant, `its members` IS A LIST OF Occupant
GIVETH A Member
DECIDE `a member of the corporation` `who` `its members` IS
    Member WITH
        `who it is` IS `who`
        `the members of the subsidiary concerned` IS `its members`

`the public body as the member` MEANS `a member of the corporation` `the public body itself` EMPTY
`the public body's nominee as the member` MEANS `a member of the corporation` `a nominee of the public body` EMPTY
`an outsider as the member` MEANS `a member of the corporation` `any other person` EMPTY
`a subsidiary whose members are the body and its nominee` MEANS `a member of the corporation` `a subsidiary of the public body` (LIST `the public body itself`, `a nominee of the public body`)
`a subsidiary with an outsider among its members` MEANS `a member of the corporation` `a subsidiary of the public body` (LIST `the public body itself`, `any other person`)
`a subsidiary that is itself held by another subsidiary` MEANS `a member of the corporation` `a subsidiary of the public body` (LIST `a subsidiary of the public body`)

#ASSERT `the corporation is a wholly-owned subsidiary corporation of the public body` (LIST `the public body as the member`)
#ASSERT `the corporation is a wholly-owned subsidiary corporation of the public body` (LIST `the public body as the member`, `the public body's nominee as the member`)
#ASSERT `the corporation is a wholly-owned subsidiary corporation of the public body` (LIST `a subsidiary whose members are the body and its nominee`)
#ASSERT NOT `the corporation is a wholly-owned subsidiary corporation of the public body` (LIST `the public body as the member`, `an outsider as the member`)
#ASSERT NOT `the corporation is a wholly-owned subsidiary corporation of the public body` (LIST `a subsidiary with an outsider among its members`)

-- THE SAME DEFECT AS COMPANIES ACT s 5B. In public body -> S2 -> S1 -> C, C's only member is S1, whose only
-- member is S2. S1 fails limb (c), so C is not a wholly-owned subsidiary corporation, and a director of C is
-- outside the s 23(3)(f) exception.
#ASSERT NOT `the corporation is a wholly-owned subsidiary corporation of the public body` (LIST `a subsidiary that is itself held by another subsidiary`)

§ `Sections 24 and 25 -- disclosure`

GIVEN `a general notice was disclosed` IS A BOOLEAN,
      `the nature has materially altered` IS A BOOLEAN,
      `the extent has materially increased` IS A BOOLEAN,
      `the extent has decreased` IS A BOOLEAN
GIVETH A StandingDisclosure
DECIDE `a standing disclosure` `a general notice was disclosed` `the nature has materially altered` `the extent has materially increased` `the extent has decreased` IS
    StandingDisclosure WITH
        `a general notice was disclosed in accordance with section 25` IS `a general notice was disclosed`
        `the nature of the interest has materially altered` IS `the nature has materially altered`
        `the extent of the interest has materially increased` IS `the extent has materially increased`
        `the extent of the interest has decreased` IS `the extent has decreased`

#ASSERT `the standing disclosure is still effective` (`a standing disclosure` TRUE FALSE FALSE FALSE)
#ASSERT NOT `the standing disclosure is still effective` (`a standing disclosure` TRUE TRUE FALSE FALSE)
#ASSERT NOT `the standing disclosure is still effective` (`a standing disclosure` TRUE FALSE TRUE FALSE)

-- A decrease in the extent does not end it.
#ASSERT `the standing disclosure is still effective` (`a standing disclosure` TRUE FALSE FALSE TRUE)
#ASSERT NOT `the standing disclosure is still effective` (`a standing disclosure` FALSE FALSE FALSE FALSE)

GIVEN `there is a chairperson` IS A BOOLEAN,
      `the chairperson is interested` IS A BOOLEAN,
      `there is a deputy chairperson` IS A BOOLEAN,
      `every deputy chairperson is interested` IS A BOOLEAN
GIVETH A Board
DECIDE `a board` `there is a chairperson` `the chairperson is interested` `there is a deputy chairperson` `every deputy chairperson is interested` IS
    Board WITH
        `there is a chairperson` IS `there is a chairperson`
        `the chairperson is interested` IS `the chairperson is interested`
        `there is a deputy chairperson` IS `there is a deputy chairperson`
        `every deputy chairperson is interested` IS `every deputy chairperson is interested`

`a board with a free chairperson and a deputy` MEANS `a board` TRUE FALSE TRUE FALSE
`a board whose chairperson is interested and has a free deputy` MEANS `a board` TRUE TRUE TRUE FALSE
`a board whose chairperson and every deputy are interested` MEANS `a board` TRUE TRUE TRUE TRUE
`a board whose chairperson is interested and has no deputy` MEANS `a board` TRUE TRUE FALSE FALSE
`a board with no chairperson and an interested deputy` MEANS `a board` FALSE FALSE TRUE TRUE
`a board with no chairperson and a free deputy` MEANS `a board` FALSE FALSE TRUE FALSE
`a board with neither a chairperson nor a deputy` MEANS `a board` FALSE FALSE FALSE FALSE

#ASSERT `an ordinary member must disclose to the chairperson` `a board with a free chairperson and a deputy`
#ASSERT NOT `an ordinary member must disclose to a deputy chairperson` `a board with a free chairperson and a deputy`
#ASSERT NOT `an ordinary member must disclose to the responsible Minister` `a board with a free chairperson and a deputy`

#ASSERT `an ordinary member must disclose to a deputy chairperson` `a board whose chairperson is interested and has a free deputy`
#ASSERT NOT `an ordinary member must disclose to the responsible Minister` `a board whose chairperson is interested and has a free deputy`

-- THE OVERLAP. Where the chairperson AND every deputy are interested, (ii) still says to disclose
-- to a deputy and (iii) says to the Minister. Both apply.
#ASSERT `an ordinary member must disclose to a deputy chairperson` `a board whose chairperson and every deputy are interested`
#ASSERT `an ordinary member must disclose to the responsible Minister` `a board whose chairperson and every deputy are interested`

#ASSERT `an ordinary member must disclose to the responsible Minister` `a board whose chairperson is interested and has no deputy`
#ASSERT NOT `an ordinary member must disclose to a deputy chairperson` `a board whose chairperson is interested and has no deputy`

-- THE GAP. With no chairperson and an interested deputy, (ii) applies and (iii) does not: the
-- disclosure is routed to an interested deputy.
#ASSERT `an ordinary member must disclose to a deputy chairperson` `a board with no chairperson and an interested deputy`
#ASSERT NOT `an ordinary member must disclose to the responsible Minister` `a board with no chairperson and an interested deputy`
#ASSERT `an ordinary member must disclose to a deputy chairperson` `a board with no chairperson and a free deputy`
#ASSERT `an ordinary member must disclose to the responsible Minister` `a board with neither a chairperson nor a deputy`
#ASSERT NOT `an ordinary member must disclose to a deputy chairperson` `a board with neither a chairperson nor a deputy`

#ASSERT `the chairperson must disclose to the chief executive and all other members, and to the responsible Minister`

#ASSERT `the chief executive has done what section 25(3) requires` (ChiefExecutiveDuty WITH `the disclosure is recorded in the register of interests` IS TRUE, `it was brought to the attention of the member presiding at the meeting` IS TRUE)
#ASSERT NOT `the chief executive has done what section 25(3) requires` (ChiefExecutiveDuty WITH `the disclosure is recorded in the register of interests` IS TRUE, `it was brought to the attention of the member presiding at the meeting` IS FALSE)
#ASSERT NOT `the chief executive has done what section 25(3) requires` (ChiefExecutiveDuty WITH `the disclosure is recorded in the register of interests` IS FALSE, `it was brought to the attention of the member presiding at the meeting` IS TRUE)

GIVEN `the nature is stated` IS A BOOLEAN, `can be quantified` IS A BOOLEAN, `the value is stated` IS A BOOLEAN, `the extent is stated` IS A BOOLEAN
GIVETH A DisclosureContent
DECIDE `a disclosure content` `the nature is stated` `can be quantified` `the value is stated` `the extent is stated` IS
    DisclosureContent WITH
        `the nature of the interest is stated` IS `the nature is stated`
        `the monetary value can be quantified` IS `can be quantified`
        `the monetary value is stated` IS `the value is stated`
        `the extent of the interest is stated` IS `the extent is stated`

#ASSERT `the details disclosed meet section 25(2)` (`a disclosure content` TRUE TRUE TRUE FALSE)
#ASSERT NOT `the details disclosed meet section 25(2)` (`a disclosure content` TRUE TRUE FALSE TRUE)
#ASSERT `the details disclosed meet section 25(2)` (`a disclosure content` TRUE FALSE FALSE TRUE)
#ASSERT NOT `the details disclosed meet section 25(2)` (`a disclosure content` TRUE FALSE TRUE FALSE)
#ASSERT NOT `the details disclosed meet section 25(2)` (`a disclosure content` FALSE TRUE TRUE TRUE)

§ `Sections 26 and 27 -- consequences, and the absence of any`

-- Seven present, two interested, quorum five.
#ASSERT `the members counted towards the quorum for that part of the meeting` 7 2 5 EQUALS 5
#ASSERT `the body can decide the matter at this meeting` 7 2 5
#ASSERT NOT `the body can decide the matter at this meeting` 7 3 5
#ASSERT `the body can decide the matter at this meeting` 5 0 5

-- THE DEADLOCK. With the quorum exactly met, one interested member stops the body deciding the matter,
-- and the Act gives nobody a way round.
#ASSERT NOT `the body can decide the matter at this meeting` 5 1 5

-- The withdrawal duty is triggered by the presiding member's request.
#ASSERT `the interested member must withdraw` TRUE
#ASSERT NOT `the interested member must withdraw` FALSE

#ASSERT `the public body must notify the responsible Minister` (Breach WITH `a member failed to comply with section 25 or 26` IS TRUE, `the public body has become aware of the failure` IS TRUE)
#ASSERT NOT `the public body must notify the responsible Minister` (Breach WITH `a member failed to comply with section 25 or 26` IS TRUE, `the public body has become aware of the failure` IS FALSE)
#ASSERT NOT `the public body must notify the responsible Minister` (Breach WITH `a member failed to comply with section 25 or 26` IS FALSE, `the public body has become aware of the failure` IS TRUE)

-- THE REGIME HAS NO SANCTION: no offence, and the decision stands.
#ASSERT NOT `the public body's decision is affected merely by the breach` (Breach WITH `a member failed to comply with section 25 or 26` IS TRUE, `the public body has become aware of the failure` IS TRUE)
#ASSERT NOT `this Act makes a failure to disclose an interest an offence`

§ `Section 28 -- committees`

#ASSERT `the individual may be appointed to the committee` (CommitteeAppointment WITH `the committee is one the constitutional Act allows the public body to appoint` IS TRUE, `the individual disclosed their interests to the public body before appointment` IS TRUE)
#ASSERT NOT `the individual may be appointed to the committee` (CommitteeAppointment WITH `the committee is one the constitutional Act allows the public body to appoint` IS TRUE, `the individual disclosed their interests to the public body before appointment` IS FALSE)
#ASSERT NOT `the individual may be appointed to the committee` (CommitteeAppointment WITH `the committee is one the constitutional Act allows the public body to appoint` IS FALSE, `the individual disclosed their interests to the public body before appointment` IS TRUE)
#ASSERT NOT `a committee member's disclosure of an interest in a matter the committee regulates goes to the responsible Minister`

§ `Sections 30, 31, 32 -- how a public body decides`

#ASSERT `a meeting may be held by electronic means` (RemoteMeeting WITH `the public body resolved that the meeting or all its meetings may be held by such means` IS TRUE, `all of the members who wish to participate have access to the technology` IS TRUE, `a quorum of members can simultaneously communicate throughout` IS TRUE)
#ASSERT NOT `a meeting may be held by electronic means` (RemoteMeeting WITH `the public body resolved that the meeting or all its meetings may be held by such means` IS FALSE, `all of the members who wish to participate have access to the technology` IS TRUE, `a quorum of members can simultaneously communicate throughout` IS TRUE)
#ASSERT NOT `a meeting may be held by electronic means` (RemoteMeeting WITH `the public body resolved that the meeting or all its meetings may be held by such means` IS TRUE, `all of the members who wish to participate have access to the technology` IS FALSE, `a quorum of members can simultaneously communicate throughout` IS TRUE)
#ASSERT NOT `a meeting may be held by electronic means` (RemoteMeeting WITH `the public body resolved that the meeting or all its meetings may be held by such means` IS TRUE, `all of the members who wish to participate have access to the technology` IS TRUE, `a quorum of members can simultaneously communicate throughout` IS FALSE)

GIVEN `resolved that section 31 applies` IS A BOOLEAN,
      `all members were sent the document` IS A BOOLEAN,
      `entitled to vote` IS A NUMBER,
      `signed in favour` IS A NUMBER
GIVETH A CircularResolution
DECIDE `a circular resolution` `resolved that section 31 applies` `all members were sent the document` `entitled to vote` `signed in favour` IS
    CircularResolution WITH
        `the public body resolved that section 31 applies to the matter` IS `resolved that section 31 applies`
        `all of the members for the time being were sent the document` IS `all members were sent the document`
        `the number of members entitled to vote on the matter` IS `entitled to vote`
        `the number of those who signed or approved in writing that they are in favour` IS `signed in favour`

#ASSERT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 7 4)
#ASSERT `a majority of those entitled to vote have signed` (`a circular resolution` TRUE TRUE 7 4)

-- A MAJORITY is more than half: exactly half is not enough.
#ASSERT NOT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 8 4)
#ASSERT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 8 5)
#ASSERT NOT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 7 3)

-- A body of two entitled members: one signature is not a majority, two are.
#ASSERT NOT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 2 1)
#ASSERT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 2 2)

-- With an interested member outside the denominator: of 7 members, 2 interested, 5 entitled; 3 sign.
#ASSERT `the resolution is taken to be passed` (`a circular resolution` TRUE TRUE 5 3)

-- The body must have resolved that s 31 applies, and all members must have been sent the document.
#ASSERT NOT `the resolution is taken to be passed` (`a circular resolution` FALSE TRUE 7 7)
#ASSERT NOT `the resolution is taken to be passed` (`a circular resolution` TRUE FALSE 7 7)

#ASSERT `the delegate may delegate further` TRUE
#ASSERT NOT `the delegate may delegate further` FALSE
#ASSERT NOT `a delegation stops the public body performing the function itself`
#ASSERT NOT `a change of membership or chief executive ends a delegation`
