IMPORT `hvac-act`
IMPORT daydate
-- בדיקות סינתטיות של גבולות, חריגים ומידע חסר; אין אלה דוגמאות מהמחוקק.

-- T001: סף תפוקה Grade1 / 18
#ASSERT (`capacity is within grade` Grade1 (18)) EQUALS TRUE

-- T002: סף תפוקה Grade1 / 18.01
#ASSERT (`capacity is within grade` Grade1 (18.01)) EQUALS FALSE

-- T003: סף תפוקה Grade2 / 70
#ASSERT (`capacity is within grade` Grade2 (70)) EQUALS TRUE

-- T004: סף תפוקה Grade2 / 70.01
#ASSERT (`capacity is within grade` Grade2 (70.01)) EQUALS FALSE

-- T005: סף תפוקה Grade3 / 100000
#ASSERT (`capacity is within grade` Grade3 (100000)) EQUALS TRUE

-- T006: סף תפוקה Grade1 / -1
#ASSERT (`capacity is within grade` Grade1 (-1)) EQUALS FALSE

-- T007: תחילה כללית
#ASSERT `verified general commencement` EQUALS (YMD 2025 7 16)

-- T008: תחילת שאר הקררים
#ASSERT (`other refrigerants commencement` `verified general commencement`) EQUALS (YMD 2027 1 16)

-- T009: תחולה לפי קרר ותאריך 2025 7 15Established
#ASSERT (`work provisions have commenced` (YMD 2025 7 15) `verified general commencement` Established) EQUALS Rejected

-- T010: תחולה לפי קרר ותאריך 2025 7 16Established
#ASSERT (`work provisions have commenced` (YMD 2025 7 16) `verified general commencement` Established) EQUALS Established

-- T011: תחולה לפי קרר ותאריך 2026 9 22Rejected
#ASSERT (`work provisions have commenced` (YMD 2026 9 22) `verified general commencement` Rejected) EQUALS Rejected

-- T012: תחולה לפי קרר ותאריך 2026 9 22Unresolved
#ASSERT (`work provisions have commenced` (YMD 2026 9 22) `verified general commencement` Unresolved) EQUALS Unresolved

-- T013: תחולה לפי קרר ותאריך 2027 1 16Rejected
#ASSERT (`work provisions have commenced` (YMD 2027 1 16) `verified general commencement` Rejected) EQUALS Established

-- T014: פרק עיצומים אינו בתוקף לפני 18 חודשים
#ASSERT (`enforcement chapter has commenced` (YMD 2026 9 22) `verified general commencement` NOTHING) EQUALS Rejected

-- T015: תאריך תקנות הפחתה חסר אינו אישור אכיפה
#ASSERT (`enforcement chapter has commenced` (YMD 2027 1 16) `verified general commencement` NOTHING) EQUALS Unresolved

-- T016: תקנות הפחתה מאוחרות דוחות תחילה
#ASSERT (`enforcement chapter has commenced` (YMD 2027 1 16) `verified general commencement` (JUST (YMD 2027 3 1))) EQUALS Rejected

-- T017: תחילת פרק לאחר ששני התנאים התמלאו
#ASSERT (`enforcement chapter has commenced` (YMD 2027 3 1) `verified general commencement` (JUST (YMD 2027 3 1))) EQUALS Established

-- T018: קרר מוכר
#ASSERT `refrigerant appears in schedule four` "32"

-- T019: קרר אחר אינו ברשימה
#ASSERT NOT (`refrigerant appears in schedule four` "134a")

-- T020: פרט תחזוקה ייחודי דורש דרגה 3
#ASSERT NOT (`grade covers classified work` Grade2 Grade3Maintain03)

-- T021: דרגה 3 מכסה את הפרט הייחודי
#ASSERT `grade covers classified work` Grade3 Grade3Maintain03

-- T022: חוסר סיווג אינו פעולה מורשית
#ASSERT NOT (`grade covers classified work` Grade3 UnclassifiedWork)

-- T023: עבודה תקינה
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 (JUST Grade1) Established Established Established Rejected Established)) EQUALS Satisfied

-- T024: תפוקה מעבר לסף
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18.01 (JUST Grade1) Established Established Established Rejected Established)) EQUALS NotSatisfied

-- T025: רישיון חסר
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 NOTHING Established Established Established Rejected Established)) EQUALS NotSatisfied

-- T026: רישיון לא בתוקף
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 (JUST Grade1) Rejected Established Established Rejected Established)) EQUALS NotSatisfied

-- T027: מצב רישיון חסר
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 (JUST Grade1) Unresolved Established Established Rejected Established)) EQUALS NeedsReview

-- T028: צו פטור לא נבדק
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 (JUST Grade1) Established Established Established Unresolved Established)) EQUALS NeedsReview

-- T029: פטור תקף בתנאים עם העדר רישיון
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 NOTHING Established Established Established Established Established)) EQUALS Satisfied

-- T030: תנאי פטור לא מולאו
#ASSERT (`assess work under section three` (WorkCase Established Established Install01 18 NOTHING Established Established Established Established Rejected)) EQUALS NotSatisfied

-- T031: טרם תחילת החוק
#ASSERT (`assess work under section three` (WorkCase Rejected Established Install01 18 NOTHING Established Established Established Rejected Established)) EQUALS NotApplicable

-- T032: פעולה מחוץ לתוספת
#ASSERT (`assess work under section three` (WorkCase Established Established OutsideSchedule 18 NOTHING Established Established Established Rejected Established)) EQUALS NotApplicable

-- T033: פעולה לא מסווגת
#ASSERT (`assess work under section three` (WorkCase Established Established UnclassifiedWork 18 (JUST Grade1) Established Established Established Rejected Established)) EQUALS NeedsReview

-- T034: שלילה גוברת על אי-ידיעה בצירוף תנאים
#ASSERT (`both findings` Rejected Unresolved) EQUALS Rejected

-- T035: אי-ידיעה אינה חיוב
#ASSERT (`both findings` Established Unresolved) EQUALS Unresolved

-- T036: חידוש אינו מחייב שוב תנאי הכשרה
#ASSERT (`renewal section six conditions` Established Established Established) EQUALS Established

-- T037: מתן רישיון חדש דורש תנאי הכשרה
#ASSERT (`ordinary licensing conditions` Established Established Established Rejected) EQUALS Rejected

-- T038: הכרעה פלילית לא ידועה מחייבת בדיקה
#ASSERT (`ordinary licensing conditions` Established Established Unresolved Established) EQUALS Unresolved

-- T039: שנת תחילה בחלון ניסיון
#ASSERT `experience transition is open` (YMD 2025 7 16) `verified general commencement`

-- T040: תום חלון שלוש שנים לפי מוסכמת המודל
#ASSERT NOT (`experience transition is open` (YMD 2028 7 16) `verified general commencement`)

-- T041: א1 הכשרה עד 350 ולא לפחות 350
#ASSERT (`route maximum training hours` A1Training) EQUALS (JUST 350)

-- T042: ג4 השלמה עד 240 לפי הפרסום הרשמי
#ASSERT (`route maximum training hours` C4) EQUALS (JUST 240)

-- T043: הנדסאי עם תוכנית משולבת בלי דרישה נוספת
#ASSERT (`route maximum training hours` C2) EQUALS NOTHING

-- T044: מומחה זר ניסיון בתוך שש שנים
#ASSERT (`foreign expert power conditions` TRUE TRUE TRUE TRUE Established) EQUALS Established

-- T045: מומחה זר ללא הכרת הרשם
#ASSERT (`foreign expert power conditions` TRUE TRUE TRUE TRUE Unresolved) EQUALS Unresolved

-- T046: חידוש זמני שני מותר
#ASSERT `temporary licence period allowed` (YMD 2026 1 1) (YMD 2027 1 1) 1 TRUE

-- T047: חידוש זמני שלישי אינו מותר
#ASSERT NOT (`temporary licence period allowed` (YMD 2026 1 1) (YMD 2027 1 1) 2 TRUE)

-- T048: יותר משנה ברישיון זמני
#ASSERT NOT (`temporary licence period allowed` (YMD 2026 1 1) (YMD 2027 1 2) 0 FALSE)

-- T049: התליה רגילה עד שלוש שנים
#ASSERT `section ten ordinary suspension period allowed` (YMD 2026 1 1) (YMD 2029 1 1)

-- T050: התליה רגילה מעבר לשלוש שנים
#ASSERT NOT (`section ten ordinary suspension period allowed` (YMD 2026 1 1) (YMD 2029 1 2))

-- T051: הארכת השתלמות בדיוק שלושה חודשים
#ASSERT (`training extension power conditions` TRUE TRUE Established (YMD 2026 1 31) (YMD 2026 4 30)) EQUALS Established

-- T052: הארכת השתלמות מעבר לשלושה חודשים
#ASSERT (`training extension power conditions` TRUE TRUE Established (YMD 2026 1 31) (YMD 2026 5 1)) EQUALS Rejected

-- T053: שמונה שעות השתלמות
#ASSERT `annual refresher obligation satisfied` TRUE TRUE TRUE 8 TRUE TRUE

-- T054: פחות משמונה שעות
#ASSERT NOT (`annual refresher obligation satisfied` TRUE TRUE TRUE 7.9 TRUE TRUE)

-- T055: הרשם מוחרג מתקופת כהונה
#ASSERT (`council term end` RegistrarSeat (YMD 2026 1 1)) EQUALS NOTHING

-- T056: כהונת חבר רגיל ארבע שנים
#ASSERT (`council term end` EnergyMinistry (YMD 2026 1 1)) EQUALS (JUST (YMD 2030 1 1))

-- T057: חמישה אינם רוב מתוך אחד עשר
#ASSERT NOT (`council acts protected against vacancy defect` 5 TRUE)

-- T058: שישה עם יושב ראש
#ASSERT `council acts protected against vacancy defect` 6 TRUE

-- T059: הרכב חסר מאפשר דיון לפי תנאי סעיף ג
#ASSERT `reduced composition discussion permitted` TRUE TRUE

-- T060: היעדרות מחצי מהישיבות אינה יותר מחצי
#ASSERT NOT (`absence removal power conditions` 0 5 10 TRUE TRUE)

-- T061: היעדרות יותר ממחצית
#ASSERT `absence removal power conditions` 0 6 10 TRUE TRUE

-- T062: תיקו מוכרע בעמדת יושב ראש
#ASSERT `motion has required votes` 3 3 TRUE

-- T063: תיקו ויושב ראש נגד
#ASSERT NOT (`motion has required votes` 3 3 FALSE)

-- T064: מפקח אינו נכנס למגורים ללא הסכמה או צו
#ASSERT (`inspector entry permitted` TRUE Established TRUE FALSE FALSE) EQUALS Rejected

-- T065: מפקח רשאי עם צו
#ASSERT (`inspector entry permitted` TRUE Established TRUE TRUE FALSE) EQUALS Established

-- T066: בודק חייב בקשת המחזיק במגורים
#ASSERT (`auxiliary examiner entry permitted` TRUE Established TRUE TRUE TRUE FALSE TRUE FALSE TRUE) EQUALS Rejected

-- T067: בודק עם בקשה ותיאום מראש
#ASSERT (`auxiliary examiner entry permitted` TRUE Established TRUE TRUE TRUE FALSE TRUE TRUE TRUE) EQUALS Established

-- T068: חזרה מהסכמה לפני בדיקה
#ASSERT (`auxiliary examiner entry permitted` TRUE Established TRUE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS Rejected

-- T069: ביטול הסמכה בעילת תנאי בלי הזדמנות תיקון
#ASSERT NOT (`certification cancellation power conditions` FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE)

-- T070: ביטול בעילת מידע כוזב אינו מחייב מסלול תיקון
#ASSERT `certification cancellation power conditions` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE

-- T071: סכום מקור WorkWithoutLicenceIndividual
#ASSERT (`original schedule penalty` WorkWithoutLicence Individual) EQUALS (JUST 20000)

-- T072: סכום מקור WorkWithoutLicenceCorporation
#ASSERT (`original schedule penalty` WorkWithoutLicence Corporation) EQUALS (NOTHING)

-- T073: סכום מקור FalseAdvertisingCorporation
#ASSERT (`original schedule penalty` FalseAdvertising Corporation) EQUALS (JUST 10000)

-- T074: סכום מקור EngageWithoutLicenceCorporation
#ASSERT (`original schedule penalty` EngageWithoutLicence Corporation) EQUALS (JUST 40000)

-- T075: סכום מקור WithholdInspectorDocumentIndividual
#ASSERT (`original schedule penalty` WithholdInspectorDocument Individual) EQUALS (JUST 3000)

-- T076: אין טיעון בתום התקופה: הודעה נעשית דרישה
#ASSERT `intention notice becomes demand` TRUE FALSE

-- T077: טיעון הוגש: נדרשת החלטה
#ASSERT NOT (`intention notice becomes demand` TRUE TRUE)

-- T078: תוספת חודש אחד 2 אחוזים
#ASSERT (`penalty before reduction` 20000 1 FALSE) EQUALS 20400

-- T079: הפרה חוזרת מכפילה את הבסיס
#ASSERT (`penalty before reduction` 20000 0 TRUE) EQUALS 40000

-- T080: תוספת מצטברת לא ריבית דריבית
#ASSERT (`penalty before reduction` 20000 2 TRUE) EQUALS 40800

-- T081: הפחתה ללא בסיס בתקנות אינה מותרת
#ASSERT (`permitted reduction` 20000 10000 Rejected) EQUALS Rejected

-- T082: הפחתה בלי מידע מחייבת בדיקה
#ASSERT (`permitted reduction` 20000 10000 Unresolved) EQUALS Unresolved

-- T083: תאריך סכום ללא טיעון: מועד הודעת הכוונה
#ASSERT (`penalty valuation date` (YMD 2027 1 1) (YMD 2027 2 1) TRUE FALSE NOTHING) EQUALS (JUST (YMD 2027 1 1))

-- T084: ערעור עם עיכוב: מועד החלטה בערעור
#ASSERT (`penalty valuation date` (YMD 2027 1 1) (YMD 2027 2 1) FALSE TRUE (JUST (YMD 2028 2 1))) EQUALS (JUST (YMD 2028 2 1))

-- T085: מדד לא תקף אינו סכום אפס
#ASSERT (`annual indexed amount with explicit tie rule` 20000 100 0 TRUE) EQUALS NOTHING

-- T086: עדכון מדד ועיגול לעשרות
#ASSERT (`annual indexed amount with explicit tie rule` 20000 103 100 TRUE) EQUALS (JUST 20600)

-- T087: עד 12 תשלומים
#ASSERT (`installment power conditions` TRUE Established 12) EQUALS Established

-- T088: 13 תשלומים מחוץ לסמכות
#ASSERT (`installment power conditions` TRUE Established 13) EQUALS Rejected

-- T089: אי תשלום מבטל פריסה
#ASSERT `installment arrangement automatically void` TRUE

-- T090: ערעור לבדו אינו מעכב
#ASSERT NOT (`appeal stays implementation` FALSE FALSE)

-- T091: עיכוב בהוראת בית המשפט
#ASSERT `appeal stays implementation` FALSE TRUE

-- T092: שם יחיד דורש זכות טיעון
#ASSERT (`individual name publication power conditions` Established FALSE) EQUALS Rejected

-- T093: תקופת פרסום יחיד
#ASSERT (`publication period years` Individual) EQUALS 2

-- T094: תקופת פרסום תאגיד
#ASSERT (`publication period years` Corporation) EQUALS 4

-- T095: חיסיון חובה גובר
#ASSERT NOT (`publication of item permitted` TRUE FALSE FALSE)

-- T096: חקיקת הכשרת בודק מחייבת היוועצות בשר המתאים
#ASSERT NOT (`rulemaking procedural conditions` ExaminerQualifications TRUE TRUE TRUE TRUE FALSE)

-- T097: מסלול תקנות בקשה אינו דורש אישור ועדה בסעיף 60(2)
#ASSERT `rulemaking procedural conditions` ApplicationProcedure FALSE FALSE FALSE FALSE FALSE

-- T098: תיקון תוספת רביעית מחייב היוועצות בשר הסביבה
#ASSERT NOT (`rulemaking procedural conditions` AmendScheduleFour FALSE FALSE FALSE FALSE FALSE)

-- T099: מסלול ללא רקע דורש תעודת סיום תקפה
#ASSERT (`schedule two route satisfied` A1Training (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0) (YMD 2026 1 1) `verified general commencement` Established) EQUALS Established

-- T100: שעות בלי הכשרה שהושלמה אינן זכאות
#ASSERT (`schedule two route satisfied` A1Training (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0) (YMD 2026 1 1) `verified general commencement` Rejected) EQUALS Rejected

-- T101: שנת ניסיון מתוך שלוש מספיקה למסלול המקוצר
#ASSERT (`schedule two route satisfied` A2 (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 1 0) (YMD 2026 1 1) `verified general commencement` Established) EQUALS Established

-- T102: חלופת שלוש שנות ניסיון מתוך שבע
#ASSERT (`schedule two route satisfied` C5 (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 3) (YMD 2026 1 1) `verified general commencement` Established) EQUALS Established

-- T103: תעודת השלמה אינה מאריכה מסלול ניסיון שפג
#ASSERT (`schedule two route satisfied` C5 (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 3) (YMD 2028 7 17) `verified general commencement` Established) EQUALS Rejected

-- T104: טכנאי עם השלמה משולבת אינו זקוק לקורס נוסף
#ASSERT (`schedule two route satisfied` B2 (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE 0 0) (YMD 2026 1 1) `verified general commencement` Unresolved) EQUALS Established

-- T105: טכנאי בלי השלמה אינו עומד במסלול המשולב
#ASSERT (`schedule two route satisfied` B2 (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 0 0) (YMD 2026 1 1) `verified general commencement` Established) EQUALS Rejected

-- T106: מסלול ג4 מרישיון דרגה שתיים
#ASSERT (`schedule two route satisfied` C4 (PriorQualifications FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0) (YMD 2026 1 1) `verified general commencement` Established) EQUALS Established

-- T107: מהנדס מכונות עדיין זקוק להשלמה במסלול ג8
#ASSERT (`schedule two route satisfied` C8 (PriorQualifications FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE 0 0) (YMD 2026 1 1) `verified general commencement` Unresolved) EQUALS Unresolved
