IMPORT prelude
IMPORT `mecesa-medifund-eldercare`

-- Medical and Elderly Care Endowment Schemes Act 2000, ss 2, 12, 13, 15-17, 22, 24, 25, 29, 31, 38, 40, 41, 43, 45 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_medical-and-elderly-care-endowment-schemes-act-2000.py). Expected results were written by
-- hand from the text.

§ `fixtures`

`citizen unable to pay` MEANS Patient WITH
    `is a citizen of Singapore` IS TRUE
    `has received or requires treatment from an approved institution` IS TRUE
    `is unable to pay the charges` IS TRUE
    `satisfies the prescribed requirements` IS TRUE
    `is incapacitated from applying` IS FALSE

`citizen unable to pay, incapacitated` MEANS Patient WITH
    `is a citizen of Singapore` IS TRUE
    `has received or requires treatment from an approved institution` IS TRUE
    `is unable to pay the charges` IS TRUE
    `satisfies the prescribed requirements` IS TRUE
    `is incapacitated from applying` IS TRUE

`permanent resident unable to pay` MEANS Patient WITH
    `is a citizen of Singapore` IS FALSE
    `has received or requires treatment from an approved institution` IS TRUE
    `is unable to pay the charges` IS TRUE
    `satisfies the prescribed requirements` IS TRUE
    `is incapacitated from applying` IS FALSE

`citizen able to pay` MEANS Patient WITH
    `is a citizen of Singapore` IS TRUE
    `has received or requires treatment from an approved institution` IS TRUE
    `is unable to pay the charges` IS FALSE
    `satisfies the prescribed requirements` IS TRUE
    `is incapacitated from applying` IS FALSE

`approved provider` MEANS Provider WITH
    `is approved for this care at these premises` IS TRUE
    `approval revoked` IS FALSE
    `approval period expired` IS FALSE
    `suspension in force` IS FALSE

`suspended provider` MEANS Provider WITH
    `is approved for this care at these premises` IS TRUE
    `approval revoked` IS FALSE
    `approval period expired` IS FALSE
    `suspension in force` IS TRUE

`revoked provider` MEANS Provider WITH
    `is approved for this care at these premises` IS TRUE
    `approval revoked` IS TRUE
    `approval period expired` IS FALSE
    `suspension in force` IS FALSE

`provider approved for other premises` MEANS Provider WITH
    `is approved for this care at these premises` IS FALSE
    `approval revoked` IS FALSE
    `approval period expired` IS FALSE
    `suspension in force` IS FALSE

