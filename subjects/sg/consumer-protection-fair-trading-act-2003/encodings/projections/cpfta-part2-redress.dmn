    <knowledgeRequirement id="decision_every_specified_period_under_section_9_4_is_permitted_kr1">
      <requiredKnowledge href="#bkm_the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period"/>
    </knowledgeRequirement>
    <literalExpression id="decision_every_specified_period_under_section_9_4_is_permitted_literal">
      <text>(every n_elem in o.the_periods_specified_for_the_orders_mentioned_in_section_9_4_a_b_c_and_d_in_years satisfies the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period(period: n_elem, the_period_the_Minister_has_prescribed_in_place_of_5_years: o.the_period_in_years_that_the_Minister_has_prescribed_in_place_of_5_years)) and (if o.the_period_specified_for_an_order_mentioned_in_section_9_4_e_or_f_in_years != null then the_specified_period_is_within_the_ceiling_of_5_years_or_the_prescribed_period(period: o.the_period_specified_for_an_order_mentioned_in_section_9_4_e_or_f_in_years, the_period_the_Minister_has_prescribed_in_place_of_5_years: o.the_period_in_years_that_the_Minister_has_prescribed_in_place_of_5_years) else true)</text>
    </literalExpression>
  </decision>
  <decision id="decision_the_court_may_extend_the_specified_period" name="the_court_may_extend_the_specified_period" label="the court may extend the specified period">
